# SHACL shapes for the MLIPs ontology.
#
# Currently enforces ontology MODULARITY (R1 reviewer: modules must be
# real, not just doc sections): every mlips class / object- / datatype- /
# annotation-property must be assigned to exactly one declared module via
# rdfs:isDefinedBy. The module assignments themselves are generated by
# artifacts/scripts/extract_modules.py from the XHTML `*-module` sections.
#
# Validate (conforms iff every term has exactly one module):
#   make shacl     # pyshacl over artifacts/ontology/mlips.ttl

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix mlips-sh: <https://w3id.org/mlips/shapes#> .

# Prefix declarations for the SPARQL-based target below.
mlips-sh: sh:declare
    [ sh:prefix "owl" ;  sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ,
    [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

mlips-sh:TermInExactlyOneModule a sh:NodeShape ;
    rdfs:label "Every mlips class/property is defined by exactly one module"@en ;
    rdfs:comment "Targets every class/object-/datatype-/annotation-property in the https://w3id.org/mlips# namespace and requires exactly one rdfs:isDefinedBy pointing at a https://w3id.org/mlips/module/* resource."@en ;
    # Scope to mlips# terms only -- external terms annotated locally
    # (schema:, mls:, qudt:, mdo:) are intentionally exempt.
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes mlips-sh: ;
        sh:select """
            SELECT ?this WHERE {
              ?this a ?t .
              VALUES ?t { owl:Class owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty }
              FILTER(STRSTARTS(STR(?this), "https://w3id.org/mlips#"))
            }
        """
    ] ;
    sh:property [
        sh:path rdfs:isDefinedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://w3id\\\\.org/mlips/module/" ;
        sh:message "Each mlips term must be assigned to exactly one ontology module (rdfs:isDefinedBy a https://w3id.org/mlips/module/* resource)." ;
    ] .
