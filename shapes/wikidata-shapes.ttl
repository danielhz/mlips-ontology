        sh:prefixes wds:prefixes ;
        sh:message "PseudopotentialType sameAsWikidata target is typed but reaches no allowed class (method Q1799072)" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this mlips:sameAsWikidata ?value .
                FILTER EXISTS { ?value (wdt:P31|wdt:P279) ?any }
                FILTER NOT EXISTS {
