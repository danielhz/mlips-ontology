wds:XCFunctionalWikidataType a sh:NodeShape ;
    sh:targetClass mlips:XCFunctional ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes wds:prefixes ;
        sh:message "XCFunctional sameAsWikidata target is typed but reaches no allowed class (method Q1799072)" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this mlips:sameAsWikidata ?value .
                FILTER EXISTS { ?value (wdt:P31|wdt:P279) ?any }
                FILTER NOT EXISTS {
                    ?value (wdt:P31|wdt:P279)/(wdt:P279*) ?cls .
                    FILTER(?cls IN (wd:Q1799072))
                }
            }""" ;
    ] .
