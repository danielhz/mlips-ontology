% TikZiT styles for the ontology overview figure.
%
% Used by mlips-overview-edit.tikz (the TikZiT-editable source).
% After arranging in TikZiT, copy positions back into mlips-overview.tex.

% Module nodes (rounded boxes, fill colour encodes module membership).
\tikzstyle{methodnode} = [draw, rounded corners=2pt, fill={rgb,255: red,166; green,206; blue,227}, minimum height=0.55cm, inner sep=3pt, align=center, font=\footnotesize, text height=1.6ex, text depth=0.4ex]
\tikzstyle{trainnode}  = [draw, rounded corners=2pt, fill={rgb,255: red,178; green,223; blue,138}, minimum height=0.55cm, inner sep=3pt, align=center, font=\footnotesize, text height=1.6ex, text depth=0.4ex]
\tikzstyle{benchnode}  = [draw, rounded corners=2pt, fill={rgb,255: red,253; green,191; blue,111}, minimum height=0.55cm, inner sep=3pt, align=center, font=\footnotesize, text height=1.6ex, text depth=0.4ex]

% Edges
\tikzstyle{edge}      = [->, >=stealth, thin]
\tikzstyle{crossedge} = [->, >=stealth, thin, dashed]
\tikzstyle{shortcut}  = [->, >=stealth, thin, dotted]
