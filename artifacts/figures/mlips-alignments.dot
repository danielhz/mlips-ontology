// Alignment graph for the MLIPs ontology.
//
// Nodes: external ontologies (dashed) and the three MLIPs modules (solid),
// clustered inside the MLIPs ontology box.
// Arcs: labelled with the axiom number (L1–L18) defined in the
// accompanying alignment table.
//
// Render:
//   dot -Tpdf mlips-alignments.dot -o mlips-alignments.pdf
//   dot2tex --figonly --autosize -tmath mlips-alignments.dot > mlips-alignments.tex

digraph alignments {
  rankdir = LR;
  splines = true;
  nodesep = 0.4;
  ranksep = 0.9;
  fontname = "Helvetica";
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];

  // -- External ontologies (dashed) -----------------------------------
  subgraph cluster_external_left {
    label = "";
    style = invis;
    mls   [label="ML-Schema", style="rounded,dashed,filled", fillcolor="#EEEEEE"];
    prov  [label="PROV-O",    style="rounded,dashed,filled", fillcolor="#EEEEEE"];
  }

  subgraph cluster_external_right {
    label = "";
    style = invis;
    mdo    [label="MDO",          style="rounded,dashed,filled", fillcolor="#EEEEEE"];
    cmso   [label="CMSO",         style="rounded,dashed,filled", fillcolor="#EEEEEE"];
    schema [label="schema.org",   style="rounded,dashed,filled", fillcolor="#EEEEEE"];
    qudt   [label="QUDT",         style="rounded,dashed,filled", fillcolor="#EEEEEE"];
  }

  // -- MLIPs ontology cluster ----------------------------------------
  subgraph cluster_mlips {
    label = "MLIPs ontology";
    fontsize = 13;
    style = "rounded";
    color = "#666666";
    bgcolor = "#FAFAFA";

    method   [label="Method module",        fillcolor="#C6DBEF"];
    train    [label="Training Data module", fillcolor="#C7E9C0"];
    bench    [label="Benchmark module",     fillcolor="#FDD0A2"];
  }

  // -- External alignments (Method module) ---------------------------
  method -> mls    [label="L1, L2, L3"];
  method -> mls    [label="L11 (disjoint)", style=dashed, dir=both, arrowhead=none, arrowtail=none];
  method -> mls    [label="L12, L13"];
  method -> prov   [label="L5"];
  method -> qudt   [label="L15"];

  // -- External alignments (Training Data module) --------------------
  train -> mls   [label="L4"];
  train -> prov  [label="L6"];
  train -> mdo   [label="L8"];
  train -> cmso  [label="L9, L10"];

  // -- External alignments (Benchmark module) ------------------------
  bench -> prov   [label="L7"];
  bench -> schema [label="L14"];

  // -- Internal cross-module alignments ------------------------------
  method -> train [label="L16"];
  bench  -> method [label="L17"];
  bench  -> train  [label="L18"];
}
