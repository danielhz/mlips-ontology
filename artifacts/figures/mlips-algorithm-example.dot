digraph mlips_algorithm_example {
rankdir=LR;
fontname="Helvetica";
fontsize=10;
node [fontname="Helvetica", fontsize=9];
edge [fontname="Helvetica", fontsize=8];

  label="Algorithm Module — Example: MACE";
  labelloc=t; fontsize=12;
  mace [label="mlips:mace-algorithm\n(MLIPAlgorithm)\n«MACE»", shape=box, style="filled", fillcolor="#fff4cc"];
  hp_cutoff [label="mlips:mace-cutoff-radius\n(Hyperparameter)", shape=box, style="filled", fillcolor="#fff4cc"];
  hp_layers [label="mlips:mace-num-layers\n(Hyperparameter)", shape=box, style="filled", fillcolor="#fff4cc"];
  hp_lr [label="mlips:mace-learning-rate\n(Hyperparameter)", shape=box, style="filled", fillcolor="#fff4cc"];
  impl [label="mlips:mace-impl-v03\n(Implementation)\n«MACE v0.3»", shape=box, style="filled", fillcolor="#fff4cc"];
  lib [label="mlips:lib-mace-python\n(Library)", shape=box, style="filled", fillcolor="#fff4cc"];
  sim_md [label="mlips:sim-md\n(SimulationType)\n«Molecular dynamics»", shape=box, style="filled", fillcolor="#fff4cc"];
  sim_opt [label="mlips:sim-geometry-opt\n(SimulationType)\n«Geometry opt.»", shape=box, style="filled", fillcolor="#fff4cc"];
  l_name [label="\"cutoff_radius\"", shape=plaintext, fontcolor="#666666"];
  l_default [label="\"5.0\"^^xsd:double", shape=plaintext, fontcolor="#666666"];
  l_min [label="\"2.0\"^^xsd:double", shape=plaintext, fontcolor="#666666"];
  l_max [label="\"10.0\"^^xsd:double", shape=plaintext, fontcolor="#666666"];
  l_version [label="\"0.3.0\"", shape=plaintext, fontcolor="#666666"];
  mace -> hp_cutoff [label="hasHyperparameter"];
  mace -> hp_layers [label="hasHyperparameter"];
  mace -> hp_lr [label="hasHyperparameter"];
  mace -> impl [label="hasImplementation"];
  mace -> sim_md [label="supportsSimulation"];
  mace -> sim_opt [label="supportsSimulation"];
  impl -> lib [label="implementedIn"];
  hp_cutoff -> l_name [label="hyperparameterName"];
  hp_cutoff -> l_default [label="defaultValue"];
  hp_cutoff -> l_min [label="minValue"];
  hp_cutoff -> l_max [label="maxValue"];
  impl -> l_version [label="version"];
}