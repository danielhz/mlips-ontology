		\draw [style=arc-2] (train) to node [pos=0.5, fill=white, font={\scriptsize}, align=center] {L9 \\ L10} (cmso);
		\draw [style=arc-1, bend left=60, looseness=1.25] (bench) to node [pos=0.5, fill=white, font={\scriptsize}] {L7} (prov);
		\draw [style=arc-1] (bench) to node [pos=0.5, fill=white, font={\scriptsize}] {L14} (schema);
		\draw [style=arc-1] (method) to node [pos=0.5, fill=white, font={\scriptsize}] {L16} (train);
