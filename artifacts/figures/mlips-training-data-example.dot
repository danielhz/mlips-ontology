digraph mlips_training_example {
rankdir=LR;
fontname="Helvetica";
fontsize=10;
node [fontname="Helvetica", fontsize=9];
edge [fontname="Helvetica", fontsize=8];

  label="Training Data Module — Example: TiCr2-H Dataset (C14)";
  labelloc=t; fontsize=12;
  ds [label="mlips:ticr2h-dataset-c14\n(TrainingDataset)\n«TiCr2-H DFT dataset (C14)»", shape=box, style="filled", fillcolor="#fff4cc"];
  mat [label="mlips:mat-ticr2\n(MaterialSystem)\n«TiCr2»", shape=box, style="filled", fillcolor="#fff4cc"];
  calc [label="mlips:ticr2h-dft-calc\n(DFTCalculation)", shape=box, style="filled", fillcolor="#fff4cc"];
  settings [label="mlips:ticr2h-dft-settings\n(DFTSettings)", shape=box, style="filled", fillcolor="#fff4cc"];
  vasp [label="mlips:lib-vasp\n(Library)\n«VASP»", shape=box, style="filled", fillcolor="#fff4cc"];
  prov [label="mlips:Published\n(DatasetProvenance)", shape=box, style="filled", fillcolor="#fff4cc"];
  prop_e [label="mlips:Energy\n(CoveredProperty)", shape=box, style="filled", fillcolor="#fff4cc"];
  prop_f [label="mlips:Forces\n(CoveredProperty)", shape=box, style="filled", fillcolor="#fff4cc"];
  prop_s [label="mlips:Stresses\n(CoveredProperty)", shape=box, style="filled", fillcolor="#fff4cc"];
  l_nconf [label="\"3766\"^^xsd:integer", shape=plaintext, fontcolor="#666666"];
  l_xc [label="\"PBE\"", shape=plaintext, fontcolor="#666666"];
  l_kpt [label="\"4x4x4\"", shape=plaintext, fontcolor="#666666"];
  l_ecut [label="\"400.0\"^^xsd:double", shape=plaintext, fontcolor="#666666"];
  l_pp [label="\"PAW\"", shape=plaintext, fontcolor="#666666"];
  l_formula [label="\"TiCr2\"", shape=plaintext, fontcolor="#666666"];
  l_class [label="\"Laves phase\"", shape=plaintext, fontcolor="#666666"];
  ds -> mat [label="coversMaterial"];
  ds -> calc [label="hasDFTCalculation"];
  ds -> prov [label="datasetProvenance"];
  ds -> prop_e [label="coversProperty"];
  ds -> prop_f [label="coversProperty"];
  ds -> prop_s [label="coversProperty"];
  ds -> l_nconf [label="numConfigurations"];
  calc -> settings [label="hasDFTSettings"];
  settings -> vasp [label="usedDFTCode"];
  settings -> l_xc [label="xcFunctional"];
  settings -> l_kpt [label="kPointMesh"];
  settings -> l_ecut [label="energyCutoff"];
  settings -> l_pp [label="pseudopotentialType"];
  mat -> l_formula [label="chemicalFormula"];
  mat -> l_class [label="materialClass"];
}