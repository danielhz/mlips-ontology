% TikZiT styles for the alignment figure.
%
% Used by mlips-alignments-edit.tikz (the editable TikZiT source).
% After arranging nodes in TikZiT, copy positions back into
% mlips-alignments.tex (the production figure).

% Nodes
\tikzstyle{module}   = [circle, fill={rgb,255: red,221; green,238; blue,255}, draw=black, minimum size=1.4cm, inner sep=0pt, font=\footnotesize, align=center]
\tikzstyle{external} = [circle, fill={rgb,255: red,232; green,232; blue,232}, draw=black, dashed, minimum size=1.4cm, inner sep=0pt, font=\footnotesize, align=center]

% Edges, named by the number of axioms collapsed onto the arc
\tikzstyle{arc-1} = [-, line width=0.5pt]
\tikzstyle{arc-2} = [-, line width=1.0pt]
\tikzstyle{arc-3} = [-, line width=1.5pt]
\tikzstyle{arc-6} = [-, line width=3.0pt]
