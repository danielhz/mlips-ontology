\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=methodnode] (MLIPRun) at (5, 4.25) {MLIPRun};
		\node [style=methodnode] (MLIPMethod) at (5, 5.5) {MLIPMethod};
		\node [style=methodnode] (TrainedModel) at (5, 2.85) {TrainedModel};
		\node [style=methodnode] (FunctionalForm) at (9.75, 6.7) {FunctionalForm};
		\node [style=methodnode] (LossFunction) at (9.75, 5.5) {LossFunction};
		\node [style=methodnode] (Hyperparameter) at (9.75, 4.3) {Hyperparameter};
		\node [style=methodnode] (Implementation) at (5, 6.9) {Implementation};
		\node [style=methodnode, anchor=west] (Library) at (0, 7.0) {Library};
		\node [style=methodnode, anchor=west] (SimulationType) at (0, 5.7) {SimulationType};
		\node [style=methodnode] (HyperparameterSetting) at (15, 4.3) {HyperparameterSetting};
		\node [style=trainnode] (TrainingDataset) at (5, 0.5) {TrainingDataset};
		\node [style=trainnode] (DFTCalculation) at (9.25, 0.5) {DFTCalculation};
		\node [style=trainnode] (DFTSettings) at (12.75, 0.5) {DFTSettings};
		\node [style=trainnode] (MaterialSystem) at (5, 1.6) {MaterialSystem};
		\node [style=trainnode, anchor=west] (AtomicConfiguration) at (0, 1.8) {AtomicConfiguration};
		\node [style=benchnode] (BenchmarkStudy) at (15, 3.05) {BenchmarkStudy};
		\node [style=benchnode] (BenchmarkResult) at (15, 1.6) {BenchmarkResult};
		\node [style=benchnode] (AccuracyMetric) at (15, 0.5) {AccuracyMetric};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=edge] (MLIPMethod) to node [pos=0.5, fill=white, font={\tiny}] {hasFunctionalForm} (FunctionalForm);
		\draw [style=edge] (MLIPMethod) to node [pos=0.5, fill=white, font={\tiny}] {hasLossFunction} (LossFunction);
		\draw [style=edge] (MLIPMethod) to node [pos=0.5, fill=white, font={\tiny}] {hasHyperparameter} (Hyperparameter);
		\draw [style=edge] (MLIPMethod) to node [pos=0.5, fill=white, font={\tiny}] {hasImplementation} (Implementation);
		\draw [style=edge] (MLIPMethod) to node [pos=0.5, fill=white, font={\tiny}] {supportsSimulation} (SimulationType);
		\draw [style=edge] (Implementation) to node [pos=0.5, fill=white, font={\tiny}] {implementedIn} (Library);
		\draw [style=edge] (HyperparameterSetting) to node [pos=0.5, fill=white, font={\tiny}] {forHyperparameter} (Hyperparameter);
		\draw [style=edge] (MLIPRun) to node [pos=0.5, fill=white, font={\tiny}] {appliesMethod} (MLIPMethod);
		\draw [style=edge] (MLIPRun) to node [pos=0.5, fill=white, font={\tiny}] {produces} (TrainedModel);
		\draw [style=edge] (TrainingDataset) to node [pos=0.5, fill=white, font={\tiny}] {hasDFTCalculation} (DFTCalculation);
		\draw [style=edge] (TrainingDataset) to node [pos=0.5, fill=white, font={\tiny}] {coversMaterial} (MaterialSystem);
		\draw [style=edge, bend right=345, looseness=0.75] (TrainingDataset) to node [pos=0.5, fill=white, font={\tiny}] {hasConfiguration} (AtomicConfiguration);
		\draw [style=edge] (DFTCalculation) to node [pos=0.5, fill=white, font={\tiny}] {hasDFTSettings} (DFTSettings);
		\draw [style=edge] (BenchmarkStudy) to node [pos=0.5, fill=white, font={\tiny}] {hasResult} (BenchmarkResult);
		\draw [style=edge] (BenchmarkResult) to node [pos=0.5, fill=white, font={\tiny}] {hasAccuracyMetric} (AccuracyMetric);
		\draw [style=crossedge, bend right=90, looseness=1.25] (MLIPRun) to node [pos=0.4, fill=white, font={\tiny}] {runsOn} (TrainingDataset);
		\draw [style=crossedge, bend right=15] (BenchmarkResult) to node [pos=0.5, fill=white, font={\tiny}] {evaluatesModel} (TrainedModel);
		\draw [style=crossedge] (BenchmarkResult) to node [pos=0.5, fill=white, font={\tiny}] {targetMaterial} (MaterialSystem);
	\end{pgfonlayer}
\end{tikzpicture}
