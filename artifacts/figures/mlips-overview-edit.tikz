		\draw [style=crossedge] (BenchmarkResult) to node [pos=0.5, fill=white, font={\tiny}] {evaluatesModel} (TrainedModel);
		\draw [style=crossedge] (BenchmarkResult) to node [pos=0.5, fill=white, font={\tiny}] {targetMaterial} (MaterialSystem);
		\draw [style=edge, bend left=25] (MLIPRun) to node [pos=0.5, fill=white, font={\tiny}] {hasHyperparameterSetting} (HyperparameterSetting);
		\draw [style=shortcut] (TrainedModel) to node [pos=0.55, fill=white, font={\tiny}] {trainedUsing} (HyperparameterSetting);
		\draw [style=shortcut, bend left=70, looseness=1.50] (TrainedModel) to node [pos=0.5, fill=white, font={\tiny}] {trainedWith} (MLIPMethod);
