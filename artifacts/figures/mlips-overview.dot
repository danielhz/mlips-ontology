// Overview of the MLIPs ontology — Graphviz layout source.
// Render: dot -Tpdf mlips-overview.dot or via dot_to_tikz.py
//
// Visual conventions:
//   * Modules are coloured cluster regions (no per-node borders).
//   * Each node is plaintext on the cluster's coloured background.
//   * Aspect: roughly 2:1 (wider than tall) — set via the size hint.

digraph mlips_overview {
  rankdir=LR;
  size="10,5!";
  ratio=fill;
  fontname="Helvetica";
  fontsize=10;
  node [fontname="Helvetica", fontsize=9, shape=plaintext, margin="0.04,0.02"];
  edge [fontname="Helvetica", fontsize=7];
  nodesep=0.10;
  ranksep=0.30;
  margin=0;
  pad="0.02";
  compound=true;
  newrank=true;

  subgraph cluster_algorithm {
    label="Method";
    style="filled,rounded"; color="#c6dbef";
    fontsize=10; labeljust=l;
    MLIPMethod;
    Hyperparameter;
    HyperparameterSetting;
    Implementation;
    Library;
    SimulationType;
    FunctionalForm;
    LossFunction;
    MLIPRun;
    TrainedModel;
    MLIPMethod -> Hyperparameter [label="hasHyperparameter"];
    MLIPMethod -> Implementation [label="hasImplementation"];
    MLIPMethod -> SimulationType [label="supportsSimulation"];
    MLIPMethod -> FunctionalForm [label="hasFunctionalForm"];
    MLIPMethod -> LossFunction [label="hasLossFunction"];
    Implementation -> Library [label="implementedIn"];
    HyperparameterSetting -> Hyperparameter [label="forHyperparameter"];
    MLIPRun -> MLIPMethod [label="appliesMethod"];
    MLIPRun -> TrainedModel [label="produces"];
  }

  subgraph cluster_training {
    label="Training Data";
    style="filled,rounded"; color="#c7e9c0";
    fontsize=10; labeljust=l;
    TrainingDataset;
    DFTCalculation;
    DFTSettings;
    MaterialSystem;
    AtomicConfiguration;
    DatasetProvenance;
    CoveredProperty;
    TrainingDataset -> MaterialSystem [label="coversMaterial"];
    TrainingDataset -> DFTCalculation [label="hasDFTCalculation"];
    TrainingDataset -> CoveredProperty [label="coversProperty"];
    TrainingDataset -> DatasetProvenance [label="datasetProvenance"];
    TrainingDataset -> AtomicConfiguration [label="hasConfiguration"];
    DFTCalculation -> DFTSettings [label="hasDFTSettings"];
  }

  subgraph cluster_benchmark {
    label="Benchmark";
    style="filled,rounded"; color="#fdd0a2";
    fontsize=10; labeljust=l;
    BenchmarkStudy;
    BenchmarkResult;
    AccuracyMetric;
    MetricType;
    MetricProperty;
    BenchmarkStudy -> BenchmarkResult [label="hasResult"];
    BenchmarkResult -> AccuracyMetric [label="hasAccuracyMetric"];
    AccuracyMetric -> MetricType [label="metricType"];
    AccuracyMetric -> MetricProperty [label="metricProperty"];
  }

  // Cross-module relationships (dashed)
  MLIPRun         -> TrainingDataset [label="runsOn",          constraint=false, style=dashed];
  BenchmarkResult -> TrainedModel    [label="evaluatesModel",  constraint=false, style=dashed];
  BenchmarkResult -> MaterialSystem  [label="targetMaterial",  constraint=false, style=dashed];
}
