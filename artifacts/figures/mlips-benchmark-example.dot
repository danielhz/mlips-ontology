digraph mlips_benchmark_example {
rankdir=LR;
fontname="Helvetica";
fontsize=10;
node [fontname="Helvetica", fontsize=9];
edge [fontname="Helvetica", fontsize=8];

  label="Benchmark Module — Example: C15-MTP on TiCr2-H";
  labelloc=t; fontsize=12;
  study [label="mlips:study-kumar2025\n(BenchmarkStudy)\n«Kumar et al. (2025)»", shape=box, style="filled", fillcolor="#fff4cc"];
  result [label="mlips:result-mtp-ticr2h-c15\n(BenchmarkResult)", shape=box, style="filled", fillcolor="#fff4cc"];
  algo [label="mlips:mtp-algorithm\n(MLIPAlgorithm)\n«MTP»", shape=box, style="filled", fillcolor="#fff4cc"];
  ds [label="mlips:ticr2h-dataset-c15\n(TrainingDataset)", shape=box, style="filled", fillcolor="#fff4cc"];
  mat [label="mlips:mat-ticr2\n(MaterialSystem)\n«TiCr2»", shape=box, style="filled", fillcolor="#fff4cc"];
  metric_e [label="mlips:metric-energy-rmse\n(AccuracyMetric)", shape=box, style="filled", fillcolor="#fff4cc"];
  metric_f [label="mlips:metric-force-rmse\n(AccuracyMetric)", shape=box, style="filled", fillcolor="#fff4cc"];
  mt_rmse [label="mlips:RMSE\n(MetricType)", shape=box, style="filled", fillcolor="#fff4cc"];
  mt_rmse_f [label="mlips:RMSE\n(MetricType)", shape=box, style="filled", fillcolor="#fff4cc"];
  mp_energy [label="mlips:EnergyProperty\n(MetricProperty)", shape=box, style="filled", fillcolor="#fff4cc"];
  mp_force [label="mlips:ForceProperty\n(MetricProperty)", shape=box, style="filled", fillcolor="#fff4cc"];
  article [label="mlips:article-kumar2025\n(ScholarlyArticle)", shape=box, style="filled", fillcolor="#fff4cc"];
  setting_c [label="mlips:setting-cutoff\n(HyperparameterSetting)", shape=box, style="filled", fillcolor="#fff4cc"];
  l_val_e [label="\"3.17\"^^xsd:double", shape=plaintext, fontcolor="#666666"];
  l_val_f [label="\"50.0\"^^xsd:double", shape=plaintext, fontcolor="#666666"];
  l_cutoff [label="\"5.0\"^^xsd:double", shape=plaintext, fontcolor="#666666"];
  study -> result [label="hasResult"];
  result -> algo [label="usesAlgorithm"];
  result -> ds [label="usesTrainingData"];
  result -> mat [label="targetMaterial"];
  result -> metric_e [label="hasAccuracyMetric"];
  result -> metric_f [label="hasAccuracyMetric"];
  result -> setting_c [label="hasHyperparameterSetting"];
  result -> article [label="reportedIn"];
  metric_e -> mt_rmse [label="metricType"];
  metric_e -> mp_energy [label="metricProperty"];
  metric_e -> l_val_e [label="metricValue"];
  metric_f -> mt_rmse_f [label="metricType"];
  metric_f -> mp_force [label="metricProperty"];
  metric_f -> l_val_f [label="metricValue"];
  setting_c -> l_cutoff [label="cutoffRadius"];
}