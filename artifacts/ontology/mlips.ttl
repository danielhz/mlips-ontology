@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdo: <https://w3id.org/mdo/core/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/mlips> a owl:Ontology ;
    rdfs:label "MLIPs Ontology: An Ontology for Machine Learning Interatomic Potentials" ;
    dcterms:contributor [ a schema:Person ;
            schema:name "Lifang Zhu" ],
        [ a schema:Person ;
            schema:name "Tom Schächtel" ],
        [ a schema:Person ;
            schema:name "Xiang Xu" ],
        [ a schema:Person ;
            schema:name "Xi Zhang" ],
        [ a schema:Person ;
            schema:name "Wenchuan Liu" ],
        [ a schema:Person ;
            schema:name "Xin Li" ],
        <https://orcid.org/0000-0001-9176-3270>,
        <https://orcid.org/0000-0002-0780-4154>,
        <https://orcid.org/0000-0002-3661-5870>,
        <https://orcid.org/0000-0003-1486-1197>,
        <https://orcid.org/0000-0003-3050-6291> ;
    dcterms:creator <https://orcid.org/0000-0002-2409-975X>,
        <https://orcid.org/0000-0002-7896-0875>,
        <https://orcid.org/0000-0003-4281-5665> ;
    dcterms:description "An OWL ontology capturing the concepts needed to describe machine learning interatomic potentials: algorithm families, hyperparameters, training datasets with DFT provenance, and published benchmarks." ;
    dcterms:issued "2026-04-10"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-05-01"^^xsd:date ;
    dcterms:publisher <http://www.wikidata.org/entity/Q131785081> ;
    dcterms:title "MLIPs Ontology: An Ontology for Machine Learning Interatomic Potentials" ;
    vann:preferredNamespacePrefix "mlips" ;
    vann:preferredNamespaceUri "https://w3id.org/mlips#" ;
    rdfs:comment "An OWL ontology capturing the concepts needed to describe machine learning interatomic potentials: algorithm families, hyperparameters, training datasets with DFT provenance, and published benchmarks." ;
    rdfs:seeAlso qudt:,
        schema:,
        mdo: ;
    owl:imports <http://www.w3.org/ns/mls>,
        <http://www.w3.org/ns/prov-o> ;
    owl:versionIRI <https://w3id.org/mlips/0.1.0> ;
    owl:versionInfo "0.1.0" .

mlips:ArchitecturalHyperparameter a owl:Class ;
    rdfs:label "Architectural Hyperparameter"@en ;
    rdfs:comment """A hyperparameter that specifies the model
architecture. Not disjoint with PhysicalHyperparameter."""@en ;
    rdfs:subClassOf mlips:Hyperparameter .

mlips:AtomicClusterExpansionDescriptor a owl:NamedIndividual,
        mlips:AtomicEnvironmentDescriptor ;
    rdfs:label "Atomic Cluster Expansion Descriptor"@en ;
    rdfs:comment "Atomic cluster expansion; used by ACE."@en .

mlips:Augmented a owl:NamedIndividual,
        mlips:DatasetProvenance ;
    rdfs:label "Augmented"@en ;
    rdfs:comment "Dataset augmented from existing sources."@en .

mlips:Energy a owl:NamedIndividual,
        mlips:CoveredProperty ;
    rdfs:label "Energy"@en .

mlips:EnergyProperty a owl:NamedIndividual,
        mlips:MetricProperty ;
    rdfs:label "Energy (metric property)"@en .

mlips:EquivariantMessagePassingDescriptor a owl:NamedIndividual,
        mlips:AtomicEnvironmentDescriptor ;
    rdfs:label "Equivariant Message Passing Descriptor"@en ;
    rdfs:comment "Equivariant message-passing representation; used by MACE and NequIP."@en .

mlips:ForceProperty a owl:NamedIndividual,
        mlips:MetricProperty ;
    rdfs:label "Force"@en .

mlips:Forces a owl:NamedIndividual,
        mlips:CoveredProperty ;
    rdfs:label "Forces"@en .

mlips:InHouse a owl:NamedIndividual,
        mlips:DatasetProvenance ;
    rdfs:label "In-house"@en ;
    rdfs:comment "Dataset generated by in-house calculations."@en .

mlips:MAE a owl:NamedIndividual,
        mlips:MetricType ;
    rdfs:label "MAE"@en ;
    rdfs:comment "Mean Absolute Error."@en .

mlips:MomentTensorDescriptor a owl:NamedIndividual,
        mlips:AtomicEnvironmentDescriptor ;
    rdfs:label "Moment Tensor Descriptor"@en ;
    rdfs:comment "Invariant moment tensors of the neighborhood; used by MTP."@en .

mlips:PhysicalHyperparameter a owl:Class ;
    rdfs:label "Physical Hyperparameter"@en ;
    rdfs:comment """A hyperparameter that has a direct physical
meaning. Not disjoint with ArchitecturalHyperparameter."""@en ;
    rdfs:subClassOf mlips:Hyperparameter .

mlips:Published a owl:NamedIndividual,
        mlips:DatasetProvenance ;
    rdfs:label "Published"@en ;
    rdfs:comment "Dataset from a published source."@en .

mlips:R2 a owl:NamedIndividual,
        mlips:MetricType ;
    rdfs:label "R²"@en ;
    rdfs:comment "Coefficient of determination."@en .

mlips:RMSE a owl:NamedIndividual,
        mlips:MetricType ;
    rdfs:label "RMSE"@en ;
    rdfs:comment "Root Mean Square Error."@en .

mlips:SOAPDescriptor a owl:NamedIndividual,
        mlips:AtomicEnvironmentDescriptor ;
    rdfs:label "SOAP Descriptor"@en ;
    rdfs:comment "Smooth Overlap of Atomic Positions; used by GAP."@en .

mlips:StressProperty a owl:NamedIndividual,
        mlips:MetricProperty ;
    rdfs:label "Stress"@en .

mlips:Stresses a owl:NamedIndividual,
        mlips:CoveredProperty ;
    rdfs:label "Stresses"@en .

mlips:SymmetryFunctionDescriptor a owl:NamedIndividual,
        mlips:AtomicEnvironmentDescriptor ;
    rdfs:label "Symmetry Function Descriptor"@en ;
    rdfs:comment "Behler-Parrinello symmetry functions; used by HDNNP."@en .

mlips:TrainingHyperparameter a owl:Class ;
    rdfs:label "Training Hyperparameter"@en ;
    rdfs:comment "A hyperparameter of the training procedure."@en ;
    rdfs:subClassOf mlips:Hyperparameter .

mlips:Virials a owl:NamedIndividual,
        mlips:CoveredProperty ;
    rdfs:label "Virials"@en .

mlips:basisSet a owl:DatatypeProperty ;
    rdfs:label "basis set"@en ;
    rdfs:comment """The Gaussian basis set used in a
wave-function calculation, e.g., cc-pVTZ, aug-cc-pVDZ, def2-TZVP."""@en ;
    rdfs:domain mlips:WaveFunctionSettings ;
    rdfs:range xsd:string .

mlips:candidateForVocabulary a owl:ObjectProperty ;
    rdfs:label "candidate for vocabulary"@en ;
    rdfs:comment """Annotates a paper-local instance with the
controlled-vocabulary class to which it should be considered for
promotion. Used when an encoded paper introduces an entity that is not
yet a named individual in mlips-vocab.ttl. The deduplication audit
collects these candidates; a curator promotes, merges, or leaves them
paper-local."""@en .

mlips:chemicalFormula a owl:DatatypeProperty ;
    rdfs:label "chemical formula"@en ;
    rdfs:domain mlips:MaterialSystem ;
    rdfs:range xsd:string .

mlips:cutoffRadius a owl:DatatypeProperty ;
    rdfs:label "cutoff radius"@en ;
    rdfs:comment "Cutoff radius for atomic interactions, in angstroms."@en ;
    rdfs:domain mlips:HyperparameterSetting ;
    rdfs:range xsd:double .

mlips:defaultValue a owl:DatatypeProperty ;
    rdfs:label "default value"@en ;
    rdfs:domain mlips:Hyperparameter ;
    rdfs:range rdfs:Literal .

mlips:dftBasisSet a owl:ObjectProperty ;
    rdfs:label "DFT basis set"@en ;
    rdfs:comment """The basis set used by an all-electron or
localised-basis DFT calculation (FHI-aims NAO, LAPW, Gaussian-type
orbitals such as cc-pVDZ or 6-31G). Plane-wave codes specify the basis
through mlips:energyCutoff and leave this slot empty."""@en ;
    rdfs:domain mlips:DFTSettings ;
    rdfs:range mlips:DftBasisSet .

mlips:energyCutoff a owl:DatatypeProperty ;
    rdfs:label "energy cutoff"@en ;
    rdfs:comment "Plane-wave energy cutoff in eV."@en ;
    rdfs:domain mlips:DFTSettings ;
    rdfs:range xsd:double .

mlips:forHyperparameter a owl:ObjectProperty ;
    rdfs:label "for hyperparameter"@en ;
    rdfs:comment "Links a setting to the hyperparameter it configures."@en ;
    rdfs:domain mlips:HyperparameterSetting ;
    rdfs:range mlips:Hyperparameter .

mlips:frozenCore a owl:DatatypeProperty ;
    rdfs:label "frozen core"@en ;
    rdfs:comment """Whether core electrons are kept frozen
during the post-Hartree-Fock correlation treatment in a wave-function
calculation. True for the standard frozen-core approximation; false
for all-electron correlation."""@en ;
    rdfs:domain mlips:WaveFunctionSettings ;
    rdfs:range xsd:boolean .

mlips:gpuHours a owl:DatatypeProperty ;
    rdfs:label "GPU hours"@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range xsd:double .

mlips:hasDFTCalculation a owl:ObjectProperty ;
    rdfs:label "has DFT calculation"@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range mlips:DFTCalculation ;
    rdfs:subPropertyOf mlips:hasReferenceCalculation .

mlips:hasDescriptor a owl:ObjectProperty ;
    rdfs:label "has descriptor"@en ;
    rdfs:comment "Links an MLIP method to the atomic environment descriptor it uses."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range mlips:AtomicEnvironmentDescriptor .

mlips:hasTrainingRun a owl:ObjectProperty ;
    rdfs:label "has training run"@en ;
    rdfs:comment "Optional link from an MLIP run to an ML-Schema run recording the training algorithm execution."@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range mls:Run .

mlips:hasUnit a owl:ObjectProperty ;
    rdfs:label "has unit"@en ;
    rdfs:comment "Links a numeric value to its QUDT unit."@en ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:hasUnit .

mlips:hyperparameterDatatype a owl:DatatypeProperty ;
    rdfs:label "hyperparameter datatype"@en ;
    rdfs:comment "The expected datatype of this hyperparameter (e.g., float, int, string)."@en ;
    rdfs:domain mlips:Hyperparameter ;
    rdfs:range xsd:string .

mlips:hyperparameterName a owl:DatatypeProperty ;
    rdfs:label "hyperparameter name"@en ;
    rdfs:domain mlips:Hyperparameter ;
    rdfs:range xsd:string .

mlips:inferenceComplexity a owl:DatatypeProperty ;
    rdfs:label "inference complexity"@en ;
    rdfs:comment "Asymptotic computational complexity of inference."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range xsd:string .

mlips:inferenceHardware a owl:DatatypeProperty ;
    rdfs:label "inference hardware"@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range xsd:string .

mlips:inferenceTimePerAtom a owl:DatatypeProperty ;
    rdfs:label "inference time per atom"@en ;
    rdfs:comment "Inference time per atom (microseconds)."@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range xsd:double .

mlips:kPointMesh a owl:DatatypeProperty ;
    rdfs:label "k-point mesh"@en ;
    rdfs:comment "K-point mesh specification (e.g., '4x4x4')."@en ;
    rdfs:domain mlips:DFTSettings ;
    rdfs:range xsd:string .

mlips:learningRate a owl:DatatypeProperty ;
    rdfs:label "learning rate"@en ;
    rdfs:comment "Learning rate used during model training."@en ;
    rdfs:domain mlips:HyperparameterSetting ;
    rdfs:range xsd:double .

mlips:materialClass a owl:DatatypeProperty ;
    rdfs:label "material class"@en ;
    rdfs:comment "E.g., element, binary alloy, ternary compound, HEA."@en ;
    rdfs:domain mlips:MaterialSystem ;
    rdfs:range xsd:string .

mlips:maxValue a owl:DatatypeProperty ;
    rdfs:label "maximum value"@en ;
    rdfs:domain mlips:Hyperparameter ;
    rdfs:range rdfs:Literal .

mlips:metricValue a owl:DatatypeProperty ;
    rdfs:label "metric value"@en ;
    rdfs:domain mlips:AccuracyMetric ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf qudt:value .

mlips:microstructuralFeature a owl:DatatypeProperty ;
    rdfs:label "microstructural feature"@en ;
    rdfs:comment "E.g., point defect, dislocation, surface, grain boundary."@en ;
    rdfs:domain mlips:MaterialSystem ;
    rdfs:range xsd:string .

mlips:minValue a owl:DatatypeProperty ;
    rdfs:label "minimum value"@en ;
    rdfs:domain mlips:Hyperparameter ;
    rdfs:range rdfs:Literal .

mlips:numAngularBasis a owl:DatatypeProperty ;
    rdfs:label "number of angular basis functions"@en ;
    rdfs:comment "Number of angular basis functions in the descriptor."@en ;
    rdfs:domain mlips:HyperparameterSetting ;
    rdfs:range xsd:integer .

mlips:numConfigurations a owl:DatatypeProperty ;
    rdfs:label "number of configurations"@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range xsd:integer .

mlips:numLayers a owl:DatatypeProperty ;
    rdfs:label "number of layers"@en ;
    rdfs:comment "Number of layers in the neural network architecture."@en ;
    rdfs:domain mlips:HyperparameterSetting ;
    rdfs:range xsd:integer .

mlips:numRadialBasis a owl:DatatypeProperty ;
    rdfs:label "number of radial basis functions"@en ;
    rdfs:comment "Number of radial basis functions in the descriptor."@en ;
    rdfs:domain mlips:HyperparameterSetting ;
    rdfs:range xsd:integer .

mlips:peakMemory a owl:DatatypeProperty ;
    rdfs:label "peak memory"@en ;
    rdfs:comment "Peak memory during training (GB)."@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range xsd:double .

mlips:pseudopotentialType a owl:ObjectProperty ;
    rdfs:label "pseudopotential type"@en ;
    rdfs:comment """The family of pseudopotentials used in a
plane-wave DFT calculation (PAW, ultrasoft, norm-conserving). All-
electron codes leave this slot empty and use mlips:dftBasisSet
instead."""@en ;
    rdfs:domain mlips:DFTSettings ;
    rdfs:range mlips:PseudopotentialType .

mlips:reportedIn a owl:ObjectProperty ;
    rdfs:label "reported in"@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range schema:ScholarlyArticle .

mlips:sameAsWikidata a owl:ObjectProperty ;
    rdfs:label "same as Wikidata"@en ;
    rdfs:comment "Links an entity to its corresponding Wikidata item."@en ;
    rdfs:subPropertyOf owl:sameAs .

mlips:samplingStrategy a owl:ObjectProperty ;
    rdfs:label "sampling strategy"@en ;
    rdfs:comment """Records the sampling strategy or strategies
used to construct a training dataset. Optional and multi-valued: a
dataset may combine several sampling strategies (e.g., chemical and
vibrational)."""@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range mlips:SamplingStrategy .

mlips:settingValue a owl:DatatypeProperty ;
    rdfs:label "setting value"@en ;
    rdfs:domain mlips:HyperparameterSetting ;
    rdfs:range rdfs:Literal .

mlips:supportsGPU a owl:DatatypeProperty ;
    rdfs:label "supports GPU"@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range xsd:boolean .

mlips:supportsParallelization a owl:DatatypeProperty ;
    rdfs:label "supports parallelization"@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range xsd:boolean .

mlips:trainedOn a owl:ObjectProperty ;
    rdfs:label "trained on"@en ;
    rdfs:comment "Shortcut: links a trained model directly to the training dataset it was fitted on."@en ;
    rdfs:domain mlips:TrainedModel ;
    rdfs:range mlips:TrainingDataset ;
    owl:propertyChainAxiom ( [ a owl:ObjectProperty ;
                owl:inverseOf mlips:produces ] mlips:runsOn ) .

mlips:trainedUsing a owl:ObjectProperty ;
    rdfs:label "trained using"@en ;
    rdfs:comment "Shortcut: links a trained model directly to a hyperparameter setting used during the MLIP run that produced it."@en ;
    rdfs:domain mlips:TrainedModel ;
    rdfs:range mlips:HyperparameterSetting ;
    owl:propertyChainAxiom ( [ a owl:ObjectProperty ;
                owl:inverseOf mlips:produces ] mlips:hasHyperparameterSetting ) .

mlips:trainedWith a owl:ObjectProperty ;
    rdfs:label "trained with"@en ;
    rdfs:comment "Shortcut: links a trained model directly to the MLIP method it applies."@en ;
    rdfs:domain mlips:TrainedModel ;
    rdfs:range mlips:MLIPMethod ;
    owl:propertyChainAxiom ( [ a owl:ObjectProperty ;
                owl:inverseOf mlips:produces ] mlips:appliesMethod ) .

mlips:trainingComplexity a owl:DatatypeProperty ;
    rdfs:label "training complexity"@en ;
    rdfs:comment "Asymptotic computational complexity of training."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range xsd:string .

mlips:trainingDuration a owl:DatatypeProperty ;
    rdfs:label "training duration"@en ;
    rdfs:comment "Measured wall-clock training time (hours)."@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range xsd:double .

mlips:trainingHardware a owl:DatatypeProperty ;
    rdfs:label "training hardware"@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range xsd:string .

mlips:usedDFTCode a owl:ObjectProperty ;
    rdfs:label "used DFT code"@en ;
    rdfs:comment "The DFT software used (e.g., VASP, GPAW)."@en ;
    rdfs:domain mlips:DFTSettings ;
    rdfs:range mlips:Library ;
    rdfs:subPropertyOf mlips:usedReferenceCode .

mlips:usesAlgorithm a owl:ObjectProperty ;
    rdfs:label "uses algorithm"@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range mlips:MLIPMethod .

mlips:usesTrainingData a owl:ObjectProperty ;
    rdfs:label "uses training data"@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range mlips:TrainingDataset .

mlips:version a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    rdfs:domain mlips:Implementation ;
    rdfs:range xsd:string .

mlips:wfMethod a owl:ObjectProperty ;
    rdfs:label "wave-function method"@en ;
    rdfs:comment """The wave-function correlation method used
to produce reference data (e.g., HF, MP2, CCSD, CCSD(T), DLPNO-CCSD(T),
CASPT2, NEVPT2). Range is WfMethod; concrete methods are named
individuals in mlips-vocab.ttl."""@en ;
    rdfs:domain mlips:WaveFunctionSettings ;
    rdfs:range mlips:WfMethod .

mlips:xcFunctional a owl:ObjectProperty ;
    rdfs:label "exchange-correlation functional"@en ;
    rdfs:comment """The exchange-correlation functional used in
a DFT calculation (e.g., LDA, PBE, PBE0, HSE06, SCAN, omegaB97X). Range
is XCFunctional; concrete functionals are named individuals in
mlips-vocab.ttl."""@en ;
    rdfs:domain mlips:DFTSettings ;
    rdfs:range mlips:XCFunctional .

<http://www.wikidata.org/entity/Q122453> a schema:Organization ;
    schema:name "University of Stuttgart" .

<http://www.wikidata.org/entity/Q131785081> a schema:Organization ;
    schema:name "Institute for Artificial Intelligence (KI)" ;
    schema:parentOrganization <http://www.wikidata.org/entity/Q122453> .

<https://orcid.org/0000-0001-9176-3270> a schema:Person ;
    schema:name "Yuji Ikeda" .

<https://orcid.org/0000-0002-0780-4154> a schema:Person ;
    schema:name "Steffen Staab" .

<https://orcid.org/0000-0002-2409-975X> a schema:Person ;
    schema:name "Jong Hyun Jung" .

<https://orcid.org/0000-0002-3661-5870> a schema:Person ;
    schema:name "Pranav Kumar" .

<https://orcid.org/0000-0002-7896-0875> a schema:Person ;
    schema:name "Daniel Hernández" .

<https://orcid.org/0000-0003-1486-1197> a schema:Person ;
    schema:name "Yongliang Ou" .

<https://orcid.org/0000-0003-3050-6291> a schema:Person ;
    schema:name "Fritz Körmann" .

<https://orcid.org/0000-0003-4281-5665> a schema:Person ;
    schema:name "Blazej Grabowski" .

mlips:DftBasisSet a owl:Class ;
    rdfs:label "DFT Basis Set"@en ;
    rdfs:comment """The basis set used in a DFT calculation,
when the code is all-electron or otherwise uses a localised basis (e.g.,
FHI-aims NAO families, LAPW, Gaussian-type orbitals such as cc-pVDZ
or 6-31G). Range of mlips:dftBasisSet on DFTSettings. Plane-wave
codes specify the basis through mlips:energyCutoff instead and leave
this slot empty. Concrete basis sets are modelled as named individuals;
an open extension point."""@en .

mlips:PseudopotentialType a owl:Class ;
    rdfs:label "Pseudopotential Type"@en ;
    rdfs:comment """A family of pseudopotentials used in a
plane-wave DFT calculation (e.g., PAW, ultrasoft, norm-conserving).
Range of mlips:pseudopotentialType on DFTSettings. All-electron codes
leave this slot empty. Concrete pseudopotential families are modelled
as named individuals; an open extension point."""@en .

mlips:SamplingStrategy a owl:Class ;
    rdfs:label "Sampling Strategy"@en ;
    rdfs:comment """A strategy used to sample the atomic
configurations in a training dataset (e.g., chemical sampling across
compositions, vibrational sampling across thermal snapshots, or a
combination). Concrete sampling strategies are modeled as instances and
will be developed in future work; this class is left open as an
extension point."""@en .

mlips:WaveFunctionCalculation a owl:Class ;
    rdfs:label "Wave Function Calculation"@en ;
    rdfs:comment """A wave-function-based reference calculation
(e.g., Hartree-Fock, MP2, CCSD, CCSD(T), CASPT2). An alternative to
DFTCalculation as a source of reference data, typically more accurate but
more expensive."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mlips:hasWaveFunctionSettings ;
            owl:someValuesFrom mlips:WaveFunctionSettings ],
        mlips:ReferenceCalculation .

mlips:WfMethod a owl:Class ;
    rdfs:label "Wave Function Method"@en ;
    rdfs:comment """A wave-function correlation method used to
produce reference data (e.g., HF, MP2, CCSD, CCSD(T), DLPNO-CCSD(T),
CASPT2, NEVPT2). Range of mlips:wfMethod on WaveFunctionSettings.
Concrete methods are modelled as named individuals; an open
extension point."""@en .

mlips:XCFunctional a owl:Class ;
    rdfs:label "Exchange-Correlation Functional"@en ;
    rdfs:comment """A density-functional approximation to the
exchange-correlation energy used in a DFT calculation (e.g., LDA, PBE,
PBE0, HSE06, SCAN, BLYP, omegaB97X). Range of mlips:xcFunctional on
DFTSettings. Concrete functionals are modelled as named individuals;
an open extension point."""@en .

mlips:coversMaterial a owl:ObjectProperty ;
    rdfs:label "covers material"@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range mlips:MaterialSystem .

mlips:coversProperty a owl:ObjectProperty ;
    rdfs:label "covers property"@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range mlips:CoveredProperty .

mlips:datasetProvenance a owl:ObjectProperty ;
    rdfs:label "dataset provenance"@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range mlips:DatasetProvenance .

mlips:evaluatesModel a owl:ObjectProperty ;
    rdfs:label "evaluates model"@en ;
    rdfs:comment "Links a benchmark result to the trained model being evaluated."@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range mlips:TrainedModel .

mlips:hasConfiguration a owl:ObjectProperty ;
    rdfs:label "has configuration"@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range mlips:AtomicConfiguration .

mlips:hasDFTSettings a owl:ObjectProperty ;
    rdfs:label "has DFT settings"@en ;
    rdfs:domain mlips:DFTCalculation ;
    rdfs:range mlips:DFTSettings ;
    rdfs:subPropertyOf mlips:hasReferenceSettings .

mlips:hasFunctionalForm a owl:ObjectProperty ;
    rdfs:label "has functional form"@en ;
    rdfs:comment "Links an MLIP method to its parametrised functional form."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range mlips:FunctionalForm .

mlips:hasHyperparameterSetting a owl:ObjectProperty ;
    rdfs:label "has hyperparameter setting"@en ;
    rdfs:comment "Links an MLIP run to a concrete hyperparameter setting used in that run."@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range mlips:HyperparameterSetting .

mlips:hasImplementation a owl:ObjectProperty ;
    rdfs:label "has implementation"@en ;
    rdfs:comment "Links an MLIP method to a software implementation."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range mlips:Implementation .

mlips:hasLossFunction a owl:ObjectProperty ;
    rdfs:label "has loss function"@en ;
    rdfs:comment "Links an MLIP method to the loss function whose minimisation fits its parameters."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range mlips:LossFunction .

mlips:hasReferenceCalculation a owl:ObjectProperty ;
    rdfs:label "has reference calculation"@en ;
    rdfs:comment """Links a training dataset to the
first-principles calculation that produced its reference data.
Generalises hasDFTCalculation to wave-function and other ab initio
methods."""@en ;
    rdfs:domain mlips:TrainingDataset ;
    rdfs:range mlips:ReferenceCalculation .

mlips:hasTrainingAlgorithm a owl:ObjectProperty ;
    rdfs:label "has training algorithm"@en ;
    rdfs:comment "Links an MLIP method to the ML-Schema algorithm used to fit its functional form."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range mls:Algorithm .

mlips:hasWaveFunctionSettings a owl:ObjectProperty ;
    rdfs:label "has wave function settings"@en ;
    rdfs:domain mlips:WaveFunctionCalculation ;
    rdfs:range mlips:WaveFunctionSettings ;
    rdfs:subPropertyOf mlips:hasReferenceSettings .

mlips:implementedIn a owl:ObjectProperty ;
    rdfs:label "implemented in"@en ;
    rdfs:comment "Links an implementation to the library that provides it."@en ;
    rdfs:domain mlips:Implementation ;
    rdfs:range mlips:Library .

mlips:metricProperty a owl:ObjectProperty ;
    rdfs:label "metric property"@en ;
    rdfs:domain mlips:AccuracyMetric ;
    rdfs:range mlips:MetricProperty .

mlips:metricType a owl:ObjectProperty ;
    rdfs:label "metric type"@en ;
    rdfs:domain mlips:AccuracyMetric ;
    rdfs:range mlips:MetricType .

mlips:supportsSimulation a owl:ObjectProperty ;
    rdfs:label "supports simulation"@en ;
    rdfs:comment "Links an MLIP method to the simulation types it supports."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range mlips:SimulationType .

mlips:targetMaterial a owl:ObjectProperty ;
    rdfs:label "target material"@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range mlips:MaterialSystem .

mlips:usedReferenceCode a owl:ObjectProperty ;
    rdfs:label "used reference code"@en ;
    rdfs:comment """The software code used to perform the
reference calculation (e.g., VASP, GPAW for DFT; Molpro, PySCF, ORCA
for wave-function methods). Generalises usedDFTCode."""@en ;
    rdfs:domain mlips:ReferenceSettings ;
    rdfs:range mlips:Library .

mlips:AtomicConfiguration a owl:Class ;
    rdfs:label "Atomic Configuration"@en ;
    rdfs:comment """A single atomic configuration (positions, cell,
properties) in a training dataset."""@en ;
    rdfs:subClassOf <https://purls.helmholtz-metadaten.de/cmso/AtomicStructure> .

mlips:BenchmarkStudy a owl:Class ;
    rdfs:label "Benchmark Study"@en ;
    rdfs:comment "A published study reporting MLIP evaluation results."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mlips:hasResult ;
            owl:someValuesFrom mlips:BenchmarkResult ],
        prov:Activity .

mlips:DFTCalculation a owl:Class ;
    rdfs:label "DFT Calculation"@en ;
    rdfs:comment """A density functional theory calculation that produced
reference data for training."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mlips:hasDFTSettings ;
            owl:someValuesFrom mlips:DFTSettings ],
        mdo:Calculation,
        mlips:ReferenceCalculation .

mlips:FunctionalForm a owl:Class ;
    rdfs:label "Functional Form"@en ;
    rdfs:comment "A parametrised mapping from an atomic configuration to an energy, specified independently of parameter values."@en .

mlips:LossFunction a owl:Class ;
    rdfs:label "Loss Function"@en ;
    rdfs:comment "A scalar objective whose minimisation fits the parameters of the functional form."@en .

mlips:SimulationType a owl:Class ;
    rdfs:label "Simulation Type"@en ;
    rdfs:comment """A type of atomistic simulation: molecular dynamics,
Monte Carlo, geometry optimization, phonon calculations,
thermodynamic integration, etc."""@en .

mlips:appliesMethod a owl:ObjectProperty ;
    rdfs:label "applies method"@en ;
    rdfs:comment "Links an MLIP run to the MLIP method it fits."@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range mlips:MLIPMethod .

mlips:hasAccuracyMetric a owl:ObjectProperty ;
    rdfs:label "has accuracy metric"@en ;
    rdfs:domain mlips:BenchmarkResult ;
    rdfs:range mlips:AccuracyMetric .

mlips:hasHyperparameter a owl:ObjectProperty ;
    rdfs:label "has hyperparameter"@en ;
    rdfs:comment "Links an MLIP method to a hyperparameter it accepts."@en ;
    rdfs:domain mlips:MLIPMethod ;
    rdfs:range mlips:Hyperparameter ;
    rdfs:subPropertyOf mls:hasHyperParameter .

mlips:hasResult a owl:ObjectProperty ;
    rdfs:label "has result"@en ;
    rdfs:domain mlips:BenchmarkStudy ;
    rdfs:range mlips:BenchmarkResult ;
    rdfs:subPropertyOf prov:generated .

mlips:runsOn a owl:ObjectProperty ;
    rdfs:label "runs on"@en ;
    rdfs:comment "Links an MLIP run to the training dataset it uses."@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range mlips:TrainingDataset ;
    rdfs:subPropertyOf prov:used .

mlips:Implementation a owl:Class ;
    rdfs:label "Implementation"@en ;
    rdfs:comment """A software implementation of an MLIP method in a
specific library and version."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mlips:implementedIn ;
            owl:someValuesFrom mlips:Library ],
        [ a owl:Restriction ;
            owl:onProperty [ a owl:ObjectProperty ;
                    owl:inverseOf mlips:hasImplementation ] ;
            owl:someValuesFrom mlips:MLIPMethod ],
        mls:Implementation,
        schema:SoftwareSourceCode .

mlips:hasReferenceSettings a owl:ObjectProperty ;
    rdfs:label "has reference settings"@en ;
    rdfs:comment """Links a reference calculation to its
method-specific settings. Generalises hasDFTSettings to wave-function
and other ab initio methods."""@en ;
    rdfs:domain mlips:ReferenceCalculation ;
    rdfs:range mlips:ReferenceSettings .

mlips:Library a owl:Class ;
    rdfs:label "Library"@en ;
    rdfs:comment """A software library or tool used in MLIP research
(e.g., ASE, LAMMPS, VASP, GPAW)."""@en ;
    rdfs:subClassOf schema:SoftwareApplication .

mlips:ReferenceCalculation a owl:Class ;
    rdfs:label "Reference Calculation"@en ;
    rdfs:comment """A first-principles calculation that produced
reference energies, forces, or stresses for MLIP training. Generalisation of
DFTCalculation that also covers wave-function methods (e.g., CCSD(T), MP2,
CASPT2) and other ab initio approaches."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mlips:hasReferenceSettings ;
            owl:someValuesFrom mlips:ReferenceSettings ],
        prov:Activity,
        mdo:Calculation .

mlips:AccuracyMetric a owl:Class ;
    rdfs:label "Accuracy Metric"@en ;
    rdfs:comment """An accuracy measure reported in a benchmark
(e.g., RMSE of energy, MAE of forces)."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass mlips:MetricType ;
            owl:onProperty mlips:metricType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty [ a owl:ObjectProperty ;
                    owl:inverseOf mlips:hasAccuracyMetric ] ;
            owl:someValuesFrom mlips:BenchmarkResult ],
        [ a owl:Restriction ;
            owl:onClass mlips:MetricProperty ;
            owl:onProperty mlips:metricProperty ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        qudt:QuantityValue .

mlips:DatasetProvenance a owl:Class ;
    rdfs:label "Dataset Provenance"@en ;
    rdfs:comment "The provenance type of a training dataset."@en .

mlips:MetricProperty a owl:Class ;
    rdfs:label "Metric Property"@en ;
    rdfs:comment "The physical property being measured (energy, force, stress)."@en .

mlips:MetricType a owl:Class ;
    rdfs:label "Metric Type"@en ;
    rdfs:comment "Type of accuracy metric (RMSE, MAE, R², etc.)."@en .

mlips:ReferenceSettings a owl:Class ;
    rdfs:label "Reference Settings"@en ;
    rdfs:comment """Settings of a reference calculation, abstracted
across method families. Concrete subclasses (DFTSettings, WaveFunctionSettings)
carry the method-specific parameters; the supertype carries cross-family slots
such as the software code used."""@en .

mlips:WaveFunctionSettings a owl:Class ;
    rdfs:label "Wave Function Settings"@en ;
    rdfs:comment """Settings of a wave-function-based reference
calculation: the method (e.g., CCSD(T), MP2), the basis set (e.g.,
cc-pVTZ, aug-cc-pVDZ), and frozen-core treatment."""@en ;
    rdfs:subClassOf mlips:ReferenceSettings .

mlips:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:comment "Links an MLIP run to the trained model it produces."@en ;
    rdfs:domain mlips:MLIPRun ;
    rdfs:range mlips:TrainedModel ;
    rdfs:subPropertyOf prov:generated .

mlips:AtomicEnvironmentDescriptor a owl:Class ;
    rdfs:label "Atomic Environment Descriptor"@en ;
    rdfs:comment "A mathematical representation of the local atomic environment used by an MLIP method."@en .

mlips:CoveredProperty a owl:Class ;
    rdfs:label "Covered Property"@en ;
    rdfs:comment """A physical property covered by the training dataset
(energy, forces, stresses, virials)."""@en .

mlips:MaterialSystem a owl:Class ;
    rdfs:label "Material System"@en ;
    rdfs:comment """A material system studied in a dataset: element, alloy,
compound, or complex microstructure."""@en ;
    rdfs:subClassOf <https://purls.helmholtz-metadaten.de/cmso/CrystallineMaterial>,
        mdo:Material .

mlips:TrainedModel a owl:Class ;
    rdfs:label "Trained Model"@en ;
    rdfs:comment """The concrete artifact produced by fitting an MLIP method
on a specific dataset with specific hyperparameter settings---the learned
parameters (weights) that can be used for prediction."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ a owl:ObjectProperty ;
                    owl:inverseOf mlips:produces ] ;
            owl:someValuesFrom mlips:MLIPRun ],
        mls:Model,
        prov:Entity .

mlips:DFTSettings a owl:Class ;
    rdfs:label "DFT Settings"@en ;
    rdfs:comment """Settings of a DFT calculation: exchange-correlation
functional, k-point mesh, energy cutoff, pseudopotential type."""@en ;
    rdfs:subClassOf mlips:ReferenceSettings .

mlips:HyperparameterSetting a owl:Class ;
    rdfs:label "Hyperparameter Setting"@en ;
    rdfs:comment """A concrete value assigned to a hyperparameter in a
specific training run or configuration."""@en ;
    rdfs:subClassOf mls:HyperParameterSetting .

mlips:MLIPRun a owl:Class ;
    rdfs:label "MLIP Run"@en ;
    rdfs:comment "A concrete fitting activity for an MLIP method: it applies an MLIP method to a training dataset and produces a trained model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass mlips:TrainedModel ;
            owl:onProperty mlips:produces ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass mlips:MLIPMethod ;
            owl:onProperty mlips:appliesMethod ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass mlips:TrainingDataset ;
            owl:onProperty mlips:runsOn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        prov:Activity .

mlips:BenchmarkResult a owl:Class ;
    rdfs:label "Benchmark Result"@en ;
    rdfs:comment """A single evaluation result: an MLIP method applied to a
material system with specific hyperparameters, reporting accuracy metrics."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass mlips:TrainedModel ;
            owl:onProperty mlips:evaluatesModel ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty mlips:targetMaterial ;
            owl:someValuesFrom mlips:MaterialSystem ],
        [ a owl:Restriction ;
            owl:onProperty mlips:hasAccuracyMetric ;
            owl:someValuesFrom mlips:AccuracyMetric ],
        [ a owl:Restriction ;
            owl:onProperty [ a owl:ObjectProperty ;
                    owl:inverseOf mlips:hasResult ] ;
            owl:someValuesFrom mlips:BenchmarkStudy ],
        prov:Entity .

mlips:Hyperparameter a owl:Class ;
    rdfs:label "Hyperparameter"@en ;
    rdfs:comment """A hyperparameter of an MLIP method, with its name,
data type, range, and default value."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ a owl:ObjectProperty ;
                    owl:inverseOf mlips:hasHyperparameter ] ;
            owl:someValuesFrom mlips:MLIPMethod ],
        mls:HyperParameter .

mlips:TrainingDataset a owl:Class ;
    rdfs:label "Training Dataset"@en ;
    rdfs:comment """A dataset of atomic configurations used for MLIP
training, with provenance, size, property coverage, and DFT settings."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mlips:coversProperty ;
            owl:someValuesFrom mlips:CoveredProperty ],
        [ a owl:Restriction ;
            owl:onProperty mlips:hasConfiguration ;
            owl:someValuesFrom mlips:AtomicConfiguration ],
        [ a owl:Restriction ;
            owl:onProperty mlips:coversMaterial ;
            owl:someValuesFrom mlips:MaterialSystem ],
        [ a owl:Restriction ;
            owl:onProperty mlips:datasetProvenance ;
            owl:someValuesFrom mlips:DatasetProvenance ],
        mls:Dataset,
        prov:Entity .

mlips:MLIPMethod a owl:Class ;
    rdfs:label "MLIP Method"@en ;
    rdfs:comment """A machine learning interatomic potential method family
(e.g., MACE, ACE, HDNNP, NequIP, M3GNet, MTP). Specifies a functional form,
a loss function, and a training algorithm. Disjoint from mls:Algorithm."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mlips:hasFunctionalForm ;
            owl:someValuesFrom mlips:FunctionalForm ],
        [ a owl:Restriction ;
            owl:onProperty mlips:hasTrainingAlgorithm ;
            owl:someValuesFrom mls:Algorithm ],
        [ a owl:Restriction ;
            owl:onProperty mlips:hasHyperparameter ;
            owl:someValuesFrom mlips:Hyperparameter ],
        [ a owl:Restriction ;
            owl:onProperty mlips:hasLossFunction ;
            owl:someValuesFrom mlips:LossFunction ],
        [ a owl:Restriction ;
            owl:onProperty mlips:supportsSimulation ;
            owl:someValuesFrom mlips:SimulationType ] ;
    owl:disjointWith mls:Algorithm .

