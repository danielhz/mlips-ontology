<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:mlips="https://w3id.org/mlips#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="https://schema.org/"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/mlips#chemicalFormula">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">chemical formula</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasLossFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has loss function</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to the loss function whose minimisation fits its parameters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#LossFunction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf589683756ba45f6b26b64e886e1b9fb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasTrainingAlgorithm"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/mls#Algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isSettingOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is setting of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:hasHyperparameterSetting.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#hasHyperparameterSetting"/>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPRun"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N81c73d78050e48bdb545fc9a3cf22cc5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasWaveFunctionSettings"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#WaveFunctionSettings"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasDFTCalculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has DFT calculation</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/mlips#hasReferenceCalculation"/>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#DFTCalculation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#coversMaterial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">covers material</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#supportsSimulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">supports simulation</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to the simulation types it supports.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#SimulationType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#cutoffRadius">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">cutoff radius</rdfs:label>
    <rdfs:comment xml:lang="en">Cutoff radius for atomic interactions, in angstroms.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainingDuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">training duration</rdfs:label>
    <rdfs:comment xml:lang="en">Measured wall-clock training time (hours).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips">
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-3661-5870"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-3050-6291"/>
