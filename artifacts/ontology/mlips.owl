  <rdf:Description rdf:about="https://w3id.org/mlips#SimulationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Simulation Type</rdfs:label>
    <rdfs:comment xml:lang="en">A type of atomistic simulation: molecular dynamics,
Monte Carlo, geometry optimization, phonon calculations,
thermodynamic integration, etc.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#sameAsWikidata">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">same as Wikidata</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to its corresponding Wikidata item.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
  </rdf:Description>
