    <schema:name>Lifang Zhu</schema:name>
    <rdf:type rdf:resource="https://schema.org/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd4a0e0921e7047279b6bddb2a1e3211e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#supportsSimulation"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#SimulationType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne0d8e72ce8b34970b4ec5ebe0d2e2e2b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#produces"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#SymmetryFunctionDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">Symmetry Function Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Behler-Parrinello symmetry functions; used by HDNNP.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Augmented">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#DatasetProvenance"/>
    <rdfs:label xml:lang="en">Augmented</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset augmented from existing sources.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to the atomic environment descriptor it uses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#AccuracyMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Accuracy Metric</rdfs:label>
    <rdfs:comment xml:lang="en">An accuracy measure reported in a benchmark
(e.g., RMSE of energy, MAE of forces).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:subClassOf rdf:nodeID="Nb0a80e03c410425299ab85b92d543ffb"/>
    <rdfs:subClassOf rdf:nodeID="N5a36213443cc4858b02a5456d62412de"/>
    <rdfs:subClassOf rdf:nodeID="N32659a47536a4931b4ea09cbbdddb52c"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#ReifiedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5d6067fa00124052beafa322ad855290">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#isImplementationOf"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#dftBasisSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">DFT basis set</rdfs:label>
    <rdfs:comment xml:lang="en">The basis set used by an all-electron or
localised-basis DFT calculation (FHI-aims NAO, LAPW, Gaussian-type
orbitals such as cc-pVDZ or 6-31G). Plane-wave codes specify the basis
through mlips:energyCutoff and leave this slot empty.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#DftBasisSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasTrainingRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has training run</rdfs:label>
    <rdfs:comment xml:lang="en">Optional link from an MLIP run to an ML-Schema run recording the training algorithm execution.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/mls#Run"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Library">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Library</rdfs:label>
    <rdfs:comment xml:lang="en">A software library or tool used in MLIP research
(e.g., ASE, LAMMPS, VASP, GPAW).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://schema.org/SoftwareApplication"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N32659a47536a4931b4ea09cbbdddb52c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#isMetricOf"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#StressProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricProperty"/>
    <rdfs:label xml:lang="en">Stress</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#wfMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">wave-function method</rdfs:label>
    <rdfs:comment xml:lang="en">The wave-function correlation method used
to produce reference data (e.g., HF, MP2, CCSD, CCSD(T), DLPNO-CCSD(T),
CASPT2, NEVPT2). Range is WfMethod; concrete methods are named
individuals in mlips-vocab.ttl.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#WaveFunctionSettings"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#WfMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#RMSE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricType"/>
    <rdfs:label xml:lang="en">RMSE</rdfs:label>
    <rdfs:comment xml:lang="en">Root Mean Square Error.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#DatasetProvenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dataset Provenance</rdfs:label>
    <rdfs:comment xml:lang="en">The provenance type of a training dataset.</rdfs:comment>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">trained with</rdfs:label>
    <rdfs:comment xml:lang="en">Shortcut: links a trained model directly to the MLIP method it applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <owl:propertyChainAxiom rdf:nodeID="N740c78efe5bc41a2b04894eca8f11714"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MaterialSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Material System</rdfs:label>
    <rdfs:comment xml:lang="en">A material system studied in a dataset: element, alloy,
compound, or complex microstructure.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/cmso/CrystallineMaterial"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mdo/core/Material"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
