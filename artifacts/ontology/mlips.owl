    <owl:imports rdf:resource="http://www.w3.org/ns/mls"/>
    <rdfs:label>MLIPs Ontology: An Ontology for Machine Learning Interatomic Potentials</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
