  <rdf:Description rdf:about="https://w3id.org/mlips#LossFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Loss Function</rdfs:label>
    <rdfs:comment xml:lang="en">A scalar objective whose minimisation fits the parameters of the functional form.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
