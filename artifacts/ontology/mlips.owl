  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#SymmetryFunctionDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">Symmetry Function Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Behler-Parrinello symmetry functions; used by HDNNP.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#ReferenceCalculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reference Calculation</rdfs:label>
    <rdfs:comment xml:lang="en">A first-principles calculation that produced
reference energies, forces, or stresses for MLIP training. Generalisation of
DFTCalculation that also covers wave-function methods (e.g., CCSD(T), MP2,
CASPT2) and other ab initio approaches.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mdo/core/Calculation"/>
    <rdfs:subClassOf rdf:nodeID="N9b1b435325e143ae8de786b43dbed174"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N33123f076f884429a64d5f7ca2db1ca4">
