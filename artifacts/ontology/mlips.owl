<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:mlips="https://w3id.org/mlips#"
   xmlns:ns1="http://purl.org/vocommons/voaf#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="https://schema.org/"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/mlips#SOAPDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">SOAP Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Smooth Overlap of Atomic Positions; used by GAP.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#TrainedModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trained Model</rdfs:label>
    <rdfs:comment xml:lang="en">The concrete artifact produced by fitting an MLIP method
on a specific dataset with specific hyperparameter settings---the learned
parameters (weights) that can be used for prediction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b23"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/mls#Model"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#BenchmarkStudy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Benchmark Study</rdfs:label>
    <rdfs:comment xml:lang="en">A published study reporting MLIP evaluation results.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b16"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isMetricOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is metric of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:hasAccuracyMetric.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#AccuracyMetric"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#hasAccuracyMetric"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b32">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#targetMaterial"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#forHyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">for hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">Links a setting to the hyperparameter it configures.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#TrainingDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Training Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">A dataset of atomic configurations used for MLIP
training, with provenance, size, property coverage, and DFT settings.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b26"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b27"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b28"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b29"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/mls#Dataset"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#inferenceComplexity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">inference complexity</rdfs:label>
    <rdfs:comment xml:lang="en">Asymptotic computational complexity of inference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#RMSE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricType"/>
    <rdfs:label xml:lang="en">RMSE</rdfs:label>
    <rdfs:comment xml:lang="en">Root Mean Square Error.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasReferenceCalculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has reference calculation</rdfs:label>
    <rdfs:comment xml:lang="en">Links a training dataset to the
first-principles calculation that produced its reference data.
Generalises hasDFTCalculation to wave-function and other ab initio
methods.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#ReferenceCalculation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#DFTCalculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">DFT Calculation</rdfs:label>
    <rdfs:comment xml:lang="en">A density functional theory calculation that produced
reference data for training.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b15"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mdo/calculation/Calculation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#ReferenceCalculation"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#SubordinateSortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/mls#Algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Algorithm (W3C ML-Schema)</rdfs:label>
    <rdfs:comment xml:lang="en">External: the W3C Machine Learning Schema Algorithm class.
Used as the range of mlips:hasTrainingAlgorithm so an MLIP method can
delegate the training-algorithm side to ML-Schema.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#numLayers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">number of layers</rdfs:label>
    <rdfs:comment xml:lang="en">Number of layers in the neural network architecture.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b30">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#isResultOf"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#BenchmarkStudy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b2">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Xi Zhang</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#chemicalFormula">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">chemical formula</rdfs:label>
    <rdfs:comment xml:lang="en">Chemical formula of a material system, written in standard nomenclature (e.g., "TiCr2", "Si", "H2O").</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#energyCutoff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">energy cutoff</rdfs:label>
    <rdfs:comment xml:lang="en">Plane-wave energy cutoff in eV.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Forces">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#CoveredProperty"/>
    <rdfs:label xml:lang="en">Forces</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#evaluatesModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evaluates model</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark result to the trained model being evaluated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#TrainedModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips">
    <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>MLIPs Ontology: An Ontology for Machine Learning Interatomic Potentials</rdfs:label>
    <dcterms:contributor rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b1"/>
    <dcterms:contributor rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b2"/>
    <dcterms:contributor rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b3"/>
    <dcterms:contributor rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b4"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9176-3270"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-0780-4154"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-3661-5870"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1486-1197"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-2740-8172"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-3050-6291"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0009-0001-4894-0195"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-3860-8388"/>
    <dcterms:contributor rdf:resource="https://orcid.org/0009-0009-9043-2491"/>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0002-2409-975X"/>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0002-7896-0875"/>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0003-4281-5665"/>
    <dcterms:description>An OWL ontology capturing the concepts needed to describe machine learning interatomic potentials: algorithm families, hyperparameters, training datasets with DFT provenance, and published benchmarks.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-10</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-01</dcterms:modified>
    <dcterms:publisher rdf:resource="http://www.wikidata.org/entity/Q131785081"/>
    <dcterms:title>MLIPs Ontology: An Ontology for Machine Learning Interatomic Potentials</dcterms:title>
    <vann:preferredNamespacePrefix>mlips</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/mlips#</vann:preferredNamespaceUri>
    <ns1:metadataVoc rdf:resource="http://purl.org/dc/terms/"/>
    <ns1:metadataVoc rdf:resource="http://purl.org/vocab/vann/"/>
    <ns1:reliesOn rdf:resource="http://qudt.org/schema/qudt/"/>
    <ns1:reliesOn rdf:resource="http://www.w3.org/ns/mls#"/>
    <ns1:reliesOn rdf:resource="http://www.w3.org/ns/prov#"/>
    <ns1:reliesOn rdf:resource="https://purls.helmholtz-metadaten.de/cmso/"/>
    <ns1:reliesOn rdf:resource="https://schema.org/"/>
    <ns1:reliesOn rdf:resource="https://w3id.org/mdo/calculation/"/>
    <ns1:reliesOn rdf:resource="https://w3id.org/mdo/core/"/>
    <rdfs:comment>An OWL ontology capturing the concepts needed to describe machine learning interatomic potentials: algorithm families, hyperparameters, training datasets with DFT provenance, and published benchmarks.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://qudt.org/schema/qudt/"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/mdo/core/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/mls"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
    <owl:versionIRI rdf:resource="https://w3id.org/mlips/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isSettingOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is setting of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:hasHyperparameterSetting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#hasHyperparameterSetting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainingComplexity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">training complexity</rdfs:label>
    <rdfs:comment xml:lang="en">Asymptotic computational complexity of training.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#dftBasisSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">DFT basis set</rdfs:label>
    <rdfs:comment xml:lang="en">The basis set used by an all-electron or
localised-basis DFT calculation (FHI-aims NAO, LAPW, Gaussian-type
orbitals such as cc-pVDZ or 6-31G). Plane-wave codes specify the basis
through mlips:energyCutoff and leave this slot empty.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#DftBasisSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasHyperparameterSetting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has hyperparameter setting</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP run to a concrete hyperparameter setting used in that run.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#coversProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">covers property</rdfs:label>
    <rdfs:comment xml:lang="en">Links a training dataset to a physical property whose reference values it contains (e.g., mlips:Energy, mlips:Forces, mlips:Stresses).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#CoveredProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isProducedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is produced by</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:produces.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#produces"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#metricProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">metric property</rdfs:label>
    <rdfs:comment xml:lang="en">Links an accuracy metric to the physical property it measures (e.g., mlips:EnergyProperty, mlips:ForceProperty).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#AccuracyMetric"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MetricProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasReferenceSettings"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#ReferenceSettings"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#ArchitecturalHyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Architectural Hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">A hyperparameter that specifies the model
architecture. Not disjoint with PhysicalHyperparameter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#DatasetProvenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dataset Provenance</rdfs:label>
    <rdfs:comment xml:lang="en">The provenance type of a training dataset.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#frozenCore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">frozen core</rdfs:label>
    <rdfs:comment xml:lang="en">Whether core electrons are kept frozen
during the post-Hartree-Fock correlation treatment in a wave-function
calculation. True for the standard frozen-core approximation; false
for all-electron correlation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#WaveFunctionSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasTrainingAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has training algorithm</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to the ML-Schema algorithm used to fit its functional form.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/mls#Algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#wfMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">wave-function method</rdfs:label>
    <rdfs:comment xml:lang="en">The wave-function correlation method used
to produce reference data (e.g., HF, MP2, CCSD, CCSD(T), DLPNO-CCSD(T),
CASPT2, NEVPT2). Range is WfMethod; concrete methods are named
individuals in mlips-vocab.ttl.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#WaveFunctionSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#WfMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#ReifiedRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetaSort"/>
    <rdfs:label xml:lang="en">Reified Relation</rdfs:label>
    <rdfs:comment xml:lang="en">A class that reifies an n-ary relation
between sortals. Instances have no identity outside their relata.
OntoClean profile: ~R, -I, -U, +D.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/metasort"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#sameAsWikidata">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">same as Wikidata</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to its corresponding Wikidata item.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/cross"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#produces">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">produces</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP run to the trained model it produces.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isImplementationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is implementation of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:hasImplementation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Implementation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#hasImplementation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips/module/training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Training Data Module</rdfs:label>
    <dcterms:description xml:lang="en">The Training Data module describes the reference data a potential is fitted to: the training datasets, the configurations they contain, the physical properties they cover, the sampling strategy, and the first-principles provenance of the labels. In the running example it captures the 3766-configuration C14 training set, drawn by active learning and labelled with VASP using PAW pseudopotentials and the PBE functional at a 400 eV plane-wave cutoff, covering energies, forces, and stresses.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MLIPMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MLIP Method</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning interatomic potential method family
(e.g., MACE, ACE, HDNNP, NequIP, M3GNet, MTP). Specifies a functional form,
a loss function, and a training algorithm. Disjoint from mls:Algorithm.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b37"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b38"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b39"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b40"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b41"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/mls#Algorithm"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips/module/algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Algorithm Module</rdfs:label>
    <dcterms:description xml:lang="en">The Algorithm module describes the machine-learning interatomic potential itself: its functional form and atomic-environment descriptor, the hyperparameters that size and bound that descriptor, the loss it is fitted with, and the software that implements it. In the running example it captures the Moment Tensor Potential (MTP) used for TiCr2-H, fitted with the MLIP-2 package, with hyperparameters such as the moment level and the cutoff radius.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#PhysicalHyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Physical Hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">A hyperparameter that has a direct physical
meaning. Not disjoint with ArchitecturalHyperparameter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#R2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricType"/>
    <rdfs:label xml:lang="en">R²</rdfs:label>
    <rdfs:comment xml:lang="en">Coefficient of determination.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasDFTSettings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has DFT settings</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DFT calculation to the DFT settings used (XC functional, pseudopotential, k-point mesh, energy cutoff). Subproperty of mlips:hasReferenceSettings.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTCalculation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/mlips#hasReferenceSettings"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#implementedIn"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#Library"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#maxValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">maximum value</rdfs:label>
    <rdfs:comment xml:lang="en">Upper bound of a hyperparameter's permitted value range, used to validate hyperparameter settings before training.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/mlips#MetricType"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#metricType"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#learningRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">learning rate</rdfs:label>
    <rdfs:comment xml:lang="en">Learning rate used during model training.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#AtomicClusterExpansionDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">Atomic Cluster Expansion Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Atomic cluster expansion; used by ACE.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#implementedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">implemented in</rdfs:label>
    <rdfs:comment xml:lang="en">Links an implementation to the library that provides it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Implementation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#Library"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasAccuracyMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has accuracy metric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark result to one of its accuracy metrics (e.g., energy RMSE, force RMSE). A benchmark result may carry several metrics for different physical properties.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#AccuracyMetric"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to the atomic environment descriptor it uses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MaterialSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Material System</rdfs:label>
    <rdfs:comment xml:lang="en">A material system studied in a dataset: element, alloy,
compound, or complex microstructure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/cmso/CrystallineMaterial"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mdo/core/Material"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#CoveredProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Covered Property</rdfs:label>
    <rdfs:comment xml:lang="en">A physical property covered by the training dataset
(energy, forces, stresses, virials).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b38">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#supportsSimulation"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#SimulationType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Library">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Library</rdfs:label>
    <rdfs:comment xml:lang="en">A software library or tool used in MLIP research
(e.g., ASE, LAMMPS, VASP, GPAW).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/SoftwareApplication"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasImplementation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has implementation</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to a software implementation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#Implementation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/schema/qudt/Unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Unit (QUDT)</rdfs:label>
    <rdfs:comment xml:lang="en">External: the QUDT Unit class. Used as the range of
mlips:hasUnit so a numeric metric or hyperparameter setting can carry
its physical unit through a QUDT IRI.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0009-0001-4894-0195">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Tom Schächtel</schema:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b28">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#coversMaterial"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#minValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">minimum value</rdfs:label>
    <rdfs:comment xml:lang="en">Lower bound of a hyperparameter's permitted value range, used to validate hyperparameter settings before training.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b34">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#runsOn"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#supportsParallelization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">supports parallelization</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the MLIP method has at least one implementation with parallel execution support (MPI, multi-threading, or domain decomposition).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#SamplingStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sampling Strategy</rdfs:label>
    <rdfs:comment xml:lang="en">A strategy used to sample the atomic
configurations in a training dataset (e.g., chemical sampling across
compositions, vibrational sampling across thermal snapshots, or a
combination). Concrete sampling strategies are modeled as instances and
will be developed in future work; this class is left open as an
extension point.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has result</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark study to one of its benchmark results. A study typically reports several results, one per (model, material, accuracy-metric) tuple.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkStudy"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#supportsGPU">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">supports GPU</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the MLIP method has at least one implementation that runs on GPU.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasLossFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has loss function</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to the loss function whose minimisation fits its parameters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#LossFunction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#WaveFunctionSettings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wave Function Settings</rdfs:label>
    <rdfs:comment xml:lang="en">Settings of a wave-function-based reference
calculation: the method (e.g., CCSD(T), MP2), the basis set (e.g.,
cc-pVTZ, aug-cc-pVDZ), and frozen-core treatment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#ReferenceSettings"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#ReifiedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#EquivariantMessagePassingDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">Equivariant Message Passing Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Equivariant message-passing representation; used by MACE and NequIP.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#InHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#DatasetProvenance"/>
    <rdfs:label xml:lang="en">In-house</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset generated by in-house calculations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#XCFunctional">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Exchange-Correlation Functional</rdfs:label>
    <rdfs:comment xml:lang="en">A density-functional approximation to the
exchange-correlation energy used in a DFT calculation (e.g., LDA, PBE,
PBE0, HSE06, SCAN, BLYP, omegaB97X). Range of mlips:xcFunctional on
DFTSettings. Concrete functionals are modelled as named individuals;
an open extension point.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#usesTrainingData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses training data</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark result to the training dataset used to fit the evaluated model. Redundant with the result's evaluatesModel chain when the run is resolved, useful when the result is reported without that chain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#supportsSimulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">supports simulation</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to the simulation types it supports.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#SimulationType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#DeepPotentialDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">Deep Potential Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Local environment descriptor used by the Deep Potential
family (DeepMD, DeePMD-kit). Represents each atom's neighborhood as a
matrix of relative coordinates, optionally embedded through a learnable
neural network before being passed to the per-atom regressor.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hyperparameterName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">hyperparameter name</rdfs:label>
    <rdfs:comment xml:lang="en">Short identifier of a hyperparameter (e.g., "r_cut", "levmax", "learning_rate"). Used by tools that key on the name rather than the IRI.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#xcFunctional">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">exchange-correlation functional</rdfs:label>
    <rdfs:comment xml:lang="en">The exchange-correlation functional used in
a DFT calculation (e.g., LDA, PBE, PBE0, HSE06, SCAN, omegaB97X). Range
is XCFunctional; concrete functionals are named individuals in
mlips-vocab.ttl.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#XCFunctional"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#isHyperparameterOf"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">trained with</rdfs:label>
    <rdfs:comment xml:lang="en">Shortcut: links a trained model directly to the MLIP method it applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <owl:propertyChainAxiom rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b12"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Stresses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#CoveredProperty"/>
    <rdfs:label xml:lang="en">Stresses</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Organization (schema.org)</rdfs:label>
    <rdfs:comment xml:lang="en">External: the schema.org Organization class. Used to type
publisher and affiliation IRIs in the ontology metadata header.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-0780-4154">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Steffen Staab</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#inferenceHardware">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">inference hardware</rdfs:label>
    <rdfs:comment xml:lang="en">Hardware platform on which inference timings were measured (e.g., "NVIDIA A100", "Intel Xeon Gold 6230R").</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Sortal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetaSort"/>
    <rdfs:label xml:lang="en">Sortal</rdfs:label>
    <rdfs:comment xml:lang="en">A class whose instances carry their own
identity criteria, rigid, with unity, not externally dependent.
OntoClean profile: +R, +I, +U, -D.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/metasort"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#DftBasisSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">DFT Basis Set</rdfs:label>
    <rdfs:comment xml:lang="en">The basis set used in a DFT calculation,
when the code is all-electron or otherwise uses a localised basis (e.g.,
FHI-aims NAO families, LAPW, Gaussian-type orbitals such as cc-pVDZ
or 6-31G). Range of mlips:dftBasisSet on DFTSettings. Plane-wave
codes specify the basis through mlips:energyCutoff instead and leave
this slot empty. Concrete basis sets are modelled as named individuals;
an open extension point.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MLIPRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MLIP Run</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete fitting activity for an MLIP method: it applies an MLIP method to a training dataset and produces a trained model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b34"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b35"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b36"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#SubordinateSortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#pseudopotentialType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">pseudopotential type</rdfs:label>
    <rdfs:comment xml:lang="en">The family of pseudopotentials used in a
plane-wave DFT calculation (PAW, ultrasoft, norm-conserving). All-
electron codes leave this slot empty and use mlips:dftBasisSet
instead.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#PseudopotentialType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MetaSort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Meta-Sort</rdfs:label>
    <rdfs:comment xml:lang="en">An OntoClean-style meta-category used to
classify classes of the ontology. The four named individuals
mlips:Sortal, mlips:SubordinateSortal, mlips:Role, and
mlips:ReifiedRelation exhaustively partition the schema.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/metasort"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Implementation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Implementation</rdfs:label>
    <rdfs:comment xml:lang="en">A software implementation of an MLIP method in a
specific library and version.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b17"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b18"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/mls#Implementation"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/SoftwareSourceCode"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#SubordinateSortal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b12">
    <rdf:first rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b11"/>
    <rdf:rest rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b13"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b16">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasResult"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/mls#Run">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Run (W3C ML-Schema)</rdfs:label>
    <rdfs:comment xml:lang="en">External: the W3C Machine Learning Schema Run class.
Used as the range of mlips:hasTrainingRun so an MLIPRun can delegate
its underlying training-run details to ML-Schema.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#numAngularBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">number of angular basis functions</rdfs:label>
    <rdfs:comment xml:lang="en">Number of angular basis functions in the descriptor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#metricValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">metric value</rdfs:label>
    <rdfs:comment xml:lang="en">Numerical value of an accuracy metric (e.g., 3.17 for an energy RMSE of 3.17 meV/atom). Paired with mlips:hasUnit for the physical unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#AccuracyMetric"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#StressProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricProperty"/>
    <rdfs:label xml:lang="en">Stress</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#WfMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wave Function Method</rdfs:label>
    <rdfs:comment xml:lang="en">A wave-function correlation method used to
produce reference data (e.g., HF, MP2, CCSD, CCSD(T), DLPNO-CCSD(T),
CASPT2, NEVPT2). Range of mlips:wfMethod on WaveFunctionSettings.
Concrete methods are modelled as named individuals; an open
extension point.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#numConfigurations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">number of configurations</rdfs:label>
    <rdfs:comment xml:lang="en">Total number of atomic configurations in a training dataset. Counts every distinct (cell, atomic positions, atomic types) triple.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#HyperparameterSetting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hyperparameter Setting</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete value assigned to a hyperparameter in a
specific training run or configuration.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b24"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/mls#HyperParameterSetting"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#ReifiedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#runsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">runs on</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP run to the training dataset it uses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#AccuracyMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Accuracy Metric</rdfs:label>
    <rdfs:comment xml:lang="en">An accuracy measure reported in a benchmark
(e.g., RMSE of energy, MAE of forces).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b20"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b21"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b22"/>
    <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#ReifiedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#TrainingHyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Training Hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">A hyperparameter of the training procedure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#isProducedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MLIPRun"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Hyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">A hyperparameter of an MLIP method, with its name,
data type, range, and default value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b25"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/mls#HyperParameter"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasHyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to a hyperparameter it accepts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/mls#hasHyperParameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#wasRunBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">was run by</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:runsOn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#runsOn"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b40">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasHyperparameter"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0009-0003-3860-8388">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Xin Li</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MetricProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Metric Property</rdfs:label>
    <rdfs:comment xml:lang="en">The physical property being measured (energy, force, stress).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasWaveFunctionSettings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has wave function settings</rdfs:label>
    <rdfs:comment xml:lang="en">Links a wave-function calculation to the settings used (wave-function method, basis set, frozen-core treatment). Subproperty of mlips:hasReferenceSettings.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#WaveFunctionCalculation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#WaveFunctionSettings"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/mlips#hasReferenceSettings"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b31">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasAccuracyMetric"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#AccuracyMetric"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.wikidata.org/entity/Q131785081">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <schema:name>Institute for Artificial Intelligence (KI)</schema:name>
    <schema:parentOrganization rdf:resource="http://www.wikidata.org/entity/Q122453"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Virials">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#CoveredProperty"/>
    <rdfs:label xml:lang="en">Virials</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#WaveFunctionCalculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wave Function Calculation</rdfs:label>
    <rdfs:comment xml:lang="en">A wave-function-based reference calculation
(e.g., Hartree-Fock, MP2, CCSD, CCSD(T), CASPT2). An alternative to
DFTCalculation as a source of reference data, typically more accurate but
more expensive.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b14"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#ReferenceCalculation"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#SubordinateSortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasDFTCalculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has DFT calculation</rdfs:label>
    <rdfs:comment xml:lang="en">Links a training dataset to a DFT calculation that produced its reference data. Subproperty of mlips:hasReferenceCalculation; specialised to the DFT subclass.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#DFTCalculation"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/mlips#hasReferenceCalculation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Published">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#DatasetProvenance"/>
    <rdfs:label xml:lang="en">Published</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset from a published source.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MomentTensorDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">Moment Tensor Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Invariant moment tensors of the neighborhood; used by MTP.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#numRadialBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">number of radial basis functions</rdfs:label>
    <rdfs:comment xml:lang="en">Number of radial basis functions in the descriptor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#datasetProvenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dataset provenance</rdfs:label>
    <rdfs:comment xml:lang="en">Links a training dataset to its provenance category (e.g., mlips:Published, mlips:InHouse, mlips:Augmented), capturing whether the data is from a literature source, generated locally, or built by augmenting an existing source.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#DatasetProvenance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isHyperparameterOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is hyperparameter of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:hasHyperparameter.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#hasHyperparameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isEvaluatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is evaluated in</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:evaluatesModel.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#evaluatesModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#ForceProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricProperty"/>
    <rdfs:label xml:lang="en">Force</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#samplingStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">sampling strategy</rdfs:label>
    <rdfs:comment xml:lang="en">Records the sampling strategy or strategies
used to construct a training dataset. Optional and multi-valued: a
dataset may combine several sampling strategies (e.g., chemical and
vibrational).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#SamplingStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#produces"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0000-0003-2740-8172">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Lifang Zhu</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#gpuHours">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">GPU hours</rdfs:label>
    <rdfs:comment xml:lang="en">Total GPU-hours consumed by an MLIP run (number of GPUs times wall-clock hours of GPU time). A measured cost.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#DFTSettings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">DFT Settings</rdfs:label>
    <rdfs:comment xml:lang="en">Settings of a DFT calculation: exchange-correlation
functional, k-point mesh, energy cutoff, pseudopotential type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#ReferenceSettings"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#ReifiedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips/module/cross">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Cross-Module Properties</rdfs:label>
    <dcterms:description xml:lang="en">The Cross-Module Properties bridge the three domain modules: they link an MLIP run to the method it applies and the trained model it produces, so that a benchmark result can be traced back through its run to the originating method and training data. In the running example they connect the MTP, its training run on the C14 dataset, and the benchmarked model.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#metaSort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">meta sort</rdfs:label>
    <rdfs:comment xml:lang="en">Attaches an OntoClean-style meta-category
(an instance of mlips:MetaSort) to a class of the ontology.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/metasort"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MetaSort"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#isImplementationOf"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#inferenceTimePerAtom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">inference time per atom</rdfs:label>
    <rdfs:comment xml:lang="en">Inference time per atom (microseconds).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#coversMaterial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">covers material</rdfs:label>
    <rdfs:comment xml:lang="en">Links a training dataset to a material system whose atomic configurations it contains. A dataset may cover several material systems (e.g., a high-entropy alloy plus its constituent unaries).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Energy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#CoveredProperty"/>
    <rdfs:label xml:lang="en">Energy</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#kPointMesh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">k-point mesh</rdfs:label>
    <rdfs:comment xml:lang="en">K-point mesh specification (e.g., '4x4x4').</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has unit</rdfs:label>
    <rdfs:comment xml:lang="en">Links a numeric value to its QUDT unit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/cross"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasFunctionalForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has functional form</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to its parametrised functional form.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#FunctionalForm"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b1">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Xiang Xu</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#reportedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">reported in</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark study to the scholarly article that reports it (a schema:ScholarlyArticle).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://schema.org/ScholarlyArticle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainingHardware">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">training hardware</rdfs:label>
    <rdfs:comment xml:lang="en">Hardware platform on which an MLIP run was trained (e.g., "NVIDIA V100", "AMD EPYC 7763"). Recorded as free text alongside the wall-clock and GPU-hour metadata.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#MAE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricType"/>
    <rdfs:label xml:lang="en">MAE</rdfs:label>
    <rdfs:comment xml:lang="en">Mean Absolute Error.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#AtomicEnvironmentDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Atomic Environment Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematical representation of the local atomic environment used by an MLIP method.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b20">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/mlips#MetricProperty"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#metricProperty"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#usedReferenceCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">used reference code</rdfs:label>
    <rdfs:comment xml:lang="en">The software code used to perform the
reference calculation (e.g., VASP, GPAW for DFT; Molpro, PySCF, ORCA
for wave-function methods). Generalises usedDFTCode.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#ReferenceSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#Library"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#targetMaterial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">target material</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark result to the material system on which the model was evaluated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Person (schema.org)</rdfs:label>
    <rdfs:comment xml:lang="en">External: the schema.org Person class. Used to type
authors and contributors in the ontology metadata header and in per-paper
canonicals via schema:author.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#isResultOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is result of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of mlips:hasResult.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#BenchmarkStudy"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#hasResult"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasReferenceSettings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has reference settings</rdfs:label>
    <rdfs:comment xml:lang="en">Links a reference calculation to its
method-specific settings. Generalises hasDFTSettings to wave-function
and other ab initio methods.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#ReferenceCalculation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#ReferenceSettings"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#coversProperty"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#CoveredProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#usesAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses algorithm</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark result to the MLIP method whose trained model is being evaluated. Redundant with the result's evaluatesModel chain when the model is identified, useful when the result is reported without resolving back to the run.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#materialClass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">material class</rdfs:label>
    <rdfs:comment xml:lang="en">E.g., element, binary alloy, ternary compound, HEA.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#ReferenceCalculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reference Calculation</rdfs:label>
    <rdfs:comment xml:lang="en">A first-principles calculation that produced
reference energies, forces, or stresses for MLIP training. Generalisation of
DFTCalculation that also covers wave-function methods (e.g., CCSD(T), MP2,
CASPT2) and other ab initio approaches.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b19"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mdo/calculation/Calculation"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#SubordinateSortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#EnergyProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetricProperty"/>
    <rdfs:label xml:lang="en">Energy (metric property)</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#ReferenceSettings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reference Settings</rdfs:label>
    <rdfs:comment xml:lang="en">Settings of a reference calculation, abstracted
across method families. Concrete subclasses (DFTSettings, WaveFunctionSettings)
carry the method-specific parameters; the supertype carries cross-family slots
such as the software code used.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#ReifiedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#cutoffRadius">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">cutoff radius</rdfs:label>
    <rdfs:comment xml:lang="en">Cutoff radius for atomic interactions, in angstroms.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#BenchmarkResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Benchmark Result</rdfs:label>
    <rdfs:comment xml:lang="en">A single evaluation result: an MLIP method applied to a
material system with specific hyperparameters, reporting accuracy metrics.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b30"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b31"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b32"/>
    <rdfs:subClassOf rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b33"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#ReifiedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b36">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#produces"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has configuration</rdfs:label>
    <rdfs:comment xml:lang="en">Links a training dataset to one of its atomic configurations.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#AtomicConfiguration"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#usedDFTCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">used DFT code</rdfs:label>
    <rdfs:comment xml:lang="en">The DFT software used (e.g., VASP, GPAW).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#Library"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/mlips#usedReferenceCode"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#candidateForVocabulary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">candidate for vocabulary</rdfs:label>
    <rdfs:comment xml:lang="en">Annotates a paper-local instance with the
controlled-vocabulary class to which it should be considered for
promotion. Used when an encoded paper introduces an entity that is not
yet a named individual in mlips-vocab.ttl. The deduplication audit
collects these candidates; a curator promotes, merges, or leaves them
paper-local.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hyperparameterDatatype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">hyperparameter datatype</rdfs:label>
    <rdfs:comment xml:lang="en">The expected XSD datatype of this hyperparameter, given as the
datatype IRI itself (e.g., xsd:integer, xsd:double, xsd:string).
Recording the IRI rather than a string label lets a consumer render
an input widget for the declared datatype directly without parsing.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasConfiguration"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#AtomicConfiguration"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#produces"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips/module/benchmark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Benchmark Module</rdfs:label>
    <dcterms:description xml:lang="en">The Benchmark module describes how a trained potential's accuracy is reported: benchmark studies, the trained model and run they evaluate, the target material, and per-property accuracy metrics. In the running example it records the energy RMSE of 2.81 meV/atom that the MTP achieves on the C14 TiCr2-H phase.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#PseudopotentialType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pseudopotential Type</rdfs:label>
    <rdfs:comment xml:lang="en">A family of pseudopotentials used in a
plane-wave DFT calculation (e.g., PAW, ultrasoft, norm-conserving).
Range of mlips:pseudopotentialType on DFTSettings. All-electron codes
leave this slot empty. Concrete pseudopotential families are modelled
as named individuals; an open extension point.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainedUsing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">trained using</rdfs:label>
    <rdfs:comment xml:lang="en">Shortcut: links a trained model directly to a hyperparameter setting used during the MLIP run that produced it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <owl:propertyChainAxiom rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#FunctionalForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Functional Form</rdfs:label>
    <rdfs:comment xml:lang="en">A parametrised mapping from an atomic configuration to an energy, specified independently of parameter values.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <mlips:metaSort rdf:resource="https://w3id.org/mlips#Sortal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b10">
    <rdf:first rdf:resource="https://w3id.org/mlips#hasHyperparameterSetting"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Augmented">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#DatasetProvenance"/>
    <rdfs:label xml:lang="en">Augmented</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset augmented from existing sources.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#defaultValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">default value</rdfs:label>
    <rdfs:comment xml:lang="en">Default value of a hyperparameter, used when the value is not stated explicitly. Range matches the hyperparameter's declared datatype.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#microstructuralFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">microstructural feature</rdfs:label>
    <rdfs:comment xml:lang="en">E.g., point defect, dislocation, surface, grain boundary.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#MetaSort"/>
    <rdfs:label xml:lang="en">Role</rdfs:label>
    <rdfs:comment xml:lang="en">An anti-rigid class whose instances are
roles played by sortal individuals and depend existentially on those
sortals. OntoClean profile: ~R, -I (identity inherited from the
carrier), -U, +D.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/metasort"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#appliesMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">applies method</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP run to the MLIP method it fits.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">trained on</rdfs:label>
    <rdfs:comment xml:lang="en">Shortcut: links a trained model directly to the training dataset it was fitted on.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#TrainedModel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#TrainingDataset"/>
    <owl:propertyChainAxiom rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#hasTrainingRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has training run</rdfs:label>
    <rdfs:comment xml:lang="en">Optional link from an MLIP run to an ML-Schema run recording the training algorithm execution.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/mls#Run"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0009-0009-9043-2491">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Wenchuan Liu</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#metricType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">metric type</rdfs:label>
    <rdfs:comment xml:lang="en">Links an accuracy metric to its type (e.g., mlips:RMSE, mlips:MAE, mlips:R2).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#AccuracyMetric"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/benchmark"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#MetricType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0000-0003-3050-6291">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Fritz Körmann</schema:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b29">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#datasetProvenance"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#DatasetProvenance"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b39">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasFunctionalForm"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#FunctionalForm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0000-0001-9176-3270">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Yuji Ikeda</schema:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/mlips#produces"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">version</rdfs:label>
    <rdfs:comment xml:lang="en">Version identifier of an Implementation, given as a release tag, commit hash, or DOI.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#Implementation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b41">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasLossFunction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#LossFunction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b3">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Xi Zhang</schema:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#isSettingOf"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MLIPRun"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#SymmetryFunctionDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">Symmetry Function Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Behler-Parrinello symmetry functions; used by HDNNP.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#trainingDuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">training duration</rdfs:label>
    <rdfs:comment xml:lang="en">Measured wall-clock training time (hours).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPRun"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasWaveFunctionSettings"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#WaveFunctionSettings"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b7">
    <rdf:first rdf:resource="https://w3id.org/mlips#runsOn"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/ScholarlyArticle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scholarly article (schema.org)</rdfs:label>
    <rdfs:comment xml:lang="en">External: the schema.org ScholarlyArticle class. Used as
the range of mlips:reportedIn so a benchmark study can point to the
scholarly article that publishes it.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#basisSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">basis set</rdfs:label>
    <rdfs:comment xml:lang="en">The Gaussian basis set used in a
wave-function calculation, e.g., cc-pVTZ, aug-cc-pVDZ, def2-TZVP.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#WaveFunctionSettings"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b37">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#hasTrainingAlgorithm"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/mls#Algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips/module/metasort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Meta-categorisation Vocabulary</rdfs:label>
    <dcterms:description xml:lang="en">Annotation vocabulary attaching an OntoClean-style meta-category to every class in the ontology. The four meta-categories (Sortal, Subordinate Sortal, Role, Reified Relation) are named individuals of the class MetaSort; the property mlips:metaSort attaches one such individual to each class.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#ANIDescriptor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/mlips#AtomicEnvironmentDescriptor"/>
    <rdfs:label xml:lang="en">ANI Descriptor</rdfs:label>
    <rdfs:comment xml:lang="en">Modified Behler-Parrinello atomic environment vector (AEV)
used by the ANI family (ANI-1, ANI-1ccx, ANI-2x). Distinct from the
generic SymmetryFunctionDescriptor in that ANI uses a specific subset
of radial and angular functions tuned for organic molecules.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mlips/module/algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n88be8b0f19164d5b9cb69d74c0f83886b15">
