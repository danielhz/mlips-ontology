  <rdf:Description rdf:about="https://orcid.org/0000-0002-2409-975X">
    <schema:name>Jong Hyun Jung</schema:name>
    <rdf:type rdf:resource="https://schema.org/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#BenchmarkResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Benchmark Result</rdfs:label>
    <rdfs:comment xml:lang="en">A single evaluation result: an MLIP method applied to a
material system with specific hyperparameters, reporting accuracy metrics.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="N947882084dfc4aeab2d401fbe574bda1"/>
