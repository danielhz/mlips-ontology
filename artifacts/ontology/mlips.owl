    <rdfs:subClassOf rdf:nodeID="N307becd61e89477f8a9b33768f6d41c0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#evaluatesModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evaluates model</rdfs:label>
    <rdfs:comment xml:lang="en">Links a benchmark result to the trained model being evaluated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#TrainedModel"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N338f032f574746208d5a900c89b8d09c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#produces"/>
