    <owl:onClass rdf:resource="https://w3id.org/mlips#TrainedModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#numRadialBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">number of radial basis functions</rdfs:label>
    <rdfs:comment xml:lang="en">Number of radial basis functions in the descriptor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
