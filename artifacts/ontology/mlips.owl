  <rdf:Description rdf:about="https://w3id.org/mlips#hasHyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">Links an MLIP method to a hyperparameter it accepts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#MLIPMethod"/>
    <rdfs:range rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
