    <rdfs:label xml:lang="en">inference time per atom</rdfs:label>
    <rdfs:comment xml:lang="en">Inference time per atom (microseconds).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#BenchmarkResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#numLayers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">number of layers</rdfs:label>
    <rdfs:comment xml:lang="en">Number of layers in the neural network architecture.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#HyperparameterSetting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
