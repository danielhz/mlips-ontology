  </rdf:Description>
  <rdf:Description rdf:nodeID="N820570b2f1514a6c8dcfbe8ae60b5943">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/mlips#coversMaterial"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/mlips#MaterialSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#Library">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Library</rdfs:label>
    <rdfs:comment xml:lang="en">A software library or tool used in MLIP research
(e.g., ASE, LAMMPS, VASP, GPAW).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#energyCutoff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">energy cutoff</rdfs:label>
    <rdfs:comment xml:lang="en">Plane-wave energy cutoff in eV.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mlips#DFTSettings"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mlips#TrainingHyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Training Hyperparameter</rdfs:label>
    <rdfs:comment xml:lang="en">A hyperparameter of the training procedure.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mlips#Hyperparameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0000-0002-3661-5870">
