# Canonical Turtle for the protocol-derived encoding of:
#   Yangshuai Wang et al. (2024). A theoretical case study of the generalization of machine-learned potentials.
#   Computer Methods in Applied Mechanics and Engineering. doi:10.1016/j.cma.2024.116831  arXiv:2311.01664v1
#
# Version read: arxiv-preprint arXiv:2311.01664v1 (sha256 a7e2637ce33100be...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 467 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wang2024.yaml.
#
# Encoding scope: the numerical tests of the generalization analysis.
# Linear ACE models (ACEpotentials.jl, ARD) are fitted to randomly
# perturbed relaxed configurations of dislocation training domains,
# labelled by empirical reference potentials (EAM for W and NiAl, an
# optimized bond-order potential for Si), with energy, force and
# virial-stress terms. Geometry and energy errors versus test RMSE and
# training-domain size are figure-only; the theory itself is not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wang2024 a mlips:BenchmarkStudy ;
    rdfs:label "Wang, Patel and Ortner (2024): a theoretical case study of MLIP generalization from small training domains to dislocation simulations, with linear ACE tests on W, Si and NiAl" ;
    mlips:reportedIn entity:article-wang2024 .

entity:article-wang2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.cma.2024.116831> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "A theoretical case study of the generalization of machine-learned potentials" ;
    schema:author <https://orcid.org/0000-0003-0226-2613> ,
        <https://orcid.org/0009-0008-7279-132X> ,
        entity:person-Ortner-wang2024 .

<https://orcid.org/0000-0003-0226-2613> a schema:Person ;
    schema:name "Yangshuai Wang" ;
    schema:givenName "Yangshuai" ;
    schema:familyName "Wang" ;
    schema:identifier <https://orcid.org/0000-0003-0226-2613> .

<https://orcid.org/0009-0008-7279-132X> a schema:Person ;
    schema:name "Shashwat Patel" ;
    schema:givenName "Shashwat" ;
    schema:familyName "Patel" ;
    schema:identifier <https://orcid.org/0009-0008-7279-132X> .

entity:person-Ortner-wang2024 a schema:Person ;
    schema:name "Christoph Ortner" ;
    schema:givenName "Christoph" ;
    schema:familyName "Ortner" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-w-wang2024 a mlips:MaterialSystem ;
    rdfs:label "Tungsten with quadrupole screw dislocations and a dislocation loop" ;
    mlips:chemicalFormula "W" ;
    mlips:materialClass "Metals" .

entity:mat-si-wang2024 a mlips:MaterialSystem ;
    rdfs:label "Diamond silicon with quadrupole edge dislocations" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental semiconductor" .

entity:mat-nial-wang2024 a mlips:MaterialSystem ;
    rdfs:label "B2 NiAl with quadrupole screw dislocations" ;
    mlips:chemicalFormula "NiAl" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-eamw-wang2024 a mlips:ReferenceCalculation .

entity:calc-bopsi-wang2024 a mlips:ReferenceCalculation .

entity:calc-eamnial-wang2024 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-eamw-wang2024 mlips:hasReferenceSettings entity:calc-settings-eamw-wang2024 .

entity:calc-settings-eamw-wang2024 a mlips:ReferenceSettings ;
    rdfs:comment "Embedded-atom model for W (Ref. 10)" .

entity:calc-bopsi-wang2024 mlips:hasReferenceSettings entity:calc-settings-bopsi-wang2024 .

entity:calc-settings-bopsi-wang2024 a mlips:ReferenceSettings ;
    rdfs:comment "Optimized bond-order interatomic potential for Si (Ref. 37)" .

entity:calc-eamnial-wang2024 mlips:hasReferenceSettings entity:calc-settings-eamnial-wang2024 .

entity:calc-settings-eamnial-wang2024 a mlips:ReferenceSettings ;
    rdfs:comment "EAM for NiAl from OpenKIM (Ref. 38)" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-w-screw-wang2024 a mlips:TrainingDataset ;
    rdfs:label "W screw-dislocation training domains (L = 8-20 r0), 100 perturbed configurations" ;
    mlips:coversMaterial entity:mat-w-wang2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100 ;
    mlips:hasReferenceCalculation entity:calc-eamw-wang2024 .

entity:ds-si-edge-wang2024 a mlips:TrainingDataset ;
    rdfs:label "Si edge-dislocation training domains (L = 8-14 r0), 100 perturbed configurations" ;
    mlips:coversMaterial entity:mat-si-wang2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100 ;
    mlips:hasReferenceCalculation entity:calc-bopsi-wang2024 .

entity:ds-nial-screw-wang2024 a mlips:TrainingDataset ;
    rdfs:label "NiAl screw-dislocation training domains (L = 8-14 r0), 100 perturbed configurations" ;
    mlips:coversMaterial entity:mat-nial-wang2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100 ;
    mlips:hasReferenceCalculation entity:calc-eamnial-wang2024 .

entity:ds-w-loop-wang2024 a mlips:TrainingDataset ;
    rdfs:label "W dipole screw and dipole edge training domains for the dislocation loop, 150 perturbed configurations" ;
    mlips:coversMaterial entity:mat-w-wang2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 150 ;
    mlips:hasReferenceCalculation entity:calc-eamw-wang2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-w-screw-wang2024 mlips:samplingStrategy
    entity:sampling-perturb-wang2024 .

entity:ds-si-edge-wang2024 mlips:samplingStrategy
    entity:sampling-perturb-wang2024 .

entity:ds-nial-screw-wang2024 mlips:samplingStrategy
    entity:sampling-perturb-wang2024 .

entity:ds-w-loop-wang2024 mlips:samplingStrategy
    entity:sampling-perturb-wang2024 .

entity:sampling-perturb-wang2024 a mlips:SamplingStrategy ;
    rdfs:label "Random perturbations (alpha = 0.5 A or 0.1 A) of the relaxed training-domain configuration" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-wang2024 ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-wang2024 ;
    mlips:hasImplementation entity:impl-ACE-wang2024 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-ACE-wang2024 a mlips:LossFunction ;
    rdfs:label "Weighted least squares on energies, forces and two virial matching terms (W_E >> W_F ~ W_d1V)" .

entity:alg-ACE-wang2024 a mls:Algorithm ;
    rdfs:label "Bayesian linear regression with automatic relevance determination (ARD)" .

entity:impl-ACE-wang2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-ACEpotentials_jl-wang2024 .

entity:lib-ACEpotentials_jl-wang2024 a mlips:Library ;
    rdfs:label "ACEpotentials.jl" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

