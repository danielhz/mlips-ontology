###############################################################################

entity:run-ace-w-wang2024 a mlips:MLIPRun ;
    rdfs:label "Linear ACE for W screw dislocations" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-w-screw-wang2024 ;
    mlips:produces entity:model-ace-w-wang2024 .

entity:model-ace-w-wang2024 a mlips:TrainedModel ;
    rdfs:label "ACE W screw dislocation" .

entity:run-ace-si-wang2024 a mlips:MLIPRun ;
    rdfs:label "Linear ACE for Si edge dislocations" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-si-edge-wang2024 ;
    mlips:produces entity:model-ace-si-wang2024 .

entity:model-ace-si-wang2024 a mlips:TrainedModel ;
    rdfs:label "ACE Si edge dislocation" .

entity:run-ace-nial-wang2024 a mlips:MLIPRun ;
    rdfs:label "Linear ACE for NiAl screw dislocations" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-nial-screw-wang2024 ;
    mlips:produces entity:model-ace-nial-wang2024 .

entity:model-ace-nial-wang2024 a mlips:TrainedModel ;
    rdfs:label "ACE NiAl screw dislocation" .

entity:run-ace-loop-wang2024 a mlips:MLIPRun ;
    rdfs:label "Linear ACE for the W dislocation loop" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-w-loop-wang2024 ;
    mlips:produces entity:model-ace-loop-wang2024 .

entity:model-ace-loop-wang2024 a mlips:TrainedModel ;
