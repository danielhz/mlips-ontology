###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ANI-1x-wang2024hotpp a mlips:TrainingDataset ;
    rdfs:label "ANI-1x, 70% training split" ;
    mlips:coversMaterial entity:mat-organic-CHNO-wang2024hotpp ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "The full data set has about five million conformations; the reference level (omegaB97x/6-31G(d)) is described in smith2018." .

entity:ds-carbon-wang2024hotpp a mlips:TrainingDataset ;
    rdfs:label "Carbon data set (various phases)" ;
    mlips:coversMaterial entity:mat-carbon-wang2024hotpp ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Size and reference level are not restated." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ANI-1x-wang2024hotpp mlips:samplingStrategy
    entity:sampling-ani1x-wang2024hotpp .

entity:ds-carbon-wang2024hotpp mlips:samplingStrategy
    entity:sampling-carbon-gap-wang2024hotpp .

entity:sampling-ani1x-wang2024hotpp a mlips:SamplingStrategy ;
    rdfs:label "ANI-1x conformations (active learning)" ;
    rdfs:comment "About five million conformations from the ANI-1x active-learning data set; 70% used for training." .

entity:sampling-carbon-gap-wang2024hotpp a mlips:SamplingStrategy ;
    rdfs:label "Carbon data set of the GAP literature" ;
    rdfs:comment "Structural snapshots from ab initio MD, iteratively extended from GAP-driven simulations, plus randomly distorted unit cells of diamond and graphite (ref. 36 of the paper)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HotPP a mlips:MLIPMethod ;
    rdfs:label "HotPP (high-order tensor passing potential)" ;
    mlips:hasFunctionalForm entity:ff-HotPP ;
    mlips:hasHyperparameter mlips:numLayers ,
        entity:hp-max-tensor-order-wang2024hotpp ,
        mlips:numRadialBasis ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:MolecularDynamics .

entity:ff-HotPP a mlips:FunctionalForm ;
    rdfs:label "E(n)-equivariant message-passing network that passes Cartesian tensors of arbitrary order between atoms, built from tensor products of relative coordinates; outputs energies and, directly, vector and tensor properties" .

entity:hp-max-tensor-order-wang2024hotpp a mlips:Hyperparameter ;
    rdfs:label "HotPP maximum order of the Cartesian tensors (output layer and tensor product of relative coordinates)" ;
    mlips:hyperparameterName "l_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-hotpp-ANI-1x-numLayers-wang2024hotpp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-hotpp-ANI-1x-max-tensor-order-wang2024hotpp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-max-tensor-order-wang2024hotpp ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-hotpp-ANI-1x-numRadialBasis-wang2024hotpp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-hotpp-carbon-numLayers-wang2024hotpp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-hotpp-carbon-max-tensor-order-wang2024hotpp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-max-tensor-order-wang2024hotpp ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-hotpp-carbon-numRadialBasis-wang2024hotpp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "8"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-hotpp-ANI-1x-wang2024hotpp a mlips:MLIPRun ;
    rdfs:label "HotPP trained on 70% of ANI-1x" ;
    mlips:appliesMethod entity:HotPP ;
    mlips:runsOn entity:ds-ANI-1x-wang2024hotpp ;
    mlips:hasHyperparameterSetting entity:setting-hotpp-ANI-1x-numLayers-wang2024hotpp ,
        entity:setting-hotpp-ANI-1x-max-tensor-order-wang2024hotpp ,
        entity:setting-hotpp-ANI-1x-numRadialBasis-wang2024hotpp ;
    mlips:produces entity:model-hotpp-ANI-1x-wang2024hotpp .

entity:model-hotpp-ANI-1x-wang2024hotpp a mlips:TrainedModel ;
    rdfs:label "HotPP ANI-1x model" .

entity:run-hotpp-carbon-wang2024hotpp a mlips:MLIPRun ;
    rdfs:label "HotPP trained on the carbon data set" ;
    mlips:appliesMethod entity:HotPP ;
    mlips:runsOn entity:ds-carbon-wang2024hotpp ;
    mlips:hasHyperparameterSetting entity:setting-hotpp-carbon-numLayers-wang2024hotpp ,
        entity:setting-hotpp-carbon-max-tensor-order-wang2024hotpp ,
        entity:setting-hotpp-carbon-numRadialBasis-wang2024hotpp ;
    mlips:produces entity:model-hotpp-carbon-wang2024hotpp .

entity:model-hotpp-carbon-wang2024hotpp a mlips:TrainedModel ;
    rdfs:label "HotPP carbon model (about 160k parameters)" .

