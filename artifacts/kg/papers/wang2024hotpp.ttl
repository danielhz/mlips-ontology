###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-organic-CHNO-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "Organic molecules with C, H, N, O (ANI-1x training domain)" ;
    mlips:materialClass "Small organic molecules" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q174211> .

entity:mat-carbon-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "Carbon across phases: ab initio MD snapshots, GAP-driven configurations and distorted diamond and graphite cells" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental carbon; crystalline, amorphous and liquid configurations" .

entity:mat-ANI-MD-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark subset ANI-MD" ;
    mlips:materialClass "Organic and biochemical molecules larger than those in the training set" .

entity:mat-DrugBank-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark subset DrugBank" ;
    mlips:materialClass "Organic and biochemical molecules larger than those in the training set" .

entity:mat-GDB7-9-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark subset GDB7-9" ;
    mlips:materialClass "Organic and biochemical molecules larger than those in the training set" .

entity:mat-GDB10-13-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark subset GDB10-13" ;
    mlips:materialClass "Organic and biochemical molecules larger than those in the training set" .

entity:mat-S66x8-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark subset S66x8" ;
    mlips:materialClass "Organic and biochemical molecules larger than those in the training set" .

entity:mat-Tripeptides-wang2024hotpp a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark subset Tripeptides" ;
    mlips:materialClass "Organic and biochemical molecules larger than those in the training set" .

