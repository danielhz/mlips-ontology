entity:run-snap-J1-wood2018 a mlips:MLIPRun ;
    rdfs:label "Linear SNAP fit to tantalum, Jmax = 1, rcut = 3.94 A" ;
    mlips:appliesMethod entity:SNAP ;
    mlips:runsOn entity:ds-Ta-snap-wood2018 ;
    mlips:hasHyperparameterSetting entity:setting-snap-J1-Jmax-wood2018 ,
        entity:setting-snap-J1-cutoffRadius-wood2018 ;
    mlips:produces entity:model-snap-J1-wood2018 .

