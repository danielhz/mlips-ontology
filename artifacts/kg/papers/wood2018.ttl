# Canonical Turtle for the protocol-derived encoding of:
#   Mitchell A. Wood et al. (2018). Extending the accuracy of the SNAP interatomic potential form.
#   The Journal of Chemical Physics. doi:10.1063/1.5017641  arXiv:1711.11131v2
#
# Version read: arxiv-preprint arXiv:1711.11131v2 (sha256 8d373c91e986b6b9...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 201 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wood2018.yaml.
#
# Encoding scope: the quadratic SNAP form (introduced here) and the linear
# and quadratic SNAP fits to the tantalum training set of Thompson et al.
# (2015) whose training energy errors are tabulated (Tables SI and SII,
# Jmax = 1 to 7 linear and 1 to 5 quadratic, each at its optimised radial
# cutoff). Errors shown only in figures (Figs. 2, 3, 5) are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wood2018 a mlips:BenchmarkStudy ;
    rdfs:label "Wood and Thompson (2018): quadratic SNAP, with linear and quadratic SNAP fits for tantalum" ;
    mlips:reportedIn entity:article-wood2018 .

entity:article-wood2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/1.5017641> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Extending the accuracy of the SNAP interatomic potential form" ;
    schema:author entity:person-Wood-wood2018 ,
        <https://orcid.org/0000-0002-0324-9114> .

entity:person-Wood-wood2018 a schema:Person ;
    schema:name "Mitchell A. Wood" ;
    schema:givenName "Mitchell A." ;
    schema:familyName "Wood" .

<https://orcid.org/0000-0002-0324-9114> a schema:Person ;
    schema:name "Aidan P. Thompson" ;
    schema:givenName "Aidan P." ;
    schema:familyName "Thompson" ;
    schema:identifier <https://orcid.org/0000-0002-0324-9114> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Ta-wood2018 a mlips:MaterialSystem ;
    rdfs:label "Tantalum (crystalline A15, bcc, fcc phases, liquid, surfaces and generalised stacking faults)" ;
    mlips:chemicalFormula "Ta" ;
    mlips:materialClass "Elemental metal" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q1123> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Ta-snap-wood2018 a mlips:TrainingDataset ;
    rdfs:label "Tantalum SNAP training set of Thompson et al. (2015)" ;
    mlips:coversMaterial entity:mat-Ta-wood2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 362 ;
    rdfs:comment "Reused from Ref. [19]: displaced A15/bcc/fcc supercells, elastic and volume deformations of the crystals, liquid, surfaces and generalised stacking faults on (110) and (112); 362 energy and 15,297 force training points (308 energies and 6,900 forces from defect-free groups, 54 energies and 8,397 forces from disordered groups)." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP ;
    mlips:hasLossFunction entity:loss-SNAP-wood2018 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-Jmax-wood2018 ;
    mlips:hasImplementation entity:impl-SNAP-wood2018 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

entity:loss-SNAP-wood2018 a mlips:LossFunction ;
    rdfs:label "Weighted linear least squares on energies and forces with optional L1 or L2 regularisation (Eq. 1); unweighted and unregularised for the cutoff search" .

entity:impl-SNAP-wood2018 a mlips:Implementation ;
    mlips:implementedIn entity:lib-LAMMPS-wood2018 .

entity:qSNAP a mlips:MLIPMethod ;
    rdfs:label "Quadratic Spectral Neighbor Analysis Potential (qSNAP)" ;
    mlips:hasFunctionalForm entity:ff-qSNAP ;
    mlips:hasLossFunction entity:loss-qSNAP-wood2018 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-Jmax-wood2018 ;
    mlips:hasImplementation entity:impl-qSNAP-wood2018 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-qSNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components plus all their distinct pairwise products" .

entity:loss-qSNAP-wood2018 a mlips:LossFunction ;
    rdfs:label "Weighted linear least squares on energies and forces with optional L1 or L2 regularisation (Eq. 1); unweighted and unregularised for the cutoff search" .

entity:impl-qSNAP-wood2018 a mlips:Implementation ;
    mlips:implementedIn entity:lib-LAMMPS-wood2018 .

entity:lib-LAMMPS-wood2018 a mlips:Library ;
    rdfs:label "LAMMPS" ;
    rdfs:comment "pair_style snap; MD timings on one Intel Broadwell node" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Jmax-wood2018 a mlips:Hyperparameter ;
    rdfs:label "Maximum order of the bispectrum components Jmax" ;
    mlips:hyperparameterName "Jmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

