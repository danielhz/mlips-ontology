###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cspbi3-tyagi2025 a mlips:MaterialSystem ;
    rdfs:label "Cubic CsPbI3 with one iodide interstitial or vacancy in charge states -1, 0, +1" ;
    mlips:chemicalFormula "CsPbI3" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbed3-tyagi2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbed3-tyagi2025 mlips:hasDFTSettings entity:calc-settings-pbed3-tyagi2025 .

entity:calc-settings-pbed3-tyagi2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "PBE-D3(BJ) without spin-orbit coupling (SI Notes 1, 4)." .

