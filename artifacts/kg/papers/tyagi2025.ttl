###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:VASP-MLFF a mlips:MLIPMethod ;
    rdfs:label "VASP on-the-fly machine-learned force field (kernel regression on two- and three-body distribution descriptors with Bayesian error estimates)" ;
    mlips:hasImplementation entity:impl-VASP-MLFF-tyagi2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-VASP-MLFF-tyagi2025 a mlips:Implementation ;
    mlips:implementedIn mlips:VASP .

