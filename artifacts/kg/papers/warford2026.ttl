# Canonical Turtle for the protocol-derived encoding of:
#   Thomas Warford et al. (2026). Better without U : impact of selective Hubbard U correction on foundational MLIPs.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/ae6be5  arXiv:2601.21056v1
#
# Version read: arxiv-preprint arXiv:2601.21056v1 (sha256 268326df1b20bfae...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 585 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/warford2026.yaml.
#
# Encoding scope: MACE-MP-0b3-architecture models retrained by the
# authors on MPtrj with differently corrected energy labels (Wang et al.
# MP2020 shift, refitted Jain et al. shift, and the new per-U-element
# shift), and the distributed models compared (MACE-MP-0b3, MACE-MPA-0,
# MACE-OMAT-0, MACE-MATPES-PBE-0 and -r2SCAN-0, MP-0-large, CHGNet,
# eSEN-OAM-20M). Oxygen-adsorption, adhesion and fluorine-adsorption
# errors are property errors; no energy/force test errors are given in
# the text read.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-warford2026 a mlips:BenchmarkStudy ;
    rdfs:label "Warford, Thiemann and Csanyi (2026): impact of selective Hubbard U corrections in training data on foundational MLIPs, and a smoothness-targeted per-element energy shift" ;
    mlips:reportedIn entity:article-warford2026 .

entity:article-warford2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/ae6be5> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Better without U : impact of selective Hubbard U correction on foundational MLIPs" ;
    schema:author <https://orcid.org/0009-0000-6039-2083> ,
        <https://orcid.org/0000-0003-2951-6740> ,
        <https://orcid.org/0000-0002-8180-2034> .

<https://orcid.org/0009-0000-6039-2083> a schema:Person ;
    schema:name "Thomas Warford" ;
    schema:givenName "Thomas" ;
    schema:familyName "Warford" ;
    schema:identifier <https://orcid.org/0009-0000-6039-2083> .

<https://orcid.org/0000-0003-2951-6740> a schema:Person ;
    schema:name "Fabian L Thiemann" ;
    schema:givenName "Fabian L" ;
    schema:familyName "Thiemann" ;
    schema:identifier <https://orcid.org/0000-0003-2951-6740> .

<https://orcid.org/0000-0002-8180-2034> a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" ;
    schema:identifier <https://orcid.org/0000-0002-8180-2034> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mp-warford2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic materials of MPtrj (PBE/PBE+U)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mptrj-warford2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mptrj-warford2026 mlips:hasDFTSettings entity:calc-settings-mptrj-warford2026 .

entity:calc-settings-mptrj-warford2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "MPtrj PBE and PBE+U energies with the stated correction schemes" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-wang-warford2026 a mlips:TrainingDataset ;
    rdfs:label "MPtrj with Wang et al. (MP2020) corrected energies" ;
    mlips:coversMaterial entity:mat-mp-warford2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-mptrj-warford2026 .

entity:ds-ours-warford2026 a mlips:TrainingDataset ;
    rdfs:label "MPtrj with the per-U-element shift fitted to MatPES-PBE overlaps" ;
    mlips:coversMaterial entity:mat-mp-warford2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-mptrj-warford2026 .

entity:ds-jain-warford2026 a mlips:TrainingDataset ;
    rdfs:label "MPtrj with a refitted Jain et al. shift" ;
    mlips:coversMaterial entity:mat-mp-warford2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-mptrj-warford2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-wang-warford2026 mlips:samplingStrategy
    entity:sampling-pub-warford2026 .

entity:ds-ours-warford2026 mlips:samplingStrategy
    entity:sampling-pub-warford2026 .

entity:ds-jain-warford2026 mlips:samplingStrategy
    entity:sampling-pub-warford2026 .

entity:sampling-pub-warford2026 a mlips:SamplingStrategy ;
    rdfs:label "MPtrj configurations as published" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-warford2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:impl-MACE-warford2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

