# Canonical Turtle for the protocol-derived encoding of:
#   Anton Z. Ni et al. (2026). Solvating machine-learning interatomic potentials for solution-phase chemistry.
#   arXiv (Cornell University). doi:10.48550/arxiv.2610.17226  arXiv:2610.17226v1
#
# Version read: arxiv-preprint arXiv:2610.17226v1 (sha256 9956c969f2330877...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 330 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ni2026.yaml.
#
# Encoding scope: the AnySolv models (MoE model fine-tuned from UMA-S-1.2
# and a compact model trained from random weights) that predict DFT-SMD
# solvation energies and forces in 36 training solvents (179 supported
# through solvent descriptors), with test-split errors (Table II) and
# external DFT-SMD benchmark errors of the MoE model. Errors against
# experimental solvation free energies, SAMPL6 partition coefficients,
# reaction barriers and coupling constants are property errors, not
# energy/force metrics of the potential.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ni2026 a mlips:BenchmarkStudy ;
    rdfs:label "Ni and Lee (2026): AnySolv, a transferable implicit-solvation correction potential for gas-phase MLIPs" ;
    mlips:reportedIn entity:article-ni2026 .

entity:article-ni2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.17226> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Solvating machine-learning interatomic potentials for solution-phase chemistry" ;
    schema:author entity:person-Ni-ni2026 ,
        entity:person-Lee-ni2026 .

entity:person-Ni-ni2026 a schema:Person ;
    schema:name "Anton Z. Ni" ;
    schema:givenName "Anton Z." ;
    schema:familyName "Ni" .

entity:person-Lee-ni2026 a schema:Person ;
    schema:name "Joonho Lee" ;
    schema:givenName "Joonho" ;
    schema:familyName "Lee" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-solutes-ni2026 a mlips:MaterialSystem ;
    rdfs:label "Organic and main-group solutes from OMol25 (neutral, charged -4 to +4, open-shell, reaction paths and transition states), AIMNet2 anions and zwitterions in 36 solvents" ;
    mlips:materialClass "Molecules in implicit solvent" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-smd-ni2026 a mlips:DFTCalculation .

entity:calc-alpb-ni2026 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-smd-ni2026 mlips:hasDFTSettings entity:calc-settings-smd-ni2026 .

entity:calc-settings-smd-ni2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-wB97M-V-ni2026 ;
    mlips:basisSet "def2-TZVPD" ;
    rdfs:comment "ORCA 6.0.1, SMD solvation, TightSCF, DefGrid3; labels are SMD minus gas-phase energies and gradients (gas phase from OMol25)." .

entity:calc-alpb-ni2026 mlips:hasReferenceSettings entity:calc-settings-alpb-ni2026 .

entity:calc-settings-alpb-ni2026 a mlips:ReferenceSettings ;
    rdfs:comment "GFN2-xTB/ALPB solvation labels (preliminary training stage)." .

entity:xc-wB97M-V-ni2026 a mlips:XCFunctional ;
    rdfs:label "wB97M-V" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-smd-train-ni2026 a mlips:TrainingDataset ;
    rdfs:label "DFT-SMD solvation labels in 36 solvents (1,355,281 training labels; OMol25 split 95/2.5/2.5)" ;
    mlips:coversMaterial entity:mat-solutes-ni2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1355281 ;
    mlips:hasDFTCalculation entity:calc-smd-ni2026 .

entity:ds-alpb-train-ni2026 a mlips:TrainingDataset ;
    rdfs:label "Preliminary GFN2-xTB/ALPB labels in 21 solvents plus DFT-SMD water labels (5,633,695 labels)" ;
    mlips:coversMaterial entity:mat-solutes-ni2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 5633695 ;
    mlips:hasReferenceCalculation entity:calc-alpb-ni2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:hasLossFunction entity:loss-UMA-ni2026 ;
    mlips:hasTrainingAlgorithm entity:alg-UMA-ni2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-UMA-ni2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-UMA-ni2026 a mlips:LossFunction ;
    rdfs:label "Per-atom MAE of the solvation energy (weight 20) and L2 norm of the solvation-force error (weight 2), normalised by 0.193 eV" .

entity:alg-UMA-ni2026 a mls:Algorithm ;
    rdfs:label "AdamW (weight decay 1e-3), 0.1-epoch warm-up and cosine decay, gradient clipping 100; solvent descriptors embedded into the system features and the MoE router" .

entity:impl-UMA-ni2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-ni2026 .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-eSEN-ni2026 .

entity:impl-eSEN-ni2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-ni2026 .

entity:lib-fairchem-ni2026 a mlips:Library ;
    rdfs:label "fairchem" ;
    mlips:candidateForVocabulary mlips:Library .

