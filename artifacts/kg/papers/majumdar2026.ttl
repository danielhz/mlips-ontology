# Canonical Turtle for the protocol-derived encoding of:
#   Sauradeep Majumdar et al. (2026). Reweighting free energy profiles between universal machine learning interatomic potentials for fast consensus building.
#   arXiv (Cornell University). doi:  arXiv:2605.15630v1
#
# Version read: arxiv-preprint arXiv:2605.15630v1 (sha256 592b3e3b53070252...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 277 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/majumdar2026.yaml.
#
# Encoding scope: eight universal MLIP set-ups (Table 1) evaluated against
# PBE+D3 energies and forces of 1,100 Li-zeolite-water configurations
# (601 atoms), and the MACE model fine-tuned here from MACE-MATPES-r2SCAN on
# r2SCAN-D4 zeolite data with its test errors (SI S2). The PMF reweighting
# results (entropy scores, free energies) are not error metrics and are
# not encoded. Errors are in kJ/mol units, which the schema has no unit for;
# they are kept in the labels with unit null.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-majumdar2026 a mlips:BenchmarkStudy ;
    rdfs:label "Majumdar et al. (2026): reweighting free-energy profiles of Li+ transport in a zeolite between universal MLIPs" ;
    mlips:reportedIn entity:article-majumdar2026 .

entity:article-majumdar2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Reweighting free energy profiles between universal machine learning interatomic potentials for fast consensus building" ;
    schema:author entity:person-Majumdar-majumdar2026 ,
        entity:person-Steiner-majumdar2026 ,
        entity:person-Dietschreit-majumdar2026 ,
        entity:person-Roy-majumdar2026 ,
        entity:person-Willimetz-majumdar2026 ,
        entity:person-Grajciar-majumdar2026 ,
        entity:person-GomezBombarelli-majumdar2026 .

entity:person-Majumdar-majumdar2026 a schema:Person ;
    schema:name "Sauradeep Majumdar" ;
    schema:givenName "Sauradeep" ;
    schema:familyName "Majumdar" .

entity:person-Steiner-majumdar2026 a schema:Person ;
    schema:name "Miguel Steiner" ;
    schema:givenName "Miguel" ;
    schema:familyName "Steiner" .

entity:person-Dietschreit-majumdar2026 a schema:Person ;
    schema:name "Johannes C. B. Dietschreit" ;
    schema:givenName "Johannes C. B." ;
    schema:familyName "Dietschreit" .

entity:person-Roy-majumdar2026 a schema:Person ;
    schema:name "Swagata Roy" ;
    schema:givenName "Swagata" ;
    schema:familyName "Roy" .

entity:person-Willimetz-majumdar2026 a schema:Person ;
    schema:name "Daniel Willimetz" ;
    schema:givenName "Daniel" ;
    schema:familyName "Willimetz" .

entity:person-Grajciar-majumdar2026 a schema:Person ;
    schema:name "Lukaš Grajciar" ;
    schema:givenName "Lukaš" ;
    schema:familyName "Grajciar" .

entity:person-GomezBombarelli-majumdar2026 a schema:Person ;
    schema:name "Rafael Gómez-Bombarelli" ;
    schema:givenName "Rafael" ;
    schema:familyName "Gómez-Bombarelli" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-li-cha-majumdar2026 a mlips:MaterialSystem ;
    rdfs:label "Li+ in a water-solvated chabazite (CHA) zeolite pore channel with one Al substitution (601 atoms)" ;
    mlips:materialClass "Ion in a nanoconfined electrolyte (aluminosilicate zeolite)" .

entity:mat-zeolites-majumdar2026 a mlips:MaterialSystem ;
    rdfs:label "Siliceous and aluminosilicate zeolites with Na and Li" ;
    mlips:materialClass "Zeolites" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-majumdar2026 a mlips:DFTCalculation .

entity:calc-r2scan-d4-majumdar2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-majumdar2026 mlips:hasDFTSettings entity:calc-settings-pbe-d3-majumdar2026 .

entity:calc-settings-pbe-d3-majumdar2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE-D3-majumdar2026 ;
    rdfs:comment "Reference for the 1,100 configurations, from the authors' previous work (Ref. [16])." .

entity:calc-r2scan-d4-majumdar2026 mlips:hasDFTSettings entity:calc-settings-r2scan-d4-majumdar2026 .

entity:calc-settings-r2scan-d4-majumdar2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-r2SCAN-D4-majumdar2026 ;
    rdfs:comment "Zeolite database of Erlebach et al. recomputed at r2SCAN-D4 plus Li-substituted structures (SI S2)." .

entity:xc-PBE-D3-majumdar2026 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-r2SCAN-D4-majumdar2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN-D4" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-zeolite-ft-majumdar2026 a mlips:TrainingDataset ;
    rdfs:label "Zeolite fine-tuning set: 10,000 configurations (5,000 Na-based and 5,000 Li-substituted) at r2SCAN-D4" ;
    mlips:coversMaterial entity:mat-zeolites-majumdar2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10000 ;
    mlips:hasDFTCalculation entity:calc-r2scan-d4-majumdar2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-zeolite-ft-majumdar2026 mlips:samplingStrategy
    entity:sampling-li-swap-majumdar2026 .

entity:sampling-li-swap-majumdar2026 a mlips:SamplingStrategy ;
    rdfs:label "SOAP farthest-point sampling of 5,000 Na environments, 75% Na replaced by Li, 20 ps MACE-MP0 MD, Li-centred SOAP-FPS of the last 5 ps" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-majumdar2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-majumdar2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:PET a mlips:MLIPMethod ;
    rdfs:label "Point Edge Transformer (PET)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mace-ft-cutoffRadius-majumdar2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-mace-ft-numFeatures-majumdar2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-mace-ft-numEpochs-majumdar2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-mp0-majumdar2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP0 as distributed (MPtrj; source of the umbrella-sampling trajectory)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp0-majumdar2026 .

entity:model-mace-mp0-majumdar2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP0" .

entity:run-uma-majumdar2026 a mlips:MLIPRun ;
    rdfs:label "UMA (OMat24 task) as distributed" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-majumdar2026 .

entity:model-uma-majumdar2026 a mlips:TrainedModel ;
    rdfs:label "UMA (OMat24)" .

entity:run-pet-mad-majumdar2026 a mlips:MLIPRun ;
    rdfs:label "PET-MAD-1.0.2 as distributed" ;
    mlips:appliesMethod entity:PET ;
    mlips:produces entity:model-pet-mad-majumdar2026 .

entity:model-pet-mad-majumdar2026 a mlips:TrainedModel ;
    rdfs:label "PET-MAD-1.0.2" .

entity:run-orb-v3-majumdar2026 a mlips:MLIPRun ;
    rdfs:label "ORB-v3 (OMat24) as distributed" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb-v3-majumdar2026 .

entity:model-orb-v3-majumdar2026 a mlips:TrainedModel ;
    rdfs:label "ORB-v3 (OMat24)" .

entity:run-mace-mpa-0-majumdar2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa-0-majumdar2026 .

entity:model-mace-mpa-0-majumdar2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-mace-matpes-majumdar2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MATPES-r2SCAN as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-matpes-majumdar2026 .

entity:model-mace-matpes-majumdar2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MATPES (r2SCAN)" .

entity:run-mace-ft-majumdar2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MATPES-r2SCAN fine-tuned on r2SCAN-D4 zeolite data (MACE-fine-tuned)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-zeolite-ft-majumdar2026 ;
    mlips:hasHyperparameterSetting entity:setting-mace-ft-cutoffRadius-majumdar2026 ,
        entity:setting-mace-ft-numFeatures-majumdar2026 ,
        entity:setting-mace-ft-numEpochs-majumdar2026 ;
    mlips:produces entity:model-mace-ft-majumdar2026 .

entity:model-mace-ft-majumdar2026 a mlips:TrainedModel ;
    rdfs:label "MACE-fine-tuned zeolite potential" .

