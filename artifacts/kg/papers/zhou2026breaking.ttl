###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MatRIS-MoE a mlips:MLIPMethod ;
    rdfs:label "MatRIS-MoE (mixture-of-experts extension of MatRIS for multi-task billion-parameter training)" ;
    mlips:hasTrainingAlgorithm entity:alg-MatRIS-MoE-zhou2026breaking ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-MatRIS-MoE-zhou2026breaking .

entity:alg-MatRIS-MoE-zhou2026breaking a mls:Algorithm ;
    rdfs:label "Mixture-of-experts routing with multi-head self-attention; multi-task training with batch sizes up to 4K (CNIS) and 15K (LineShine); learning rate scaled by the square root of the batch-size multiplier" .

entity:impl-MatRIS-MoE-zhou2026breaking a mlips:Implementation ;
    mlips:implementedIn entity:lib-Janus-zhou2026breaking .

entity:lib-Janus-zhou2026breaking a mlips:Library ;
    rdfs:label "Janus" ;
    rdfs:comment "High-dimensional distributed training framework (FS-3D, expert parallelism) on CNIS and LineShine" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-matris-moe-s-numLayers-zhou2026breaking a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-matris-moe-s-numFeatures-zhou2026breaking a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "2560"^^xsd:integer .

###############################################################################
