###############################################################################

entity:run-matris-moe-s-zhou2026breaking a mlips:MLIPRun ;
    rdfs:label "MatRIS-MoE (S): 1.09B parameters (0.19B active), 72 experts, top-4 routing" ;
    mlips:appliesMethod entity:MatRIS-MoE ;
    mlips:runsOn entity:ds-multi473-zhou2026breaking ;
    mlips:hasHyperparameterSetting entity:setting-matris-moe-s-numLayers-zhou2026breaking ,
        entity:setting-matris-moe-s-numFeatures-zhou2026breaking ;
    mlips:produces entity:model-matris-moe-s-zhou2026breaking .

entity:model-matris-moe-s-zhou2026breaking a mlips:TrainedModel ;
    rdfs:label "MatRIS-MoE (S)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Per-step training time at 1/8 machine scale (Table III): MatRIS-MoE (M)
# 5.96 s to 2.21 s on CNIS and 33.1 s to 8.08 s on LineShine after
# optimisation; MatRIS-MoE (L) 7.71 s to 2.66 s and 40.7 s to 8.14 s. Peak
# single-precision performance 1.2 EFLOPS (CNIS) and 1.0 EFLOPS (LineShine)
# at 90-93% weak-scaling efficiency. These are training-cost figures for
# the scaling models, not inference timings of the trained model.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Accuracy on Matcalc, Wiggle150, GMTKN55, X23, DMC ice, OC20NEB, ASD, noble-metal adsorption and MOFSimBench is shown only as normalised scores in Fig. 5; no numbers are given.
# - MatRIS-MoE (M) (2.47B) and (L) (11.5B) are not trained to convergence and are not encoded as models. MatRIS-MoE is a new registry method derived from MatRIS (Sec. III-B).
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: datacite).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/zhou2026breaking.yaml) until the schema has terms for them.
