    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-r2scan-caucci2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ft-caucci2026 mlips:samplingStrategy
    entity:sampling-pub-caucci2026 .

