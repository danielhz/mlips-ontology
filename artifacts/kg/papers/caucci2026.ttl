entity:run-tuned-caucci2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet-tuned: CHGNet-r2SCAN fine-tuned on the authors' r2SCAN RE-HEO dataset" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-ft-caucci2026 ;
    mlips:produces entity:model-tuned-caucci2026 .

entity:model-tuned-caucci2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet-tuned RE-HEO" .

