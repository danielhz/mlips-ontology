###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasLossFunction entity:loss-CHGNet-caucci2026 ;
    mlips:hasImplementation entity:impl-CHGNet-caucci2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-CHGNet-caucci2026 a mlips:LossFunction ;
    rdfs:label "Transfer-learning configuration of Ref. 40" .

entity:impl-CHGNet-caucci2026 a mlips:Implementation ;
    mlips:implementedIn mlips:CHGNet .

