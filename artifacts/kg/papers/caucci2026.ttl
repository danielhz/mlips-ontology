###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-reheo-caucci2026 a mlips:MaterialSystem ;
    rdfs:label "Rare-earth high-entropy oxides Ce_x(YLaPrSm)_(1-x)O_(2-delta) (fluorite and bixbyite), binary rare-earth oxides and rare-earth metals" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scan-caucci2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scan-caucci2026 mlips:hasDFTSettings entity:calc-settings-r2scan-caucci2026 .

entity:calc-settings-r2scan-caucci2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-r2SCAN-caucci2026 ;
    rdfs:comment "Authors' r2SCAN dataset with f-valence electrons for Pr, Nd, Sm (Refs. 41-42; OSF W38CM)" .

entity:xc-r2SCAN-caucci2026 a mlips:XCFunctional ;
