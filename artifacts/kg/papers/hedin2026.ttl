# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mpa0-hedin2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 foundation model as distributed (MPtrj + sAlex)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mpa0-hedin2026 .

entity:model-mpa0-hedin2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-ref360-hedin2026 a mlips:MLIPRun ;
    rdfs:label "360 Ref. model: MACE trained from scratch on the 360-atom data" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-d360-hedin2026 ;
    mlips:hasHyperparameterSetting entity:setting-ref360-cutoffRadius-hedin2026 ,
        entity:setting-ref360-numLayers-hedin2026 ,
        entity:setting-ref360-numFeatures-hedin2026 ,
        entity:setting-ref360-learningRate-hedin2026 ,
        entity:setting-ref360-batchSize-hedin2026 ,
        entity:setting-ref360-numEpochs-hedin2026 ;
    mlips:produces entity:model-ref360-hedin2026 .

