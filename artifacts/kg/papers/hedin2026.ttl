    entity:result-mhft10-test-hedin2026 .

entity:result-ref360-test-hedin2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ref360-hedin2026 ;
    mlips:targetMaterial entity:mat-as-hedin2026 ;
    mlips:hasAccuracyMetric entity:metric-ref360-test-1-hedin2026 ,
        entity:metric-ref360-test-2-hedin2026 ,
        entity:metric-ref360-test-3-hedin2026 .

entity:metric-ref360-test-1-hedin2026 a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on as: ammonium sulfate MACE ref360" ;
    mlips:metricType mlips:RMSE ;
