# Canonical Turtle for the protocol-derived encoding of:
#   Ludwig Hedin et al. (2026). Barocaloric phase transformation from data efficient fine-tuning of machine learned interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2606.25742  arXiv:2606.25742v1
#
# Version read: arxiv-preprint arXiv:2606.25742v1 (sha256 d7b8460acb6090dd...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 386 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/hedin2026.yaml.
#
# Encoding scope: r2SCAN data sets of ammonium sulfate (360-atom VASP
# MLFF on-the-fly MD snapshots, 1,385 structures with a 139-structure
# hold-out test set; 60-atom MACE-MPA-0 MD snapshots, 2,403 structures,
# with DIRECT-sampled subsets of 5-500), MACE models trained from scratch
# and fine-tuned from MACE-MPA-0 (naive, NFT; multihead replay, MHFT),
# and the hold-out test RMSEs of the models listed in Table I. PBE0 and
# PBE0+D3 fine-tunes and the out-of-domain errors of Fig. 9 are
# figure-only; lattice parameters and transition behaviour are
# properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-hedin2026 a mlips:BenchmarkStudy ;
    rdfs:label "Hedin and Klarbring (2026): data-efficient naive and multihead-replay fine-tuning of MACE-MPA-0 for the barocaloric transformation in ammonium sulfate" ;
    mlips:reportedIn entity:article-hedin2026 .

entity:article-hedin2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2606.25742> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Barocaloric phase transformation from data efficient fine-tuning of machine learned interatomic potentials" ;
    schema:author entity:person-Hedin-hedin2026 ,
        entity:person-Klarbring-hedin2026 .

entity:person-Hedin-hedin2026 a schema:Person ;
    schema:name "Ludwig Hedin" ;
    schema:givenName "Ludwig" ;
    schema:familyName "Hedin" .

entity:person-Klarbring-hedin2026 a schema:Person ;
    schema:name "Johan Klarbring" ;
    schema:givenName "Johan" ;
    schema:familyName "Klarbring" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-as-hedin2026 a mlips:MaterialSystem ;
    rdfs:label "Ammonium sulfate (NH4)2SO4, low-temperature Pna21 and high-temperature Pnam phases" ;
    mlips:chemicalFormula "(NH4)2SO4" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scan-hedin2026 a mlips:DFTCalculation .

entity:calc-pbe0d3-hedin2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scan-hedin2026 mlips:hasDFTSettings entity:calc-settings-r2scan-hedin2026 .

entity:calc-settings-r2scan-hedin2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-hedin2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "900"^^xsd:double ;
    mlips:kPointMesh "Gamma point (360-atom cells); KSPACING 0.5 (60-atom cells)" ;
    rdfs:comment "50 meV Gaussian smearing, EDIFF 1e-6 eV (Sec. II C)." .

entity:calc-pbe0d3-hedin2026 mlips:hasDFTSettings entity:calc-settings-pbe0d3-hedin2026 .

entity:calc-settings-pbe0d3-hedin2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE0 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "900"^^xsd:double ;
    rdfs:comment "PBE0 with and without D3 on selected subsets (PRECFOCK Normal)." .

entity:xc-r2SCAN-hedin2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-d360-hedin2026 a mlips:TrainingDataset ;
    rdfs:label "360-atom r2SCAN data (1,385 structures; 139 held out as test set)" ;
    mlips:coversMaterial entity:mat-as-hedin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1385 ;
    mlips:hasDFTCalculation entity:calc-r2scan-hedin2026 .

entity:ds-d60-hedin2026 a mlips:TrainingDataset ;
    rdfs:label "60-atom r2SCAN data (80/20 train/validation)" ;
    mlips:coversMaterial entity:mat-as-hedin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2403 ;
    mlips:hasDFTCalculation entity:calc-r2scan-hedin2026 .

entity:ds-s100-hedin2026 a mlips:TrainingDataset ;
    rdfs:label "DIRECT subset of 100 60-atom r2SCAN structures" ;
    mlips:coversMaterial entity:mat-as-hedin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100 ;
    mlips:hasDFTCalculation entity:calc-r2scan-hedin2026 .

entity:ds-s10-hedin2026 a mlips:TrainingDataset ;
    rdfs:label "DIRECT subset of 10 60-atom r2SCAN structures" ;
    mlips:coversMaterial entity:mat-as-hedin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10 ;
    mlips:hasDFTCalculation entity:calc-r2scan-hedin2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-d360-hedin2026 mlips:samplingStrategy
    entity:sampling-otf-hedin2026 .

entity:ds-d60-hedin2026 mlips:samplingStrategy
    entity:sampling-mpa-md-hedin2026 .

entity:ds-s100-hedin2026 mlips:samplingStrategy
    entity:sampling-mpa-md-hedin2026 .

entity:ds-s10-hedin2026 mlips:samplingStrategy
    entity:sampling-mpa-md-hedin2026 .

entity:sampling-otf-hedin2026 a mlips:SamplingStrategy ;
    rdfs:label "VASP MLFF on-the-fly MD of 360-atom cells over temperatures and pressures in both phases" .

entity:sampling-mpa-md-hedin2026 a mlips:SamplingStrategy ;
    rdfs:label "MACE-MPA-0 MD of 60-atom cells over temperatures and pressures, temporally separated snapshots; DIRECT sampling (MACE-MPA-0 features, PCA, clustering) for subsets" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-hedin2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-hedin2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

