# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-hedin2026 mlips:hasResult
    entity:result-ref360-test-hedin2026 ,
    entity:result-ref60-test-hedin2026 ,
    entity:result-scr100-test-hedin2026 ,
    entity:result-scr10-test-hedin2026 ,
    entity:result-nft100-test-hedin2026 ,
    entity:result-nft10-test-hedin2026 ,
