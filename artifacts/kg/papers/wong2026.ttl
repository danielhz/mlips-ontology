# Canonical Turtle for the protocol-derived encoding of:
#   Yee Chit Wong et al. (2026). Long-Range Machine Learning Interatomic Potentials for Defect Energetics in SrTiO$_3$.
#   arXiv (Cornell University). doi:10.48550/arxiv.2610.00794  arXiv:2610.00794v1
#
# Version read: arxiv-preprint arXiv:2610.00794v1 (sha256 14879ef40e8fb196...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 592 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wong2026.yaml.
#
# Encoding scope: the four models trained on the SrTiO3 DFT data (bulk
# MD, 1D strain and Sr-O Schottky defect configurations; PBE, FHI-aims),
# with energy and force RMSEs relative to DFT along NEB paths at three
# Sr-O separations (Table V). Synthetic point-charge and formal-charge
# Ewald benchmarks are reported as pass/fail tables and figure panels and
# are not encoded; activation barriers are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wong2026 a mlips:BenchmarkStudy ;
    rdfs:label "Wong, Langer, Maurer and Hine (2026): long-range MLIPs (MACE-LES, MACE-POLAR, LOREM) versus local MACE for Schottky-defect energetics in SrTiO3" ;
    mlips:reportedIn entity:article-wong2026 .

entity:article-wong2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.00794> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Long-Range Machine Learning Interatomic Potentials for Defect Energetics in SrTiO$_3$" ;
    schema:author entity:person-Wong-wong2026 ,
        entity:person-Langer-wong2026 ,
        entity:person-Maurer-wong2026 ,
        entity:person-Hine-wong2026 .

entity:person-Wong-wong2026 a schema:Person ;
    schema:name "Yee Chit Wong" ;
    schema:givenName "Yee Chit" ;
    schema:familyName "Wong" .

entity:person-Langer-wong2026 a schema:Person ;
    schema:name "Marcel F. Langer" ;
    schema:givenName "Marcel F." ;
    schema:familyName "Langer" .

entity:person-Maurer-wong2026 a schema:Person ;
    schema:name "Reinhard J. Maurer" ;
    schema:givenName "Reinhard J." ;
    schema:familyName "Maurer" .

entity:person-Hine-wong2026 a schema:Person ;
    schema:name "Nicholas D. M. Hine" ;
    schema:givenName "Nicholas D. M." ;
    schema:familyName "Hine" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sto-wong2026 a mlips:MaterialSystem ;
    rdfs:label "SrTiO3 bulk (MD, strain) and Sr-O Schottky defect pairs" ;
    mlips:chemicalFormula "SrTiO3" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-aims-wong2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-aims-wong2026 mlips:hasDFTSettings entity:calc-settings-aims-wong2026 .

entity:calc-settings-aims-wong2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Frozen core below -600 eV, non-spin-polarized" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-sto-wong2026 a mlips:TrainingDataset ;
    rdfs:label "SrTiO3 DFT training data (bulk MD, strain, Schottky defects)" ;
    mlips:coversMaterial entity:mat-sto-wong2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-aims-wong2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-sto-wong2026 mlips:samplingStrategy
    entity:sampling-mix-wong2026 .

entity:sampling-mix-wong2026 a mlips:SamplingStrategy ;
    rdfs:label "Cubic SrTiO3 MD (MACE-OMAT-0 and NOMAD trajectories), 1D strains and Schottky-defect configurations at varying separations" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-wong2026 ;
    mlips:supportsSimulation mlips:NudgedElasticBand ,
        mlips:MolecularDynamics .

entity:impl-MACE-wong2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:MACE-LES a mlips:MLIPMethod ;
    rdfs:label "MACE with latent Ewald summation (MACE-LES)" ;
    mlips:hasImplementation entity:impl-MACE-LES-wong2026 ;
    mlips:supportsSimulation mlips:NudgedElasticBand .

entity:impl-MACE-LES-wong2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:MACE-POLAR a mlips:MLIPMethod ;
    rdfs:label "MACE-POLAR (polarizable MACE with an explicit long-range electrostatic term conditioned on total charge and spin multiplicity)" ;
    mlips:hasImplementation entity:impl-MACE-POLAR-wong2026 ;
    mlips:supportsSimulation mlips:NudgedElasticBand .

entity:impl-MACE-POLAR-wong2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:LOREM a mlips:MLIPMethod ;
    rdfs:label "LOREM (long-range equivariant message passing with latent equivariant charges and Ewald summation)" ;
    mlips:supportsSimulation mlips:NudgedElasticBand .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-wong2026 a mlips:MLIPRun ;
    rdfs:label "MACE trained on SrTiO3 DFT data" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-sto-wong2026 ;
    mlips:produces entity:model-mace-wong2026 .

entity:model-mace-wong2026 a mlips:TrainedModel ;
    rdfs:label "MACE SrTiO3 (Wong 2026)" .

entity:run-les-wong2026 a mlips:MLIPRun ;
    rdfs:label "MACE-LES trained on SrTiO3 DFT data" ;
    mlips:appliesMethod entity:MACE-LES ;
    mlips:runsOn entity:ds-sto-wong2026 ;
    mlips:produces entity:model-les-wong2026 .

entity:model-les-wong2026 a mlips:TrainedModel ;
    rdfs:label "MACE-LES SrTiO3 (Wong 2026)" .

entity:run-polar-wong2026 a mlips:MLIPRun ;
    rdfs:label "MACE-POLAR trained on SrTiO3 DFT data" ;
    mlips:appliesMethod entity:MACE-POLAR ;
    mlips:runsOn entity:ds-sto-wong2026 ;
    mlips:produces entity:model-polar-wong2026 .

entity:model-polar-wong2026 a mlips:TrainedModel ;
    rdfs:label "MACE-POLAR SrTiO3 (Wong 2026)" .

entity:run-lorem-wong2026 a mlips:MLIPRun ;
    rdfs:label "LOREM trained on SrTiO3 DFT data" ;
    mlips:appliesMethod entity:LOREM ;
    mlips:runsOn entity:ds-sto-wong2026 ;
    mlips:produces entity:model-lorem-wong2026 .

entity:model-lorem-wong2026 a mlips:TrainedModel ;
    rdfs:label "LOREM SrTiO3 (Wong 2026)" .

