# Canonical Turtle for the protocol-derived encoding of:
#   Silvan Käser et al. (2024). Numerical Accuracy Matters: Applications of Machine Learned Potential Energy Surfaces.
#   The Journal of Physical Chemistry Letters. doi:10.1021/acs.jpclett.3c03405  arXiv:2311.17398v1
#
# Version read: arxiv-preprint arXiv:2311.17398v1 (sha256 ae4edd229f17d3af...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 358 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/kaser2024.yaml.
#
# Encoding scope: four PhysNet PESs for H2CO (two trained in 32-bit and
# two in 64-bit arithmetic, on two different splits of 3,601 MP2
# structures) with the test MAEs and RMSEs of Table 1, and the 32- and
# 64-bit malonaldehyde PESs transfer-learned from MP2 to CCSD(T). Harmonic
# and VPT2 frequencies and tunnelling splittings are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kaser2024 a mlips:BenchmarkStudy ;
    rdfs:label "Käser and Meuwly (2024): numerical accuracy matters, single- versus double-precision PhysNet PESs for formaldehyde and malonaldehyde" ;
    mlips:reportedIn entity:article-kaser2024 .

entity:article-kaser2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpclett.3c03405> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Numerical Accuracy Matters: Applications of Machine Learned Potential Energy Surfaces" ;
    schema:author <https://orcid.org/0000-0002-3641-8519> ,
        <https://orcid.org/0000-0001-7930-8806> .

<https://orcid.org/0000-0002-3641-8519> a schema:Person ;
    schema:name "Silvan Käser" ;
    schema:givenName "Silvan" ;
    schema:familyName "Käser" ;
    schema:identifier <https://orcid.org/0000-0002-3641-8519> .

<https://orcid.org/0000-0001-7930-8806> a schema:Person ;
    schema:name "Markus Meuwly" ;
    schema:givenName "Markus" ;
    schema:familyName "Meuwly" ;
    schema:identifier <https://orcid.org/0000-0001-7930-8806> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-h2co-kaser2024 a mlips:MaterialSystem ;
    rdfs:label "Formaldehyde (H2CO), normal-mode-sampled structures" ;
    mlips:chemicalFormula "H2CO" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-mal-kaser2024 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde (H-transfer)" ;
    mlips:chemicalFormula "C3H4O2" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mp2-kaser2024 a mlips:WaveFunctionCalculation .

entity:calc-ccsdt-kaser2024 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mp2-kaser2024 mlips:hasWaveFunctionSettings entity:calc-settings-mp2-kaser2024 .

entity:calc-settings-mp2-kaser2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:MP2 ;
    mlips:basisSet "aug-cc-pVTZ" ;
    rdfs:comment "Energies, forces and dipoles (Ref. 13 for H2CO; Ref. 16 for malonaldehyde low level)." .

entity:calc-ccsdt-kaser2024 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-kaser2024 .

entity:calc-settings-ccsdt-kaser2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "aug-cc-pVTZ" ;
    rdfs:comment "Malonaldehyde high-level data (862 configurations, Ref. 16)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-h2co-kaser2024 a mlips:TrainingDataset ;
    rdfs:label "H2CO MP2/aug-cc-pVTZ data (3,601 normal-mode-sampled structures; 3,061/360/180 split)" ;
    mlips:coversMaterial entity:mat-h2co-kaser2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 3601 ;
    mlips:hasReferenceCalculation entity:calc-mp2-kaser2024 .

entity:ds-mal-ll-kaser2024 a mlips:TrainingDataset ;
    rdfs:label "Malonaldehyde MP2/aug-cc-pVTZ data (about 70,000 points)" ;
    mlips:coversMaterial entity:mat-mal-kaser2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasReferenceCalculation entity:calc-mp2-kaser2024 .

entity:ds-mal-hl-kaser2024 a mlips:TrainingDataset ;
    rdfs:label "Malonaldehyde CCSD(T)/aug-cc-pVTZ transfer-learning data" ;
    mlips:coversMaterial entity:mat-mal-kaser2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 862 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-kaser2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PhysNet a mlips:MLIPMethod ;
    rdfs:label "PhysNet (message-passing neural network for energies, forces, dipole moments and partial charges)" ;
    mlips:hasFunctionalForm entity:ff-PhysNet ;
    mlips:hasTrainingAlgorithm entity:alg-PhysNet-kaser2024 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ff-PhysNet a mlips:FunctionalForm ;
    rdfs:label "Message-passing neural network of stacked modular blocks with residual refinements over radial-basis-expanded interatomic distances; atomic energy and partial-charge outputs, optionally augmented with explicit long-range electrostatics and dispersion" .

entity:alg-PhysNet-kaser2024 a mls:Algorithm ;
    rdfs:label "Adam" .

