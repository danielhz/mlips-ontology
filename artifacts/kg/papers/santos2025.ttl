###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-blyp-santos2025 a mlips:DFTCalculation .

entity:calc-morse-santos2025 a mlips:ReferenceCalculation .

entity:calc-ccsdt-santos2025 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-blyp-santos2025 mlips:hasDFTSettings entity:calc-settings-blyp-santos2025 .

entity:calc-settings-blyp-santos2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-BLYP-santos2025 ;
    mlips:basisSet "TZVP" ;
    rdfs:comment "ANI-1xnr dataset level of theory" .

entity:calc-morse-santos2025 mlips:hasReferenceSettings entity:calc-settings-morse-santos2025 .

entity:calc-settings-morse-santos2025 a mlips:ReferenceSettings ;
    mlips:usedReferenceCode mlips:MLIP ;
    rdfs:comment "PCDA-Morse labels: reference MLIP (ANI-1xnr; ANI-1ccx for H2O, CO2, NH3, CH4 in ANI-Mcc) where its uncertainty is low, two fitted Morse potentials (repulsive, dissociative) elsewhere, smoothly switched" .

entity:calc-ccsdt-santos2025 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-santos2025 .

entity:calc-settings-ccsdt-santos2025 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    rdfs:comment "Target BDEs for the energy shifts: CCCBDB CCSD(T)=FULL with aug-cc-pVQZ (35 bonds), aug-cc-pVTZ (1), cc-pVTZ (7)" .

entity:xc-BLYP-santos2025 a mlips:XCFunctional ;
    rdfs:label "BLYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

