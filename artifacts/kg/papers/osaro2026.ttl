# Canonical Turtle for the protocol-derived encoding of:
#   Etinosa Osaro et al. (2026). MLIPilot: LLM-Driven Auto-Research for Machine-Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2605.30889  arXiv:2605.30889v1
#
# Version read: arxiv-preprint arXiv:2605.30889v1 (sha256 68d78d62318ab36b...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 129 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: an agentic workflow in which large language models
# tune MACE training configurations against a physically constrained
# scorecard. The final MACE models reached by the four benchmarked
# agents on the two data sets (QM7 with B3LYP labels; Cu with EMT
# labels) are encoded with their test errors (Tables 2 and 4). Preprint
# only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-osaro2026 a mlips:BenchmarkStudy ;
    rdfs:label "Osaro et al. (2026): MLIPilot, LLM-driven auto-research for machine-learned interatomic potentials" ;
    mlips:reportedIn entity:article-osaro2026 .

entity:article-osaro2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2605.30889> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "MLIPilot: LLM-Driven Auto-Research for Machine-Learned Interatomic Potentials" ;
    schema:author entity:person-Osaro-osaro2026 ,
        entity:person-Adhikari-osaro2026 ,
        entity:person-Zavitsanou-osaro2026 ,
        entity:person-Parker-osaro2026 ,
        entity:person-Rocca-osaro2026 .

entity:person-Osaro-osaro2026 a schema:Person ;
    schema:name "Etinosa Osaro" ;
    schema:givenName "Etinosa" ;
    schema:familyName "Osaro" .

entity:person-Adhikari-osaro2026 a schema:Person ;
    schema:name "Santosh Adhikari" ;
    schema:givenName "Santosh" ;
    schema:familyName "Adhikari" .

entity:person-Zavitsanou-osaro2026 a schema:Person ;
    schema:name "Stamatia Zavitsanou" ;
    schema:givenName "Stamatia" ;
    schema:familyName "Zavitsanou" .

entity:person-Parker-osaro2026 a schema:Person ;
    schema:name "Kelsey Parker" ;
    schema:givenName "Kelsey" ;
    schema:familyName "Parker" .

entity:person-Rocca-osaro2026 a schema:Person ;
    schema:name "Dario Rocca" ;
    schema:givenName "Dario" ;
    schema:familyName "Rocca" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-QM7-osaro2026 a mlips:MaterialSystem ;
    rdfs:label "QM7 organic molecules (C, H, N, O, S; 7,165 molecules)" ;
    mlips:materialClass "Small organic molecules (gas phase)" .

entity:mat-Cu-osaro2026 a mlips:MaterialSystem ;
    rdfs:label "Strained and rattled fcc copper supercells (32 atoms)" ;
    mlips:chemicalFormula "Cu" ;
    mlips:materialClass "Elemental fcc metal (model reference)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qm7-dft-osaro2026 a mlips:DFTCalculation .

entity:calc-emt-osaro2026 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qm7-dft-osaro2026 mlips:hasDFTSettings entity:calc-settings-qm7-dft-osaro2026 .

entity:calc-settings-qm7-dft-osaro2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-B3LYP-osaro2026 ;
    mlips:dftBasisSet entity:basis-6-31G-d-osaro2026 ;
    rdfs:comment "B3LYP/6-31G(d) single-point energies and forces generated by the authors for the QM7 molecules; the code is not named." .

entity:calc-emt-osaro2026 mlips:hasReferenceSettings entity:calc-settings-emt-osaro2026 .

entity:calc-settings-emt-osaro2026 a mlips:ReferenceSettings ;
    mlips:usedReferenceCode entity:lib-ASE-osaro2026 ;
    rdfs:comment "Effective Medium Theory (EMT) calculator of ASE: an analytic model potential serves as the reference for the Cu data set." .

entity:xc-B3LYP-osaro2026 a mlips:XCFunctional ;
    rdfs:label "B3LYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-6-31G-d-osaro2026 a mlips:DftBasisSet ;
    rdfs:label "6-31G(d)" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

entity:lib-ASE-osaro2026 a mlips:Library ;
    rdfs:label "ASE" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-QM7-osaro2026 a mlips:TrainingDataset ;
    rdfs:label "QM7 B3LYP training split (5,015 structures)" ;
    mlips:coversMaterial entity:mat-QM7-osaro2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 5015 ;
    mlips:hasDFTCalculation entity:calc-qm7-dft-osaro2026 .

entity:ds-Cu-osaro2026 a mlips:TrainingDataset ;
    rdfs:label "Cu EMT training split (140 structures)" ;
    mlips:coversMaterial entity:mat-Cu-osaro2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 140 ;
    mlips:hasReferenceCalculation entity:calc-emt-osaro2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-QM7-osaro2026 mlips:samplingStrategy
    entity:sampling-qm7-osaro2026 .

entity:ds-Cu-osaro2026 mlips:samplingStrategy
    entity:sampling-cu-rattled-osaro2026 .

entity:sampling-qm7-osaro2026 a mlips:SamplingStrategy ;
    rdfs:label "QM7 molecules with single-point labels" ;
    rdfs:comment "Split 5,015 / 1,433 / 717 into training, validation and test structures." .

entity:sampling-cu-rattled-osaro2026 a mlips:SamplingStrategy ;
    rdfs:label "Strained and rattled fcc Cu supercells" ;
    rdfs:comment "200 supercells (2x2x2, 32 atoms); split 140 / 40 / 20." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-osaro2026 ;
    mlips:hasHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:hasImplementation entity:impl-MACE-osaro2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-MACE-osaro2026 a mls:Algorithm ;
    rdfs:label "Training configuration (model variant, loss, epochs and other settings) chosen iteratively by an LLM agent against a scorecard with hard gates on energy, force and stress errors, relaxation and NVE energy drift" .

entity:impl-MACE-osaro2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE ;
    mlips:version "mace_run_train backend" .

entity:hp-tuning-agent-osaro2026 a mlips:Hyperparameter ;
    rdfs:label "LLM agent that selected the training configuration" ;
    mlips:hyperparameterName "tuning_agent" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-qm7-GPT-5_5-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "GPT-5.5" .

entity:setting-qm7-Mistral-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "Mistral" .

entity:setting-qm7-GPT-4_1-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "GPT-4.1" .

entity:setting-qm7-Qwen3-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "Qwen3" .

entity:setting-cu-GPT-5_5-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "GPT-5.5" .

entity:setting-cu-Mistral-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "Mistral" .

entity:setting-cu-GPT-4_1-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "GPT-4.1" .

entity:setting-cu-Qwen3-tuning-agent-osaro2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-tuning-agent-osaro2026 ;
    mlips:settingValue "Qwen3" .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-qm7-GPT-5_5-osaro2026 a mlips:MLIPRun ;
    rdfs:label "MACE on QM7 B3LYP, final configuration found by the GPT-5.5 agent" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-QM7-osaro2026 ;
    mlips:hasHyperparameterSetting entity:setting-qm7-GPT-5_5-tuning-agent-osaro2026 ;
    mlips:produces entity:model-qm7-GPT-5_5-osaro2026 .

entity:model-qm7-GPT-5_5-osaro2026 a mlips:TrainedModel ;
    rdfs:label "MACE QM7 model tuned by GPT-5.5" .

entity:run-qm7-Mistral-osaro2026 a mlips:MLIPRun ;
    rdfs:label "MACE on QM7 B3LYP, final configuration found by the Mistral agent" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-QM7-osaro2026 ;
    mlips:hasHyperparameterSetting entity:setting-qm7-Mistral-tuning-agent-osaro2026 ;
    mlips:produces entity:model-qm7-Mistral-osaro2026 .

entity:model-qm7-Mistral-osaro2026 a mlips:TrainedModel ;
    rdfs:label "MACE QM7 model tuned by Mistral" .

