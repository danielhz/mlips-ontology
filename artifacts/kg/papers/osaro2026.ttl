entity:model-qm7-Qwen3-osaro2026 a mlips:TrainedModel ;
    rdfs:label "MACE QM7 model tuned by Qwen3" .

entity:run-cu-GPT-5_5-osaro2026 a mlips:MLIPRun ;
    rdfs:label "MACE on Cu EMT, final configuration found by the GPT-5.5 agent" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-Cu-osaro2026 ;
