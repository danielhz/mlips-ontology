###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-osaro2026 mlips:hasResult
    entity:result-qm7-GPT-5_5-osaro2026 ,
    entity:result-qm7-Mistral-osaro2026 ,
    entity:result-qm7-GPT-4_1-osaro2026 ,
    entity:result-qm7-Qwen3-osaro2026 ,
    entity:result-cu-GPT-5_5-osaro2026 ,
    entity:result-cu-Mistral-osaro2026 ,
    entity:result-cu-GPT-4_1-osaro2026 ,
    entity:result-cu-Qwen3-osaro2026 .

entity:result-qm7-GPT-5_5-osaro2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-qm7-GPT-5_5-osaro2026 ;
    mlips:targetMaterial entity:mat-QM7-osaro2026 ;
    mlips:hasAccuracyMetric entity:metric-qm7-GPT-5_5-1-osaro2026 ,
        entity:metric-qm7-GPT-5_5-2-osaro2026 .

entity:metric-qm7-GPT-5_5-1-osaro2026 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on energy: MACE tuned by GPT-5.5, QM7 B3LYP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "9.52"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-qm7-GPT-5_5-2-osaro2026 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on forces: MACE tuned by GPT-5.5, QM7 B3LYP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "9.83"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-qm7-Mistral-osaro2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-qm7-Mistral-osaro2026 ;
    mlips:targetMaterial entity:mat-QM7-osaro2026 ;
    mlips:hasAccuracyMetric entity:metric-qm7-Mistral-1-osaro2026 ,
        entity:metric-qm7-Mistral-2-osaro2026 .

entity:metric-qm7-Mistral-1-osaro2026 a mlips:AccuracyMetric ;
