entity:run-qm7-Qwen3-osaro2026 a mlips:MLIPRun ;
    rdfs:label "MACE on QM7 B3LYP, final configuration found by the Qwen3 agent" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-QM7-osaro2026 ;
