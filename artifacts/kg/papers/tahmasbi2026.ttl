###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-sirius-tahmasbi2026 mlips:hasDFTSettings entity:calc-settings-sirius-tahmasbi2026 .

entity:calc-settings-sirius-tahmasbi2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-SIRIUS-tahmasbi2026 ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "SSSP PBE Precision 1.3.0 pseudopotentials with recommended cutoffs; AiiDA kpoints_distance 0.2; Fermi-Dirac smearing 0.0022 Ha; single points (Methods, Unary dataset)." .

entity:lib-CP2K-SIRIUS-tahmasbi2026 a mlips:Library ;
    rdfs:label "CP2K-SIRIUS" ;
    mlips:candidateForVocabulary mlips:Library .

