    rdfs:comment "About 400 configurations per element generated with aiida-datagen (Methods)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-tahmasbi2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        entity:hp-max-L-tahmasbi2026 ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-tahmasbi2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-MACE-tahmasbi2026 a mlips:LossFunction ;
    rdfs:label "Weighted energy and force MSE (1:100), then 300:100 with stochastic weight averaging for the last 100 epochs; isolated-atom energies E0" .

entity:impl-MACE-tahmasbi2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:PET a mlips:MLIPMethod ;
    rdfs:label "Point Edge Transformer (PET)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" .

entity:hp-max-L-tahmasbi2026 a mlips:Hyperparameter ;
    rdfs:label "MACE maximum symmetry order L of the messages" ;
    mlips:hyperparameterName "max_L" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

