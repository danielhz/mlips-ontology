###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-MAD-mazitov2025 a mlips:MaterialSystem ;
    rdfs:label "MAD: organic and inorganic systems of 85 elements in all dimensionalities (3D and 2D crystals, rattled and random structures, surfaces, clusters, molecular crystals and fragments)" ;
    mlips:materialClass "Universal (organic and inorganic)" .

entity:mat-MPtrj-mazitov2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk inorganic crystals of MPtrj (relaxation trajectories)" ;
    mlips:materialClass "Universal inorganic materials" .

entity:mat-Alexandria-mazitov2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk, 2D and 1D inorganic systems of Alexandria (relaxation trajectories)" ;
    mlips:materialClass "Universal inorganic materials" .

entity:mat-OC2020-mazitov2025 a mlips:MaterialSystem ;
    rdfs:label "Adsorbates on catalytic surfaces, OC2020 S2EF" ;
    mlips:materialClass "Adsorbate-surface systems" .

entity:mat-SPICE-mazitov2025 a mlips:MaterialSystem ;
    rdfs:label "Drug-like molecules and peptides of SPICE" ;
    mlips:materialClass "Organic molecules" .

entity:mat-MD22-mazitov2025 a mlips:MaterialSystem ;
    rdfs:label "Peptides, DNA fragments, carbohydrates and fatty acids of MD22" ;
    mlips:materialClass "Large molecules" .

entity:mat-Matbench-mazitov2025 a mlips:MaterialSystem ;
    rdfs:label "WBM crystals of Matbench Discovery (single-element substitutions on bulk inorganic crystals)" ;
    mlips:materialClass "Universal inorganic materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-mazitov2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-mazitov2025 mlips:hasDFTSettings entity:calc-settings-dft-mazitov2025 .

entity:calc-settings-dft-mazitov2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-PBEsol-mazitov2025 ;
    mlips:kPointMesh "Gamma-centred grid with resolution 0.125 per Angstrom in periodic directions" ;
    rdfs:comment "Quantum ESPRESSO v7.2 with SIRIUS, driven by AiiDA; non-magnetic; SSSP v1.2 efficiency pseudopotentials (mixed types) with cutoffs 110 Ry (wave functions) and 1320 Ry (density), stated in Ry; Marzari-Vanderbilt cold smearing of 0.01 Ry; Coulomb truncation for 2D and 0D systems." .

entity:xc-PBEsol-mazitov2025 a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-MAD-mazitov2025 a mlips:TrainingDataset ;
    rdfs:label "MAD data set (95,595 structures of 85 elements; 80% / 10% / 10% train / validation / test per subset)" ;
    mlips:coversMaterial entity:mat-MAD-mazitov2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 95595 ;
    mlips:hasDFTCalculation entity:calc-dft-mazitov2025 ;
    rdfs:comment "The count is the whole data set; training uses 80% of each subset. Stresses are not named among the training targets in the text read." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-MAD-mazitov2025 mlips:samplingStrategy
    entity:sampling-mad-mazitov2025 .

entity:sampling-mad-mazitov2025 a mlips:SamplingStrategy ;
    rdfs:label "Eight subsets: MC3D crystals, rattled MC3D, random-composition MC3D, MC3D surfaces, MC3D clusters, MC2D crystals, SHIFTML molecular crystals and molecular fragments; outliers with very large forces removed" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PET a mlips:MLIPMethod ;
    rdfs:label "Point Edge Transformer (PET)" ;
    mlips:hasLossFunction entity:loss-PET-mazitov2025 ;
    mlips:hasTrainingAlgorithm entity:alg-PET-mazitov2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-transformer-layers-mazitov2025 ,
        mlips:numFeatures ,
        entity:hp-attention-heads-mazitov2025 ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-PET-mazitov2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation ,
        mlips:MonteCarlo .

entity:loss-PET-mazitov2025 a mlips:LossFunction ;
    rdfs:label "Root-mean-square differences of energies and forces, with a factor 0.1 on the energy term" .

entity:alg-PET-mazitov2025 a mls:Algorithm ;
    rdfs:label "Adam with the learning rate halved every 250 epochs; rotational symmetry learned through data augmentation (no explicit equivariance); a separate head for direct (non-conservative) force prediction is trained as well" .

entity:impl-PET-mazitov2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-metatrain-mazitov2025 .

entity:lib-metatrain-mazitov2025 a mlips:Library ;
    rdfs:label "metatrain" ;
    rdfs:comment "PyTorch framework and the metatrain package." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-transformer-layers-mazitov2025 a mlips:Hyperparameter ;
    rdfs:label "Transformer layers per message-passing layer" ;
    mlips:hyperparameterName "num_transformer_layers" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-attention-heads-mazitov2025 a mlips:Hyperparameter ;
    rdfs:label "Heads in the multi-head attention layer" ;
    mlips:hyperparameterName "num_heads" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-PET-MAD-cutoffRadius-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-PET-MAD-numLayers-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-PET-MAD-transformer-layers-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-transformer-layers-mazitov2025 ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-PET-MAD-numFeatures-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-PET-MAD-attention-heads-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-attention-heads-mazitov2025 ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-PET-MAD-batchSize-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "24"^^xsd:integer .

entity:setting-PET-MAD-numEpochs-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "1500"^^xsd:integer .

entity:setting-PET-MAD-learningRate-mazitov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-PET-MAD-mazitov2025 a mlips:MLIPRun ;
    rdfs:label "Training of PET-MAD on the MAD data set" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-MAD-mazitov2025 ;
    mlips:hasHyperparameterSetting entity:setting-PET-MAD-cutoffRadius-mazitov2025 ,
        entity:setting-PET-MAD-numLayers-mazitov2025 ,
        entity:setting-PET-MAD-transformer-layers-mazitov2025 ,
        entity:setting-PET-MAD-numFeatures-mazitov2025 ,
        entity:setting-PET-MAD-attention-heads-mazitov2025 ,
        entity:setting-PET-MAD-batchSize-mazitov2025 ,
        entity:setting-PET-MAD-numEpochs-mazitov2025 ,
        entity:setting-PET-MAD-learningRate-mazitov2025 ;
    mlips:trainingDuration "40"^^xsd:double ;
    mlips:trainingHardware "8 NVIDIA H100 GPUs" ;
    mlips:produces entity:model-PET-MAD-mazitov2025 .

entity:model-PET-MAD-mazitov2025 a mlips:TrainedModel ;
    rdfs:label "PET-MAD" .

