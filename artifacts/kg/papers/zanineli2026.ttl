# Canonical Turtle for the protocol-derived encoding of:
#   Pedro H. M. Zanineli et al. (2026). Cross-Geometry Transferability Assessment of Universal Machine Learning Interatomic Potentials: From Bulk Materials to Atomic Nanowires.
#   arXiv (Cornell University). doi:10.48550/arxiv.2608.06662  arXiv:2608.06662v1
#
# Version read: arxiv-preprint arXiv:2608.06662v1 (sha256 8842ea6bd3debc89...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 157 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the eight training runs of the fine-tuning versus
# from-scratch comparison (MACE MP-0, MACE MPA-0, ORB-v2-MPtrj and ORB-v3
# architectures on the geometry-diverse ZrO2 data set) with their shared
# settings and wall times. Their errors are shown as figures. The
# zero-shot table for 26 pretrained models is not encoded; see gaps.
# Preprint only (arXiv v1).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zanineli2026 a mlips:BenchmarkStudy ;
    rdfs:label "Zanineli et al. (2026): cross-geometry transferability of universal MLIPs, from bulk ZrO2 to atomic nanowires" ;
    mlips:reportedIn entity:article-zanineli2026 .

entity:article-zanineli2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2608.06662> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Cross-Geometry Transferability Assessment of Universal Machine Learning Interatomic Potentials: From Bulk Materials to Atomic Nanowires" ;
    schema:author entity:person-Zanineli-zanineli2026 ,
        entity:person-Focassio-zanineli2026 ,
        entity:person-Schleder-zanineli2026 .

entity:person-Zanineli-zanineli2026 a schema:Person ;
    schema:name "Pedro H. M. Zanineli" ;
    schema:givenName "Pedro H. M." ;
    schema:familyName "Zanineli" .

entity:person-Focassio-zanineli2026 a schema:Person ;
    schema:name "Bruno Focassio" ;
    schema:givenName "Bruno" ;
    schema:familyName "Focassio" .

entity:person-Schleder-zanineli2026 a schema:Person ;
    schema:name "Gabriel R. Schleder" ;
    schema:givenName "Gabriel R." ;
    schema:familyName "Schleder" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ZrO2-zanineli2026 a mlips:MaterialSystem ;
    rdfs:label "Zirconia in five geometry classes: bulk, slab, particle, neck and wire" ;
    mlips:chemicalFormula "ZrO2" ;
    mlips:materialClass "Oxide across bulk and nanostructure geometries" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-zanineli2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-zanineli2026 mlips:hasDFTSettings entity:calc-settings-dft-zanineli2026 .

entity:calc-settings-dft-zanineli2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "DFT as implemented in VASP; functional and settings were not captured from the text read." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ZrO2-zanineli2026 a mlips:TrainingDataset ;
    rdfs:label "ZrO2 training partition after force filtering (9331 structures, 454,851 atomic environments)" ;
    mlips:coversMaterial entity:mat-ZrO2-zanineli2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 9331 ;
    mlips:hasDFTCalculation entity:calc-dft-zanineli2026 ;
    rdfs:comment "By geometry: bulk 67, slab/surface defect/grain boundary 2140, particle 548, neck 2269, wire 4307 structures. About 72% / 18% / 10% train / validation / test after filtering." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ZrO2-zanineli2026 mlips:samplingStrategy
    entity:sampling-process-zanineli2026 .

entity:sampling-process-zanineli2026 a mlips:SamplingStrategy ;
    rdfs:label "First-principles simulations following the structural evolution from bulk and slabs through particles and necks to atomic wires; geometry-stratified split, then removal of structures with any force above 3 eV/A" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-zanineli2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-zanineli2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-zanineli2026 ,
        mlips:numEpochs ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-MACE-zanineli2026 a mlips:LossFunction ;
    rdfs:label "Per-atom energy loss plus force RMSE with unit weights" .

entity:alg-MACE-zanineli2026 a mls:Algorithm ;
    rdfs:label "AdamW with ReduceLROnPlateau; full-parameter single-head fine-tuning or training from scratch, 50 epochs, float32 (Graph-PES)" .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:hasLossFunction entity:loss-ORB-zanineli2026 ;
    mlips:hasTrainingAlgorithm entity:alg-ORB-zanineli2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-zanineli2026 ,
