    rdfs:label "Per-atom energy loss plus force RMSE with unit weights" .

entity:alg-ORB-zanineli2026 a mls:Algorithm ;
    rdfs:label "AdamW with ReduceLROnPlateau; full-parameter single-head fine-tuning or training from scratch, 50 epochs, float32 (Graph-PES)" .

