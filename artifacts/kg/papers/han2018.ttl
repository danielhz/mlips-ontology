# Canonical Turtle for the protocol-derived encoding of:
#   Jiequn Han et al. (2018). Deep Potential: A General Representation of a Many-Body Potential Energy Surface.
#   Communications in Computational Physics. doi:10.4208/cicp.oa-2017-0213  arXiv:1707.01478v2
#
# Version read: arxiv-preprint arXiv:1707.01478v2 (sha256 4011e6a02afe2482...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 25 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the first Deep Potential paper (energies only, local
# frames): four fits with their architectures and energy errors (Tables 1
# and 2): C7O2H10 isomers, EAM copper, AIMD zirconium and path-integral
# AIMD liquid water.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-han2018 a mlips:BenchmarkStudy ;
    rdfs:label "Han et al. (2018): Deep Potential, a general representation of a many-body potential energy surface" ;
    mlips:reportedIn entity:article-han2018 .

entity:article-han2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.4208/cicp.oa-2017-0213> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Deep Potential: A General Representation of a Many-Body Potential Energy Surface" ;
    schema:author entity:person-Han-han2018 ,
        entity:person-Zhang-han2018 ,
        entity:person-Car-han2018 ,
        entity:person-E-han2018 .

entity:person-Han-han2018 a schema:Person ;
    schema:name "Jiequn Han" ;
    schema:givenName "Jiequn" ;
    schema:familyName "Han" .

entity:person-Zhang-han2018 a schema:Person ;
    schema:name "Linfeng Zhang" ;
    schema:givenName "Linfeng" ;
    schema:familyName "Zhang" .

entity:person-Car-han2018 a schema:Person ;
    schema:name "Roberto Car" ;
    schema:givenName "Roberto" ;
    schema:familyName "Car" .

entity:person-E-han2018 a schema:Person ;
    schema:name "Weinan E" ;
    schema:givenName "Weinan" ;
    schema:familyName "E" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-C7O2H10-han2018 a mlips:MaterialSystem ;
    rdfs:label "C7O2H10 isomers" ;
    mlips:chemicalFormula "C7O2H10" ;
    mlips:materialClass "Small organic molecules (gas phase), AIMD conformations" .

entity:mat-Cu-han2018 a mlips:MaterialSystem ;
    rdfs:label "Bulk copper, heated from 500 K to 2400 K and cooled back (256 atoms)" ;
    mlips:chemicalFormula "Cu" ;
    mlips:materialClass "Elemental fcc metal, solid and liquid" .

entity:mat-Zr-han2018 a mlips:MaterialSystem ;
    rdfs:label "Solid zirconium with randomly displaced atoms (radiation-damage model, 8000-atom supercells)" ;
    mlips:chemicalFormula "Zr" ;
    mlips:materialClass "Elemental metal; threshold-displacement-energy trajectories" .

entity:mat-water-han2018 a mlips:MaterialSystem ;
    rdfs:label "Liquid water at 300 K and 1 atm (64 molecules, path-integral AIMD)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-eam-Cu-han2018 a mlips:ReferenceCalculation .

entity:calc-dft-Zr-han2018 a mlips:DFTCalculation .

entity:calc-dft-water-han2018 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-eam-Cu-han2018 mlips:hasReferenceSettings entity:calc-settings-eam-Cu-han2018 .

entity:calc-settings-eam-Cu-han2018 a mlips:ReferenceSettings ;
    mlips:usedReferenceCode entity:lib-LAMMPS-han2018 ;
    rdfs:comment "Embedded-atom-method (EAM) potential for Cu run with LAMMPS 2016; a classical potential serves as the reference, time step 1 fs, Nose-Hoover thermostat and barostat." .

entity:calc-dft-Zr-han2018 mlips:hasDFTSettings entity:calc-settings-dft-Zr-han2018 .

entity:calc-settings-dft-Zr-han2018 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "AIMD with VASP; functional and settings are not given in this paper." .

entity:calc-dft-water-han2018 mlips:hasDFTSettings entity:calc-settings-dft-water-han2018 .

entity:calc-settings-dft-water-han2018 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-PBE0-TS-han2018 ;
    rdfs:comment "Path-integral AIMD with Quantum ESPRESSO interfaced with i-PI, 8 beads (generalized Langevin equation), time step 0.48 fs, trajectory of about 10 ps." .

entity:lib-LAMMPS-han2018 a mlips:Library ;
    rdfs:label "LAMMPS" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE0-TS-han2018 a mlips:XCFunctional ;
    rdfs:label "PBE0+TS" ;
    rdfs:comment "PBE0 with self-consistent Tkatchenko-Scheffler dispersion." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-C7O2H10-han2018 a mlips:TrainingDataset ;
    rdfs:label "C7O2H10 isomer AIMD data (DTNN benchmark protocol)" ;
    mlips:coversMaterial entity:mat-C7O2H10-han2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "From http://quantum-machine.org/datasets/; the level of theory and the split sizes are not restated in this paper." .

entity:ds-Cu-han2018 a mlips:TrainingDataset ;
    rdfs:label "EAM copper MD snapshots (72000 training of 80000)" ;
    mlips:coversMaterial entity:mat-Cu-han2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 72000 ;
    mlips:hasReferenceCalculation entity:calc-eam-Cu-han2018 ;
    rdfs:comment "8000 snapshots held out for testing." .

entity:ds-Zr-han2018 a mlips:TrainingDataset ;
    rdfs:label "Zirconium AIMD snapshots (90% of 14000)" ;
    mlips:coversMaterial entity:mat-Zr-han2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 12600 ;
    mlips:hasDFTCalculation entity:calc-dft-Zr-han2018 ;
    rdfs:comment "numConfigurations is 90% of the 14000 snapshots, as stated ('90% of the corresponding snapshots are used for training'); trajectory data provided by Han Wang." .

entity:ds-water-han2018 a mlips:TrainingDataset ;
    rdfs:label "Liquid water PI-AIMD snapshots (90000 training of 100000)" ;
    mlips:coversMaterial entity:mat-water-han2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 90000 ;
    mlips:hasDFTCalculation entity:calc-dft-water-han2018 ;
    rdfs:comment "10000 snapshots held out for testing." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-C7O2H10-han2018 mlips:samplingStrategy
    entity:sampling-isomer-aimd-han2018 .

entity:ds-Cu-han2018 mlips:samplingStrategy
    entity:sampling-eam-md-ramp-han2018 .

entity:ds-Zr-han2018 mlips:samplingStrategy
    entity:sampling-zr-aimd-han2018 .

entity:ds-water-han2018 mlips:samplingStrategy
    entity:sampling-pi-aimd-han2018 .

entity:sampling-isomer-aimd-han2018 a mlips:SamplingStrategy ;
    rdfs:label "AIMD of C7O2H10 isomers (quantum-machine.org)" ;
    rdfs:comment "Data set and training/testing protocol of the DTNN benchmark." .

entity:sampling-eam-md-ramp-han2018 a mlips:SamplingStrategy ;
    rdfs:label "EAM MD temperature ramp" ;
    rdfs:comment "Snapshots every 0.1 ps; temperature raised by 100 K every 200 ps at zero pressure up to 2400 K and lowered again to 500 K." .

entity:sampling-zr-aimd-han2018 a mlips:SamplingStrategy ;
    rdfs:label "Short AIMD trajectories of displaced atoms (Zr)" ;
    rdfs:comment "14000 snapshots from 30 trajectories of 1 ps with a variable time step, used to determine threshold displacement energies along symmetric directions." .

entity:sampling-pi-aimd-han2018 a mlips:SamplingStrategy ;
    rdfs:label "Path-integral AIMD of liquid water" ;
    rdfs:comment "100000 snapshots selected at random along the trajectory; almost all time steps are used, so the data are strongly correlated." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-han2018 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-hidden-layers-han2018 ,
        mlips:numEpochs ,
        mlips:learningRate ,
        entity:hp-lr-decay-rate-han2018 ,
        entity:hp-lr-decay-epochs-han2018 ,
        mlips:batchSize ;
    mlips:inferenceComplexity "Linear in the number of atoms N (at most N_c neighbours inside the cutoff, N_c size independent)" .

entity:alg-DeePMD-han2018 a mls:Algorithm ;
    rdfs:label "Adam with batch size 128 and exponentially decaying learning rate a * b^(x/c); fully connected sub-networks with ReLU activation; Batch Normalization for C7O2H10 and H2O only" .

entity:hp-hidden-layers-han2018 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential hidden-layer widths of the sub-networks" ;
    mlips:hyperparameterName "hidden_layers" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-rate-han2018 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay rate" ;
    mlips:hyperparameterName "decay_rate" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-epochs-han2018 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay epoch" ;
    mlips:hyperparameterName "decay_epoch" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

