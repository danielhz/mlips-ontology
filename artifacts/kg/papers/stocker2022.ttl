###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-qm7x-3k-stocker2022 mlips:samplingStrategy
    entity:sampling-normal-mode-stocker2022 .

entity:ds-qm7x-32k-stocker2022 mlips:samplingStrategy
    entity:sampling-normal-mode-stocker2022 .

entity:ds-qm7x-320k-stocker2022 mlips:samplingStrategy
    entity:sampling-normal-mode-stocker2022 .

entity:ds-qm7x-3M-stocker2022 mlips:samplingStrategy
    entity:sampling-normal-mode-stocker2022 .

entity:sampling-normal-mode-stocker2022 a mlips:SamplingStrategy ;
    rdfs:label "Equilibrium structures and normal-mode displacements (QM7-x)" ;
    rdfs:comment "About 41,500 equilibrium structures from 6950 structural formulas and 100 non-equilibrium structures each, from linear combinations of normal-mode displacements; about 4.2 million configurations in total. Random split into training sets, validation sets (800 to 800 k) and a test set of 10,100 configurations." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GemNet a mlips:MLIPMethod ;
    rdfs:label "GemNet (geometric message passing neural network)" ;
    mlips:hasFunctionalForm entity:ff-GemNet ;
    mlips:hasLossFunction entity:loss-GemNet-stocker2022 ;
    mlips:hasHyperparameter entity:hp-variant-stocker2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ;
    mlips:inferenceComplexity "Linear in the number of atoms (finite cutoff, per-atom energy contributions)" .

entity:ff-GemNet a mlips:FunctionalForm ;
    rdfs:label "Directional graph neural network with geometric message passing over atom triplets and, in the two-hop form, quadruplets, built on spherical representations; energies are sums of atomic contributions and forces are obtained by backpropagation or, in the direct variants, predicted directly" .

entity:loss-GemNet-stocker2022 a mlips:LossFunction ;
    rdfs:label "Combined loss on atomization energies and forces in which the atomization energy contributes 0.1%" .

entity:hp-variant-stocker2022 a mlips:Hyperparameter ;
    rdfs:label "GemNet variant (two-hop Q or one-hop T message passing; d = direct force prediction)" ;
    mlips:hyperparameterName "variant" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
