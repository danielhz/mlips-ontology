###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-qm7x-stocker2022 a mlips:MaterialSystem ;
    rdfs:label "QM7-x small organic molecules (up to seven non-hydrogen atoms: C, N, O, S, Cl; 4 to 23 atoms)" ;
    mlips:materialClass "Small organic molecules, equilibrium and normal-mode-displaced non-equilibrium structures" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-stocker2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-stocker2022 mlips:hasDFTSettings entity:calc-settings-dft-stocker2022 .

entity:calc-settings-dft-stocker2022 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE0-MBD-stocker2022 ;
    rdfs:comment "QM7-x level: tightly converged numerical atom-centred basis sets and integration grids (details in the QM7-x paper); MD samples are re-labelled with identical settings." .

entity:xc-PBE0-MBD-stocker2022 a mlips:XCFunctional ;
    rdfs:label "PBE0+MBD" ;
    rdfs:comment "PBE0 hybrid functional with a many-body dispersion correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

