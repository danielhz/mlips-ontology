# Canonical Turtle for the protocol-derived encoding of:
#   Connor Allen et al. (2022). Optimal data generation for machine learned interatomic potentials.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/ac9ae7  arXiv:2207.11828v1
#
# Version read: arxiv-preprint arXiv:2207.11828v1 (sha256 8ddb54e2d7310097...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 696 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/allen2022.yaml.
#
# Encoding scope: GAP models for hcp Mg, fcc Al, diamond Si and bcc W
# trained on configurations built from nondiagonal supercells (NDSCs)
# commensurate with a 4x4x4 phonon grid, with random displacements and
# strains, plus an Al model extended along the Bain path. Model quality is
# reported as phonon-frequency RMSEs (THz) and elastic constants, which are
# property errors, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-allen2022 a mlips:BenchmarkStudy ;
    rdfs:label "Allen and Bartók (2022): optimal data generation for MLIPs with nondiagonal supercells" ;
    mlips:reportedIn entity:article-allen2022 .

entity:article-allen2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/ac9ae7> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Optimal data generation for machine learned interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-5625-7425> ,
        <https://orcid.org/0000-0002-4347-8819> .

<https://orcid.org/0000-0002-5625-7425> a schema:Person ;
    schema:name "Connor Allen" ;
    schema:givenName "Connor" ;
    schema:familyName "Allen" ;
    schema:identifier <https://orcid.org/0000-0002-5625-7425> .

<https://orcid.org/0000-0002-4347-8819> a schema:Person ;
    schema:name "Albert P Bartók" ;
    schema:givenName "Albert P" ;
    schema:familyName "Bartók" ;
    schema:identifier <https://orcid.org/0000-0002-4347-8819> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mg-allen2022 a mlips:MaterialSystem ;
    rdfs:label "hcp Mg" ;
    mlips:chemicalFormula "Mg" ;
    mlips:materialClass "hcp metal" .

entity:mat-al-allen2022 a mlips:MaterialSystem ;
    rdfs:label "fcc Al (plus bcc and Bain-path structures for the extended model)" ;
    mlips:chemicalFormula "Al" ;
    mlips:materialClass "fcc metal" .

entity:mat-si-allen2022 a mlips:MaterialSystem ;
    rdfs:label "Diamond Si" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "covalent semiconductor" .

entity:mat-w-allen2022 a mlips:MaterialSystem ;
    rdfs:label "bcc W" ;
    mlips:chemicalFormula "W" ;
    mlips:materialClass "bcc metal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-castep-allen2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-castep-allen2022 mlips:hasDFTSettings entity:calc-settings-castep-allen2022 .

entity:calc-settings-castep-allen2022 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CASTEP-allen2022 ;
    mlips:pseudopotentialType mlips:Ultrasoft ;
    rdfs:comment "GGA functional; on-the-fly ultrasoft pseudopotentials; cutoffs 520/800/400/600 eV and k-spacings 0.012/0.010/0.030/0.015 1/A for Mg/Al/Si/W (Table I)." .

entity:lib-CASTEP-allen2022 a mlips:Library ;
    rdfs:label "CASTEP" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mg-allen2022 a mlips:TrainingDataset ;
    rdfs:label "Mg NDSC training configurations" ;
    mlips:coversMaterial entity:mat-mg-allen2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-castep-allen2022 .

entity:ds-al-allen2022 a mlips:TrainingDataset ;
    rdfs:label "Al NDSC training configurations" ;
    mlips:coversMaterial entity:mat-al-allen2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-castep-allen2022 .

entity:ds-si-allen2022 a mlips:TrainingDataset ;
    rdfs:label "Si NDSC training configurations" ;
    mlips:coversMaterial entity:mat-si-allen2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-castep-allen2022 .

entity:ds-w-allen2022 a mlips:TrainingDataset ;
    rdfs:label "W NDSC training configurations" ;
    mlips:coversMaterial entity:mat-w-allen2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-castep-allen2022 .

entity:ds-al-bain-allen2022 a mlips:TrainingDataset ;
    rdfs:label "Al NDSC data plus bcc and Bain-path configurations (3751 atomic environments, 1455 energies)" ;
    mlips:coversMaterial entity:mat-al-allen2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-castep-allen2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mg-allen2022 mlips:samplingStrategy
    entity:sampling-ndsc-allen2022 .

entity:ds-al-allen2022 mlips:samplingStrategy
    entity:sampling-ndsc-allen2022 .

entity:ds-si-allen2022 mlips:samplingStrategy
    entity:sampling-ndsc-allen2022 .

entity:ds-w-allen2022 mlips:samplingStrategy
    entity:sampling-ndsc-allen2022 .

entity:ds-al-bain-allen2022 mlips:samplingStrategy
    entity:sampling-ndsc-allen2022 .

entity:sampling-ndsc-allen2022 a mlips:SamplingStrategy ;
    rdfs:label "Nondiagonal supercells commensurate with a 4x4x4 vibrational Brillouin-zone grid, with random displacements and small random strains" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-allen2022 ;
    mlips:hasHyperparameter mlips:numSparseConfigs ;
    mlips:supportsSimulation mlips:PhononCalculation .

entity:alg-GAP-allen2022 a mls:Algorithm ;
    rdfs:label "SOAP kernel (zeta = 4, delta = 2 eV), 1400 CUR-selected sparse points, adaptive regularisation; further hyperparameters in Table II" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-mg-numSparseConfigs-allen2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "1400"^^xsd:integer .

entity:setting-gap-al-numSparseConfigs-allen2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "1400"^^xsd:integer .

entity:setting-gap-si-numSparseConfigs-allen2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "1400"^^xsd:integer .

entity:setting-gap-w-numSparseConfigs-allen2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "1400"^^xsd:integer .

entity:setting-gap-al-bain-numSparseConfigs-allen2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "1400"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-mg-allen2022 a mlips:MLIPRun ;
    rdfs:label "GAP for Mg trained on NDSC data" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-mg-allen2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-mg-numSparseConfigs-allen2022 ;
    mlips:produces entity:model-gap-mg-allen2022 .

entity:model-gap-mg-allen2022 a mlips:TrainedModel ;
    rdfs:label "GAP Mg (NDSC)" .

entity:run-gap-al-allen2022 a mlips:MLIPRun ;
    rdfs:label "GAP for Al trained on NDSC data" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-al-allen2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-al-numSparseConfigs-allen2022 ;
    mlips:produces entity:model-gap-al-allen2022 .

entity:model-gap-al-allen2022 a mlips:TrainedModel ;
    rdfs:label "GAP Al (NDSC)" .

entity:run-gap-si-allen2022 a mlips:MLIPRun ;
    rdfs:label "GAP for Si trained on NDSC data" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-si-allen2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-si-numSparseConfigs-allen2022 ;
    mlips:produces entity:model-gap-si-allen2022 .

entity:model-gap-si-allen2022 a mlips:TrainedModel ;
    rdfs:label "GAP Si (NDSC)" .

entity:run-gap-w-allen2022 a mlips:MLIPRun ;
    rdfs:label "GAP for W trained on NDSC data" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-w-allen2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-w-numSparseConfigs-allen2022 ;
    mlips:produces entity:model-gap-w-allen2022 .

entity:model-gap-w-allen2022 a mlips:TrainedModel ;
    rdfs:label "GAP W (NDSC)" .

entity:run-gap-al-bain-allen2022 a mlips:MLIPRun ;
    rdfs:label "GAP for Al extended along the Bain path" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-al-bain-allen2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-al-bain-numSparseConfigs-allen2022 ;
    mlips:produces entity:model-gap-al-bain-allen2022 .

entity:model-gap-al-bain-allen2022 a mlips:TrainedModel ;
    rdfs:label "GAP Al (NDSC + Bain path)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Model quality is given as RMSEs of phonon frequencies (THz) and elastic constants (Table III), which are property errors. Minimal-data Al models (74 and 65 environments) are not encoded as runs. The fitting code is not named beyond 'the GAP framework'.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/allen2022.yaml) until the schema has terms for them.
