# Canonical Turtle for the protocol-derived encoding of:
#   Pradeep Kumar Rana et al. (2025). Prediction of Mechanical Properties and Thermodynamic Stability of Ti-N system using MTP Interatomic Potential.
#   arXiv (Cornell University). doi:10.48550/arxiv.2507.18873  arXiv:2507.18873v1
#
# Version read: arxiv-preprint arXiv:2507.18873v1 (sha256 f87ca551486c780a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 590 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/rana2025.yaml.
#
# Encoding scope: three MTPs for Ti-N (Ti, Ti2N, Ti3N2, Ti4N3, Ti6N5, TiN)
# trained on 2,398 Maxvol-selected strained and finite-temperature PBE
# structures with energy:force:stress weights 1:0:0, 100:10:1 and
# 0.75:0.25:0.25. RMSEs are figure-only (Fig. 1); formation-energy and
# elastic-constant errors (Tables 3-5) are property errors.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-rana2025 a mlips:BenchmarkStudy ;
    rdfs:label "Rana et al. (2025): MTPs for the Ti-N system, loss-weight tuning and prediction of mechanical properties and thermodynamic stability" ;
    mlips:reportedIn entity:article-rana2025 .

entity:article-rana2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2507.18873> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Prediction of Mechanical Properties and Thermodynamic Stability of Ti-N system using MTP Interatomic Potential" ;
    schema:author entity:person-Rana-rana2025 ,
        entity:person-Vyawahare-rana2025 ,
        entity:person-Batra-rana2025 ,
        entity:person-Yadav-rana2025 .

entity:person-Rana-rana2025 a schema:Person ;
    schema:name "Pradeep Kumar Rana" ;
    schema:givenName "Pradeep Kumar" ;
    schema:familyName "Rana" .

entity:person-Vyawahare-rana2025 a schema:Person ;
    schema:name "Atharva Vyawahare" ;
    schema:givenName "Atharva" ;
    schema:familyName "Vyawahare" .

entity:person-Batra-rana2025 a schema:Person ;
    schema:name "Rohit Batra" ;
    schema:givenName "Rohit" ;
    schema:familyName "Batra" .

entity:person-Yadav-rana2025 a schema:Person ;
    schema:name "Satyesh Kumar Yadav" ;
    schema:givenName "Satyesh Kumar" ;
    schema:familyName "Yadav" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tin-rana2025 a mlips:MaterialSystem ;
    rdfs:label "Ti-N phases (Ti, Ti2N, Ti3N2, Ti4N3, Ti6N5, TiN), strained and at finite temperature" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-rana2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-rana2025 mlips:hasDFTSettings entity:calc-settings-vasp-rana2025 .

entity:calc-settings-vasp-rana2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack, resolution below 2 pi x 0.03 1/A" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-tin-rana2025 a mlips:TrainingDataset ;
    rdfs:label "Ti-N training set (2,398 Maxvol-selected structures)" ;
    mlips:coversMaterial entity:mat-tin-rana2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2398 ;
    mlips:hasDFTCalculation entity:calc-vasp-rana2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-tin-rana2025 mlips:samplingStrategy
    entity:sampling-maxvol-rana2025 .

entity:sampling-maxvol-rana2025 a mlips:SamplingStrategy ;
    rdfs:label "Strained structures and 2-13 ps finite-temperature MD (10-400 K), reduced with the Maxvol algorithm (Table 2)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-rana2025 ;
    mlips:hasImplementation entity:impl-MTP-rana2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-MTP-rana2025 a mlips:LossFunction ;
    rdfs:label "Weighted energies, forces and stresses (weights per model)" .

entity:impl-MTP-rana2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp100-rana2025 a mlips:MLIPRun ;
    rdfs:label "MTP with weights 1:0:0 (energy only)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-tin-rana2025 ;
    mlips:produces entity:model-mtp100-rana2025 .

entity:model-mtp100-rana2025 a mlips:TrainedModel ;
    rdfs:label "MTP Ti-N 1-0-0" .

entity:run-mtp10010-rana2025 a mlips:MLIPRun ;
    rdfs:label "MTP with weights 100:10:1" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-tin-rana2025 ;
    mlips:produces entity:model-mtp10010-rana2025 .

entity:model-mtp10010-rana2025 a mlips:TrainedModel ;
    rdfs:label "MTP Ti-N 100-10-1" .

entity:run-mtp075-rana2025 a mlips:MLIPRun ;
    rdfs:label "MTP with weights 0.75:0.25:0.25 (selected)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-tin-rana2025 ;
    mlips:produces entity:model-mtp075-rana2025 .

entity:model-mtp075-rana2025 a mlips:TrainedModel ;
    rdfs:label "MTP Ti-N 0.75-0.25-0.25" .

