# Canonical Turtle for the protocol-derived encoding of:
#   Rui Wang et al. (2022). Classical and machine learning interatomic potentials for BCC vanadium.
#   Physical Review Materials. doi:10.1103/physrevmaterials.6.113603  arXiv:2209.12322v1
#
# Version read: arxiv-preprint arXiv:2209.12322v1 (sha256 ca29df6e27156e47...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 447 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wang2022.yaml.
#
# Encoding scope: the VASP PBE training data for vanadium built with
# DP-GEN (bulk, surfaces, interstitials, high-density BCC/FCC) plus
# specialised gamma-line, cohesive-energy and vacancy sets (8,786
# configurations, Table III), the DP-HYB-V model (hybrid descriptor,
# DeePMD-kit), and the GAP-V of the literature used as a benchmark. No
# energy/force errors are stated; lattice, elastic, defect, surface and
# dislocation properties and relative speeds are properties. XMEAM-V is a
# classical potential and not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wang2022 a mlips:BenchmarkStudy ;
    rdfs:label "Wang et al. (2022): classical XMEAM and machine-learned DP-HYB interatomic potentials for BCC vanadium, benchmarked with GAP-V" ;
    mlips:reportedIn entity:article-wang2022 .

entity:article-wang2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.6.113603> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Classical and machine learning interatomic potentials for BCC vanadium" ;
    schema:author <https://orcid.org/0000-0002-9532-0810> ,
        <https://orcid.org/0000-0001-8189-7240> ,
        entity:person-Zhang-wang2022 ,
        entity:person-Wang-wang2022 ,
        <https://orcid.org/0000-0001-6038-020X> ,
        <https://orcid.org/0000-0003-1692-2512> ,
        <https://orcid.org/0000-0002-4739-1139> .

<https://orcid.org/0000-0002-9532-0810> a schema:Person ;
    schema:name "Rui Wang" ;
    schema:givenName "Rui" ;
    schema:familyName "Wang" ;
    schema:identifier <https://orcid.org/0000-0002-9532-0810> .

<https://orcid.org/0000-0001-8189-7240> a schema:Person ;
    schema:name "Xiaoxiao Ma" ;
    schema:givenName "Xiaoxiao" ;
    schema:familyName "Ma" ;
    schema:identifier <https://orcid.org/0000-0001-8189-7240> .

entity:person-Zhang-wang2022 a schema:Person ;
    schema:name "Linfeng Zhang" ;
    schema:givenName "Linfeng" ;
    schema:familyName "Zhang" .

entity:person-Wang-wang2022 a schema:Person ;
    schema:name "Han Wang" ;
    schema:givenName "Han" ;
    schema:familyName "Wang" .

<https://orcid.org/0000-0001-6038-020X> a schema:Person ;
    schema:name "David J. Srolovitz" ;
    schema:givenName "David J." ;
    schema:familyName "Srolovitz" ;
    schema:identifier <https://orcid.org/0000-0001-6038-020X> .

<https://orcid.org/0000-0003-1692-2512> a schema:Person ;
    schema:name "Tongqi Wen" ;
    schema:givenName "Tongqi" ;
    schema:familyName "Wen" ;
    schema:identifier <https://orcid.org/0000-0003-1692-2512> .

<https://orcid.org/0000-0002-4739-1139> a schema:Person ;
    schema:name "Zhaoxuan Wu" ;
    schema:givenName "Zhaoxuan" ;
    schema:familyName "Wu" ;
    schema:identifier <https://orcid.org/0000-0002-4739-1139> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-v-wang2022 a mlips:MaterialSystem ;
    rdfs:label "Vanadium: BCC (bulk, surfaces, point defects, dislocations), FCC and HCP structures" ;
    mlips:chemicalFormula "V" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-wang2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-wang2022 mlips:hasDFTSettings entity:calc-settings-pbe-wang2022 .

entity:calc-settings-pbe-wang2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "650"^^xsd:double ;
    mlips:kPointMesh "0.1 1/A spacing" ;
    rdfs:comment "V_sv PAW (13 valence electrons), Methfessel-Paxton 0.22 eV (Sec. II A)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-v-wang2022 a mlips:TrainingDataset ;
    rdfs:label "DP-HYB-V training data (Table III; weights 1-100 per data type)" ;
    mlips:coversMaterial entity:mat-v-wang2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 8786 ;
    mlips:hasDFTCalculation entity:calc-pbe-wang2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-v-wang2022 mlips:samplingStrategy
    entity:sampling-dpgen-wang2022 .

entity:sampling-dpgen-wang2022 a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN loops over bulk (50 K to 1.9 Tm, 8 pressures), surfaces, self-interstitials and high-density structures, selecting configurations by force deviation of four DP models; plus specialised gamma-line, EOS and vacancy sets" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-wang2022 ;
    mlips:hasHyperparameter mlips:learningRate ;
    mlips:hasImplementation entity:impl-DeePMD-wang2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:loss-DeePMD-wang2022 a mlips:LossFunction ;
    rdfs:label "Energy, force and virial prefactors 10, 1 and 10 (start and limit)" .

entity:impl-DeePMD-wang2022 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-hyb-v-learningRate-wang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-hyb-v-wang2022 a mlips:MLIPRun ;
    rdfs:label "DP-HYB-V: DeePMD with the hybrid descriptor, best of four models further trained on all data (4e6 steps)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-v-wang2022 ;
    mlips:hasHyperparameterSetting entity:setting-dp-hyb-v-learningRate-wang2022 ;
    mlips:produces entity:model-dp-hyb-v-wang2022 .

entity:model-dp-hyb-v-wang2022 a mlips:TrainedModel ;
    rdfs:label "DP-HYB-V" .

entity:run-gap-v-wang2022 a mlips:MLIPRun ;
    rdfs:label "GAP-V of the literature as published (benchmark)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:produces entity:model-gap-v-wang2022 .

entity:model-gap-v-wang2022 a mlips:TrainedModel ;
    rdfs:label "GAP-V" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# For the largest system (more than 30,000 atoms, LAMMPS, 32 CPU cores) XMEAM-V is about 20 % faster than compressed DP-HYB-V, 13.3 times faster than uncompressed DP-HYB-V and 31.6 times faster than GAP-V; compression speeds DP-HYB-V up about 10 times on CPU and 6 times on a V100 GPU (Sec. III K; absolute speeds in Fig. 12).

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No energy or force errors are stated for DP-HYB-V. Lattice parameters, elastic constants, surface energies, point-defect energies, Peierls stresses and barriers (Tables V-IX) are properties.
# - DP-HYB (the hybrid se_e2_a + se_e3 descriptor) is encoded under DeePMD with the descriptor as a setting. XMEAM-V is a classical MEAM and not an MLIP.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/wang2022.yaml) until the schema has terms for them.
