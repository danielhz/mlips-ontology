# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-liu2026ai2pot a mlips:MLIPRun ;
    rdfs:label "MTP (level 18, 526 parameters) for Ge-Sb-Te" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-gst-liu2026ai2pot ;
    mlips:hasHyperparameterSetting entity:setting-mtp-momentLevel-liu2026ai2pot ,
        entity:setting-mtp-cutoffRadius-liu2026ai2pot ,
        entity:setting-mtp-numRadialBasis-liu2026ai2pot ,
        entity:setting-mtp-learningRate-liu2026ai2pot ,
        entity:setting-mtp-numEpochs-liu2026ai2pot ,
        entity:setting-mtp-batchSize-liu2026ai2pot ;
    mlips:produces entity:model-mtp-liu2026ai2pot .

entity:model-mtp-liu2026ai2pot a mlips:TrainedModel ;
    rdfs:label "AI2Pot MTP Ge-Sb-Te" .

entity:run-nep-liu2026ai2pot a mlips:MLIPRun ;
    rdfs:label "NEP (7.9k parameters) for Ge-Sb-Te" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-gst-liu2026ai2pot ;
