###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-gst-liu2026ai2pot a mlips:MaterialSystem ;
    rdfs:label "Ge-Sb-Te crystalline, liquid and amorphous configurations of various compositions" ;
    mlips:materialClass "Phase-change materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-fp-liu2026ai2pot a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-fp-liu2026ai2pot mlips:hasDFTSettings entity:calc-settings-fp-liu2026ai2pot .

entity:calc-settings-fp-liu2026ai2pot a mlips:DFTSettings ;
    rdfs:comment "First-principles energies, forces and virials; level of theory not stated in the text read" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-gst-liu2026ai2pot a mlips:TrainingDataset ;
    rdfs:label "Ge-Sb-Te training set (2,633 frames, 283,465 atoms)" ;
    mlips:coversMaterial entity:mat-gst-liu2026ai2pot ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2633 ;
    mlips:hasDFTCalculation entity:calc-fp-liu2026ai2pot .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gst-liu2026ai2pot mlips:samplingStrategy
    entity:sampling-gst-liu2026ai2pot .

entity:sampling-gst-liu2026ai2pot a mlips:SamplingStrategy ;
    rdfs:label "Ge-Sb-Te dataset of crystalline, liquid and amorphous configurations (source not described)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-liu2026ai2pot ;
    mlips:hasHyperparameter mlips:momentLevel ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:learningRate ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-MTP-liu2026ai2pot ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MTP-liu2026ai2pot a mlips:LossFunction ;
    rdfs:label "Energy, force and virial terms with dynamic loss weighting" .

entity:impl-MTP-liu2026ai2pot a mlips:Implementation ;
    mlips:implementedIn entity:lib-AI2Pot-liu2026ai2pot .

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-liu2026ai2pot ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numRadialBasis ,
        mlips:learningRate ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NEP-liu2026ai2pot ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NEP-liu2026ai2pot a mlips:LossFunction ;
    rdfs:label "Energy, force and virial terms with dynamic loss weighting" .

entity:impl-NEP-liu2026ai2pot a mlips:Implementation ;
    mlips:implementedIn entity:lib-AI2Pot-liu2026ai2pot .

entity:lib-AI2Pot-liu2026ai2pot a mlips:Library ;
    rdfs:label "AI2Pot" ;
    mlips:candidateForVocabulary mlips:Library .

