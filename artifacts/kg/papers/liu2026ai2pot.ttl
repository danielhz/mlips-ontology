@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liu2026ai2pot a mlips:BenchmarkStudy ;
    rdfs:label "Liu et al. (2026): AI2Pot, a PyTorch/CUDA framework for training and deploying MTP and NEP potentials, demonstrated on Ge-Sb-Te" ;
