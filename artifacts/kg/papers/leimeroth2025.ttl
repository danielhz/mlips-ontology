###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-SiO-leimeroth2025 a mlips:MaterialSystem ;
    rdfs:label "Si-O system (crystalline, liquid and amorphous silica and related structures)" ;
    mlips:chemicalFormula "Si-O" ;
    mlips:materialClass "Ionic-covalent oxide" .

entity:mat-AlCuZr-leimeroth2025 a mlips:MaterialSystem ;
    rdfs:label "Al-Cu-Zr system (crystalline phases and metallic glasses)" ;
    mlips:chemicalFormula "Al-Cu-Zr" ;
    mlips:materialClass "Metallic alloy / metallic glass" .

