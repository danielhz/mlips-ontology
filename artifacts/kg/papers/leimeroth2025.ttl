###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-SiO-leimeroth2025 a mlips:TrainingDataset ;
    rdfs:label "Si-O training data (from the earlier silica potential study)" ;
    mlips:coversMaterial entity:mat-SiO-leimeroth2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-AlCuZr-leimeroth2025 a mlips:TrainingDataset ;
    rdfs:label "Al-Cu-Zr training data (Cu-Zr data extended with Al)" ;
    mlips:coversMaterial entity:mat-AlCuZr-leimeroth2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-SiO-leimeroth2025 mlips:samplingStrategy
    entity:sampling-published-leimeroth2025 .

entity:ds-AlCuZr-leimeroth2025 mlips:samplingStrategy
    entity:sampling-published-leimeroth2025 .

entity:sampling-published-leimeroth2025 a mlips:SamplingStrategy ;
    rdfs:label "Published DFT training data from the authors' earlier potential-development studies (Si-O unchanged; Cu-Zr data extended with Al in the same way), available on Zenodo" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

