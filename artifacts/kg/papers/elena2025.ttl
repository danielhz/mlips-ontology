###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mof-elena2025 a mlips:MaterialSystem ;
    rdfs:label "Metal-organic frameworks (19 prototypical MOFs plus 108 QMOF structures; 24 elements; mostly closed-shell metals)" ;
    mlips:materialClass "Metal-organic frameworks" .

entity:mat-qmof70-elena2025 a mlips:MaterialSystem ;
    rdfs:label "70 diverse QMOF metal-organic frameworks unseen in training" ;
    mlips:materialClass "Metal-organic frameworks" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbed3-elena2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbed3-elena2025 mlips:hasDFTSettings entity:calc-settings-pbed3-elena2025 .

entity:calc-settings-pbed3-elena2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    rdfs:comment "PBE-D3(BJ), MPtrj-compatible settings (PAW 54), EDIFF 1e-5, EDIFFG -0.02 eV/A, atomate2 (Sec. 4.1)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mof-elena2025 a mlips:TrainingDataset ;
    rdfs:label "Curated MOF fine-tuning data (127 MOFs, 4,764 DFT points; 85 % train, 7.5 % validation, 7.5 % test)" ;
    mlips:coversMaterial entity:mat-mof-elena2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4764 ;
    mlips:hasDFTCalculation entity:calc-pbed3-elena2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mof-elena2025 mlips:samplingStrategy
    entity:sampling-fps-elena2025 .

entity:sampling-fps-elena2025 a mlips:SamplingStrategy ;
    rdfs:label "NPT MD with MACE-MP-0b+D3, equation-of-state strains (-10 % to +10 %) and geometry-optimisation trajectories, frames selected by farthest-point sampling in MACE descriptor space" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-elena2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-elena2025 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-MACE-elena2025 a mlips:LossFunction ;
    rdfs:label "Energy, force and stress weights 1:10:100; multi-head fine-tuning with an MPtrj replay head (FPS-selected MPtrj configurations)" .

entity:impl-MACE-elena2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

