    schema:sameAs <https://doi.org/10.1038/s41524-025-01611-8> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Machine learned potential for high-throughput phonon calculations of metal—organic frameworks" ;
    schema:author entity:person-Elena-elena2025 ,
