# Q2 -- Material system
###############################################################################

entity:mat-surfaces-peuch2026 a mlips:MaterialSystem ;
    rdfs:label "Transition-metal and alloy surfaces with adsorbates, oxides and reaction intermediates (HetCat26)" ;
    mlips:materialClass "heterogeneous catalysts" .

