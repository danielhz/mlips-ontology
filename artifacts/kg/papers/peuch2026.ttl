    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa-0-peuch2026 .

entity:model-mace-mpa-0-peuch2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

