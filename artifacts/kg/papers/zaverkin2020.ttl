###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ethanol-500K-zaverkin2020 mlips:samplingStrategy
    entity:sampling-xtb-md-zaverkin2020 .

entity:ds-ethanol-1000K-zaverkin2020 mlips:samplingStrategy
    entity:sampling-xtb-md-zaverkin2020 .

entity:sampling-xtb-md-zaverkin2020 a mlips:SamplingStrategy ;
    rdfs:label "GFN2-xTB Born-Oppenheimer MD at 500 K or 1000 K, every 10th step recomputed with DFT" ;
    rdfs:comment "NVT, Berendsen thermostat, 0.5 fs, 50,000 steps (25 ps); 5,000 structures per data set." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GMNN a mlips:MLIPMethod ;
    rdfs:label "Gaussian Moment Neural Network (GMNN)" ;
    mlips:hasLossFunction entity:loss-GMNN-zaverkin2020 ;
    mlips:hasTrainingAlgorithm entity:alg-GMNN-zaverkin2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-GMNN-zaverkin2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-GMNN-zaverkin2020 a mlips:LossFunction ;
    rdfs:label "Squared energy error plus force error weighted by wF/(3 Nat), wE = 1 and wF = 100 A^2 (Eq. 16); wF = 0 for QM9" .

entity:alg-GMNN-zaverkin2020 a mls:Algorithm ;
    rdfs:label "AMSGrad with constant learning rate and early stopping on a validation set" .

entity:impl-GMNN-zaverkin2020 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GM-NN-TensorFlow-zaverkin2020 .

entity:lib-GM-NN-TensorFlow-zaverkin2020 a mlips:Library ;
    rdfs:label "GM-NN (TensorFlow)" ;
    rdfs:comment "TensorFlow implementation with ASE neighbour lists" ;
    mlips:candidateForVocabulary mlips:Library .

