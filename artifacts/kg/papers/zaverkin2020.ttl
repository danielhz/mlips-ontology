# Canonical Turtle for the protocol-derived encoding of:
#   Viktor Zaverkin et al. (2020). Gaussian Moments as Physically Inspired Molecular Descriptors for Accurate and Scalable Machine Learning Potentials.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.0c00347  arXiv:2109.07421v1
#
# Version read: arxiv-preprint arXiv:2109.07421v1 (sha256 2be9bd3314ba8f47...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 211 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/zaverkin2020.yaml.
#
# Encoding scope: the GM-NN method (Gaussian moment descriptor with
# atomistic feed-forward networks; GMNN in the registry; introduced here)
# with its shallow (GM-sNN) and deep (GM-dNN) networks: QM9 energy errors
# for seven training-set sizes (Table 1) and the size-transfer test, MD17
# energy and force MAEs (Table 2), ISO17 (Table 3), and the two ethanol
# models trained on new PBE-D3(BJ) data at 500 K and 1000 K (barriers in
# Table 4, no error metric). Learning curves shown only in figures and
# values quoted from other papers are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zaverkin2020 a mlips:BenchmarkStudy ;
    rdfs:label "Zaverkin and Kästner (2020): Gaussian moments as molecular descriptors for neural network potentials (GM-NN)" ;
    mlips:reportedIn entity:article-zaverkin2020 .

entity:article-zaverkin2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.0c00347> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Gaussian Moments as Physically Inspired Molecular Descriptors for Accurate and Scalable Machine Learning Potentials" ;
    schema:author entity:person-Zaverkin-zaverkin2020 ,
        <https://orcid.org/0000-0001-6178-7669> .

entity:person-Zaverkin-zaverkin2020 a schema:Person ;
    schema:name "V. Zaverkin" ;
    schema:givenName "V." ;
    schema:familyName "Zaverkin" .

<https://orcid.org/0000-0001-6178-7669> a schema:Person ;
    schema:name "J. Kästner" ;
    schema:givenName "J." ;
    schema:familyName "Kästner" ;
    schema:identifier <https://orcid.org/0000-0001-6178-7669> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-qm9-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules with up to nine heavy atoms (QM9)" ;
    mlips:materialClass "Small organic molecules (equilibrium geometries)" .

entity:mat-qm9-large-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "QM9 molecules with more than 15 atoms" ;
    mlips:materialClass "Small organic molecules (equilibrium geometries)" .

entity:mat-benzene-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-toluene-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-malonaldehyde-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-salicylic-acid-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-aspirin-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-ethanol-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-uracil-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Uracil molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-naphthalene-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "Naphthalene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-iso17-zaverkin2020 a mlips:MaterialSystem ;
    rdfs:label "C7O2H10 isomers (ISO17)" ;
    mlips:chemicalFormula "C7O2H10" ;
    mlips:materialClass "Small organic molecules (MD trajectories)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-md17-zaverkin2020 a mlips:DFTCalculation .

entity:calc-ethanol-zaverkin2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-md17-zaverkin2020 mlips:hasDFTSettings entity:calc-settings-md17-zaverkin2020 .

entity:calc-settings-md17-zaverkin2020 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE-vdW-TS-zaverkin2020 ;
    rdfs:comment "Level of the MD17 data set as stated in Sec. 3.4; the basis is not given." .

entity:calc-ethanol-zaverkin2020 mlips:hasDFTSettings entity:calc-settings-ethanol-zaverkin2020 .

entity:calc-settings-ethanol-zaverkin2020 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Turbomole-7_1-zaverkin2020 ;
    mlips:xcFunctional entity:xc-PBE-D3-BJ-zaverkin2020 ;
    mlips:basisSet "6-31G*" ;
    rdfs:comment "Single points within ChemShell on geometries from GFN2-xTB Born-Oppenheimer MD (Sec. 3.4)." .

entity:xc-PBE-vdW-TS-zaverkin2020 a mlips:XCFunctional ;
    rdfs:label "PBE+vdW-TS" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:lib-Turbomole-7_1-zaverkin2020 a mlips:Library ;
    rdfs:label "Turbomole 7.1" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE-D3-BJ-zaverkin2020 a mlips:XCFunctional ;
    rdfs:label "PBE-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

