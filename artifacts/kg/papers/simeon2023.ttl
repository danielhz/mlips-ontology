# Canonical Turtle for the protocol-derived encoding of:
#   Guillem Simeon et al. (2023). TensorNet: Cartesian Tensor Representations for Efficient Learning of Molecular Potentials.
#   neural information processing systems. doi:10.52202/075280-1623  arXiv:2306.06482v2
#
# Version read: arxiv-preprint arXiv:2306.06482v2 (sha256 18b8666f8eec0b7f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 209 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/simeon2023.yaml.
#
# Encoding scope: TensorNet (introduced here) with its energy and force
# errors on rMD17 with one and two interaction layers (Table 2), QM9 U0
# (Table 1), SPICE (text), ANI1x and the COMP6 benchmarks (Table 3) and
# ethanol in vacuum (Table 4). The other QM9 targets, the ablations
# (Table 5), dipole/polarisability/shielding errors and values quoted from
# other papers are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-simeon2023 a mlips:BenchmarkStudy ;
    rdfs:label "Simeon and De Fabritiis (2023): TensorNet, Cartesian tensor representations for molecular potentials" ;
    mlips:reportedIn entity:article-simeon2023 .

entity:article-simeon2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.52202/075280-1623> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "TensorNet: Cartesian Tensor Representations for Efficient Learning of Molecular Potentials" ;
    schema:author entity:person-Simeon-simeon2023 ,
        entity:person-Fabritiis-simeon2023 .

entity:person-Simeon-simeon2023 a schema:Person ;
    schema:name "Guillem Simeon" ;
    schema:givenName "Guillem" ;
    schema:familyName "Simeon" .

entity:person-Fabritiis-simeon2023 a schema:Person ;
    schema:name "Gianni De Fabritiis" ;
    schema:givenName "Gianni De" ;
    schema:familyName "Fabritiis" .

