###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-rmd17-simeon2023 a mlips:DFTCalculation .

entity:calc-qm9-simeon2023 a mlips:DFTCalculation .

entity:calc-spice-simeon2023 a mlips:DFTCalculation .

entity:calc-ani1x-simeon2023 a mlips:DFTCalculation .

entity:calc-ethanol-pbe0-simeon2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-rmd17-simeon2023 mlips:hasDFTSettings entity:calc-settings-rmd17-simeon2023 .

entity:calc-settings-rmd17-simeon2023 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE-simeon2023 ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "rMD17 recomputation with a very dense integration grid and very tight SCF convergence (App. A.3)." .

entity:calc-qm9-simeon2023 mlips:hasDFTSettings entity:calc-settings-qm9-simeon2023 .

entity:calc-settings-qm9-simeon2023 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-B3LYP-simeon2023 ;
    mlips:basisSet "6-31G(2df,p)" .

entity:calc-spice-simeon2023 mlips:hasDFTSettings entity:calc-settings-spice-simeon2023 .

entity:calc-settings-spice-simeon2023 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-wB97M-D3BJ-simeon2023 ;
    mlips:basisSet "def2-TZVPPD" .

entity:calc-ani1x-simeon2023 mlips:hasDFTSettings entity:calc-settings-ani1x-simeon2023 .

entity:calc-settings-ani1x-simeon2023 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "ANI1x and COMP6 (App. A.3)." .

entity:calc-ethanol-pbe0-simeon2023 mlips:hasDFTSettings entity:calc-settings-ethanol-pbe0-simeon2023 .

entity:calc-settings-ethanol-pbe0-simeon2023 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE0 ;
    rdfs:comment "Ethanol-in-vacuum reference data of FieldSchNet (App. A.3)." .

entity:xc-PBE-simeon2023 a mlips:XCFunctional ;
    rdfs:label "PBE" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-B3LYP-simeon2023 a mlips:XCFunctional ;
    rdfs:label "B3LYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-wB97M-D3BJ-simeon2023 a mlips:XCFunctional ;
    rdfs:label "wB97M-D3BJ" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

