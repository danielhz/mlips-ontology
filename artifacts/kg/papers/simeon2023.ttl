###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" ;
    mlips:hasLossFunction entity:loss-TensorNet-simeon2023 ;
    mlips:hasTrainingAlgorithm entity:alg-TensorNet-simeon2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-TensorNet-simeon2023 .

entity:loss-TensorNet-simeon2023 a mlips:LossFunction ;
    rdfs:label "MSE on energies (QM9) or weighted MSE on energies and forces (weights 0.5 and 0.5; 1 and 100 for ANI1x)" .

entity:alg-TensorNet-simeon2023 a mls:Algorithm ;
    rdfs:label "Adam with linear warm-up and reduce-on-plateau learning-rate decay" .

entity:impl-TensorNet-simeon2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-TorchMD-NET-simeon2023 .

entity:lib-TorchMD-NET-simeon2023 a mlips:Library ;
    rdfs:label "TorchMD-NET" ;
    rdfs:comment "TensorNet implemented within the TorchMD-NET framework (PyTorch 1.11.0, PyTorch Geometric 2.0.3, PyTorch Lightning 1.6.3)" ;
    mlips:candidateForVocabulary mlips:Library .

