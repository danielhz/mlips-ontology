entity:ds-rmd17-aspirin-simeon2023 a mlips:TrainingDataset ;
    rdfs:label "rMD17 aspirin training set (950 conformations)" ;
    mlips:coversMaterial entity:mat-aspirin-simeon2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 950 ;
    mlips:hasDFTCalculation entity:calc-rmd17-simeon2023 ;
    rdfs:comment "950 training and 50 validation conformations; errors on all remaining conformations; five random splits." .

