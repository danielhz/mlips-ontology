# Canonical Turtle for the protocol-derived encoding of:
#   Vladislav O. Korostelev et al. (2026). Can Universal Machine-Learning Interatomic Potentials Capture Small Polarons? A Geometry-Based Benchmark in Transition-Metal Oxides.
#   arXiv (Cornell University). doi:10.48550/arxiv.2610.17352  arXiv:2610.17352v1
#
# Version read: arxiv-preprint arXiv:2610.17352v1 (sha256 ad9b22b03d168412...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 334 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/korostelev2026.yaml.
#
# Encoding scope: five pretrained universal MLIP checkpoints (CHGNet
# v0.3.0, mace-mpa-0-medium, mace-omat-0-medium, uma-s-1p2 omat task,
# matris_10m_oam) relaxed from DFT+U polaron geometries of H-doped
# transition-metal oxides (Methods), with BFGS relaxations and linear
# interpolations of the localized-delocalized path. Results are Z-score
# ratios, magnetic moments and polaron-transfer barriers, not energy/force
# error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-korostelev2026 a mlips:BenchmarkStudy ;
    rdfs:label "Korostelev et al. (2026): can universal MLIPs capture small polarons? A Z-score geometric benchmark on H-doped transition-metal oxides" ;
    mlips:reportedIn entity:article-korostelev2026 .

entity:article-korostelev2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.17352> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Can Universal Machine-Learning Interatomic Potentials Capture Small Polarons? A Geometry-Based Benchmark in Transition-Metal Oxides" ;
    schema:author entity:person-Korostelev-korostelev2026 ,
        entity:person-Zguns-korostelev2026 ,
        entity:person-Klyukin-korostelev2026 .

entity:person-Korostelev-korostelev2026 a schema:Person ;
    schema:name "Vladislav Korostelev" ;
    schema:givenName "Vladislav" ;
    schema:familyName "Korostelev" .

entity:person-Zguns-korostelev2026 a schema:Person ;
    schema:name "Pjotrs Žguns" ;
    schema:givenName "Pjotrs" ;
    schema:familyName "Žguns" .

entity:person-Klyukin-korostelev2026 a schema:Person ;
    schema:name "Konstantin Klyukin" ;
    schema:givenName "Konstantin" ;
    schema:familyName "Klyukin" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tmo-korostelev2026 a mlips:MaterialSystem ;
    rdfs:label "H-doped transition-metal oxides (TiO2, Sr2Fe2O5, Sr2Co2O5, Co3O4, NiO, V2O5, LiFePO4/FePO4, CrO2, Cr2O3, MnO2, Fe2O3, Fe3O4, MoO3, WO3, CeO2) with one interstitial H as electron donor" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbeu-korostelev2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbeu-korostelev2026 mlips:hasDFTSettings entity:calc-settings-pbeu-korostelev2026 .

entity:calc-settings-pbeu-korostelev2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "2x2x2 Gamma-centred" ;
    rdfs:comment "DFT+U (Materials Project U values on TM d states; none on Ti and Ce except the U(Ti) 0-5 eV sweep), spin-polarized, VASP 6.3.0, EDIFF 1e-6 eV, EDIFFG -0.02; climbing-image NEB for polaron-transfer barriers (Methods)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:MatRIS a mlips:MLIPMethod ;
    rdfs:label "MatRIS (invariant graph-attention interatomic potential with three-body features)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chgnet-korostelev2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet v0.3.0 as distributed (412,525 parameters; MPtrj)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-korostelev2026 .

entity:model-chgnet-korostelev2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet v0.3.0" .

entity:run-mace-mpa-korostelev2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 medium as distributed (mace-mpa-0-medium; MPtrj + Alexandria)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa-korostelev2026 .

entity:model-mace-mpa-korostelev2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0 (mace-mpa-0-medium)" .

entity:run-mace-omat-korostelev2026 a mlips:MLIPRun ;
    rdfs:label "MACE-OMAT-0 medium as distributed (mace-omat-0-medium; OMat24)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-omat-korostelev2026 .

entity:model-mace-omat-korostelev2026 a mlips:TrainedModel ;
    rdfs:label "mace-omat-0-medium" .

entity:run-uma-korostelev2026 a mlips:MLIPRun ;
    rdfs:label "UMA-S 1.2 as distributed (uma-s-1p2, omat task)" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-korostelev2026 .

entity:model-uma-korostelev2026 a mlips:TrainedModel ;
    rdfs:label "uma-s-1p2 (omat task)" .

entity:run-matris-korostelev2026 a mlips:MLIPRun ;
    rdfs:label "MatRIS 10M OAM as distributed (matris_10m_oam; 10,443,505 parameters; OMat24 + Alexandria + MPtrj)" ;
    mlips:appliesMethod entity:MatRIS ;
    mlips:produces entity:model-matris-korostelev2026 .

entity:model-matris-korostelev2026 a mlips:TrainedModel ;
    rdfs:label "matris_10m_oam" .

