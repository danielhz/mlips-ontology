# Canonical Turtle for the protocol-derived encoding of:
#   Brennon L. Shanks et al. (2022). Uncertainty quantification design principles for machine learning interatomic potentials: lessons learned from hierarchical Bayesian inference.
#   arXiv (Cornell University). doi:10.48550/arxiv.2206.08744  arXiv:2206.08744v2
#
# Version read: arxiv-preprint arXiv:2206.08744v2 (sha256 3b27ec5f61c36723...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 506 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/shanks2022.yaml.
#
# Encoding scope: the argon dimer/trimer CCSD(T) dataset (1,921
# configurations, nested training sets of 20-100, 1,821 held out), the
# fine-tuned MACE seed ensemble (five seeds from MACE-MH-0) and the MACE
# foundation committee (MH-0, MH-1, MPA-0, OMAT-0 each fine-tuned), with
# the energy RMSEs printed in Fig. 2 for energy+force training. The
# hierarchical GP potential (pair-distance descriptors, Mie prior mean,
# HMC hyperposterior) awaits a registry decision on GP regression
# potentials (as for holzenkamp2025) and is not encoded as a run. CRPS
# and coverage are not schema metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-shanks2022 a mlips:BenchmarkStudy ;
    rdfs:label "Shanks et al. (2022): uncertainty-quantification design principles for MLIPs from hierarchical Bayesian GP inference, benchmarked against fine-tuned MACE ensembles on CCSD(T) argon clusters" ;
    mlips:reportedIn entity:article-shanks2022 .

entity:article-shanks2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2206.08744> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Uncertainty quantification design principles for machine learning interatomic potentials: lessons learned from hierarchical Bayesian inference" ;
    schema:author entity:person-Shanks-shanks2022 ,
        entity:person-Simmons-shanks2022 ,
        entity:person-Bartok-shanks2022 ,
        entity:person-Kermode-shanks2022 .

entity:person-Shanks-shanks2022 a schema:Person ;
    schema:name "Brennon L. Shanks" ;
    schema:givenName "Brennon L." ;
    schema:familyName "Shanks" .

entity:person-Simmons-shanks2022 a schema:Person ;
    schema:name "George Simmons" ;
    schema:givenName "George" ;
    schema:familyName "Simmons" .

entity:person-Bartok-shanks2022 a schema:Person ;
    schema:name "Albert P. Bartók" ;
    schema:givenName "Albert P." ;
    schema:familyName "Bartók" .

entity:person-Kermode-shanks2022 a schema:Person ;
    schema:name "James. R. Kermode" ;
    schema:givenName "James. R." ;
    schema:familyName "Kermode" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ar-shanks2022 a mlips:MaterialSystem ;
    rdfs:label "Argon dimers (41) and trimers (1,880)" ;
    mlips:chemicalFormula "Ar" ;
    mlips:materialClass "Molecular dimers and noncovalent complexes" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ccsdt-shanks2022 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ccsdt-shanks2022 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-shanks2022 .

entity:calc-settings-ccsdt-shanks2022 a mlips:WaveFunctionSettings ;
    mlips:usedReferenceCode mlips:ORCA ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "aug-cc-pVQZ" ;
    rdfs:comment "Counterpoise-corrected; forces by symmetric finite differences (1e-4 A)" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ar20-shanks2022 a mlips:TrainingDataset ;
    rdfs:label "Argon cluster training set of 20 configurations (energies and forces)" ;
    mlips:coversMaterial entity:mat-ar-shanks2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 20 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-shanks2022 .

entity:ds-ar100-shanks2022 a mlips:TrainingDataset ;
    rdfs:label "Argon cluster training set of 100 configurations (energies and forces)" ;
    mlips:coversMaterial entity:mat-ar-shanks2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-shanks2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ar20-shanks2022 mlips:samplingStrategy
    entity:sampling-grid-shanks2022 .

entity:ds-ar100-shanks2022 mlips:samplingStrategy
    entity:sampling-grid-shanks2022 .

entity:sampling-grid-shanks2022 a mlips:SamplingStrategy ;
    rdfs:label "Dimers at 3-7 A; trimers with bond lengths 3-7 A and angles 0-180 degrees; nested random training subsets" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-shanks2022 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-shanks2022 ;
    mlips:hasImplementation entity:impl-MACE-shanks2022 .

entity:loss-MACE-shanks2022 a mlips:LossFunction ;
    rdfs:label "Energies and forces (energy+force setting)" .

entity:alg-MACE-shanks2022 a mls:Algorithm ;
    rdfs:label "Fine-tuning of foundation checkpoints (multi-head checkpoints from one head)" .

entity:impl-MACE-shanks2022 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-seed-20-shanks2022 a mlips:MLIPRun ;
    rdfs:label "MACE seed ensemble (5 seeds fine-tuned from MACE-MH-0, MATPES r2SCAN head), 20 training configurations" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ar20-shanks2022 ;
    mlips:produces entity:model-seed-20-shanks2022 .

entity:model-seed-20-shanks2022 a mlips:TrainedModel ;
    rdfs:label "MACE-MH-0 seed ensemble Ar (20)" .

entity:run-comm-20-shanks2022 a mlips:MLIPRun ;
    rdfs:label "MACE foundation committee (MH-0 r2SCAN head, MH-1 OMOL head, MPA-0, OMAT-0, each fine-tuned), 20 training configurations" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ar20-shanks2022 ;
    mlips:produces entity:model-comm-20-shanks2022 .

entity:model-comm-20-shanks2022 a mlips:TrainedModel ;
    rdfs:label "MACE foundation committee Ar (20)" .

entity:run-seed-100-shanks2022 a mlips:MLIPRun ;
    rdfs:label "MACE seed ensemble (5 seeds fine-tuned from MACE-MH-0, MATPES r2SCAN head), 100 training configurations" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ar100-shanks2022 ;
    mlips:produces entity:model-seed-100-shanks2022 .

entity:model-seed-100-shanks2022 a mlips:TrainedModel ;
    rdfs:label "MACE-MH-0 seed ensemble Ar (100)" .

entity:run-comm-100-shanks2022 a mlips:MLIPRun ;
    rdfs:label "MACE foundation committee (MH-0 r2SCAN head, MH-1 OMOL head, MPA-0, OMAT-0, each fine-tuned), 100 training configurations" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ar100-shanks2022 ;
    mlips:produces entity:model-comm-100-shanks2022 .

entity:model-comm-100-shanks2022 a mlips:TrainedModel ;
