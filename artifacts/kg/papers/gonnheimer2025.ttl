# Canonical Turtle for the protocol-derived encoding of:
#   Nils Gönnheimer et al. (2025). Beyond Numerical Hessians: Higher-Order Derivatives for Machine Learning Interatomic Potentials via Automatic Differentiation.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.4c01790
#
# Version read: publisher (sha256 00579d4411635e62...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 85 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the paper computes analytic Hessians (and higher
# derivatives) of the pretrained MACE-MP-0 'medium' model by automatic
# differentiation and uses them for vibrational frequencies and heat
# capacities of 233 porous materials (215 MOFs, 9 COFs, 9 zeolites),
# compared with published PBE-D3(BJ) values. No model is trained and no
# energy/force error is reported; only the demonstrated simulation types
# are asserted.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gonnheimer2025 a mlips:BenchmarkStudy ;
    rdfs:label "Goennheimer et al. (2025): beyond numerical Hessians, higher-order derivatives for MLIPs via automatic differentiation" ;
    mlips:reportedIn entity:article-gonnheimer2025 .

entity:article-gonnheimer2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.4c01790> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Beyond Numerical Hessians: Higher-Order Derivatives for Machine Learning Interatomic Potentials via Automatic Differentiation" ;
    schema:author entity:person-Gonnheimer-gonnheimer2025 ,
        <https://orcid.org/0000-0001-8473-8659> ,
        <https://orcid.org/0000-0002-0862-5289> .

entity:person-Gonnheimer-gonnheimer2025 a schema:Person ;
    schema:name "Nils Gönnheimer" ;
    schema:givenName "Nils" ;
    schema:familyName "Gönnheimer" .

<https://orcid.org/0000-0001-8473-8659> a schema:Person ;
    schema:name "Karsten Reuter" ;
    schema:givenName "Karsten" ;
    schema:familyName "Reuter" ;
    schema:identifier <https://orcid.org/0000-0001-8473-8659> .

<https://orcid.org/0000-0002-0862-5289> a schema:Person ;
