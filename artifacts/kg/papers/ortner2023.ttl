    mlips:reportedIn entity:article-ortner2023 .

entity:article-ortner2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.25950/c7f24234> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "On the Atomic Cluster Expansion: interatomic potentials and beyond" ;
    schema:author entity:person-Ortner-ortner2023 .

entity:person-Ortner-ortner2023 a schema:Person ;
    schema:name "Christoph Ortner" ;
    schema:givenName "Christoph" ;
    schema:familyName "Ortner" .

