###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:RACE a mlips:MLIPMethod ;
    rdfs:label "RACE (E(3)-equivariant many-body message passing with iterative restratification)" ;
    mlips:hasTrainingAlgorithm entity:alg-RACE-willow2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ,
        entity:hp-loss-weight-energy-willow2026 ,
        entity:hp-loss-weight-force-willow2026 .

entity:alg-RACE-willow2026 a mls:Algorithm ;
    rdfs:label "AMSGrad with ReduceLROnPlateau (decay factor 0.9, patience 50), exponential moving average of the weights (decay 0.99) (3BPA settings, Table S5)" .

entity:hp-loss-weight-energy-willow2026 a mlips:Hyperparameter ;
    rdfs:label "Energy coefficient of the loss (lambda_E)" ;
    mlips:hyperparameterName "lambda_E" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-loss-weight-force-willow2026 a mlips:Hyperparameter ;
    rdfs:label "Force coefficient of the loss (lambda_F)" ;
    mlips:hyperparameterName "lambda_F" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-race-3BPA-cutoffRadius-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-race-3BPA-numRadialBasis-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-race-3BPA-numLayers-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-race-3BPA-numFeatures-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-race-3BPA-learningRate-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-race-3BPA-batchSize-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-race-3BPA-numEpochs-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "5000"^^xsd:integer .

entity:setting-race-3BPA-loss-weight-energy-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-loss-weight-energy-willow2026 ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-race-3BPA-loss-weight-force-willow2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-loss-weight-force-willow2026 ;
    mlips:settingValue "100"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-race-3BPA-willow2026 a mlips:MLIPRun ;
    rdfs:label "RACE trained on 3BPA (300 K)" ;
    mlips:appliesMethod entity:RACE ;
    mlips:runsOn entity:ds-3BPA-willow2026 ;
    mlips:hasHyperparameterSetting entity:setting-race-3BPA-cutoffRadius-willow2026 ,
        entity:setting-race-3BPA-numRadialBasis-willow2026 ,
        entity:setting-race-3BPA-numLayers-willow2026 ,
        entity:setting-race-3BPA-numFeatures-willow2026 ,
        entity:setting-race-3BPA-learningRate-willow2026 ,
        entity:setting-race-3BPA-batchSize-willow2026 ,
        entity:setting-race-3BPA-numEpochs-willow2026 ,
        entity:setting-race-3BPA-loss-weight-energy-willow2026 ,
        entity:setting-race-3BPA-loss-weight-force-willow2026 ;
    mlips:produces entity:model-race-3BPA-willow2026 .

entity:model-race-3BPA-willow2026 a mlips:TrainedModel ;
    rdfs:label "RACE 3BPA model" .

