# Canonical Turtle for the protocol-derived encoding of:
#   Volker L. Deringer et al. (2017). Machine learning based interatomic potential for amorphous carbon.
#   Physical review. B./Physical review. B. doi:10.1103/physrevb.95.094203  arXiv:1611.03277v1
#
# Version read: arxiv-preprint arXiv:1611.03277v1 (sha256 5cdc61e608dec62f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 499 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/deringer2017.yaml.
#
# Encoding scope: the a-C GAP combining two-body, three-body and SOAP
# descriptors, trained on CASTEP LDA single points of liquid, amorphous,
# surface, crystalline and dimer structures built by iterative GAP-driven
# melt-quench; the energy and force RMS errors of Table II. Simpler
# descriptor combinations (Fig. 5), structural, elastic and surface
# properties are not metrics or are figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-deringer2017 a mlips:BenchmarkStudy ;
    rdfs:label "Deringer and Csanyi (2017): a GAP machine-learning potential for liquid and amorphous carbon (2b + 3b + SOAP)" ;
    mlips:reportedIn entity:article-deringer2017 .

entity:article-deringer2017 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevb.95.094203> ;
    schema:datePublished "2017"^^xsd:gYear ;
    schema:name "Machine learning based interatomic potential for amorphous carbon" ;
    schema:author entity:person-Deringer-deringer2017 ,
        entity:person-Csanyi-deringer2017 .

entity:person-Deringer-deringer2017 a schema:Person ;
    schema:name "Volker L. Deringer" ;
    schema:givenName "Volker L." ;
    schema:familyName "Deringer" .

entity:person-Csanyi-deringer2017 a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ac-deringer2017 a mlips:MaterialSystem ;
    rdfs:label "Liquid and amorphous carbon (bulk and surfaces), diamond and graphite" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental solid and liquid carbon" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-lda-deringer2017 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-lda-deringer2017 mlips:hasDFTSettings entity:calc-settings-lda-deringer2017 .

entity:calc-settings-lda-deringer2017 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:CASTEP ;
    mlips:xcFunctional mlips:LDA ;
    mlips:energyCutoff "650"^^xsd:double ;
    mlips:kPointMesh "Maximum spacing 0.03 1/A" ;
    rdfs:comment "Gaussian smearing 0.1 eV, finite-basis correction" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-train-deringer2017 a mlips:TrainingDataset ;
    rdfs:label "a-C training database (liquid, amorphous, surfaces, crystalline, dimer; 90% of the combined database)" ;
    mlips:coversMaterial entity:mat-ac-deringer2017 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-lda-deringer2017 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-train-deringer2017 mlips:samplingStrategy
    entity:sampling-mq-deringer2017 .

entity:sampling-mq-deringer2017 a mlips:SamplingStrategy ;
    rdfs:label "Snapshots from ab initio and iteratively GAP-driven melt-quench MD (1.5-3.5 g/cm3, 27-125 atoms), amorphous slabs, distorted diamond and graphite cells, carbon dimer" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:loss-GAP-deringer2017 ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-deringer2017 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-GAP-deringer2017 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-GAP-deringer2017 a mlips:LossFunction ;
    rdfs:label "GAP regression; expected errors 0.002 eV and 0.2 eV/A (liquid/amorphous), 10x smaller and virials 0.2 eV for crystals" .

entity:alg-GAP-deringer2017 a mls:Algorithm ;
    rdfs:label "2b and 3b terms on uniform sparse grids (15 and 200 points), SOAP with CUR sparsification (4,030 points), n_max = l_max = 8, zeta = 4" .

entity:impl-GAP-deringer2017 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-cutoffRadius-deringer2017 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3.7"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-deringer2017 a mlips:MLIPRun ;
    rdfs:label "GAP for amorphous carbon (2b + 3b + SOAP)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-train-deringer2017 ;
    mlips:hasHyperparameterSetting entity:setting-gap-cutoffRadius-deringer2017 ;
    mlips:produces entity:model-gap-deringer2017 .

entity:model-gap-deringer2017 a mlips:TrainedModel ;
    rdfs:label "GAP a-C (2017)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-deringer2017 mlips:hasResult
    entity:result-liq9000-deringer2017 ,
    entity:result-liq5000-deringer2017 ,
    entity:result-quench-deringer2017 ,
    entity:result-amorph-deringer2017 ,
    entity:result-cryst-deringer2017 .

entity:result-liq9000-deringer2017 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-deringer2017 ;
    mlips:targetMaterial entity:mat-ac-deringer2017 ;
    mlips:hasAccuracyMetric entity:metric-liq9000-1-deringer2017 ,
