# Canonical Turtle for the protocol-derived encoding of:
#   Zhao Fan et al. (2025). Efficient machine learning interatomic potentials robust for liquid and multiple solid polymorphs of NaF and KF.
#   Physical Review Materials. doi:10.1103/xbfm-clgd
#
# Version read: submittedVersion (sha256 6453a1ece8865b5a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 473 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/fan2025.yaml.
#
# Encoding scope: one linear ACE potential each for NaF and KF (268
# basis functions), trained by active learning (extrapolation grade,
# short bonds, uniform MD snapshots) on SCAN data for the liquid and the
# B1, B2, B3, B4 and H5 polymorphs up to 2000 K (NaF) or 1600 K (KF) and
# 100 GPa; final training and test RMSEs (Sec. II C) and the 1-million-
# atom MD cost. Per-snapshot error bounds from long MD (Figs. 4-5),
# melting points, thermodynamic and transport properties are not metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-fan2025 a mlips:BenchmarkStudy ;
    rdfs:label "Fan, Whittaker and Asta (2025): ACE potentials for liquid and five solid polymorphs of NaF and KF trained on SCAN data" ;
    mlips:reportedIn entity:article-fan2025 .

entity:article-fan2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/xbfm-clgd> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Efficient machine learning interatomic potentials robust for liquid and multiple solid polymorphs of NaF and KF" ;
    schema:author <https://orcid.org/0000-0002-2523-2532> ,
        <https://orcid.org/0000-0002-9724-3409> ,
        <https://orcid.org/0000-0002-8968-321X> .

<https://orcid.org/0000-0002-2523-2532> a schema:Person ;
    schema:name "Zhao Fan" ;
    schema:givenName "Zhao" ;
    schema:familyName "Fan" ;
    schema:identifier <https://orcid.org/0000-0002-2523-2532> .

<https://orcid.org/0000-0002-9724-3409> a schema:Person ;
    schema:name "Michael L. Whittaker" ;
    schema:givenName "Michael L." ;
    schema:familyName "Whittaker" ;
    schema:identifier <https://orcid.org/0000-0002-9724-3409> .

<https://orcid.org/0000-0002-8968-321X> a schema:Person ;
    schema:name "Mark Asta" ;
    schema:givenName "Mark" ;
    schema:familyName "Asta" ;
    schema:identifier <https://orcid.org/0000-0002-8968-321X> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-naf-fan2025 a mlips:MaterialSystem ;
    rdfs:label "NaF liquid and B1, B2, B3, B4, H5 polymorphs" ;
    mlips:chemicalFormula "NaF" ;
    mlips:materialClass "Molten salts and ionic crystals" .

entity:mat-kf-fan2025 a mlips:MaterialSystem ;
    rdfs:label "KF liquid and B1, B2, B3, B4, H5 polymorphs" ;
    mlips:chemicalFormula "KF" ;
    mlips:materialClass "Molten salts and ionic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-scan-fan2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-scan-fan2025 mlips:hasDFTSettings entity:calc-settings-scan-fan2025 .

entity:calc-settings-scan-fan2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:SCAN ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma point (cells > 200 atoms)" ;
    rdfs:comment "No dispersion correction; SCF convergence 0.1 meV" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-naf-train-fan2025 a mlips:TrainingDataset ;
    rdfs:label "NaF training set (15,720 configurations, 4,124,984 atoms)" ;
    mlips:coversMaterial entity:mat-naf-fan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 15720 ;
    mlips:hasDFTCalculation entity:calc-scan-fan2025 .

entity:ds-kf-train-fan2025 a mlips:TrainingDataset ;
    rdfs:label "KF training set (14,964 configurations, 3,642,464 atoms)" ;
    mlips:coversMaterial entity:mat-kf-fan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 14964 ;
    mlips:hasDFTCalculation entity:calc-scan-fan2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-naf-train-fan2025 mlips:samplingStrategy
    entity:sampling-al-fan2025 .

entity:ds-kf-train-fan2025 mlips:samplingStrategy
    entity:sampling-al-fan2025 .

entity:sampling-al-fan2025 a mlips:SamplingStrategy ;
    rdfs:label "Active learning from MD with intermediate ACE potentials: high extrapolation grade, short bond lengths or uniform time intervals, until the maximum energy error is below 5 meV/atom; 4:1 train/test split per MD run" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-fan2025 ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-fan2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-nbasis-fan2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-ACE-fan2025 a mlips:LossFunction ;
    rdfs:label "Energies and forces" .

entity:alg-ACE-fan2025 a mls:Algorithm ;
    rdfs:label "Linear embedding function; fitting package not named in the text read" .

entity:hp-nbasis-fan2025 a mlips:Hyperparameter ;
    rdfs:label "Number of ACE basis functions" ;
    mlips:hyperparameterName "number of basis functions" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ace-naf-cutoffRadius-fan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.3"^^xsd:double .

entity:setting-ace-naf-nbasis-fan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nbasis-fan2025 ;
    mlips:settingValue "268"^^xsd:integer .

entity:setting-ace-kf-cutoffRadius-fan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-ace-kf-nbasis-fan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nbasis-fan2025 ;
    mlips:settingValue "268"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ace-naf-fan2025 a mlips:MLIPRun ;
    rdfs:label "ACE potential for NaF" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-naf-train-fan2025 ;
    mlips:hasHyperparameterSetting entity:setting-ace-naf-cutoffRadius-fan2025 ,
        entity:setting-ace-naf-nbasis-fan2025 ;
    mlips:produces entity:model-ace-naf-fan2025 .

entity:model-ace-naf-fan2025 a mlips:TrainedModel ;
    rdfs:label "ACE NaF (SCAN)" .

entity:run-ace-kf-fan2025 a mlips:MLIPRun ;
    rdfs:label "ACE potential for KF" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-kf-train-fan2025 ;
    mlips:hasHyperparameterSetting entity:setting-ace-kf-cutoffRadius-fan2025 ,
        entity:setting-ace-kf-nbasis-fan2025 ;
    mlips:produces entity:model-ace-kf-fan2025 .

entity:model-ace-kf-fan2025 a mlips:TrainedModel ;
    rdfs:label "ACE KF (SCAN)" .

