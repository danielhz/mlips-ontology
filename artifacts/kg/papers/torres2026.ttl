###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-hematite-torres2026 a mlips:MaterialSystem ;
    rdfs:label "Hematite, alpha-Fe2O3 (bulk, strained and thermally displaced cells, (001) and (110) surfaces)" ;
    mlips:chemicalFormula "Fe2O3" ;
    mlips:materialClass "Iron oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-torres2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-torres2026 mlips:hasDFTSettings entity:calc-settings-dft-torres2026 .

entity:calc-settings-dft-torres2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-SIESTA-torres2026 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:dftBasisSet entity:basis-Double-zeta-polarised-DZP-numerical-atomic-orbitals-torres2026 ;
    mlips:kPointMesh "7x7x5 grid" ;
    rdfs:comment "Real-space grid equivalent to a 300 Ry plane-wave cutoff, with grid-cell sampling for forces; Hubbard U = 4.35 eV on Fe d levels (Dudarev)." .

entity:lib-SIESTA-torres2026 a mlips:Library ;
    rdfs:label "SIESTA" ;
    mlips:candidateForVocabulary mlips:Library .

entity:basis-Double-zeta-polarised-DZP-numerical-atomic-orbitals-torres2026 a mlips:DftBasisSet ;
    rdfs:label "Double-zeta polarised (DZP) numerical atomic orbitals" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-hematite-torres2026 a mlips:TrainingDataset ;
    rdfs:label "Hematite DFT data set (split 85.6% / 4.4% / 10% into training, validation and test sets)" ;
    mlips:coversMaterial entity:mat-hematite-torres2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-torres2026 ;
    rdfs:comment "The total is not stated; the parts given are 1,530 + 1,020 + 520 + 334 distorted configurations plus the MD snapshots." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-hematite-torres2026 mlips:samplingStrategy
    entity:sampling-md-torres2026 ,
    entity:sampling-distort-torres2026 .

entity:sampling-md-torres2026 a mlips:SamplingStrategy ;
    rdfs:label "NPT MD of a 120-atom hematite supercell with the Clay empirical potential (100 to 2000 K, 1 to 100 atm; 100 ns with snapshots every 100 ps)" .

entity:sampling-distort-torres2026 a mlips:SamplingStrategy ;
    rdfs:label "Random atomic displacements (0.01 to 0.03 A) combined with strains (0%, +/-1%, +/-3%) of the 30-atom unit cell (1,530 configurations), of a (001) surface cell (1,020) and a (110) surface cell (520); random thermal displacements of the bulk unit cell for 300 to 2100 K (334 configurations)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-torres2026 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        entity:hp-lmax-torres2026 ,
        mlips:numLayers ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-torres2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:alg-MACE-torres2026 a mls:Algorithm ;
    rdfs:label "Committee of four models; predictions are ensemble averages" .

entity:impl-MACE-torres2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:hp-lmax-torres2026 a mlips:Hyperparameter ;
    rdfs:label "Maximum order L of equivariant features" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-hematite-numFeatures-torres2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-hematite-lmax-torres2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lmax-torres2026 ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-hematite-numLayers-torres2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-hematite-numEpochs-torres2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "300"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-hematite-torres2026 a mlips:MLIPRun ;
    rdfs:label "MACE committee training for hematite (Fe-MLIP)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-hematite-torres2026 ;
    mlips:hasHyperparameterSetting entity:setting-hematite-numFeatures-torres2026 ,
