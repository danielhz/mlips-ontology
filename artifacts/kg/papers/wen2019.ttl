###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-PdSi-wen2019 a mlips:MaterialSystem ;
    rdfs:label "Pd-Si alloys: Pd82Si18 and Pd75Si25 liquids and undercooled liquids, Pd9Si2 and Pd3Si crystals" ;
    mlips:chemicalFormula "Pd-Si" ;
    mlips:materialClass "Metal-metalloid binary alloy; liquid, glass-forming and crystalline phases" .

entity:mat-Pd3Si-wen2019 a mlips:MaterialSystem ;
    rdfs:label "Pd3Si crystal at 300 K (128 atoms)" ;
    mlips:chemicalFormula "Pd3Si" ;
    mlips:materialClass "Intermetallic compound" .

entity:mat-Pd9Si2-wen2019 a mlips:MaterialSystem ;
    rdfs:label "Pd9Si2 crystal at 300 K (352 atoms)" ;
    mlips:chemicalFormula "Pd9Si2" ;
    mlips:materialClass "Intermetallic compound" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-wen2019 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-wen2019 mlips:hasDFTSettings entity:calc-settings-dft-wen2019 .

entity:calc-settings-dft-wen2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "k-mesh grid of 2 pi x 1/25 A^-1 for the static labels; Gamma point only (default cutoff 251 eV) for the sampling AIMD" ;
    rdfs:comment "Static calculations with electronic convergence 1e-5 eV on the AIMD snapshots and on the crystal structures." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-PdSi-wen2019 a mlips:TrainingDataset ;
    rdfs:label "Pd-Si training set (3000 configurations)" ;
    mlips:coversMaterial entity:mat-PdSi-wen2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 3000 ;
    mlips:hasDFTCalculation entity:calc-dft-wen2019 ;
    rdfs:comment "700 liquid frames per composition (the 100 frames at 800 K are held out) plus 800 crystal structures per composition; 800 configurations for validation. No virial data." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-PdSi-wen2019 mlips:samplingStrategy
    entity:sampling-aimd-liquids-wen2019 ,
    entity:sampling-distorted-crystals-wen2019 .

entity:sampling-aimd-liquids-wen2019 a mlips:SamplingStrategy ;
    rdfs:label "NVT AIMD of liquids and undercooled liquids" ;
    rdfs:comment "200 atoms; 1800 K down to 800 K in eight temperatures, quenched at 0.1 K/step, 30 ps at each temperature with a 3 fs time step, snapshots every 0.3 ps: 800 frames per composition." .

entity:sampling-distorted-crystals-wen2019 a mlips:SamplingStrategy ;
    rdfs:label "Uniformly scaled and randomly displaced crystal cells" ;
    rdfs:comment "Unit cells compressed or dilated by factors 0.9 to 1.0 and atoms displaced at random by up to 2.5% of the cell vector: 1000 structures per composition, including the perfect crystal." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-wen2019 ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-wen2019 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-rcut-smooth-wen2019 ,
        entity:hp-embedding-net-wen2019 ,
        entity:hp-fitting-net-wen2019 ,
        mlips:learningRate ,
        entity:hp-lr-decay-rate-wen2019 ,
        entity:hp-lr-decay-steps-wen2019 ;
    mlips:hasImplementation entity:impl-DeePMD-wen2019 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-DeePMD-wen2019 a mlips:LossFunction ;
    rdfs:label "DeePMD loss with prefactors p_e from 0.2 to 2, p_f from 100 to 1 and p_v = 0 (no virial data)" .

entity:alg-DeePMD-wen2019 a mls:Algorithm ;
    rdfs:label "Adam with exponentially decaying learning rate; ResNet skip connections between neighbouring fitting layers" .

entity:impl-DeePMD-wen2019 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit ;
    mlips:version "DeepPot-SE model" .

entity:hp-rcut-smooth-wen2019 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential smoothing start radius (Angstrom)" ;
    mlips:hyperparameterName "rcut_smth" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-embedding-net-wen2019 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential filter (embedding) network sizes" ;
    mlips:hyperparameterName "filter_neuron" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-fitting-net-wen2019 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential fitting network sizes" ;
    mlips:hyperparameterName "fitting_neuron" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-rate-wen2019 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay rate" ;
    mlips:hyperparameterName "decay_rate" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-steps-wen2019 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay step" ;
    mlips:hyperparameterName "decay_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-PdSi-cutoffRadius-wen2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-dp-PdSi-rcut-smooth-wen2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-rcut-smooth-wen2019 ;
    mlips:settingValue "5.8"^^xsd:double .

entity:setting-dp-PdSi-embedding-net-wen2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-embedding-net-wen2019 ;
    mlips:settingValue "50-100" .

entity:setting-dp-PdSi-fitting-net-wen2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-fitting-net-wen2019 ;
    mlips:settingValue "240-240-240" .

entity:setting-dp-PdSi-learningRate-wen2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-dp-PdSi-lr-decay-rate-wen2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lr-decay-rate-wen2019 ;
    mlips:settingValue "0.96"^^xsd:double .

entity:setting-dp-PdSi-lr-decay-steps-wen2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lr-decay-steps-wen2019 ;
    mlips:settingValue "10000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-dp-PdSi-wen2019 a mlips:MLIPRun ;
    rdfs:label "DeepPot-SE training for the Pd-Si system" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-PdSi-wen2019 ;
    mlips:hasHyperparameterSetting entity:setting-dp-PdSi-cutoffRadius-wen2019 ,
        entity:setting-dp-PdSi-rcut-smooth-wen2019 ,
        entity:setting-dp-PdSi-embedding-net-wen2019 ,
        entity:setting-dp-PdSi-fitting-net-wen2019 ,
        entity:setting-dp-PdSi-learningRate-wen2019 ,
        entity:setting-dp-PdSi-lr-decay-rate-wen2019 ,
        entity:setting-dp-PdSi-lr-decay-steps-wen2019 ;
    mlips:produces entity:model-dp-PdSi-wen2019 .

entity:model-dp-PdSi-wen2019 a mlips:TrainedModel ;
    rdfs:label "Deep Potential (DeepPot-SE) for Pd-Si" .

