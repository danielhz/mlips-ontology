###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-MP-universal-batatia2024mp0 a mlips:MaterialSystem ;
    rdfs:label "Materials Project Trajectory coverage (foundation-model scope, 89 elements)" ;
    mlips:chemicalFormula "any" ;
    mlips:materialClass "Universal inorganic crystal coverage from MPtrj (~150,000 unique Materials Project structures, mainly small periodic unit cells with under 70 atoms in 90% of cases). MACE-MP-0 is demonstrated out-of-the-box on solids, liquids, gases, surfaces, MOFs, and a small protein, well beyond the training distribution" ;
    rdfs:comment "No single Wikidata entry applies: this is the universal foundation-model coverage of the Materials Project database, spanning 89 elements." .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-batatia2024mp0 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-batatia2024mp0 mlips:hasDFTSettings entity:dft-settings-batatia2024mp0 .

entity:dft-settings-batatia2024mp0 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "Hubbard U applied on transition-metal oxides containing Co, Cr, Fe, Mn, Mo, Ni, V, W combined with O or F (Materials Project default U-values); no dispersion correction in training." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-MPtrj-batatia2024mp0 a mlips:TrainingDataset ;
    rdfs:label "MPtrj subset used for MACE-MP-0: ~1.5M static and structural-relaxation configurations across ~150,000 Materials Project compounds; 90% of unit cells have under 70 atoms" ;
    mlips:coversMaterial entity:mat-MP-universal-batatia2024mp0 ;
    mlips:coversProperty mlips:Energy , mlips:Forces , mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1500000 ;
    mlips:hasDFTCalculation entity:dft-batatia2024mp0 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-MPtrj-batatia2024mp0 mlips:samplingStrategy
    entity:relaxation-trajectory-sampling-batatia2024mp0 ,
    entity:periodic-table-coverage-sampling-batatia2024mp0 .

entity:relaxation-trajectory-sampling-batatia2024mp0 a mlips:SamplingStrategy ;
    rdfs:label "Materials Project relaxation-trajectory sampling (re-using the CHGNet-curated MPtrj training set)" ;
    rdfs:comment "Static and relaxation-trajectory frames from the Materials Project, originally compiled for CHGNet (Deng et al. 2023). MACE-MP-0 inherits the MPtrj curation: deduplicated, energy/force-quality-filtered configurations from ~150k Materials Project structures." .

entity:periodic-table-coverage-sampling-batatia2024mp0 a mlips:SamplingStrategy ;
    rdfs:label "Periodic-table chemical-space coverage" ;
    rdfs:comment "MPtrj configurations span 89 elements across binary, ternary, and higher-order inorganic compositions; 90% of structures contain under 70 atoms per unit cell." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE-MP-0 a mlips:MLIPMethod ;
    rdfs:label "MACE: equivariant higher-order message-passing graph neural network with atomic-cluster-expansion-style many-body messages" ;
    mlips:hasFunctionalForm entity:mace-functional-form-batatia2024mp0 ;
    mlips:hasLossFunction entity:mace-huber-loss-batatia2024mp0 ;
    mlips:hasTrainingAlgorithm entity:amsgrad-batatia2024mp0 ;
    mlips:hasHyperparameter mlips:cutoffRadius , mlips:numLayers ,
        mlips:numAngularBasis , mlips:bodyOrder ,
        mlips:numFeatures , mlips:numRadialBasis ,
        entity:hp-mlp-hidden-batatia2024mp0 , mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:mace-impl-batatia2024mp0 .

entity:mace-functional-form-batatia2024mp0 a mlips:FunctionalForm ;
    rdfs:label "MACE: equivariant message-passing graph tensor network (e3nn). Two layers of higher-order equivariant messages built from sums of two-body permutation-invariant polynomials in a spherical basis; tensor-decomposition parameterisation; 4-body messages per layer (correlation order 3); ZBL repulsive pair potential at close range with Agnesi distance transform; energy is the sum of per-atom contributions, forces and stresses by auto-differentiation. The MACE-MP-0b3 release is the L=1 (medium-sized) variant in 128x0e + 128x1o irreps." .

entity:mace-huber-loss-batatia2024mp0 a mlips:LossFunction ;
    rdfs:label "Weighted Huber loss on energy, forces, and stresses with weights (lambda_E, lambda_F, lambda_sigma)=(1, 10, 10) and Huber deltas (delta_E, delta_F, delta_sigma)=(0.01, 0.01, 0.01); the force Huber delta is conditional, decreasing step-wise from 1.0 to 0.1 as the per-atom force magnitude increases from 0 to 300 eV/A" .

entity:amsgrad-batatia2024mp0 a mls:Algorithm ;
    rdfs:label "AMSGrad variant of Adam (beta_1=0.9, beta_2=0.999, epsilon=1e-8) with EMA learning-rate schedule (decay 0.99999) and gradient clipping (max-norm 100)" .

entity:mace-impl-batatia2024mp0 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE ;
    mlips:version "MACE-MP-0b3" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-6-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-num-layers-2-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-lmax-3-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-correlation-order-3-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-num-channels-128-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-num-radial-bessel-10-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-mlp-hidden-3x64-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-mlp-hidden-batatia2024mp0 ;
    mlips:settingValue "3x64 SiLU" .

entity:setting-initial-lr-1e-3-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-num-epochs-100-batatia2024mp0 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-mace-mp-0-batatia2024mp0 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0b3 (medium) training run on MPtrj" ;
    mlips:appliesMethod entity:MACE-MP-0 ;
    mlips:runsOn entity:ds-MPtrj-batatia2024mp0 ;
    mlips:hasHyperparameterSetting
        entity:setting-rcut-6-batatia2024mp0 ,
        entity:setting-num-layers-2-batatia2024mp0 ,
        entity:setting-lmax-3-batatia2024mp0 ,
        entity:setting-correlation-order-3-batatia2024mp0 ,
        entity:setting-num-channels-128-batatia2024mp0 ,
        entity:setting-num-radial-bessel-10-batatia2024mp0 ,
        entity:setting-mlp-hidden-3x64-batatia2024mp0 ,
        entity:setting-initial-lr-1e-3-batatia2024mp0 ,
        entity:setting-num-epochs-100-batatia2024mp0 ;
    mlips:gpuHours 2600 ;
    mlips:trainingHardware "40-80 NVIDIA H100 GPUs across 10-20 nodes" ;
    mlips:produces entity:model-mace-mp-0-batatia2024mp0 .

entity:model-mace-mp-0-batatia2024mp0 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b3 medium foundation model" ;
    mlips:inferenceHardware "Single NVIDIA A100 80GB GPU: ~ns/day for 1000-atom system; weak scaling to 32,000 atoms on 64 GPUs at 0.1 ns/day" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-batatia2024mp0 mlips:hasResult
    entity:result-mae-energy-batatia2024mp0 ,
    entity:result-mae-force-batatia2024mp0 .

entity:result-mae-energy-batatia2024mp0 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-mp-0-batatia2024mp0 ;
    mlips:targetMaterial entity:mat-MP-universal-batatia2024mp0 ;
    mlips:hasAccuracyMetric entity:metric-mae-energy-batatia2024mp0 .

entity:metric-mae-energy-batatia2024mp0 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on energy per atom (MPtrj held-out, MACE-MP-0 medium)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "18"^^xsd:double ;
    mlips:hasUnit unit:MeV-PER-ATOM .

entity:result-mae-force-batatia2024mp0 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-mp-0-batatia2024mp0 ;
    mlips:targetMaterial entity:mat-MP-universal-batatia2024mp0 ;
    mlips:hasAccuracyMetric entity:metric-mae-force-batatia2024mp0 .

entity:metric-mae-force-batatia2024mp0 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on force components (MPtrj held-out, MACE-MP-0 medium)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "39"^^xsd:double ;
    mlips:hasUnit unit:MeV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Captured in Q9 (run) and Q10 (model) where the predicates allow it:
#   - mlips:gpuHours = 2600
#   - mlips:trainingHardware = "40-80 NVIDIA H100 GPUs across 10-20 nodes"
#   - mlips:inferenceHardware = "Single NVIDIA A100 80GB GPU ..."
# Wall-clock training duration, peak memory, and explicit per-atom
# inference time are not reported.

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-mlp-hidden-batatia2024mp0 a mlips:Hyperparameter ;
    rdfs:label "MACE-MP-0 readout MLP architecture" ;
    mlips:hyperparameterName "mlp_hidden" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .
