###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-matsutani2024 a mlips:BenchmarkStudy ;
    rdfs:label "Matsutani, Kasamatsu and Usuki (2024): intermediate-range order in GeO2 glass from SIMPLE-NN neural network potential MD versus reverse Monte Carlo" ;
    mlips:reportedIn entity:article-matsutani2024 .

entity:article-matsutani2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0240087> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Comparison of intermediate-range order in GeO2 glass: Molecular dynamics using machine-learning interatomic potential vs reverse Monte Carlo fitting to experimental data" ;
    schema:author <https://orcid.org/0000-0003-0055-0339> ,
        <https://orcid.org/0000-0002-4368-7995> ,
