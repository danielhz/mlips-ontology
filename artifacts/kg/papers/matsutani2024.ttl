###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-geo2-matsutani2024 a mlips:MaterialSystem ;
    rdfs:label "GeO2 crystal, liquid and glass (with small Ge3O and GeO3 sets)" ;
    mlips:chemicalFormula "GeO2" ;
    mlips:materialClass "Oxide glass" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-matsutani2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-matsutani2024 mlips:hasDFTSettings entity:calc-settings-vasp-matsutani2024 .

entity:calc-settings-vasp-matsutani2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "2x2x2" ;
    rdfs:comment "Labels recomputed at 500 eV after Gamma-point AIMD at 289.8 eV" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-geo2-matsutani2024 a mlips:TrainingDataset ;
    rdfs:label "GeO2 training data (1,870 structures; 9:1 training/validation)" ;
    mlips:coversMaterial entity:mat-geo2-matsutani2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1870 ;
    mlips:hasDFTCalculation entity:calc-vasp-matsutani2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-geo2-matsutani2024 mlips:samplingStrategy
    entity:sampling-aimd-matsutani2024 .

entity:sampling-aimd-matsutani2024 a mlips:SamplingStrategy ;
    rdfs:label "AIMD of crystal (300-3000 K), liquid (3000 K), melt-quench, compressed glass and crystal, and liquid Ge3O/GeO3 in 96-atom cells (Table I)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-matsutani2024 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-matsutani2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-HDNNP-matsutani2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-matsutani2024 a mlips:LossFunction ;
    rdfs:label "Sum of RMSEs of total energy and forces" .

entity:alg-HDNNP-matsutani2024 a mls:Algorithm ;
    rdfs:label "Adam" .

entity:impl-HDNNP-matsutani2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SIMPLE-NN-matsutani2024 .

entity:lib-SIMPLE-NN-matsutani2024 a mlips:Library ;
    rdfs:label "SIMPLE-NN" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nnp-cutoffRadius-matsutani2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-nnp-numLayers-matsutani2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-nnp-learningRate-matsutani2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-nnp-batchSize-matsutani2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "10"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nnp-matsutani2024 a mlips:MLIPRun ;
    rdfs:label "NNP for GeO2 (70-30-30-1)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-geo2-matsutani2024 ;
    mlips:hasHyperparameterSetting entity:setting-nnp-cutoffRadius-matsutani2024 ,
        entity:setting-nnp-numLayers-matsutani2024 ,
        entity:setting-nnp-learningRate-matsutani2024 ,
        entity:setting-nnp-batchSize-matsutani2024 ;
    mlips:produces entity:model-nnp-matsutani2024 .

entity:model-nnp-matsutani2024 a mlips:TrainedModel ;
    rdfs:label "NNP GeO2 glass" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-matsutani2024 mlips:hasResult
    entity:result-nnp-test-matsutani2024 .

entity:result-nnp-test-matsutani2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nnp-matsutani2024 ;
    mlips:targetMaterial entity:mat-geo2-matsutani2024 ;
    mlips:hasAccuracyMetric entity:metric-nnp-test-1-matsutani2024 .

entity:metric-nnp-test-1-matsutani2024 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on GeO2 quench structures: NNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "7.923"^^xsd:double ;
