###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NewtonNet a mlips:MLIPMethod ;
    rdfs:label "NewtonNet (Newtonian message passing network)" ;
    mlips:hasLossFunction entity:loss-NewtonNet-haghighatlari2022 ;
    mlips:hasTrainingAlgorithm entity:alg-NewtonNet-haghighatlari2022 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:cutoffRadius ,
        mlips:learningRate ,
        entity:hp-lr-decay-haghighatlari2022 ,
        entity:hp-loss-weight-energy-haghighatlari2022 ,
        entity:hp-loss-weight-force-haghighatlari2022 ;
    mlips:inferenceComplexity "Linear in the number of atoms" .

entity:loss-NewtonNet-haghighatlari2022 a mlips:LossFunction ;
    rdfs:label "Weighted sum of energy, force and force-direction terms with weights lambda_E, lambda_F and lambda_D (Table 5)" .

entity:alg-NewtonNet-haghighatlari2022 a mls:Algorithm ;
    rdfs:label "Mini-batch gradient descent with the Adam optimizer and learning-rate decay 0.7" .

entity:hp-loss-weight-energy-haghighatlari2022 a mlips:Hyperparameter ;
    rdfs:label "Energy weight of the loss (lambda_E)" ;
    mlips:hyperparameterName "lambda_E" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-loss-weight-force-haghighatlari2022 a mlips:Hyperparameter ;
    rdfs:label "Force weight of the loss (lambda_F)" ;
    mlips:hyperparameterName "lambda_F" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-haghighatlari2022 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay factor" ;
    mlips:hyperparameterName "lr_decay" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

