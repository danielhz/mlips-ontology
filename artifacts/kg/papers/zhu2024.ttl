###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-9-unit-zhu2024 mlips:samplingStrategy
    entity:sampling-published-zhu2024 .

entity:ds-9-super-zhu2024 mlips:samplingStrategy
    entity:sampling-published-zhu2024 .

