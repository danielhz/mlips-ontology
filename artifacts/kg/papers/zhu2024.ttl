# Canonical Turtle for the protocol-derived encoding of:
#   Keming Zhu et al. (2024). Performance Comparisons of NequIP and DPMD Machine Learning Interatomic Potentials for Tobermorites.
#   Computational Materials Science. doi:10.1016/j.commatsci.2024.113212
#
# Version read: publisher (sha256 f8c43f95612eec7f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 182 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the twelve models of Table 3: NequIP and DeePMD
# trained on each of six tobermorite configuration sets (9, 11 and 14 A;
# unit cell and supercells), with the training-set sizes of Table 1, the
# epochs of Table 2 and the training, validation and test RMSEs. The
# data are DFT results of an earlier DeePMD study. Data-efficiency,
# generalisation to C-S-H and property tests are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhu2024 a mlips:BenchmarkStudy ;
    rdfs:label "Zhu (2024): performance comparison of NequIP and DPMD potentials for tobermorites" ;
    mlips:reportedIn entity:article-zhu2024 .

entity:article-zhu2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.commatsci.2024.113212> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Performance Comparisons of NequIP and DPMD Machine Learning Interatomic Potentials for Tobermorites" ;
    schema:author <https://orcid.org/0009-0008-7591-2908> .

<https://orcid.org/0009-0008-7591-2908> a schema:Person ;
    schema:name "Keming Zhu" ;
    schema:givenName "Keming" ;
    schema:familyName "Zhu" ;
    schema:identifier <https://orcid.org/0009-0008-7591-2908> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tob9-unit-zhu2024 a mlips:MaterialSystem ;
    rdfs:label "Tobermorite 9 A, unit cell" ;
    mlips:materialClass "Calcium silicate hydrate mineral" .

entity:mat-tob9-super-zhu2024 a mlips:MaterialSystem ;
    rdfs:label "Tobermorite 9 A, supercells" ;
    mlips:materialClass "Calcium silicate hydrate mineral" .

entity:mat-tob11-unit-zhu2024 a mlips:MaterialSystem ;
    rdfs:label "Tobermorite 11 A, unit cell" ;
    mlips:materialClass "Calcium silicate hydrate mineral" .

entity:mat-tob11-super-zhu2024 a mlips:MaterialSystem ;
    rdfs:label "Tobermorite 11 A, supercells" ;
    mlips:materialClass "Calcium silicate hydrate mineral" .

entity:mat-tob14-unit-zhu2024 a mlips:MaterialSystem ;
    rdfs:label "Tobermorite 14 A, unit cell" ;
    mlips:materialClass "Calcium silicate hydrate mineral" .

entity:mat-tob14-super-zhu2024 a mlips:MaterialSystem ;
    rdfs:label "Tobermorite 14 A, supercells" ;
    mlips:materialClass "Calcium silicate hydrate mineral" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-zhu2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-zhu2024 mlips:hasDFTSettings entity:calc-settings-dft-zhu2024 .

entity:calc-settings-dft-zhu2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Energies and forces taken from the DFT calculations of the earlier DeePMD study of tobermorite (Zhou et al., the paper's ref. [35]); convergence criteria 1e-5 eV and 0.03 eV/A. Functional and other settings are in that study." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-9-unit-zhu2024 a mlips:TrainingDataset ;
