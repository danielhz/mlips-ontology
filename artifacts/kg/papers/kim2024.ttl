###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Li6PS5Cl-kim2024 a mlips:MaterialSystem ;
    rdfs:label "Li6PS5Cl argyrodite solid electrolyte with S/Cl site disorder (2x2x2 supercells)" ;
    mlips:chemicalFormula "Li6PS5Cl" ;
    mlips:materialClass "Sulfide Li-ion conductor; strained crystals and high-temperature MD configurations" .

entity:mat-mp-kim2024 a mlips:MaterialSystem ;
    rdfs:label "Materials Project crystals (PBE and r2SCAN relaxation databases)" ;
    mlips:materialClass "Universal inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-lpsc-pbe-kim2024 a mlips:DFTCalculation .

entity:calc-lpsc-scan-kim2024 a mlips:DFTCalculation .

entity:calc-mp-dft-kim2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-lpsc-pbe-kim2024 mlips:hasDFTSettings entity:calc-settings-lpsc-pbe-kim2024 .

entity:calc-settings-lpsc-pbe-kim2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "300"^^xsd:double ;
    mlips:kPointMesh "2x2x2 per unit cell" ;
    rdfs:comment "Low-fidelity level for Li6PS5Cl; spin-unpolarised." .

entity:calc-lpsc-scan-kim2024 mlips:hasDFTSettings entity:calc-settings-lpsc-scan-kim2024 .

entity:calc-settings-lpsc-scan-kim2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:SCAN ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "300"^^xsd:double ;
    mlips:kPointMesh "2x2x2 per unit cell" ;
    rdfs:comment "High-fidelity level for Li6PS5Cl: one-shot SCAN single points on structures sampled from the PBE data; PAW PBE pseudopotentials, spin-unpolarised." .

entity:calc-mp-dft-kim2024 mlips:hasDFTSettings entity:calc-settings-mp-dft-kim2024 .

entity:calc-settings-mp-dft-kim2024 a mlips:DFTSettings ;
    rdfs:comment "Materials Project calculations: the PBE database (low fidelity) and the r2SCAN relaxation database retrieved in February 2024 (high fidelity); settings are those of the Materials Project and are not restated." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-lpsc-mf-kim2024 a mlips:TrainingDataset ;
    rdfs:label "Li6PS5Cl multi-fidelity training set (PBE set plus subsampled SCAN single points)" ;
    mlips:coversMaterial entity:mat-Li6PS5Cl-kim2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-lpsc-pbe-kim2024 ,
        entity:calc-lpsc-scan-kim2024 ;
    rdfs:comment "The sizes per structure type are shown in Figure 2a and not printed in the text; the high-fidelity part costs 10-20% on top of the PBE set." .

entity:ds-mp-mf-kim2024 a mlips:TrainingDataset ;
    rdfs:label "Materials Project PBE + r2SCAN multi-fidelity training set" ;
    mlips:coversMaterial entity:mat-mp-kim2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-mp-dft-kim2024 ;
    rdfs:comment "Sizes were not captured from the parts read." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-lpsc-mf-kim2024 mlips:samplingStrategy
    entity:sampling-strained-crystals-kim2024 ,
    entity:sampling-aimd-kim2024 ,
    entity:sampling-high-fidelity-subsample-kim2024 .

entity:ds-mp-mf-kim2024 mlips:samplingStrategy
    entity:sampling-mp-relaxations-kim2024 .

entity:sampling-strained-crystals-kim2024 a mlips:SamplingStrategy ;
    rdfs:label "Strained bulk crystals" ;
    rdfs:comment "0%, 50% and 100% Cl@4c crystals deformed by shear or hydrostatic strain within 5% of the lattice parameters." .

entity:sampling-aimd-kim2024 a mlips:SamplingStrategy ;
    rdfs:label "Ab initio MD at 600 K and 1200 K (NVT)" ;
    rdfs:comment "Two 50% Cl@4c cells, 10 ps with a 2 fs time step; sampled every 20 fs after the first 300 fs for the low-fidelity set." .

entity:sampling-high-fidelity-subsample-kim2024 a mlips:SamplingStrategy ;
    rdfs:label "Subsampling for high-fidelity labels" ;
    rdfs:comment "All strained crystals and 10% of the MD configurations (200 fs interval) are recomputed with the high-fidelity functional." .

entity:sampling-mp-relaxations-kim2024 a mlips:SamplingStrategy ;
    rdfs:label "Materials Project relaxation trajectories" ;
    rdfs:comment "For the r2SCAN database: initial, middle and final configuration of the first relaxation trajectory of the smallest cell of each material." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-kim2024 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-kim2024 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numAngularBasis ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-NequIP-kim2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-NequIP-kim2024 a mlips:LossFunction ;
    rdfs:label "Huber loss on energy, force and stress with fidelity-dependent weights (weight 7 for the MP-r2SCAN data, 1 otherwise)" .

entity:alg-NequIP-kim2024 a mls:Algorithm ;
    rdfs:label "Adam (epsilon = 1e-8, beta1 = 0.9, beta2 = 0.999)" .

entity:impl-NequIP-kim2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-MF-kim2024 .

entity:lib-SevenNet-MF-kim2024 a mlips:Library ;
    rdfs:label "SevenNet-MF" ;
    rdfs:comment "Multi-fidelity extension of SevenNet (NequIP architecture) in which the fidelity of the data selects fidelity-dependent parameters, so one model is trained on several databases at once." ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-lpsc-mf-numLayers-kim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-lpsc-mf-numAngularBasis-kim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-lpsc-mf-numFeatures-kim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-sevennet-mf-0-numLayers-kim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-sevennet-mf-0-numAngularBasis-kim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-sevennet-mf-0-numFeatures-kim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-lpsc-mf-kim2024 a mlips:MLIPRun ;
    rdfs:label "Multi-fidelity SevenNet-MF training for Li6PS5Cl (PBE + SCAN)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lpsc-mf-kim2024 ;
    mlips:hasHyperparameterSetting entity:setting-lpsc-mf-numLayers-kim2024 ,
        entity:setting-lpsc-mf-numAngularBasis-kim2024 ,
        entity:setting-lpsc-mf-numFeatures-kim2024 ;
    mlips:produces entity:model-lpsc-mf-kim2024 .

entity:model-lpsc-mf-kim2024 a mlips:TrainedModel ;
    rdfs:label "Multi-fidelity MLIP for Li6PS5Cl (SevenNet-MF, 3 interaction layers, 32 channels)" .

entity:run-sevennet-mf-0-kim2024 a mlips:MLIPRun ;
    rdfs:label "SevenNet-MF-0 training on the Materials Project PBE and r2SCAN databases" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-mp-mf-kim2024 ;
    mlips:hasHyperparameterSetting entity:setting-sevennet-mf-0-numLayers-kim2024 ,
        entity:setting-sevennet-mf-0-numAngularBasis-kim2024 ,
        entity:setting-sevennet-mf-0-numFeatures-kim2024 ;
    mlips:produces entity:model-sevennet-mf-0-kim2024 .

entity:model-sevennet-mf-0-kim2024 a mlips:TrainedModel ;
    rdfs:label "SevenNet-MF-0 (128x0e + 64x1e + 32x2e, 5 interaction layers)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-kim2024 mlips:hasResult
    entity:result-lpsc-mf-val-kim2024 ,
    entity:result-sevennet-mf-0-train-kim2024 .

entity:result-lpsc-mf-val-kim2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-lpsc-mf-kim2024 ;
    mlips:targetMaterial entity:mat-Li6PS5Cl-kim2024 ;
    mlips:hasAccuracyMetric entity:metric-lpsc-mf-val-1-kim2024 ,
        entity:metric-lpsc-mf-val-2-kim2024 ,
        entity:metric-lpsc-mf-val-3-kim2024 .

entity:metric-lpsc-mf-val-1-kim2024 a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on energy: multi-fidelity model, Li6PS5Cl" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-lpsc-mf-val-2-kim2024 a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on forces: multi-fidelity model, Li6PS5Cl" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "57.4"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-lpsc-mf-val-3-kim2024 a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on stress, in kbar: multi-fidelity model, Li6PS5Cl" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.64"^^xsd:double .

entity:result-sevennet-mf-0-train-kim2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-sevennet-mf-0-kim2024 ;
    mlips:targetMaterial entity:mat-mp-kim2024 ;
    mlips:hasAccuracyMetric entity:metric-sevennet-mf-0-train-1-kim2024 ,
        entity:metric-sevennet-mf-0-train-2-kim2024 ,
        entity:metric-sevennet-mf-0-train-3-kim2024 .

entity:metric-sevennet-mf-0-train-1-kim2024 a mlips:AccuracyMetric ;
    rdfs:label "Training-set MAE on energy: SevenNet-MF-0" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "10.8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-sevennet-mf-0-train-2-kim2024 a mlips:AccuracyMetric ;
    rdfs:label "Training-set MAE on forces: SevenNet-MF-0" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "18.3"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-sevennet-mf-0-train-3-kim2024 a mlips:AccuracyMetric ;
    rdfs:label "Training-set MAE on stress, in kbar: SevenNet-MF-0" ;
