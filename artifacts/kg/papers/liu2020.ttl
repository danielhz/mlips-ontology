# Canonical Turtle for the protocol-derived encoding of:
#   Yuanbin Liu et al. (2020). Machine learning interatomic potential developed for molecular simulations on thermal properties of β-Ga2O3.
#   The Journal of Chemical Physics. doi:10.1063/5.0027643
#
# Version read: publisher (sha256 57b73f0290c85121...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 193 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the SOAP-GAP model for beta-Ga2O3: VASP reference
# calculations, the iteratively built training database, the
# hyperparameters of Table I and the test-set energy and force RMSEs.
# Phonons, thermal expansion and thermal conductivity are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liu2020 a mlips:BenchmarkStudy ;
    rdfs:label "Liu et al. (2020): machine learning interatomic potential for thermal properties of beta-Ga2O3" ;
    mlips:reportedIn entity:article-liu2020 .

entity:article-liu2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0027643> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Machine learning interatomic potential developed for molecular simulations on thermal properties of β-Ga2O3" ;
    schema:author entity:person-Liu-liu2020 ,
        <https://orcid.org/0000-0002-3678-827X> ,
        <https://orcid.org/0000-0003-3974-0391> ,
        entity:person-LiuLinHua-liu2020 ,
        entity:person-Csanyi-liu2020 ,
        <https://orcid.org/0000-0003-3588-972X> .

entity:person-Liu-liu2020 a schema:Person ;
    schema:name "Yuan-Bin Liu" ;
    schema:givenName "Yuan-Bin" ;
    schema:familyName "Liu" .

