# Canonical Turtle for the protocol-derived encoding of:
#   Yury V. Lysogorskiy et al. (2026). Graph atomic cluster expansion for foundational machine learning interatomic potentials.
#   npj Computational Materials. doi:10.1038/s41524-026-01979-1  arXiv:2508.17936v2
#
# Version read: arxiv-preprint arXiv:2508.17936v2 (sha256 f274a6e8003fe035...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 26 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the GRACE foundational models: five architectures
# (1L, 1L-L, 2L, 2L-M, 2L-L; Table S1) parameterised on OMat24 ("-OMAT")
# and fine-tuned on MPTraj + sAlex ("-OAM"), ten named models in all,
# with their settings, training protocol and reported throughput.
# Validation is by benchmark scores and properties, not by energy/force
# errors on a material system.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-lysogorskiy2026 a mlips:BenchmarkStudy ;
    rdfs:label "Lysogorskiy et al. (2026): GRACE foundational machine learning interatomic potentials" ;
    mlips:reportedIn entity:article-lysogorskiy2026 .

entity:article-lysogorskiy2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-01979-1> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Graph atomic cluster expansion for foundational machine learning interatomic potentials" ;
    schema:author entity:person-Lysogorskiy-lysogorskiy2026 ,
        entity:person-Bochkarev-lysogorskiy2026 ,
        entity:person-Drautz-lysogorskiy2026 .

entity:person-Lysogorskiy-lysogorskiy2026 a schema:Person ;
    schema:name "Yury Lysogorskiy" ;
    schema:givenName "Yury" ;
    schema:familyName "Lysogorskiy" .

entity:person-Bochkarev-lysogorskiy2026 a schema:Person ;
    schema:name "Anton Bochkarev" ;
    schema:givenName "Anton" ;
    schema:familyName "Bochkarev" .

entity:person-Drautz-lysogorskiy2026 a schema:Person ;
    schema:name "Ralf Drautz" ;
    schema:givenName "Ralf" ;
    schema:familyName "Drautz" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-universal-lysogorskiy2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic materials across 89 elements (universal training domain of OMat24, MPTraj and sAlex)" ;
    mlips:materialClass "Universal inorganic materials; bulk crystals, non-equilibrium and relaxation-trajectory configurations" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-omat-dft-lysogorskiy2026 a mlips:DFTCalculation .

entity:calc-mp-dft-lysogorskiy2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-omat-dft-lysogorskiy2026 mlips:hasDFTSettings entity:calc-settings-omat-dft-lysogorskiy2026 .

entity:calc-settings-omat-dft-lysogorskiy2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "OMat24: GGA-PBE with Hubbard U corrections for specific oxides and fluorides, consistent with Materials Project defaults; DFT and pseudopotential settings differ from those of Alexandria and the Materials Project." .

entity:calc-mp-dft-lysogorskiy2026 mlips:hasDFTSettings entity:calc-settings-mp-dft-lysogorskiy2026 .

entity:calc-settings-mp-dft-lysogorskiy2026 a mlips:DFTSettings ;
    rdfs:comment "MPTraj (v2022.10.28) and sAlex reference calculations (Materials Project and Alexandria settings); their code, functional and pseudopotentials are not restated in this paper, only that they differ from the OMat24 settings." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-OMat24-lysogorskiy2026 a mlips:TrainingDataset ;
    rdfs:label "OMat24 (110 million DFT calculations)" ;
    mlips:coversMaterial entity:mat-universal-lysogorskiy2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 110000000 ;
    mlips:hasDFTCalculation entity:calc-omat-dft-lysogorskiy2026 ;
    rdfs:comment "numConfigurations is the size of OMat24 as stated in the paper ('110 million DFT calculations'); the paper does not say whether a subset was used." .

entity:ds-MPTraj-sAlex-lysogorskiy2026 a mlips:TrainingDataset ;
    rdfs:label "MPTraj (v2022.10.28) + subsampled Alexandria (sAlex)" ;
    mlips:coversMaterial entity:mat-universal-lysogorskiy2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-mp-dft-lysogorskiy2026 ;
    rdfs:comment "sAlex is curated to prevent data leakage with the WBM test set. Used to fine-tune the OMat-base models into the -OAM models; sizes are not stated." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-OMat24-lysogorskiy2026 mlips:samplingStrategy
    entity:sampling-rattled-boltzmann-lysogorskiy2026 ,
    entity:sampling-aimd-lysogorskiy2026 ,
    entity:sampling-relaxations-lysogorskiy2026 .

entity:ds-MPTraj-sAlex-lysogorskiy2026 mlips:samplingStrategy
    entity:sampling-relaxations-lysogorskiy2026 .

entity:sampling-rattled-boltzmann-lysogorskiy2026 a mlips:SamplingStrategy ;
    rdfs:label "Boltzmann sampling of structures with randomly displaced atoms (OMat24)" .

entity:sampling-aimd-lysogorskiy2026 a mlips:SamplingStrategy ;
    rdfs:label "Ab initio molecular dynamics (OMat24)" .

entity:sampling-relaxations-lysogorskiy2026 a mlips:SamplingStrategy ;
    rdfs:label "Structural relaxation trajectories" ;
    rdfs:comment "Relaxations of the sampled configurations in OMat24; sAlex and MPTraj consist of relaxation trajectories only." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:hasLossFunction entity:loss-GRACE-lysogorskiy2026 ;
    mlips:hasTrainingAlgorithm entity:alg-GRACE-lysogorskiy2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:numAngularBasis ,
        mlips:bodyOrder ,
        mlips:numLayers ,
        entity:hp-chem-embedding-lysogorskiy2026 ,
        entity:hp-num-radial-functions-lysogorskiy2026 ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-GRACE-lysogorskiy2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:loss-GRACE-lysogorskiy2026 a mlips:LossFunction ;
    rdfs:label "Weighted sum of Huber losses (delta = 0.01) on energy per atom, force components and stress components; weights alpha_E : alpha_F : alpha_S = 16 : 128 : 128 for the OMat-base stage and 128 : 128 : 256 for the fine-tuning stages" .

entity:alg-GRACE-lysogorskiy2026 a mls:Algorithm ;
    rdfs:label "Adam with cosine learning-rate reduction from 8e-3 to 5e-4; constant learning rate 1e-4 for fine-tuning; batches of 165000 bonds per device (about 200 structures on average)" .

entity:impl-GRACE-lysogorskiy2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-grace-tensorpotential-lysogorskiy2026 .

entity:lib-grace-tensorpotential-lysogorskiy2026 a mlips:Library ;
    rdfs:label "grace-tensorpotential" ;
    rdfs:comment "TensorFlow-based package; double precision, JIT-compiled with XLA; MD through ASE and LAMMPS." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-chem-embedding-lysogorskiy2026 a mlips:Hyperparameter ;
    rdfs:label "GRACE chemical embedding dimension" ;
    mlips:hyperparameterName "chemical_embedding" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-num-radial-functions-lysogorskiy2026 a mlips:Hyperparameter ;
    rdfs:label "GRACE number of radial functions" ;
    mlips:hyperparameterName "num_radial_functions" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

