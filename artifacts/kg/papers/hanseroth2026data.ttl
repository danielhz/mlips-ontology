entity:calc-settings-pbe-hanseroth2026data a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-hanseroth2026data ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    rdfs:comment "CP2K 2025.1, GTH pseudopotentials, DZVP-MOLOPT basis, Nose-Hoover chains, 0.5 fs step (CDP, CPP, MoS2, Li13Si4)." .

