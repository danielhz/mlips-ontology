###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-hanseroth2026data ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-MACE-hanseroth2026data a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasImplementation entity:impl-NequIP-hanseroth2026data ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-NequIP-hanseroth2026data a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-hanseroth2026data .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:hasImplementation entity:impl-M3GNet-hanseroth2026data ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-M3GNet-hanseroth2026data a mlips:Implementation ;
    mlips:implementedIn entity:lib-MatterSim-hanseroth2026data .

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:hasImplementation entity:impl-GRACE-hanseroth2026data ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:impl-GRACE-hanseroth2026data a mlips:Implementation ;
    mlips:implementedIn entity:lib-tensorpotential-hanseroth2026data .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:hasImplementation entity:impl-ORB-hanseroth2026data ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-ORB-hanseroth2026data a mlips:Implementation ;
    mlips:implementedIn entity:lib-orb-models-hanseroth2026data .

entity:lib-SevenNet-hanseroth2026data a mlips:Library ;
    rdfs:label "SevenNet" ;
    rdfs:comment "SevenNet 0.11.2" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-MatterSim-hanseroth2026data a mlips:Library ;
    rdfs:label "MatterSim" ;
    rdfs:comment "MatterSim 1.1.2" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-tensorpotential-hanseroth2026data a mlips:Library ;
    rdfs:label "tensorpotential" ;
    rdfs:comment "GRACE tensorpotential 0.5.1" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-orb-models-hanseroth2026data a mlips:Library ;
    rdfs:label "orb-models" ;
    rdfs:comment "ORB 0.3.2" ;
    mlips:candidateForVocabulary mlips:Library .

