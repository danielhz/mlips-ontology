# Q2 -- Material system
###############################################################################

entity:mat-CDP-hanseroth2026data a mlips:MaterialSystem ;
    rdfs:label "Benchmark system CDP as named in the paper (AIMD at 510-660 K; defined in Refs. [41, 42])" ;
    mlips:materialClass "Material-specific benchmark system (solid acid, electrolyte, alloy, layered material or molecular liquid)" .

entity:mat-CPP-hanseroth2026data a mlips:MaterialSystem ;
    rdfs:label "Benchmark system CPP as named in the paper (AIMD at 510-660 K; defined in Refs. [41, 42])" ;
    mlips:materialClass "Material-specific benchmark system (solid acid, electrolyte, alloy, layered material or molecular liquid)" .

