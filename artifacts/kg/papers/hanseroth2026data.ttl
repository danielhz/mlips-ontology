# Canonical Turtle for the protocol-derived encoding of:
#   Jonas Hänseroth et al. (2026). Data-Efficient Construction of Material-Specific Machine-Learning Interatomic Potentials from Ab Initio Molecular Dynamics Trajectories.
#   arXiv (Cornell University). doi:10.48550/arxiv.2608.14899  arXiv:2608.14899v1
#
# Version read: arxiv-preprint arXiv:2608.14899v1 (sha256 a4238b6f2a6dbc3c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 280 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/hanseroth2026data.yaml.
#
# Encoding scope: five universal MLIPs (MACE-MP-0 small, SevenNet-0,
# MatterSim-v1.0.0-5M, GRACE-1L-OAM, ORB-v2) fine-tuned, and MACE, SevenNet
# and GRACE trained from scratch, on 10, 200 or 2,000 configurations
# sampled with stride 100 from AIMD of seven systems, with the test force
# MAEs printed in the heat maps of Fig. 2a-e and Fig. 4a-c. Energy errors,
# stride-10 and universal-model errors (Supplementary Notes 1-3, 6-8, 12,
# 13), the MoS2 stride-1 scaling study (Fig. 3) and model averaging (Fig. 5)
# are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-hanseroth2026data a mlips:BenchmarkStudy ;
    rdfs:label "Hänseroth and Dreßler (2026): how many AIMD configurations turn universal MLIPs into material-specific potentials" ;
    mlips:reportedIn entity:article-hanseroth2026data .

entity:article-hanseroth2026data a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2608.14899> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Data-Efficient Construction of Material-Specific Machine-Learning Interatomic Potentials from Ab Initio Molecular Dynamics Trajectories" ;
    schema:author entity:person-Hanseroth-hanseroth2026data ,
        entity:person-Dreler-hanseroth2026data .

entity:person-Hanseroth-hanseroth2026data a schema:Person ;
    schema:name "Jonas Hänseroth" ;
    schema:givenName "Jonas" ;
    schema:familyName "Hänseroth" .

entity:person-Dreler-hanseroth2026data a schema:Person ;
    schema:name "Christian Dreßler" ;
    schema:givenName "Christian" ;
    schema:familyName "Dreßler" .

