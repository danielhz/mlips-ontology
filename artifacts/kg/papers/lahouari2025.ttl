# Canonical Turtle for the protocol-derived encoding of:
#   Adam Lahouari et al. (2025). Automated Machine Learning Pipeline: Large Language Models-Assisted Automated Data set Generation for Training Machine-Learned Interatomic Potentials.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.5c01610  arXiv:2509.21647v2
#
# Version read: arxiv-preprint arXiv:2509.21647v2 (sha256 2a4865f5828fa4ad...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 252 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/lahouari2025.yaml.
#
# Encoding scope: the AMLP pipeline case study, a PBE-D4 AIMD data set of
# eight acridine polymorphs and three MACE committee members fine-tuned
# from MACE-MPA-0 (mace-mpa-0-medium), with geometry optimisation, NVE and
# NVT simulations. The training errors are stated only approximately for
# all committees together and per committee only in Fig. 4, so no error
# metric is encoded; the RMSDs of Table 2 are structural deviations, not
# energy/force/stress errors.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-lahouari2025 a mlips:BenchmarkStudy ;
    rdfs:label "Lahouari, Rogal and Tuckerman (2025): AMLP, LLM-assisted data-set generation and MACE fine-tuning for acridine polymorphs" ;
    mlips:reportedIn entity:article-lahouari2025 .

entity:article-lahouari2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.5c01610> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Automated Machine Learning Pipeline: Large Language Models-Assisted Automated Data set Generation for Training Machine-Learned Interatomic Potentials" ;
    schema:author <https://orcid.org/0000-0001-5857-1066> ,
        <https://orcid.org/0000-0002-6268-380X> ,
        <https://orcid.org/0000-0003-2194-9955> .

<https://orcid.org/0000-0001-5857-1066> a schema:Person ;
    schema:name "Adam Lahouari" ;
    schema:givenName "Adam" ;
    schema:familyName "Lahouari" ;
    schema:identifier <https://orcid.org/0000-0001-5857-1066> .

<https://orcid.org/0000-0002-6268-380X> a schema:Person ;
    schema:name "Jutta Rogal" ;
    schema:givenName "Jutta" ;
    schema:familyName "Rogal" ;
    schema:identifier <https://orcid.org/0000-0002-6268-380X> .

<https://orcid.org/0000-0003-2194-9955> a schema:Person ;
    schema:name "Mark E. Tuckerman" ;
    schema:givenName "Mark E." ;
    schema:familyName "Tuckerman" ;
