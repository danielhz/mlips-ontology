###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-acridine-lahouari2025 a mlips:MaterialSystem ;
    rdfs:label "Acridine molecular crystal polymorphs (ACRDIN04, 05, 06, 09, 10, 11, 12, 13)" ;
    mlips:chemicalFormula "C13H9N" ;
    mlips:materialClass "Organic molecular crystal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d4-lahouari2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d4-lahouari2025 mlips:hasDFTSettings entity:calc-settings-pbe-d4-lahouari2025 .

entity:calc-settings-pbe-d4-lahouari2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "850"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred 7x7x7" ;
    rdfs:comment "Grimme D4 dispersion (IVDW 13); EDIFF 1e-6 eV; Fermi smearing 0.05 eV; PREC High (Tables S4, S6)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-acridine-lahouari2025 a mlips:TrainingDataset ;
    rdfs:label "Acridine polymorph AIMD data set (8,208 structures; 8,108 after force filtering; 85/15 training/validation split)" ;
    mlips:coversMaterial entity:mat-acridine-lahouari2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 8108 ;
    mlips:hasDFTCalculation entity:calc-pbe-d4-lahouari2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-acridine-lahouari2025 mlips:samplingStrategy
    entity:sampling-aimd-lahouari2025 .

entity:sampling-aimd-lahouari2025 a mlips:SamplingStrategy ;
    rdfs:label "NVT AIMD of eight polymorphs at 300-800 K, Langevin thermostat, 1 fs time step, 10,000 steps" ;
    rdfs:comment "Configurations extracted from each trajectory; force outliers filtered before training (Sec. 3.1.1)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-lahouari2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-lahouari2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:bodyOrder ;
    mlips:hasImplementation entity:impl-MACE-lahouari2025 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-MACE-lahouari2025 a mlips:LossFunction ;
    rdfs:label "Energy and force loss; force weight raised to ten times the energy weight in the second (SWA) stage" .

entity:alg-MACE-lahouari2025 a mls:Algorithm ;
    rdfs:label "AMSGrad with stochastic weight averaging from epoch 250 and exponential moving average (decay 0.99)" .

entity:impl-MACE-lahouari2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

