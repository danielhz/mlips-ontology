# Canonical Turtle for the protocol-derived encoding of:
#   Sebastien Röcken et al. (2024). Accurate machine learning force fields via experimental and simulation data fusion.
#   npj Computational Materials. doi:10.1038/s41524-024-01251-4  arXiv:2308.09142v1
#
# Version read: arxiv-preprint arXiv:2308.09142v1 (sha256 1694e5933afeb14f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 582 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/rocken2024.yaml.
#
# Encoding scope: three DimeNet++ models for Ti (JaxMD, 5 A cutoff):
# DFT pre-trained, then trained sequentially on experimental elastic
# constants with DiffTRe, or with DFT and experimental trainers
# alternated (fused); test-set energy, force and virial RMSE/MAE (Table
# 1). Elastic constants, lattice constants and other properties are not
# metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-rocken2024 a mlips:BenchmarkStudy ;
    rdfs:label "Rocken and Zavadlav (2024): accurate DimeNet++ force fields for titanium via fusion of DFT and experimental data (DiffTRe)" ;
    mlips:reportedIn entity:article-rocken2024 .

entity:article-rocken2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-024-01251-4> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Accurate machine learning force fields via experimental and simulation data fusion" ;
    schema:author <https://orcid.org/0009-0005-0812-7545> ,
        <https://orcid.org/0000-0002-4495-9956> .

<https://orcid.org/0009-0005-0812-7545> a schema:Person ;
    schema:name "Sebastien Röcken" ;
    schema:givenName "Sebastien" ;
    schema:familyName "Röcken" ;
    schema:identifier <https://orcid.org/0009-0005-0812-7545> .

<https://orcid.org/0000-0002-4495-9956> a schema:Person ;
    schema:name "Julija Zavadlav" ;
    schema:givenName "Julija" ;
    schema:familyName "Zavadlav" ;
    schema:identifier <https://orcid.org/0000-0002-4495-9956> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ti-rocken2024 a mlips:MaterialSystem ;
    rdfs:label "Titanium (hcp, bcc, fcc; strained, perturbed and high-temperature configurations)" ;
    mlips:chemicalFormula "Ti" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-rocken2024 a mlips:DFTCalculation .

entity:calc-exp-rocken2024 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-rocken2024 mlips:hasDFTSettings entity:calc-settings-dft-rocken2024 .

entity:calc-settings-dft-rocken2024 a mlips:DFTSettings ;
    rdfs:comment "Previously published Ti DFT database (Refs. 15, 53)" .

entity:calc-exp-rocken2024 mlips:hasReferenceSettings entity:calc-settings-exp-rocken2024 .

entity:calc-settings-exp-rocken2024 a mlips:ReferenceSettings ;
    rdfs:comment "Experimental hcp Ti elastic constants at 23, 323, 623 and 923 K and lattice constants (zero-pressure target)" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ti-dft-rocken2024 a mlips:TrainingDataset ;
    rdfs:label "Ti DFT database (5,704 samples, training split)" ;
    mlips:coversMaterial entity:mat-ti-rocken2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-rocken2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ti-dft-rocken2024 mlips:samplingStrategy
    entity:sampling-pub-rocken2024 .

entity:sampling-pub-rocken2024 a mlips:SamplingStrategy ;
    rdfs:label "Published Ti DFT database: equilibrated, strained and perturbed hcp/bcc/fcc, high-temperature MD and active-learning configurations" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:hasLossFunction entity:loss-DimeNet-rocken2024 ;
    mlips:hasTrainingAlgorithm entity:alg-DimeNet-rocken2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-DimeNet-rocken2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-DimeNet-rocken2024 a mlips:LossFunction ;
    rdfs:label "DFT trainer: weighted MSE (energy 1e-6, force 1e-2, virial 4e-6); EXP trainer: DiffTRe loss on elastic constants and pressure" .

entity:alg-DimeNet-rocken2024 a mls:Algorithm ;
    rdfs:label "Alternating one-epoch DFT and EXP trainers (fused) or EXP trainer only (sequential)" .

entity:impl-DimeNet-rocken2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-JaxMD-rocken2024 .

entity:lib-JaxMD-rocken2024 a mlips:Library ;
    rdfs:label "JaxMD" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-pre-cutoffRadius-rocken2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-seq-cutoffRadius-rocken2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-fused-cutoffRadius-rocken2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-pre-rocken2024 a mlips:MLIPRun ;
    rdfs:label "DimeNet++ Ti: DFT pre-trained" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-ti-dft-rocken2024 ;
    mlips:hasHyperparameterSetting entity:setting-pre-cutoffRadius-rocken2024 ;
    mlips:produces entity:model-pre-rocken2024 .

entity:model-pre-rocken2024 a mlips:TrainedModel ;
    rdfs:label "DimeNet++ Ti DFT pre-trained" .

entity:run-seq-rocken2024 a mlips:MLIPRun ;
    rdfs:label "DimeNet++ Ti: DFT, EXP sequential" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-ti-dft-rocken2024 ;
    mlips:hasHyperparameterSetting entity:setting-seq-cutoffRadius-rocken2024 ;
    mlips:produces entity:model-seq-rocken2024 .

entity:model-seq-rocken2024 a mlips:TrainedModel ;
    rdfs:label "DimeNet++ Ti DFT, EXP sequential" .

entity:run-fused-rocken2024 a mlips:MLIPRun ;
    rdfs:label "DimeNet++ Ti: DFT & EXP fused" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-ti-dft-rocken2024 ;
    mlips:hasHyperparameterSetting entity:setting-fused-cutoffRadius-rocken2024 ;
    mlips:produces entity:model-fused-rocken2024 .

entity:model-fused-rocken2024 a mlips:TrainedModel ;
    rdfs:label "DimeNet++ Ti DFT & EXP fused" .

