    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-mixed-chong2026 ;
    mlips:hasHyperparameterSetting entity:setting-mace-mixed-cutoffRadius-chong2026 ;
    mlips:produces entity:model-mace-mixed-chong2026 .

entity:model-mace-mixed-chong2026 a mlips:TrainedModel ;
    rdfs:label "MACE H 8-mers (both densities)" .

entity:run-pet-mixed-chong2026 a mlips:MLIPRun ;
