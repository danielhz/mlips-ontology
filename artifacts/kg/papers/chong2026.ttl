###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-h8-chong2026 a mlips:MaterialSystem ;
    rdfs:label "Hydrogen 8-mers cut from low-density (molecular, insulating) and high-density (atomic, metallic) bulk hydrogen" ;
    mlips:chemicalFormula "H" ;
    mlips:materialClass "hydrogen clusters" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-chong2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-chong2026 mlips:hasDFTSettings entity:calc-settings-pbe-chong2026 .

entity:calc-settings-pbe-chong2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    mlips:basisSet "tight species defaults" ;
    rdfs:comment "FHI-aims 221103.1; Gaussian smearing 0.025 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mixed-chong2026 a mlips:TrainingDataset ;
    rdfs:label "10,000 hydrogen 8-mers, low and high density 1:1 (8:1:1 split, stratified)" ;
    mlips:coversMaterial entity:mat-h8-chong2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10000 ;
    mlips:hasDFTCalculation entity:calc-pbe-chong2026 .

entity:ds-low-chong2026 a mlips:TrainingDataset ;
    rdfs:label "Low-density hydrogen 8-mers only" ;
    mlips:coversMaterial entity:mat-h8-chong2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-chong2026 .

entity:ds-high-chong2026 a mlips:TrainingDataset ;
    rdfs:label "High-density hydrogen 8-mers only" ;
    mlips:coversMaterial entity:mat-h8-chong2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-chong2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mixed-chong2026 mlips:samplingStrategy
    entity:sampling-clusters-chong2026 .

entity:ds-low-chong2026 mlips:samplingStrategy
    entity:sampling-clusters-chong2026 .

entity:ds-high-chong2026 mlips:samplingStrategy
    entity:sampling-clusters-chong2026 .

entity:sampling-clusters-chong2026 a mlips:SamplingStrategy ;
    rdfs:label "8-mers cut around random atoms (high density: 7 nearest neighbours; low density: nearest bonded pairs) from the 100 highest- and 100 lowest-density FPS configurations of the Cheng et al. bulk-hydrogen AIMD set" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-chong2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:alg-HDNNP-chong2026 a mls:Algorithm ;
    rdfs:label "SOAP-BPNN: Behler-Parrinello atomic networks on SOAP descriptors" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-chong2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:loss-MACE-chong2026 a mlips:LossFunction ;
    rdfs:label "Energy:force 1:100 then reweighted in the second stage (default routine)" .

entity:PET a mlips:MLIPMethod ;
    rdfs:label "Point Edge Transformer (PET)" ;
    mlips:hasHyperparameter mlips:cutoffRadius .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-bpnn-mixed-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-mace-mixed-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-pet-mixed-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-bpnn-low-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-mace-low-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-pet-low-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-bpnn-high-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-mace-high-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-pet-high-cutoffRadius-chong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-bpnn-mixed-chong2026 a mlips:MLIPRun ;
    rdfs:label "SOAP-BPNN trained on hydrogen 8-mers (both densities)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-mixed-chong2026 ;
    mlips:hasHyperparameterSetting entity:setting-bpnn-mixed-cutoffRadius-chong2026 ;
    mlips:produces entity:model-bpnn-mixed-chong2026 .

entity:model-bpnn-mixed-chong2026 a mlips:TrainedModel ;
    rdfs:label "SOAP-BPNN H 8-mers (both densities)" .

entity:run-mace-mixed-chong2026 a mlips:MLIPRun ;
