###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-ikeda2026achieving ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-ikeda2026achieving ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-MTP-ikeda2026achieving a mlips:LossFunction ;
    rdfs:label "Energy per atom averaged over the training configurations (Delta-learning target E(PNO-LCCSD(T)-F12) - E(GFN2-xTB))" .

entity:alg-MTP-ikeda2026achieving a mls:Algorithm ;
    rdfs:label "BFGS (SciPy), at most 1,000 iterations; free-atom energies fixed to the quantum-chemical values" .

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor .

