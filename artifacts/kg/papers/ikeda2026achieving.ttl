###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-frag-ikeda2026achieving a mlips:MaterialSystem ;
    rdfs:label "Hydrogen-terminated fragments of the C48H30 covalent organic framework (benzene to benzerythrene, H2) and their vdW-bound dimers, trimers and tetramers" ;
    mlips:materialClass "Organic molecules (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ccsdt-ikeda2026achieving a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ccsdt-ikeda2026achieving mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-ikeda2026achieving .

entity:calc-settings-ccsdt-ikeda2026achieving a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "heavy-aug-cc-pVTZ" ;
    rdfs:comment "PNO-LCCSD(T)-F12 (F12b, 3*A ansatz, density fitting, no counterpoise correction) in MOLPRO 2024.1 on GFN2-xTB MD snapshots (Sec. II A); the MTP learns the difference to GFN2-xTB (tblite)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-train2-ikeda2026achieving a mlips:TrainingDataset ;
    rdfs:label "Training set #2: master training configurations with up to 2 benzene rings" ;
    mlips:coversMaterial entity:mat-frag-ikeda2026achieving ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 747 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-ikeda2026achieving .

entity:ds-train3-ikeda2026achieving a mlips:TrainingDataset ;
    rdfs:label "Training set #3: master training configurations with up to 3 benzene rings" ;
    mlips:coversMaterial entity:mat-frag-ikeda2026achieving ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1125 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-ikeda2026achieving .

entity:ds-train4-ikeda2026achieving a mlips:TrainingDataset ;
    rdfs:label "Training set #4: master training configurations with up to 4 benzene rings" ;
    mlips:coversMaterial entity:mat-frag-ikeda2026achieving ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1602 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-ikeda2026achieving .

entity:ds-train5-ikeda2026achieving a mlips:TrainingDataset ;
    rdfs:label "Training set #5: master training configurations with up to 5 benzene rings" ;
    mlips:coversMaterial entity:mat-frag-ikeda2026achieving ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1872 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-ikeda2026achieving .

