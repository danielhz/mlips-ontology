# Canonical Turtle for the protocol-derived encoding of:
#   Joshua A. Vita et al. (2023). Data efficiency and extrapolation trends in neural network interatomic potentials.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/acf115  arXiv:2302.05823v2
#
# Version read: arxiv-preprint arXiv:2302.05823v2 (sha256 69892ce31c7f6dc9...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 285 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/vita2023.yaml.
#
# Encoding scope: NequIP and MACE models with different architectures and
# optimiser choices (Tables S1, S4) trained on 25, 125, 250 or 500 3BPA
# configurations at 300 K, with their test energy and force RMSEs on the
# 300, 600 and 1200 K splits (Tables S3, S6). Loss-landscape entropies and
# MD times to failure (Tables S2, S5), the noise study (Fig. 1a) and the
# ANI-Al experiments are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-vita2023 a mlips:BenchmarkStudy ;
    rdfs:label "Vita and Schwalbe-Koda (2023): data efficiency, extrapolation and loss-landscape entropy of NequIP and MACE on 3BPA" ;
    mlips:reportedIn entity:article-vita2023 .

entity:article-vita2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/acf115> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Data efficiency and extrapolation trends in neural network interatomic potentials" ;
    schema:author <https://orcid.org/0000-0001-9191-055X> ,
        <https://orcid.org/0000-0001-9176-0854> .

<https://orcid.org/0000-0001-9191-055X> a schema:Person ;
    schema:name "Joshua A Vita" ;
    schema:givenName "Joshua A" ;
    schema:familyName "Vita" ;
    schema:identifier <https://orcid.org/0000-0001-9191-055X> .

<https://orcid.org/0000-0001-9176-0854> a schema:Person ;
    schema:name "Daniel Schwalbe-Koda" ;
    schema:givenName "Daniel" ;
    schema:familyName "Schwalbe-Koda" ;
    schema:identifier <https://orcid.org/0000-0001-9176-0854> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-bpa-vita2023 a mlips:MaterialSystem ;
    rdfs:label "3-(benzyloxy)pyridin-2-amine (3BPA) molecule" ;
    mlips:chemicalFormula "C12H12N2O" ;
    mlips:materialClass "Flexible drug-like organic molecule (gas phase)" .

