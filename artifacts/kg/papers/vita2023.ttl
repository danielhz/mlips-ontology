###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-bpa25-vita2023 a mlips:TrainingDataset ;
    rdfs:label "3BPA training subset of 25 configurations sampled at 300 K" ;
    mlips:coversMaterial entity:mat-bpa-vita2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 25 .

entity:ds-bpa125-vita2023 a mlips:TrainingDataset ;
    rdfs:label "3BPA training subset of 125 configurations sampled at 300 K" ;
    mlips:coversMaterial entity:mat-bpa-vita2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 125 .

entity:ds-bpa250-vita2023 a mlips:TrainingDataset ;
    rdfs:label "3BPA training subset of 250 configurations sampled at 300 K" ;
    mlips:coversMaterial entity:mat-bpa-vita2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 250 .

entity:ds-bpa500-vita2023 a mlips:TrainingDataset ;
    rdfs:label "3BPA training subset of 500 configurations sampled at 300 K" ;
    mlips:coversMaterial entity:mat-bpa-vita2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 500 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-vita2023 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-vita2023 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-NequIP-vita2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-vita2023 a mlips:LossFunction ;
    rdfs:label "Energy:force weight 1:1000" .

entity:alg-NequIP-vita2023 a mls:Algorithm ;
    rdfs:label "Adam (optionally AMSGrad, EMA), ReduceLROnPlateau (patience 50, factor 0.5)" .

entity:impl-NequIP-vita2023 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-vita2023 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-vita2023 ;
    mlips:hasHyperparameter mlips:bodyOrder ,
        mlips:cutoffRadius ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-MACE-vita2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-vita2023 a mlips:LossFunction ;
    rdfs:label "Energy:force weight 1:1000" .

entity:alg-MACE-vita2023 a mls:Algorithm ;
    rdfs:label "Adam (optionally AMSGrad, EMA, SWA with weight changes), ReduceLROnPlateau (patience 50, factor 0.8)" .

entity:impl-MACE-vita2023 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

