    entity:sampling-qbc-muller2021 .

entity:sampling-qbc-muller2021 a mlips:SamplingStrategy ;
    rdfs:label "15 query-by-committee steps on 2,000 random AIMD structures per step, 20 highest mean-force-disagreement structures added each step (about 300 in total)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-muller2021 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-muller2021 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-HDNNP-muller2021 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-muller2021 a mlips:LossFunction ;
    rdfs:label "Energies and forces" .

entity:alg-HDNNP-muller2021 a mls:Algorithm ;
    rdfs:label "Committee of 8 (90% subsampling each), parallel multistream adaptive global extended Kalman filter" .

entity:impl-HDNNP-muller2021 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-muller2021 .

entity:lib-n2p2-muller2021 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

