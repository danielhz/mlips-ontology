    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "High-Dimensional Neural Network Potentials for Atomistic Simulations" ;
    schema:author entity:person-Hellstrom-hellstrom2020 ,
        entity:person-Behler-hellstrom2020 .

entity:person-Hellstrom-hellstrom2020 a schema:Person ;
    schema:name "Matti Hellström" ;
    schema:givenName "Matti" ;
    schema:familyName "Hellström" .

entity:person-Behler-hellstrom2020 a schema:Person ;
