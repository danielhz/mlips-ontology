###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-han2026 ;
    mlips:hasHyperparameter entity:hp-cutoff-type-han2026 ,
        entity:hp-target-neighbors-han2026 ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        entity:hp-lmax-han2026 ,
        mlips:bodyOrder ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-han2026 a mlips:LossFunction ;
    rdfs:label "Energy weight 10, force weight 1000 (SWA force weight 10, SWA from epoch 450)" .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-han2026 ;
    mlips:hasHyperparameter entity:hp-cutoff-type-han2026 ,
        entity:hp-target-neighbors-han2026 ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-lmax-han2026 ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-han2026 a mlips:LossFunction ;
    rdfs:label "Energy weight 1.0, force weight 10.0" .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:hasLossFunction entity:loss-ORB-han2026 ;
    mlips:hasTrainingAlgorithm entity:alg-ORB-han2026 ;
    mlips:hasHyperparameter entity:hp-cutoff-type-han2026 ,
        entity:hp-target-neighbors-han2026 ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-ORB-han2026 a mlips:LossFunction ;
    rdfs:label "Energy weight 1.0, force weight 1.0" .

entity:alg-ORB-han2026 a mls:Algorithm ;
    rdfs:label "Trained from scratch with the authors' own training script, without the diffusion pretraining of Orb-v1" .

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" ;
    mlips:hasLossFunction entity:loss-TensorNet-han2026 ;
    mlips:hasHyperparameter entity:hp-cutoff-type-han2026 ,
        entity:hp-target-neighbors-han2026 ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-TensorNet-han2026 a mlips:LossFunction ;
    rdfs:label "Energy weight 1.0, force weight 1000.0 (MD22) or 1.0 (MatPES)" .

entity:hp-cutoff-type-han2026 a mlips:Hyperparameter ;
    rdfs:label "Cutoff type (fixed or smooth dynamic)" ;
    mlips:hyperparameterName "cutoff_type" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-target-neighbors-han2026 a mlips:Hyperparameter ;
    rdfs:label "Target average number of neighbours mu of the dynamic cutoff" ;
    mlips:hyperparameterName "target_neighbors" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lmax-han2026 a mlips:Hyperparameter ;
    rdfs:label "Maximum rotation order l_max" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

