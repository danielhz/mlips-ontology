# Canonical Turtle for the protocol-derived encoding of:
#   Kevin Han et al. (2026). Smooth Dynamic Cutoffs for Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2601.21147  arXiv:2601.21147v1
#
# Version read: arxiv-preprint arXiv:2601.21147v1 (sha256 258bfa2db4caaecc...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 144 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the paired fixed-cutoff and dynamic-cutoff trainings of
# small MACE, NequIP, Orb-v3 and TensorNet models on MatPES-r2SCAN
# (Table 2, plus the reduced-fixed-cutoff TensorNet of Table 3) and on the
# seven MD22 molecules (Table 1), with the hyperparameters of Appendix B.
# The dynamic cutoff is a per-atom smooth cutoff targeting mu neighbours;
# it is encoded as a setting, not as a method. Preprint only (arXiv v1).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-han2026 a mlips:BenchmarkStudy ;
    rdfs:label "Han et al. (2026): smooth dynamic cutoffs for machine learning interatomic potentials" ;
    mlips:reportedIn entity:article-han2026 .

entity:article-han2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2601.21147> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Smooth Dynamic Cutoffs for Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Han-han2026 ,
        entity:person-Cong-han2026 ,
        entity:person-Deng-han2026 ,
        entity:person-Farimani-han2026 .

entity:person-Han-han2026 a schema:Person ;
    schema:name "Kevin Han" ;
    schema:givenName "Kevin" ;
    schema:familyName "Han" .

entity:person-Cong-han2026 a schema:Person ;
    schema:name "Haolin Cong" ;
    schema:givenName "Haolin" ;
    schema:familyName "Cong" .

entity:person-Deng-han2026 a schema:Person ;
    schema:name "Bowen Deng" ;
    schema:givenName "Bowen" ;
    schema:familyName "Deng" .

entity:person-Farimani-han2026 a schema:Person ;
    schema:name "Amir Barati Farimani" ;
    schema:givenName "Amir Barati" ;
    schema:familyName "Farimani" .

