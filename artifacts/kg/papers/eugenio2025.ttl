entity:ds-ybco-eugenio2025 a mlips:TrainingDataset ;
    rdfs:label "YBCO training database (2,712 structures, 7,174,977 force components) after force (> 80 eV/A) and SOAP farthest-point filtering" ;
    mlips:coversMaterial entity:mat-ybco-eugenio2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2712 ;
    mlips:hasDFTCalculation entity:calc-pbe-eugenio2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ybco-eugenio2025 mlips:samplingStrategy
    entity:sampling-perturb-eugenio2025 ,
    entity:sampling-al-eugenio2025 .

entity:sampling-perturb-eugenio2025 a mlips:SamplingStrategy ;
    rdfs:label "Volume (-10% to +200%), random strain (+-5%, angle sd about 2.5 deg) and Lindemann-limited thermal displacements of relaxed cells; interstitials, vacancies and antisites in YBCO7; random-displacement amorphous cells" .

entity:sampling-al-eugenio2025 a mlips:SamplingStrategy ;
    rdfs:label "Active learning: MD with preliminary MLPs, re-evaluated with DFT" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-eugenio2025 ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-eugenio2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-ACE-eugenio2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:loss-ACE-eugenio2025 a mlips:LossFunction ;
    rdfs:label "Weighted energy (1) and force (10) loss, kappa = 0.3" .

entity:alg-ACE-eugenio2025 a mls:Algorithm ;
    rdfs:label "BFGS, up to 2,000 iterations; ZBL core repulsion" .

entity:impl-ACE-eugenio2025 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-eugenio2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-eugenio2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:bodyOrder ,
        mlips:numRadialBasis ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-eugenio2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:loss-MACE-eugenio2025 a mlips:LossFunction ;
    rdfs:label "Weighted energy (1) and force (10) loss" .

entity:alg-MACE-eugenio2025 a mls:Algorithm ;
    rdfs:label "AMSGrad, gradient clipping 5, weight decay 5e-7, EMA 0.99, SWA from epoch 425 (stage-one model selected)" .

entity:impl-MACE-eugenio2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-eugenio2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-eugenio2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-GAP-eugenio2025 a mls:Algorithm ;
    rdfs:label "Two-body, three-body and EAM descriptors; hyperparameters by Bayesian optimisation (BoTorch); screened Coulomb repulsion" .

entity:impl-GAP-eugenio2025 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:hasImplementation entity:impl-tabGAP-eugenio2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:impl-tabGAP-eugenio2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-tabgap-eugenio2025 .

entity:lib-tabgap-eugenio2025 a mlips:Library ;
    rdfs:label "tabgap" ;
    rdfs:comment "LAMMPS pair_style tabgap" ;
    mlips:candidateForVocabulary mlips:Library .

