###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-eugenio2025 mlips:hasDFTSettings entity:calc-settings-pbe-eugenio2025 .

entity:calc-settings-pbe-eugenio2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-eugenio2025 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:kPointMesh "Gamma point (supercells converged to 1 meV/atom)" ;
    rdfs:comment "CP2K Quickstep GPW, 400 Ry cutoff, DZVP basis, GTH pseudopotentials, non-spin-polarised." .

