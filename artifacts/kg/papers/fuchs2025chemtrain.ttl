###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-fuchs2025chemtrain ;
    mlips:hasImplementation entity:impl-Allegro-fuchs2025chemtrain ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-Allegro-fuchs2025chemtrain a mlips:LossFunction ;
    rdfs:label "Force-matching energy + force MSE" .

entity:impl-Allegro-fuchs2025chemtrain a mlips:Implementation ;
    mlips:implementedIn entity:lib-chemtrain-fuchs2025chemtrain .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-fuchs2025chemtrain ;
    mlips:hasImplementation entity:impl-MACE-fuchs2025chemtrain ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-fuchs2025chemtrain a mlips:LossFunction ;
    rdfs:label "Energy weight 1e-6, force weight 1e-1" .

entity:impl-MACE-fuchs2025chemtrain a mlips:Implementation ;
    mlips:implementedIn entity:lib-chemtrain-fuchs2025chemtrain .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:hasImplementation entity:impl-PaiNN-fuchs2025chemtrain ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-PaiNN-fuchs2025chemtrain a mlips:Implementation ;
    mlips:implementedIn entity:lib-chemtrain-fuchs2025chemtrain .

entity:lib-chemtrain-fuchs2025chemtrain a mlips:Library ;
    rdfs:label "chemtrain" ;
    mlips:candidateForVocabulary mlips:Library .

