###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ani-al-fuchs2025chemtrain mlips:hasDFTSettings entity:calc-settings-ani-al-fuchs2025chemtrain .

entity:calc-settings-ani-al-fuchs2025chemtrain a mlips:DFTSettings ;
    rdfs:comment "ANI-AL published DFT labels." .

entity:calc-spice-fuchs2025chemtrain mlips:hasDFTSettings entity:calc-settings-spice-fuchs2025chemtrain .

entity:calc-settings-spice-fuchs2025chemtrain a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-wB97M-D3-BJ-fuchs2025chemtrain ;
    mlips:basisSet "def2-TZVPPD" ;
    rdfs:comment "SPICE labels." .

entity:calc-pbe0ts-fuchs2025chemtrain mlips:hasDFTSettings entity:calc-settings-pbe0ts-fuchs2025chemtrain .

entity:calc-settings-pbe0ts-fuchs2025chemtrain a mlips:DFTSettings ;
