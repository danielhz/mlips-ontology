###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-al-fuchs2025chemtrain a mlips:MaterialSystem ;
    rdfs:label "Aluminium (ANI-AL nonequilibrium supercells up to 250 atoms)" ;
    mlips:chemicalFormula "Al" ;
    mlips:materialClass "fcc metal" .

entity:mat-organics-fuchs2025chemtrain a mlips:MaterialSystem ;
    rdfs:label "Drug-like molecules, dimers, dipeptides and solvated amino acids (SPICE)" ;
    mlips:materialClass "organic and biomolecular systems" .

entity:mat-water-fuchs2025chemtrain a mlips:MaterialSystem ;
    rdfs:label "Liquid water and ice (H2O-PBE0TS)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid and solid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ani-al-fuchs2025chemtrain a mlips:DFTCalculation .

entity:calc-spice-fuchs2025chemtrain a mlips:DFTCalculation .

