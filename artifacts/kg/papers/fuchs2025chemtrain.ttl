###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ani-al-fuchs2025chemtrain a mlips:TrainingDataset ;
    rdfs:label "ANI-AL (over 6000 configurations; 7:2:1 split)" ;
    mlips:coversMaterial entity:mat-al-fuchs2025chemtrain ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-ani-al-fuchs2025chemtrain .

entity:ds-spice-fuchs2025chemtrain a mlips:TrainingDataset ;
