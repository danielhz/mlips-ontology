entity:xc-wB97M-D3-BJ-fuchs2025chemtrain a mlips:XCFunctional ;
    rdfs:label "wB97M-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-PBE0-TS-fuchs2025chemtrain a mlips:XCFunctional ;
