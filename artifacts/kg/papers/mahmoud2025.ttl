###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-go-mahmoud2025 a mlips:MaterialSystem ;
    rdfs:label "Graphene oxide sheets with hydroxyl, epoxide, aldehyde and carboxylic-acid groups and small molecules" ;
    mlips:materialClass "functionalised carbon (graphene oxide)" .

entity:mat-rmd17-mahmoud2025 a mlips:MaterialSystem ;
    rdfs:label "rMD17 small organic molecules (aspirin, ethanol, malonaldehyde, naphthalene, salicylic acid, toluene)" ;
    mlips:materialClass "small organic molecules" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-mahmoud2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-mahmoud2025 mlips:hasDFTSettings entity:calc-settings-pbe-mahmoud2025 .

entity:calc-settings-pbe-mahmoud2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CASTEP-mahmoud2025 ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "On-the-fly generated pseudopotentials; GO-MACE-23 training labels (CASTEP+ML data generation)." .

entity:lib-CASTEP-mahmoud2025 a mlips:Library ;
    rdfs:label "CASTEP" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-go-mahmoud2025 a mlips:TrainingDataset ;
    rdfs:label "GO-MACE-23 training data (graphene oxide, PBE)" ;
    mlips:coversMaterial entity:mat-go-mahmoud2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbe-mahmoud2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-mahmoud2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:alg-MACE-mahmoud2025 a mls:Algorithm ;
    rdfs:label "GO-MACE-23 architecture with max L of the hidden equivariant features set to 0, 1 or 2" .

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" .

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mace-l0-cutoffRadius-mahmoud2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3.7"^^xsd:double .

entity:setting-mace-l2-cutoffRadius-mahmoud2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3.7"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-go-mace-23-mahmoud2025 a mlips:MLIPRun ;
    rdfs:label "GO-MACE-23 (max L = 1, 3.7 A cutoff) as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-go-mace-23-mahmoud2025 .

entity:model-go-mace-23-mahmoud2025 a mlips:TrainedModel ;
    rdfs:label "GO-MACE-23" .

entity:run-mace-l0-mahmoud2025 a mlips:MLIPRun ;
    rdfs:label "MACE refitted on GO-MACE-23 data with max L = 0 (invariant)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-go-mahmoud2025 ;
    mlips:hasHyperparameterSetting entity:setting-mace-l0-cutoffRadius-mahmoud2025 ;
    mlips:produces entity:model-mace-l0-mahmoud2025 .

entity:model-mace-l0-mahmoud2025 a mlips:TrainedModel ;
    rdfs:label "GO-MACE (max L = 0)" .

entity:run-mace-l2-mahmoud2025 a mlips:MLIPRun ;
