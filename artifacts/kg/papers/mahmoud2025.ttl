# Canonical Turtle for the protocol-derived encoding of:
#   Chiheb Ben Mahmoud et al. (2025). Assessing zero-shot generalisation behaviour in graph-neural-network interatomic potentials.
#   Digital Discovery. doi:10.1039/d5dd00103j  arXiv:2502.21317v2
#
# Version read: arxiv-preprint arXiv:2502.21317v2 (sha256 a4154f5ed70e9557...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 665 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/mahmoud2025.yaml.
#
# Encoding scope: GO-MACE-23 (MACE, max L = 1) used as distributed, the
# max L = 0 and max L = 2 MACE refits, and SchNet, PaiNN, TensorNet and
# NequIP models trained by the authors on the GO-MACE-23 data, with their
# zero-shot energy and force RMSEs on rMD17 molecules against rMD17's DFT
# labels (Tables 1 and 2). MACE-OFF23/24 are baselines evaluated only in
# figures.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mahmoud2025 a mlips:BenchmarkStudy ;
    rdfs:label "Ben Mahmoud et al. (2025): zero-shot generalisation of graph-neural-network interatomic potentials trained on graphene-oxide data" ;
    mlips:reportedIn entity:article-mahmoud2025 .

entity:article-mahmoud2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/d5dd00103j> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Assessing zero-shot generalisation behaviour in graph-neural-network interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-6695-1402> ,
        <https://orcid.org/0000-0003-3290-4787> ,
        <https://orcid.org/0009-0004-2814-6754> ,
        <https://orcid.org/0009-0006-7377-7146> ,
        <https://orcid.org/0000-0001-6873-0278> .

