# Canonical Turtle for the protocol-derived encoding of:
#   Jonas Grandel et al. (2026). Targeted fine-tuning of machine-learning interatomic potentials for phonons and phase transitions.
#   npj Computational Materials. doi:10.1038/s41524-026-02338-w  arXiv:2604.01017v2
#
# Version read: arxiv-preprint arXiv:2604.01017v2 (sha256 bc80e083b16bdc9a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 515 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/grandel2026.yaml.
#
# Encoding scope: per-material MACE models for 53 Materials Project
# compounds (mostly chalcogenides and phase-change materials), obtained
# by transfer learning, multi-head fine-tuning with replay, full-rank
# LoRA in Equitrain, or training from scratch, on rattled and
# relaxation-trajectory configurations (16 training, 4 validation per
# material, VASP PBE). Force MAEs are figure-only (Fig. 2); phonon,
# thermal, elastic and phase-transition errors are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-grandel2026 a mlips:BenchmarkStudy ;
    rdfs:label "Grandel, Benner and George (2026): targeted fine-tuning of MACE-MP-0b3 (transfer, multi-head, LoRA via Equitrain) for phonons, thermal and elastic properties and phase transitions of 53 materials" ;
    mlips:reportedIn entity:article-grandel2026 .

entity:article-grandel2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-02338-w> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Targeted fine-tuning of machine-learning interatomic potentials for phonons and phase transitions" ;
    schema:author entity:person-Grandel-grandel2026 ,
        entity:person-Benner-grandel2026 ,
        <https://orcid.org/0000-0001-8907-0336> .

entity:person-Grandel-grandel2026 a schema:Person ;
    schema:name "Jonas Grandel" ;
    schema:givenName "Jonas" ;
    schema:familyName "Grandel" .

entity:person-Benner-grandel2026 a schema:Person ;
    schema:name "Philipp Benner" ;
    schema:givenName "Philipp" ;
    schema:familyName "Benner" .

<https://orcid.org/0000-0001-8907-0336> a schema:Person ;
    schema:name "Janine George" ;
    schema:givenName "Janine" ;
    schema:familyName "George" ;
    schema:identifier <https://orcid.org/0000-0001-8907-0336> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mp53-grandel2026 a mlips:MaterialSystem ;
    rdfs:label "53 crystalline materials from the Materials Project (mostly Te, Sb and Se compounds; up to 40 atoms per primitive cell)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-grandel2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-grandel2026 mlips:hasDFTSettings entity:calc-settings-vasp-grandel2026 .

entity:calc-settings-vasp-grandel2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "k-point spacing 0.1 1/A" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ft-grandel2026 a mlips:TrainingDataset ;
    rdfs:label "Per-material fine-tuning sets (16 training configurations per material; 4 unscaled-volume configurations for validation)" ;
    mlips:coversMaterial entity:mat-mp53-grandel2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-grandel2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ft-grandel2026 mlips:samplingStrategy
    entity:sampling-rattle-grandel2026 .

entity:sampling-rattle-grandel2026 a mlips:SamplingStrategy ;
    rdfs:label "Hiphive Monte Carlo rattling (about 0.1 A) of small or large cubic supercells, lattice perturbation (+/-2%), volume scaling (-5% to +5%), four configurations per MACE-MP-0b3 relaxation trajectory" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-grandel2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-grandel2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-grandel2026 ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:loss-MACE-grandel2026 a mlips:LossFunction ;
    rdfs:label "Huber losses (delta 0.01) on energies, forces and stresses, weights 10, 100, 1000" .

entity:alg-MACE-grandel2026 a mls:Algorithm ;
    rdfs:label "AdamW with ReduceLROnPlateau, up to 200 epochs" .

entity:impl-MACE-grandel2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-transfer-cutoffRadius-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-transfer-numLayers-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-transfer-learningRate-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-transfer-numEpochs-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

entity:setting-multihead-cutoffRadius-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-multihead-numLayers-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-multihead-learningRate-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-multihead-numEpochs-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

entity:setting-equitrain-cutoffRadius-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-equitrain-numLayers-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-equitrain-learningRate-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-equitrain-numEpochs-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

entity:setting-scratch-cutoffRadius-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-scratch-numLayers-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-scratch-learningRate-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-scratch-numEpochs-grandel2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-transfer-grandel2026 a mlips:MLIPRun ;
    rdfs:label "Transfer-learned MACE-MP-0b3 models (one per material)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ft-grandel2026 ;
    mlips:hasHyperparameterSetting entity:setting-transfer-cutoffRadius-grandel2026 ,
        entity:setting-transfer-numLayers-grandel2026 ,
        entity:setting-transfer-learningRate-grandel2026 ,
        entity:setting-transfer-numEpochs-grandel2026 ;
    mlips:produces entity:model-transfer-grandel2026 .

entity:model-transfer-grandel2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b3 transfer fine-tuned (53 materials)" .

entity:run-multihead-grandel2026 a mlips:MLIPRun ;
    rdfs:label "Multi-head fine-tuned MACE-MP-0b3 models with 100 replay structures" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ft-grandel2026 ;
    mlips:hasHyperparameterSetting entity:setting-multihead-cutoffRadius-grandel2026 ,
        entity:setting-multihead-numLayers-grandel2026 ,
        entity:setting-multihead-learningRate-grandel2026 ,
        entity:setting-multihead-numEpochs-grandel2026 ;
    mlips:produces entity:model-multihead-grandel2026 .

entity:model-multihead-grandel2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b3 multi-head fine-tuned (53 materials)" .

entity:run-equitrain-grandel2026 a mlips:MLIPRun ;
    rdfs:label "Full-rank LoRA fine-tuned MACE-MP-0b3 models (Equitrain)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ft-grandel2026 ;
    mlips:hasHyperparameterSetting entity:setting-equitrain-cutoffRadius-grandel2026 ,
        entity:setting-equitrain-numLayers-grandel2026 ,
        entity:setting-equitrain-learningRate-grandel2026 ,
        entity:setting-equitrain-numEpochs-grandel2026 ;
    mlips:produces entity:model-equitrain-grandel2026 .

entity:model-equitrain-grandel2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b3 Equitrain LoRA fine-tuned (53 materials)" .

entity:run-scratch-grandel2026 a mlips:MLIPRun ;
    rdfs:label "MACE models trained from scratch on the fine-tuning data" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ft-grandel2026 ;
    mlips:hasHyperparameterSetting entity:setting-scratch-cutoffRadius-grandel2026 ,
        entity:setting-scratch-numLayers-grandel2026 ,
        entity:setting-scratch-learningRate-grandel2026 ,
        entity:setting-scratch-numEpochs-grandel2026 ;
    mlips:produces entity:model-scratch-grandel2026 .

entity:model-scratch-grandel2026 a mlips:TrainedModel ;
    rdfs:label "MACE from scratch (53 materials)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Training per material on an NVIDIA A100: 1.2 min (scratch and transfer), 7.3 min (Equitrain), 8.3 min (multi-head with 100 replay structures). Generating 10 large-supercell training structures took 18.8 h per material on average versus 27.3 h for DFT phonon supercells (three 48-core nodes) (Sec. 3.6).

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Force (and energy/stress) MAEs are figure-only (Fig. 2b) or in the SI. Phonon MAEs and IQRs (Tables 1-2), thermal and elastic errors and phase-transition scores (Tables 3-4) are properties. The checkpoint is named only as MACE-MP-0b3 (no size), so it is not linked to the registry model MACE-MP-0b3-medium.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/grandel2026.yaml) until the schema has terms for them.
