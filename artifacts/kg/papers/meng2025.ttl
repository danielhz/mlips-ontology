# Canonical Turtle for the protocol-derived encoding of:
#   Zijian Meng et al. (2025). Small-cell-based fast active learning of machine learning interatomic potentials.
#   Computational Materials Science. doi:10.1016/j.commatsci.2025.113919  arXiv:2504.07293v1
#
# Version read: arxiv-preprint arXiv:2504.07293v1 (sha256 eb3e1fc228fd0bdb...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 417 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/meng2025.yaml.
#
# Encoding scope: the small-cell active-learning protocol (24 parallel
# MD instances per stage with cells growing from 1-2 to 54 atoms;
# configuration- or neighbourhood-mode extrapolation grades; Quantum
# ESPRESSO PBE labels), the potassium MTPs of levels 8-18 trained with it
# or with large cells, and the Na-K MTP (level 18, configuration mode).
# Training and test errors are figure-only (Figs. 5-8); training costs
# are given in core-hours (Table 5, resources); solid and liquid
# properties are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-meng2025 a mlips:BenchmarkStudy ;
    rdfs:label "Meng et al. (2025): small-cell-based fast active learning of moment tensor potentials for potassium, sodium and Na-K" ;
    mlips:reportedIn entity:article-meng2025 .

entity:article-meng2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.commatsci.2025.113919> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Small-cell-based fast active learning of machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0009-0004-5476-5209> ,
        entity:person-Sun-meng2025 ,
        <https://orcid.org/0000-0002-5232-0036> ,
        entity:person-Maxwell-meng2025 ,
        entity:person-Grant-meng2025 ,
        <https://orcid.org/0000-0001-5332-7128> .

<https://orcid.org/0009-0004-5476-5209> a schema:Person ;
    schema:name "Zijian Meng" ;
    schema:givenName "Zijian" ;
    schema:familyName "Meng" ;
    schema:identifier <https://orcid.org/0009-0004-5476-5209> .

entity:person-Sun-meng2025 a schema:Person ;
    schema:name "Hao Sun" ;
    schema:givenName "Hao" ;
    schema:familyName "Sun" .

<https://orcid.org/0000-0002-5232-0036> a schema:Person ;
    schema:name "Edmanuel Torres" ;
    schema:givenName "Edmanuel" ;
    schema:familyName "Torres" ;
    schema:identifier <https://orcid.org/0000-0002-5232-0036> .

entity:person-Maxwell-meng2025 a schema:Person ;
    schema:name "Christopher Maxwell" ;
    schema:givenName "Christopher" ;
    schema:familyName "Maxwell" .

entity:person-Grant-meng2025 a schema:Person ;
    schema:name "Ryan Eric Grant" ;
    schema:givenName "Ryan Eric" ;
    schema:familyName "Grant" .

<https://orcid.org/0000-0001-5332-7128> a schema:Person ;
    schema:name "Laurent Karim Béland" ;
    schema:givenName "Laurent Karim" ;
    schema:familyName "Béland" ;
    schema:identifier <https://orcid.org/0000-0001-5332-7128> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-k-meng2025 a mlips:MaterialSystem ;
    rdfs:label "Potassium: solid bcc and liquid" ;
    mlips:chemicalFormula "K" ;
    mlips:materialClass "Metals" .

entity:mat-nak-meng2025 a mlips:MaterialSystem ;
    rdfs:label "Na-K alloys: liquid eutectic and the Na2K C14 Laves phase" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-meng2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-meng2025 mlips:hasDFTSettings entity:calc-settings-pbe-meng2025 .

entity:calc-settings-pbe-meng2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "QE 6.6; K 60/300 Ry, Na 90/450 Ry; 0.01 Ry Gaussian smearing; PSlibrary spn-kjpaw pseudopotentials; k-points per stage (Table 1)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-k-nbh-meng2025 a mlips:TrainingDataset ;
    rdfs:label "Potassium training set from neighbourhood-mode small-cell active learning (2-54 atoms)" ;
    mlips:coversMaterial entity:mat-k-meng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-meng2025 .

entity:ds-nak-meng2025 a mlips:TrainingDataset ;
    rdfs:label "Na-K training set (K and Na sets combined, then extended by configuration-mode small-cell active learning)" ;
    mlips:coversMaterial entity:mat-nak-meng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-meng2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-k-nbh-meng2025 mlips:samplingStrategy
    entity:sampling-smallcell-meng2025 .

entity:ds-nak-meng2025 mlips:samplingStrategy
    entity:sampling-smallcell-meng2025 .

entity:sampling-smallcell-meng2025 a mlips:SamplingStrategy ;
    rdfs:label "Small-cell active learning: staged parallel MD (random temperatures and strains; barostat and random concentrations for Na-K) with MLIP-3 extrapolation-grade selection (gamma_select 2.1, gamma_break 10) and redundancy filtering" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ;
    mlips:hasImplementation entity:impl-MTP-meng2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MTP-meng2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-k-nbh08-cutoffRadius-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-k-nbh08-momentLevel-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-k-nbh12-cutoffRadius-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-k-nbh12-momentLevel-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "12"^^xsd:integer .

entity:setting-k-nbh16-cutoffRadius-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-k-nbh16-momentLevel-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "16"^^xsd:integer .

entity:setting-nak18-cutoffRadius-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-nak18-momentLevel-meng2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "18"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-k-nbh08-meng2025 a mlips:MLIPRun ;
    rdfs:label "Potassium MTP NBH08(2-54): level 8, neighbourhood mode, cells of 2-54 atoms" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-k-nbh-meng2025 ;
    mlips:hasHyperparameterSetting entity:setting-k-nbh08-cutoffRadius-meng2025 ,
        entity:setting-k-nbh08-momentLevel-meng2025 ;
    mlips:produces entity:model-k-nbh08-meng2025 .

entity:model-k-nbh08-meng2025 a mlips:TrainedModel ;
    rdfs:label "K MTP NBH08(2-54)" .

entity:run-k-nbh12-meng2025 a mlips:MLIPRun ;
    rdfs:label "Potassium MTP NBH12(2-54): level 12, neighbourhood mode" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-k-nbh-meng2025 ;
    mlips:hasHyperparameterSetting entity:setting-k-nbh12-cutoffRadius-meng2025 ,
        entity:setting-k-nbh12-momentLevel-meng2025 ;
    mlips:produces entity:model-k-nbh12-meng2025 .

entity:model-k-nbh12-meng2025 a mlips:TrainedModel ;
    rdfs:label "K MTP NBH12(2-54)" .

entity:run-k-nbh16-meng2025 a mlips:MLIPRun ;
    rdfs:label "Potassium MTP NBH16(2-54): level 16, neighbourhood mode" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-k-nbh-meng2025 ;
    mlips:hasHyperparameterSetting entity:setting-k-nbh16-cutoffRadius-meng2025 ,
        entity:setting-k-nbh16-momentLevel-meng2025 ;
    mlips:produces entity:model-k-nbh16-meng2025 .

entity:model-k-nbh16-meng2025 a mlips:TrainedModel ;
    rdfs:label "K MTP NBH16(2-54)" .

entity:run-nak18-meng2025 a mlips:MLIPRun ;
    rdfs:label "Na-K MTP, level 18, configuration-mode small-cell active learning" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-nak-meng2025 ;
    mlips:hasHyperparameterSetting entity:setting-nak18-cutoffRadius-meng2025 ,
        entity:setting-nak18-momentLevel-meng2025 ;
    mlips:produces entity:model-nak18-meng2025 .

entity:model-nak18-meng2025 a mlips:TrainedModel ;
    rdfs:label "NaK MTP level 18" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Small-cell training costs (Table 5): potassium 348.5 core-h CPU (20.0 h wall), sodium 312.0 core-h (22.2 h), Na-K 1,012.8 core-h (73.1 h); DFT is about 95 % of the cost for potassium. NBH08(54-54) large-cell training costs 237 times more CPU time than CFG08(2-54) (Fig. 5). Intel Xeon E5-2650 v4 nodes.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Training RMSEs (Fig. 5), test force residuals on 20 liquid 128-atom AIMD configurations (Figs. 6-8) and sparsification effects are figure-only; the figure text is not machine-readable here. Other levels (10, 14, 18), configuration-mode and large-cell potassium MTPs are not encoded separately.
# - Elastic constants (Table 3), critical exponents (Table 4), densities (Table 6), RDFs, melting points and the C14 equation of state are properties.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/meng2025.yaml) until the schema has terms for them.
