# Canonical Turtle for the protocol-derived encoding of:
#   Johannes Sandberg et al. (2026). Benchmarking machine-learning interatomic potentials using classical force fields.
#   arXiv (Cornell University). doi:10.48550/arxiv.2610.14239  arXiv:2610.14239v1
#
# Version read: arxiv-preprint arXiv:2610.14239v1 (sha256 7fe2a9c9be5668d8...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 405 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/sandberg2026.yaml.
#
# Encoding scope: synthetic data sets labelled by three classical
# potentials (LJ argon, EAM copper, SW silicon), each sampled as Liquid 1,
# Liquid 2 (ramped to evaporation) and Cluster (64-atom droplets) with
# 250 snapshots, and the linear ACE (python-ace), HDNNP (n2p2) and MACE
# models trained on them (five 9:1 splits each). The models trained on
# Liquid 2 are encoded as runs because their run times are tabulated
# (Tables II-III); all accuracy results (force RMSEs, 2- and 4-body curve
# errors, RDF errors, noise study) are figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-sandberg2026 a mlips:BenchmarkStudy ;
    rdfs:label "Sandberg et al. (2026): benchmarking linear ACE, HDNNP and MACE against classical reference force fields (LJ, EAM, Stillinger-Weber)" ;
    mlips:reportedIn entity:article-sandberg2026 .

entity:article-sandberg2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.14239> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Benchmarking machine-learning interatomic potentials using classical force fields" ;
    schema:author entity:person-Sandberg-sandberg2026 ,
        entity:person-Dusson-sandberg2026 ,
        entity:person-Lam-sandberg2026 .

entity:person-Sandberg-sandberg2026 a schema:Person ;
    schema:name "Johannes Sandberg" ;
    schema:givenName "Johannes" ;
    schema:familyName "Sandberg" .

entity:person-Dusson-sandberg2026 a schema:Person ;
    schema:name "Geneviève Dusson" ;
    schema:givenName "Geneviève" ;
    schema:familyName "Dusson" .

entity:person-Lam-sandberg2026 a schema:Person ;
    schema:name "Julien Lam" ;
    schema:givenName "Julien" ;
    schema:familyName "Lam" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lj-sandberg2026 a mlips:MaterialSystem ;
    rdfs:label "Lennard-Jones argon (eps = 117.7 K, sigma = 3.504 A, cut at 2.5 sigma): liquid and cluster configurations of 64 atoms" ;
    mlips:chemicalFormula "Ar" ;
    mlips:materialClass "Material-specific benchmark system (solid acid, electrolyte, alloy, layered material or molecular liquid)" .

entity:mat-eam-sandberg2026 a mlips:MaterialSystem ;
    rdfs:label "EAM copper (Ref. 47): liquid and cluster configurations of 64 atoms" ;
    mlips:chemicalFormula "Cu" ;
    mlips:materialClass "Material-specific benchmark system (solid acid, electrolyte, alloy, layered material or molecular liquid)" .

entity:mat-sw-sandberg2026 a mlips:MaterialSystem ;
    rdfs:label "Stillinger-Weber silicon (Ref. 48): liquid and cluster configurations of 64 atoms" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Material-specific benchmark system (solid acid, electrolyte, alloy, layered material or molecular liquid)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ref-lj-sandberg2026 a mlips:ReferenceCalculation .

entity:calc-ref-eam-sandberg2026 a mlips:ReferenceCalculation .

entity:calc-ref-sw-sandberg2026 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ref-lj-sandberg2026 mlips:hasReferenceSettings entity:calc-settings-ref-lj-sandberg2026 .

entity:calc-settings-ref-lj-sandberg2026 a mlips:ReferenceSettings ;
    rdfs:comment "Classical LJ potential (Lennard-Jones argon (eps = 117.7 K, sigma = 3.504 A, cut at 2.5 sigma)) evaluated in LAMMPS as the reference." .

entity:calc-ref-eam-sandberg2026 mlips:hasReferenceSettings entity:calc-settings-ref-eam-sandberg2026 .

entity:calc-settings-ref-eam-sandberg2026 a mlips:ReferenceSettings ;
    rdfs:comment "Classical EAM potential (EAM copper (Ref. 47)) evaluated in LAMMPS as the reference." .

entity:calc-ref-sw-sandberg2026 mlips:hasReferenceSettings entity:calc-settings-ref-sw-sandberg2026 .

entity:calc-settings-ref-sw-sandberg2026 a mlips:ReferenceSettings ;
    rdfs:comment "Classical SW potential (Stillinger-Weber silicon (Ref. 48)) evaluated in LAMMPS as the reference." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-liq2-lj-sandberg2026 a mlips:TrainingDataset ;
    rdfs:label "Liquid 2 data set for LJ (250 snapshots, ramp to evaporation)" ;
    mlips:coversMaterial entity:mat-lj-sandberg2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 250 ;
    mlips:hasReferenceCalculation entity:calc-ref-lj-sandberg2026 .

entity:ds-liq2-eam-sandberg2026 a mlips:TrainingDataset ;
    rdfs:label "Liquid 2 data set for EAM (250 snapshots, ramp to evaporation)" ;
    mlips:coversMaterial entity:mat-eam-sandberg2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 250 ;
    mlips:hasReferenceCalculation entity:calc-ref-eam-sandberg2026 .

entity:ds-liq2-sw-sandberg2026 a mlips:TrainingDataset ;
    rdfs:label "Liquid 2 data set for SW (250 snapshots, ramp to evaporation)" ;
    mlips:coversMaterial entity:mat-sw-sandberg2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 250 ;
    mlips:hasReferenceCalculation entity:calc-ref-sw-sandberg2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-liq2-lj-sandberg2026 mlips:samplingStrategy
    entity:sampling-md-sandberg2026 .

entity:ds-liq2-eam-sandberg2026 mlips:samplingStrategy
    entity:sampling-md-sandberg2026 .

entity:ds-liq2-sw-sandberg2026 mlips:samplingStrategy
    entity:sampling-md-sandberg2026 .

entity:sampling-md-sandberg2026 a mlips:SamplingStrategy ;
    rdfs:label "LAMMPS NPT MD of 64 atoms: equilibration at T0, then a temperature ramp to T1 with 250 snapshots every 4,000 steps (Table I)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-sandberg2026 ;
    mlips:hasHyperparameter mlips:bodyOrder ;
    mlips:hasImplementation entity:impl-ACE-sandberg2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-ACE-sandberg2026 a mlips:LossFunction ;
    rdfs:label "Linear ridge regression" .

entity:impl-ACE-sandberg2026 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasImplementation entity:impl-HDNNP-sandberg2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-HDNNP-sandberg2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-sandberg2026 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:numFeatures ;
    mlips:hasImplementation entity:impl-MACE-sandberg2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-sandberg2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:lib-n2p2-sandberg2026 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ace-lj-bodyOrder-sandberg2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-mace-lj-numFeatures-sandberg2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-ace-eam-bodyOrder-sandberg2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-mace-eam-numFeatures-sandberg2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-ace-sw-bodyOrder-sandberg2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-mace-sw-numFeatures-sandberg2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ace-lj-sandberg2026 a mlips:MLIPRun ;
    rdfs:label "Linear ACE (body order 6) trained on the LJ Liquid 2 data" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-liq2-lj-sandberg2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-lj-bodyOrder-sandberg2026 ;
    mlips:produces entity:model-ace-lj-sandberg2026 .

entity:model-ace-lj-sandberg2026 a mlips:TrainedModel ;
    rdfs:label "linear ACE LJ Liquid 2" .

entity:run-hdnnp-lj-sandberg2026 a mlips:MLIPRun ;
    rdfs:label "HDNNP (two hidden layers of 10 neurons; 10 radial and 12 angular SFs) trained on the LJ Liquid 2 data" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-liq2-lj-sandberg2026 ;
    mlips:produces entity:model-hdnnp-lj-sandberg2026 .

