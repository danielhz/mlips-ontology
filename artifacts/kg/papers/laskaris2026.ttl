###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-aspirin-laskaris2026 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule (rMD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-benzene-laskaris2026 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule (rMD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-QM9-laskaris2026 a mlips:MaterialSystem ;
    rdfs:label "QM9 small organic molecules" ;
    mlips:materialClass "Small organic molecules, equilibrium geometries" .

entity:mat-CuLi-laskaris2026 a mlips:MaterialSystem ;
    rdfs:label "Cu-Li interface structures" ;
    mlips:chemicalFormula "Cu-Li" ;
    mlips:materialClass "Metal-metal interface (AIMD melt-quench configurations)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-culi-dft-laskaris2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-culi-dft-laskaris2026 mlips:hasDFTSettings entity:calc-settings-culi-dft-laskaris2026 .

entity:calc-settings-culi-dft-laskaris2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-laskaris2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred Monkhorst-Pack meshes with a minimum density of 32 per A^-1" ;
    rdfs:comment "Convergence to 1e-5 eV in energy and 0.03 eV/A in forces; AIMD in the NVT ensemble with a 2 fs time step." .

entity:xc-r2SCAN-laskaris2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    rdfs:comment "Regularised-restored SCAN meta-GGA." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aspirin-laskaris2026 a mlips:TrainingDataset ;
    rdfs:label "rMD17 aspirin" ;
    mlips:coversMaterial entity:mat-aspirin-laskaris2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-benzene-laskaris2026 a mlips:TrainingDataset ;
    rdfs:label "rMD17 benzene" ;
    mlips:coversMaterial entity:mat-benzene-laskaris2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-QM9-laskaris2026 a mlips:TrainingDataset ;
    rdfs:label "QM9" ;
    mlips:coversMaterial entity:mat-QM9-laskaris2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published .

entity:ds-CuLi-laskaris2026 a mlips:TrainingDataset ;
    rdfs:label "Cu-Li interface data set (11,000 structures)" ;
    mlips:coversMaterial entity:mat-CuLi-laskaris2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 11000 ;
    mlips:hasDFTCalculation entity:calc-culi-dft-laskaris2026 ;
    rdfs:comment "Generated with an industrial partner; available on request only." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-aspirin-laskaris2026 mlips:samplingStrategy
    entity:sampling-public-benchmark-laskaris2026 .

entity:ds-benzene-laskaris2026 mlips:samplingStrategy
    entity:sampling-public-benchmark-laskaris2026 .

entity:ds-QM9-laskaris2026 mlips:samplingStrategy
    entity:sampling-public-benchmark-laskaris2026 .

entity:ds-CuLi-laskaris2026 mlips:samplingStrategy
    entity:sampling-culi-aimd-laskaris2026 .

entity:sampling-public-benchmark-laskaris2026 a mlips:SamplingStrategy ;
    rdfs:label "Public benchmark data (rMD17, QM9)" .

entity:sampling-culi-aimd-laskaris2026 a mlips:SamplingStrategy ;
    rdfs:label "AIMD of Cu-Li interfaces" ;
    rdfs:comment "NVT AIMD (Nose-Hoover), including quenching at 250 K/ps; the interfacial data form the bulk of the 11,000 distinct structures." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-laskaris2026 ;
    mlips:hasHyperparameter entity:hp-variant-laskaris2026 ,
        mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numLayers .

entity:alg-Allegro-laskaris2026 a mls:Algorithm ;
    rdfs:label "Hyperparameters by multi-objective surrogate-assisted optimisation (SAMO-COBRA; 100 generations with 12 offspring, 1200 evaluations per variant and data set)" .

entity:hp-variant-laskaris2026 a mlips:Hyperparameter ;
    rdfs:label "Allegro variant (baseline, +MLP, +QDI quantum layer)" ;
    mlips:hyperparameterName "variant" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

