# Canonical Turtle for the protocol-derived encoding of:
#   Jesper Byggmästar et al. (2022). Multiscale machine-learning interatomic potentials for ferromagnetic and liquid iron.
#   Journal of Physics Condensed Matter. doi:10.1088/1361-648x/ac6f39  arXiv:2201.10237v1
#
# Version read: arxiv-preprint arXiv:2201.10237v1 (sha256 f261951df2ef10c4...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 623 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/byggmastar2022multiscale.yaml.
#
# Encoding scope: the four iron potentials of the paper, trained on the
# same 1078-structure PBE data set: the tabulated low-dimensional GAPs
# tabGAP-EAM, tabGAP-3b and tabGAP (2b+3b+EAM) and the GAP-SOAP. Energy
# and force errors are given only in figures or approximately, so there
# are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-byggmastar2022multiscale a mlips:BenchmarkStudy ;
    rdfs:label "Byggmästar et al. (2022): multiscale machine-learning potentials (tabGAP-EAM, tabGAP-3b, tabGAP, GAP-SOAP) for ferromagnetic and liquid iron" ;
    mlips:reportedIn entity:article-byggmastar2022multiscale .

entity:article-byggmastar2022multiscale a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1361-648x/ac6f39> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Multiscale machine-learning interatomic potentials for ferromagnetic and liquid iron" ;
    schema:author <https://orcid.org/0000-0002-4898-6150> ,
        entity:person-Nikoulis-byggmastar2022multiscale ,
        entity:person-Fellman-byggmastar2022multiscale ,
