###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-fe-byggmastar2022multiscale a mlips:MaterialSystem ;
    rdfs:label "Ferromagnetic bcc and liquid iron with vacancies, interstitial clusters, dislocations, surfaces and short-range repulsion" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "bcc transition metal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-byggmastar2022multiscale a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-byggmastar2022multiscale mlips:hasDFTSettings entity:calc-settings-pbe-byggmastar2022multiscale .

entity:calc-settings-pbe-byggmastar2022multiscale a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred Monkhorst-Pack, spacing at most 0.15 1/A" ;
    rdfs:comment "Fe_sv PAW (16 valence electrons); 0.1 eV Methfessel-Paxton smearing; collinear spin-polarised (ferromagnetic)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fe-byggmastar2022multiscale a mlips:TrainingDataset ;
    rdfs:label "Iron training set (1078 structures, 38,613 atoms) with a separate crystalline/liquid test set" ;
    mlips:coversMaterial entity:mat-fe-byggmastar2022multiscale ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1078 ;
    mlips:hasDFTCalculation entity:calc-pbe-byggmastar2022multiscale .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-fe-byggmastar2022multiscale mlips:samplingStrategy
    entity:sampling-mixed-byggmastar2022multiscale .

entity:sampling-mixed-byggmastar2022multiscale a mlips:SamplingStrategy ;
    rdfs:label "Distorted bcc cells, finite-temperature bulk, vacancy and SIA clusters, dislocation loops and lines, surfaces, gamma-surfaces, short-range interstitials and liquids at chi-squared-distributed densities; some generated with early GAP/tabGAP versions" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-tabGAP-byggmastar2022multiscale ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-tabGAP-byggmastar2022multiscale ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:alg-tabGAP-byggmastar2022multiscale a mls:Algorithm ;
    rdfs:label "Low-dimensional GAPs (repulsive + 2-body, EAM-like embedding, 3-body) tabulated onto 1D and 3D cubic splines; pair style tabgap with eam/fs in LAMMPS" .

entity:impl-tabGAP-byggmastar2022multiscale a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-byggmastar2022multiscale ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-byggmastar2022multiscale ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:alg-GAP-byggmastar2022multiscale a mls:Algorithm ;
    rdfs:label "SOAP descriptor with repulsive and machine-learned pair potentials" .

entity:impl-GAP-byggmastar2022multiscale a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-tabgap-eam-cutoffRadius-byggmastar2022multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-tabgap-3b-cutoffRadius-byggmastar2022multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-tabgap-cutoffRadius-byggmastar2022multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-gap-soap-cutoffRadius-byggmastar2022multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-gap-soap-numSparseConfigs-byggmastar2022multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "3000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-tabgap-eam-byggmastar2022multiscale a mlips:MLIPRun ;
    rdfs:label "tabGAP-EAM (repulsion + 2-body + EAM embedding, tabulated)" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-fe-byggmastar2022multiscale ;
    mlips:hasHyperparameterSetting entity:setting-tabgap-eam-cutoffRadius-byggmastar2022multiscale ;
    mlips:produces entity:model-tabgap-eam-byggmastar2022multiscale .

entity:model-tabgap-eam-byggmastar2022multiscale a mlips:TrainedModel ;
    rdfs:label "tabGAP-EAM Fe" .

entity:run-tabgap-3b-byggmastar2022multiscale a mlips:MLIPRun ;
    rdfs:label "tabGAP-3b (repulsion + 2-body + 3-body, tabulated)" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-fe-byggmastar2022multiscale ;
    mlips:hasHyperparameterSetting entity:setting-tabgap-3b-cutoffRadius-byggmastar2022multiscale ;
    mlips:produces entity:model-tabgap-3b-byggmastar2022multiscale .

entity:model-tabgap-3b-byggmastar2022multiscale a mlips:TrainedModel ;
    rdfs:label "tabGAP-3b Fe" .

entity:run-tabgap-byggmastar2022multiscale a mlips:MLIPRun ;
    rdfs:label "tabGAP (repulsion + 2-body + 3-body + EAM embedding, tabulated)" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-fe-byggmastar2022multiscale ;
    mlips:hasHyperparameterSetting entity:setting-tabgap-cutoffRadius-byggmastar2022multiscale ;
    mlips:produces entity:model-tabgap-byggmastar2022multiscale .

entity:model-tabgap-byggmastar2022multiscale a mlips:TrainedModel ;
    rdfs:label "tabGAP Fe (2022)" .

entity:run-gap-soap-byggmastar2022multiscale a mlips:MLIPRun ;
    rdfs:label "GAP-SOAP (repulsion + 2-body + SOAP)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-fe-byggmastar2022multiscale ;
    mlips:hasHyperparameterSetting entity:setting-gap-soap-cutoffRadius-byggmastar2022multiscale ,
        entity:setting-gap-soap-numSparseConfigs-byggmastar2022multiscale ;
    mlips:produces entity:model-gap-soap-byggmastar2022multiscale .

entity:model-gap-soap-byggmastar2022multiscale a mlips:TrainedModel ;
    rdfs:label "GAP-SOAP Fe (2022)" .

