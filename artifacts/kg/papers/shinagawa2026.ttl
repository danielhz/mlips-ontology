###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-expt-crystals-shinagawa2026 a mlips:MaterialSystem ;
    rdfs:label "1,100 crystals of the Kingsbury experimental formation-enthalpy set restricted to the 70 PFP-R2SCAN elements with Materials Project r2SCAN data" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-fcc-metals-shinagawa2026 a mlips:MaterialSystem ;
    rdfs:label "fcc (100), (110) and (111) surfaces of Al, Cu, Ru, Rh, Pd, Ag, Pt and Au (30-layer slabs)" ;
    mlips:materialClass "Metal surfaces" .

entity:mat-pfp-domains-shinagawa2026 a mlips:MaterialSystem ;
    rdfs:label "Molecules, bulk crystals, slabs, disordered high-temperature structures, clusters and adsorption structures over up to 96 elements" ;
    mlips:materialClass "Universal (molecules and materials)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scan-shinagawa2026 a mlips:DFTCalculation .

entity:calc-pbe-u-shinagawa2026 a mlips:DFTCalculation .

entity:calc-wb97xd-shinagawa2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scan-shinagawa2026 mlips:hasDFTSettings entity:calc-settings-r2scan-shinagawa2026 .

entity:calc-settings-r2scan-shinagawa2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-shinagawa2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "680"^^xsd:double ;
    mlips:kPointMesh "KSPACING = 0.22" ;
    rdfs:comment "VASP 6.4.3 (GPU), PBE_64 PAW set, collinear spin-polarised with several initial magnetic orderings (lowest energy kept), no Hubbard U, Gaussian smearing 0.05 eV, EDIFF 1e-6, ALGO All (Table S1)." .

entity:calc-pbe-u-shinagawa2026 mlips:hasDFTSettings entity:calc-settings-pbe-u-shinagawa2026 .

entity:calc-settings-pbe-u-shinagawa2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "1000 k-points per reciprocal atom" ;
    rdfs:comment "PFP-PBE+U with Hubbard U and PFP-PBE without; PBE_54 PAW set, EDIFF 1e-4 (Table S1; Ref. [26])." .

entity:calc-wb97xd-shinagawa2026 mlips:hasDFTSettings entity:calc-settings-wb97xd-shinagawa2026 .

entity:calc-settings-wb97xd-shinagawa2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-wB97X-D-shinagawa2026 ;
    rdfs:comment "PFP-WB97XD molecular data set (Ref. [26])." .

entity:xc-r2SCAN-shinagawa2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-wB97X-D-shinagawa2026 a mlips:XCFunctional ;
    rdfs:label "wB97X-D" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

