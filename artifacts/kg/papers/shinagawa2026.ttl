###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:TeaNet a mlips:MLIPMethod ;
    rdfs:label "TeaNet (tensor embedded atom network)" ;
    mlips:hasFunctionalForm entity:ff-TeaNet ;
    mlips:hasLossFunction entity:loss-TeaNet-shinagawa2026 ;
    mlips:hasImplementation entity:impl-TeaNet-shinagawa2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:ff-TeaNet a mlips:FunctionalForm ;
    rdfs:label "Graph convolutional network whose message passing carries scalar, vector and rank-2 tensor values on atoms and bonds, motivated by rewriting the embedded-atom and bond-order (Tersoff-type) potentials as graph convolutions and by iterative electronic relaxation; energies are sums of atomic contributions and forces come from backpropagation" .

entity:loss-TeaNet-shinagawa2026 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses with Bader charges as an auxiliary target; calculation-mode label embedded in the node features" .

entity:impl-TeaNet-shinagawa2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PFP-PFVM-shinagawa2026 .

entity:lib-PFP-PFVM-shinagawa2026 a mlips:Library ;
    rdfs:label "PFP / PFVM" ;
    rdfs:comment "Trained in PyTorch; inference with the proprietary PFVM engine (Matlantis) on NVIDIA GPUs" ;
    mlips:candidateForVocabulary mlips:Library .

