    mlips:coversMaterial entity:mat-pfp-domains-shinagawa2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97xd-shinagawa2026 .

entity:ds-oc20-shinagawa2026 a mlips:TrainingDataset ;
    rdfs:label "OC20 (about 1e8 structures, 56 elements; PBE)" ;
    mlips:coversMaterial entity:mat-pfp-domains-shinagawa2026 ;
    mlips:coversProperty mlips:Energy ,
