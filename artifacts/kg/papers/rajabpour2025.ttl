@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-rajabpour2025 a mlips:BenchmarkStudy ;
    rdfs:label "Rajabpour et al. (2025): interfacial thermal conductance between silicon and diamond with a passively fitted moment tensor potential" ;
