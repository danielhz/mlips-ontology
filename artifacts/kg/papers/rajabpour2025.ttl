###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sic-rajabpour2025 a mlips:MaterialSystem ;
    rdfs:label "Si/diamond (100) interface, pure diamond and pure silicon" ;
    mlips:materialClass "Elemental covalent solid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbesol-rajabpour2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbesol-rajabpour2025 mlips:hasDFTSettings entity:calc-settings-pbesol-rajabpour2025 .

entity:calc-settings-pbesol-rajabpour2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBEsol-rajabpour2025 ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "2x2x2 Monkhorst-Pack" ;
    rdfs:comment "AIMD of 96-atom heterostructure (40 Si, 56 C), 144-atom diamond and 64-atom silicon cells, 3,000 steps each, 1-2000 K (Sec. 2)." .

entity:xc-PBEsol-rajabpour2025 a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aimd-rajabpour2025 a mlips:TrainingDataset ;
    rdfs:label "Si/diamond AIMD pool" ;
    mlips:coversMaterial entity:mat-sic-rajabpour2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 9000 ;
    mlips:hasDFTCalculation entity:calc-pbesol-rajabpour2025 .

entity:ds-final-rajabpour2025 a mlips:TrainingDataset ;
    rdfs:label "Final MTP training set (800 initial configurations plus high-extrapolation-grade additions)" ;
    mlips:coversMaterial entity:mat-sic-rajabpour2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbesol-rajabpour2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-final-rajabpour2025 mlips:samplingStrategy
    entity:sampling-passive-rajabpour2025 .

entity:sampling-passive-rajabpour2025 a mlips:SamplingStrategy ;
    rdfs:label "Two-step passive fitting: 800 configurations from the 9,000-configuration AIMD pool, then the highest-extrapolation-grade configurations added" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-MTP-rajabpour2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MTP-rajabpour2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-cutoffRadius-rajabpour2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-rajabpour2025 a mlips:MLIPRun ;
    rdfs:label "Final MTP for Si/diamond (409 parameters)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-final-rajabpour2025 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-cutoffRadius-rajabpour2025 ;
    mlips:produces entity:model-mtp-rajabpour2025 .

entity:model-mtp-rajabpour2025 a mlips:TrainedModel ;
    rdfs:label "Si/diamond MTP (Rajabpour 2025)" .

