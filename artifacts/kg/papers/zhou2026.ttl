# Canonical Turtle for the protocol-derived encoding of:
#   Yuanchang Zhou et al. (2026). MatRIS: Toward Reliable and Efficient Pretrained Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2603.02002  arXiv:2603.02002v3
#
# Version read: arxiv-preprint arXiv:2603.02002v3 (sha256 d47070b2e356163f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 133 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the MatRIS architecture (introduced here) and the six
# pretrained variants whose hyperparameters Table 12 lists: three sizes
# trained on MPTrj, MatRIS-OAM (OMat24, fine-tuned on sAlex + MPTrj), a
# molecular model trained on SPICE-MACE-OFF23, and a MatPES model.
# Benchmark results are spread over a dozen tables (Matbench Discovery,
# MatCalc, phonons, molecular zero-shot, LAMBench, zeolites); none is
# encoded, see the gaps. Preprint only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhou2026 a mlips:BenchmarkStudy ;
    rdfs:label "Zhou et al. (2026): MatRIS, toward reliable and efficient pretrained MLIPs" ;
    mlips:reportedIn entity:article-zhou2026 .

entity:article-zhou2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2603.02002> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "MatRIS: Toward Reliable and Efficient Pretrained Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Zhou-zhou2026 ,
        entity:person-Hu-zhou2026 ,
        entity:person-Zhang-zhou2026 ,
        entity:person-Wang-zhou2026 ,
        entity:person-Tan-zhou2026 ,
        entity:person-Jia-zhou2026 .

entity:person-Zhou-zhou2026 a schema:Person ;
    schema:name "Yuanchang Zhou" ;
    schema:givenName "Yuanchang" ;
    schema:familyName "Zhou" .

entity:person-Hu-zhou2026 a schema:Person ;
    schema:name "Siyu Hu" ;
    schema:givenName "Siyu" ;
    schema:familyName "Hu" .

entity:person-Zhang-zhou2026 a schema:Person ;
    schema:name "Xiangyu Zhang" ;
    schema:givenName "Xiangyu" ;
    schema:familyName "Zhang" .

entity:person-Wang-zhou2026 a schema:Person ;
    schema:name "Hongyu Wang" ;
    schema:givenName "Hongyu" ;
    schema:familyName "Wang" .

entity:person-Tan-zhou2026 a schema:Person ;
    schema:name "Guangming Tan" ;
    schema:givenName "Guangming" ;
    schema:familyName "Tan" .

entity:person-Jia-zhou2026 a schema:Person ;
    schema:name "Weile Jia" ;
    schema:givenName "Weile" ;
    schema:familyName "Jia" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-inorganic-zhou2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals of MPTrj, OMat24, sAlex and MatPES" ;
    mlips:materialClass "Universal inorganic materials" .

entity:mat-organic-zhou2026 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules of SPICE-MACE-OFF23" ;
    mlips:materialClass "Organic molecules and molecular clusters" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-spice-dft-zhou2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-spice-dft-zhou2026 mlips:hasDFTSettings entity:calc-settings-spice-dft-zhou2026 .

entity:calc-settings-spice-dft-zhou2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-omegaB97M-D3-BJ-zhou2026 ;
    mlips:dftBasisSet entity:basis-def2-TZVPPD-zhou2026 ;
    rdfs:comment "Level of the SPICE-MACE-OFF23 data (the training set of kovacs2025)." .

entity:xc-omegaB97M-D3-BJ-zhou2026 a mlips:XCFunctional ;
    rdfs:label "omegaB97M-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-def2-TZVPPD-zhou2026 a mlips:DftBasisSet ;
    rdfs:label "def2-TZVPPD" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mptrj-zhou2026 a mlips:TrainingDataset ;
    rdfs:label "MPTrj" ;
    mlips:coversMaterial entity:mat-inorganic-zhou2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

entity:ds-oam-zhou2026 a mlips:TrainingDataset ;
    rdfs:label "OMat24, then sAlex + MPTrj for fine-tuning" ;
    mlips:coversMaterial entity:mat-inorganic-zhou2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

entity:ds-matpes-zhou2026 a mlips:TrainingDataset ;
    rdfs:label "MatPES (1.4M)" ;
    mlips:coversMaterial entity:mat-inorganic-zhou2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

entity:ds-spice-zhou2026 a mlips:TrainingDataset ;
    rdfs:label "SPICE-MACE-OFF23 (951,005 small-molecule configurations)" ;
    mlips:coversMaterial entity:mat-organic-zhou2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 951005 ;
    mlips:hasDFTCalculation entity:calc-spice-dft-zhou2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mptrj-zhou2026 mlips:samplingStrategy
    entity:sampling-published-zhou2026 .

entity:ds-oam-zhou2026 mlips:samplingStrategy
    entity:sampling-published-zhou2026 .

entity:ds-matpes-zhou2026 mlips:samplingStrategy
    entity:sampling-published-zhou2026 .

entity:ds-spice-zhou2026 mlips:samplingStrategy
    entity:sampling-published-zhou2026 .

entity:sampling-published-zhou2026 a mlips:SamplingStrategy ;
    rdfs:label "Published pretraining data sets used as provided" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MatRIS a mlips:MLIPMethod ;
    rdfs:label "MatRIS (invariant graph-attention interatomic potential with three-body features)" ;
    mlips:hasLossFunction entity:loss-MatRIS-zhou2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MatRIS-zhou2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:cutoffRadius ,
        entity:hp-three-body-cutoff-zhou2026 ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs .

entity:loss-MatRIS-zhou2026 a mlips:LossFunction ;
    rdfs:label "Huber (delta = 0.01), MAE or L2-MAE loss depending on the variant, with prefactors 5 (energy), 5 (force), 0.1 (stress) and 0.1 (magnetic moment)" .

entity:alg-MatRIS-zhou2026 a mls:Algorithm ;
    rdfs:label "AdamW (Adam for MatPES) with cosine learning-rate schedule down to 1% of the maximum; gradient clipping 0.5; denoising pretraining for the MPTrj-M and MPTrj-L variants" .

entity:hp-three-body-cutoff-zhou2026 a mlips:Hyperparameter ;
    rdfs:label "MatRIS three-body cutoff (Angstrom)" ;
    mlips:hyperparameterName "three_body_cutoff" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

