###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-fe-c-meng2024 a mlips:MaterialSystem ;
    rdfs:label "alpha-Fe with C (vacancies, grain boundaries, screw dislocations), cementite and other carbides, ferrite-cementite interfaces" ;
    mlips:materialClass "Iron-carbon alloys and carbides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-meng2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-meng2024 mlips:hasDFTSettings entity:calc-settings-dft-meng2024 .

entity:calc-settings-dft-meng2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Spin-polarised DFT; settings in Supplementary Table S2 (not restated in the main text)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fe-c-meng2024 a mlips:TrainingDataset ;
    rdfs:label "Fe-C database (32,002 configurations, 2.78e6 atomic environments; 90% training, 10% testing)" ;
    mlips:coversMaterial entity:mat-fe-c-meng2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 32002 ;
    mlips:hasDFTCalculation entity:calc-dft-meng2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-meng2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-HDNNP-meng2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-HDNNP-meng2024 a mlips:LossFunction ;
    rdfs:label "Energies and forces (no virials)" .

entity:impl-HDNNP-meng2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-meng2024 .

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-meng2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-DeePMD-meng2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-DeePMD-meng2024 a mlips:LossFunction ;
    rdfs:label "Energies and forces (no virials)" .

entity:impl-DeePMD-meng2024 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:lib-n2p2-meng2024 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-bnnp-cutoffRadius-meng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-bnnp-angularCutoff-meng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-bnnp-numLayers-meng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-dp-cutoffRadius-meng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-dp-angularCutoff-meng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "5.6"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-bnnp-meng2024 a mlips:MLIPRun ;
    rdfs:label "BNNP for Fe-C (16 radial and 60 angular ACSFs per element, 2 x 15 hidden neurons)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-fe-c-meng2024 ;
    mlips:hasHyperparameterSetting entity:setting-bnnp-cutoffRadius-meng2024 ,
        entity:setting-bnnp-angularCutoff-meng2024 ,
        entity:setting-bnnp-numLayers-meng2024 ;
    mlips:produces entity:model-bnnp-meng2024 .

entity:model-bnnp-meng2024 a mlips:TrainedModel ;
    rdfs:label "Fe-C BNNP" .

entity:run-dp-meng2024 a mlips:MLIPRun ;
    rdfs:label "Deep Potential for Fe-C (se_e2_a + se_e3 hybrid descriptor)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-fe-c-meng2024 ;
    mlips:hasHyperparameterSetting entity:setting-dp-cutoffRadius-meng2024 ,
        entity:setting-dp-angularCutoff-meng2024 ;
    mlips:produces entity:model-dp-meng2024 .

entity:model-dp-meng2024 a mlips:TrainedModel ;
    rdfs:label "Fe-C DP" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-meng2024 mlips:hasResult
    entity:result-bnnp-train-meng2024 ,
    entity:result-bnnp-test-meng2024 ,
    entity:result-dp-train-meng2024 ,
    entity:result-dp-test-meng2024 .

entity:result-bnnp-train-meng2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-bnnp-meng2024 ;
    mlips:targetMaterial entity:mat-fe-c-meng2024 ;
    mlips:hasAccuracyMetric entity:metric-bnnp-train-1-meng2024 ,
        entity:metric-bnnp-train-2-meng2024 .

entity:metric-bnnp-train-1-meng2024 a mlips:AccuracyMetric ;
    rdfs:label "Training energy RMSE: Fe-C BNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.58"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-bnnp-train-2-meng2024 a mlips:AccuracyMetric ;
    rdfs:label "Training force RMSE: Fe-C BNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "83"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-bnnp-test-meng2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-bnnp-meng2024 ;
    mlips:targetMaterial entity:mat-fe-c-meng2024 ;
    mlips:hasAccuracyMetric entity:metric-bnnp-test-1-meng2024 ,
        entity:metric-bnnp-test-2-meng2024 ;
    mlips:inferenceTimePerAtom "27.38"^^xsd:double ;
    mlips:inferenceHardware "2 Intel Xeon Gold 6150 CPUs (36 cores): 27.38 us/atom/step (BNNP)" .

entity:metric-bnnp-test-1-meng2024 a mlips:AccuracyMetric ;
    rdfs:label "Test energy RMSE: Fe-C BNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.57"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-bnnp-test-2-meng2024 a mlips:AccuracyMetric ;
    rdfs:label "Test force RMSE: Fe-C BNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "83.2"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-dp-train-meng2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-dp-meng2024 ;
    mlips:targetMaterial entity:mat-fe-c-meng2024 ;
    mlips:hasAccuracyMetric entity:metric-dp-train-1-meng2024 ,
        entity:metric-dp-train-2-meng2024 .

entity:metric-dp-train-1-meng2024 a mlips:AccuracyMetric ;
    rdfs:label "Training energy RMSE: Fe-C DP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "4.71"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-dp-train-2-meng2024 a mlips:AccuracyMetric ;
