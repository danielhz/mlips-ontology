    rdfs:label "Salicylic acid molecule" ;
    mlips:materialClass "Small organic molecule (gas phase), AIMD conformations" .

entity:mat-malonaldehyde-chmiela2017 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule" ;
