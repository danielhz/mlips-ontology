# Q2 -- Material system
###############################################################################

entity:mat-benzene-chmiela2017 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule" ;
    mlips:materialClass "Small organic molecule (gas phase), AIMD conformations" .

entity:mat-uracil-chmiela2017 a mlips:MaterialSystem ;
    rdfs:label "Uracil molecule" ;
    mlips:materialClass "Small organic molecule (gas phase), AIMD conformations" .

