###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-benzene-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:ds-uracil-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:ds-naphthalene-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:ds-aspirin-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:ds-salicylic-acid-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:ds-malonaldehyde-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:ds-ethanol-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:ds-toluene-chmiela2017 mlips:samplingStrategy
    entity:sampling-aimd-energy-uniform-chmiela2017 .

entity:sampling-aimd-energy-uniform-chmiela2017 a mlips:SamplingStrategy ;
    rdfs:label "Ab initio MD with sampling uniform in the trajectory energy distribution" ;
    rdfs:comment "Trajectories of 150 k to nearly 1 M conformations at 0.5 fs resolution; about 1000 geometries per molecule are drawn uniformly according to the energy distribution of the MD@DFT trajectory." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GDML a mlips:MLIPMethod ;
    rdfs:label "Gradient-Domain Machine Learning (GDML)" ;
    mlips:hasTrainingAlgorithm entity:alg-GDML-chmiela2017 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-GDML-chmiela2017 a mls:Algorithm ;
    rdfs:label "Kernel ridge regression in the gradient domain: the force field is learned directly as a conservative vector field, with hyperparameters selected per data set and errors estimated by cross-validation" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

