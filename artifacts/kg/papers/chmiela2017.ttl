###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-chmiela2017 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-chmiela2017 mlips:hasDFTSettings entity:calc-settings-dft-chmiela2017 .

entity:calc-settings-dft-chmiela2017 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE-vdW-TS-chmiela2017 ;
    rdfs:comment "Total energies and forces of the AIMD trajectories (resolution 0.5 fs); code and basis are not given in the main text." .

entity:xc-PBE-vdW-TS-chmiela2017 a mlips:XCFunctional ;
    rdfs:label "PBE+vdW-TS" ;
    rdfs:comment "PBE with Tkatchenko-Scheffler van der Waals correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-benzene-chmiela2017 a mlips:TrainingDataset ;
    rdfs:label "GDML training set for benzene (about 1000 geometries)" ;
    mlips:coversMaterial entity:mat-benzene-chmiela2017 ;
    mlips:coversProperty mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-dft-chmiela2017 ;
    rdfs:comment "The paper gives the size as '~1000 geometries'. GDML is trained on forces; energies are recovered by integration." .

