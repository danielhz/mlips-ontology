# Canonical Turtle for the protocol-derived encoding of:
#   Stefan Chmiela et al. (2017). Machine learning of accurate energy-conserving molecular force fields.
#   Science Advances. doi:10.1126/sciadv.1603015  arXiv:1611.04678v4
#
# Version read: arxiv-preprint arXiv:1611.04678v4 (sha256 94e25dae2e9b364c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 47 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the gradient-domain machine learning (GDML) method,
# introduced here, and its eight molecular force fields trained on about
# 1000 geometries each from ab initio MD trajectories (the data later
# known as MD17). The per-molecule errors are in the supplementary
# tables, which are not part of the PDF read.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-chmiela2017 a mlips:BenchmarkStudy ;
    rdfs:label "Chmiela et al. (2017): machine learning of accurate energy-conserving molecular force fields (GDML)" ;
    mlips:reportedIn entity:article-chmiela2017 .

entity:article-chmiela2017 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1126/sciadv.1603015> ;
    schema:datePublished "2017"^^xsd:gYear ;
    schema:name "Machine learning of accurate energy-conserving molecular force fields" ;
    schema:author entity:person-Chmiela-chmiela2017 ,
        <https://orcid.org/0000-0002-1012-4854> ,
        <https://orcid.org/0000-0001-6091-3408> ,
        entity:person-Poltavsky-chmiela2017 ,
        <https://orcid.org/0000-0001-8342-0964> ,
        entity:person-Muller-chmiela2017 .

entity:person-Chmiela-chmiela2017 a schema:Person ;
    schema:name "Stefan Chmiela" ;
    schema:givenName "Stefan" ;
    schema:familyName "Chmiela" .

<https://orcid.org/0000-0002-1012-4854> a schema:Person ;
    schema:name "Alexandre Tkatchenko" ;
    schema:givenName "Alexandre" ;
    schema:familyName "Tkatchenko" ;
    schema:identifier <https://orcid.org/0000-0002-1012-4854> .

<https://orcid.org/0000-0001-6091-3408> a schema:Person ;
    schema:name "Huziel E. Sauceda" ;
    schema:givenName "Huziel E." ;
    schema:familyName "Sauceda" ;
    schema:identifier <https://orcid.org/0000-0001-6091-3408> .

entity:person-Poltavsky-chmiela2017 a schema:Person ;
    schema:name "Igor Poltavsky" ;
    schema:givenName "Igor" ;
    schema:familyName "Poltavsky" .

<https://orcid.org/0000-0001-8342-0964> a schema:Person ;
    schema:name "Kristof T. Schütt" ;
    schema:givenName "Kristof T." ;
    schema:familyName "Schütt" ;
    schema:identifier <https://orcid.org/0000-0001-8342-0964> .

entity:person-Muller-chmiela2017 a schema:Person ;
    schema:name "Klaus-Robert Müller" ;
    schema:givenName "Klaus-Robert" ;
    schema:familyName "Müller" .

