# Canonical Turtle for the protocol-derived encoding of:
#   Nada M. Alghamdi et al. (2025). Comparing fine-tuning strategies of MACE machine learning force field for modeling Li-ion diffusion in LiF for batteries.
#   arXiv (Cornell University). doi:10.48550/arxiv.2510.05020  arXiv:2510.05020v2
#
# Version read: arxiv-preprint arXiv:2510.05020v2 (sha256 5e5b641ad557758a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 598 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/alghamdi2025.yaml.
#
# Encoding scope: MACE-MPA-0 as distributed and the MACE models fine-tuned
# from it, either on subsets of a published DeePMD active-learning LiF
# dataset with multi-head MPtrj replay, or naively on in-house
# configurations sampled from MACE-MPA-0 MD with committee active learning
# (FT1, FT2). The paper evaluates the models only through diffusivities
# and Arrhenius parameters of interstitial Li in LiF; it states no energy,
# force or stress errors, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-alghamdi2025 a mlips:BenchmarkStudy ;
    rdfs:label "Alghamdi et al. (2025): fine-tuning strategies of MACE-MPA-0 for Li-ion diffusion in LiF" ;
    mlips:reportedIn entity:article-alghamdi2025 .

entity:article-alghamdi2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2510.05020> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Comparing fine-tuning strategies of MACE machine learning force field for modeling Li-ion diffusion in LiF for batteries" ;
    schema:author entity:person-Alghamdi-alghamdi2025 ,
        entity:person-deAngelis-alghamdi2025 ,
        entity:person-Asinari-alghamdi2025 ,
        entity:person-Chiavazzo-alghamdi2025 .

entity:person-Alghamdi-alghamdi2025 a schema:Person ;
    schema:name "Nada Alghamdi" ;
    schema:givenName "Nada" ;
    schema:familyName "Alghamdi" .

entity:person-deAngelis-alghamdi2025 a schema:Person ;
    schema:name "Paolo de Angelis" ;
    schema:givenName "Paolo" ;
    schema:familyName "de Angelis" .

entity:person-Asinari-alghamdi2025 a schema:Person ;
    schema:name "Pietro Asinari" ;
    schema:givenName "Pietro" ;
    schema:familyName "Asinari" .

entity:person-Chiavazzo-alghamdi2025 a schema:Person ;
    schema:name "Eliodoro Chiavazzo" ;
    schema:givenName "Eliodoro" ;
    schema:familyName "Chiavazzo" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lif-alghamdi2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk LiF and interstitial Li in LiF" ;
    mlips:chemicalFormula "LiF" ;
    mlips:materialClass "ionic solid (battery SEI component)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-alghamdi2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-alghamdi2025 mlips:hasDFTSettings entity:calc-settings-pbe-alghamdi2025 .

entity:calc-settings-pbe-alghamdi2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "Gamma point only" ;
    rdfs:comment "Kinetic-energy cutoff 110 Ry, charge-density cutoff 440 Ry; Gaussian smearing 0.005 Ry; SCF 5e-7 Ry; same settings as the published DeePMD dataset (ref. 38)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-deepmd-800-alghamdi2025 a mlips:TrainingDataset ;
    rdfs:label "800-structure subset (100 bulk, 700 interstitial) of the DeePMD active-learning LiF dataset" ;
    mlips:coversMaterial entity:mat-lif-alghamdi2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 800 ;
    mlips:hasDFTCalculation entity:calc-pbe-alghamdi2025 .

entity:ds-ft1-alghamdi2025 a mlips:TrainingDataset ;
    rdfs:label "FT1 training set: MACE-MPA-0 MD samples plus two active-learning steps on interstitial Li" ;
    mlips:coversMaterial entity:mat-lif-alghamdi2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 156 ;
    mlips:hasDFTCalculation entity:calc-pbe-alghamdi2025 .

entity:ds-ft2-alghamdi2025 a mlips:TrainingDataset ;
    rdfs:label "FT2 training set: MACE-MPA-0 MD samples plus one active-learning step on bulk and interstitial configurations" ;
    mlips:coversMaterial entity:mat-lif-alghamdi2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 144 ;
    mlips:hasDFTCalculation entity:calc-pbe-alghamdi2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-deepmd-800-alghamdi2025 mlips:samplingStrategy
    entity:sampling-deepmd-al-alghamdi2025 .

entity:ds-ft1-alghamdi2025 mlips:samplingStrategy
    entity:sampling-mace-al-alghamdi2025 .

entity:ds-ft2-alghamdi2025 mlips:samplingStrategy
    entity:sampling-mace-al-alghamdi2025 .

entity:sampling-deepmd-al-alghamdi2025 a mlips:SamplingStrategy ;
    rdfs:label "DeePMD active-learning configurations of bulk LiF and interstitial Li (ref. 38)" .

entity:sampling-mace-al-alghamdi2025 a mlips:SamplingStrategy ;
    rdfs:label "MACE-MPA-0 NVT MD (300-600 K) sampling followed by committee active learning (four models; 1, 1.5 and 2 sigma force-disagreement bins)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-alghamdi2025 ;
    mlips:hasHyperparameter mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-MACE-alghamdi2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-alghamdi2025 a mlips:LossFunction ;
    rdfs:label "Weighted Huber loss on energies, forces (conditional Huber delta) and stresses; weights (1,10,1) for DeePMD-data fine-tuning and (1,1,10) for FT1/FT2" .

entity:impl-MACE-alghamdi2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ft-800-1000-numEpochs-alghamdi2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "800"^^xsd:integer .

entity:setting-ft-800-1000-batchSize-alghamdi2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-ft1-numEpochs-alghamdi2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "800"^^xsd:integer .

entity:setting-ft2-numEpochs-alghamdi2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "800"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mpa0-alghamdi2025 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mpa0-alghamdi2025 .

entity:model-mpa0-alghamdi2025 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-ft-800-1000-alghamdi2025 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 multi-head fine-tuned on 800 DeePMD structures with 1000 MPtrj replay structures" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-deepmd-800-alghamdi2025 ;
    mlips:hasHyperparameterSetting entity:setting-ft-800-1000-numEpochs-alghamdi2025 ,
        entity:setting-ft-800-1000-batchSize-alghamdi2025 ;
    mlips:trainingHardware "8 NVIDIA A100 GPUs; 4.5 h for 800 epochs (Sec. 3.2)" ;
    mlips:produces entity:model-ft-800-1000-alghamdi2025 .

entity:model-ft-800-1000-alghamdi2025 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0 FT (800 fine-tuning + 1000 MPtrj)" .

entity:run-ft1-alghamdi2025 a mlips:MLIPRun ;
    rdfs:label "FT1: MACE-MPA-0 naively fine-tuned on the FT1 set" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ft1-alghamdi2025 ;
    mlips:hasHyperparameterSetting entity:setting-ft1-numEpochs-alghamdi2025 ;
    mlips:produces entity:model-ft1-alghamdi2025 .

entity:model-ft1-alghamdi2025 a mlips:TrainedModel ;
    rdfs:label "FT1" .

entity:run-ft2-alghamdi2025 a mlips:MLIPRun ;
    rdfs:label "FT2: MACE-MPA-0 naively fine-tuned on the FT2 set" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ft2-alghamdi2025 ;
    mlips:hasHyperparameterSetting entity:setting-ft2-numEpochs-alghamdi2025 ;
    mlips:produces entity:model-ft2-alghamdi2025 .

entity:model-ft2-alghamdi2025 a mlips:TrainedModel ;
    rdfs:label "FT2" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No energy, force or stress errors are stated; models are compared through diffusivities (Fig. 3) and Arrhenius activation energies and prefactors (Table 3), which are property values.
# - Only one of the DeePMD-data fine-tuning variants (800 + 1000 MPtrj, the one with stated training time and batch size) is encoded as a run; the others (110-1600 fine-tuning structures with 0-10,000 MPtrj replay, Table 1) differ only in training-set size. The 10,000-replay cases ran 200 epochs.
# - MD cost is given only approximately ('approximately 0.24 seconds per step' on one A100), so no timing is encoded. MACE-MPA-0 has no registry row and is a paper-local run.
# - The MPtrj replay subsets are random selections from MPtrj; they are not encoded as separate data sets.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: datacite).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/alghamdi2025.yaml) until the schema has terms for them.
