###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mos2-faiyad2026 a mlips:MaterialSystem ;
    rdfs:label "Bulk MoS2 with one of 25 dopants (Ag, Al, Au, C, Cl, Cu, F, Fe, Ir, Li, N, Na, Nb, O, Pd, Pt, Re, Rh, Ru, Si, Ta, Te, Ti, V, Zn) at S-substitution, Mo-substitution or intercalated sites" ;
    mlips:chemicalFormula "MoS2" ;
    mlips:materialClass "Transition-metal dichalcogenides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qe-faiyad2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qe-faiyad2026 mlips:hasDFTSettings entity:calc-settings-qe-faiyad2026 .

entity:calc-settings-qe-faiyad2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "PSLibrary 1.0.0 PAW/USPP, spin-polarized, no SOC, 124/843 Ry, Fermi-Dirac smearing, fixed-cell BFGS to 5e-3 eV/A (Methods)." .

