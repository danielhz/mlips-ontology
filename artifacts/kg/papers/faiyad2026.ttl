@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-faiyad2026 a mlips:BenchmarkStudy ;
    rdfs:label "Faiyad and Martini (2026): UMA small and medium for 25 dopants in MoS2, formation-energy benchmark against DFT and heating-cooling MD" ;
    mlips:reportedIn entity:article-faiyad2026 .

entity:article-faiyad2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.5c02004> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Machine Learning Interatomic Potentials Enable Molecular Dynamics Simulations of Doped MoS 2" ;
    schema:author <https://orcid.org/0000-0001-5862-9619> ,
        <https://orcid.org/0000-0003-2017-6081> .

<https://orcid.org/0000-0001-5862-9619> a schema:Person ;
    schema:name "Abrar Faiyad" ;
    schema:givenName "Abrar" ;
    schema:familyName "Faiyad" ;
    schema:identifier <https://orcid.org/0000-0001-5862-9619> .

<https://orcid.org/0000-0003-2017-6081> a schema:Person ;
