###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-alli-menon2024 a mlips:MaterialSystem ;
    rdfs:label "Al-Li system: fcc Al, bcc Li and Al-Li binary phases, random and perturbed structures" ;
    mlips:materialClass "light-metal binary alloy" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-menon2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-menon2024 mlips:hasDFTSettings entity:calc-settings-pbe-menon2024 .

entity:calc-settings-pbe-menon2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "750"^^xsd:double ;
    mlips:kPointMesh "k-mesh spacing 0.1 1/A" ;
    rdfs:comment "VASP 5.4; Fermi smearing 0.1 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-hdnnp-set-menon2024 a mlips:TrainingDataset ;
    rdfs:label "HDNNP training data (50,834 structures after filtering; 90/10 split)" ;
    mlips:coversMaterial entity:mat-alli-menon2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 50834 ;
    mlips:hasDFTCalculation entity:calc-pbe-menon2024 .

entity:ds-ace-set-menon2024 a mlips:TrainingDataset ;
    rdfs:label "ACE training data (51,082 structures; 95/5 split)" ;
    mlips:coversMaterial entity:mat-alli-menon2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 51082 ;
    mlips:hasDFTCalculation entity:calc-pbe-menon2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-hdnnp-set-menon2024 mlips:samplingStrategy
    entity:sampling-pyiron-menon2024 .

entity:ds-ace-set-menon2024 mlips:samplingStrategy
    entity:sampling-pyiron-menon2024 .

entity:sampling-pyiron-menon2024 a mlips:SamplingStrategy ;
    rdfs:label "Domain-knowledge Materials Project prototypes with deformations and displacements, active learning during validation, and random structure search with relaxations and perturbations (pyiron workflows)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-menon2024 ;
    mlips:hasImplementation entity:impl-HDNNP-menon2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:ThermodynamicIntegration .

entity:alg-HDNNP-menon2024 a mls:Algorithm ;
    rdfs:label "Hyperparameters (ACSFs, cutoff, Kalman-filter settings) from a RuNNerASE grid search (SI Note 4)" .

entity:impl-HDNNP-menon2024 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-menon2024 ;
    mlips:hasImplementation entity:impl-ACE-menon2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:ThermodynamicIntegration .

entity:alg-ACE-menon2024 a mls:Algorithm ;
    rdfs:label "1000 basis functions per element, 7 A cutoff, energy weights by distance to the convex hull, core repulsion below 2 A" .

entity:impl-ACE-menon2024 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-hdnnp-menon2024 a mlips:MLIPRun ;
    rdfs:label "HDNNP for Al-Li" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-hdnnp-set-menon2024 ;
    mlips:produces entity:model-hdnnp-menon2024 .

entity:model-hdnnp-menon2024 a mlips:TrainedModel ;
    rdfs:label "HDNNP Al-Li (pyiron)" .

entity:run-ace-menon2024 a mlips:MLIPRun ;
    rdfs:label "ACE for Al-Li (1000 functions per element)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-ace-set-menon2024 ;
    mlips:produces entity:model-ace-menon2024 .

entity:model-ace-menon2024 a mlips:TrainedModel ;
    rdfs:label "ACE Al-Li (pyiron)" .

