    schema:givenName "Ben" ;
    schema:familyName "Xu" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-knbo3-thong2023 a mlips:MaterialSystem ;
    rdfs:label "KNbO3 perovskite (cubic, tetragonal, orthorhombic and rhombohedral phases)" ;
    mlips:chemicalFormula "KNbO3" ;
    mlips:materialClass "ferroelectric perovskite oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-thong2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-thong2023 mlips:hasDFTSettings entity:calc-settings-pbe-thong2023 .

entity:calc-settings-pbe-thong2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "900"^^xsd:double ;
    mlips:kPointMesh "k-point spacing 0.12" ;
    rdfs:comment "Energy convergence 1e-6 eV, force convergence 0.005 eV/A." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-dpgen-thong2023 a mlips:TrainingDataset ;
    rdfs:label "DP-GEN training set of KNbO3 configurations (roughly 10,000)" ;
    mlips:coversMaterial entity:mat-knbo3-thong2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-thong2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-dpgen-thong2023 mlips:samplingStrategy
    entity:sampling-dpgen-thong2023 .

entity:sampling-dpgen-thong2023 a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN concurrent learning: MD exploration at 0-800 K and 1-10000 kbar, labelling at force model deviation 0.12-0.30 eV/A, started from 20-atom cells of the four phases" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-thong2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-DeePMD-thong2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:alg-DeePMD-thong2023 a mls:Algorithm ;
    rdfs:label "DeePot-SE descriptor; embedding net (20, 40, 60), fitting net (120, 120, 120); smoothing cutoff 1.5 A" .

entity:impl-DeePMD-thong2023 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-cutoffRadius-thong2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "9"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-thong2023 a mlips:MLIPRun ;
    rdfs:label "DP model of KNbO3" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-dpgen-thong2023 ;
    mlips:hasHyperparameterSetting entity:setting-dp-cutoffRadius-thong2023 ;
    mlips:produces entity:model-dp-thong2023 .

entity:model-dp-thong2023 a mlips:TrainedModel ;
    rdfs:label "DP KNbO3" .

