# Canonical Turtle for the protocol-derived encoding of:
#   Alea Miako Tokita et al. (2023). How to train a neural network potential.
#   The Journal of Chemical Physics. doi:10.1063/5.0160326  arXiv:2308.08859v2
#
# Version read: arxiv-preprint arXiv:2308.08859v2 (sha256 780953fb3487260d...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 534 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/tokita2023.yaml.
#
# Encoding scope: the tutorial's case-study HDNNP (RuNNer) for one LiOH
# ion pair with 19-23 water molecules, PBE0r-D3 references (CP-PAW),
# built from 630 AIMD structures plus published pure-water structures
# and extended by active learning; the final training and test RMSEs.
# General guidance is not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-tokita2023 a mlips:BenchmarkStudy ;
    rdfs:label "Tokita and Behler (2023): how to train a neural network potential (tutorial), with a case study of a LiOH ion pair in water" ;
    mlips:reportedIn entity:article-tokita2023 .

entity:article-tokita2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0160326> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "How to train a neural network potential" ;
    schema:author <https://orcid.org/0009-0001-2697-8213> ,
        <https://orcid.org/0000-0002-1220-1542> .

<https://orcid.org/0009-0001-2697-8213> a schema:Person ;
    schema:name "Alea Miako Tokita" ;
    schema:givenName "Alea Miako" ;
    schema:familyName "Tokita" ;
    schema:identifier <https://orcid.org/0009-0001-2697-8213> .

<https://orcid.org/0000-0002-1220-1542> a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" ;
    schema:identifier <https://orcid.org/0000-0002-1220-1542> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lioh-tokita2023 a mlips:MaterialSystem ;
    rdfs:label "LiOH ion pair with 19-23 water molecules in periodic boxes (0.97-1.02 kg/dm3), plus pure water" ;
    mlips:materialClass "Molecular liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe0r-tokita2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe0r-tokita2023 mlips:hasDFTSettings entity:calc-settings-pbe0r-tokita2023 .

entity:calc-settings-pbe0r-tokita2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP-PAW-tokita2023 ;
    mlips:xcFunctional entity:xc-PBE0r-D3-BJ-tokita2023 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "2x2x2 for 8.2 A cubic cells" ;
    rdfs:comment "Local hybrid PBE0r with D3(BJ) dispersion" .

entity:lib-CP-PAW-tokita2023 a mlips:Library ;
    rdfs:label "CP-PAW" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE0r-D3-BJ-tokita2023 a mlips:XCFunctional ;
    rdfs:label "PBE0r-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-lioh-tokita2023 a mlips:TrainingDataset ;
    rdfs:label "LiOH-water data set after active learning (training split)" ;
    mlips:coversMaterial entity:mat-lioh-tokita2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe0r-tokita2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-lioh-tokita2023 mlips:samplingStrategy
    entity:sampling-aimd-tokita2023 .

entity:sampling-aimd-tokita2023 a mlips:SamplingStrategy ;
    rdfs:label "AIMD at 100-500 K from random packings (630 structures), published pure-water structures, then active-learning cycles" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-tokita2023 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-tokita2023 ;
    mlips:hasImplementation entity:impl-HDNNP-tokita2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-tokita2023 a mlips:LossFunction ;
    rdfs:label "Energies and forces" .

entity:alg-HDNNP-tokita2023 a mls:Algorithm ;
    rdfs:label "Global adaptive extended Kalman filter, early stopping on the test set" .

entity:impl-HDNNP-tokita2023 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-hdnnp-tokita2023 a mlips:MLIPRun ;
    rdfs:label "Most accurate HDNNP for the final LiOH-water data set" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-lioh-tokita2023 ;
    mlips:produces entity:model-hdnnp-tokita2023 .

entity:model-hdnnp-tokita2023 a mlips:TrainedModel ;
    rdfs:label "HDNNP LiOH in water (tutorial)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-tokita2023 mlips:hasResult
    entity:result-hdnnp-train-tokita2023 ,
    entity:result-hdnnp-test-tokita2023 .

entity:result-hdnnp-train-tokita2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-hdnnp-tokita2023 ;
    mlips:targetMaterial entity:mat-lioh-tokita2023 ;
    mlips:hasAccuracyMetric entity:metric-hdnnp-train-1-tokita2023 ,
        entity:metric-hdnnp-train-2-tokita2023 .

entity:metric-hdnnp-train-1-tokita2023 a mlips:AccuracyMetric ;
    rdfs:label "training energy RMSE on LiOH in water: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.204"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-hdnnp-train-2-tokita2023 a mlips:AccuracyMetric ;
    rdfs:label "training force-component RMSE (eV/bohr) on LiOH in water: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.069272"^^xsd:double .

entity:result-hdnnp-test-tokita2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-hdnnp-tokita2023 ;
    mlips:targetMaterial entity:mat-lioh-tokita2023 ;
    mlips:hasAccuracyMetric entity:metric-hdnnp-test-1-tokita2023 ,
        entity:metric-hdnnp-test-2-tokita2023 .

entity:metric-hdnnp-test-1-tokita2023 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on LiOH in water: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.682"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-hdnnp-test-2-tokita2023 a mlips:AccuracyMetric ;
    rdfs:label "test force-component RMSE (eV/bohr) on LiOH in water: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.069355"^^xsd:double .

