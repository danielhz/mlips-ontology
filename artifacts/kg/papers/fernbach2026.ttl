# Canonical Turtle for the protocol-derived encoding of:
#   Simon Fernbach et al. (2026). Using Machine-Learned Force Fields for Describing Heat-Transport-Related Quantities in AlGaN and Derived Materials.
#   Condensed Matter. doi:10.3390/condmat11020023
#
# Version read: acceptedVersion (sha256 2e76126195ba4e8a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 420 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/fernbach2026.yaml.
#
# Encoding scope: the passive training data (random displacements and
# triclinic cell deformations of 32-atom wurtzite supercells; set 1 with
# 0.2 A and 2 %, set 2 with 0.05 A and 0.5 %; 300 training and 50
# validation configurations each; Quantum ESPRESSO PBEsol), MTP ensembles
# of levels up to 18 with level 10 selected, and the material-specific
# (AlN, GaN) and alloy MTPs. Validation MAEs are stated only as bounds or
# approximately (gaps); lattice and elastic constants, phonons, Grueneisen
# parameters and thermal conductivities are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-fernbach2026 a mlips:BenchmarkStudy ;
    rdfs:label "Fernbach et al. (2026): passively trained moment tensor potentials for heat-transport quantities in AlN, GaN and AlGaN" ;
    mlips:reportedIn entity:article-fernbach2026 .

entity:article-fernbach2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.3390/condmat11020023> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Using Machine-Learned Force Fields for Describing Heat-Transport-Related Quantities in AlGaN and Derived Materials" ;
    schema:author <https://orcid.org/0009-0008-2169-3869> ,
        <https://orcid.org/0000-0002-6502-1721> ,
        <https://orcid.org/0000-0001-9824-6129> .

<https://orcid.org/0009-0008-2169-3869> a schema:Person ;
    schema:name "Simon Fernbach" ;
    schema:givenName "Simon" ;
    schema:familyName "Fernbach" ;
    schema:identifier <https://orcid.org/0009-0008-2169-3869> .

<https://orcid.org/0000-0002-6502-1721> a schema:Person ;
    schema:name "Egbert Zojer" ;
    schema:givenName "Egbert" ;
    schema:familyName "Zojer" ;
    schema:identifier <https://orcid.org/0000-0002-6502-1721> .

<https://orcid.org/0000-0001-9824-6129> a schema:Person ;
    schema:name "Natalia Bedoya-Martínez" ;
    schema:givenName "Natalia" ;
    schema:familyName "Bedoya-Martínez" ;
    schema:identifier <https://orcid.org/0000-0001-9824-6129> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-aln-fernbach2026 a mlips:MaterialSystem ;
    rdfs:label "Wurtzite AlN" ;
    mlips:chemicalFormula "AlN" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-gan-fernbach2026 a mlips:MaterialSystem ;
    rdfs:label "Wurtzite GaN" ;
    mlips:chemicalFormula "GaN" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-algan-fernbach2026 a mlips:MaterialSystem ;
    rdfs:label "Wurtzite AlxGa1-xN alloys (x = n/16)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbesol-fernbach2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbesol-fernbach2026 mlips:hasDFTSettings entity:calc-settings-pbesol-fernbach2026 .

entity:calc-settings-pbesol-fernbach2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-PBEsol-fernbach2026 ;
    rdfs:comment "SSSP precision pseudopotentials, 80-90 Ry wavefunction cutoffs (8x for density), 4x4x4 k-points for 2x2x2 supercells, SCF 1e-12 Ry (Sec. 2.5)." .

entity:xc-PBEsol-fernbach2026 a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aln-set1-fernbach2026 a mlips:TrainingDataset ;
    rdfs:label "AlN set 1 (Delta_d 0.2 A, Delta_c 2 %; 300 training + 50 validation)" ;
    mlips:coversMaterial entity:mat-aln-fernbach2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 300 ;
    mlips:hasDFTCalculation entity:calc-pbesol-fernbach2026 .

entity:ds-gan-set1-fernbach2026 a mlips:TrainingDataset ;
    rdfs:label "GaN set 1 (Delta_d 0.2 A, Delta_c 2 %; 300 training + 50 validation)" ;
    mlips:coversMaterial entity:mat-gan-fernbach2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 300 ;
    mlips:hasDFTCalculation entity:calc-pbesol-fernbach2026 .

entity:ds-algan-set1-fernbach2026 a mlips:TrainingDataset ;
    rdfs:label "AlxGa1-xN set 1 (all realisable compositions; 300 training + 50 validation)" ;
    mlips:coversMaterial entity:mat-algan-fernbach2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 300 ;
    mlips:hasDFTCalculation entity:calc-pbesol-fernbach2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-aln-set1-fernbach2026 mlips:samplingStrategy
    entity:sampling-random-fernbach2026 .

entity:ds-gan-set1-fernbach2026 mlips:samplingStrategy
    entity:sampling-random-fernbach2026 .

entity:ds-algan-set1-fernbach2026 mlips:samplingStrategy
    entity:sampling-random-fernbach2026 .

entity:sampling-random-fernbach2026 a mlips:SamplingStrategy ;
    rdfs:label "Random atomic displacements (up to Delta_d) and random triclinic cell deformations (up to Delta_c) of 2x2x2 wurtzite supercells" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-fernbach2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-fernbach2026 ;
    mlips:hasHyperparameter mlips:momentLevel ;
    mlips:hasImplementation entity:impl-MTP-fernbach2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-MTP-fernbach2026 a mlips:LossFunction ;
    rdfs:label "Weighted energy (1.0), force (0.1) and stress (1.0) squared errors" .

entity:alg-MTP-fernbach2026 a mls:Algorithm ;
    rdfs:label "BFGS, 4,000 steps" .

entity:impl-MTP-fernbach2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-aln-momentLevel-fernbach2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-mtp-gan-momentLevel-fernbach2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-mtp-alloy-momentLevel-fernbach2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "10"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-aln-fernbach2026 a mlips:MLIPRun ;
    rdfs:label "Level-10 MTP for AlN (selected from an ensemble of 10)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-aln-set1-fernbach2026 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-aln-momentLevel-fernbach2026 ;
    mlips:produces entity:model-mtp-aln-fernbach2026 .

entity:model-mtp-aln-fernbach2026 a mlips:TrainedModel ;
    rdfs:label "AlN MTP level 10" .

entity:run-mtp-gan-fernbach2026 a mlips:MLIPRun ;
    rdfs:label "Level-10 MTP for GaN (selected from an ensemble of 10)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-gan-set1-fernbach2026 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-gan-momentLevel-fernbach2026 ;
    mlips:produces entity:model-mtp-gan-fernbach2026 .

entity:model-mtp-gan-fernbach2026 a mlips:TrainedModel ;
    rdfs:label "GaN MTP level 10" .

entity:run-mtp-alloy-fernbach2026 a mlips:MLIPRun ;
    rdfs:label "Level-10 alloy MTP for AlxGa1-xN (selected from an ensemble of 10)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-algan-set1-fernbach2026 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-alloy-momentLevel-fernbach2026 ;
    mlips:produces entity:model-mtp-alloy-fernbach2026 .

entity:model-mtp-alloy-fernbach2026 a mlips:TrainedModel ;
    rdfs:label "AlGaN alloy MTP level 10" .

