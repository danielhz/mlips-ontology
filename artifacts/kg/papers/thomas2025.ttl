# Canonical Turtle for the protocol-derived encoding of:
#   Jack Thomas et al. (2025). Self-consistent Coulomb interactions for machine learning interatomic potentials.
#   Nonlinearity. doi:10.1088/1361-6544/ae0402  arXiv:2406.10915v1
#
# Version read: arxiv-preprint arXiv:2406.10915v1 (sha256 28630d26c6c67a40...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 622 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/thomas2025.yaml.
#
# Encoding scope: the proof-of-concept self-consistent model (energy and
# coarse-grained density as body-ordered functions of positions and
# electrostatic-potential features, built from MACE elements) fitted to
# 4800 FHI-aims PBE water clusters. The paper is mainly mathematical
# analysis; its only numerical results are convergence curves in Fig. 1,
# so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-thomas2025 a mlips:BenchmarkStudy ;
    rdfs:label "Thomas, Baldwin, Csányi and Ortner (2025): self-consistent Coulomb interactions for machine-learning interatomic potentials" ;
    mlips:reportedIn entity:article-thomas2025 .

entity:article-thomas2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1361-6544/ae0402> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Self-consistent Coulomb interactions for machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0000-0001-8800-3406> ,
        entity:person-Baldwin-thomas2025 ,
        entity:person-Csanyi-thomas2025 ,
        <https://orcid.org/0000-0003-1498-8120> .

<https://orcid.org/0000-0001-8800-3406> a schema:Person ;
    schema:name "Jack Thomas" ;
    schema:givenName "Jack" ;
    schema:familyName "Thomas" ;
    schema:identifier <https://orcid.org/0000-0001-8800-3406> .

entity:person-Baldwin-thomas2025 a schema:Person ;
    schema:name "Will Baldwin" ;
    schema:givenName "Will" ;
    schema:familyName "Baldwin" .

entity:person-Csanyi-thomas2025 a schema:Person ;
    schema:name "Gabor Csanyi" ;
    schema:givenName "Gabor" ;
    schema:familyName "Csanyi" .

<https://orcid.org/0000-0003-1498-8120> a schema:Person ;
    schema:name "Christoph Ortner" ;
    schema:givenName "Christoph" ;
    schema:familyName "Ortner" ;
    schema:identifier <https://orcid.org/0000-0003-1498-8120> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-clusters-thomas2025 a mlips:MaterialSystem ;
    rdfs:label "Small clusters of water molecules" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular clusters" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-thomas2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-thomas2025 mlips:hasDFTSettings entity:calc-settings-pbe-thomas2025 .

entity:calc-settings-pbe-thomas2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Electron density partitioned onto atom-centred charges, dipoles and quadrupoles (Appendix C)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-water-thomas2025 a mlips:TrainingDataset ;
    rdfs:label "4800 small water clusters with energies, forces and partitioned densities" ;
    mlips:coversMaterial entity:mat-water-clusters-thomas2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4800 ;
    mlips:hasDFTCalculation entity:calc-pbe-thomas2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-thomas2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-thomas2025 ;
    mlips:hasHyperparameter mlips:bodyOrder .

entity:loss-MACE-thomas2025 a mlips:LossFunction ;
    rdfs:label "Total energy (with Hartree term from the coarse-grained density) and nuclear forces; density coefficients fitted directly" .

entity:alg-MACE-thomas2025 a mls:Algorithm ;
    rdfs:label "Self-consistent variant: local energy and density functions of positions, species and projected electrostatic-potential features (0-27 per atom), built from MACE elements" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-sc-mace-thomas2025 a mlips:MLIPRun ;
    rdfs:label "Self-consistent Coulomb model for water clusters (MACE-based energy and density functions)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-water-thomas2025 ;
    mlips:produces entity:model-sc-mace-thomas2025 .

entity:model-sc-mace-thomas2025 a mlips:TrainedModel ;
    rdfs:label "Self-consistent Coulomb MACE (water clusters)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

