###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-co-bideault2024 a mlips:MaterialSystem ;
    rdfs:label "Cobalt (hcp and fcc bulk, defects, surfaces, nanoclusters and nanoparticles)" ;
    mlips:chemicalFormula "Co" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-bideault2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-bideault2024 mlips:hasDFTSettings entity:calc-settings-vasp-bideault2024 .

entity:calc-settings-vasp-bideault2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "300"^^xsd:double ;
    mlips:kPointMesh "k-spacing 0.2 1/A in periodic directions" ;
    rdfs:comment "Spin-polarized; Methfessel-Paxton smearing 0.2 eV; MedeA" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-co-bideault2024 a mlips:TrainingDataset ;
    rdfs:label "Co training set (Table I classes; 10% held out as test set)" ;
    mlips:coversMaterial entity:mat-co-bideault2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-bideault2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-co-bideault2024 mlips:samplingStrategy
    entity:sampling-classes-bideault2024 .

entity:sampling-classes-bideault2024 a mlips:SamplingStrategy ;
    rdfs:label "Unit cells, MD bulk supercells, interstitial/vacancy supercells, surfaces and nanoparticles (Table I)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:qSNAP a mlips:MLIPMethod ;
    rdfs:label "Quadratic Spectral Neighbor Analysis Potential (qSNAP)" ;
    mlips:hasFunctionalForm entity:ff-qSNAP ;
    mlips:hasLossFunction entity:loss-qSNAP-bideault2024 ;
    mlips:hasTrainingAlgorithm entity:alg-qSNAP-bideault2024 ;
    mlips:hasHyperparameter entity:hp-twoJmax-bideault2024 ,
        mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-qSNAP-bideault2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:ff-qSNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components plus all their distinct pairwise products" .

entity:loss-qSNAP-bideault2024 a mlips:LossFunction ;
    rdfs:label "Weighted least squares; energy, force and stress weights 1, 0.01 and 1e-6" .

entity:alg-qSNAP-bideault2024 a mls:Algorithm ;
    rdfs:label "Least squares; 2Jmax and cutoff optimized on the test set" .

entity:impl-qSNAP-bideault2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-MedeA-MLPG-bideault2024 .

entity:lib-MedeA-MLPG-bideault2024 a mlips:Library ;
    rdfs:label "MedeA MLPG" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-twoJmax-bideault2024 a mlips:Hyperparameter ;
    rdfs:label "SNAP/qSNAP angular order 2Jmax of the bispectrum expansion" ;
    mlips:hyperparameterName "2Jmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-qsnap-twoJmax-bideault2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-twoJmax-bideault2024 ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-qsnap-cutoffRadius-bideault2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-qsnap-bideault2024 a mlips:MLIPRun ;
    rdfs:label "q-SNAP for cobalt" ;
    mlips:appliesMethod entity:qSNAP ;
    mlips:runsOn entity:ds-co-bideault2024 ;
    mlips:hasHyperparameterSetting entity:setting-qsnap-twoJmax-bideault2024 ,
        entity:setting-qsnap-cutoffRadius-bideault2024 ;
    mlips:produces entity:model-qsnap-bideault2024 .

entity:model-qsnap-bideault2024 a mlips:TrainedModel ;
    rdfs:label "q-SNAP Co (2024)" .

