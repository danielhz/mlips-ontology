@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bideault2024 a mlips:BenchmarkStudy ;
    rdfs:label "Bideault et al. (2024): a quadratic SNAP potential for cobalt from bulk to nanoparticles" ;
    mlips:reportedIn entity:article-bideault2024 .

entity:article-bideault2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.8.123803> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Polyvalent machine-learned potential for cobalt: From bulk to nanoparticles" ;
    schema:author <https://orcid.org/0009-0003-5679-1665> ,
        <https://orcid.org/0000-0002-0306-6190> ,
        entity:person-Asahi-bideault2024 ,
        <https://orcid.org/0000-0002-7079-9589> .

