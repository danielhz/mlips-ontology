entity:metric-ani2x-DrugBank-1-gelzinyte2023 a mlips:AccuracyMetric ;
    rdfs:label "RMSE on energy, in kcal/mol/atom: pretrained ANI-2x, DrugBank (against the omegaB97x/6-31G(d) COMP6 values)" ;
    mlips:metricType mlips:RMSE ;
