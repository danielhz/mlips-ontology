###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-QM9-lubbers2018 a mlips:MLIPRun ;
    rdfs:label "HIP-NN training on QM9 (N_on-site = 3, N_feature = 80)" ;
    mlips:appliesMethod entity:HIP-NN ;
    mlips:runsOn entity:ds-QM9-lubbers2018 ;
    mlips:hasHyperparameterSetting entity:setting-QM9-numFeatures-lubbers2018 ,
        entity:setting-QM9-n-on-site-lubbers2018 ,
        entity:setting-QM9-batchSize-lubbers2018 ,
        entity:setting-QM9-learningRate-lubbers2018 ;
    mlips:trainingHardware "Single Nvidia Tesla P100 GPU: about 1 minute per epoch on the full QM9 data set, typically 1000 to 2000 epochs" ;
    mlips:produces entity:model-QM9-lubbers2018 .

entity:model-QM9-lubbers2018 a mlips:TrainedModel ;
    rdfs:label "HIP-NN QM9 model (234k parameters; mean of eight models)" .

entity:run-benzene-1k-lubbers2018 a mlips:MLIPRun ;
    rdfs:label "HIP-NN training on 1k benzene conformations (N_on-site = 0, N_feature = 20)" ;
    mlips:appliesMethod entity:HIP-NN ;
    mlips:runsOn entity:ds-benzene-1k-lubbers2018 ;
