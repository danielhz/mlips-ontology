        entity:setting-benzene-1k-n-on-site-lubbers2018 ,
        entity:setting-benzene-1k-batchSize-lubbers2018 ,
        entity:setting-benzene-1k-learningRate-lubbers2018 ;
    mlips:produces entity:model-benzene-1k-lubbers2018 .

entity:model-benzene-1k-lubbers2018 a mlips:TrainedModel ;
    rdfs:label "HIP-NN benzene model, 1k training conformations (about 10k parameters)" .

entity:run-benzene-50k-lubbers2018 a mlips:MLIPRun ;
    rdfs:label "HIP-NN training on 50k benzene conformations (N_on-site = 3, N_feature = 40)" ;
