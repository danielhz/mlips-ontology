# Canonical Turtle for the protocol-derived encoding of:
#   Nicholas Lubbers et al. (2018). Hierarchical modeling of molecular energies using a deep neural network.
#   The Journal of Chemical Physics. doi:10.1063/1.5011181  arXiv:1710.00017v1
#
# Version read: arxiv-preprint arXiv:1710.00017v1 (sha256 87113a9f02493440...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 48 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the HIP-NN method (introduced here; energies only) and
# its benchmark fits: QM9 with 110,426 training and validation molecules
# (Tables I and II, N_feature = 80) and four MD-trajectory molecules at
# 1k and 50k training conformations (Table III). Every value is a mean
# over eight models with different random data splits.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-lubbers2018 a mlips:BenchmarkStudy ;
    rdfs:label "Lubbers, Smith and Barros (2018): HIP-NN, hierarchical modeling of molecular energies with a deep neural network" ;
    mlips:reportedIn entity:article-lubbers2018 .

entity:article-lubbers2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/1.5011181> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Hierarchical modeling of molecular energies using a deep neural network" ;
    schema:author <https://orcid.org/0000-0002-9001-9973> ,
        <https://orcid.org/0000-0001-7314-7896> ,
        <https://orcid.org/0000-0002-1333-5972> .

<https://orcid.org/0000-0002-9001-9973> a schema:Person ;
    schema:name "Nicholas Lubbers" ;
    schema:givenName "Nicholas" ;
    schema:familyName "Lubbers" ;
    schema:identifier <https://orcid.org/0000-0002-9001-9973> .

<https://orcid.org/0000-0001-7314-7896> a schema:Person ;
    schema:name "Justin S. Smith" ;
    schema:givenName "Justin S." ;
    schema:familyName "Smith" ;
    schema:identifier <https://orcid.org/0000-0001-7314-7896> .

<https://orcid.org/0000-0002-1333-5972> a schema:Person ;
    schema:name "Kipton Barros" ;
    schema:givenName "Kipton" ;
    schema:familyName "Barros" ;
    schema:identifier <https://orcid.org/0000-0002-1333-5972> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-QM9-lubbers2018 a mlips:MaterialSystem ;
    rdfs:label "QM9 small organic molecules (H, C, N, O, F; up to nine heavy atoms)" ;
    mlips:materialClass "Small organic molecules, equilibrium geometries" .

entity:mat-benzene-lubbers2018 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule, MD conformations at 500 K" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-malonaldehyde-lubbers2018 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule, MD conformations at 500 K" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-salicylic-acid-lubbers2018 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid molecule, MD conformations at 500 K" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-toluene-lubbers2018 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule, MD conformations at 500 K" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qm9-dft-lubbers2018 a mlips:DFTCalculation .

entity:calc-md-dft-lubbers2018 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qm9-dft-lubbers2018 mlips:hasDFTSettings entity:calc-settings-qm9-dft-lubbers2018 .

entity:calc-settings-qm9-dft-lubbers2018 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-B3LYP-lubbers2018 ;
    mlips:dftBasisSet entity:basis-6-31G-2df-p-lubbers2018 ;
    rdfs:comment "B3LYP/6-31G(2df,p), the QM9 level of theory." .

entity:calc-md-dft-lubbers2018 mlips:hasDFTSettings entity:calc-settings-md-dft-lubbers2018 .

entity:calc-settings-md-dft-lubbers2018 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "DFT with the PBE functional (data sets of Schutt et al.); code and basis are not restated." .

entity:xc-B3LYP-lubbers2018 a mlips:XCFunctional ;
    rdfs:label "B3LYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-6-31G-2df-p-lubbers2018 a mlips:DftBasisSet ;
    rdfs:label "6-31G(2df,p)" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-QM9-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "QM9 training and validation split (110,426 molecules)" ;
    mlips:coversMaterial entity:mat-QM9-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 110426 ;
    mlips:hasDFTCalculation entity:calc-qm9-dft-lubbers2018 .

entity:ds-benzene-1k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Benzene MD conformations, 1k training set" ;
    mlips:coversMaterial entity:mat-benzene-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

entity:ds-benzene-50k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Benzene MD conformations, 50k training set" ;
    mlips:coversMaterial entity:mat-benzene-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

entity:ds-malonaldehyde-1k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Malonaldehyde MD conformations, 1k training set" ;
    mlips:coversMaterial entity:mat-malonaldehyde-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

entity:ds-malonaldehyde-50k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Malonaldehyde MD conformations, 50k training set" ;
    mlips:coversMaterial entity:mat-malonaldehyde-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

entity:ds-salicylic-acid-1k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Salicylic acid MD conformations, 1k training set" ;
    mlips:coversMaterial entity:mat-salicylic-acid-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

entity:ds-salicylic-acid-50k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Salicylic acid MD conformations, 50k training set" ;
    mlips:coversMaterial entity:mat-salicylic-acid-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

entity:ds-toluene-1k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Toluene MD conformations, 1k training set" ;
    mlips:coversMaterial entity:mat-toluene-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

entity:ds-toluene-50k-lubbers2018 a mlips:TrainingDataset ;
    rdfs:label "Toluene MD conformations, 50k training set" ;
    mlips:coversMaterial entity:mat-toluene-lubbers2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md-dft-lubbers2018 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-QM9-lubbers2018 mlips:samplingStrategy
    entity:sampling-qm9-equilibrium-lubbers2018 .

entity:ds-benzene-1k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:ds-benzene-50k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:ds-malonaldehyde-1k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:ds-malonaldehyde-50k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:ds-salicylic-acid-1k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:ds-salicylic-acid-50k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:ds-toluene-1k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:ds-toluene-50k-lubbers2018 mlips:samplingStrategy
    entity:sampling-md-500K-lubbers2018 .

entity:sampling-qm9-equilibrium-lubbers2018 a mlips:SamplingStrategy ;
    rdfs:label "Equilibrium geometries (pruned QM9)" ;
    rdfs:comment "About 131k molecules after removing about 3k that fail a geometric consistency check and 11 with minimisation difficulties; random partition into training, validation (1000) and test sets." .

entity:sampling-md-500K-lubbers2018 a mlips:SamplingStrategy ;
    rdfs:label "MD trajectories in vacuum at 500 K" ;
    rdfs:comment "Conformations drawn at random from the trajectory; 1k further conformations for early stopping, the rest for testing." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HIP-NN a mlips:MLIPMethod ;
    rdfs:label "Hierarchically Interacting Particle Neural Network (HIP-NN)" ;
    mlips:hasFunctionalForm entity:ff-HIP-NN ;
    mlips:hasLossFunction entity:loss-HIP-NN-lubbers2018 ;
    mlips:hasTrainingAlgorithm entity:alg-HIP-NN-lubbers2018 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        entity:hp-n-on-site-lubbers2018 ,
        mlips:batchSize ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-HIP-NN-lubbers2018 .

entity:ff-HIP-NN a mlips:FunctionalForm ;
    rdfs:label "Deep neural network with on-site and interaction layers over inverse-distance sensitivity functions; the molecular energy is a sum of atomic energies decomposed into hierarchical contributions from successive interaction layers" .

entity:loss-HIP-NN-lubbers2018 a mlips:LossFunction ;
    rdfs:label "(MAE + RMSE) of the energy scaled by the standard deviation of the energies, plus L2 regularisation (lambda_L2 = 1e-6) and a hierarchicality regularisation (lambda_R = 1e-2)" .

entity:alg-HIP-NN-lubbers2018 a mls:Algorithm ;
    rdfs:label "Adam (beta1 = 0.9, beta2 = 0.999), initial learning rate 1e-3 held for 100 epochs, multiplied by 0.5 when the validation MAE plateaus for 50 epochs; early stopping, at most 2000 epochs; mini-batches of 30 molecules" .

entity:impl-HIP-NN-lubbers2018 a mlips:Implementation ;
    mlips:implementedIn entity:lib-Theano-Lasagne-implementation-of-HIP-NN-lubbers2018 .

entity:lib-Theano-Lasagne-implementation-of-HIP-NN-lubbers2018 a mlips:Library ;
    rdfs:label "Theano / Lasagne implementation of HIP-NN" ;
    rdfs:comment "Custom layers in the Theano framework with the Lasagne library." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-n-on-site-lubbers2018 a mlips:Hyperparameter ;
    rdfs:label "HIP-NN number of on-site layers per interaction block" ;
    mlips:hyperparameterName "N_on-site" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
