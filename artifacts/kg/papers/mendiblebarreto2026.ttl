@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mendiblebarreto2026 a mlips:BenchmarkStudy ;
    rdfs:label "Mendible-Barreto and Colón (2026): fine-tuned MACE-POLAR free-energy surface for the first step of MIL-101(Cr) SBU formation" ;
    mlips:reportedIn entity:article-mendiblebarreto2026 .

entity:article-mendiblebarreto2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2609.38518> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "A Machine-Learned Interatomic Potential Free-Energy Surface for the First Step of MIL-101(Cr) Secondary Building Unit Formation" ;
    schema:author entity:person-MendibleBarreto-mendiblebarreto2026 ,
        entity:person-Colon-mendiblebarreto2026 .

entity:person-MendibleBarreto-mendiblebarreto2026 a schema:Person ;
    schema:name "Orlando A. Mendible-Barreto" ;
    schema:givenName "Orlando A." ;
    schema:familyName "Mendible-Barreto" .

entity:person-Colon-mendiblebarreto2026 a schema:Person ;
    schema:name "Yamil J. Colón" ;
    schema:givenName "Yamil J." ;
    schema:familyName "Colón" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-crbdc-mendiblebarreto2026 a mlips:MaterialSystem ;
    rdfs:label "[Cr(H2O)6]3+ + terephthalate (BDC) ligand-exchange complex in a 30.5 A periodic box (charge 2, S = 1.5)" ;
    mlips:materialClass "metal-organic precursor complex" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97mv-mendiblebarreto2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97mv-mendiblebarreto2026 mlips:hasDFTSettings entity:calc-settings-wb97mv-mendiblebarreto2026 .

entity:calc-settings-wb97mv-mendiblebarreto2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-wB97M-V-mendiblebarreto2026 ;
    mlips:basisSet "def2-TZVPP" ;
    rdfs:comment "ORCA 6.1.0, RIJCOSX with def2/J, tight SCF, DEFGRID3; same level as the MACE-POLAR-M training data." .

entity:xc-wB97M-V-mendiblebarreto2026 a mlips:XCFunctional ;
    rdfs:label "wB97M-V" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ft-mendiblebarreto2026 a mlips:TrainingDataset ;
    rdfs:label "70 basin configurations with wB97M-V energies and forces (train/validation split in SI Table S1)" ;
    mlips:coversMaterial entity:mat-crbdc-mendiblebarreto2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 70 ;
    mlips:hasDFTCalculation entity:calc-wb97mv-mendiblebarreto2026 .

entity:ds-test-mendiblebarreto2026 a mlips:TrainingDataset ;
    rdfs:label "70 held-out configurations (ten further frames per basin)" ;
    mlips:coversMaterial entity:mat-crbdc-mendiblebarreto2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 70 ;
    mlips:hasDFTCalculation entity:calc-wb97mv-mendiblebarreto2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ft-mendiblebarreto2026 mlips:samplingStrategy
    entity:sampling-metad-basins-mendiblebarreto2026 .

entity:ds-test-mendiblebarreto2026 mlips:samplingStrategy
    entity:sampling-metad-basins-mendiblebarreto2026 .

entity:sampling-metad-basins-mendiblebarreto2026 a mlips:SamplingStrategy ;
    rdfs:label "Ten frames nearest to each of seven free-energy basins of an exploratory well-tempered metadynamics run with MACE-POLAR-M" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE-POLAR a mlips:MLIPMethod ;
    rdfs:label "MACE-POLAR (polarizable MACE with an explicit long-range electrostatic term conditioned on total charge and spin multiplicity)" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-POLAR-mendiblebarreto2026 ;
    mlips:hasImplementation entity:impl-MACE-POLAR-mendiblebarreto2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-MACE-POLAR-mendiblebarreto2026 a mls:Algorithm ;
    rdfs:label "Naive (all weights), LoRA (frozen weights with low-rank updates) and multi-head replay fine-tuning from the same checkpoint; hyperparameters in SI Table S2" .

entity:impl-MACE-POLAR-mendiblebarreto2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

