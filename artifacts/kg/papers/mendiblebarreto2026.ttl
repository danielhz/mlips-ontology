entity:run-lora-mendiblebarreto2026 a mlips:MLIPRun ;
    rdfs:label "MACE-POLAR-M LoRA fine-tune" ;
    mlips:appliesMethod entity:MACE-POLAR ;
    mlips:runsOn entity:ds-ft-mendiblebarreto2026 ;
    mlips:produces entity:model-lora-mendiblebarreto2026 .

entity:model-lora-mendiblebarreto2026 a mlips:TrainedModel ;
    rdfs:label "MACE-POLAR-M LoRA FT (MIL-101 SBU step 1)" .

entity:run-mh-mendiblebarreto2026 a mlips:MLIPRun ;
