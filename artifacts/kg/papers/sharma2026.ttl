# Canonical Turtle for the protocol-derived encoding of:
#   Manas Sharma et al. (2026). MLIP Studio: An Open Platform for Interactive Benchmarking and Atomistic Simulations Using Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2607.07606  arXiv:2607.07606v1
#
# Version read: arxiv-preprint arXiv:2607.07606v1 (sha256 7d0db25316f140ae...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 258 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/sharma2026.yaml.
#
# Encoding scope: the MLIP Studio platform with its CrCl3/sapphire
# benchmark of seven universal MLIPs against a 500-frame AIMD trajectory
# (Table 5, with the Fig. 9 R2 of MACE OMAT Medium) and the stated CPU and
# GPU wall times for 1,000 energy/force/stress evaluations of (H2O)64.
# Bulk Al2O3 properties (Table 3), surface energies (Table 4), the
# DFT pre-optimisation study (Table 2), spin-state scans and other
# property demonstrations are not error metrics and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-sharma2026 a mlips:BenchmarkStudy ;
    rdfs:label "Sharma, Punnathanam and Govind Rajan (2026): MLIP Studio, an interactive platform for universal MLIP benchmarking and simulation" ;
    mlips:reportedIn entity:article-sharma2026 .

entity:article-sharma2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2607.07606> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "MLIP Studio: An Open Platform for Interactive Benchmarking and Atomistic Simulations Using Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Sharma-sharma2026 ,
        entity:person-Punnathanam-sharma2026 ,
        entity:person-Rajan-sharma2026 .

entity:person-Sharma-sharma2026 a schema:Person ;
    schema:name "Manas Sharma" ;
    schema:givenName "Manas" ;
    schema:familyName "Sharma" .

entity:person-Punnathanam-sharma2026 a schema:Person ;
    schema:name "Sudeep Punnathanam" ;
    schema:givenName "Sudeep" ;
    schema:familyName "Punnathanam" .

entity:person-Rajan-sharma2026 a schema:Person ;
    schema:name "Ananth Govind Rajan" ;
    schema:givenName "Ananth Govind" ;
    schema:familyName "Rajan" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-crcl3-sapphire-sharma2026 a mlips:MaterialSystem ;
    rdfs:label "CrCl3 molecule adsorbed on an alpha-Al2O3 (sapphire) surface" ;
    mlips:materialClass "Molecule-oxide surface interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PET a mlips:MLIPMethod ;
    rdfs:label "Point Edge Transformer (PET)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-pet-omat-m-sharma2026 a mlips:MLIPRun ;
    rdfs:label "PET-OMAT-M (v1) as distributed" ;
    mlips:appliesMethod entity:PET ;
    mlips:produces entity:model-pet-omat-m-sharma2026 .

entity:model-pet-omat-m-sharma2026 a mlips:TrainedModel ;
    rdfs:label "PET-OMAT-M v1" .

