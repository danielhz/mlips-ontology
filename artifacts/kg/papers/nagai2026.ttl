entity:ds-d-r2scan-nagai2026 mlips:samplingStrategy
    entity:sampling-slhmc-nagai2026 .

entity:ds-d-hse-nagai2026 mlips:samplingStrategy
    entity:sampling-slhmc-nagai2026 .

entity:sampling-slhmc-nagai2026 a mlips:SamplingStrategy ;
