@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-nagai2026 a mlips:BenchmarkStudy ;
    rdfs:label "Nagai et al. (2026): target-distribution-guided (SLHMC) cross-functional fine-tuning of MACE-MP-0 for rutile TiO2 at PBE, r2SCAN and HSE06" ;
    mlips:reportedIn entity:article-nagai2026 .

entity:article-nagai2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2605.25032> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Target-Distribution-Guided Cross-Functional Fine-Tuning of Machine-Learning Interatomic Potentials" ;
    schema:author entity:person-Nagai-nagai2026 ,
        entity:person-Thomsen-nagai2026 ,
        entity:person-Shiga-nagai2026 .

entity:person-Nagai-nagai2026 a schema:Person ;
    schema:name "Yuki Nagai" ;
    schema:givenName "Yuki" ;
    schema:familyName "Nagai" .

entity:person-Thomsen-nagai2026 a schema:Person ;
    schema:name "Bo Thomsen" ;
    schema:givenName "Bo" ;
    schema:familyName "Thomsen" .

entity:person-Shiga-nagai2026 a schema:Person ;
    schema:name "Motoyuki Shiga" ;
    schema:givenName "Motoyuki" ;
    schema:familyName "Shiga" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tio2-nagai2026 a mlips:MaterialSystem ;
    rdfs:label "Rutile TiO2 (48-atom 2x2x2 and 216-atom 3x3x4 supercells), 300-600 K" ;
    mlips:chemicalFormula "TiO2" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-nagai2026 a mlips:DFTCalculation .

entity:calc-r2scan-nagai2026 a mlips:DFTCalculation .

entity:calc-hse06-nagai2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-nagai2026 mlips:hasDFTSettings entity:calc-settings-pbe-nagai2026 .

entity:calc-settings-pbe-nagai2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "VASP 6.5.1, Ti_pv and O PAW, spin unpolarised, Gaussian smearing 0.05 eV, EDIFF 1e-4 eV (Sec. 4.1)." .

entity:calc-r2scan-nagai2026 mlips:hasDFTSettings entity:calc-settings-r2scan-nagai2026 .

entity:calc-settings-r2scan-nagai2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-nagai2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "Same numerical settings as PBE (Sec. 4.1)." .

entity:calc-hse06-nagai2026 mlips:hasDFTSettings entity:calc-settings-hse06-nagai2026 .

entity:calc-settings-hse06-nagai2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:HSE06 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "25 % short-range exact exchange, screening 0.2 1/A; same numerical settings (Sec. 4.1)." .

entity:xc-r2SCAN-nagai2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-d-pbe-nagai2026 a mlips:TrainingDataset ;
