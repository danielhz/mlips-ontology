# Canonical Turtle for the protocol-derived encoding of:
#   Vijay Kumar Choyal et al. (2024). Constructing and Evaluating Machine-Learned Interatomic Potentials for Li-Based Disordered Rocksalts.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.4c00039  arXiv:2304.01650v1
#
# Version read: arxiv-preprint arXiv:2304.01650v1 (sha256 53b12911d4fcf65e...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 233 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/choyal2024.yaml.
#
# Encoding scope: the four MLIPs trained on the full 10,842-structure
# LiTMO2/TMO2 data set (MTP, SNAP, GAP, AENET) with their training and test
# RMSEs for energies and forces at the full data-set size (Fig. 3; the
# training values also in the text). Smaller data-set sizes, qSNAP
# (dropped by the authors), training times and the voltage predictions are
# not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-choyal2024 a mlips:BenchmarkStudy ;
    rdfs:label "Choyal, Sagar and Sai Gautam (2024): MTP, SNAP, qSNAP, GAP and AENET potentials for Li-based disordered rocksalts" ;
    mlips:reportedIn entity:article-choyal2024 .

entity:article-choyal2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.4c00039> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Constructing and Evaluating Machine-Learned Interatomic Potentials for Li-Based Disordered Rocksalts" ;
    schema:author entity:person-Choyal-choyal2024 ,
        entity:person-Sagar-choyal2024 ,
        <https://orcid.org/0000-0002-1303-0976> .

entity:person-Choyal-choyal2024 a schema:Person ;
    schema:name "Vijay Choyal" ;
    schema:givenName "Vijay" ;
    schema:familyName "Choyal" .

entity:person-Sagar-choyal2024 a schema:Person ;
    schema:name "Nidhish Sagar" ;
    schema:givenName "Nidhish" ;
    schema:familyName "Sagar" .

<https://orcid.org/0000-0002-1303-0976> a schema:Person ;
    schema:name "Gopalakrishnan Sai Gautam" ;
    schema:givenName "Gopalakrishnan" ;
    schema:familyName "Sai Gautam" ;
    schema:identifier <https://orcid.org/0000-0002-1303-0976> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-LDR-choyal2024 a mlips:MaterialSystem ;
    rdfs:label "Li-based disordered rocksalts LiTMO2 and delithiated TMO2 (TM = Sc, Ti, V, Cr, Mn, Fe, Co, Ni, Cu; up to nine TMs)" ;
    mlips:materialClass "Disordered rocksalt oxide cathode materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-u-choyal2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-u-choyal2024 mlips:hasDFTSettings entity:calc-settings-pbe-u-choyal2024 .

entity:calc-settings-pbe-u-choyal2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, 1000 per number of atoms" ;
    rdfs:comment "Hubbard U correction (Materials Project compatible pymatgen settings), VASP 6.1.2; single points for the structures of Artrith et al., full relaxations for the newly enumerated ones." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ldr-choyal2024 a mlips:TrainingDataset ;
    rdfs:label "LiTMO2/TMO2 disordered-rocksalt data set (10,842 structures; 90:10 split)" ;
    mlips:coversMaterial entity:mat-LDR-choyal2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 10842 ;
    mlips:hasDFTCalculation entity:calc-pbe-u-choyal2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ldr-choyal2024 mlips:samplingStrategy
    entity:sampling-enumeration-choyal2024 .

entity:sampling-enumeration-choyal2024 a mlips:SamplingStrategy ;
    rdfs:label "Enumerated Li/TM orderings on the rocksalt cation sublattice (up to 18 cation sites)" ;
    rdfs:comment "10,046 structures of Artrith et al., about 400 new multi-TM combinations from pymatgen, and 500 delithiated structures per n-TM combination (Dataset generation)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-choyal2024 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-choyal2024 ;
    mlips:hasImplementation entity:impl-MTP-choyal2024 .

entity:loss-MTP-choyal2024 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses" .

entity:alg-MTP-choyal2024 a mls:Algorithm ;
    rdfs:label "BFGS" .

entity:impl-MTP-choyal2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP ;
    mlips:hasTrainingAlgorithm entity:alg-SNAP-choyal2024 ;
    mlips:hasImplementation entity:impl-SNAP-choyal2024 .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

entity:alg-SNAP-choyal2024 a mls:Algorithm ;
    rdfs:label "Linear regression" .

entity:impl-SNAP-choyal2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-MAML-choyal2024 .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:loss-GAP-choyal2024 ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-choyal2024 ;
    mlips:hasImplementation entity:impl-GAP-choyal2024 .

entity:loss-GAP-choyal2024 a mlips:LossFunction ;
    rdfs:label "Energies only (forces not included in training)" .

entity:alg-GAP-choyal2024 a mls:Algorithm ;
    rdfs:label "Gaussian process regression" .

entity:impl-GAP-choyal2024 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:ChebyshevANN a mlips:MLIPMethod ;
    rdfs:label "Atomic neural-network potential with Chebyshev radial and angular distribution descriptors (aenet)" ;
    mlips:hasLossFunction entity:loss-ChebyshevANN-choyal2024 ;
    mlips:hasTrainingAlgorithm entity:alg-ChebyshevANN-choyal2024 ;
    mlips:hasHyperparameter mlips:numEpochs ;
    mlips:hasImplementation entity:impl-ChebyshevANN-choyal2024 .

entity:loss-ChebyshevANN-choyal2024 a mlips:LossFunction ;
    rdfs:label "Energies only (aenet cannot weight forces)" .

entity:alg-ChebyshevANN-choyal2024 a mls:Algorithm ;
    rdfs:label "L-BFGS" .

entity:impl-ChebyshevANN-choyal2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-aenet-choyal2024 .

entity:lib-MAML-choyal2024 a mlips:Library ;
    rdfs:label "MAML" ;
    rdfs:comment "materials machine learning package used as the interface for GAP, SNAP, qSNAP and MTP" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-aenet-choyal2024 a mlips:Library ;
    rdfs:label "aenet" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-aenet-numEpochs-choyal2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "3300"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-choyal2024 a mlips:MLIPRun ;
    rdfs:label "MTP trained on the full LDR data set (90% of 10,842)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-ldr-choyal2024 ;
    mlips:trainingHardware "Single core of an Intel Xeon Gold 6271 CPU" ;
    mlips:produces entity:model-mtp-choyal2024 .

entity:model-mtp-choyal2024 a mlips:TrainedModel ;
    rdfs:label "MTP LiTMO2/TMO2 potential" .

entity:run-snap-choyal2024 a mlips:MLIPRun ;
    rdfs:label "SNAP trained on the full LDR data set (90% of 10,842)" ;
    mlips:appliesMethod entity:SNAP ;
    mlips:runsOn entity:ds-ldr-choyal2024 ;
    mlips:trainingHardware "Single core of an Intel Xeon Gold 6271 CPU" ;
    mlips:produces entity:model-snap-choyal2024 .

entity:model-snap-choyal2024 a mlips:TrainedModel ;
    rdfs:label "SNAP LiTMO2/TMO2 potential" .

entity:run-gap-choyal2024 a mlips:MLIPRun ;
    rdfs:label "GAP trained on the full LDR data set (90% of 10,842)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-ldr-choyal2024 ;
    mlips:trainingHardware "Single core of an Intel Xeon Gold 6271 CPU" ;
    mlips:produces entity:model-gap-choyal2024 .

entity:model-gap-choyal2024 a mlips:TrainedModel ;
    rdfs:label "GAP LiTMO2/TMO2 potential" .

entity:run-aenet-choyal2024 a mlips:MLIPRun ;
    rdfs:label "AENET trained on the full LDR data set (90% of 10,842)" ;
    mlips:appliesMethod entity:ChebyshevANN ;
    mlips:runsOn entity:ds-ldr-choyal2024 ;
    mlips:hasHyperparameterSetting entity:setting-aenet-numEpochs-choyal2024 ;
    mlips:trainingHardware "Single core of an Intel Xeon Gold 6271 CPU; about 38 h for 3,300 epochs" ;
    mlips:produces entity:model-aenet-choyal2024 .

entity:model-aenet-choyal2024 a mlips:TrainedModel ;
    rdfs:label "AENET LiTMO2/TMO2 potential" .

