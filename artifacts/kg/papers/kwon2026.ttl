# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-uma-s-kwon2026 a mlips:MLIPRun ;
    rdfs:label "uma-s-1p1 (OC20 task) as distributed" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-s-kwon2026 .

entity:model-uma-s-kwon2026 a mlips:TrainedModel ;
    rdfs:label "UMA-S uma-s-1p1 (OC20 task)" .

entity:run-r1-kwon2026 a mlips:MLIPRun ;
    rdfs:label "UMA-S fine-tuned, round 1 (layer freezing)" ;
    mlips:appliesMethod entity:UMA ;
    mlips:runsOn entity:ds-r1-kwon2026 ;
    mlips:hasHyperparameterSetting entity:setting-r1-numEpochs-kwon2026 ;
