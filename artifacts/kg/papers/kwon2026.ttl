# Canonical Turtle for the protocol-derived encoding of:
#   Jaehong Kwon et al. (2026). Fine-tuning a universal machine-learned interatomic potential for oxygen plasma interactions with WS2.
#   Journal of Vacuum Science & Technology A Vacuum Surfaces and Films. doi:10.1116/6.0005737  arXiv:2606.21632v3
#
# Version read: arxiv-preprint arXiv:2606.21632v3 (sha256 a0ef79b8a3682201...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 295 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/kwon2026.yaml.
#
# Encoding scope: the pretrained uma-s-1p1 model (OC20 task) and its
# iterative fine-tunings (rounds R1-R3 with layer freezing; full
# fine-tuning and LoRA r = 8 and r = 1 on the final 2,610 configurations)
# on PBE+D3+U spin-polarised W-S-O data, with the stated test MAEs on the
# held-out R4 and larger-cell R4b sets. Plasma-surface observables
# (chemisorbed S and O coverage) are not error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kwon2026 a mlips:BenchmarkStudy ;
    rdfs:label "Kwon, Rosen and Graves (2026): iterative fine-tuning of UMA-S (OC20 task) for oxygen-plasma interactions with WS2" ;
    mlips:reportedIn entity:article-kwon2026 .

entity:article-kwon2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1116/6.0005737> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Fine-tuning a universal machine-learned interatomic potential for oxygen plasma interactions with WS2" ;
    schema:author <https://orcid.org/0000-0002-2792-2772> ,
        <https://orcid.org/0000-0002-0141-7006> ,
        <https://orcid.org/0000-0002-2288-6768> .

<https://orcid.org/0000-0002-2792-2772> a schema:Person ;
    schema:name "Jaehong Kwon" ;
    schema:givenName "Jaehong" ;
    schema:familyName "Kwon" ;
    schema:identifier <https://orcid.org/0000-0002-2792-2772> .

<https://orcid.org/0000-0002-0141-7006> a schema:Person ;
    schema:name "Andrew S. Rosen" ;
    schema:givenName "Andrew S." ;
    schema:familyName "Rosen" ;
    schema:identifier <https://orcid.org/0000-0002-0141-7006> .

<https://orcid.org/0000-0002-2288-6768> a schema:Person ;
