###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ws2-o-kwon2026 a mlips:MaterialSystem ;
    rdfs:label "Oxidising WS2 layers (flat 3x3x2 and stepped slabs) under 15 eV O+ and O2+ bombardment" ;
    mlips:materialClass "2D transition-metal dichalcogenide surface with oxygen" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-u-kwon2026 a mlips:DFTCalculation .

entity:calc-oc20-dft-kwon2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-u-kwon2026 mlips:hasDFTSettings entity:calc-settings-pbe-d3-u-kwon2026 .

entity:calc-settings-pbe-d3-u-kwon2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-PBE-D3-U-kwon2026 ;
    mlips:kPointMesh "Gamma-centred 2x2x1" ;
    rdfs:comment "Spin-polarised, Hubbard U = 2.87 eV on W 5d, SSSP 1.3.0 efficiency (GBRV ultrasoft W, S; PAW O), 55/430 Ry cutoffs (Quantum ESPRESSO 7)." .

entity:calc-oc20-dft-kwon2026 mlips:hasDFTSettings entity:calc-settings-oc20-dft-kwon2026 .

entity:calc-settings-oc20-dft-kwon2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-RPBE-kwon2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "OC20 setting (non-spin-polarised, no U, PBE 54 PAW) used only to score the pretrained model on R4 (quacc)." .

entity:xc-PBE-D3-U-kwon2026 a mlips:XCFunctional ;
    rdfs:label "PBE+D3+U" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-RPBE-kwon2026 a mlips:XCFunctional ;
    rdfs:label "RPBE" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-r1-kwon2026 a mlips:TrainingDataset ;
    rdfs:label "Round-1 fine-tuning set (configurations explored by the pretrained model; size not stated)" ;
    mlips:coversMaterial entity:mat-ws2-o-kwon2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-u-kwon2026 .

entity:ds-r1-r2-kwon2026 a mlips:TrainingDataset ;
    rdfs:label "Cumulative R1-R2 fine-tuning set (size not stated)" ;
    mlips:coversMaterial entity:mat-ws2-o-kwon2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-u-kwon2026 .

entity:ds-r1-r3-kwon2026 a mlips:TrainingDataset ;
    rdfs:label "Cumulative R1-R3 fine-tuning set (2,610 W-S-O configurations, 90/10 training/validation)" ;
    mlips:coversMaterial entity:mat-ws2-o-kwon2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2610 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-u-kwon2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-r1-kwon2026 mlips:samplingStrategy
    entity:sampling-loop-kwon2026 .

entity:ds-r1-r2-kwon2026 mlips:samplingStrategy
    entity:sampling-loop-kwon2026 .

entity:ds-r1-r3-kwon2026 mlips:samplingStrategy
    entity:sampling-loop-kwon2026 .

entity:sampling-loop-kwon2026 a mlips:SamplingStrategy ;
    rdfs:label "Iterative loop: MD exploration with the current model, SOAP + PCA + farthest-point sampling, DFT labelling; next round's configurations form the test set" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:hasLossFunction entity:loss-UMA-kwon2026 ;
    mlips:hasTrainingAlgorithm entity:alg-UMA-kwon2026 ;
    mlips:hasHyperparameter mlips:numEpochs ;
    mlips:hasImplementation entity:impl-UMA-kwon2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-UMA-kwon2026 a mlips:LossFunction ;
    rdfs:label "MSE on per-atom energy (w 5), Huber (delta 2 eV/A) on forces (w 60), MSE on stress (w 10), in force-RMS-normalised space" .

entity:alg-UMA-kwon2026 a mls:Algorithm ;
    rdfs:label "Cosine schedule with 5-epoch warm-up, EMA; layer freezing, full fine-tuning or LoRA on the MoLE experts" .

entity:impl-UMA-kwon2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-kwon2026 .

entity:lib-fairchem-kwon2026 a mlips:Library ;
    rdfs:label "fairchem" ;
    rdfs:comment "FairChem with custom fine-tuning code" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-r1-numEpochs-kwon2026 a mlips:HyperparameterSetting ;
