    mlips:settingValue "55"^^xsd:integer .

entity:setting-r2-numEpochs-kwon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "55"^^xsd:integer .

entity:setting-r3-numEpochs-kwon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "55"^^xsd:integer .

