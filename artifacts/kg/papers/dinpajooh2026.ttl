###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-HNO3aq-dinpajooh2026 a mlips:MaterialSystem ;
    rdfs:label "Aqueous nitric acid solutions (about 2 to 4 M in training; associated and dissociated HNO3)" ;
    mlips:chemicalFormula "HNO3 + H2O" ;
    mlips:materialClass "Aqueous electrolyte solution" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-blyp-dinpajooh2026 a mlips:DFTCalculation .

entity:calc-pbe-dinpajooh2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-blyp-dinpajooh2026 mlips:hasDFTSettings entity:calc-settings-blyp-dinpajooh2026 .

entity:calc-settings-blyp-dinpajooh2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-dinpajooh2026 ;
    mlips:xcFunctional entity:xc-BLYP-D2-dinpajooh2026 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:dftBasisSet entity:basis-TZV2P-MOLOPT-dinpajooh2026 ;
    rdfs:comment "Goedecker-Teter-Hutter pseudopotentials; Grimme D2 dispersion; SCF convergence 1e-6." .

entity:calc-pbe-dinpajooh2026 mlips:hasDFTSettings entity:calc-settings-pbe-dinpajooh2026 .

entity:calc-settings-pbe-dinpajooh2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-dinpajooh2026 ;
    mlips:xcFunctional entity:xc-PBE-D3-dinpajooh2026 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    rdfs:comment "Second reference level: energies and forces recomputed on the same snapshots. Basis and pseudopotentials are assumed to follow the BLYP-D2 setup and are not restated in the text read." .

entity:lib-CP2K-dinpajooh2026 a mlips:Library ;
    rdfs:label "CP2K" ;
    rdfs:comment "QuickStep module; Gaussian and plane-wave scheme with an 800 Ry density cutoff." ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-BLYP-D2-dinpajooh2026 a mlips:XCFunctional ;
    rdfs:label "BLYP-D2" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-TZV2P-MOLOPT-dinpajooh2026 a mlips:DftBasisSet ;
    rdfs:label "TZV2P MOLOPT" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

entity:lib-CP2K-dinpajooh2026 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE-D3-dinpajooh2026 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-blyp-dinpajooh2026 a mlips:TrainingDataset ;
    rdfs:label "HNO3 training set at the BLYP-D2 level (2941 configurations)" ;
    mlips:coversMaterial entity:mat-HNO3aq-dinpajooh2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 2941 ;
    mlips:hasDFTCalculation entity:calc-blyp-dinpajooh2026 .

entity:ds-pbe-dinpajooh2026 a mlips:TrainingDataset ;
    rdfs:label "HNO3 training set at the PBE-D3 level (the 2941 snapshots recomputed plus 11 new candidates)" ;
    mlips:coversMaterial entity:mat-HNO3aq-dinpajooh2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2952 ;
    mlips:hasDFTCalculation entity:calc-pbe-dinpajooh2026 ;
    rdfs:comment "2952 is the sum of the two stated numbers." .

entity:ds-stage1-dinpajooh2026 a mlips:TrainingDataset ;
    rdfs:label "Stage-1 (NVT) configurations at the BLYP-D2 level, used to fine-tune MACE-MP0" ;
    mlips:coversMaterial entity:mat-HNO3aq-dinpajooh2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-blyp-dinpajooh2026 ;
    rdfs:comment "Size not stated." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-blyp-dinpajooh2026 mlips:samplingStrategy
    entity:sampling-initial-dinpajooh2026 ,
    entity:sampling-arcann-dinpajooh2026 .

entity:ds-pbe-dinpajooh2026 mlips:samplingStrategy
    entity:sampling-initial-dinpajooh2026 ,
    entity:sampling-arcann-dinpajooh2026 .

entity:ds-stage1-dinpajooh2026 mlips:samplingStrategy
    entity:sampling-initial-dinpajooh2026 ,
    entity:sampling-arcann-dinpajooh2026 .

entity:sampling-initial-dinpajooh2026 a mlips:SamplingStrategy ;
    rdfs:label "About 800 configurations selected at random from earlier ab initio MD of 2-4 M HNO3" .

entity:sampling-arcann-dinpajooh2026 a mlips:SamplingStrategy ;
    rdfs:label "ArcaNN iterations in three stages (NVT at 298 K; a volume scan with box lengths 14 to 17 A; NpT at 298 K and 1 bar): exploration MD in LAMMPS with and without OPES enhanced sampling on protonation and dimerisation, candidates with force deviation between 0.2 and 0.7 eV/A over three models, labelled with CP2K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-dinpajooh2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-rcut-smooth-dinpajooh2026 ,
        entity:hp-embedding-net-dinpajooh2026 ,
        entity:hp-fitting-net-dinpajooh2026 ,
        mlips:learningRate ,
        entity:hp-lr-decay-rate-dinpajooh2026 ,
        entity:hp-lr-decay-steps-dinpajooh2026 ,
        entity:hp-training-steps-dinpajooh2026 ;
    mlips:hasImplementation entity:impl-DeePMD-dinpajooh2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-DeePMD-dinpajooh2026 a mls:Algorithm ;
    rdfs:label "Learning rate decaying exponentially from 0.001 to 1e-6; ensembles of three models with different seeds in each ArcaNN iteration" .

entity:impl-DeePMD-dinpajooh2026 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-dinpajooh2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-dinpajooh2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-dinpajooh2026 ,
        mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-dinpajooh2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-dinpajooh2026 a mlips:LossFunction ;
    rdfs:label "Energy-force loss with forces weighted ten times the energies (no virial or stress data)" .

entity:alg-MACE-dinpajooh2026 a mls:Algorithm ;
    rdfs:label "Fine-tuning from the foundation model on a single GPU; stochastic weight averaging after 400 epochs and exponential moving average" .

entity:impl-MACE-dinpajooh2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:hp-rcut-smooth-dinpajooh2026 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential smoothing cutoff (Angstrom)" ;
    mlips:hyperparameterName "rcut_smth" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-embedding-net-dinpajooh2026 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential embedding network sizes" ;
    mlips:hyperparameterName "embedding_net" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-fitting-net-dinpajooh2026 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential fitting network sizes" ;
    mlips:hyperparameterName "fitting_net" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-training-steps-dinpajooh2026 a mlips:Hyperparameter ;
    rdfs:label "Number of training steps" ;
    mlips:hyperparameterName "training_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-rate-dinpajooh2026 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay rate" ;
    mlips:hyperparameterName "lr_decay_rate" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-steps-dinpajooh2026 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay steps" ;
    mlips:hyperparameterName "lr_decay_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-initialisation-dinpajooh2026 a mlips:Hyperparameter ;
    rdfs:label "Foundation model the fine-tuning starts from" ;
    mlips:hyperparameterName "initialisation" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

