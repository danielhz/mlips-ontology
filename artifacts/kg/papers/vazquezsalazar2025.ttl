entity:run-ens3-vazquezsalazar2025 a mlips:MLIPRun ;
    rdfs:label "Ensemble of three PhysNet models (models 1, 3, 5) (Ens-3)" ;
    mlips:appliesMethod entity:PhysNet ;
    mlips:runsOn entity:ds-train-vazquezsalazar2025 ;
    mlips:produces entity:model-ens3-vazquezsalazar2025 .

entity:model-ens3-vazquezsalazar2025 a mlips:TrainedModel ;
    rdfs:label "Ens-3 PhysNet PES" .

entity:run-ens6-vazquezsalazar2025 a mlips:MLIPRun ;
