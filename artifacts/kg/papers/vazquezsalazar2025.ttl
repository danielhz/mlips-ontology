# Canonical Turtle for the protocol-derived encoding of:
#   Luis Itza Vazquez-Salazar et al. (2025). Outlier-detection for reactive machine learned potential energy surfaces.
#   npj Computational Materials. doi:10.1038/s41524-024-01473-6  arXiv:2402.17686v1
#
# Version read: arxiv-preprint arXiv:2402.17686v1 (sha256 80ed06a262aa1601...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 324 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/vazquezsalazar2025.yaml.
#
# Encoding scope: PhysNet potentials for the syn-Criegee to vinyl
# hydroperoxide H-transfer reaction trained on 4,305 MP2/aug-cc-pVTZ
# structures, as ensembles (Ens-3, Ens-6), deep-evidential-regression
# variants (DER-S, DER-L, DER-M) and a Gaussian-mixture-model uncertainty
# head (GMM), with energy and force MAEs and RMSEs on the 33,402-structure
# hold-out test set (Table S1). Outlier-detection statistics are not
# error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-vazquezsalazar2025 a mlips:BenchmarkStudy ;
    rdfs:label "Vazquez-Salazar, Käser and Meuwly (2025): uncertainty-based outlier detection for reactive PhysNet potential energy surfaces" ;
    mlips:reportedIn entity:article-vazquezsalazar2025 .

entity:article-vazquezsalazar2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-024-01473-6> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Outlier-detection for reactive machine learned potential energy surfaces" ;
    schema:author <https://orcid.org/0000-0001-6347-5108> ,
        <https://orcid.org/0000-0002-3641-8519> ,
        <https://orcid.org/0000-0001-7930-8806> .

<https://orcid.org/0000-0001-6347-5108> a schema:Person ;
    schema:name "Luis Itza Vazquez-Salazar" ;
    schema:givenName "Luis Itza" ;
    schema:familyName "Vazquez-Salazar" ;
    schema:identifier <https://orcid.org/0000-0001-6347-5108> .

<https://orcid.org/0000-0002-3641-8519> a schema:Person ;
    schema:name "Silvan Käser" ;
    schema:givenName "Silvan" ;
    schema:familyName "Käser" ;
    schema:identifier <https://orcid.org/0000-0002-3641-8519> .

<https://orcid.org/0000-0001-7930-8806> a schema:Person ;
    schema:name "Markus Meuwly" ;
    schema:givenName "Markus" ;
    schema:familyName "Meuwly" ;
    schema:identifier <https://orcid.org/0000-0001-7930-8806> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-criegee-vazquezsalazar2025 a mlips:MaterialSystem ;
    rdfs:label "syn-Criegee intermediate, transition state and vinyl hydroperoxide (C2H4O2) along the H-transfer reaction" ;
    mlips:chemicalFormula "C2H4O2" ;
    mlips:materialClass "Reactive small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mp2-vazquezsalazar2025 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mp2-vazquezsalazar2025 mlips:hasWaveFunctionSettings entity:calc-settings-mp2-vazquezsalazar2025 .

entity:calc-settings-mp2-vazquezsalazar2025 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:MP2 ;
    mlips:basisSet "aug-cc-pVTZ" ;
    rdfs:comment "Reference data of earlier work (Ref. [34])." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-train-vazquezsalazar2025 a mlips:TrainingDataset ;
    rdfs:label "Final training data (4,305 structures; 80/20 training/validation)" ;
    mlips:coversMaterial entity:mat-criegee-vazquezsalazar2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4305 ;
    mlips:hasReferenceCalculation entity:calc-mp2-vazquezsalazar2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-train-vazquezsalazar2025 mlips:samplingStrategy
    entity:sampling-dmc-as-vazquezsalazar2025 .

entity:sampling-dmc-as-vazquezsalazar2025 a mlips:SamplingStrategy ;
    rdfs:label "Every 10th of 37,399 reaction structures (E < 400 kcal/mol), extended by diffusion Monte Carlo and adaptive sampling" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PhysNet a mlips:MLIPMethod ;
    rdfs:label "PhysNet (message-passing neural network for energies, forces, dipole moments and partial charges)" ;
    mlips:hasFunctionalForm entity:ff-PhysNet ;
    mlips:hasLossFunction entity:loss-PhysNet-vazquezsalazar2025 ;
    mlips:hasImplementation entity:impl-PhysNet-vazquezsalazar2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:ff-PhysNet a mlips:FunctionalForm ;
    rdfs:label "Message-passing neural network of stacked modular blocks with residual refinements over radial-basis-expanded interatomic distances; atomic energy and partial-charge outputs, optionally augmented with explicit long-range electrostatics and dispersion" .

entity:loss-PhysNet-vazquezsalazar2025 a mlips:LossFunction ;
    rdfs:label "Energies, forces and dipole moments (ensembles); DER variants add a normal-inverse-gamma (DER-S, DER-L) or normal-inverse-Wishart (DER-M) negative log-likelihood" .

entity:impl-PhysNet-vazquezsalazar2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PhysNet-vazquezsalazar2025 .

entity:lib-PhysNet-vazquezsalazar2025 a mlips:Library ;
    rdfs:label "PhysNet" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

