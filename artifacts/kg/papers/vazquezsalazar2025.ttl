entity:run-der-m-vazquezsalazar2025 a mlips:MLIPRun ;
    rdfs:label "PhysNet with multivariate deep evidential regression (DER-M)" ;
    mlips:appliesMethod entity:PhysNet ;
    mlips:runsOn entity:ds-train-vazquezsalazar2025 ;
    mlips:produces entity:model-der-m-vazquezsalazar2025 .

entity:model-der-m-vazquezsalazar2025 a mlips:TrainedModel ;
    rdfs:label "DER-M PhysNet PES" .

entity:run-gmm-vazquezsalazar2025 a mlips:MLIPRun ;
