# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-orbv3-zaghen2026 a mlips:MLIPRun ;
    rdfs:label "Orb-v3 pretrained model (variant not stated)" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orbv3-zaghen2026 .

entity:model-orbv3-zaghen2026 a mlips:TrainedModel ;
    rdfs:label "Orb-v3 (variant not stated)" .

entity:run-p-orb-zaghen2026 a mlips:MLIPRun ;
    rdfs:label "P-Orb: Orb-v3 fine-tuned with learned functional perturbations and CRPS" ;
    mlips:appliesMethod entity:ORB ;
    mlips:runsOn entity:ds-sio2-zaghen2026 ;
    mlips:produces entity:model-p-orb-zaghen2026 .

entity:model-p-orb-zaghen2026 a mlips:TrainedModel ;
    rdfs:label "P-Orb (silica)" .

entity:run-blip-orb-zaghen2026 a mlips:MLIPRun ;
    rdfs:label "BLIP-Orb: Orb-v3 fine-tuned with the BLIP variational method" ;
    mlips:appliesMethod entity:ORB ;
    mlips:runsOn entity:ds-sio2-zaghen2026 ;
    mlips:produces entity:model-blip-orb-zaghen2026 .

entity:model-blip-orb-zaghen2026 a mlips:TrainedModel ;
    rdfs:label "BLIP-Orb (silica)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-zaghen2026 mlips:hasResult
    entity:result-p-orb-test-zaghen2026 ,
    entity:result-blip-orb-test-zaghen2026 .

entity:result-p-orb-test-zaghen2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-p-orb-zaghen2026 ;
    mlips:targetMaterial entity:mat-sio2-zaghen2026 ;
    mlips:hasAccuracyMetric entity:metric-p-orb-test-1-zaghen2026 .

entity:metric-p-orb-test-1-zaghen2026 a mlips:AccuracyMetric ;
    rdfs:label "test force MAE on sio2: P-Orb" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "1.38"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-blip-orb-test-zaghen2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-blip-orb-zaghen2026 ;
    mlips:targetMaterial entity:mat-sio2-zaghen2026 ;
    mlips:hasAccuracyMetric entity:metric-blip-orb-test-1-zaghen2026 .

entity:metric-blip-orb-test-1-zaghen2026 a mlips:AccuracyMetric ;
    rdfs:label "test force MAE on sio2: BLIP-Orb" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "1.61"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

