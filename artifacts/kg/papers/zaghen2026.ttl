###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-sio2-zaghen2026 a mlips:TrainingDataset ;
    rdfs:label "Silica-glass benchmark of Coscia et al. (2025), 1,024 training structures" ;
    mlips:coversMaterial entity:mat-sio2-zaghen2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:hasLossFunction entity:loss-ORB-zaghen2026 .

entity:loss-ORB-zaghen2026 a mlips:LossFunction ;
    rdfs:label "Continuous Ranked Probability Score on energies and forces (P-Orb); MSE + KL (BLIP-Orb)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

