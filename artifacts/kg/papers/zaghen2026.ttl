# Canonical Turtle for the protocol-derived encoding of:
#   Olga Zaghen et al. (2026). Uncertainty-aware Machine Learning Interatomic Potentials via Learned Functional Perturbations.
#   arXiv (Cornell University). doi:10.48550/arxiv.2605.19939  arXiv:2605.19939v2
#
# Version read: arxiv-preprint arXiv:2605.19939v2 (sha256 b4bf1833303a8505...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 452 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/zaghen2026.yaml.
#
# Encoding scope: the silica-glass experiment: an Orb-v3 foundation model
# fine-tuned on the SiO2 benchmark of Coscia et al. (2025) as P-Orb
# (learned weight perturbations, CRPS loss) and as BLIP-Orb (variational
# baseline), with the test force MAEs at 1,024 training structures
# (Table 2). The N-body experiment (EGNN predicting particle positions)
# is not an interatomic-potential task and is not encoded; CRPS,
# spread-to-skill ratios and Spearman correlations are UQ metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zaghen2026 a mlips:BenchmarkStudy ;
    rdfs:label "Zaghen et al. (2026): uncertainty-aware MLIPs via learned functional perturbations trained with the CRPS (P-EGNN, P-Orb)" ;
    mlips:reportedIn entity:article-zaghen2026 .

entity:article-zaghen2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2605.19939> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Uncertainty-aware Machine Learning Interatomic Potentials via Learned Functional Perturbations" ;
    schema:author entity:person-Zaghen-zaghen2026 ,
        entity:person-Zhdanov-zaghen2026 ,
        entity:person-Coscia-zaghen2026 ,
        entity:person-Wessels-zaghen2026 ,
        entity:person-Bekkers-zaghen2026 .

entity:person-Zaghen-zaghen2026 a schema:Person ;
    schema:name "Olga Zaghen" ;
    schema:givenName "Olga" ;
    schema:familyName "Zaghen" .

entity:person-Zhdanov-zaghen2026 a schema:Person ;
    schema:name "Maksim Zhdanov" ;
    schema:givenName "Maksim" ;
    schema:familyName "Zhdanov" .

entity:person-Coscia-zaghen2026 a schema:Person ;
    schema:name "Dario Coscia" ;
    schema:givenName "Dario" ;
    schema:familyName "Coscia" .

entity:person-Wessels-zaghen2026 a schema:Person ;
    schema:name "David R. Wessels" ;
    schema:givenName "David R." ;
    schema:familyName "Wessels" .

entity:person-Bekkers-zaghen2026 a schema:Person ;
    schema:name "Erik J. Bekkers" ;
    schema:givenName "Erik J." ;
    schema:familyName "Bekkers" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sio2-zaghen2026 a mlips:MaterialSystem ;
    rdfs:label "Silica glass (699 atoms per structure)" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "Amorphous metal oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

