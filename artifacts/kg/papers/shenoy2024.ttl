###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-fecrni-shenoy2024 a mlips:MaterialSystem ;
    rdfs:label "Fe7Cr2Ni austenitic alloy: bulk (256 atoms) and monovacancy (255 atoms) supercells with short-range order, strained and high-temperature configurations" ;
    mlips:materialClass "High-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-shenoy2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-shenoy2024 mlips:hasDFTSettings entity:calc-settings-pbe-shenoy2024 .

entity:calc-settings-pbe-shenoy2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "3x3x3" ;
    rdfs:comment "Collinear spin-polarised with single-layer AFM ordering imposed; 8, 6 and 10 valence electrons for Fe, Cr, Ni; EDIFF 1e-7 eV (Sec. II C)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-db-shenoy2024 a mlips:TrainingDataset ;
    rdfs:label "Fe7Cr2Ni training database DB1-DB8 (training and test split)" ;
    mlips:coversMaterial entity:mat-fecrni-shenoy2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-shenoy2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-db-shenoy2024 mlips:samplingStrategy
    entity:sampling-em-shenoy2024 .

entity:sampling-em-shenoy2024 a mlips:SamplingStrategy ;
    rdfs:label "Lattice Monte Carlo with KKR-CPA S(2) pair interchange parameters at 600-2000 K, then DFT relaxation; random strains, relaxation snapshots, AIMD at 1000-2000 K and intermediate geometry-optimisation snapshots (DB1-8)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-shenoy2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:MonteCarlo .

entity:impl-GAP-shenoy2024 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-cutoffRadius-shenoy2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-gap-numSparseConfigs-shenoy2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "800"^^xsd:integer .

entity:setting-spin-gap-cutoffRadius-shenoy2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-spin-gap-numSparseConfigs-shenoy2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "800"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-shenoy2024 a mlips:MLIPRun ;
    rdfs:label "GAP (2-body Gaussian kernel with 100 sparse points + SOAP with 800 sparse points, nmax = lmax = 10, zeta 4)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-db-shenoy2024 ;
    mlips:hasHyperparameterSetting entity:setting-gap-cutoffRadius-shenoy2024 ,
        entity:setting-gap-numSparseConfigs-shenoy2024 ;
    mlips:produces entity:model-gap-shenoy2024 .

entity:model-gap-shenoy2024 a mlips:TrainedModel ;
    rdfs:label "Fe7Cr2Ni GAP" .

entity:run-spin-gap-shenoy2024 a mlips:MLIPRun ;
    rdfs:label "Spin GAP: GAP with collinear Fe spin information in the descriptors" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-db-shenoy2024 ;
    mlips:hasHyperparameterSetting entity:setting-spin-gap-cutoffRadius-shenoy2024 ,
        entity:setting-spin-gap-numSparseConfigs-shenoy2024 ;
    mlips:produces entity:model-spin-gap-shenoy2024 .

entity:model-spin-gap-shenoy2024 a mlips:TrainedModel ;
    rdfs:label "Fe7Cr2Ni Spin GAP" .

entity:run-cgap-shenoy2024 a mlips:MLIPRun ;
    rdfs:label "Compressed GAP (compressed SOAP descriptors)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-db-shenoy2024 ;
    mlips:produces entity:model-cgap-shenoy2024 .

entity:model-cgap-shenoy2024 a mlips:TrainedModel ;
    rdfs:label "Fe7Cr2Ni compressed GAP" .

