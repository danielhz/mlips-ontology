    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mp0b-d3-cutoffRadius-nasir2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-mp0b-d3-numLayers-nasir2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-mp0b-d3-numRadialBasis-nasir2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "10"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mp0b-d3-nasir2025 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0 medium, release 0b (agnesi), with D3 dispersion, as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:hasHyperparameterSetting entity:setting-mp0b-d3-cutoffRadius-nasir2025 ,
        entity:setting-mp0b-d3-numLayers-nasir2025 ,
        entity:setting-mp0b-d3-numRadialBasis-nasir2025 ;
    mlips:produces entity:model-mp0b-d3-nasir2025 .

entity:model-mp0b-d3-nasir2025 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b medium (agnesi) + D3" .

