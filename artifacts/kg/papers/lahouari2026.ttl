###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d4-lahouari2026 mlips:hasDFTSettings entity:calc-settings-pbe-d4-lahouari2026 .

entity:calc-settings-pbe-d4-lahouari2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "650"^^xsd:double ;
    rdfs:comment "Grimme D4 dispersion; Gamma-centred Monkhorst-Pack meshes scaled to the cell; EDIFF 1e-7 eV; Fermi smearing 0.05 eV (Tables S1, S2)." .

