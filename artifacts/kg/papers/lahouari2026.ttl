###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-lahouari2026 ;
    mlips:hasImplementation entity:impl-MACE-lahouari2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-MACE-lahouari2026 a mls:Algorithm ;
    rdfs:label "Adam with AMSGrad, early stopping, then stochastic weight averaging; float64" .

entity:impl-MACE-lahouari2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

