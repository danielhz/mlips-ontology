###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-al-cui-kang2025accelerating mlips:samplingStrategy
    entity:sampling-almomd-kang2025accelerating .

entity:ds-al-agse-kang2025accelerating mlips:samplingStrategy
    entity:sampling-almomd-kang2025accelerating .

entity:sampling-almomd-kang2025accelerating a mlips:SamplingStrategy ;
    rdfs:label "ALmoMD active learning: NVT MLIP-MD at 300 K, sampling by probability functions of the uncertainty (energy, maximum force or degree of anharmonicity) and of the potential energy; 30 new DFT points per step (25 training, 5 validation initially)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-kang2025accelerating ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-NequIP-kang2025accelerating ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation .

entity:loss-NequIP-kang2025accelerating a mlips:LossFunction ;
    rdfs:label "Per-atom energy MSE and force MSE in a 1:1 ratio" .

entity:impl-NequIP-kang2025accelerating a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

