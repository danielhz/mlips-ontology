###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-anh-kang2025accelerating a mlips:MaterialSystem ;
    rdfs:label "112 bulk materials with strong anharmonicity (e.g. CuI, AgGaSe2, AgGaS2, InNaO2, CsBr, CsCl, LiBr, LiCl, LiI, Na2Te) in 160-256-atom supercells" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbesol-kang2025accelerating a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbesol-kang2025accelerating mlips:hasDFTSettings entity:calc-settings-pbesol-kang2025accelerating .

entity:calc-settings-pbesol-kang2025accelerating a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional entity:xc-PBEsol-kang2025accelerating ;
    rdfs:comment "All-electron FHI-aims with light default basis, same k-point densities as the original aiMD data (Refs. 59, 71)." .

entity:xc-PBEsol-kang2025accelerating a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aimd-kang2025accelerating a mlips:TrainingDataset ;
    rdfs:label "aiMD trajectories of 112 materials (PBEsol; Knoop et al. data repository)" ;
    mlips:coversMaterial entity:mat-anh-kang2025accelerating ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbesol-kang2025accelerating .

entity:ds-al-cui-kang2025accelerating a mlips:TrainingDataset ;
    rdfs:label "CuI data from ALmoMD with maximum-force uncertainty" ;
    mlips:coversMaterial entity:mat-anh-kang2025accelerating ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbesol-kang2025accelerating .

entity:ds-al-agse-kang2025accelerating a mlips:TrainingDataset ;
    rdfs:label "AgGaSe2 data from ALmoMD with maximum-force uncertainty" ;
    mlips:coversMaterial entity:mat-anh-kang2025accelerating ;
    mlips:coversProperty mlips:Energy ,
