# Canonical Turtle for the protocol-derived encoding of:
#   Tsz Wai Ko et al. (2025). Data-efficient construction of high-fidelity graph deep learning interatomic potentials.
#   npj Computational Materials. doi:10.1038/s41524-025-01550-4  arXiv:2409.00957v1
#
# Version read: arxiv-preprint arXiv:2409.00957v1 (sha256 0194ff501e2c31dc...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 410 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ko2025.yaml.
#
# Encoding scope: multi-fidelity (mfi) M3GNet models, with the fidelity
# embedded in the global state, trained on 80 % of low-fidelity data
# (PBE for silicon, RPBE for water) plus a fraction of SCAN data, and
# single-fidelity (1fi) SCAN baselines; test MAEs stated in the text or
# printed in Fig. 5, and the GAP-18 transfer test for silicon. Equations
# of state, amorphous-silicon structure, water RDFs and ice relaxations
# are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ko2025 a mlips:BenchmarkStudy ;
    rdfs:label "Ko and Ong (2025): data-efficient multi-fidelity M3GNet potentials trained on PBE/RPBE plus a small fraction of SCAN data (silicon and water)" ;
    mlips:reportedIn entity:article-ko2025 .

entity:article-ko2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01550-4> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Data-efficient construction of high-fidelity graph deep learning interatomic potentials" ;
    schema:author entity:person-Ko-ko2025 ,
        entity:person-Ong-ko2025 .

entity:person-Ko-ko2025 a schema:Person ;
    schema:name "Tsz Wai Ko" ;
    schema:givenName "Tsz Wai" ;
    schema:familyName "Ko" .

entity:person-Ong-ko2025 a schema:Person ;
    schema:name "Shyue Ping Ong" ;
    schema:givenName "Shyue Ping" ;
    schema:familyName "Ong" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-si-ko2025 a mlips:MaterialSystem ;
    rdfs:label "Silicon: crystalline polymorphs, distorted and defective diamond, amorphous and liquid structures" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental semiconductor" .

entity:mat-water-ko2025 a mlips:MaterialSystem ;
    rdfs:label "Liquid water and ice" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-si-pbe-ko2025 a mlips:DFTCalculation .

entity:calc-scan-ko2025 a mlips:DFTCalculation .

entity:calc-rpbe-ko2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-si-pbe-ko2025 mlips:hasDFTSettings entity:calc-settings-si-pbe-ko2025 .

entity:calc-settings-si-pbe-ko2025 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Low-fidelity silicon data (Ref. 38)." .

entity:calc-scan-ko2025 mlips:hasDFTSettings entity:calc-settings-scan-ko2025 .

entity:calc-settings-scan-ko2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:SCAN ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "High-fidelity SCAN data (silicon, Ref. 38; water, Ref. 47); VASP 6.3.2 for new calculations." .

entity:calc-rpbe-ko2025 mlips:hasDFTSettings entity:calc-settings-rpbe-ko2025 .

entity:calc-settings-rpbe-ko2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-RPBE-ko2025 ;
    rdfs:comment "Low-fidelity water data (Zenodo record 2634098)." .

entity:xc-RPBE-ko2025 a mlips:XCFunctional ;
    rdfs:label "RPBE" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-si-mfi-direct-ko2025 a mlips:TrainingDataset ;
    rdfs:label "Silicon: 80 % PBE + 10 % SCAN (DIRECT-sampled)" ;
    mlips:coversMaterial entity:mat-si-ko2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-scan-ko2025 .

entity:ds-si-mfi-random-ko2025 a mlips:TrainingDataset ;
    rdfs:label "Silicon: 80 % PBE + 10 % SCAN (random)" ;
    mlips:coversMaterial entity:mat-si-ko2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-scan-ko2025 .

entity:ds-si-mfi-narrow-ko2025 a mlips:TrainingDataset ;
    rdfs:label "Silicon: 80 % PBE + 10 % SCAN (narrow)" ;
    mlips:coversMaterial entity:mat-si-ko2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-scan-ko2025 .

entity:ds-si-1fi-10-ko2025 a mlips:TrainingDataset ;
    rdfs:label "Silicon: 10 % SCAN only" ;
    mlips:coversMaterial entity:mat-si-ko2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-scan-ko2025 .

entity:ds-w-mfi-10-ko2025 a mlips:TrainingDataset ;
    rdfs:label "Water: 80 % RPBE + 10 % SCAN (random)" ;
    mlips:coversMaterial entity:mat-water-ko2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-scan-ko2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-si-mfi-direct-ko2025 mlips:samplingStrategy
    entity:sampling-direct-ko2025 .

entity:ds-si-mfi-random-ko2025 mlips:samplingStrategy
    entity:sampling-random-ko2025 .

entity:ds-si-mfi-narrow-ko2025 mlips:samplingStrategy
    entity:sampling-narrow-ko2025 .

entity:ds-w-mfi-10-ko2025 mlips:samplingStrategy
    entity:sampling-random-ko2025 .

entity:sampling-direct-ko2025 a mlips:SamplingStrategy ;
    rdfs:label "DIRECT sampling (M3GNet-encoded features, PCA, clustering, stratified selection) of the SCAN fraction" .

entity:sampling-random-ko2025 a mlips:SamplingStrategy ;
    rdfs:label "Random selection of the SCAN fraction" .

entity:sampling-narrow-ko2025 a mlips:SamplingStrategy ;
    rdfs:label "Narrow selection: mostly diamond-type structures with distortions, strains and defects" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:hasLossFunction entity:loss-M3GNet-ko2025 ;
    mlips:hasTrainingAlgorithm entity:alg-M3GNet-ko2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-M3GNet-ko2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-M3GNet-ko2025 a mlips:LossFunction ;
    rdfs:label "MSE of energy per atom plus weighted MSE of force components" .

entity:alg-M3GNet-ko2025 a mls:Algorithm ;
    rdfs:label "Adam with cosine decay to 1 % in 100 epochs; early stopping after 200 epochs without improvement" .

entity:impl-M3GNet-ko2025 a mlips:Implementation ;
    mlips:implementedIn mlips:M3GNet .

