# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-C-entropy-100-wang2026 a mlips:MLIPRun ;
    rdfs:label "Allegro-OAM-L fine-tuned on 100 Carbon structures from the entropy pool (three seeds)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-C-entropy-wang2026 ;
    mlips:hasHyperparameterSetting entity:setting-C-entropy-100-learningRate-wang2026 ,
        entity:setting-C-entropy-100-batchSize-wang2026 ;
    mlips:produces entity:model-C-entropy-100-wang2026 .

entity:model-C-entropy-100-wang2026 a mlips:TrainedModel ;
    rdfs:label "Allegro-OAM-L fine-tuned, Carbon, entropy, N = 100" .

