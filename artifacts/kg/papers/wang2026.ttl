# Canonical Turtle for the protocol-derived encoding of:
#   Meiyan Wang et al. (2026). Dataset-aware entropy-maximized active learning for machine-learned interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2605.20384  arXiv:2605.20384v1
#
# Version read: arxiv-preprint arXiv:2605.20384v1 (sha256 ae6cbfbe75821191...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 294 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wang2026.yaml.
#
# Encoding scope: Allegro-OAM-L fine-tuned on N = 100, 250, 500 or 800
# structures drawn either from the entropy-driven active-learning pool or
# from random-MD pools for carbon (r2SCAN+rVV10), silicon and NaCl (PBE),
# with in-distribution test MAEs (Tables 1-3; means over three seeds), the
# curated independent-test MAEs at N = 800 (Table 4) and the carbon mixed
# 80/20 pool (Table 5). Phonon comparisons are not error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wang2026 a mlips:BenchmarkStudy ;
    rdfs:label "Wang, Rao and Zhu (2026): dataset-aware entropy-maximised active learning with Allegro-OAM-L fine-tuning" ;
    mlips:reportedIn entity:article-wang2026 .

entity:article-wang2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2605.20384> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Dataset-aware entropy-maximized active learning for machine-learned interatomic potentials" ;
    schema:author entity:person-Wang-wang2026 ,
        entity:person-Rao-wang2026 ,
        entity:person-Zhu-wang2026 .

entity:person-Wang-wang2026 a schema:Person ;
    schema:name "Meiyan Wang" ;
    schema:givenName "Meiyan" ;
    schema:familyName "Wang" .

entity:person-Rao-wang2026 a schema:Person ;
    schema:name "Rishi Rao" ;
    schema:givenName "Rishi" ;
    schema:familyName "Rao" .

entity:person-Zhu-wang2026 a schema:Person ;
    schema:name "Li Zhu" ;
    schema:givenName "Li" ;
    schema:familyName "Zhu" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-C-wang2026 a mlips:MaterialSystem ;
    rdfs:label "Carbon polymorphs (diamond, graphite, lonsdaleite, M-carbon and other allotropes) at 0-100 GPa" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental covalent solid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q623> .

entity:mat-Si-wang2026 a mlips:MaterialSystem ;
    rdfs:label "Silicon (diamond cubic, beta-tin, Imma, simple hexagonal) at 0-20 GPa" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental semiconductor" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q670> .

entity:mat-NaCl-wang2026 a mlips:MaterialSystem ;
    rdfs:label "Sodium chloride (B1 rocksalt and B2 CsCl-type) at 0-40 GPa" ;
    mlips:chemicalFormula "NaCl" ;
    mlips:materialClass "Ionic crystal" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q2314> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scan-rvv10-wang2026 a mlips:DFTCalculation .

entity:calc-pbe-wang2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scan-rvv10-wang2026 mlips:hasDFTSettings entity:calc-settings-r2scan-rvv10-wang2026 .

entity:calc-settings-r2scan-rvv10-wang2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-rVV10-wang2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, density 40 1/A" ;
    rdfs:comment "BPARAM 11.95; Gaussian smearing 0.05 eV; EDIFF 1e-6 (carbon)." .

entity:calc-pbe-wang2026 mlips:hasDFTSettings entity:calc-settings-pbe-wang2026 .

entity:calc-settings-pbe-wang2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, density 40 1/A" ;
    rdfs:comment "Gaussian smearing 0.05 eV; EDIFF 1e-6 (silicon, NaCl)." .

entity:xc-r2SCAN-rVV10-wang2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN+rVV10" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-C-entropy-wang2026 a mlips:TrainingDataset ;
    rdfs:label "Carbon entropy-driven pool (814 DFT-labelled structures)" ;
    mlips:coversMaterial entity:mat-C-wang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 814 ;
    mlips:hasDFTCalculation entity:calc-r2scan-rvv10-wang2026 .

entity:ds-C-random-wang2026 a mlips:TrainingDataset ;
    rdfs:label "Carbon random-MD pool (1536 DFT-labelled structures)" ;
    mlips:coversMaterial entity:mat-C-wang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1536 ;
    mlips:hasDFTCalculation entity:calc-r2scan-rvv10-wang2026 .

entity:ds-Si-entropy-wang2026 a mlips:TrainingDataset ;
    rdfs:label "Silicon entropy-driven pool (645 DFT-labelled structures)" ;
    mlips:coversMaterial entity:mat-Si-wang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 645 ;
    mlips:hasDFTCalculation entity:calc-pbe-wang2026 .

entity:ds-Si-random-wang2026 a mlips:TrainingDataset ;
    rdfs:label "Silicon random-MD pool (594 DFT-labelled structures)" ;
    mlips:coversMaterial entity:mat-Si-wang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 594 ;
    mlips:hasDFTCalculation entity:calc-pbe-wang2026 .

entity:ds-NaCl-entropy-wang2026 a mlips:TrainingDataset ;
    rdfs:label "NaCl entropy-driven pool (524 DFT-labelled structures)" ;
    mlips:coversMaterial entity:mat-NaCl-wang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 524 ;
    mlips:hasDFTCalculation entity:calc-pbe-wang2026 .

entity:ds-NaCl-random-wang2026 a mlips:TrainingDataset ;
    rdfs:label "NaCl random-MD pool (557 DFT-labelled structures)" ;
    mlips:coversMaterial entity:mat-NaCl-wang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 557 ;
    mlips:hasDFTCalculation entity:calc-pbe-wang2026 .

entity:ds-C-mixed-wang2026 a mlips:TrainingDataset ;
    rdfs:label "Carbon mixed pool: 640 entropy-driven plus 160 near-equilibrium (max |F| < 2 eV/A) random-MD structures" ;
    mlips:coversMaterial entity:mat-C-wang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 800 ;
    mlips:hasDFTCalculation entity:calc-r2scan-rvv10-wang2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-C-entropy-wang2026 mlips:samplingStrategy
    entity:sampling-entropy-wang2026 .

entity:ds-C-random-wang2026 mlips:samplingStrategy
    entity:sampling-random-md-wang2026 .

entity:ds-Si-entropy-wang2026 mlips:samplingStrategy
    entity:sampling-entropy-wang2026 .

entity:ds-Si-random-wang2026 mlips:samplingStrategy
    entity:sampling-random-md-wang2026 .

entity:ds-NaCl-entropy-wang2026 mlips:samplingStrategy
    entity:sampling-entropy-wang2026 .

entity:ds-NaCl-random-wang2026 mlips:samplingStrategy
    entity:sampling-random-md-wang2026 .

entity:ds-C-mixed-wang2026 mlips:samplingStrategy
    entity:sampling-entropy-wang2026 ,
    entity:sampling-random-md-wang2026 .

entity:sampling-entropy-wang2026 a mlips:SamplingStrategy ;
    rdfs:label "Entropy-biased NVT MD (local fingerprint entropy) with global log-det dataset-entropy filtering, started from Allegro-OAM-L and pre-scaled seed cells over a temperature-pressure grid" .

entity:sampling-random-md-wang2026 a mlips:SamplingStrategy ;
    rdfs:label "Unbiased NVT Langevin MD with Allegro-OAM-L over the same condition grid" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-wang2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-wang2026 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-Allegro-wang2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-Allegro-wang2026 a mlips:LossFunction ;
    rdfs:label "Huber loss, energy 1.0, forces 1.0, stress 0.01; energy-binned sample weights (3.0, 1.0, 0.5)" .

entity:alg-Allegro-wang2026 a mls:Algorithm ;
    rdfs:label "Full fine-tuning with Adam, ReduceLROnPlateau (patience 15, factor 0.5), EMA 0.999, gradient clipping 0.015, early stopping (patience 30)" .

entity:impl-Allegro-wang2026 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

