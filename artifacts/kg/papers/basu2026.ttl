# Canonical Turtle for the protocol-derived encoding of:
#   Abhinaba Basu et al. (2026). Proof-Carrying Materials: Falsifiable Safety Certificates for Machine-Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2603.12183  arXiv:2603.12183v2
#
# Version read: arxiv-preprint arXiv:2603.12183v2 (sha256 392e0aa883bcab45...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 331 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/basu2026.yaml.
#
# Encoding scope: three pretrained universal MLIPs (CHGNet 0.3.0,
# TensorNet MatPES-PBE-v2025.1, MACE-MP medium) audited for failures on
# synthetic compositional probes of WBM materials (force failure threshold
# 50 eV/A). Results are failure rates, correlations, classifier AUCs and
# discovery yields, not energy/force error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-basu2026 a mlips:BenchmarkStudy ;
    rdfs:label "Basu and Chakraborty (2026): Proof-Carrying Materials, adversarial auditing and Lean 4 certification of universal MLIPs" ;
    mlips:reportedIn entity:article-basu2026 .

entity:article-basu2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2603.12183> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Proof-Carrying Materials: Falsifiable Safety Certificates for Machine-Learned Interatomic Potentials" ;
    schema:author entity:person-Basu-basu2026 ,
        entity:person-Chakraborty-basu2026 .

entity:person-Basu-basu2026 a schema:Person ;
    schema:name "Abhinaba Basu" ;
    schema:givenName "Abhinaba" ;
    schema:familyName "Basu" .

entity:person-Chakraborty-basu2026 a schema:Person ;
    schema:name "Pavan Chakraborty" ;
    schema:givenName "Pavan" ;
    schema:familyName "Chakraborty" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-wbm-basu2026 a mlips:MaterialSystem ;
    rdfs:label "WBM materials (25,000 sampled of 257K) as synthetic compositional probes with golden-ratio fractional coordinates and DFT cell volumes" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qe-basu2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qe-basu2026 mlips:hasDFTSettings entity:calc-settings-qe-basu2026 .

entity:calc-settings-qe-basu2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "4x4x4" ;
    rdfs:comment "Quantum ESPRESSO 6.7, SSSP 1.3.0 efficiency, 60/480 Ry, cold smearing 0.01 Ry; validation of 20 DFT-stable/CHGNet-unstable materials." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" .

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chgnet-basu2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet v0.3.0 as distributed" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-basu2026 .

entity:model-chgnet-basu2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet v0.3.0" .

entity:run-tensornet-basu2026 a mlips:MLIPRun ;
    rdfs:label "TensorNet MatPES-PBE-v2025.1-PES as distributed (matgl 2.0.6)" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:produces entity:model-tensornet-basu2026 .

entity:model-tensornet-basu2026 a mlips:TrainedModel ;
    rdfs:label "TensorNet MatPES-PBE-v2025.1-PES" .

entity:run-mace-mp-basu2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP medium as distributed (mace-torch)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp-basu2026 .

entity:model-mace-mp-basu2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP medium" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# No MLIP timings are given (each QE validation SCF ran on 8 CPU cores).

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Failure rates (force above 50 eV/A on far-from-equilibrium probes), pairwise force correlations, stability recall and AUC-ROC values of the risk classifier are not energy/force/stress error metrics.
# - The MACE-MP medium release (0, 0a, 0b) is not stated, so it is a paper-local run.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: datacite).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/basu2026.yaml) until the schema has terms for them.
