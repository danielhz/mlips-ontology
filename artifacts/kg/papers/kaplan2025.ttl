entity:run-m3gnet-pbe-kaplan2025 a mlips:MLIPRun ;
    rdfs:label "M3GNet trained on MatPES PBE" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:runsOn entity:ds-matpes-pbe-kaplan2025 ;
    mlips:hasHyperparameterSetting entity:setting-m3gnet-pbe-cutoffRadius-kaplan2025 ,
        entity:setting-m3gnet-pbe-numFeatures-kaplan2025 ,
        entity:setting-m3gnet-pbe-numLayers-kaplan2025 ,
        entity:setting-m3gnet-pbe-learningRate-kaplan2025 ;
    mlips:produces entity:model-m3gnet-pbe-kaplan2025 .

