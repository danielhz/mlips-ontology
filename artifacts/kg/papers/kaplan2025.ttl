# Canonical Turtle for the protocol-derived encoding of:
#   Aaron D. Kaplan et al. (2025). A Foundational Potential Energy Surface Dataset for Materials.
#   arXiv. doi:10.48550/arxiv.2503.04070  arXiv:2503.04070v1
#
# Version read: arxiv-preprint arXiv:2503.04070v1 (sha256 4d3e14476a18f92b...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 223 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/kaplan2025.yaml.
#
# Encoding scope: the MatPES data set introduced here (PBE and r2SCAN
# subsets) and the universal MLIPs trained in MatGL on MatPES, MPF, MPtrj
# and OMat24 (Table 1): validation and test MAEs of energy, force and
# stress; the CPU timings of Table S5. The property benchmarks
# (MatCalc-Benchmark, Table S4 and figures), magnetic-moment errors and
# training-set MAEs are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kaplan2025 a mlips:BenchmarkStudy ;
    rdfs:label "Kaplan et al. (2025): MatPES, a foundational potential energy surface data set for materials" ;
    mlips:reportedIn entity:article-kaplan2025 .

entity:article-kaplan2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2503.04070> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "A Foundational Potential Energy Surface Dataset for Materials" ;
    schema:author entity:person-Kaplan-kaplan2025 ,
        entity:person-Liu-kaplan2025 ,
        entity:person-Qi-kaplan2025 ,
        entity:person-Ko-kaplan2025 ,
        entity:person-Deng-kaplan2025 ,
        entity:person-Riebesell-kaplan2025 ,
        entity:person-Ceder-kaplan2025 ,
        entity:person-Persson-kaplan2025 ,
        entity:person-Ong-kaplan2025 .

entity:person-Kaplan-kaplan2025 a schema:Person ;
    schema:name "Aaron D. Kaplan" ;
    schema:givenName "Aaron D." ;
    schema:familyName "Kaplan" .

entity:person-Liu-kaplan2025 a schema:Person ;
    schema:name "Runze Liu" ;
    schema:givenName "Runze" ;
    schema:familyName "Liu" .

entity:person-Qi-kaplan2025 a schema:Person ;
    schema:name "Ji Qi" ;
    schema:givenName "Ji" ;
    schema:familyName "Qi" .

entity:person-Ko-kaplan2025 a schema:Person ;
    schema:name "Tsz Wai Ko" ;
    schema:givenName "Tsz Wai" ;
    schema:familyName "Ko" .

entity:person-Deng-kaplan2025 a schema:Person ;
    schema:name "Bowen Deng" ;
    schema:givenName "Bowen" ;
    schema:familyName "Deng" .

entity:person-Riebesell-kaplan2025 a schema:Person ;
    schema:name "Janosh Riebesell" ;
    schema:givenName "Janosh" ;
    schema:familyName "Riebesell" .

entity:person-Ceder-kaplan2025 a schema:Person ;
    schema:name "Gerbrand Ceder" ;
    schema:givenName "Gerbrand" ;
    schema:familyName "Ceder" .

entity:person-Persson-kaplan2025 a schema:Person ;
    schema:name "Kristin A. Persson" ;
    schema:givenName "Kristin A." ;
    schema:familyName "Persson" .

entity:person-Ong-kaplan2025 a schema:Person ;
    schema:name "Shyue Ping Ong" ;
    schema:givenName "Shyue Ping" ;
    schema:familyName "Ong" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-inorganic-kaplan2025 a mlips:MaterialSystem ;
    rdfs:label "Inorganic materials across the periodic table (Materials Project ground states and their 300 K MD snapshots)" ;
    mlips:materialClass "Inorganic crystalline materials (equilibrium and 300 K MD)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-kaplan2025 a mlips:DFTCalculation .

entity:calc-r2scan-kaplan2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-kaplan2025 mlips:hasDFTSettings entity:calc-settings-pbe-kaplan2025 .

entity:calc-settings-pbe-kaplan2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "VASP 6.4.x, PBE 64 pseudopotentials, MatPESStaticSet (pymatgen) settings, Gaussian smearing with pseudo-entropy below 1 meV/atom (Methods; Tables S6, S7)." .

entity:calc-r2scan-kaplan2025 mlips:hasDFTSettings entity:calc-settings-r2scan-kaplan2025 .

entity:calc-settings-r2scan-kaplan2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-kaplan2025 ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "r2SCAN started from self-consistent PBE orbitals; same settings otherwise." .

entity:xc-r2SCAN-kaplan2025 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-matpes-pbe-kaplan2025 a mlips:TrainingDataset ;
    rdfs:label "MatPES PBE (434,712 structures; 90% training)" ;
    mlips:coversMaterial entity:mat-inorganic-kaplan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 434712 ;
    mlips:hasDFTCalculation entity:calc-pbe-kaplan2025 ;
    rdfs:comment "Random 90/5/5 training/validation/test split; the test set has 21,737 structures." .

entity:ds-matpes-r2scan-kaplan2025 a mlips:TrainingDataset ;
    rdfs:label "MatPES r2SCAN (387,897 structures; 90% training)" ;
    mlips:coversMaterial entity:mat-inorganic-kaplan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 387897 ;
    mlips:hasDFTCalculation entity:calc-r2scan-kaplan2025 .

entity:ds-mpf-kaplan2025 a mlips:TrainingDataset ;
    rdfs:label "MPF (185,877 structures)" ;
    mlips:coversMaterial entity:mat-inorganic-kaplan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 185877 .

entity:ds-mptrj-kaplan2025 a mlips:TrainingDataset ;
    rdfs:label "MPtrj (1,580,395 structures)" ;
    mlips:coversMaterial entity:mat-inorganic-kaplan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1580395 .

entity:ds-omat24-kaplan2025 a mlips:TrainingDataset ;
    rdfs:label "OMat24 training split (100,824,585 structures)" ;
    mlips:coversMaterial entity:mat-inorganic-kaplan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 100824585 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-matpes-pbe-kaplan2025 mlips:samplingStrategy
    entity:sampling-md-2direct-kaplan2025 .

entity:ds-matpes-r2scan-kaplan2025 mlips:samplingStrategy
    entity:sampling-md-2direct-kaplan2025 .

entity:sampling-md-2direct-kaplan2025 a mlips:SamplingStrategy ;
    rdfs:label "M3GNet NpT MD at 300 K of Materials Project structures and supercells, 2DIRECT sampling" ;
    rdfs:comment "281,853,572 MD snapshots of 281,572 initial structures, clustered in M3GNet structural and atomic feature space (15,192 structural clusters); the smallest structure per cluster was computed with DFT (Methods)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:hasLossFunction entity:loss-M3GNet-kaplan2025 ;
    mlips:hasTrainingAlgorithm entity:alg-M3GNet-kaplan2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-M3GNet-kaplan2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-M3GNet-kaplan2025 a mlips:LossFunction ;
    rdfs:label "L1 loss on energy, force and stress (stress weight 0.1)" .

entity:alg-M3GNet-kaplan2025 a mls:Algorithm ;
    rdfs:label "AMSGrad AdamW, learning rate 1e-3 down to 1e-5" .

entity:impl-M3GNet-kaplan2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-MatGL-kaplan2025 .

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" ;
    mlips:hasLossFunction entity:loss-TensorNet-kaplan2025 ;
    mlips:hasTrainingAlgorithm entity:alg-TensorNet-kaplan2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-TensorNet-kaplan2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-TensorNet-kaplan2025 a mlips:LossFunction ;
    rdfs:label "L1 loss on energy, force and stress (stress weight 0.1)" .

entity:alg-TensorNet-kaplan2025 a mls:Algorithm ;
    rdfs:label "AMSGrad AdamW, learning rate 1e-3 down to 1e-5" .

entity:impl-TensorNet-kaplan2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-MatGL-kaplan2025 .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasLossFunction entity:loss-CHGNet-kaplan2025 ;
    mlips:hasTrainingAlgorithm entity:alg-CHGNet-kaplan2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-CHGNet-kaplan2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-CHGNet-kaplan2025 a mlips:LossFunction ;
    rdfs:label "Huber loss (delta 0.1) on energy, force, stress (0.05) and magnetic moments" .

entity:alg-CHGNet-kaplan2025 a mls:Algorithm ;
    rdfs:label "Adam, learning rate 1e-3 down to 1e-5" .

entity:impl-CHGNet-kaplan2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-MatGL-kaplan2025 .

entity:lib-MatGL-kaplan2025 a mlips:Library ;
    rdfs:label "MatGL" ;
    rdfs:comment "Materials Graph Library 1.13" ;
    mlips:candidateForVocabulary mlips:Library .

