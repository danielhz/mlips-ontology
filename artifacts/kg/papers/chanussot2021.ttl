    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.5986"^^xsd:double ;
    mlips:hasUnit unit:EV .

entity:metric-CGCNN-ood-ads-2-chanussot2021 a mlips:AccuracyMetric ;
