# Canonical Turtle for the protocol-derived encoding of:
#   Lowik Chanussot et al. (2021). Open Catalyst 2020 (OC20) Dataset and Community Challenges.
#   ACS Catalysis. doi:10.1021/acscatal.0c04525  arXiv:2010.09990v5
#
# Version read: arxiv-preprint arXiv:2010.09990v5 (sha256 35d65cd8316e4e65...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 57 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the OC20 data set (adsorbate-on-catalyst relaxations
# with RPBE, plus MD and rattled structures) and the three baseline
# models trained on the full S2EF training set for energy and forces
# (CGCNN, SchNet, DimeNet++), with their S2EF validation errors on the
# four splits (Table 13). The IS2RE and IS2RS tasks and the force-only /
# energy-only variants are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-chanussot2021 a mlips:BenchmarkStudy ;
    rdfs:label "Chanussot et al. (2021): the Open Catalyst 2020 (OC20) data set and community challenges" ;
    mlips:reportedIn entity:article-chanussot2021 .

entity:article-chanussot2021 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acscatal.0c04525> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "Open Catalyst 2020 (OC20) Dataset and Community Challenges" ;
    schema:author entity:person-Chanussot-chanussot2021 ,
        entity:person-Das-chanussot2021 ,
        entity:person-Goyal-chanussot2021 ,
        entity:person-Lavril-chanussot2021 ,
