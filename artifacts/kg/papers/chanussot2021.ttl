###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-oc20-chanussot2021 a mlips:MaterialSystem ;
    rdfs:label "OC20 adsorbate-catalyst systems: small adsorbates (C, N, O, H containing) on unary, binary and ternary catalyst surfaces" ;
    mlips:materialClass "Heterogeneous-catalysis slab + adsorbate systems" ;
    mlips:microstructuralFeature "Surface slabs with adsorbates; only the top surface layers and the adsorbate move" .

entity:mat-val-id-chanussot2021 a mlips:MaterialSystem ;
    rdfs:label "OC20 S2EF validation split: in domain (same distribution as training)" ;
    mlips:materialClass "Slab + adsorbate systems" .

entity:mat-val-ood-ads-chanussot2021 a mlips:MaterialSystem ;
    rdfs:label "OC20 S2EF validation split: unseen adsorbates" ;
    mlips:materialClass "Slab + adsorbate systems" .

entity:mat-val-ood-cat-chanussot2021 a mlips:MaterialSystem ;
    rdfs:label "OC20 S2EF validation split: unseen catalyst compositions" ;
    mlips:materialClass "Slab + adsorbate systems" .

entity:mat-val-ood-both-chanussot2021 a mlips:MaterialSystem ;
    rdfs:label "OC20 S2EF validation split: unseen adsorbates and catalysts" ;
    mlips:materialClass "Slab + adsorbate systems" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-chanussot2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-chanussot2021 mlips:hasDFTSettings entity:calc-settings-dft-chanussot2021 .

entity:calc-settings-dft-chanussot2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-RPBE-chanussot2021 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "350"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack grid derived from the unit-cell parameters" ;
    rdfs:comment "No spin polarisation; relaxations by conjugate gradient until forces are below 0.03 eV/A or 200 steps per VASP call. Energies are referenced as adsorption energies E_ad = E_sys - E_slab - E_gas." .

entity:xc-RPBE-chanussot2021 a mlips:XCFunctional ;
    rdfs:label "RPBE" ;
    rdfs:comment "Revised Perdew-Burke-Ernzerhof GGA functional." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-s2ef-all-chanussot2021 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF training set, 'All' (133,934,018 structures)" ;
    mlips:coversMaterial entity:mat-oc20-chanussot2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 133934018 ;
    mlips:hasDFTCalculation entity:calc-dft-chanussot2021 ;
    rdfs:comment "Validation splits of about 1 million structures each: in domain, out-of-domain adsorbate, out-of-domain catalyst, out-of-domain both." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-s2ef-all-chanussot2021 mlips:samplingStrategy
    entity:sampling-site-enumeration-chanussot2021 ,
    entity:sampling-relaxation-chanussot2021 ,
    entity:sampling-md-chanussot2021 ,
    entity:sampling-rattled-chanussot2021 .

entity:sampling-site-enumeration-chanussot2021 a mlips:SamplingStrategy ;
    rdfs:label "Random adsorption-site placement on enumerated surfaces" ;
    rdfs:comment "Adsorbates placed with CatKit on symmetrically distinct sites of surfaces cut from bulk structures; a configuration is selected at random." .

entity:sampling-relaxation-chanussot2021 a mlips:SamplingStrategy ;
    rdfs:label "Relaxation trajectories" ;
    rdfs:comment "Intermediate and final structures of the DFT relaxations; S2EF training structures are sampled from 640,081 relaxations." .

entity:sampling-md-chanussot2021 a mlips:SamplingStrategy ;
    rdfs:label "Short ab initio MD from relaxed structures" ;
    rdfs:comment "About 950 thousand MD runs (about 64 million single points) with random Maxwell-Boltzmann initial velocities." .

entity:sampling-rattled-chanussot2021 a mlips:SamplingStrategy ;
    rdfs:label "Rattled structures" ;
    rdfs:comment "About 30 million structures with atomic positions perturbed by normally distributed noise (sigma = 0.05), single-point DFT." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:hasTrainingAlgorithm entity:alg-DimeNet-chanussot2021 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        mlips:numLayers ,
        mlips:numRadialBasis ,
        mlips:numAngularBasis ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ,
        entity:hp-force-coefficient-chanussot2021 .

entity:alg-DimeNet-chanussot2021 a mls:Algorithm ;
    rdfs:label "Initial learning rate 1e-4 with 2 warm-up epochs (factor 0.2) and decay by 0.1 at epochs 2, 3 and 4; batch size 8 per GPU" .

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" .

entity:CGCNN a mlips:MLIPMethod ;
    rdfs:label "Crystal Graph Convolutional Neural Network (CGCNN)" .

entity:hp-force-coefficient-chanussot2021 a mlips:Hyperparameter ;
    rdfs:label "Force coefficient in the loss" ;
    mlips:hyperparameterName "force_coefficient" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-DimeNet-s2ef-numFeatures-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "192"^^xsd:integer .

entity:setting-DimeNet-s2ef-numLayers-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-DimeNet-s2ef-numRadialBasis-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-DimeNet-s2ef-numAngularBasis-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-DimeNet-s2ef-cutoffRadius-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-DimeNet-s2ef-batchSize-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-DimeNet-s2ef-learningRate-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-DimeNet-s2ef-numEpochs-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-DimeNet-s2ef-force-coefficient-chanussot2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-force-coefficient-chanussot2021 ;
    mlips:settingValue "50"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-DimeNet-s2ef-chanussot2021 a mlips:MLIPRun ;
    rdfs:label "DimeNet++ baseline trained on OC20 S2EF-All (energy and forces)" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-s2ef-all-chanussot2021 ;
    mlips:hasHyperparameterSetting entity:setting-DimeNet-s2ef-numFeatures-chanussot2021 ,
        entity:setting-DimeNet-s2ef-numLayers-chanussot2021 ,
        entity:setting-DimeNet-s2ef-numRadialBasis-chanussot2021 ,
        entity:setting-DimeNet-s2ef-numAngularBasis-chanussot2021 ,
        entity:setting-DimeNet-s2ef-cutoffRadius-chanussot2021 ,
        entity:setting-DimeNet-s2ef-batchSize-chanussot2021 ,
        entity:setting-DimeNet-s2ef-learningRate-chanussot2021 ,
        entity:setting-DimeNet-s2ef-numEpochs-chanussot2021 ,
        entity:setting-DimeNet-s2ef-force-coefficient-chanussot2021 ;
    mlips:produces entity:model-DimeNet-s2ef-chanussot2021 .

entity:model-DimeNet-s2ef-chanussot2021 a mlips:TrainedModel ;
    rdfs:label "DimeNet++ OC20 S2EF-All baseline" .

entity:run-SchNet-s2ef-chanussot2021 a mlips:MLIPRun ;
    rdfs:label "SchNet baseline trained on OC20 S2EF-All (energy and forces)" ;
    mlips:appliesMethod entity:SchNet ;
    mlips:runsOn entity:ds-s2ef-all-chanussot2021 ;
    mlips:produces entity:model-SchNet-s2ef-chanussot2021 .

entity:model-SchNet-s2ef-chanussot2021 a mlips:TrainedModel ;
    rdfs:label "SchNet OC20 S2EF-All baseline" .

entity:run-CGCNN-s2ef-chanussot2021 a mlips:MLIPRun ;
    rdfs:label "CGCNN baseline trained on OC20 S2EF-All (energy and forces)" ;
    mlips:appliesMethod entity:CGCNN ;
    mlips:runsOn entity:ds-s2ef-all-chanussot2021 ;
    mlips:produces entity:model-CGCNN-s2ef-chanussot2021 .

entity:model-CGCNN-s2ef-chanussot2021 a mlips:TrainedModel ;
    rdfs:label "CGCNN OC20 S2EF-All baseline" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-chanussot2021 mlips:hasResult
    entity:result-CGCNN-id-chanussot2021 ,
    entity:result-CGCNN-ood-ads-chanussot2021 ,
    entity:result-CGCNN-ood-cat-chanussot2021 ,
    entity:result-CGCNN-ood-both-chanussot2021 ,
    entity:result-SchNet-id-chanussot2021 ,
    entity:result-SchNet-ood-ads-chanussot2021 ,
    entity:result-SchNet-ood-cat-chanussot2021 ,
    entity:result-SchNet-ood-both-chanussot2021 ,
    entity:result-DimeNet-id-chanussot2021 ,
    entity:result-DimeNet-ood-ads-chanussot2021 ,
    entity:result-DimeNet-ood-cat-chanussot2021 ,
    entity:result-DimeNet-ood-both-chanussot2021 .

entity:result-CGCNN-id-chanussot2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-CGCNN-s2ef-chanussot2021 ;
    mlips:targetMaterial entity:mat-val-id-chanussot2021 ;
    mlips:hasAccuracyMetric entity:metric-CGCNN-id-1-chanussot2021 ,
        entity:metric-CGCNN-id-2-chanussot2021 .

entity:metric-CGCNN-id-1-chanussot2021 a mlips:AccuracyMetric ;
    rdfs:label "S2EF validation MAE on (adsorption-referenced) energy: CGCNN, in domain (same distribution as training)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.5041"^^xsd:double ;
    mlips:hasUnit unit:EV .

entity:metric-CGCNN-id-2-chanussot2021 a mlips:AccuracyMetric ;
    rdfs:label "S2EF validation MAE on forces: CGCNN, in domain (same distribution as training)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.0684"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:result-CGCNN-ood-ads-chanussot2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-CGCNN-s2ef-chanussot2021 ;
    mlips:targetMaterial entity:mat-val-ood-ads-chanussot2021 ;
    mlips:hasAccuracyMetric entity:metric-CGCNN-ood-ads-1-chanussot2021 ,
        entity:metric-CGCNN-ood-ads-2-chanussot2021 .

entity:metric-CGCNN-ood-ads-1-chanussot2021 a mlips:AccuracyMetric ;
