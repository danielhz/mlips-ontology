    mlips:metricValue "0.0746"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:result-CGCNN-ood-cat-chanussot2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-CGCNN-s2ef-chanussot2021 ;
    mlips:targetMaterial entity:mat-val-ood-cat-chanussot2021 ;
    mlips:hasAccuracyMetric entity:metric-CGCNN-ood-cat-1-chanussot2021 ,
