# Canonical Turtle for the protocol-derived encoding of:
#   Michael J. Waters et al. (2022). Benchmarking structural evolution methods for training of machine learned interatomic potentials.
#   Journal of Physics Condensed Matter. doi:10.1088/1361-648x/ac7f73  arXiv:2203.16055v1
#
# Version read: arxiv-preprint arXiv:2203.16055v1 (sha256 7c096eb8c1819314...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 408 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/waters2022.yaml.
#
# Encoding scope: the Zr-O training data generated from polymorph-derived
# and random structures evolved by MD, contour exploration (CE) or the
# dimer method (DM) with VASP PBE labels, three Behler-Parrinello neural
# networks (AMP fork; 136 Gaussian descriptors, 7 A cutoff, one hidden
# layer of eight nodes per element) trained on the MD, CE and DM data,
# and their train and cross-test energy and force errors printed in
# Figs. 11-12. Equations of state, vacuum pair curves, phonons and
# force-angle errors are properties or figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-waters2022 a mlips:BenchmarkStudy ;
    rdfs:label "Waters and Rondinelli (2022): benchmarking structural-evolution methods (MD, contour exploration, dimer method) for generating MLIP training data in Zr-O" ;
    mlips:reportedIn entity:article-waters2022 .

entity:article-waters2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1361-648x/ac7f73> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Benchmarking structural evolution methods for training of machine learned interatomic potentials" ;
    schema:author <https://orcid.org/0000-0001-6425-4331> ,
        <https://orcid.org/0000-0003-0508-2175> .

<https://orcid.org/0000-0001-6425-4331> a schema:Person ;
    schema:name "Michael J Waters" ;
    schema:givenName "Michael J" ;
    schema:familyName "Waters" ;
    schema:identifier <https://orcid.org/0000-0001-6425-4331> .

<https://orcid.org/0000-0003-0508-2175> a schema:Person ;
    schema:name "James M Rondinelli" ;
    schema:givenName "James M" ;
    schema:familyName "Rondinelli" ;
    schema:identifier <https://orcid.org/0000-0003-0508-2175> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-zro-waters2022 a mlips:MaterialSystem ;
    rdfs:label "Zr-O system: Zr metal, ZrO2 polymorphs, suboxides, polymorph-derived and random structures" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-waters2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-waters2022 mlips:hasDFTSettings entity:calc-settings-pbe-waters2022 .

entity:calc-settings-pbe-waters2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack, at least 10,000 k-points x A^3" ;
    rdfs:comment "VASP 5.4.4, Zr_sv and O PAW potentials (Sec. II B)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-d-md-waters2022 a mlips:TrainingDataset ;
    rdfs:label "Zr-O molecular dynamics (MD) training data" ;
    mlips:coversMaterial entity:mat-zro-waters2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-waters2022 .

entity:ds-d-ce-waters2022 a mlips:TrainingDataset ;
    rdfs:label "Zr-O contour exploration (CE) training data" ;
    mlips:coversMaterial entity:mat-zro-waters2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-waters2022 .

entity:ds-d-dimer-waters2022 a mlips:TrainingDataset ;
    rdfs:label "Zr-O dimer-method search (DM) training data" ;
    mlips:coversMaterial entity:mat-zro-waters2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-waters2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-d-md-waters2022 mlips:samplingStrategy
    entity:sampling-s-md-waters2022 .

entity:ds-d-ce-waters2022 mlips:samplingStrategy
    entity:sampling-s-ce-waters2022 .

entity:ds-d-dimer-waters2022 mlips:samplingStrategy
    entity:sampling-s-dimer-waters2022 .

entity:sampling-s-md-waters2022 a mlips:SamplingStrategy ;
    rdfs:label "Structure evolution by molecular dynamics (MD) from 50 polymorph-derived and 50 random starting structures; energies and forces limited by binding-energy-based caps" .

entity:sampling-s-ce-waters2022 a mlips:SamplingStrategy ;
    rdfs:label "Structure evolution by contour exploration (CE) from 50 polymorph-derived and 50 random starting structures; energies and forces limited by binding-energy-based caps" .

entity:sampling-s-dimer-waters2022 a mlips:SamplingStrategy ;
    rdfs:label "Structure evolution by dimer-method search (DM) from 50 polymorph-derived and 50 random starting structures; energies and forces limited by binding-energy-based caps" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-waters2022 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-waters2022 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-HDNNP-waters2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-HDNNP-waters2022 a mlips:LossFunction ;
    rdfs:label "Energy RMSE plus 10 % weighted force RMSE plus an overfit penalty (0.05 for 200 iterations, then 0.001 for 1,500)" .

entity:alg-HDNNP-waters2022 a mls:Algorithm ;
    rdfs:label "BFGS" .

entity:impl-HDNNP-waters2022 a mlips:Implementation ;
    mlips:implementedIn entity:lib-AMP-0_7_0-beta-fork-waters2022 .

entity:lib-AMP-0_7_0-beta-fork-waters2022 a mlips:Library ;
    rdfs:label "AMP 0.7.0-beta (fork)" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nn-md-cutoffRadius-waters2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:double .

entity:setting-nn-ce-cutoffRadius-waters2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:double .

entity:setting-nn-dimer-cutoffRadius-waters2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nn-md-waters2022 a mlips:MLIPRun ;
    rdfs:label "Behler-Parrinello NN trained on the molecular dynamics (MD) data" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-d-md-waters2022 ;
    mlips:hasHyperparameterSetting entity:setting-nn-md-cutoffRadius-waters2022 ;
    mlips:produces entity:model-nn-md-waters2022 .

entity:model-nn-md-waters2022 a mlips:TrainedModel ;
    rdfs:label "Zr-O NN (MD-trained)" .

entity:run-nn-ce-waters2022 a mlips:MLIPRun ;
    rdfs:label "Behler-Parrinello NN trained on the contour exploration (CE) data" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-d-ce-waters2022 ;
    mlips:hasHyperparameterSetting entity:setting-nn-ce-cutoffRadius-waters2022 ;
    mlips:produces entity:model-nn-ce-waters2022 .

entity:model-nn-ce-waters2022 a mlips:TrainedModel ;
    rdfs:label "Zr-O NN (CE-trained)" .

entity:run-nn-dimer-waters2022 a mlips:MLIPRun ;
    rdfs:label "Behler-Parrinello NN trained on the dimer-method search (DM) data" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-d-dimer-waters2022 ;
    mlips:hasHyperparameterSetting entity:setting-nn-dimer-cutoffRadius-waters2022 ;
    mlips:produces entity:model-nn-dimer-waters2022 .

entity:model-nn-dimer-waters2022 a mlips:TrainedModel ;
    rdfs:label "Zr-O NN (DIMER-trained)" .

