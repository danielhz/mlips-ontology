# Canonical Turtle for the protocol-derived encoding of:
#   Vladimir Ladygin et al. (2019). Lattice dynamics simulation using machine learning interatomic potentials.
#   Computational Materials Science. doi:10.1016/j.commatsci.2019.109333
#
# Version read: publisher (sha256 825ea982ba7d35cd...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 181 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the five moment tensor potentials trained on the fly
# for fcc Al, bcc Mo (two temperatures), bcc Ti and bcc U, with their
# VASP reference settings and training procedure. The paper states
# accuracy as relative differences (Table 1), which are kept in comments;
# no AccuracyMetric is encoded. Phonon and free-energy results are not
# encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ladygin2019 a mlips:BenchmarkStudy ;
    rdfs:label "Ladygin et al. (2019): lattice dynamics simulation using machine learning interatomic potentials" ;
    mlips:reportedIn entity:article-ladygin2019 .

entity:article-ladygin2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.commatsci.2019.109333> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "Lattice dynamics simulation using machine learning interatomic potentials" ;
    schema:author entity:person-Ladygin-ladygin2019 ,
        entity:person-Korotaev-ladygin2019 ,
        entity:person-Yanilkin-ladygin2019 ,
        entity:person-Shapeev-ladygin2019 .

entity:person-Ladygin-ladygin2019 a schema:Person ;
    schema:name "V.V. Ladygin" ;
    schema:givenName "V.V." ;
    schema:familyName "Ladygin" .

entity:person-Korotaev-ladygin2019 a schema:Person ;
    schema:name "P.Yu. Korotaev" ;
    schema:givenName "P.Yu." ;
    schema:familyName "Korotaev" .

entity:person-Yanilkin-ladygin2019 a schema:Person ;
    schema:name "A.V. Yanilkin" ;
    schema:givenName "A.V." ;
    schema:familyName "Yanilkin" .

entity:person-Shapeev-ladygin2019 a schema:Person ;
    schema:name "A.V. Shapeev" ;
    schema:givenName "A.V." ;
    schema:familyName "Shapeev" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Al-775K-ladygin2019 a mlips:MaterialSystem ;
    rdfs:label "fcc aluminium at 775 K (3x3x3 conventional supercell, lattice constant 4.11 A)" ;
    mlips:chemicalFormula "Al" ;
    mlips:materialClass "Elemental metal" .

entity:mat-Mo-300K-ladygin2019 a mlips:MaterialSystem ;
    rdfs:label "bcc molybdenum at 300 K (3x3x3 conventional supercell, lattice constant 3.15 A)" ;
    mlips:chemicalFormula "Mo" ;
    mlips:materialClass "Elemental metal" .

entity:mat-Mo-1500K-ladygin2019 a mlips:MaterialSystem ;
    rdfs:label "bcc molybdenum at 1500 K (3x3x3 conventional supercell, lattice constant 3.166 A)" ;
    mlips:chemicalFormula "Mo" ;
    mlips:materialClass "Elemental metal" .

entity:mat-Ti-1500K-ladygin2019 a mlips:MaterialSystem ;
    rdfs:label "bcc titanium at 1500 K (3x3x3 conventional supercell, lattice constant 3.3257 A)" ;
    mlips:chemicalFormula "Ti" ;
    mlips:materialClass "Elemental metal" .

entity:mat-U-1350K-ladygin2019 a mlips:MaterialSystem ;
    rdfs:label "bcc uranium at 1350 K (3x3x3 conventional supercell, lattice constant 3.49 A)" ;
    mlips:chemicalFormula "U" ;
    mlips:materialClass "Elemental metal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-Al-ladygin2019 a mlips:DFTCalculation .

entity:calc-dft-Mo-ladygin2019 a mlips:DFTCalculation .

entity:calc-dft-Ti-ladygin2019 a mlips:DFTCalculation .

entity:calc-dft-U-ladygin2019 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-Al-ladygin2019 mlips:hasDFTSettings entity:calc-settings-dft-Al-ladygin2019 .

entity:calc-settings-dft-Al-ladygin2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "320"^^xsd:double ;
    mlips:kPointMesh "4x4x4 for the 3x3x3 conventional supercell" .

entity:calc-dft-Mo-ladygin2019 mlips:hasDFTSettings entity:calc-settings-dft-Mo-ladygin2019 .

entity:calc-settings-dft-Mo-ladygin2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "300"^^xsd:double ;
    mlips:kPointMesh "4x4x4 for the 3x3x3 conventional supercell" .

entity:calc-dft-Ti-ladygin2019 mlips:hasDFTSettings entity:calc-settings-dft-Ti-ladygin2019 .

entity:calc-settings-dft-Ti-ladygin2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "250"^^xsd:double ;
    mlips:kPointMesh "4x4x4 for the 3x3x3 conventional supercell" .

entity:calc-dft-U-ladygin2019 mlips:hasDFTSettings entity:calc-settings-dft-U-ladygin2019 .

entity:calc-settings-dft-U-ladygin2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "330"^^xsd:double ;
    mlips:kPointMesh "3x3x3 for the 3x3x3 conventional supercell" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Al-775K-ladygin2019 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly training set for fcc aluminium at 775 K (approximately 100 DFT configurations)" ;
    mlips:coversMaterial entity:mat-Al-775K-ladygin2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-Al-ladygin2019 ;
    rdfs:comment "Table 1: average difference in potential energy per atom relative to 3kT 0.1%; relative difference in forces 3%." .

entity:ds-Mo-300K-ladygin2019 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly training set for bcc molybdenum at 300 K (approximately 100 DFT configurations)" ;
    mlips:coversMaterial entity:mat-Mo-300K-ladygin2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-Mo-ladygin2019 ;
    rdfs:comment "Table 1: average difference in potential energy per atom relative to 3kT 0.1%; relative difference in forces 3%." .

entity:ds-Mo-1500K-ladygin2019 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly training set for bcc molybdenum at 1500 K (approximately 100 DFT configurations)" ;
    mlips:coversMaterial entity:mat-Mo-1500K-ladygin2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-Mo-ladygin2019 ;
    rdfs:comment "Table 1: average difference in potential energy per atom relative to 3kT 0.3%; relative difference in forces 3%." .

entity:ds-Ti-1500K-ladygin2019 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly training set for bcc titanium at 1500 K (around 300 DFT configurations)" ;
    mlips:coversMaterial entity:mat-Ti-1500K-ladygin2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-Ti-ladygin2019 ;
    rdfs:comment "Table 1: average difference in potential energy per atom relative to 3kT 0.6%; relative difference in forces 25%." .

entity:ds-U-1350K-ladygin2019 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly training set for bcc uranium at 1350 K (around 300 DFT configurations)" ;
    mlips:coversMaterial entity:mat-U-1350K-ladygin2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-U-ladygin2019 ;
    rdfs:comment "Table 1: average difference in potential energy per atom relative to 3kT 1.3%; relative difference in forces 27%." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Al-775K-ladygin2019 mlips:samplingStrategy
    entity:sampling-onthefly-ladygin2019 .

entity:ds-Mo-300K-ladygin2019 mlips:samplingStrategy
    entity:sampling-onthefly-ladygin2019 .

entity:ds-Mo-1500K-ladygin2019 mlips:samplingStrategy
    entity:sampling-onthefly-ladygin2019 .

entity:ds-Ti-1500K-ladygin2019 mlips:samplingStrategy
    entity:sampling-onthefly-ladygin2019 .

entity:ds-U-1350K-ladygin2019 mlips:samplingStrategy
    entity:sampling-onthefly-ladygin2019 .

entity:sampling-onthefly-ladygin2019 a mlips:SamplingStrategy ;
    rdfs:label "Learning on the fly: NVT MD of 70,000 steps (1 fs) with the MTP at the experimental temperature and lattice constant; DFT is called only for configurations on which extrapolation is detected" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-ladygin2019 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:alg-MTP-ladygin2019 a mls:Algorithm ;
    rdfs:label "Active learning on the fly (extrapolation detection) during MD" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-Al-775K-ladygin2019 a mlips:MLIPRun ;
    rdfs:label "MTP trained on the fly for fcc aluminium at 775 K" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-Al-775K-ladygin2019 ;
    mlips:produces entity:model-Al-775K-ladygin2019 .

entity:model-Al-775K-ladygin2019 a mlips:TrainedModel ;
    rdfs:label "MTP for fcc aluminium at 775 K" .

entity:run-Mo-300K-ladygin2019 a mlips:MLIPRun ;
    rdfs:label "MTP trained on the fly for bcc molybdenum at 300 K" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-Mo-300K-ladygin2019 ;
    mlips:produces entity:model-Mo-300K-ladygin2019 .

entity:model-Mo-300K-ladygin2019 a mlips:TrainedModel ;
    rdfs:label "MTP for bcc molybdenum at 300 K" .

entity:run-Mo-1500K-ladygin2019 a mlips:MLIPRun ;
    rdfs:label "MTP trained on the fly for bcc molybdenum at 1500 K" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-Mo-1500K-ladygin2019 ;
    mlips:produces entity:model-Mo-1500K-ladygin2019 .

entity:model-Mo-1500K-ladygin2019 a mlips:TrainedModel ;
    rdfs:label "MTP for bcc molybdenum at 1500 K" .

entity:run-Ti-1500K-ladygin2019 a mlips:MLIPRun ;
    rdfs:label "MTP trained on the fly for bcc titanium at 1500 K" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-Ti-1500K-ladygin2019 ;
    mlips:produces entity:model-Ti-1500K-ladygin2019 .

entity:model-Ti-1500K-ladygin2019 a mlips:TrainedModel ;
    rdfs:label "MTP for bcc titanium at 1500 K" .

entity:run-U-1350K-ladygin2019 a mlips:MLIPRun ;
    rdfs:label "MTP trained on the fly for bcc uranium at 1350 K" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-U-1350K-ladygin2019 ;
    mlips:produces entity:model-U-1350K-ladygin2019 .

entity:model-U-1350K-ladygin2019 a mlips:TrainedModel ;
    rdfs:label "MTP for bcc uranium at 1350 K" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No AccuracyMetric: Table 1 gives the energy error as a percentage of 3kT and the force error as a relative percentage (0.1 to 1.3% and 3 to 27%), which are neither MAE nor RMSE in physical units. They are recorded in the data-set comments of the corresponding systems.
# - The MTP level, cutoff and package version are not stated in the text read (the MTP is used as a LAMMPS plugin); training-set sizes are given only approximately ('approximately 100' for Al and Mo, 'around 300' for Ti and U) and are in the labels, not as mlips:numConfigurations.
# - Phonon dispersions, vibrational densities of states from TDEP and from the velocity autocorrelation function, anharmonic shifts, entropies and free energies (Table 2) are not encoded.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
