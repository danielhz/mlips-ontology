# Canonical Turtle for the protocol-derived encoding of:
#   Peichen Zhong et al. (2025). Machine learning interatomic potential can infer electrical response.
#   npj Computational Materials. doi:10.1038/s41524-025-01911-z  arXiv:2504.05169v1
#
# Version read: arxiv-preprint arXiv:2504.05169v1 (sha256 296190c915dfea78...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 260 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/zhong2025.yaml.
#
# Encoding scope: CACE-LES potentials (called CACE-LR in the paper) for
# RPBE-D3 bulk water (four versions, Table I), high-pressure superionic
# water (and a model fine-tuned with BECs at 2 g/cm3 and 2000 K) and SCAN
# PbTiO3, with their test energy and force RMSEs; MD for IR spectra,
# ionic conductivity and ferroelectric hysteresis. BEC RMSEs (in e) have no
# metric property and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhong2025 a mlips:BenchmarkStudy ;
    rdfs:label "Zhong et al. (2025): Born effective charges and polarisation from CACE-LES (latent Ewald summation) potentials" ;
    mlips:reportedIn entity:article-zhong2025 .

entity:article-zhong2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01911-z> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Machine learning interatomic potential can infer electrical response" ;
    schema:author entity:person-Zhong-zhong2025 ,
        entity:person-Kim-zhong2025 ,
        entity:person-King-zhong2025 ,
        entity:person-Cheng-zhong2025 .

entity:person-Zhong-zhong2025 a schema:Person ;
    schema:name "Peichen Zhong" ;
    schema:givenName "Peichen" ;
    schema:familyName "Zhong" .

entity:person-Kim-zhong2025 a schema:Person ;
    schema:name "Dongjin Kim" ;
    schema:givenName "Dongjin" ;
    schema:familyName "Kim" .

entity:person-King-zhong2025 a schema:Person ;
    schema:name "Daniel S. King" ;
    schema:givenName "Daniel S." ;
    schema:familyName "King" .

entity:person-Cheng-zhong2025 a schema:Person ;
    schema:name "Bingqing Cheng" ;
    schema:givenName "Bingqing" ;
    schema:familyName "Cheng" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-zhong2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk liquid water at experimental density and room temperature (64 molecules)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-hp-water-zhong2025 a mlips:MaterialSystem ;
    rdfs:label "High-pressure water: ionic liquid, superionic ice XVIII and ice X (300-15000 K, 1-7 g/cm3)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "High-pressure ionic and superionic water" .

entity:mat-PbTiO3-zhong2025 a mlips:MaterialSystem ;
    rdfs:label "PbTiO3 perovskite, cubic and tetragonal phases (3x3x3 cells, 135 atoms)" ;
    mlips:chemicalFormula "PbTiO3" ;
    mlips:materialClass "Ferroelectric perovskite oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-rpbe-d3-zhong2025 a mlips:DFTCalculation .

entity:calc-hp-dft-zhong2025 a mlips:DFTCalculation .

entity:calc-scan-zhong2025 a mlips:DFTCalculation .

entity:calc-pbe-dfpt-zhong2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-rpbe-d3-zhong2025 mlips:hasDFTSettings entity:calc-settings-rpbe-d3-zhong2025 .

entity:calc-settings-rpbe-d3-zhong2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-RPBE-D3-zhong2025 ;
    rdfs:comment "Bulk water data sets of Ref. [28]; DFPT (VASP) for the BECs of the RPBE-D3 + BEC set." .

entity:calc-hp-dft-zhong2025 mlips:hasDFTSettings entity:calc-settings-hp-dft-zhong2025 .

entity:calc-settings-hp-dft-zhong2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Superionic water training set of Ref. [42] (functional not restated); BECs from DFPT with a 400 eV cutoff at the Baldereschi point." .

entity:calc-scan-zhong2025 mlips:hasDFTSettings entity:calc-settings-scan-zhong2025 .

entity:calc-settings-scan-zhong2025 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:SCAN ;
    rdfs:comment "PbTiO3 data set of Ref. [51] (DP-GEN MD at 300/600/900 K)." .

entity:calc-pbe-dfpt-zhong2025 mlips:hasDFTSettings entity:calc-settings-pbe-dfpt-zhong2025 .

entity:calc-settings-pbe-dfpt-zhong2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "680"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "DFPT BECs of 443 PbTiO3 configurations (PBE54 PAW); total-energy convergence 1e-6 eV." .

entity:xc-RPBE-D3-zhong2025 a mlips:XCFunctional ;
    rdfs:label "RPBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-rpbe-zhong2025 a mlips:TrainingDataset ;
    rdfs:label "RPBE-D3 bulk water data set of Ref. [28] (654 configurations of 64 molecules; 90/10 train/test)" ;
    mlips:coversMaterial entity:mat-water-zhong2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 654 ;
    mlips:hasDFTCalculation entity:calc-rpbe-d3-zhong2025 .

entity:ds-rpbe-bec-zhong2025 a mlips:TrainingDataset ;
    rdfs:label "RPBE-D3 + BEC water set of Ref. [28] (100 configurations at 298.2 K with Born effective charges)" ;
    mlips:coversMaterial entity:mat-water-zhong2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 100 ;
    mlips:hasDFTCalculation entity:calc-rpbe-d3-zhong2025 .

entity:ds-hp-zhong2025 a mlips:TrainingDataset ;
    rdfs:label "5,000 configurations randomly selected from the 17,516-structure superionic water training set of Ref. [42] (90/10 train/test)" ;
    mlips:coversMaterial entity:mat-hp-water-zhong2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 5000 ;
    mlips:hasDFTCalculation entity:calc-hp-dft-zhong2025 .

entity:ds-hp-bec-zhong2025 a mlips:TrainingDataset ;
    rdfs:label "100 water configurations at 2 g/cm3 and 2000 K with energies, forces and DFPT BECs (90/10 train/test)" ;
    mlips:coversMaterial entity:mat-hp-water-zhong2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100 ;
    mlips:hasDFTCalculation entity:calc-hp-dft-zhong2025 .

entity:ds-pto-zhong2025 a mlips:TrainingDataset ;
    rdfs:label "PbTiO3 SCAN data set of Ref. [51] (4,432 training and 600 test configurations; 10% of training used for validation)" ;
    mlips:coversMaterial entity:mat-PbTiO3-zhong2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 5032 ;
    mlips:hasDFTCalculation entity:calc-scan-zhong2025 .

entity:ds-pto-bec-zhong2025 a mlips:TrainingDataset ;
    rdfs:label "443 PbTiO3 configurations with PBE energies, forces and DFPT BECs (8:1:1 split)" ;
    mlips:coversMaterial entity:mat-PbTiO3-zhong2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 443 ;
    mlips:hasDFTCalculation entity:calc-pbe-dfpt-zhong2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CACE-LES a mlips:MLIPMethod ;
    rdfs:label "CACE with latent Ewald summation (CACE-LES)" ;
    mlips:hasLossFunction entity:loss-CACE-LES-zhong2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:bodyOrder ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-CACE-LES-zhong2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-CACE-LES-zhong2025 a mlips:LossFunction ;
    rdfs:label "Energy and force loss (version 4 and the fine-tuned models also on Born effective charges)" .

entity:impl-CACE-LES-zhong2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-cace-zhong2025 .

entity:lib-cace-zhong2025 a mlips:Library ;
    rdfs:label "cace" ;
    rdfs:comment "LES implemented in the CACE code (https://github.com/BingqingCheng/cace); MD through ASE" ;
    mlips:candidateForVocabulary mlips:Library .

