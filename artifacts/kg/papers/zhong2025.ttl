        entity:setting-pto-numLayers-zhong2025 ;
    mlips:produces entity:model-pto-zhong2025 .

entity:model-pto-zhong2025 a mlips:TrainedModel ;
    rdfs:label "CACE-LR PbTiO3 potential (E+F)" .

entity:run-pto-ft-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES PbTiO3 E+F model fine-tuned on PBE energies, forces and BECs" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-pto-bec-zhong2025 ;
