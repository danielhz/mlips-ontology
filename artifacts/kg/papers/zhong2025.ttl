# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-w-v1-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES water version 1 (E+F, RPBE-D3, rcut 5.5 A)" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-rpbe-zhong2025 ;
    mlips:hasHyperparameterSetting entity:setting-w-v1-cutoffRadius-zhong2025 ,
        entity:setting-w-v1-numRadialBasis-zhong2025 ,
        entity:setting-w-v1-bodyOrder-zhong2025 ;
    mlips:produces entity:model-w-v1-zhong2025 .

entity:model-w-v1-zhong2025 a mlips:TrainedModel ;
    rdfs:label "CACE-LR water potential, version 1" .

entity:run-w-v2-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES water version 2 (E+F, RPBE-D3, rcut 4.5 A; used in the main text)" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-rpbe-zhong2025 ;
    mlips:hasHyperparameterSetting entity:setting-w-v2-cutoffRadius-zhong2025 ,
        entity:setting-w-v2-numRadialBasis-zhong2025 ,
        entity:setting-w-v2-bodyOrder-zhong2025 ;
    mlips:produces entity:model-w-v2-zhong2025 .

entity:model-w-v2-zhong2025 a mlips:TrainedModel ;
    rdfs:label "CACE-LR water potential, version 2" .

entity:run-w-v3-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES water version 3 (E+F, RPBE-D3 + BEC set, rcut 4.5 A)" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-rpbe-bec-zhong2025 ;
    mlips:hasHyperparameterSetting entity:setting-w-v3-cutoffRadius-zhong2025 ,
        entity:setting-w-v3-numRadialBasis-zhong2025 ,
        entity:setting-w-v3-bodyOrder-zhong2025 ;
    mlips:produces entity:model-w-v3-zhong2025 .

entity:model-w-v3-zhong2025 a mlips:TrainedModel ;
    rdfs:label "CACE-LR water potential, version 3" .

entity:run-w-v4-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES water version 4 (E+F+BEC, RPBE-D3 + BEC set, rcut 4.5 A)" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-rpbe-bec-zhong2025 ;
    mlips:hasHyperparameterSetting entity:setting-w-v4-cutoffRadius-zhong2025 ,
        entity:setting-w-v4-numRadialBasis-zhong2025 ,
        entity:setting-w-v4-bodyOrder-zhong2025 ;
    mlips:produces entity:model-w-v4-zhong2025 .

entity:model-w-v4-zhong2025 a mlips:TrainedModel ;
    rdfs:label "CACE-LR water potential, version 4" .

entity:run-hp-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES for superionic water (E+F)" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-hp-zhong2025 ;
    mlips:hasHyperparameterSetting entity:setting-hp-cutoffRadius-zhong2025 ,
        entity:setting-hp-numRadialBasis-zhong2025 ,
        entity:setting-hp-bodyOrder-zhong2025 ,
        entity:setting-hp-numLayers-zhong2025 ;
    mlips:produces entity:model-hp-zhong2025 .

entity:model-hp-zhong2025 a mlips:TrainedModel ;
    rdfs:label "CACE-LR superionic water potential" .

entity:run-hp-ft-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES superionic water model fine-tuned on energies, forces and BECs at 2 g/cm3 and 2000 K" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-hp-bec-zhong2025 ;
    mlips:produces entity:model-hp-ft-zhong2025 .

entity:model-hp-ft-zhong2025 a mlips:TrainedModel ;
    rdfs:label "CACE-LR superionic water potential, BEC fine-tuned" .

entity:run-pto-zhong2025 a mlips:MLIPRun ;
    rdfs:label "CACE-LES E+F model for PbTiO3 (SCAN)" ;
    mlips:appliesMethod entity:CACE-LES ;
    mlips:runsOn entity:ds-pto-zhong2025 ;
