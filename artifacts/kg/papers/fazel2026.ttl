    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 24541 ;
    mlips:hasDFTCalculation entity:calc-r2scan-fazel2026 .

entity:ds-it2-fazel2026 a mlips:TrainingDataset ;
