entity:sampling-aimd-fazel2026 a mlips:SamplingStrategy ;
    rdfs:label "Every 10th frame of NVT AIMD of water, fluorocarbon fragments, a Nafion chain and Pt(111)-Nafion (10 SOAP/iSIM-selected rotations) at several hydration levels and strains" .

entity:sampling-al-fazel2026 a mlips:SamplingStrategy ;
    rdfs:label "Committee (3 MACE models) active learning from 24 x 1 ps MLIP NVT trajectories at 300 K, flagged by relative force deviation" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-fazel2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-fazel2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:alg-MACE-fazel2026 a mls:Algorithm ;
    rdfs:label "hidden irreps 128x0e + 128x1o; AMSGrad, EMA 0.99; committee of 3 seeds" .

entity:impl-MACE-fazel2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

