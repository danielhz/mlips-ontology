# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scan-fazel2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scan-fazel2026 mlips:hasDFTSettings entity:calc-settings-r2scan-fazel2026 .

entity:calc-settings-r2scan-fazel2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-JDFTx-fazel2026 ;
    mlips:xcFunctional entity:xc-r2SCAN-fazel2026 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:kPointMesh "2x2x1 Gamma-centred with Pt; Gamma only without" ;
    rdfs:comment "LibXC r2SCAN; SG15 norm-conserving pseudopotentials; 30 hartree wavefunction cutoff; 0.2 eV smearing with Pt; NVT AIMD at 300 K." .

entity:lib-JDFTx-fazel2026 a mlips:Library ;
    rdfs:label "JDFTx" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-r2SCAN-fazel2026 a mlips:XCFunctional ;
