###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-fazel2026 a mlips:MaterialSystem ;
    rdfs:label "Liquid water under strain" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid" .

entity:mat-nafion-water-fazel2026 a mlips:MaterialSystem ;
    rdfs:label "Hydrated Nafion fragments and Nafion chain (lambda 6-24, strained)" ;
    mlips:materialClass "polymer electrolyte" .

entity:mat-pt-nafion-fazel2026 a mlips:MaterialSystem ;
    rdfs:label "Pt(111) 4x4 slab with a hydrated Nafion chain" ;
    mlips:materialClass "catalyst-polymer interface" .

