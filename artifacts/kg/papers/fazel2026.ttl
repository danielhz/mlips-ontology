# Q6 -- Sampling strategies
###############################################################################

entity:ds-initial-fazel2026 mlips:samplingStrategy
    entity:sampling-aimd-fazel2026 .

entity:ds-it1-fazel2026 mlips:samplingStrategy
    entity:sampling-aimd-fazel2026 ,
    entity:sampling-al-fazel2026 .

entity:ds-it2-fazel2026 mlips:samplingStrategy
    entity:sampling-aimd-fazel2026 ,
