###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ani1xnr-zhang2024exploring a mlips:TrainingDataset ;
    rdfs:label "ANI-1xnr dataset (26,650 periodic cells, average 139 atoms)" ;
    mlips:coversMaterial entity:mat-chno-zhang2024exploring ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 26650 ;
    mlips:hasDFTCalculation entity:calc-blyp-zhang2024exploring .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ani1xnr-zhang2024exploring mlips:samplingStrategy
    entity:sampling-nr-zhang2024exploring .

entity:sampling-nr-zhang2024exploring a mlips:SamplingStrategy ;
    rdfs:label "Nanoreactor MD with oscillating temperature and density (random schedules) driven by the current ANI ensemble; configurations kept when the normalized energy/force ensemble deviation exceeds thresholds" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasLossFunction entity:loss-ANI-zhang2024exploring ;
    mlips:hasTrainingAlgorithm entity:alg-ANI-zhang2024exploring ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-ANI-zhang2024exploring ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-ANI-zhang2024exploring a mlips:LossFunction ;
    rdfs:label "Energies and forces (as in Ref. 69)" .

entity:alg-ANI-zhang2024exploring a mls:Algorithm ;
    rdfs:label "Ensemble with eightfold cross validation (14/1/1 blocks), early stopping and learning-rate annealing until below 1e-5" .

entity:impl-ANI-zhang2024exploring a mlips:Implementation ;
    mlips:implementedIn mlips:NeuroChem .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ani1xnr-cutoffRadius-zhang2024exploring a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.2"^^xsd:double .

entity:setting-ani1xnr-angularCutoff-zhang2024exploring a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "3.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ani1xnr-zhang2024exploring a mlips:MLIPRun ;
    rdfs:label "ANI-1xnr" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1xnr-zhang2024exploring ;
    mlips:hasHyperparameterSetting entity:setting-ani1xnr-cutoffRadius-zhang2024exploring ,
        entity:setting-ani1xnr-angularCutoff-zhang2024exploring ;
    mlips:produces entity:model-ani1xnr-zhang2024exploring .

entity:model-ani1xnr-zhang2024exploring a mlips:TrainedModel ;
    rdfs:label "ANI-1xnr" .

