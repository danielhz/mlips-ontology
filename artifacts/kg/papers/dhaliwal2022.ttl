###############################################################################

entity:run-gap-2b-dhaliwal2022 a mlips:MLIPRun ;
    rdfs:label "GAP (2B) trained on the graphene data set" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-graphene-dhaliwal2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-2b-descriptor-order-dhaliwal2022 ,
        entity:setting-gap-2b-num-parameters-dhaliwal2022 ;
    mlips:produces entity:model-gap-2b-dhaliwal2022 .

entity:model-gap-2b-dhaliwal2022 a mlips:TrainedModel ;
    rdfs:label "GAP (2B) potential for graphene" .

entity:run-rff-2b-dhaliwal2022 a mlips:MLIPRun ;
