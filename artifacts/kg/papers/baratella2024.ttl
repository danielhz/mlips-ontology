###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gete-baratella2024 mlips:samplingStrategy
    entity:sampling-it-baratella2024 .

entity:sampling-it-baratella2024 a mlips:SamplingStrategy ;
    rdfs:label "Iterative generations: DFT-MD of Ge (144 atoms), GeTe (108) and Ge2Te (100) liquids and amorphous phases plus crystals, enriched with high-energy NN-MD configurations and DFT-MD at other densities and temperatures (Table I)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-baratella2024 ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-baratella2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-DeePMD-baratella2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-DeePMD-baratella2024 a mlips:LossFunction ;
    rdfs:label "Energies, forces and virials" .

entity:alg-DeePMD-baratella2024 a mls:Algorithm ;
    rdfs:label "Attention-based embedding (40, 80, 160), fitting net 3 x 320, smoothing radius 2 A, at most 80 neighbours" .

entity:impl-DeePMD-baratella2024 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-cutoffRadius-baratella2024 a mlips:HyperparameterSetting ;
