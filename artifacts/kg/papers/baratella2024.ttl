###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-cp2k-baratella2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-cp2k-baratella2024 mlips:hasDFTSettings entity:calc-settings-cp2k-baratella2024 .

entity:calc-settings-cp2k-baratella2024 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-baratella2024 ;
    rdfs:comment "Labels at 400 Ry density cutoff, 4x4x4 k-points, Fermi-Dirac smearing (300 K); MD at Gamma point with TZVP basis; functional not named in the text read (D3 used for density checks)" .

entity:lib-CP2K-baratella2024 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

