###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mptrj-10-zheng2026 mlips:samplingStrategy
    entity:sampling-mptrj-filter-zheng2026 ,
    entity:sampling-eam-augmentation-zheng2026 .

entity:ds-mptrj-full-zheng2026 mlips:samplingStrategy
    entity:sampling-mptrj-filter-zheng2026 ,
    entity:sampling-eam-augmentation-zheng2026 .

entity:ds-phosphorus-5-zheng2026 mlips:samplingStrategy
    entity:sampling-phosphorus-rss-zheng2026 ,
    entity:sampling-eam-augmentation-zheng2026 .

entity:ds-phosphorus-full-zheng2026 mlips:samplingStrategy
    entity:sampling-phosphorus-rss-zheng2026 ,
    entity:sampling-eam-augmentation-zheng2026 .

entity:ds-silica-10-zheng2026 mlips:samplingStrategy
    entity:sampling-silica-gap-md-zheng2026 ,
    entity:sampling-eam-augmentation-zheng2026 .

entity:ds-silica-full-zheng2026 mlips:samplingStrategy
    entity:sampling-silica-gap-md-zheng2026 ,
    entity:sampling-eam-augmentation-zheng2026 .

entity:sampling-silica-gap-md-zheng2026 a mlips:SamplingStrategy ;
    rdfs:label "Iteratively expanded silica database from GAP fitting and MD" ;
    rdfs:comment "Distorted crystals, isolated dimers and melt-quench trajectories; single-point DFT labels for energy, forces and stress (ref. 54 of the paper)." .

entity:sampling-phosphorus-rss-zheng2026 a mlips:SamplingStrategy ;
    rdfs:label "Phosphorus GAP-RSS and curated configurations" ;
    rdfs:comment "Random structure search configurations, liquids, 2D structures, bulk crystals and fragments with DFT energies and forces (ref. 53)." .

entity:sampling-mptrj-filter-zheng2026 a mlips:SamplingStrategy ;
    rdfs:label "MPtrj relaxation trajectories filtered by composition" ;
    rdfs:comment "Structures containing exclusively Li, Mn, O and P." .

entity:sampling-eam-augmentation-zheng2026 a mlips:SamplingStrategy ;
    rdfs:label "Augmentation with configurations labelled by a fitted EAM potential" ;
    rdfs:comment "An empirical EAM potential is fitted to the available DFT data and used to label additional configurations for pretraining (the paper's physics-informed pretraining)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CGCNN a mlips:MLIPMethod ;
    rdfs:label "Crystal Graph Convolutional Neural Network (CGCNN)" ;
    mlips:hasHyperparameter entity:hp-training-strategy-zheng2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:TorchMD-ET a mlips:MLIPMethod ;
    rdfs:label "Equivariant Transformer (TorchMD-NET)" ;
    mlips:hasHyperparameter entity:hp-training-strategy-zheng2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:hasHyperparameter entity:hp-training-strategy-zheng2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:hp-training-strategy-zheng2026 a mlips:Hyperparameter ;
