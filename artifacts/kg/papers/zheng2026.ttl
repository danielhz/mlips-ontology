    mlips:reportedIn entity:article-zheng2026 .

entity:article-zheng2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jcim.6c00826> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Improving Reliability of Machine Learning Interatomic Potentials with Physics-Informed Pretraining" ;
    schema:author entity:person-Zheng-zheng2026 ,
