###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-silica-zheng2026 a mlips:MaterialSystem ;
    rdfs:label "Silica: amorphous, liquid, glass and crystalline SiO2 configurations" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "Oxide; crystalline, liquid and amorphous" .

entity:mat-phosphorus-zheng2026 a mlips:MaterialSystem ;
    rdfs:label "Phosphorus across phases: GAP-RSS structures, molecular and network liquids, phosphorene with defects, bulk crystals up to 100 GPa, molecular fragments" ;
    mlips:chemicalFormula "P" ;
    mlips:materialClass "Elemental; molecular, layered and network phases" .

entity:mat-mptrj-zheng2026 a mlips:MaterialSystem ;
    rdfs:label "Li-Mn-O-P compounds from MPtrj" ;
    mlips:chemicalFormula "Li-Mn-O-P" ;
    mlips:materialClass "Inorganic crystals with only Li, Mn, O and P; relaxation trajectories" .

