@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhang2021phase a mlips:BenchmarkStudy ;
    rdfs:label "Zhang, Wang, Car and E (2021): phase diagram of a Deep Potential water model (SCAN)" ;
    mlips:reportedIn entity:article-zhang2021phase .

