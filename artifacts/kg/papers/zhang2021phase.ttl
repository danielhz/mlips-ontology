###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-zhang2021phase a mlips:MaterialSystem ;
    rdfs:label "Water: ice phases (including superionic), molecular and ionic fluids up to about 50 GPa and 2000 K" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular solid and liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-scan-zhang2021phase a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-scan-zhang2021phase mlips:hasDFTSettings entity:calc-settings-scan-zhang2021phase .

entity:calc-settings-scan-zhang2021phase a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:SCAN ;
    rdfs:comment "VASP 5.4.4; energies, forces and virials." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-water-zhang2021phase a mlips:TrainingDataset ;
    rdfs:label "SCAN water training data (31,058 + 3519 configurations)" ;
    mlips:coversMaterial entity:mat-water-zhang2021phase ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 34577 ;
    mlips:hasDFTCalculation entity:calc-scan-zhang2021phase .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-water-zhang2021phase mlips:samplingStrategy
    entity:sampling-dpgen-zhang2021phase .

entity:sampling-dpgen-zhang2021phase a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN concurrent learning (36 iterations) across the phase diagram, plus 3519 configurations to reduce systematic deviations" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasImplementation entity:impl-DeePMD-zhang2021phase ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:ThermodynamicIntegration .

entity:impl-DeePMD-zhang2021phase a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-zhang2021phase a mlips:MLIPRun ;
    rdfs:label "DP SCAN water model for the phase diagram" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-water-zhang2021phase ;
    mlips:produces entity:model-dp-zhang2021phase .

entity:model-dp-zhang2021phase a mlips:TrainedModel ;
    rdfs:label "DP-SCAN water (phase diagram)" .

