    mlips:produces entity:model-nequip-l1-gramatte2024 .

entity:model-nequip-l1-gramatte2024 a mlips:TrainedModel ;
    rdfs:label "NequIP am-alumina potential (num_layers = 1)" .

entity:run-nequip-l8-gramatte2024 a mlips:MLIPRun ;
    rdfs:label "NequIP with num_layers = 8" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-train-gramatte2024 ;
