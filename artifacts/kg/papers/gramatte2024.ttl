    mlips:produces entity:model-nequip-l8-gramatte2024 .

entity:model-nequip-l8-gramatte2024 a mlips:TrainedModel ;
    rdfs:label "NequIP am-alumina potential (num_layers = 8)" .

entity:run-nequip-b11-gramatte2024 a mlips:MLIPRun ;
    rdfs:label "NequIP with num_base = 11" ;
