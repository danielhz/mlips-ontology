# Canonical Turtle for the protocol-derived encoding of:
#   Simon Gramatte et al. (2024). Do we really need machine learning interatomic potentials for modeling amorphous metal oxides? Case study on amorphous alumina by recycling an existing ab initio database.
#   Modelling and Simulation in Materials Science and Engineering. doi:10.1088/1361-651x/ad39ff
#
# Version read: publisher (sha256 7bbc5687658e9474...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 278 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/gramatte2024.yaml.
#
# Encoding scope: NequIP potentials trained here on 835 amorphous-alumina
# structures selected from the AIMD database of Li et al. (Ref. [41]), in
# the four variants of Table 2 (default settings, one layer, eight layers,
# eleven radial basis functions), with energy and force RMSEs on the
# stoichiometric (889) and non-stoichiometric (835) test sets and their
# time per MD iteration. Classical fixed-charge and variable-charge
# potentials (Matsui, ReaxFF, COMB3, SMTB-Q and others) are not MLIPs and
# are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gramatte2024 a mlips:BenchmarkStudy ;
    rdfs:label "Gramatte, Turlo and Politano (2024): classical and NequIP potentials for amorphous alumina" ;
    mlips:reportedIn entity:article-gramatte2024 .

entity:article-gramatte2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1361-651x/ad39ff> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Do we really need machine learning interatomic potentials for modeling amorphous metal oxides? Case study on amorphous alumina by recycling an existing ab initio database" ;
    schema:author <https://orcid.org/0000-0002-0132-5742> ,
        <https://orcid.org/0000-0001-8120-4643> ,
        <https://orcid.org/0000-0002-2322-431X> .

<https://orcid.org/0000-0002-0132-5742> a schema:Person ;
    schema:name "Simon Gramatte" ;
    schema:givenName "Simon" ;
    schema:familyName "Gramatte" ;
    schema:identifier <https://orcid.org/0000-0002-0132-5742> .

<https://orcid.org/0000-0001-8120-4643> a schema:Person ;
    schema:name "Vladyslav Turlo" ;
    schema:givenName "Vladyslav" ;
    schema:familyName "Turlo" ;
    schema:identifier <https://orcid.org/0000-0001-8120-4643> .

<https://orcid.org/0000-0002-2322-431X> a schema:Person ;
    schema:name "Olivier Politano" ;
    schema:givenName "Olivier" ;
    schema:familyName "Politano" ;
    schema:identifier <https://orcid.org/0000-0002-2322-431X> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-am-alumina-gramatte2024 a mlips:MaterialSystem ;
    rdfs:label "Amorphous aluminium oxide over a range of stoichiometries and densities" ;
    mlips:chemicalFormula "AlxOy" ;
    mlips:materialClass "Amorphous metal oxide" .

entity:mat-am-al2o3-gramatte2024 a mlips:MaterialSystem ;
    rdfs:label "Stoichiometric amorphous Al2O3" ;
    mlips:chemicalFormula "Al2O3" ;
    mlips:materialClass "Amorphous metal oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-li-dft-gramatte2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-li-dft-gramatte2024 mlips:hasDFTSettings entity:calc-settings-li-dft-gramatte2024 .

entity:calc-settings-li-dft-gramatte2024 a mlips:DFTSettings ;
    rdfs:comment "AIMD database of Li et al. (Ref. [41], Materials Cloud 2020.89); settings not restated here." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-train-gramatte2024 a mlips:TrainingDataset ;
    rdfs:label "Training set: 835 structures binned by energy/atom, stoichiometry and density from the cleaned database of Ref. [41] (about 160,000 AIMD structures)" ;
    mlips:coversMaterial entity:mat-am-alumina-gramatte2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 835 ;
    mlips:hasDFTCalculation entity:calc-li-dft-gramatte2024 ;
    rdfs:comment "382 further structures form the validation set." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-NequIP-gramatte2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-NequIP-gramatte2024 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nequip-l1-numLayers-gramatte2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-nequip-l8-numLayers-gramatte2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-nequip-b11-numRadialBasis-gramatte2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "11"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nequip-default-gramatte2024 a mlips:MLIPRun ;
    rdfs:label "NequIP with the developers' default settings" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-train-gramatte2024 ;
    mlips:produces entity:model-nequip-default-gramatte2024 .

entity:model-nequip-default-gramatte2024 a mlips:TrainedModel ;
    rdfs:label "NequIP am-alumina potential (default settings)" .

entity:run-nequip-l1-gramatte2024 a mlips:MLIPRun ;
