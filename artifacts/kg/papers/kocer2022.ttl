@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kocer2022 a mlips:BenchmarkStudy ;
    rdfs:label "Kocer, Ko and Behler (2022): neural network potentials, a concise overview of methods (review)" ;
    mlips:reportedIn entity:article-kocer2022 .

entity:article-kocer2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1146/annurev-physchem-082720-034254> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Neural Network Potentials: A Concise Overview of Methods" ;
    schema:author entity:person-Kocer-kocer2022 ,
        entity:person-Ko-kocer2022 ,
        entity:person-Behler-kocer2022 .

entity:person-Kocer-kocer2022 a schema:Person ;
    schema:name "Emir Kocer" ;
    schema:givenName "Emir" ;
    schema:familyName "Kocer" .

entity:person-Ko-kocer2022 a schema:Person ;
    schema:name "Tsz Wai Ko" ;
    schema:givenName "Tsz Wai" ;
    schema:familyName "Ko" .

entity:person-Behler-kocer2022 a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" .

