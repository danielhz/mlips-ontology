###############################################################################

entity:ds-uni2d-wang2025uni2d a mlips:TrainingDataset ;
    rdfs:label "Uni2D training data (strained and perturbed C2DB and 2dMatpedia structures; 90/5/5 split)" ;
    mlips:coversMaterial entity:mat-twod-wang2025uni2d ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 327000 ;
    mlips:hasDFTCalculation entity:calc-optb88-wang2025uni2d .

