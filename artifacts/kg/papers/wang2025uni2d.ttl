###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:hasLossFunction entity:loss-M3GNet-wang2025uni2d ;
    mlips:hasTrainingAlgorithm entity:alg-M3GNet-wang2025uni2d ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-M3GNet-wang2025uni2d ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-M3GNet-wang2025uni2d a mlips:LossFunction ;
    rdfs:label "Huber loss (delta 0.01) on energy per atom, forces and stress with weights 1, 1, 0.1" .

entity:alg-M3GNet-wang2025uni2d a mls:Algorithm ;
    rdfs:label "Adam with cosine decay to 1 % after 100 epochs" .

entity:impl-M3GNet-wang2025uni2d a mlips:Implementation ;
    mlips:implementedIn entity:lib-MatterSim-wang2025uni2d .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:lib-MatterSim-wang2025uni2d a mlips:Library ;
    rdfs:label "MatterSim" ;
    mlips:candidateForVocabulary mlips:Library .

