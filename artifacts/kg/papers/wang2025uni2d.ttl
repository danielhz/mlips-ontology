###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-optb88-wang2025uni2d a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-optb88-wang2025uni2d mlips:hasDFTSettings entity:calc-settings-optb88-wang2025uni2d .

entity:calc-settings-optb88-wang2025uni2d a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-optB88-vdW-wang2025uni2d ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "pymatgen automatic, density 5000, one k-point along vacuum" ;
    rdfs:comment "Collinear spin, DFT+U with pymatgen defaults, MPStaticSet inputs (DFT Parameters)." .

entity:xc-optB88-vdW-wang2025uni2d a mlips:XCFunctional ;
    rdfs:label "optB88-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

