# Canonical Turtle for the protocol-derived encoding of:
#   William J. Baldwin et al. (2026). Design Space of Self--Consistent Electrostatic Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2603.14700  arXiv:2603.14700v2
#
# Version read: arxiv-preprint arXiv:2603.14700v2 (sha256 930b5c094aa9d2f7...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 482 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/baldwin2026.yaml.
#
# Encoding scope: the families of MACE-based models trained on the
# aluminium/water-slab/water-cluster dataset (2,590 configurations, PBE
# FHI-aims) and on charged oxygen vacancies in alpha-quartz SiO2:
# energy-functional and fixed-point self-consistent models, MACE-
# LocalCharges, MACE-QEq, a local MACE and (SiO2) a global-charge-
# embedding MACE. All share the medium MACE local part (128 channels,
# L = 1, 6 A cutoff). Each run stands for a family of fits (Table S.I).
# All errors are figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-baldwin2026 a mlips:BenchmarkStudy ;
    rdfs:label "Baldwin et al. (2026): design space of self-consistent electrostatic MLIPs (energy-functional and fixed-point charge-density models in MACE) with MACE-LocalCharges, MACE-QEq and global-charge-embedding baselines" ;
    mlips:reportedIn entity:article-baldwin2026 .

entity:article-baldwin2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2603.14700> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Design Space of Self--Consistent Electrostatic Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Baldwin-baldwin2026 ,
        entity:person-Batatia-baldwin2026 ,
        entity:person-Vondrak-baldwin2026 ,
        entity:person-Margraf-baldwin2026 ,
        entity:person-Csanyi-baldwin2026 .

entity:person-Baldwin-baldwin2026 a schema:Person ;
    schema:name "William J. Baldwin" ;
    schema:givenName "William J." ;
    schema:familyName "Baldwin" .

entity:person-Batatia-baldwin2026 a schema:Person ;
    schema:name "Ilyes Batatia" ;
    schema:givenName "Ilyes" ;
    schema:familyName "Batatia" .

entity:person-Vondrak-baldwin2026 a schema:Person ;
    schema:name "Martin Vondrák" ;
    schema:givenName "Martin" ;
    schema:familyName "Vondrák" .

entity:person-Margraf-baldwin2026 a schema:Person ;
    schema:name "Johannes T. Margraf" ;
    schema:givenName "Johannes T." ;
    schema:familyName "Margraf" .

entity:person-Csanyi-baldwin2026 a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-alwater-baldwin2026 a mlips:MaterialSystem ;
    rdfs:label "Aluminium slabs (with applied field), liquid-water slabs and neutral or hydronium water clusters" ;
    mlips:materialClass "Solid-liquid interface" .

entity:mat-sio2-baldwin2026 a mlips:MaterialSystem ;
    rdfs:label "alpha-quartz SiO2 with oxygen vacancies in charge states -1, 0, +1" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-aims-baldwin2026 a mlips:DFTCalculation .

entity:calc-sio2dft-baldwin2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-aims-baldwin2026 mlips:hasDFTSettings entity:calc-settings-aims-baldwin2026 .

entity:calc-settings-aims-baldwin2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "'tight' basis and integration grids; atomic multipoles of the Hartree potential extracted as targets" .

entity:calc-sio2dft-baldwin2026 mlips:hasDFTSettings entity:calc-settings-sio2dft-baldwin2026 .

entity:calc-settings-sio2dft-baldwin2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Charged-defect labels (-1, 0, +1); other settings in Sec. XII E" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-alwater-baldwin2026 a mlips:TrainingDataset ;
    rdfs:label "Water-metal dataset (2,590 configurations)" ;
    mlips:coversMaterial entity:mat-alwater-baldwin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2590 ;
    mlips:hasDFTCalculation entity:calc-aims-baldwin2026 .

entity:ds-sio2-baldwin2026 a mlips:TrainingDataset ;
    rdfs:label "SiO2 oxygen-vacancy dataset (300 configurations in three charge states, 374 puckered +1 configurations, relaxed geometries)" ;
    mlips:coversMaterial entity:mat-sio2-baldwin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-sio2dft-baldwin2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-alwater-baldwin2026 mlips:samplingStrategy
    entity:sampling-alw-baldwin2026 .

entity:ds-sio2-baldwin2026 mlips:samplingStrategy
    entity:sampling-vac-baldwin2026 .

entity:sampling-alw-baldwin2026 a mlips:SamplingStrategy ;
    rdfs:label "Al(111)/(100) slabs and water slabs with random out-of-plane fields (-0.1 to 0.1 V/A), water clusters of up to 12 molecules, half with a hydronium ion" .

entity:sampling-vac-baldwin2026 a mlips:SamplingStrategy ;
    rdfs:label "Foundation-model MD of oxygen-vacancy supercells with a Hookean Si-Si constraint (2.4-4.5 A), relabelled in three charge states, plus relaxed geometries" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-baldwin2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-baldwin2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-MACE-baldwin2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-MACE-baldwin2026 a mlips:LossFunction ;
    rdfs:label "Energy per atom, total dipole per atom, forces and atomic multipoles (Eq. 93), plus total charge and (SiO2 fixed-point) Fermi level terms" .

entity:alg-MACE-baldwin2026 a mls:Algorithm ;
    rdfs:label "Schedule-free optimizer; direct, implicit-differentiation, shortcut-SCF or unrolled-SCF training stages" .

entity:impl-MACE-baldwin2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

