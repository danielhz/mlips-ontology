# Canonical Turtle for the protocol-derived encoding of:
#   Yi-Lun Liao et al. (2023). EquiformerV2: Improved Equivariant Transformer for Scaling to Higher-Degree Representations.
#   arXiv (Cornell University). doi:10.48550/arxiv.2306.12059  arXiv:2306.12059v3
#
# Version read: arxiv-preprint arXiv:2306.12059v3 (sha256 b6100110d9b4a65a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 204 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/liao2023.yaml.
#
# Encoding scope: the EquiformerV2 architecture (introduced here) and its
# energy and force errors on OC20 S2EF (Tables 1, 2, 6), OC22 S2EF-Total
# (Table 4) and the QM9 U0 task (Table 5), plus the Equiformer model the
# authors trained on OC20 S2EF-2M for comparison (Table 6). Ablation
# variants of Table 1 other than the base setting, the eSCN ablation
# baselines, IS2RS/IS2RE and AdsorbML results, the other eleven QM9 targets
# and values quoted from other papers are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liao2023 a mlips:BenchmarkStudy ;
    rdfs:label "Liao et al. (2024): EquiformerV2, an improved equivariant transformer scaling to higher-degree representations" ;
    mlips:reportedIn entity:article-liao2023 .

entity:article-liao2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2306.12059> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "EquiformerV2: Improved Equivariant Transformer for Scaling to Higher-Degree Representations" ;
    schema:author entity:person-Liao-liao2023 ,
        entity:person-Wood-liao2023 ,
        entity:person-Das-liao2023 ,
        entity:person-Smidt-liao2023 .

entity:person-Liao-liao2023 a schema:Person ;
    schema:name "Yi-Lun Liao" ;
    schema:givenName "Yi-Lun" ;
    schema:familyName "Liao" .

entity:person-Wood-liao2023 a schema:Person ;
    schema:name "Brandon Wood" ;
    schema:givenName "Brandon" ;
    schema:familyName "Wood" .

entity:person-Das-liao2023 a schema:Person ;
    schema:name "Abhishek Das" ;
    schema:givenName "Abhishek" ;
    schema:familyName "Das" .

entity:person-Smidt-liao2023 a schema:Person ;
    schema:name "Tess Smidt" ;
    schema:givenName "Tess" ;
    schema:familyName "Smidt" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-oc20-liao2023 a mlips:MaterialSystem ;
    rdfs:label "Adsorbate-catalyst surface systems (OC20)" ;
    mlips:materialClass "Heterogeneous catalysis: adsorbates on inorganic surfaces" .

entity:mat-oc22-liao2023 a mlips:MaterialSystem ;
    rdfs:label "Oxide electrocatalyst surfaces with adsorbates (OC22)" ;
    mlips:materialClass "Heterogeneous catalysis: oxide surfaces" .

entity:mat-qm9-liao2023 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules (QM9)" ;
    mlips:materialClass "Small organic molecules (gas phase)" .

