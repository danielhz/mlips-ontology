###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:hasLossFunction entity:loss-EquiformerV2-liao2023 ;
    mlips:hasTrainingAlgorithm entity:alg-EquiformerV2-liao2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numRadialBasis ,
        entity:hp-Lmax-liao2023 ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-EquiformerV2-liao2023 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-EquiformerV2-liao2023 a mlips:LossFunction ;
    rdfs:label "Weighted sum of energy and force errors with energy coefficient lambda_E and force coefficient lambda_F" .

entity:alg-EquiformerV2-liao2023 a mls:Algorithm ;
    rdfs:label "AdamW with cosine learning-rate schedule and linear warmup, model EMA" .

entity:impl-EquiformerV2-liao2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-equiformer_v2-liao2023 .

entity:Equiformer a mlips:MLIPMethod ;
    rdfs:label "Equiformer (SE(3)/E(3)-equivariant graph attention transformer)" ;
    mlips:hasHyperparameter entity:hp-Lmax-liao2023 .

entity:lib-equiformer_v2-liao2023 a mlips:Library ;
    rdfs:label "equiformer_v2" ;
    rdfs:comment "https://github.com/atomicarchitects/equiformer_v2; relaxations with the Open Catalyst repository LBFGS" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Lmax-liao2023 a mlips:Hyperparameter ;
    rdfs:label "Maximum degree Lmax of the equivariant irreps features" ;
    mlips:hyperparameterName "Lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

