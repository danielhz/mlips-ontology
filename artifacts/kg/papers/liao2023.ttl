# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-s2ef-2m-liao2023 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF 2M training split" ;
    mlips:coversMaterial entity:mat-oc20-liao2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 2000000 .

entity:ds-s2ef-all-liao2023 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF-All training split" ;
    mlips:coversMaterial entity:mat-oc20-liao2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-s2ef-allmd-liao2023 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF-All+MD training split" ;
    mlips:coversMaterial entity:mat-oc20-liao2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-oc22-liao2023 a mlips:TrainingDataset ;
    rdfs:label "OC22 S2EF-Total training data" ;
    mlips:coversMaterial entity:mat-oc22-liao2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "OC22 energies are DFT total energies; about 8.4M structures (Sec. 4.2)." .

entity:ds-qm9-liao2023 a mlips:TrainingDataset ;
    rdfs:label "QM9 training set (about 110k molecules)" ;
    mlips:coversMaterial entity:mat-qm9-liao2023 ;
