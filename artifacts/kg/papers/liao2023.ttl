    mlips:runsOn entity:ds-s2ef-2m-liao2023 ;
    mlips:hasHyperparameterSetting entity:setting-eqv2-2m-L6-cutoffRadius-liao2023 ,
        entity:setting-eqv2-2m-L6-numLayers-liao2023 ,
