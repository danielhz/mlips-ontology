# Canonical Turtle for the protocol-derived encoding of:
#   Mirko Fischer et al. (2026). From oligomers to entangled polymers: How to train a transferable machine learning interatomic potential.
#   arXiv (Cornell University). doi:10.48550/arxiv.2608.01162  arXiv:2608.01162v1
#
# Version read: arxiv-preprint arXiv:2608.01162v1 (sha256 a532fb8577ffeeb7...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 587 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/fischer2026.yaml.
#
# Encoding scope: linear ACE potentials (606 basis functions up to
# four-body, 7 A cutoff) fitted with the ACELearner active-learning
# workflow to OPLS-AA reference energies and forces of polyethylene
# chains (C2H6 to C512H1026); the refined potentials after iterations
# 8, 12, 16 and 20 with total force and energy RMSEs on a common test
# set (Table 1). Intra/intermolecular and normalized RMSEs are not
# schema metrics; densities and structure are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-fischer2026 a mlips:BenchmarkStudy ;
    rdfs:label "Fischer and Heuer (2026): training a transferable ACE potential for polyethylene from oligomers to entangled polymers by active learning" ;
    mlips:reportedIn entity:article-fischer2026 .

entity:article-fischer2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2608.01162> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "From oligomers to entangled polymers: How to train a transferable machine learning interatomic potential" ;
    schema:author entity:person-Fischer-fischer2026 ,
        entity:person-Heuer-fischer2026 .

entity:person-Fischer-fischer2026 a schema:Person ;
    schema:name "Mirko Fischer" ;
    schema:givenName "Mirko" ;
    schema:familyName "Fischer" .

entity:person-Heuer-fischer2026 a schema:Person ;
    schema:name "Andreas Heuer" ;
    schema:givenName "Andreas" ;
    schema:familyName "Heuer" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-pe-fischer2026 a mlips:MaterialSystem ;
    rdfs:label "Polyethylene chains (single molecules, oligomer and polymer melts, volume scans)" ;
    mlips:materialClass "Polymers" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-opls-fischer2026 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-opls-fischer2026 mlips:hasReferenceSettings entity:calc-settings-opls-fischer2026 .

entity:calc-settings-opls-fischer2026 a mlips:ReferenceSettings ;
    rdfs:comment "OPLS-AA classical force field as the reference method" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-it8-fischer2026 a mlips:TrainingDataset ;
    rdfs:label "Active-learning data after iteration 8 (21,644 atomic environments)" ;
    mlips:coversMaterial entity:mat-pe-fischer2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-opls-fischer2026 .

entity:ds-it12-fischer2026 a mlips:TrainingDataset ;
    rdfs:label "Active-learning data after iteration 12 (58,230 atomic environments)" ;
    mlips:coversMaterial entity:mat-pe-fischer2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-opls-fischer2026 .

entity:ds-it16-fischer2026 a mlips:TrainingDataset ;
    rdfs:label "Active-learning data after iteration 16 (139,584 atomic environments)" ;
    mlips:coversMaterial entity:mat-pe-fischer2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-opls-fischer2026 .

entity:ds-it20-fischer2026 a mlips:TrainingDataset ;
    rdfs:label "Active-learning data after iteration 20 (246,238 atomic environments)" ;
    mlips:coversMaterial entity:mat-pe-fischer2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-opls-fischer2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-it8-fischer2026 mlips:samplingStrategy
    entity:sampling-al-fischer2026 .

entity:ds-it12-fischer2026 mlips:samplingStrategy
    entity:sampling-al-fischer2026 .

entity:ds-it16-fischer2026 mlips:samplingStrategy
    entity:sampling-al-fischer2026 .

entity:ds-it20-fischer2026 mlips:samplingStrategy
    entity:sampling-al-fischer2026 .

entity:sampling-al-fischer2026 a mlips:SamplingStrategy ;
    rdfs:label "Active learning from single-molecule and bulk MD with extrapolation-grade selection and volume scans (ACELearner)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-fischer2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-nfunc-fischer2026 ;
    mlips:hasImplementation entity:impl-ACE-fischer2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-ACE-fischer2026 a mlips:LossFunction ;
    rdfs:label "Weighted energies and forces with kappa = 0.95" .

entity:impl-ACE-fischer2026 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:hp-nfunc-fischer2026 a mlips:Hyperparameter ;
    rdfs:label "Number of ACE basis functions" ;
    mlips:hyperparameterName "number of basis functions" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ace-it8-cutoffRadius-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-ace-it8-nfunc-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-fischer2026 ;
    mlips:settingValue "606"^^xsd:integer .

entity:setting-ace-it12-cutoffRadius-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-ace-it12-nfunc-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-fischer2026 ;
    mlips:settingValue "606"^^xsd:integer .

entity:setting-ace-it16-cutoffRadius-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-ace-it16-nfunc-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-fischer2026 ;
    mlips:settingValue "606"^^xsd:integer .

entity:setting-ace-it20-cutoffRadius-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-ace-it20-nfunc-fischer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-fischer2026 ;
    mlips:settingValue "606"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ace-it8-fischer2026 a mlips:MLIPRun ;
    rdfs:label "Refined ACE potential after iteration 8" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-it8-fischer2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-it8-cutoffRadius-fischer2026 ,
        entity:setting-ace-it8-nfunc-fischer2026 ;
    mlips:produces entity:model-ace-it8-fischer2026 .

entity:model-ace-it8-fischer2026 a mlips:TrainedModel ;
    rdfs:label "ACE polyethylene (iteration 8)" .

entity:run-ace-it12-fischer2026 a mlips:MLIPRun ;
    rdfs:label "Refined ACE potential after iteration 12" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-it12-fischer2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-it12-cutoffRadius-fischer2026 ,
        entity:setting-ace-it12-nfunc-fischer2026 ;
    mlips:produces entity:model-ace-it12-fischer2026 .

entity:model-ace-it12-fischer2026 a mlips:TrainedModel ;
    rdfs:label "ACE polyethylene (iteration 12)" .

entity:run-ace-it16-fischer2026 a mlips:MLIPRun ;
    rdfs:label "Refined ACE potential after iteration 16" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-it16-fischer2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-it16-cutoffRadius-fischer2026 ,
        entity:setting-ace-it16-nfunc-fischer2026 ;
    mlips:produces entity:model-ace-it16-fischer2026 .

entity:model-ace-it16-fischer2026 a mlips:TrainedModel ;
    rdfs:label "ACE polyethylene (iteration 16)" .

entity:run-ace-it20-fischer2026 a mlips:MLIPRun ;
    rdfs:label "Refined ACE potential after iteration 20" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-it20-fischer2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-it20-cutoffRadius-fischer2026 ,
        entity:setting-ace-it20-nfunc-fischer2026 ;
