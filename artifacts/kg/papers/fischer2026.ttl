# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-fischer2026 mlips:hasResult
    entity:result-ace-it8-test-fischer2026 ,
    entity:result-ace-it12-test-fischer2026 ,
    entity:result-ace-it16-test-fischer2026 ,
    entity:result-ace-it20-test-fischer2026 .

entity:result-ace-it8-test-fischer2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ace-it8-fischer2026 ;
    mlips:targetMaterial entity:mat-pe-fischer2026 ;
    mlips:hasAccuracyMetric entity:metric-ace-it8-test-1-fischer2026 ,
        entity:metric-ace-it8-test-2-fischer2026 .

entity:metric-ace-it8-test-1-fischer2026 a mlips:AccuracyMetric ;
    rdfs:label "test total force RMSE on polyethylene: ACE iteration 8" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "42.6"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

