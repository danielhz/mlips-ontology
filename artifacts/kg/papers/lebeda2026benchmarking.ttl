@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-lebeda2026benchmarking a mlips:BenchmarkStudy ;
    rdfs:label "Lebeda et al. (2026): nine universal MLIPs for temperature-dependent elasticity of binary and high-entropy refractory carbides" ;
    mlips:reportedIn entity:article-lebeda2026benchmarking .

entity:article-lebeda2026benchmarking a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.11878> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Benchmarking Universal Machine-Learning Interatomic Potentials for Temperature-Dependent Elasticity of Binary and High-Entropy Refractory Carbides" ;
    schema:author entity:person-Lebeda-lebeda2026benchmarking ,
        entity:person-Drahokoupil-lebeda2026benchmarking ,
        entity:person-Svoboda-lebeda2026benchmarking ,
        entity:person-Vlcak-lebeda2026benchmarking .

