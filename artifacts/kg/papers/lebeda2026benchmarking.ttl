    schema:name "Miroslav Lebeda" ;
    schema:givenName "Miroslav" ;
    schema:familyName "Lebeda" .

entity:person-Drahokoupil-lebeda2026benchmarking a schema:Person ;
    schema:name "Jan Drahokoupil" ;
    schema:givenName "Jan" ;
    schema:familyName "Drahokoupil" .

entity:person-Svoboda-lebeda2026benchmarking a schema:Person ;
