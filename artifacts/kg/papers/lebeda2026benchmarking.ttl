    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-7net-nano-lebeda2026benchmarking .

entity:model-7net-nano-lebeda2026benchmarking a mlips:TrainedModel ;
    rdfs:label "7net-nano-5.5" .

