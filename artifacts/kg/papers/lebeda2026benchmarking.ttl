###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-carbides-lebeda2026benchmarking a mlips:MaterialSystem ;
    rdfs:label "Rocksalt TiC, ZrC, HfC, VC, TaC and the high-entropy carbides (Ti,Zr,Hf,Ta,W)C and (V,Nb,Ta,Mo,W)C (512-atom supercells)" ;
    mlips:materialClass "Refractory transition-metal carbides" .

