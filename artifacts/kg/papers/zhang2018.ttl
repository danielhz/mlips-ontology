    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 9500 ;
    mlips:hasDFTCalculation entity:calc-water-dft-zhang2018 ;
    rdfs:comment "9500 of 12000 snapshots selected at random for training." .

entity:ds-ice-d-zhang2018 a mlips:TrainingDataset ;
    rdfs:label "DeePMD training set: 9500 snapshots of ice d" ;
    mlips:coversMaterial entity:mat-ice-d-zhang2018 ;
    mlips:coversProperty mlips:Energy ,
