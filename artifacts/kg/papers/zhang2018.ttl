# Canonical Turtle for the protocol-derived encoding of:
#   Linfeng Zhang et al. (2018). Deep Potential Molecular Dynamics: A Scalable Model with the Accuracy of Quantum Mechanics.
#   Physical Review Letters. doi:10.1103/physrevlett.120.143001  arXiv:1707.09571v2
#
# Version read: arxiv-preprint arXiv:1707.09571v2 (sha256 41c4cf3b07ec173a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 17 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the original DeePMD model and its twelve fits: liquid
# water and three ice Ih conditions (PBE0+TS, path-integral or classical
# AIMD) and eight organic molecules (PBE+TS AIMD data of
# quantum-machine.org), with the errors of Tables I and II.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhang2018 a mlips:BenchmarkStudy ;
    rdfs:label "Zhang et al. (2018): Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:reportedIn entity:article-zhang2018 .

entity:article-zhang2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevlett.120.143001> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Deep Potential Molecular Dynamics: A Scalable Model with the Accuracy of Quantum Mechanics" ;
    schema:author entity:person-Zhang-zhang2018 ,
        entity:person-Han-zhang2018 ,
        entity:person-Wang-zhang2018 ,
        entity:person-Car-zhang2018 ,
        entity:person-E-zhang2018 .

entity:person-Zhang-zhang2018 a schema:Person ;
    schema:name "Linfeng Zhang" ;
    schema:givenName "Linfeng" ;
    schema:familyName "Zhang" .

entity:person-Han-zhang2018 a schema:Person ;
    schema:name "Jiequn Han" ;
    schema:givenName "Jiequn" ;
    schema:familyName "Han" .

entity:person-Wang-zhang2018 a schema:Person ;
    schema:name "Han Wang" ;
    schema:givenName "Han" ;
    schema:familyName "Wang" .

entity:person-Car-zhang2018 a schema:Person ;
    schema:name "Roberto Car" ;
    schema:givenName "Roberto" ;
    schema:familyName "Car" .

entity:person-E-zhang2018 a schema:Person ;
    schema:name "Weinan E" ;
    schema:givenName "Weinan" ;
    schema:familyName "E" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-liquid-water-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Liquid water at 1 bar and 300 K (path-integral AIMD, 64 H2O)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-ice-b-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Ice Ih at 1 bar and 273 K (path-integral AIMD, 96 H2O)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Proton-disordered molecular crystal (ice Ih)" .

entity:mat-ice-c-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Ice Ih at 1 bar and 330 K (classical AIMD, 96 D2O)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Proton-disordered molecular crystal (ice Ih)" .

entity:mat-ice-d-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Ice Ih at 2.13 kbar and 238 K (classical AIMD, 96 D2O)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Proton-disordered molecular crystal (ice Ih)" .

entity:mat-benzene-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-uracil-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Uracil molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-naphthalene-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Naphthalene molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-aspirin-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-salicylic-acid-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-malonaldehyde-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-ethanol-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-toluene-zhang2018 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-water-dft-zhang2018 a mlips:DFTCalculation .

entity:calc-mol-dft-zhang2018 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-water-dft-zhang2018 mlips:hasDFTSettings entity:calc-settings-water-dft-zhang2018 .

entity:calc-settings-water-dft-zhang2018 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-PBE0-TS-zhang2018 ;
    rdfs:comment "Car-Parrinello MD (CPMD) codes of Quantum ESPRESSO, time step 0.48 fs, Parrinello-Rahman variable cell; path-integral runs through i-PI with 8 beads (generalized Langevin equation with coloured noise), classical runs with a Nose-Hoover thermostat." .

entity:calc-mol-dft-zhang2018 mlips:hasDFTSettings entity:calc-settings-mol-dft-zhang2018 .

entity:calc-settings-mol-dft-zhang2018 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE-TS-zhang2018 ;
    rdfs:comment "Classical AIMD trajectories with the PBE+TS functional, taken from quantum-machine.org; code and settings are not given in this paper." .

entity:xc-PBE0-TS-zhang2018 a mlips:XCFunctional ;
    rdfs:label "PBE0+TS" ;
    rdfs:comment "PBE0 hybrid functional with Tkatchenko-Scheffler dispersion correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-PBE-TS-zhang2018 a mlips:XCFunctional ;
    rdfs:label "PBE+TS" ;
    rdfs:comment "PBE functional with Tkatchenko-Scheffler dispersion correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-liquid-water-zhang2018 a mlips:TrainingDataset ;
    rdfs:label "DeePMD training set: 95000 snapshots of liquid water" ;
    mlips:coversMaterial entity:mat-liquid-water-zhang2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 95000 ;
    mlips:hasDFTCalculation entity:calc-water-dft-zhang2018 ;
    rdfs:comment "95000 of 105000 snapshots selected at random for training." .

entity:ds-ice-b-zhang2018 a mlips:TrainingDataset ;
    rdfs:label "DeePMD training set: 19500 snapshots of ice b" ;
    mlips:coversMaterial entity:mat-ice-b-zhang2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 19500 ;
    mlips:hasDFTCalculation entity:calc-water-dft-zhang2018 ;
    rdfs:comment "19500 of 24000 snapshots selected at random for training." .

entity:ds-ice-c-zhang2018 a mlips:TrainingDataset ;
    rdfs:label "DeePMD training set: 9500 snapshots of ice c" ;
    mlips:coversMaterial entity:mat-ice-c-zhang2018 ;
