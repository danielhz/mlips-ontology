    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 9500 ;
    mlips:hasDFTCalculation entity:calc-water-dft-zhang2018 ;
    rdfs:comment "9500 of 12000 snapshots selected at random for training." .

entity:ds-benzene-zhang2018 a mlips:TrainingDataset ;
    rdfs:label "DeePMD training set: 95000 snapshots of benzene" ;
    mlips:coversMaterial entity:mat-benzene-zhang2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 95000 ;
    mlips:hasDFTCalculation entity:calc-mol-dft-zhang2018 .

entity:ds-uracil-zhang2018 a mlips:TrainingDataset ;
