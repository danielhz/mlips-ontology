###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-liquid-water-zhang2018 mlips:samplingStrategy
    entity:sampling-pi-aimd-zhang2018 .

entity:ds-ice-b-zhang2018 mlips:samplingStrategy
    entity:sampling-pi-aimd-zhang2018 .

entity:ds-ice-c-zhang2018 mlips:samplingStrategy
    entity:sampling-classical-aimd-zhang2018 .

entity:ds-ice-d-zhang2018 mlips:samplingStrategy
    entity:sampling-classical-aimd-zhang2018 .

entity:ds-benzene-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:ds-uracil-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:ds-naphthalene-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:ds-aspirin-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:ds-salicylic-acid-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:ds-malonaldehyde-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:ds-ethanol-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:ds-toluene-zhang2018 mlips:samplingStrategy
    entity:sampling-md17-aimd-zhang2018 .

entity:sampling-pi-aimd-zhang2018 a mlips:SamplingStrategy ;
    rdfs:label "Path-integral AIMD (NPT)" ;
    rdfs:comment "Snapshots drawn at random along equilibrated path-integral AIMD trajectories (liquid water 6.2 ps, ice Ih (b) 1.5 ps); the remaining snapshots are used for testing." .

entity:sampling-classical-aimd-zhang2018 a mlips:SamplingStrategy ;
    rdfs:label "Classical AIMD (NPT)" ;
    rdfs:comment "Snapshots drawn at random along equilibrated classical AIMD trajectories of 6.0 ps (ice Ih (c) and (d)); the remaining snapshots are used for testing." .

entity:sampling-md17-aimd-zhang2018 a mlips:SamplingStrategy ;
    rdfs:label "Classical AIMD of gas-phase molecules (quantum-machine.org)" ;
    rdfs:comment "95000 snapshots per molecule drawn at random from the published AIMD database; the remaining snapshots are used for testing." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-zhang2018 ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-zhang2018 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize ,
        entity:hp-hidden-layers-zhang2018 ,
        entity:hp-training-steps-zhang2018 ,
        entity:hp-lr-decay-rate-zhang2018 ,
        entity:hp-lr-decay-steps-zhang2018 ;
    mlips:hasImplementation entity:impl-DeePMD-zhang2018 ;
    mlips:supportsSimulation mlips:MolecularDynamics ;
    mlips:inferenceComplexity "Linear in the number of atoms" .

entity:loss-DeePMD-zhang2018 a mlips:LossFunction ;
    rdfs:label "Weighted sum of squared errors in energy per atom, forces and virial per atom with tunable prefactors (p_e, p_f, p_xi); p_e and p_xi are increased and p_f decreased during training, evolving linearly with the learning rate; p_xi = 0 when no virial data are available" .

entity:alg-DeePMD-zhang2018 a mls:Algorithm ;
    rdfs:label "Adam (beta1 = 0.9, beta2 = 0.999, epsilon = 1e-8) with exponentially decaying learning rate" .

entity:impl-DeePMD-zhang2018 a mlips:Implementation ;
    mlips:implementedIn entity:lib-TensorFlow-r1_0-interfaced-with-in-house-C-codes-zhang2018 .

entity:lib-TensorFlow-r1_0-interfaced-with-in-house-C-codes-zhang2018 a mlips:Library ;
    rdfs:label "TensorFlow r1.0 interfaced with in-house C++ codes" ;
    rdfs:comment "The implementation used in this paper; predates the DeePMD-kit package." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-hidden-layers-zhang2018 a mlips:Hyperparameter ;
    rdfs:label "DeePMD hidden-layer widths of the atomic network" ;
    mlips:hyperparameterName "hidden_layers" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-training-steps-zhang2018 a mlips:Hyperparameter ;
    rdfs:label "Number of training steps" ;
    mlips:hyperparameterName "training_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-rate-zhang2018 a mlips:Hyperparameter ;
    rdfs:label "Exponential learning-rate decay rate" ;
    mlips:hyperparameterName "decay_rate" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lr-decay-steps-zhang2018 a mlips:Hyperparameter ;
    rdfs:label "Learning-rate decay step" ;
    mlips:hyperparameterName "decay_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-liquid-water-cutoffRadius-zhang2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-liquid-water-hidden-layers-zhang2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-hidden-layers-zhang2018 ;
    mlips:settingValue "240-120-60-30-10" .

