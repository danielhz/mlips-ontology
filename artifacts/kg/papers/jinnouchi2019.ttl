###############################################################################

entity:run-mlff-mapbi3-jinnouchi2019 a mlips:MLIPRun ;
    rdfs:label "On-the-fly MLFF for MAPbI3" ;
    mlips:appliesMethod entity:VASP-MLFF ;
    mlips:runsOn entity:ds-mapbi3-jinnouchi2019 ;
    mlips:produces entity:model-mlff-mapbi3-jinnouchi2019 .

entity:model-mlff-mapbi3-jinnouchi2019 a mlips:TrainedModel ;
    rdfs:label "VASP on-the-fly MLFF MAPbI3 (2019)" .

entity:run-mlff-cspbi3-jinnouchi2019 a mlips:MLIPRun ;
    rdfs:label "On-the-fly MLFF for CsPbI3" ;
    mlips:appliesMethod entity:VASP-MLFF ;
    mlips:runsOn entity:ds-cspbi3-jinnouchi2019 ;
    mlips:produces entity:model-mlff-cspbi3-jinnouchi2019 .

entity:model-mlff-cspbi3-jinnouchi2019 a mlips:TrainedModel ;
    rdfs:label "VASP on-the-fly MLFF CsPbI3 (2019)" .

entity:run-mlff-abx3-jinnouchi2019 a mlips:MLIPRun ;
    rdfs:label "On-the-fly MLFFs for other ABX3 perovskites" ;
    mlips:appliesMethod entity:VASP-MLFF ;
    mlips:runsOn entity:ds-abx3-jinnouchi2019 ;
    mlips:produces entity:model-mlff-abx3-jinnouchi2019 .

entity:model-mlff-abx3-jinnouchi2019 a mlips:TrainedModel ;
    rdfs:label "VASP on-the-fly MLFFs ABX3 (2019)" .

