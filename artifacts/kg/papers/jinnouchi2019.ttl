# Canonical Turtle for the protocol-derived encoding of:
#   Ryosuke Jinnouchi et al. (2019). Phase Transitions of Hybrid Perovskites Simulated by Machine-Learning Force Fields Trained on the Fly with Bayesian Inference.
#   Physical Review Letters. doi:10.1103/physrevlett.122.225701  arXiv:1903.09613v1
#
# Version read: arxiv-preprint arXiv:1903.09613v1 (sha256 4df858d4155fb327...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 505 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/jinnouchi2019.yaml.
#
# Encoding scope: the on-the-fly MLFF scheme (GAP-variant kernel
# regression on SOAP-variant descriptors, Bayesian error deciding when
# to run first-principles calculations, integrated in VASP) and its
# force fields for MAPbI3, CsPbI3 and other ABX3 perovskites (A = Cs, Fr;
# X = I, Br, Cl). The only accuracy figures (2.6 meV/atom, 0.07 eV/A,
# 0.82 kbar) are not named as RMSE or MAE in the text read. Lattice
# constants, transition temperatures and order parameters are
# properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-jinnouchi2019 a mlips:BenchmarkStudy ;
    rdfs:label "Jinnouchi et al. (2019): on-the-fly machine-learning force fields with Bayesian inference in VASP, applied to phase transitions of hybrid and inorganic lead-halide perovskites" ;
    mlips:reportedIn entity:article-jinnouchi2019 .

entity:article-jinnouchi2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevlett.122.225701> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "Phase Transitions of Hybrid Perovskites Simulated by Machine-Learning Force Fields Trained on the Fly with Bayesian Inference" ;
    schema:author entity:person-Jinnouchi-jinnouchi2019 ,
        entity:person-Lahnsteiner-jinnouchi2019 ,
        entity:person-Karsai-jinnouchi2019 ,
        entity:person-Kresse-jinnouchi2019 ,
        entity:person-Bokdam-jinnouchi2019 .

entity:person-Jinnouchi-jinnouchi2019 a schema:Person ;
    schema:name "Ryosuke Jinnouchi" ;
    schema:givenName "Ryosuke" ;
    schema:familyName "Jinnouchi" .

entity:person-Lahnsteiner-jinnouchi2019 a schema:Person ;
    schema:name "Jonathan Lahnsteiner" ;
    schema:givenName "Jonathan" ;
    schema:familyName "Lahnsteiner" .

entity:person-Karsai-jinnouchi2019 a schema:Person ;
    schema:name "Ferenc Karsai" ;
    schema:givenName "Ferenc" ;
    schema:familyName "Karsai" .

entity:person-Kresse-jinnouchi2019 a schema:Person ;
    schema:name "Georg Kresse" ;
    schema:givenName "Georg" ;
    schema:familyName "Kresse" .

