    schema:familyName "Bokdam" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mapbi3-jinnouchi2019 a mlips:MaterialSystem ;
    rdfs:label "MAPbI3 (orthorhombic, tetragonal, cubic)" ;
    mlips:chemicalFormula "CH3NH3PbI3" ;
    mlips:materialClass "Hybrid organic-inorganic perovskite" .

entity:mat-cspbi3-jinnouchi2019 a mlips:MaterialSystem ;
    rdfs:label "CsPbI3" ;
    mlips:chemicalFormula "CsPbI3" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-abx3-jinnouchi2019 a mlips:MaterialSystem ;
    rdfs:label "Inorganic perovskites ABX3 (A = Cs or Fr, B = Pb, X = I, Br or Cl)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-jinnouchi2019 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-jinnouchi2019 mlips:hasDFTSettings entity:calc-settings-vasp-jinnouchi2019 .

entity:calc-settings-vasp-jinnouchi2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Meta-GGA functional of Ref. 27 (not named in the text read); training in 2x2x2 unit cells" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mapbi3-jinnouchi2019 a mlips:TrainingDataset ;
    rdfs:label "MAPbI3 on-the-fly training structures" ;
    mlips:coversMaterial entity:mat-mapbi3-jinnouchi2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-jinnouchi2019 .

entity:ds-cspbi3-jinnouchi2019 a mlips:TrainingDataset ;
    rdfs:label "CsPbI3 on-the-fly training structures" ;
    mlips:coversMaterial entity:mat-cspbi3-jinnouchi2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-jinnouchi2019 .

entity:ds-abx3-jinnouchi2019 a mlips:TrainingDataset ;
    rdfs:label "ABX3 on-the-fly training structures" ;
    mlips:coversMaterial entity:mat-abx3-jinnouchi2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-jinnouchi2019 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mapbi3-jinnouchi2019 mlips:samplingStrategy
    entity:sampling-otf-jinnouchi2019 .

entity:ds-cspbi3-jinnouchi2019 mlips:samplingStrategy
    entity:sampling-otf-jinnouchi2019 .

entity:ds-abx3-jinnouchi2019 mlips:samplingStrategy
    entity:sampling-otf-jinnouchi2019 .

entity:sampling-otf-jinnouchi2019 a mlips:SamplingStrategy ;
    rdfs:label "On-the-fly sampling during NPT MD in all three phases: first-principles calculations only when the Bayesian force error exceeds an adaptive threshold (99% skipped)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:VASP-MLFF a mlips:MLIPMethod ;
    rdfs:label "VASP on-the-fly machine-learned force field (kernel regression on two- and three-body distribution descriptors with Bayesian error estimates)" ;
    mlips:hasLossFunction entity:loss-VASP-MLFF-jinnouchi2019 ;
    mlips:hasTrainingAlgorithm entity:alg-VASP-MLFF-jinnouchi2019 ;
    mlips:hasImplementation entity:impl-VASP-MLFF-jinnouchi2019 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-VASP-MLFF-jinnouchi2019 a mlips:LossFunction ;
    rdfs:label "Bayesian linear regression on energies, forces and stresses; sigma_v and sigma_w from the evidence approximation" .

entity:alg-VASP-MLFF-jinnouchi2019 a mls:Algorithm ;
    rdfs:label "On-the-fly learning with Bayesian error estimates" .

entity:impl-VASP-MLFF-jinnouchi2019 a mlips:Implementation ;
    mlips:implementedIn mlips:VASP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

