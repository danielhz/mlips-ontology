    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType entity:pp-GTH-chahal2025 ;
    rdfs:comment "PBE-D3, CP2K QUICKSTEP, DZVP-MOLOPT basis, 600 Ry density cutoff, NVT AIMD with 1 fs steps for 16-80 ps (Sec. DeePMD NNIP Development)." .

