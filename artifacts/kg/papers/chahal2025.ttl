# Q7 -- MLIP method, components, implementation
###############################################################################

entity:VASP-MLFF a mlips:MLIPMethod ;
    rdfs:label "VASP on-the-fly machine-learned force field (kernel regression on two- and three-body distribution descriptors with Bayesian error estimates)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-VASP-MLFF-chahal2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-VASP-MLFF-chahal2025 a mlips:Implementation ;
    mlips:implementedIn mlips:VASP .

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-DeePMD-chahal2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-DeePMD-chahal2025 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

