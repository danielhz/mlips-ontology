###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-chahal2025 mlips:hasDFTSettings entity:calc-settings-vasp-chahal2025 .

entity:calc-settings-vasp-chahal2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "1x1x1" ;
    rdfs:comment "PBE-D3, VASP 6.3, Al 3s2 3p1 valence, EDIFF 1e-5 eV; on-the-fly AIMD for the MLFF (Sec. VASP MLFF Development)." .

