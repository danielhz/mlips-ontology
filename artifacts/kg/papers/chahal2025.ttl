# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mlff-otf-chahal2025 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly AIMD frames of 15 Al2Cl6 dimers (500-800 K NPT ramp plus 0.8 and 0.6 g/cm3 NVT)" ;
    mlips:coversMaterial entity:mat-alcl3-chahal2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1555 ;
    mlips:hasDFTCalculation entity:calc-vasp-chahal2025 .

entity:ds-nnip1-chahal2025 a mlips:TrainingDataset ;
    rdfs:label "NNIP-1 data: 15 Al2Cl6 dimer configurations at and around the 498 K density (5-25 % compressed/expanded), 80/20 train/validation split" ;
    mlips:coversMaterial entity:mat-alcl3-chahal2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-cp2k-chahal2025 ;
    rdfs:comment "55,355 configurations at 498 K density plus 16,074 + 16,125 + 19,123 + 16,513 + 71,000 compressed/expanded (Sec. NNIP Training)." .

entity:ds-nnip2-chahal2025 a mlips:TrainingDataset ;
    rdfs:label "NNIP-2 data: NNIP-1 data plus 454,839 configurations (further compressed/expanded bulk and 2-7 dimer gas-phase cells), 80/20 split" ;
    mlips:coversMaterial entity:mat-alcl3-chahal2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-cp2k-chahal2025 .

