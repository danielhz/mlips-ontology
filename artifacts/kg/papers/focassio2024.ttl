entity:ds-ong21-all-focassio2024 a mlips:TrainingDataset ;
    rdfs:label "[Ong21] training data for Ni, Cu, Li, Mo, Si and Ge together (1402 structures)" ;
    mlips:coversMaterial entity:mat-Ni-focassio2024 ,
        entity:mat-Cu-focassio2024 ,
        entity:mat-Li-focassio2024 ,
        entity:mat-Mo-focassio2024 ,
        entity:mat-Si-focassio2024 ,
        entity:mat-Ge-focassio2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1402 ;
    rdfs:comment "The paper states 1402 structures for fine-tuning; this equals the sum of the per-element training counts (263 + 262 + 241 + 194 + 214 + 228)." .

entity:ds-ong21-Ni-focassio2024 a mlips:TrainingDataset ;
    rdfs:label "[Ong21] Ni data (263 training / 31 test structures)" ;
    mlips:coversMaterial entity:mat-Ni-focassio2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 263 ;
    rdfs:comment "Split 90:10 into training and validation for the NequIP fits." .

