entity:mat-bulk-set-focassio2024 a mlips:MaterialSystem ;
    rdfs:label "Bulk structures of Ni, Cu, Li, Mo, Si and Ge (parents of the Materials Project surface set)" ;
    mlips:materialClass "Unary bulk crystals" .

entity:mat-surface-set-focassio2024 a mlips:MaterialSystem ;
    rdfs:label "Surface slabs of Ni, Cu, Li, Mo, Si and Ge from the Materials Project surface data set (Crystalium)" ;
    mlips:materialClass "Unary surface slabs" ;
    mlips:microstructuralFeature "Free surfaces of several Miller indices" .

entity:mat-Ni-focassio2024 a mlips:MaterialSystem ;
    rdfs:label "Elemental Ni" ;
    mlips:chemicalFormula "Ni" ;
    mlips:materialClass "Unary fcc material" .

entity:mat-Cu-focassio2024 a mlips:MaterialSystem ;
    rdfs:label "Elemental Cu" ;
    mlips:chemicalFormula "Cu" ;
    mlips:materialClass "Unary fcc material" .

entity:mat-Li-focassio2024 a mlips:MaterialSystem ;
    rdfs:label "Elemental Li" ;
    mlips:chemicalFormula "Li" ;
    mlips:materialClass "Unary bcc material" .

entity:mat-Mo-focassio2024 a mlips:MaterialSystem ;
    rdfs:label "Elemental Mo" ;
    mlips:chemicalFormula "Mo" ;
    mlips:materialClass "Unary bcc material" .

entity:mat-Si-focassio2024 a mlips:MaterialSystem ;
    rdfs:label "Elemental Si" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Unary diamond cubic material" .

entity:mat-Ge-focassio2024 a mlips:MaterialSystem ;
