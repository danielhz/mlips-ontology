    rdfs:label "Structures of the [Ong21] data set (Zuo et al. 2020)" ;
    rdfs:comment "Ground state, strained cells, slabs and AIMD snapshots as generated by Zuo et al.; taken from the maml package." .

entity:sampling-mptrj-unary-focassio2024 a mlips:SamplingStrategy ;
    rdfs:label "Unary structures filtered from MPtrj" ;
    rdfs:comment "Materials Project relaxation-trajectory frames of single-element structures; the entire subset is used for training." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-focassio2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numAngularBasis ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        entity:hp-max-L-focassio2024 ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-focassio2024 .

entity:loss-MACE-focassio2024 a mlips:LossFunction ;
    rdfs:label "Huber loss on energy, forces and stress with weights lambda_E = 1, lambda_F = 10, lambda_sigma = 100 (from-scratch model)" .

entity:impl-MACE-focassio2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE ;
    mlips:version "training scripts of https://github.com/ACEsuit/mace" .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:hasLossFunction entity:loss-M3GNet-focassio2024 ;
    mlips:hasTrainingAlgorithm entity:alg-M3GNet-focassio2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-M3GNet-focassio2024 .

entity:loss-M3GNet-focassio2024 a mlips:LossFunction ;
    rdfs:label "Huber loss (delta = 0.01) with a 1 : 1 : 0.1 weight ratio for energy (eV/atom), force (eV/A) and stress (GPa) (from-scratch model)" .

entity:alg-M3GNet-focassio2024 a mls:Algorithm ;
    rdfs:label "Adam, initial rate 1e-3 with cosine decay to 1% of the initial value in 100 epochs; 200 epochs with a patience of 50 epochs on the validation loss" .

entity:impl-M3GNet-focassio2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-matgl-focassio2024 .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-focassio2024 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-focassio2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numAngularBasis ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NequIP-focassio2024 .

entity:loss-NequIP-focassio2024 a mlips:LossFunction ;
    rdfs:label "Weighted sum of per-atom energy MSE and force MSE with weights 4 and 1" .

entity:alg-NequIP-focassio2024 a mls:Algorithm ;
    rdfs:label "Adam in AMSGrad mode without weight decay; hyperparameters by grid search over cutoff (4-7 A), number of features (32, 64) and lmax (1, 2)" .

entity:impl-NequIP-focassio2024 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP ;
    mlips:version "https://github.com/mir-group/nequip" .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-focassio2024 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-focassio2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-MTP-focassio2024 .

entity:loss-MTP-focassio2024 a mlips:LossFunction ;
    rdfs:label "Weighted fit with energy weight 1.0 and force weight 0.01" .

entity:alg-MTP-focassio2024 a mls:Algorithm ;
    rdfs:label "Maximum of 500 / 1000 / 2000 iterations for <=16 / 20 / 24 polynomial powers; cutoff and number of polynomial powers by grid search" .

entity:impl-MTP-focassio2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" .

entity:lib-matgl-focassio2024 a mlips:Library ;
    rdfs:label "matgl" ;
    rdfs:comment "https://github.com/materialsvirtuallab/matgl" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-max-L-focassio2024 a mlips:Hyperparameter ;
    rdfs:label "MACE maximum equivariance order L of the messages" ;
    mlips:hyperparameterName "max_L" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

