# Canonical Turtle for the protocol-derived encoding of:
#   Bruno Focassio et al. (2024). Performance Assessment of Universal Machine Learning Interatomic Potentials: Challenges and Directions for Materials’ Surfaces.
#   ACS Applied Materials & Interfaces. doi:10.1021/acsami.4c03815  arXiv:2403.04217v2
#
# Version read: arxiv-preprint arXiv:2403.04217v2 (sha256 51bf14c13e25906d...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 101 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the comparison of Table S1 for Ni, Cu, Li, Mo, Si, Ge:
# three pretrained universal models (registry stubs), MACE and M3GNet
# fine-tuned and trained from scratch on the [Ong21] data (the data of
# zuo2020), per-element NequIP and MTP fits on [Ong21] and on the unary
# MPtrj subset (MPtrj*), and the MTP models published with zuo2020.
# RMSEs are aggregated over the bulk and the surface structures of the
# six elements.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-focassio2024 a mlips:BenchmarkStudy ;
    rdfs:label "Focassio et al. (2024): universal MLIPs on Materials Project surfaces (MACE-MP-0, CHGNet, M3GNet, fine-tuned and specialised models)" ;
    mlips:reportedIn entity:article-focassio2024 .

entity:article-focassio2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acsami.4c03815> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Performance Assessment of Universal Machine Learning Interatomic Potentials: Challenges and Directions for Materials’ Surfaces" ;
    schema:author <https://orcid.org/0000-0003-4811-7729> ,
        <https://orcid.org/0000-0002-1874-5612> ,
        <https://orcid.org/0000-0003-3129-8682> .

<https://orcid.org/0000-0003-4811-7729> a schema:Person ;
    schema:name "Bruno Focassio" ;
    schema:givenName "Bruno" ;
    schema:familyName "Focassio" ;
    schema:identifier <https://orcid.org/0000-0003-4811-7729> .

<https://orcid.org/0000-0002-1874-5612> a schema:Person ;
    schema:name "Luis Paulo M. Freitas" ;
    schema:givenName "Luis Paulo" ;
    schema:familyName "M. Freitas" ;
    schema:identifier <https://orcid.org/0000-0002-1874-5612> .

<https://orcid.org/0000-0003-3129-8682> a schema:Person ;
    schema:name "Gabriel R. Schleder" ;
    schema:givenName "Gabriel R." ;
    schema:familyName "Schleder" ;
    schema:identifier <https://orcid.org/0000-0003-3129-8682> .

