entity:article-hong2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.commatsci.2026.115108> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "SLUSCHI-UP: A web infrastructure for SLUSCHI melting-temperature calculations using universal machine-learning interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-5970-0605> .

<https://orcid.org/0000-0002-5970-0605> a schema:Person ;
    schema:name "Qi-Jun Hong" ;
