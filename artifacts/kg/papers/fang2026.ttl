###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-modope-fang2026 a mlips:MaterialSystem ;
    rdfs:label "Dilute Mo alloys (0.78-1.85 at.%) with Cr, Fe, Mn, Nb, Re, Ta, Ti, V, W, Y or Zr in BCC and FCC Mo supercells" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-fang2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-fang2026 mlips:hasDFTSettings entity:calc-settings-pbe-fang2026 .

entity:calc-settings-pbe-fang2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "VASP 6.3.0, spin polarisation, fixed lattice of optimised pure Mo; further settings in SI Text S2." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fte-fang2026 a mlips:TrainingDataset ;
    rdfs:label "FT-E: near-equilibrium doped-Mo structures (IID (81:9):10 splits, 10 repeats)" ;
    mlips:coversMaterial entity:mat-modope-fang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 420 ;
    mlips:hasDFTCalculation entity:calc-pbe-fang2026 .

entity:ds-ftne-fang2026 a mlips:TrainingDataset ;
    rdfs:label "FT-E_NE: equilibrium and relaxation-trajectory doped-Mo structures (IID splits, 5 repeats)" ;
    mlips:coversMaterial entity:mat-modope-fang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 6970 ;
    mlips:hasDFTCalculation entity:calc-pbe-fang2026 .

entity:ds-ftne-sm-fang2026 a mlips:TrainingDataset ;
    rdfs:label "FT-E_NE subsample size-matched to FT-E" ;
    mlips:coversMaterial entity:mat-modope-fang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-fang2026 .

