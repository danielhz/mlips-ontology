###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-fang2026 ;
    mlips:hasImplementation entity:impl-MACE-fang2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-MACE-fang2026 a mlips:LossFunction ;
    rdfs:label "Per-atom energy MAE plus force MSE (weights lambda_E, lambda_F)" .

entity:impl-MACE-fang2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

