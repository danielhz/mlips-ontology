###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-oxides-tran2023 a mlips:MaterialSystem ;
    rdfs:label "Oxide surfaces (slabs) with and without OER-relevant adsorbates (OC22)" ;
    mlips:materialClass "Oxide electrocatalyst surfaces" .

entity:mat-oc20-tran2023 a mlips:MaterialSystem ;
    rdfs:label "Adsorbate-catalyst systems of OC20" ;
    mlips:materialClass "Heterogeneous catalysis: adsorbates on inorganic surfaces" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-oc22-dft-tran2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-oc22-dft-tran2023 mlips:hasDFTSettings entity:calc-settings-oc22-dft-tran2023 .

entity:calc-settings-oc22-dft-tran2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    rdfs:comment "Spin-polarised; Hubbard U for transition-metal oxides as suggested by the Materials Project; energies and forces converged to 1e-4 eV and 0.05 eV/A; Gamma-centred k-point meshes (SI)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-oc22-tran2023 a mlips:TrainingDataset ;
    rdfs:label "OC22 S2EF-Total training split (8,225,293 structures)" ;
    mlips:coversMaterial entity:mat-oxides-tran2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 8225293 ;
    mlips:hasDFTCalculation entity:calc-oc22-dft-tran2023 ;
    rdfs:comment "62,331 relaxations (about 9,854,504 single points); validation and test splits in-domain and out-of-domain by catalyst composition; total (not adsorption) energies." .

entity:ds-oc20-2m-oc22-tran2023 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF 2M combined with OC22 S2EF-Total (DFT total energies)" ;
    mlips:coversMaterial entity:mat-oxides-tran2023 ,
        entity:mat-oc20-tran2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented .

entity:ds-oc20-20m-oc22-tran2023 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF 20M combined with OC22 S2EF-Total (DFT total energies)" ;
    mlips:coversMaterial entity:mat-oxides-tran2023 ,
        entity:mat-oc20-tran2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented .

entity:ds-oc20-all-oc22-tran2023 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF All combined with OC22 S2EF-Total (DFT total energies)" ;
    mlips:coversMaterial entity:mat-oxides-tran2023 ,
        entity:mat-oc20-tran2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:GemNet a mlips:MLIPMethod ;
    rdfs:label "GemNet (geometric message passing neural network)" ;
    mlips:hasFunctionalForm entity:ff-GemNet ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:ff-GemNet a mlips:FunctionalForm ;
    rdfs:label "Directional graph neural network with geometric message passing over atom triplets and, in the two-hop form, quadruplets, built on spherical representations; energies are sums of atomic contributions and forces are obtained by backpropagation or, in the direct variants, predicted directly" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-schnet-cutoffRadius-tran2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dimenetpp-cutoffRadius-tran2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-painn-cutoffRadius-tran2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-gemnet-dt-cutoffRadius-tran2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-painn-2m-cutoffRadius-tran2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-painn-20m-cutoffRadius-tran2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-gemnet-dt-ft-cutoffRadius-tran2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

