# Canonical Turtle for the protocol-derived encoding of:
#   Zihan Pengmei et al. (2024). Beyond MD17: the reactive xxMD dataset.
#   Scientific Data. doi:10.1038/s41597-024-03019-3  arXiv:2308.11155v3
#
# Version read: arxiv-preprint arXiv:2308.11155v3 (sha256 8dd0f36dbca976de...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 49 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the xxMD data sets (geometries of azobenzene,
# malonaldehyde, stilbene and dithiophene from nonadiabatic trajectory
# surface hopping dynamics) and the benchmark of six neural force fields
# (MACE, Allegro, NequIP, SchNet, DimeNet++, SphereNet) on the
# single-state xxMD-DFT set with a temporal train/test split (Table 2).
# The multi-state xxMD-CASSCF benchmark (Table 1) is not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-pengmei2024 a mlips:BenchmarkStudy ;
    rdfs:label "Pengmei et al. (2024): beyond MD17, the reactive xxMD data set, with a benchmark of six neural force fields" ;
    mlips:reportedIn entity:article-pengmei2024 .

entity:article-pengmei2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41597-024-03019-3> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Beyond MD17: the reactive xxMD dataset" ;
    schema:author entity:person-Pengmei-pengmei2024 ,
        <https://orcid.org/0000-0003-1669-8039> ,
        <https://orcid.org/0000-0002-8371-0221> .

entity:person-Pengmei-pengmei2024 a schema:Person ;
    schema:name "Zihan Pengmei" ;
    schema:givenName "Zihan" ;
    schema:familyName "Pengmei" .

<https://orcid.org/0000-0003-1669-8039> a schema:Person ;
    schema:name "Junyu Liu" ;
    schema:givenName "Junyu" ;
    schema:familyName "Liu" ;
    schema:identifier <https://orcid.org/0000-0003-1669-8039> .

<https://orcid.org/0000-0002-8371-0221> a schema:Person ;
    schema:name "Yinan Shu" ;
    schema:givenName "Yinan" ;
    schema:familyName "Shu" ;
    schema:identifier <https://orcid.org/0000-0002-8371-0221> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-azobenzene-pengmei2024 a mlips:MaterialSystem ;
    rdfs:label "Azobenzene molecule along photochemical reaction pathways (xxMD)" ;
    mlips:materialClass "Organic molecule (gas phase); geometries from nonadiabatic dynamics, far from the ground-state minimum" .

entity:mat-stilbene-pengmei2024 a mlips:MaterialSystem ;
    rdfs:label "Stilbene molecule along photochemical reaction pathways (xxMD)" ;
    mlips:materialClass "Organic molecule (gas phase); geometries from nonadiabatic dynamics, far from the ground-state minimum" .

entity:mat-malonaldehyde-pengmei2024 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule along photochemical reaction pathways (xxMD)" ;
    mlips:materialClass "Organic molecule (gas phase); geometries from nonadiabatic dynamics, far from the ground-state minimum" .

entity:mat-dithiophene-pengmei2024 a mlips:MaterialSystem ;
    rdfs:label "Dithiophene molecule along photochemical reaction pathways (xxMD)" ;
    mlips:materialClass "Organic molecule (gas phase); geometries from nonadiabatic dynamics, far from the ground-state minimum" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-pengmei2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-pengmei2024 mlips:hasDFTSettings entity:calc-settings-dft-pengmei2024 .

entity:calc-settings-dft-pengmei2024 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-M06-pengmei2024 ;
    rdfs:comment "Single-point unrestricted KS-DFT with M06 on the geometries of the nonadiabatic trajectories (xxMD-DFT). Basis set and code are in the supplementary computational details and were not captured." .

entity:xc-M06-pengmei2024 a mlips:XCFunctional ;
    rdfs:label "M06" ;
    rdfs:comment "Meta-GGA hybrid functional; spin-polarised (unrestricted) Kohn-Sham DFT." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-azobenzene-pengmei2024 a mlips:TrainingDataset ;
    rdfs:label "xxMD-DFT azobenzene: training split (4200 of 8414 samples)" ;
    mlips:coversMaterial entity:mat-azobenzene-pengmei2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4200 ;
    mlips:hasDFTCalculation entity:calc-dft-pengmei2024 .

entity:ds-stilbene-pengmei2024 a mlips:TrainingDataset ;
    rdfs:label "xxMD-DFT stilbene: training split (12800 of 27965 samples)" ;
    mlips:coversMaterial entity:mat-stilbene-pengmei2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 12800 ;
    mlips:hasDFTCalculation entity:calc-dft-pengmei2024 .

entity:ds-malonaldehyde-pengmei2024 a mlips:TrainingDataset ;
    rdfs:label "xxMD-DFT malonaldehyde: training split (14000 of 25568 samples)" ;
    mlips:coversMaterial entity:mat-malonaldehyde-pengmei2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 14000 ;
    mlips:hasDFTCalculation entity:calc-dft-pengmei2024 .

entity:ds-dithiophene-pengmei2024 a mlips:TrainingDataset ;
    rdfs:label "xxMD-DFT dithiophene: training split (12400 of 24769 samples)" ;
    mlips:coversMaterial entity:mat-dithiophene-pengmei2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 12400 ;
    mlips:hasDFTCalculation entity:calc-dft-pengmei2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-azobenzene-pengmei2024 mlips:samplingStrategy
    entity:sampling-tsh-pengmei2024 ,
    entity:sampling-temporal-split-pengmei2024 .

entity:ds-stilbene-pengmei2024 mlips:samplingStrategy
    entity:sampling-tsh-pengmei2024 ,
    entity:sampling-temporal-split-pengmei2024 .

entity:ds-malonaldehyde-pengmei2024 mlips:samplingStrategy
    entity:sampling-tsh-pengmei2024 ,
    entity:sampling-temporal-split-pengmei2024 .

entity:ds-dithiophene-pengmei2024 mlips:samplingStrategy
    entity:sampling-tsh-pengmei2024 ,
    entity:sampling-temporal-split-pengmei2024 .

entity:sampling-tsh-pengmei2024 a mlips:SamplingStrategy ;
    rdfs:label "Trajectory surface hopping nonadiabatic dynamics at the SA-CASSCF level" ;
    rdfs:comment "Geometries sampled from energy-conserving trajectories with state-averaged CASSCF (active spaces from (2e,2o) to (10e,10o), 6-31g or 6-31g* basis)." .

entity:sampling-temporal-split-pengmei2024 a mlips:SamplingStrategy ;
    rdfs:label "Temporal split by trajectory time step" ;
    rdfs:comment "Training, validation and test sets are partitioned by trajectory time steps rather than at random, so the test set probes extrapolation." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-pengmei2024 .

entity:loss-MACE-pengmei2024 a mlips:LossFunction ;
    rdfs:label "Weighted loss of 1 : 1000 on energy and forces" .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-pengmei2024 .

entity:loss-Allegro-pengmei2024 a mlips:LossFunction ;
    rdfs:label "Weighted loss of 1 : 1000 on energy and forces" .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-pengmei2024 .

entity:loss-NequIP-pengmei2024 a mlips:LossFunction ;
    rdfs:label "Weighted loss of 1 : 1000 on energy and forces" .

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:hasLossFunction entity:loss-SchNet-pengmei2024 .

entity:loss-SchNet-pengmei2024 a mlips:LossFunction ;
    rdfs:label "Weighted loss of 1 : 1000 on energy and forces" .

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:hasLossFunction entity:loss-DimeNet-pengmei2024 .

entity:loss-DimeNet-pengmei2024 a mlips:LossFunction ;
    rdfs:label "Weighted loss of 1 : 1000 on energy and forces" .

entity:SphereNet a mlips:MLIPMethod ;
    rdfs:label "SphereNet (spherical message passing neural network)" ;
    mlips:hasLossFunction entity:loss-SphereNet-pengmei2024 .

entity:loss-SphereNet-pengmei2024 a mlips:LossFunction ;
    rdfs:label "Weighted loss of 1 : 1000 on energy and forces" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

