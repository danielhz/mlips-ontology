# Canonical Turtle for the protocol-derived encoding of:
#   Moin Uddin Maruf et al. (2025). Learning Long-Range Interactions in Equivariant Machine Learning Interatomic Potentials via Electronic Degrees of Freedom.
#   The Journal of Physical Chemistry Letters. doi:10.1021/acs.jpclett.5c02352  arXiv:2503.17949v1
#
# Version read: arxiv-preprint arXiv:2503.17949v1 (sha256 3ca6e88225675100...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 306 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/maruf2025.yaml.
#
# Encoding scope: NequIP-LR (introduced here) and NequIP trained on five
# data sets with long-range or charge-transfer effects (Au2 on MgO(001),
# BTA on Cu(111) with and without water, Ag3 clusters, carbon chains),
# with the force and energy RMSEs of Table 1 and the 3 A NequIP-LR on
# BTA-Cu. The 4G-HDNNP values of Table 1 are quoted from Ko et al. and not
# encoded; inference times are figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-maruf2025 a mlips:BenchmarkStudy ;
    rdfs:label "Maruf, Kim and Ahmad (2025): NequIP-LR, an equivariant MLIP with charge equilibration and long-range electrostatics" ;
    mlips:reportedIn entity:article-maruf2025 .

entity:article-maruf2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpclett.5c02352> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Learning Long-Range Interactions in Equivariant Machine Learning Interatomic Potentials via Electronic Degrees of Freedom" ;
    schema:author entity:person-Maruf-maruf2025 ,
        entity:person-Kim-maruf2025 ,
        <https://orcid.org/0000-0001-9758-8952> .

entity:person-Maruf-maruf2025 a schema:Person ;
    schema:name "Moin Uddin Maruf" ;
    schema:givenName "Moin Uddin" ;
    schema:familyName "Maruf" .

entity:person-Kim-maruf2025 a schema:Person ;
    schema:name "Sungmin Kim" ;
    schema:givenName "Sungmin" ;
    schema:familyName "Kim" .

<https://orcid.org/0000-0001-9758-8952> a schema:Person ;
    schema:name "Zeeshan Ahmad" ;
    schema:givenName "Zeeshan" ;
    schema:familyName "Ahmad" ;
    schema:identifier <https://orcid.org/0000-0001-9758-8952> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-au2-mgo-maruf2025 a mlips:MaterialSystem ;
    rdfs:label "Au2 cluster on undoped and Al-doped MgO(001)" ;
    mlips:materialClass "Supported metal cluster on oxide" .

entity:mat-bta-cu-maruf2025 a mlips:MaterialSystem ;
    rdfs:label "Benzotriazole chemisorbed and physisorbed on Cu(111)" ;
    mlips:materialClass "Molecule-metal interface" .

entity:mat-bta-h2o-cu-maruf2025 a mlips:MaterialSystem ;
    rdfs:label "BTAH and BTA- on Cu(111) in water (with H3O+)" ;
    mlips:materialClass "Solvated molecule-metal interface" .

entity:mat-ag3-maruf2025 a mlips:MaterialSystem ;
    rdfs:label "Ag3 clusters with total charge +1 and -1" ;
    mlips:materialClass "Charged metal clusters" .

entity:mat-c-chain-maruf2025 a mlips:MaterialSystem ;
    rdfs:label "C10H2 and C10H3+ carbon chains" ;
    mlips:materialClass "Charged organic molecules" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ko2021-maruf2025 a mlips:DFTCalculation .

entity:calc-bta-dft-maruf2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ko2021-maruf2025 mlips:hasDFTSettings entity:calc-settings-ko2021-maruf2025 .

entity:calc-settings-ko2021-maruf2025 a mlips:DFTSettings ;
    rdfs:comment "Data sets of Ko et al. (Nat. Commun. 2021) for Au2-MgO, Ag3 and carbon chains; settings not restated." .

entity:calc-bta-dft-maruf2025 mlips:hasDFTSettings entity:calc-settings-bta-dft-maruf2025 .

entity:calc-settings-bta-dft-maruf2025 a mlips:DFTSettings ;
    rdfs:comment "AIMD of BTA on Cu(111) generated in this work (with Hirshfeld charges); settings not stated in the main text." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-au2-mgo-maruf2025 a mlips:TrainingDataset ;
    rdfs:label "Au2-MgO(001) data set of Ko et al." ;
    mlips:coversMaterial entity:mat-au2-mgo-maruf2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-ko2021-maruf2025 .

entity:ds-bta-cu-maruf2025 a mlips:TrainingDataset ;
    rdfs:label "BTA-Cu(111) AIMD data set (400 steps, half chemisorbed, half physisorbed)" ;
    mlips:coversMaterial entity:mat-bta-cu-maruf2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 400 ;
    mlips:hasDFTCalculation entity:calc-bta-dft-maruf2025 .

entity:ds-bta-h2o-cu-maruf2025 a mlips:TrainingDataset ;
    rdfs:label "BTA(H2O)-Cu(111) AIMD data set (300 steps each for BTAH and BTA-)" ;
    mlips:coversMaterial entity:mat-bta-h2o-cu-maruf2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 600 ;
    mlips:hasDFTCalculation entity:calc-bta-dft-maruf2025 .

entity:ds-ag3-maruf2025 a mlips:TrainingDataset ;
    rdfs:label "Ag3 cluster data set of Ko et al. (5,000 structures used for training)" ;
    mlips:coversMaterial entity:mat-ag3-maruf2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-ko2021-maruf2025 .

entity:ds-c-chain-maruf2025 a mlips:TrainingDataset ;
    rdfs:label "Carbon-chain data set of Ko et al. (5,000 of 10,019 structures used for training)" ;
    mlips:coversMaterial entity:mat-c-chain-maruf2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-ko2021-maruf2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NequIP-maruf2025 .

entity:impl-NequIP-maruf2025 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

entity:NequIP-LR a mlips:MLIPMethod ;
    rdfs:label "NequIP-LR (NequIP with charge equilibration from predicted electronegativities and long-range Coulomb energy)" ;
    mlips:hasLossFunction entity:loss-NequIP-LR-maruf2025 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-LR-maruf2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NequIP-LR-maruf2025 .

entity:loss-NequIP-LR-maruf2025 a mlips:LossFunction ;
    rdfs:label "Energy (alpha_E = 1), forces (alpha_F = N_at) and Hirshfeld charges (alpha_Q = 10)" .

entity:alg-NequIP-LR-maruf2025 a mls:Algorithm ;
    rdfs:label "Charge equilibration of Gaussian charges from predicted electronegativities, with total-charge constraint" .

entity:impl-NequIP-LR-maruf2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-nequip-charge-maruf2025 .

entity:lib-nequip-charge-maruf2025 a mlips:Library ;
    rdfs:label "nequip-charge" ;
    rdfs:comment "github.com/ahmad-research-group/nequip-charge" ;
    mlips:candidateForVocabulary mlips:Library .

