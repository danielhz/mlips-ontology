# Canonical Turtle for the protocol-derived encoding of:
#   Ryuhei Okuno et al. (2026). MLIP Detective: Active Failure Mode Discovery Beyond Benchmark Scores for Machine-Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2609.08399  arXiv:2609.08399v1
#
# Version read: arxiv-preprint arXiv:2609.08399v1 (sha256 3ddd17db3ccd266d...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 279 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/okuno2026.yaml.
#
# Encoding scope: the target model MACE-MPA-0 and the committee models
# (Matlantis PFP v9.0.0 and v8.0.0, SevenNet-Omni, SevenNet, Orb-v3) used
# by the agentic MLIP Detective framework; the stated adsorption-energy MAE
# of MACE-MPA-0 against DFT-PBE on a 36-system subset of the Wellendorff
# benchmark. The adsorption anomalies (relative energies, desorption
# barriers, CI-NEB profiles with DFT single points) are single-system
# properties, not error metrics, and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-okuno2026 a mlips:BenchmarkStudy ;
    rdfs:label "Okuno et al. (2026): MLIP Detective, LLM-agent failure-mode discovery for universal MLIPs (case MACE-MPA-0)" ;
    mlips:reportedIn entity:article-okuno2026 .

entity:article-okuno2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2609.08399> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "MLIP Detective: Active Failure Mode Discovery Beyond Benchmark Scores for Machine-Learning Interatomic Potentials" ;
    schema:author entity:person-Okuno-okuno2026 ,
        entity:person-Charoenphakdee-okuno2026 ,
        entity:person-Hisama-okuno2026 ,
        entity:person-Tsuboi-okuno2026 .

entity:person-Okuno-okuno2026 a schema:Person ;
    schema:name "Ryuhei Okuno" ;
    schema:givenName "Ryuhei" ;
    schema:familyName "Okuno" .

entity:person-Charoenphakdee-okuno2026 a schema:Person ;
    schema:name "Nontawat Charoenphakdee" ;
    schema:givenName "Nontawat" ;
    schema:familyName "Charoenphakdee" .

entity:person-Hisama-okuno2026 a schema:Person ;
    schema:name "Kaoru Hisama" ;
    schema:givenName "Kaoru" ;
    schema:familyName "Hisama" .

entity:person-Tsuboi-okuno2026 a schema:Person ;
    schema:name "Yuta Tsuboi" ;
    schema:givenName "Yuta" ;
    schema:familyName "Tsuboi" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-adsorption-okuno2026 a mlips:MaterialSystem ;
    rdfs:label "Small adsorbates (O, OH, CO, NO, F, H, N, S) on transition-metal surfaces" ;
    mlips:materialClass "Adsorbate-metal surface systems" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-okuno2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-okuno2026 mlips:hasDFTSettings entity:calc-settings-pbe-okuno2026 .

entity:calc-settings-pbe-okuno2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "680"^^xsd:double ;
    mlips:kPointMesh "7x7x1 (slab), 2x2x2 (molecule)" ;
    rdfs:comment "VASP 6.5.1, PBE_64 PAW, spin-polarised collinear, Gaussian smearing 0.05 eV, SCF 1e-6 eV; single points on the CO/Cu(111) NEB images." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand ,
        mlips:MolecularDynamics .

entity:TeaNet a mlips:MLIPMethod ;
    rdfs:label "TeaNet (tensor embedded atom network)" ;
    mlips:hasFunctionalForm entity:ff-TeaNet ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:ff-TeaNet a mlips:FunctionalForm ;
    rdfs:label "Graph convolutional network whose message passing carries scalar, vector and rank-2 tensor values on atoms and bonds, motivated by rewriting the embedded-atom and bond-order (Tersoff-type) potentials as graph convolutions and by iterative electronic relaxation; energies are sums of atomic contributions and forces come from backpropagation" .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-mpa-0-okuno2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed (MPtrj + sAlex)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa-0-okuno2026 .

entity:model-mace-mpa-0-okuno2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-pfp-v9-okuno2026 a mlips:MLIPRun ;
    rdfs:label "Matlantis PFP v9.0.0 as distributed (PBE mode)" ;
    mlips:appliesMethod entity:TeaNet ;
    mlips:produces entity:model-pfp-v9-okuno2026 .

entity:model-pfp-v9-okuno2026 a mlips:TrainedModel ;
    rdfs:label "Matlantis PFP v9.0.0" .

entity:run-pfp-v8-okuno2026 a mlips:MLIPRun ;
    rdfs:label "Matlantis PFP v8.0.0 as distributed" ;
    mlips:appliesMethod entity:TeaNet ;
    mlips:produces entity:model-pfp-v8-okuno2026 .

entity:model-pfp-v8-okuno2026 a mlips:TrainedModel ;
    rdfs:label "Matlantis PFP v8.0.0" .

entity:run-sevennet-omni-okuno2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Omni as distributed (MatPES-PBE and MPA channels)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-sevennet-omni-okuno2026 .

entity:model-sevennet-omni-okuno2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Omni" .

entity:run-sevennet-okuno2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet as distributed (checkpoint not stated)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-sevennet-okuno2026 .

entity:model-sevennet-okuno2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet" .

entity:run-orb-v3-okuno2026 a mlips:MLIPRun ;
    rdfs:label "Orb-v3 as distributed (OMat)" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb-v3-okuno2026 .

entity:model-orb-v3-okuno2026 a mlips:TrainedModel ;
    rdfs:label "Orb-v3 (OMat)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-okuno2026 mlips:hasResult
    entity:result-mace-mpa-0-okuno2026 .

entity:result-mace-mpa-0-okuno2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-mpa-0-okuno2026 ;
    mlips:targetMaterial entity:mat-adsorption-okuno2026 ;
    mlips:hasAccuracyMetric entity:metric-mace-mpa-0-1-okuno2026 .

entity:metric-mace-mpa-0-1-okuno2026 a mlips:AccuracyMetric ;
    rdfs:label "Adsorption-energy MAE vs DFT-PBE: MACE-MPA-0, 36 adsorbate-surface systems" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.21"^^xsd:double ;
    mlips:hasUnit unit:EV .

###############################################################################
# Q11 -- Computational resources
###############################################################################

