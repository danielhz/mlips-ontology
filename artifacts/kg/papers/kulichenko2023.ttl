# Q2 -- Material system
###############################################################################

entity:mat-glycine-kulichenko2023 a mlips:MaterialSystem ;
    rdfs:label "Glycine molecule, conformational space including proton-transfer and rotation paths" ;
    mlips:chemicalFormula "C2H5NO2" ;
    mlips:materialClass "Amino acid (gas phase)" .

