###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-udd-350K-kulichenko2023 mlips:samplingStrategy
    entity:sampling-udd-al-kulichenko2023 .

entity:ds-md-350K-kulichenko2023 mlips:samplingStrategy
    entity:sampling-md-al-kulichenko2023 .

entity:ds-md-600K-kulichenko2023 mlips:samplingStrategy
    entity:sampling-md-al-kulichenko2023 .

entity:ds-md-1000K-kulichenko2023 mlips:samplingStrategy
    entity:sampling-md-al-kulichenko2023 .

entity:sampling-udd-al-kulichenko2023 a mlips:SamplingStrategy ;
    rdfs:label "Uncertainty-driven dynamics active learning (UDD-AL) at 350 K" ;
    rdfs:comment "MD with an ensemble of eight ANI networks on a potential modified by a bias that favours regions of large ensemble disagreement; configurations above an uncertainty criterion are computed with DFT and added. Seeds: 25 near-equilibrium glycine geometries." .

entity:sampling-md-al-kulichenko2023 a mlips:SamplingStrategy ;
    rdfs:label "Plain MD active learning (MD-AL) at fixed temperature" ;
    rdfs:comment "Unbiased MD with the ensemble at 350 K, 600 K or 1,000 K; uncertain configurations are computed with DFT and added." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-ANI-kulichenko2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        entity:hp-nn-architecture-kulichenko2023 ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-ANI-kulichenko2023 a mls:Algorithm ;
    rdfs:label "Adam; initial learning rate 0.001, batch size 32, early stopping after 50 epochs without validation improvement, restart with the learning rate halved, termination below 1e-5; ensembles from an eightfold cross-validation split" .

entity:hp-nn-architecture-kulichenko2023 a mlips:Hyperparameter ;
    rdfs:label "ANI atomic network architecture" ;
    mlips:hyperparameterName "nn_architecture" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

