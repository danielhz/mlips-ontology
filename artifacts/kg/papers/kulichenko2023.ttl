###############################################################################

entity:calc-dft-kulichenko2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-kulichenko2023 mlips:hasDFTSettings entity:calc-settings-dft-kulichenko2023 .

entity:calc-settings-dft-kulichenko2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-PSI4-kulichenko2023 ;
    mlips:xcFunctional entity:xc-omegaB97X-D-kulichenko2023 ;
    mlips:dftBasisSet entity:basis-cc-pVTZ-kulichenko2023 ;
    rdfs:comment "omegaB97X-D/cc-pVTZ as implemented in PSI4." .

entity:lib-PSI4-kulichenko2023 a mlips:Library ;
    rdfs:label "PSI4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-omegaB97X-D-kulichenko2023 a mlips:XCFunctional ;
    rdfs:label "omegaB97X-D" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-cc-pVTZ-kulichenko2023 a mlips:DftBasisSet ;
    rdfs:label "cc-pVTZ" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

