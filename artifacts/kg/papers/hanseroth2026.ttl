# Q6 -- Sampling strategies
###############################################################################

entity:ds-CDP-hanseroth2026 mlips:samplingStrategy
    entity:sampling-aimd-hanseroth2026 .

entity:ds-CPP-hanseroth2026 mlips:samplingStrategy
    entity:sampling-aimd-hanseroth2026 .

