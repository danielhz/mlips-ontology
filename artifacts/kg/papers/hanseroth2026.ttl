    entity:sampling-aimd-hanseroth2026 .

entity:sampling-aimd-hanseroth2026 a mlips:SamplingStrategy ;
    rdfs:label "Every 100th frame of Born-Oppenheimer AIMD trajectories at the target temperature (300-600 K depending on the system); no active learning" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-hanseroth2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-hanseroth2026 ,
        mlips:learningRate ,
        entity:hp-force-weight-hanseroth2026 ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-hanseroth2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-MACE-hanseroth2026 a mls:Algorithm ;
    rdfs:label "Fine-tuning of a pretrained foundation model on system-specific AIMD data (aMACEing Toolkit workflow)" .

entity:impl-MACE-hanseroth2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE ;
    mlips:version "mace-torch 0.3.10" .

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:hasTrainingAlgorithm entity:alg-GRACE-hanseroth2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-hanseroth2026 ,
        mlips:learningRate ,
        entity:hp-force-weight-hanseroth2026 ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-GRACE-hanseroth2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:alg-GRACE-hanseroth2026 a mls:Algorithm ;
    rdfs:label "Fine-tuning of a pretrained foundation model on system-specific AIMD data (aMACEing Toolkit workflow)" .

entity:impl-GRACE-hanseroth2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GRACE-tensorpotential-hanseroth2026 .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-hanseroth2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-hanseroth2026 ,
        mlips:learningRate ,
        entity:hp-force-weight-hanseroth2026 ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-hanseroth2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-NequIP-hanseroth2026 a mls:Algorithm ;
    rdfs:label "Fine-tuning of a pretrained foundation model on system-specific AIMD data (aMACEing Toolkit workflow)" .

entity:impl-NequIP-hanseroth2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-hanseroth2026 .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:hasTrainingAlgorithm entity:alg-M3GNet-hanseroth2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-hanseroth2026 ,
        mlips:learningRate ,
        entity:hp-force-weight-hanseroth2026 ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-M3GNet-hanseroth2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-M3GNet-hanseroth2026 a mls:Algorithm ;
    rdfs:label "Fine-tuning of a pretrained foundation model on system-specific AIMD data (aMACEing Toolkit workflow)" .

entity:impl-M3GNet-hanseroth2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-MatterSim-hanseroth2026 .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-ORB-hanseroth2026 ;
    mlips:hasHyperparameter entity:hp-initialisation-hanseroth2026 ,
        mlips:learningRate ,
        entity:hp-force-weight-hanseroth2026 ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-ORB-hanseroth2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-ORB-hanseroth2026 a mls:Algorithm ;
    rdfs:label "Fine-tuning of a pretrained foundation model on system-specific AIMD data (aMACEing Toolkit workflow)" .

entity:impl-ORB-hanseroth2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-orb-models-hanseroth2026 .

entity:lib-GRACE-tensorpotential-hanseroth2026 a mlips:Library ;
    rdfs:label "GRACE tensorpotential" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-SevenNet-hanseroth2026 a mlips:Library ;
    rdfs:label "SevenNet" ;
    rdfs:comment "SevenNet 0.11.2; SevenNet models are encoded under the registry method NequIP." ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-MatterSim-hanseroth2026 a mlips:Library ;
    rdfs:label "MatterSim" ;
    rdfs:comment "MatterSim 1.1.2; MatterSim models are encoded under the registry method M3GNet." ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-orb-models-hanseroth2026 a mlips:Library ;
    rdfs:label "orb-models" ;
    rdfs:comment "ORB 0.3.2." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-initialisation-hanseroth2026 a mlips:Hyperparameter ;
    rdfs:label "Foundation model the fine-tuning starts from" ;
    mlips:hyperparameterName "initialisation" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-force-weight-hanseroth2026 a mlips:Hyperparameter ;
    rdfs:label "Force weight (force-to-energy loss ratio)" ;
    mlips:hyperparameterName "force_weight" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

