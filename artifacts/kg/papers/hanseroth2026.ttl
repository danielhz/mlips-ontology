# Canonical Turtle for the protocol-derived encoding of:
#   Jonas Hänseroth et al. (2026). Fine-Tuning Unifies Foundational Machine-Learned Interatomic Potential Architectures at ab initio Accuracy.
#   The Journal of Physical Chemistry Letters. doi:10.1021/acs.jpclett.5c03801  arXiv:2511.05337v1
#
# Version read: arxiv-preprint arXiv:2511.05337v1 (sha256 0bbac1bda60bbffe...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 164 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the 35 fine-tuning runs (five frameworks, MACE, GRACE,
# SevenNet, MatterSim and ORB, on seven systems), each with its
# hyperparameters (SI Table S4), fine-tuning cost (Table S2) and force and
# energy errors after fine-tuning (Table S1). The zero-shot errors of the
# foundation models are kept in comments. Read from the arXiv preprint
# (v1).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-hanseroth2026 a mlips:BenchmarkStudy ;
    rdfs:label "Haenseroth et al. (2026): fine-tuning unifies foundational MLIP architectures at ab initio accuracy" ;
    mlips:reportedIn entity:article-hanseroth2026 .

entity:article-hanseroth2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpclett.5c03801> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Fine-Tuning Unifies Foundational Machine-Learned Interatomic Potential Architectures at ab initio Accuracy" ;
    schema:author <https://orcid.org/0009-0003-8324-6160> ,
        entity:person-Flototto-hanseroth2026 ,
        <https://orcid.org/0000-0003-4167-3116> ,
        <https://orcid.org/0000-0002-0145-1263> .

<https://orcid.org/0009-0003-8324-6160> a schema:Person ;
    schema:name "Jonas Hänseroth" ;
    schema:givenName "Jonas" ;
    schema:familyName "Hänseroth" ;
    schema:identifier <https://orcid.org/0009-0003-8324-6160> .

entity:person-Flototto-hanseroth2026 a schema:Person ;
    schema:name "Aaron Flötotto" ;
    schema:givenName "Aaron" ;
    schema:familyName "Flötotto" .

<https://orcid.org/0000-0003-4167-3116> a schema:Person ;
    schema:name "Muhammad Nawaz Qaisrani" ;
    schema:givenName "Muhammad Nawaz" ;
    schema:familyName "Qaisrani" ;
    schema:identifier <https://orcid.org/0000-0003-4167-3116> .

<https://orcid.org/0000-0002-0145-1263> a schema:Person ;
    schema:name "Christian Dreßler" ;
    schema:givenName "Christian" ;
    schema:familyName "Dreßler" ;
    schema:identifier <https://orcid.org/0000-0002-0145-1263> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-CDP-hanseroth2026 a mlips:MaterialSystem ;
    rdfs:label "CsH2PO4 (solid acid proton conductor)" ;
    mlips:materialClass "Fine-tuning benchmark system" .

entity:mat-CPP-hanseroth2026 a mlips:MaterialSystem ;
    rdfs:label "Cs7(H4PO4)(H2PO4)8 (solid acid)" ;
    mlips:materialClass "Fine-tuning benchmark system" .

entity:mat-PyroNH4-hanseroth2026 a mlips:MaterialSystem ;
    rdfs:label "L-pyroglutamate ammonium (organic molecular crystal with short hydrogen bonds)" ;
    mlips:materialClass "Fine-tuning benchmark system" .

entity:mat-PhOH-hanseroth2026 a mlips:MaterialSystem ;
    rdfs:label "Phenol in water (388 atoms)" ;
    mlips:materialClass "Fine-tuning benchmark system" .

entity:mat-KOH-hanseroth2026 a mlips:MaterialSystem ;
    rdfs:label "Aqueous KOH solution (288 atoms)" ;
    mlips:materialClass "Fine-tuning benchmark system" .

entity:mat-Li13Si4-hanseroth2026 a mlips:MaterialSystem ;
    rdfs:label "Li13Si4 (lithium silicide, 204 atoms)" ;
    mlips:materialClass "Fine-tuning benchmark system" .

entity:mat-MoS2-hanseroth2026 a mlips:MaterialSystem ;
    rdfs:label "1H-MoS2 with sulfur vacancies (106 atoms)" ;
    mlips:materialClass "Fine-tuning benchmark system" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-hanseroth2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-hanseroth2026 mlips:hasDFTSettings entity:calc-settings-dft-hanseroth2026 .

entity:calc-settings-dft-hanseroth2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-hanseroth2026 ;
    mlips:xcFunctional entity:xc-BLYP-or-PBE-chosen-per-system-hanseroth2026 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:dftBasisSet entity:basis-DZVP-MOLOPT-hanseroth2026 ;
    rdfs:comment "Goedecker-Teter-Hutter pseudopotentials." .

entity:lib-CP2K-hanseroth2026 a mlips:Library ;
    rdfs:label "CP2K" ;
    rdfs:comment "CP2K 2025.1, Born-Oppenheimer AIMD." ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-BLYP-or-PBE-chosen-per-system-hanseroth2026 a mlips:XCFunctional ;
    rdfs:label "BLYP or PBE (chosen per system)" ;
    rdfs:comment "The text names both functionals without assigning them to systems." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-DZVP-MOLOPT-hanseroth2026 a mlips:DftBasisSet ;
    rdfs:label "DZVP-MOLOPT" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

