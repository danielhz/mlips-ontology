###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-MgAlCu-fan2022 a mlips:TrainingDataset ;
    rdfs:label "MgAlCu data set of Ref. [122] (141,409 structures; 90% training, 10% test)" ;
    mlips:coversMaterial entity:mat-MgAlCu-fan2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 141409 ;
    rdfs:comment "Previously used for a Deep Potential (Jiang et al., Chin. Phys. B 30, 050706 (2021))." .

entity:ds-C-train-fan2022 a mlips:TrainingDataset ;
    rdfs:label "Carbon training set of Ref. [10] (4,080 structures, 256,628 atoms)" ;
    mlips:coversMaterial entity:mat-C-fan2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 4080 ;
    rdfs:comment "Deringer and Csanyi, Phys. Rev. B 95, 094203 (2017); DFT-LDA reference; some structures carry virials." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-fan2022 ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-fan2022 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        entity:hp-Nneu-fan2022 ,
        entity:hp-Ngen-fan2022 ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NEP-fan2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NEP-fan2022 a mlips:LossFunction ;
    rdfs:label "Energy, force and virial RMSEs plus L1 and L2 regularisation" .

entity:alg-NEP-fan2022 a mls:Algorithm ;
    rdfs:label "Separable natural evolution strategy (SNES), population 50" .

entity:impl-NEP-fan2022 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-fan2022 .

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-DeePMD-fan2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-DeePMD-fan2022 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ;
    mlips:hasImplementation entity:impl-MTP-fan2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MTP-fan2022 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:REANN a mlips:MLIPMethod ;
    rdfs:label "REANN (recursively embedded atom neural network)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-REANN-fan2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-REANN-fan2022 a mlips:Implementation ;
    mlips:implementedIn entity:lib-REANN-fan2022 .

entity:lib-GPUMD-fan2022 a mlips:Library ;
    rdfs:label "GPUMD" ;
    rdfs:comment "nep executable of the open-source gpumd package (GPU)" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-REANN-fan2022 a mlips:Library ;
    rdfs:label "REANN" ;
    rdfs:comment "reann package (PyTorch)" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Nneu-fan2022 a mlips:Hyperparameter ;
    rdfs:label "NEP number of neurons in the hidden layer N_neu" ;
    mlips:hyperparameterName "N_neu" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-Ngen-fan2022 a mlips:Hyperparameter ;
    rdfs:label "NEP maximum number of generations of the separable natural evolution strategy N_gen" ;
    mlips:hyperparameterName "N_gen" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

