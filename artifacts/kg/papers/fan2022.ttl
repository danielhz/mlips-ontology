entity:run-dp-C-se2se3-fan2022 a mlips:MLIPRun ;
    rdfs:label "DP (smooth edition, se_e2_a plus se_e3 descriptors) fit to carbon, DP (se2+se3)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-C-train-fan2022 ;
    mlips:hasHyperparameterSetting entity:setting-dp-C-se2se3-cutoffRadius-fan2022 ,
        entity:setting-dp-C-se2se3-angularCutoff-fan2022 ;
