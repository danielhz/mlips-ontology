entity:mat-MgAlCu-fan2022 a mlips:MaterialSystem ;
    rdfs:label "Mg-Al-Cu alloys in the full concentration space" ;
    mlips:chemicalFormula "MgAlCu" ;
    mlips:materialClass "Ternary metallic alloy" .

entity:mat-C-fan2022 a mlips:MaterialSystem ;
    rdfs:label "Carbon (bulk crystals, liquid and amorphous bulk, amorphous surfaces, dimers)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental solid and liquid carbon" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q623> .

