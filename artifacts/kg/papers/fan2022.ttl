# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nep2-MgAlCu-fan2022 a mlips:MLIPRun ;
    rdfs:label "NEP2 fit to MgAlCu" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-MgAlCu-fan2022 ;
    mlips:hasHyperparameterSetting entity:setting-nep2-MgAlCu-cutoffRadius-fan2022 ,
        entity:setting-nep2-MgAlCu-angularCutoff-fan2022 ,
        entity:setting-nep2-MgAlCu-Nneu-fan2022 ,
        entity:setting-nep2-MgAlCu-Ngen-fan2022 ,
        entity:setting-nep2-MgAlCu-batchSize-fan2022 ;
    mlips:produces entity:model-nep2-MgAlCu-fan2022 .

entity:model-nep2-MgAlCu-fan2022 a mlips:TrainedModel ;
    rdfs:label "NEP2 MgAlCu potential" .

entity:run-nep3-MgAlCu-fan2022 a mlips:MLIPRun ;
    rdfs:label "NEP3 fit to MgAlCu" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-MgAlCu-fan2022 ;
    mlips:hasHyperparameterSetting entity:setting-nep3-MgAlCu-cutoffRadius-fan2022 ,
        entity:setting-nep3-MgAlCu-angularCutoff-fan2022 ,
        entity:setting-nep3-MgAlCu-Nneu-fan2022 ,
        entity:setting-nep3-MgAlCu-Ngen-fan2022 ,
        entity:setting-nep3-MgAlCu-batchSize-fan2022 ;
    mlips:produces entity:model-nep3-MgAlCu-fan2022 .

entity:model-nep3-MgAlCu-fan2022 a mlips:TrainedModel ;
    rdfs:label "NEP3 MgAlCu potential" .

entity:run-nep-C-4_2-fan2022 a mlips:MLIPRun ;
    rdfs:label "NEP3 fit to carbon, NEP (4.2 A)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-C-train-fan2022 ;
    mlips:hasHyperparameterSetting entity:setting-nep-C-4_2-cutoffRadius-fan2022 ,
        entity:setting-nep-C-4_2-angularCutoff-fan2022 ,
        entity:setting-nep-C-4_2-Nneu-fan2022 ,
        entity:setting-nep-C-4_2-Ngen-fan2022 ;
    mlips:produces entity:model-nep-C-4_2-fan2022 .

entity:model-nep-C-4_2-fan2022 a mlips:TrainedModel ;
    rdfs:label "NEP (4.2 A) carbon potential (C_2022_NEP3)" .

entity:run-nep-C-3_7-fan2022 a mlips:MLIPRun ;
    rdfs:label "NEP3 fit to carbon, NEP (3.7 A)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-C-train-fan2022 ;
    mlips:hasHyperparameterSetting entity:setting-nep-C-3_7-cutoffRadius-fan2022 ,
