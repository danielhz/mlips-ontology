        entity:setting-nep-C-3_7-Nneu-fan2022 ,
        entity:setting-nep-C-3_7-Ngen-fan2022 ;
    mlips:produces entity:model-nep-C-3_7-fan2022 .

entity:model-nep-C-3_7-fan2022 a mlips:TrainedModel ;
    rdfs:label "NEP (3.7 A) carbon potential" .

entity:run-dp-C-se2-fan2022 a mlips:MLIPRun ;
    rdfs:label "DP (smooth edition, se_a descriptor) fit to carbon, DP (se2)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-C-train-fan2022 ;
    mlips:hasHyperparameterSetting entity:setting-dp-C-se2-cutoffRadius-fan2022 ;
    mlips:produces entity:model-dp-C-se2-fan2022 .

entity:model-dp-C-se2-fan2022 a mlips:TrainedModel ;
