###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-HfO2-sivaraman2020 a mlips:MaterialSystem ;
    rdfs:label "Hafnium dioxide, liquid (3600 K) and amorphous (300 K), 96-atom cells" ;
    mlips:chemicalFormula "HfO2" ;
    mlips:materialClass "Oxide; liquid and melt-quenched amorphous phases" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-sivaraman2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-sivaraman2020 mlips:hasDFTSettings entity:calc-settings-dft-sivaraman2020 .

entity:calc-settings-dft-sivaraman2020 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "2x2x2 Monkhorst-Pack grid" ;
    rdfs:comment "AIMD in the NVT ensemble with a 1 fs time step." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-HfO2-sivaraman2020 a mlips:TrainingDataset ;
    rdfs:label "Active-learned HfO2 training set (combined selections from liquid, quench and amorphous AIMD)" ;
    mlips:coversMaterial entity:mat-HfO2-sivaraman2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-sivaraman2020 ;
    rdfs:comment "The number of selected configurations is not stated in the main text." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-HfO2-sivaraman2020 mlips:samplingStrategy
    entity:sampling-aimd-melt-quench-sivaraman2020 ,
    entity:sampling-cluster-active-learning-sivaraman2020 .

entity:sampling-aimd-melt-quench-sivaraman2020 a mlips:SamplingStrategy ;
    rdfs:label "AIMD melt-quench trajectories" ;
    rdfs:comment "96 atoms (32 Hf, 64 O) packed at random with Packmol; liquid at 3600 K sampled for 12 ps, quench to 300 K at 100 K/ps (33 ps, all retained), amorphous at the experimental density for 12 ps; the final 6 ps of the liquid and amorphous runs are retained." .

entity:sampling-cluster-active-learning-sivaraman2020 a mlips:SamplingStrategy ;
    rdfs:label "Active learning by HDBSCAN clustering with Bayesian-optimised GAP fits" ;
    rdfs:comment "Each AIMD trajectory is partitioned into uncorrelated clusters with HDBSCAN; training and test configurations are drawn from the clusters in successive trials, a GAP is fitted with Bayesian optimisation of its hyperparameters, and sampling stops when the energy MAE on the test configurations reaches a tolerance. The selections from the individual trajectories are combined." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-sivaraman2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-GAP-sivaraman2020 a mls:Algorithm ;
    rdfs:label "Sparse Gaussian process regression with a SOAP descriptor plus a non-parametric two-body term (added to prevent unphysical clustering of oxygen atoms at high temperature); hyperparameters by Bayesian optimisation" .

###############################################################################
