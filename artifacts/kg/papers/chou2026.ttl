# Canonical Turtle for the protocol-derived encoding of:
#   Chang-Ti Chou et al. (2026). Predicting interface structure using the minima hopping method with a machine learning interatomic potential.
#   npj Computational Materials. doi:10.1038/s41524-026-02214-7
#
# Version read: publisher (sha256 474b80e0b8f3982a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 588 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/chou2026.yaml.
#
# Encoding scope: the Allegro potential (2 layers, 32 features, l_max 3,
# 6 A cutoff) trained on 40,000 LDA configurations of SrTiO3 grain
# boundaries selected by DIRECT sampling from about 3.5 million M3GNet
# MD and relaxation configurations; training, validation and test MAEs
# (Table I). The M3GNet model used for enrichment and the direct M3GNet
# minima-hopping test are as distributed. Grain-boundary structures and
# energies are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-chou2026 a mlips:BenchmarkStudy ;
    rdfs:label "Chou et al. (2026): predicting SrTiO3 grain-boundary structures with minima hopping driven by an Allegro potential trained on DIRECT-selected DFT data" ;
    mlips:reportedIn entity:article-chou2026 .

entity:article-chou2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-02214-7> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Predicting interface structure using the minima hopping method with a machine learning interatomic potential" ;
    schema:author entity:person-Chou-chou2026 ,
        entity:person-Wang-chou2026 ,
        entity:person-Yang-chou2026 ,
        entity:person-vanAken-chou2026 ,
        entity:person-Perry-chou2026 ,
        entity:person-Kozinsky-chou2026 ,
        entity:person-Wolverton-chou2026 .

entity:person-Chou-chou2026 a schema:Person ;
    schema:name "Chang-Ti Chou" ;
    schema:givenName "Chang-Ti" ;
    schema:familyName "Chou" .

entity:person-Wang-chou2026 a schema:Person ;
    schema:name "Menghang Wang" ;
    schema:givenName "Menghang" ;
    schema:familyName "Wang" .

entity:person-Yang-chou2026 a schema:Person ;
    schema:name "Chao Yang" ;
    schema:givenName "Chao" ;
    schema:familyName "Yang" .

entity:person-vanAken-chou2026 a schema:Person ;
    schema:name "Peter A. van Aken" ;
    schema:givenName "Peter A." ;
    schema:familyName "van Aken" .

entity:person-Perry-chou2026 a schema:Person ;
    schema:name "Nicola H. Perry" ;
    schema:givenName "Nicola H." ;
    schema:familyName "Perry" .

entity:person-Kozinsky-chou2026 a schema:Person ;
    schema:name "Boris Kozinsky" ;
    schema:givenName "Boris" ;
    schema:familyName "Kozinsky" .

entity:person-Wolverton-chou2026 a schema:Person ;
    schema:name "Christopher M. Wolverton" ;
    schema:givenName "Christopher M." ;
    schema:familyName "Wolverton" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sto-chou2026 a mlips:MaterialSystem ;
    rdfs:label "SrTiO3 tilt grain boundaries (Sigma3(112), Sigma5(310) and related structures)" ;
    mlips:chemicalFormula "SrTiO3" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-lda-chou2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-lda-chou2026 mlips:hasDFTSettings entity:calc-settings-lda-chou2026 .

entity:calc-settings-lda-chou2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:LDA ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, 0.5 1/A resolution" ;
    rdfs:comment "Sr_sv and Ti_sv pseudopotentials" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-sto-chou2026 a mlips:TrainingDataset ;
    rdfs:label "SrTiO3 grain-boundary DFT dataset (40,000 configurations; 80/10/10)" ;
    mlips:coversMaterial entity:mat-sto-chou2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 40000 ;
    mlips:hasDFTCalculation entity:calc-lda-chou2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-sto-chou2026 mlips:samplingStrategy
    entity:sampling-direct-chou2026 .

entity:sampling-direct-chou2026 a mlips:SamplingStrategy ;
    rdfs:label "Grain-boundary candidates enriched by M3GNet MD and relaxation (about 3.5 million configurations), DIRECT selection of 40,000 for DFT" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-chou2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-chou2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-Allegro-chou2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-Allegro-chou2026 a mlips:LossFunction ;
    rdfs:label "Equal-weight per-atom energy, force and stress MSE" .

entity:alg-Allegro-chou2026 a mls:Algorithm ;
    rdfs:label "Adam, ReduceLROnPlateau (patience 20, factor 0.5), EMA 0.99, early stopping after 200 epochs without improvement" .

entity:impl-Allegro-chou2026 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-allegro-numLayers-chou2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-allegro-numFeatures-chou2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-allegro-cutoffRadius-chou2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-allegro-numRadialBasis-chou2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-allegro-learningRate-chou2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.002"^^xsd:double .

entity:setting-allegro-batchSize-chou2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "5"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-allegro-chou2026 a mlips:MLIPRun ;
    rdfs:label "Allegro for SrTiO3 grain boundaries" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-sto-chou2026 ;
    mlips:hasHyperparameterSetting entity:setting-allegro-numLayers-chou2026 ,
        entity:setting-allegro-numFeatures-chou2026 ,
        entity:setting-allegro-cutoffRadius-chou2026 ,
        entity:setting-allegro-numRadialBasis-chou2026 ,
        entity:setting-allegro-learningRate-chou2026 ,
        entity:setting-allegro-batchSize-chou2026 ;
    mlips:produces entity:model-allegro-chou2026 .

entity:model-allegro-chou2026 a mlips:TrainedModel ;
    rdfs:label "Allegro SrTiO3 grain boundaries" .

entity:run-m3gnet-chou2026 a mlips:MLIPRun ;
    rdfs:label "M3GNet universal potential (as distributed)" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-m3gnet-chou2026 .

entity:model-m3gnet-chou2026 a mlips:TrainedModel ;
    rdfs:label "M3GNet (uMLIP)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-chou2026 mlips:hasResult
    entity:result-allegro-train-chou2026 ,
    entity:result-allegro-val-chou2026 ,
    entity:result-allegro-test-chou2026 .

entity:result-allegro-train-chou2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-allegro-chou2026 ;
    mlips:targetMaterial entity:mat-sto-chou2026 ;
    mlips:hasAccuracyMetric entity:metric-allegro-train-1-chou2026 ,
