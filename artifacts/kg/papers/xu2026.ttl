# Canonical Turtle for the protocol-derived encoding of:
#   Jiayan Xu et al. (2026). Benchmarking universal machine learning interatomic potentials for supported nanoparticles: decoupling energy accuracy from structural exploration.
#   npj Computational Materials. doi:10.1038/s41524-026-02043-8
#
# Version read: publisher (sha256 e1b165a9576911b4...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 237 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/xu2026.yaml.
#
# Encoding scope: the domain-specific DP-UniAlCu model (from the authors'
# previous work), MACE-UniAlCu trained here on the same data, and the
# universal models MACE-OMAT, MatterSim-v1.0.0-1M, MatterSim-v1.0.0-5M and
# DPA3-OMAT, with their force RMSEs on the three subsystems of the UniAlCu
# data set (Table 3). Binding-energy deviations (Table 1), ranking metrics
# (Table 2), MD observables and the MACE-MP and DPA2 models (errors in
# figures and SI) are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-xu2026 a mlips:BenchmarkStudy ;
    rdfs:label "Xu et al. (2026): benchmarking universal MLIPs for Cu nanoparticles supported on Al2O3" ;
    mlips:reportedIn entity:article-xu2026 .

entity:article-xu2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-02043-8> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Benchmarking universal machine learning interatomic potentials for supported nanoparticles: decoupling energy accuracy from structural exploration" ;
    schema:author entity:person-Xu-xu2026 ,
        entity:person-Patra-xu2026 ,
        entity:person-Pathak-xu2026 ,
        entity:person-Shetty-xu2026 ,
        entity:person-Hohl-xu2026 ,
        entity:person-Car-xu2026 .

entity:person-Xu-xu2026 a schema:Person ;
    schema:name "Jiayan Xu" ;
    schema:givenName "Jiayan" ;
    schema:familyName "Xu" .

entity:person-Patra-xu2026 a schema:Person ;
    schema:name "Abhirup Patra" ;
    schema:givenName "Abhirup" ;
    schema:familyName "Patra" .

entity:person-Pathak-xu2026 a schema:Person ;
    schema:name "Amar Deep Pathak" ;
    schema:givenName "Amar Deep" ;
    schema:familyName "Pathak" .

entity:person-Shetty-xu2026 a schema:Person ;
    schema:name "Sharan Shetty" ;
    schema:givenName "Sharan" ;
    schema:familyName "Shetty" .

entity:person-Hohl-xu2026 a schema:Person ;
    schema:name "Detlef Hohl" ;
    schema:givenName "Detlef" ;
    schema:familyName "Hohl" .

entity:person-Car-xu2026 a schema:Person ;
    schema:name "Roberto Car" ;
    schema:givenName "Roberto" ;
    schema:familyName "Car" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Cu-xu2026 a mlips:MaterialSystem ;
    rdfs:label "Cu structures of the UniAlCu data set (bulk, surfaces, gas-phase nanoparticles)" ;
    mlips:materialClass "Supported metal nanoparticle catalyst / oxide surface" .

entity:mat-gamma-xu2026 a mlips:MaterialSystem ;
    rdfs:label "gamma-Al2O3 surfaces with and without supported Cu nanoparticles" ;
    mlips:materialClass "Supported metal nanoparticle catalyst / oxide surface" .

entity:mat-alpha-xu2026 a mlips:MaterialSystem ;
    rdfs:label "alpha-Al2O3(0001) surfaces with and without supported Cu nanoparticles" ;
    mlips:materialClass "Supported metal nanoparticle catalyst / oxide surface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-xu2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-xu2026 mlips:hasDFTSettings entity:calc-settings-pbe-xu2026 .

entity:calc-settings-pbe-xu2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "UniAlCu data set and binding energies; settings close to the Materials Project MPRelaxSet (Section S2)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-unialcu-xu2026 a mlips:TrainingDataset ;
    rdfs:label "UniAlCu data set (147,464 structures at 0 K and 400-1200 K)" ;
    mlips:coversMaterial entity:mat-Cu-xu2026 ,
        entity:mat-gamma-xu2026 ,
        entity:mat-alpha-xu2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 147464 ;
    mlips:hasDFTCalculation entity:calc-pbe-xu2026 ;
    rdfs:comment "From the authors' previous work (Ref. 16); Cu bulk, surfaces and gas-phase nanoparticles, Al2O3 surfaces and Al2O3-supported Cu nanoparticles up to Cu21." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-xu2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:impl-MACE-xu2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:DPA3 a mlips:MLIPMethod ;
    rdfs:label "DPA-3 (Deep Potential attention model, version 3)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-unialcu-xu2026 a mlips:MLIPRun ;
    rdfs:label "DP-UniAlCu, the domain-specific Deep Potential of the authors' previous work" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-unialcu-xu2026 ;
    mlips:produces entity:model-dp-unialcu-xu2026 .

entity:model-dp-unialcu-xu2026 a mlips:TrainedModel ;
    rdfs:label "DP-UniAlCu" .

entity:run-mace-unialcu-xu2026 a mlips:MLIPRun ;
    rdfs:label "MACE trained on the UniAlCu data set with the MACE-OMAT architecture" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-unialcu-xu2026 ;
    mlips:produces entity:model-mace-unialcu-xu2026 .

entity:model-mace-unialcu-xu2026 a mlips:TrainedModel ;
    rdfs:label "MACE-UniAlCu" .

entity:run-mace-omat-xu2026 a mlips:MLIPRun ;
    rdfs:label "MACE-OMAT as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-omat-xu2026 .

entity:model-mace-omat-xu2026 a mlips:TrainedModel ;
    rdfs:label "MACE-OMAT (trained on OMat24)" .

entity:run-mattersim-1m-xu2026 a mlips:MLIPRun ;
    rdfs:label "MatterSim-v1.0.0-1M as distributed" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-mattersim-1m-xu2026 .

entity:model-mattersim-1m-xu2026 a mlips:TrainedModel ;
    rdfs:label "MatterSim-v1.0.0-1M" .

entity:run-dpa3-omat-xu2026 a mlips:MLIPRun ;
    rdfs:label "DPA3-OMAT as distributed" ;
    mlips:appliesMethod entity:DPA3 ;
    mlips:produces entity:model-dpa3-omat-xu2026 .

entity:model-dpa3-omat-xu2026 a mlips:TrainedModel ;
    rdfs:label "DPA3-OMAT" .

# Registry stub for the externally trained model MatterSim-v1 (not trained in this paper).
entity:run-MatterSim-v1 a mlips:MLIPRun ;
    rdfs:label "Training run of MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-MatterSim-v1 .

entity:model-MatterSim-v1 a mlips:TrainedModel ;
    rdfs:label "MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" .

