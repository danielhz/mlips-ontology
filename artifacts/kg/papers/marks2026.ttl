# Canonical Turtle for the protocol-derived encoding of:
#   Jonah Marks et al. (2026). Reliable and Efficient Automated Transition-State Searches with Machine-Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2604.00405  arXiv:2604.00405v1
#
# Version read: arxiv-preprint arXiv:2604.00405v1 (sha256 6ae28d87140303fd...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 299 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/marks2026.yaml.
#
# Encoding scope: five pretrained MLIPs (MACE-OMol25, UMA-S 1.1, UMA-M
# 1.1, eSEN-S OMol25 conserving, AIMNet2) used for reaction-path finding
# (freezing-string method, CI-NEB) and low-level transition-state
# refinement, validated by wB97X-V/def2-TZVP refinement on 58 reactions.
# Results are success rates and numbers of DFT gradient evaluations, not
# error metrics; GFN2-xTB is semi-empirical and not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-marks2026 a mlips:BenchmarkStudy ;
    rdfs:label "Marks, Vandezande and Gomes (2026): MLIP-accelerated transition-state searches with the freezing-string method and CI-NEB" ;
    mlips:reportedIn entity:article-marks2026 .

entity:article-marks2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2604.00405> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Reliable and Efficient Automated Transition-State Searches with Machine-Learned Interatomic Potentials" ;
    schema:author entity:person-Marks-marks2026 ,
        entity:person-Vandezande-marks2026 ,
        entity:person-Gomes-marks2026 .

entity:person-Marks-marks2026 a schema:Person ;
    schema:name "Jonah Marks" ;
    schema:givenName "Jonah" ;
    schema:familyName "Marks" .

entity:person-Vandezande-marks2026 a schema:Person ;
    schema:name "Jonathon Vandezande" ;
    schema:givenName "Jonathon" ;
    schema:familyName "Vandezande" .

entity:person-Gomes-marks2026 a schema:Person ;
    schema:name "Joseph Gomes" ;
    schema:givenName "Joseph" ;
    schema:familyName "Gomes" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-reactions-marks2026 a mlips:MaterialSystem ;
    rdfs:label "58 reactions: Baker and Sharada organic sets, polymerisation chemistry, transition-metal complexes and organometallic C-H activation" ;
    mlips:materialClass "Molecular reactions (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97xv-marks2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97xv-marks2026 mlips:hasDFTSettings entity:calc-settings-wb97xv-marks2026 .

entity:calc-settings-wb97xv-marks2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Q-Chem-marks2026 ;
    mlips:xcFunctional entity:xc-wB97X-V-marks2026 ;
    mlips:basisSet "def2-TZVP" ;
    rdfs:comment "Q-Chem 6.0, SG-2 grid; P-RFO refinement and frequency validation of the transition states." .

entity:lib-Q-Chem-marks2026 a mlips:Library ;
    rdfs:label "Q-Chem" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-wB97X-V-marks2026 a mlips:XCFunctional ;
    rdfs:label "wB97X-V" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:supportsSimulation mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:AIMNet2 a mlips:MLIPMethod ;
    rdfs:label "AIMNet2 (atoms-in-molecules neural network potential with learned charges and explicit long-range terms)" ;
    mlips:supportsSimulation mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-omol25-marks2026 a mlips:MLIPRun ;
    rdfs:label "MACE-OMol25 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-omol25-marks2026 .

entity:model-mace-omol25-marks2026 a mlips:TrainedModel ;
    rdfs:label "MACE-OMol25" .

entity:run-uma-s-marks2026 a mlips:MLIPRun ;
    rdfs:label "UMA Small 1.1 as distributed" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-s-marks2026 .

entity:model-uma-s-marks2026 a mlips:TrainedModel ;
    rdfs:label "UMA-S 1.1" .

entity:run-uma-m-marks2026 a mlips:MLIPRun ;
    rdfs:label "UMA Medium 1.1 as distributed" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-m-marks2026 .

entity:model-uma-m-marks2026 a mlips:TrainedModel ;
    rdfs:label "UMA-M 1.1" .

entity:run-esen-s-marks2026 a mlips:MLIPRun ;
    rdfs:label "OMol25 eSEN conserving small as distributed" ;
    mlips:appliesMethod entity:eSEN ;
    mlips:produces entity:model-esen-s-marks2026 .

entity:model-esen-s-marks2026 a mlips:TrainedModel ;
    rdfs:label "eSEN-S (OMol25, conserving)" .

entity:run-aimnet2-marks2026 a mlips:MLIPRun ;
    rdfs:label "AIMNet2 as distributed" ;
    mlips:appliesMethod entity:AIMNet2 ;
    mlips:produces entity:model-aimnet2-marks2026 .

entity:model-aimnet2-marks2026 a mlips:TrainedModel ;
    rdfs:label "AIMNet2" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# MACE-OMol25 needs fewer than four DFT gradient evaluations per organic
# reaction (96.6% success), a 94-96% reduction relative to DFT-only
# searches; no MLIP timings are given.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Transition-state search success rates, DFT gradient counts, energies relative to reference saddle points and reactive-core geometries (Tables 1-6) are not energy/force/stress error metrics.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: datacite).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/marks2026.yaml) until the schema has terms for them.
