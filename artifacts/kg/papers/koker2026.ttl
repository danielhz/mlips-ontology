# Canonical Turtle for the protocol-derived encoding of:
#   Teddy Koker et al. (2026). PFT: Phonon Fine-tuning for Machine Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2601.07742  arXiv:2601.07742v4
#
# Version read: arxiv-preprint arXiv:2601.07742v4 (sha256 8731ace2a319a078...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 318 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/koker2026.yaml.
#
# Encoding scope: Nequix MP and the Nequix OAM base model trained here,
# their phonon-fine-tuned versions (with and without MPtrj co-training),
# and MACE-MP-0 PFT, fine-tuned on MDR Phonon PBE force constants; the
# Matbench Discovery energy MAE and R2 of the Nequix models (Table 4) and
# the training costs. Phonon thermodynamic, third-order force-constant,
# thermal-conductivity and elastic errors are property errors, not
# energy/force/stress metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-koker2026 a mlips:BenchmarkStudy ;
    rdfs:label "Koker et al. (2026): phonon fine-tuning (PFT) of MLIPs on DFT force constants via stochastic Hessian-vector products" ;
    mlips:reportedIn entity:article-koker2026 .

entity:article-koker2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2601.07742> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "PFT: Phonon Fine-tuning for Machine Learned Interatomic Potentials" ;
    schema:author entity:person-Koker-koker2026 ,
        entity:person-Gangan-koker2026 ,
        entity:person-Kotak-koker2026 ,
        entity:person-Marian-koker2026 ,
        entity:person-Smidt-koker2026 .

entity:person-Koker-koker2026 a schema:Person ;
    schema:name "Teddy Koker" ;
    schema:givenName "Teddy" ;
    schema:familyName "Koker" .

entity:person-Gangan-koker2026 a schema:Person ;
    schema:name "Abhijeet Gangan" ;
    schema:givenName "Abhijeet" ;
    schema:familyName "Gangan" .

entity:person-Kotak-koker2026 a schema:Person ;
    schema:name "Mit Kotak" ;
    schema:givenName "Mit" ;
    schema:familyName "Kotak" .

entity:person-Marian-koker2026 a schema:Person ;
    schema:name "Jaime Marian" ;
    schema:givenName "Jaime" ;
    schema:familyName "Marian" .

entity:person-Smidt-koker2026 a schema:Person ;
    schema:name "Tess Smidt" ;
    schema:givenName "Tess" ;
    schema:familyName "Smidt" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mdr-koker2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals of the MDR Phonon database (PBE recalculation)" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-wbm-koker2026 a mlips:MaterialSystem ;
    rdfs:label "WBM test set of Matbench Discovery" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-mdr-koker2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-mdr-koker2026 mlips:hasDFTSettings entity:calc-settings-pbe-mdr-koker2026 .

entity:calc-settings-pbe-mdr-koker2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "MDR Phonon finite-displacement calculations recomputed with PBE in Materials Project settings (Loew et al. 2025)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mdr-phonon-koker2026 a mlips:TrainingDataset ;
    rdfs:label "MDR Phonon PBE force constants (training split; 1,000-material test subset held out)" ;
    mlips:coversMaterial entity:mat-mdr-koker2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbe-mdr-koker2026 .

entity:ds-mptrj-koker2026 a mlips:TrainingDataset ;
    rdfs:label "MPtrj (co-training data)" ;
    mlips:coversMaterial entity:mat-mdr-koker2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

entity:ds-oam-koker2026 a mlips:TrainingDataset ;
    rdfs:label "OMat24 (pretraining) then sAlex + 8 copies of MPtrj (fine-tuning)" ;
    mlips:coversMaterial entity:mat-mdr-koker2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Nequix a mlips:MLIPMethod ;
    rdfs:label "Nequix (compact E(3)-equivariant interatomic potential, JAX implementation)" ;
    mlips:hasLossFunction entity:loss-Nequix-koker2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Nequix-koker2026 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-Nequix-koker2026 ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-Nequix-koker2026 a mlips:LossFunction ;
    rdfs:label "PFT: energy, force, stress and force-constant (lambda_Phi = 100) terms, the latter via a single stochastic Hessian-vector product per step; co-training on upstream data every 4 steps" .

entity:alg-Nequix-koker2026 a mls:Algorithm ;
    rdfs:label "AdamW, weight decay 0.001" .

entity:impl-Nequix-koker2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-nequix-koker2026 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-koker2026 ;
    mlips:supportsSimulation mlips:PhononCalculation .

entity:impl-MACE-koker2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-FeNNol-koker2026 .

entity:lib-nequix-koker2026 a mlips:Library ;
    rdfs:label "nequix" ;
    rdfs:comment "JAX backend for PFT; torch backend with OpenEquivariance for the OAM base model" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-FeNNol-koker2026 a mlips:Library ;
    rdfs:label "FeNNol" ;
    rdfs:comment "JAX implementation of MACE used for PFT" ;
    mlips:candidateForVocabulary mlips:Library .

