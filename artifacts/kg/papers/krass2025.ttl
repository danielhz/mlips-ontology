# Canonical Turtle for the protocol-derived encoding of:
#   Hendrik Kraß et al. (2025). MOFSimBench: evaluating universal machine learning interatomic potentials in metal-organic framework molecular modeling.
#   npj Computational Materials. doi:10.1038/s41524-025-01872-3  arXiv:2507.11806v1
#
# Version read: arxiv-preprint arXiv:2507.11806v1 (sha256 15580745345a3882...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 142 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: bibliographic facts only. MOFSimBench evaluates over 20
# pretrained universal MLIPs on tasks for nanoporous materials (structure
# optimisation, MD stability, bulk modulus, heat capacity, guest-host
# interaction energies). The paper trains no model, and its scores are
# task metrics, none of them an energy, force or stress error on a
# reference set that schema 0.1.2 can carry. Read from the arXiv preprint
# (v1).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-krass2025 a mlips:BenchmarkStudy ;
    rdfs:label "Krass et al. (2025): MOFSimBench, evaluating universal MLIPs for metal-organic framework modelling" ;
    mlips:reportedIn entity:article-krass2025 .

entity:article-krass2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01872-3> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "MOFSimBench: evaluating universal machine learning interatomic potentials in metal-organic framework molecular modeling" ;
    schema:author entity:person-Kra-krass2025 ,
        entity:person-Huang-krass2025 ,
        entity:person-Moosavi-krass2025 .

entity:person-Kra-krass2025 a schema:Person ;
    schema:name "Hendrik Kraß" ;
    schema:givenName "Hendrik" ;
    schema:familyName "Kraß" .

entity:person-Huang-krass2025 a schema:Person ;
    schema:name "Ju Huang" ;
    schema:givenName "Ju" ;
    schema:familyName "Huang" .

entity:person-Moosavi-krass2025 a schema:Person ;
    schema:name "Seyed Mohamad Moosavi" ;
    schema:givenName "Seyed Mohamad" ;
    schema:familyName "Moosavi" .

