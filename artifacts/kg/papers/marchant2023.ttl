# Canonical Turtle for the protocol-derived encoding of:
#   George A. Marchant et al. (2023). Exploring the configuration space of elemental carbon with empirical and machine learned interatomic potentials.
#   npj Computational Materials. doi:10.1038/s41524-023-01081-w
#
# Version read: publisher (sha256 82de06e832cad220...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 567 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/marchant2023.yaml.
#
# Encoding scope: the published GAP-20 and GAP-20U carbon potentials
# (as distributed) and GAP-20U+gr, refitted with the GAP-20U parameters
# on its dataset plus 165 ordered graphite configurations
# (optB88-vdW). Tersoff and EDIP are empirical potentials. No energy or
# force errors are reported; phase diagrams, melting lines and
# energy-volume landscapes are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-marchant2023 a mlips:BenchmarkStudy ;
    rdfs:label "Marchant, Caro, Karasulu and Partay (2023): nested-sampling phase diagrams of carbon with Tersoff, EDIP, GAP-20 and GAP-20U, and the improved GAP-20U+gr" ;
    mlips:reportedIn entity:article-marchant2023 .

entity:article-marchant2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-023-01081-w> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Exploring the configuration space of elemental carbon with empirical and machine learned interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-6756-6936> ,
        <https://orcid.org/0000-0001-9304-4261> ,
        <https://orcid.org/0000-0001-8129-8010> ,
        entity:person-Partay-marchant2023 .

<https://orcid.org/0000-0002-6756-6936> a schema:Person ;
    schema:name "George A. Marchant" ;
    schema:givenName "George A." ;
    schema:familyName "Marchant" ;
    schema:identifier <https://orcid.org/0000-0002-6756-6936> .

<https://orcid.org/0000-0001-9304-4261> a schema:Person ;
    schema:name "Miguel A. Caro" ;
    schema:givenName "Miguel A." ;
    schema:familyName "Caro" ;
    schema:identifier <https://orcid.org/0000-0001-9304-4261> .

<https://orcid.org/0000-0001-8129-8010> a schema:Person ;
    schema:name "Bora Karasulu" ;
    schema:givenName "Bora" ;
    schema:familyName "Karasulu" ;
    schema:identifier <https://orcid.org/0000-0001-8129-8010> .

entity:person-Partay-marchant2023 a schema:Person ;
    schema:name "Livia B. Pártay" ;
    schema:givenName "Livia B." ;
    schema:familyName "Pártay" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-c-marchant2023 a mlips:MaterialSystem ;
    rdfs:label "Elemental carbon (graphite stackings, diamond, liquid and high-pressure phases)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental solid and liquid carbon" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-optb88-marchant2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-optb88-marchant2023 mlips:hasDFTSettings entity:calc-settings-optb88-marchant2023 .

entity:calc-settings-optb88-marchant2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-optB88-vdW-marchant2023 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, spacing at most 0.2 1/A" ;
    rdfs:comment "Settings of the GAP-20U data; Gaussian smearing 0.1 eV" .

entity:xc-optB88-vdW-marchant2023 a mlips:XCFunctional ;
    rdfs:label "optB88-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-gr-marchant2023 a mlips:TrainingDataset ;
    rdfs:label "GAP-20U training data extended by 165 ordered graphite configurations" ;
    mlips:coversMaterial entity:mat-c-marchant2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-optb88-marchant2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gr-marchant2023 mlips:samplingStrategy
    entity:sampling-gr-marchant2023 .

entity:sampling-gr-marchant2023 a mlips:SamplingStrategy ;
    rdfs:label "GAP-20U dataset plus 165 AA, AB and ABC graphite configurations with c varied by +/-40% and a by +/-2%" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:loss-GAP-marchant2023 ;
    mlips:hasImplementation entity:impl-GAP-marchant2023 ;
    mlips:supportsSimulation mlips:MonteCarlo ,
        mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-GAP-marchant2023 a mlips:LossFunction ;
    rdfs:label "GAP-20U fitting parameters retained" .

entity:impl-GAP-marchant2023 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap20-marchant2023 a mlips:MLIPRun ;
    rdfs:label "GAP-20 (as distributed)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:produces entity:model-gap20-marchant2023 .

entity:model-gap20-marchant2023 a mlips:TrainedModel ;
    rdfs:label "GAP-20" .

entity:run-gap20u-marchant2023 a mlips:MLIPRun ;
    rdfs:label "GAP-20U (as distributed)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:produces entity:model-gap20u-marchant2023 .

entity:model-gap20u-marchant2023 a mlips:TrainedModel ;
    rdfs:label "GAP-20U" .

entity:run-gap20ugr-marchant2023 a mlips:MLIPRun ;
    rdfs:label "GAP-20U+gr (refitted with 165 additional graphite configurations)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-gr-marchant2023 ;
    mlips:produces entity:model-gap20ugr-marchant2023 .

entity:model-gap20ugr-marchant2023 a mlips:TrainedModel ;
    rdfs:label "GAP-20U+gr" .

