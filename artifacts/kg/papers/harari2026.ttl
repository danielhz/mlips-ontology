    schema:givenName "Boris" ;
    schema:familyName "Kozinsky" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-CDP-harari2026 a mlips:MaterialSystem ;
    rdfs:label "Solid-state CsH2PO4 (CDP)" ;
    mlips:chemicalFormula "CsH2PO4" ;
    mlips:materialClass "Solid acid proton conductor" .

entity:mat-water-harari2026 a mlips:MaterialSystem ;
    rdfs:label "Liquid water" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

