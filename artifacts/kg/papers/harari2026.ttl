# Canonical Turtle for the protocol-derived encoding of:
#   Gil Harari et al. (2026). Beyond Adam: SOAP and Muon for Faster, Label-Efficient Training of Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2607.02499  arXiv:2607.02499v1
#
# Version read: arxiv-preprint arXiv:2607.02499v1 (sha256 e4a973b7cce6aa81...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 170 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the 16 training configurations of Table 1: Allegro on
# solid-state CsH2PO4 (CDP) and NequIP on liquid water, each trained with
# four optimisers (AdamW, Muon, SOAP, SOAP-Muon) on energies and forces
# or on energies only, with the architecture settings of Table 3 and the
# test MAEs. The optimiser is a run setting. Intermediate force-label
# fractions and MD observables are not encoded. Preprint only (arXiv v1).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-harari2026 a mlips:BenchmarkStudy ;
    rdfs:label "Harari et al. (2026): beyond Adam, SOAP and Muon optimisers for faster, label-efficient MLIP training" ;
    mlips:reportedIn entity:article-harari2026 .

entity:article-harari2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2607.02499> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Beyond Adam: SOAP and Muon for Faster, Label-Efficient Training of Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Harari-harari2026 ,
        entity:person-Zimmermann-harari2026 ,
        entity:person-Kulseng-harari2026 ,
        entity:person-Zichi-harari2026 ,
        entity:person-Tan-harari2026 ,
        entity:person-Descoteaux-harari2026 ,
        entity:person-Kozinsky-harari2026 .

entity:person-Harari-harari2026 a schema:Person ;
    schema:name "Gil Harari" ;
    schema:givenName "Gil" ;
    schema:familyName "Harari" .

entity:person-Zimmermann-harari2026 a schema:Person ;
    schema:name "Yoel Zimmermann" ;
    schema:givenName "Yoel" ;
    schema:familyName "Zimmermann" .

entity:person-Kulseng-harari2026 a schema:Person ;
    schema:name "Ola Tangen Kulseng" ;
    schema:givenName "Ola Tangen" ;
