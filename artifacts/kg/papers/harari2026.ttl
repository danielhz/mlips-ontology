###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-CDP-harari2026 a mlips:TrainingDataset ;
    rdfs:label "CDP data set of the Allegro study cited by the paper (Wang et al., 2025)" ;
    mlips:coversMaterial entity:mat-CDP-harari2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-water-harari2026 a mlips:TrainingDataset ;
    rdfs:label "Water data set used with NequIP, following Batzner et al. (2022)" ;
    mlips:coversMaterial entity:mat-water-harari2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-CDP-harari2026 mlips:samplingStrategy
    entity:sampling-published-harari2026 .

entity:ds-water-harari2026 mlips:samplingStrategy
    entity:sampling-published-harari2026 .

entity:sampling-published-harari2026 a mlips:SamplingStrategy ;
    rdfs:label "Published data set used as provided" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-harari2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-harari2026 ;
    mlips:hasHyperparameter entity:hp-optimizer-harari2026 ,
        entity:hp-training-targets-harari2026 ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-lmax-harari2026 ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-Allegro-harari2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-Allegro-harari2026 a mlips:LossFunction ;
    rdfs:label "Per-frame squared energy error plus masked squared force error with fixed coefficients (ratio tuned among 1:1, 1:10 and 1:100 at full force supervision)" .

entity:alg-Allegro-harari2026 a mls:Algorithm ;
    rdfs:label "AdamW, Muon, SOAP or SOAP-Muon with a cosine-annealing schedule; early stopping; five seeds" .

entity:impl-Allegro-harari2026 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-harari2026 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-harari2026 ;
    mlips:hasHyperparameter entity:hp-optimizer-harari2026 ,
        entity:hp-training-targets-harari2026 ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-lmax-harari2026 ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-harari2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-harari2026 a mlips:LossFunction ;
    rdfs:label "Per-frame squared energy error plus masked squared force error with fixed coefficients (ratio tuned among 1:1, 1:10 and 1:100 at full force supervision)" .

entity:alg-NequIP-harari2026 a mls:Algorithm ;
    rdfs:label "AdamW, Muon, SOAP or SOAP-Muon with a reduce-on-plateau schedule; early stopping; five seeds" .

entity:impl-NequIP-harari2026 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

entity:hp-optimizer-harari2026 a mlips:Hyperparameter ;
    rdfs:label "Optimiser" ;
    mlips:hyperparameterName "optimizer" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-training-targets-harari2026 a mlips:Hyperparameter ;
    rdfs:label "Training targets" ;
    mlips:hyperparameterName "training_targets" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lmax-harari2026 a mlips:Hyperparameter ;
    rdfs:label "Maximum rotation order l_max" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

