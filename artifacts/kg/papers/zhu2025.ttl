# Canonical Turtle for the protocol-derived encoding of:
#   Jia-Xin Zhu et al. (2025). Machine Learning Potential for Electrochemical Interfaces with Hybrid Representation of Dielectric Response.
#   Physical Review Letters. doi:10.1103/48ct-3jxm  arXiv:2407.17740v1
#
# Version read: arxiv-preprint arXiv:2407.17740v1 (sha256 400258196530690c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 671 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/zhu2025.yaml.
#
# Encoding scope: the ec-MLP for Pt(111)/KF(aq) interfaces: a DPLR model
# whose electrolyte charges come from a Deep Wannier model and whose
# electrode charges follow a Siepmann-Sprik model, trained on CP2K PBE-D3
# data, with its training and test RMSEs (Table 1). Interfacial water
# structure and dielectric profiles are property results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhu2025 a mlips:BenchmarkStudy ;
    rdfs:label "Zhu and Cheng (2025): machine-learning potential for electrochemical interfaces with a hybrid representation of dielectric response" ;
    mlips:reportedIn entity:article-zhu2025 .

entity:article-zhu2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/48ct-3jxm> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Machine Learning Potential for Electrochemical Interfaces with Hybrid Representation of Dielectric Response" ;
    schema:author <https://orcid.org/0000-0002-3471-4728> ,
        <https://orcid.org/0000-0001-6971-0797> .

<https://orcid.org/0000-0002-3471-4728> a schema:Person ;
    schema:name "Jia-Xin Zhu" ;
    schema:givenName "Jia-Xin" ;
    schema:familyName "Zhu" ;
    schema:identifier <https://orcid.org/0000-0002-3471-4728> .

<https://orcid.org/0000-0001-6971-0797> a schema:Person ;
    schema:name "Jun Cheng" ;
    schema:givenName "Jun" ;
    schema:familyName "Cheng" ;
    schema:identifier <https://orcid.org/0000-0001-6971-0797> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-pt-kf-zhu2025 a mlips:MaterialSystem ;
    rdfs:label "Charged Pt(111) electrodes with KF aqueous electrolyte" ;
    mlips:materialClass "electrochemical metal-electrolyte interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-zhu2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-zhu2025 mlips:hasDFTSettings entity:calc-settings-pbe-d3-zhu2025 .

entity:calc-settings-pbe-d3-zhu2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-zhu2025 ;
    mlips:xcFunctional entity:xc-PBE-D3-zhu2025 ;
    mlips:pseudopotentialType entity:pp-GTH-zhu2025 ;
    mlips:basisSet "DZVP-type Gaussian basis" ;
    rdfs:comment "800 Ry plane-wave cutoff; maximally localised Wannier centres for the Deep Wannier labels." .

entity:lib-CP2K-zhu2025 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE-D3-zhu2025 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:pp-GTH-zhu2025 a mlips:PseudopotentialType ;
    rdfs:label "GTH" ;
    mlips:candidateForVocabulary mlips:PseudopotentialType .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-pt-kf-zhu2025 a mlips:TrainingDataset ;
    rdfs:label "Pt/KF(aq) interface configurations (details in SM Sec. 1)" ;
    mlips:coversMaterial entity:mat-pt-kf-zhu2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-zhu2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DPLR a mlips:MLIPMethod ;
    rdfs:label "DPLR (Deep Potential Long-Range: DP short-range model plus Ewald electrostatics of Gaussian charges at ions and Deep-Wannier centroids)" ;
    mlips:hasLossFunction entity:loss-DPLR-zhu2025 ;
    mlips:hasTrainingAlgorithm entity:alg-DPLR-zhu2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-DPLR-zhu2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-DPLR-zhu2025 a mlips:LossFunction ;
    rdfs:label "Energy prefactor 0.001 to 1, force prefactor 1000 to 1" .

entity:alg-DPLR-zhu2025 a mls:Algorithm ;
    rdfs:label "Short-range DeepPot-SE (embedding 25-50-100, fitting 240x3) plus PPPM electrostatics from Deep Wannier centroids (electrolyte) and Siepmann-Sprik Gaussian charges (Pt, spread 1.6 A); 5e5 batches" .

entity:impl-DPLR-zhu2025 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ec-mlp-cutoffRadius-zhu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-ec-mlp-batchSize-zhu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-ec-mlp-learningRate-zhu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ec-mlp-zhu2025 a mlips:MLIPRun ;
    rdfs:label "ec-MLP (DPLR + Deep Wannier + Siepmann-Sprik electrode) for Pt/KF(aq)" ;
    mlips:appliesMethod entity:DPLR ;
    mlips:runsOn entity:ds-pt-kf-zhu2025 ;
    mlips:hasHyperparameterSetting entity:setting-ec-mlp-cutoffRadius-zhu2025 ,
        entity:setting-ec-mlp-batchSize-zhu2025 ,
        entity:setting-ec-mlp-learningRate-zhu2025 ;
    mlips:produces entity:model-ec-mlp-zhu2025 .

entity:model-ec-mlp-zhu2025 a mlips:TrainedModel ;
    rdfs:label "ec-MLP Pt/KF(aq)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-zhu2025 mlips:hasResult
    entity:result-ec-mlp-train-zhu2025 ,
    entity:result-ec-mlp-test-zhu2025 .

entity:result-ec-mlp-train-zhu2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ec-mlp-zhu2025 ;
    mlips:targetMaterial entity:mat-pt-kf-zhu2025 ;
    mlips:hasAccuracyMetric entity:metric-ec-mlp-train-1-zhu2025 ,
        entity:metric-ec-mlp-train-2-zhu2025 .

entity:metric-ec-mlp-train-1-zhu2025 a mlips:AccuracyMetric ;
    rdfs:label "train energy RMSE on Pt/KF(aq): ec-MLP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.305"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-ec-mlp-train-2-zhu2025 a mlips:AccuracyMetric ;
    rdfs:label "train force RMSE on Pt/KF(aq): ec-MLP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "75"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-ec-mlp-test-zhu2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ec-mlp-zhu2025 ;
    mlips:targetMaterial entity:mat-pt-kf-zhu2025 ;
    mlips:hasAccuracyMetric entity:metric-ec-mlp-test-1-zhu2025 ,
        entity:metric-ec-mlp-test-2-zhu2025 .

entity:metric-ec-mlp-test-1-zhu2025 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on Pt/KF(aq): ec-MLP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.9638"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-ec-mlp-test-2-zhu2025 a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on Pt/KF(aq): ec-MLP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "57.19"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

