# Canonical Turtle for the protocol-derived encoding of:
#   Luca Brugnoli et al. (2026). Overcoming sampling limitations using machine-learned interatomic potentials: the case of water-in-salt electrolytes.
#   arXiv (Cornell University). (no DOI)  arXiv:2603.22099v1
#
# Version read: arxiv-preprint arXiv:2603.22099v1 (sha256 fd41b95dc41ed944...);
#   the arXiv id above is cited, numbers are those of the version read.
# Corpus rank 685 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/brugnoli2026.yaml.
#
# Encoding scope: MACE models for the 21 m LiTFSI water-in-salt
# electrolyte trained on r2SCAN single points of published AIMD
# configurations: a fine-tuned model (FT, multi-head replay from the
# MACE-MATPES-r2SCAN-OMAT-FT checkpoint) and a from-scratch model (TfS)
# with the same architecture, with their stated test RMSEs, plus the other
# shortlisted variants without results. Foundation checkpoints screened
# as distributed are compared through properties only. Densities,
# structure factors, diffusion, conductivity and viscosity are property
# results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-brugnoli2026 a mlips:BenchmarkStudy ;
    rdfs:label "Brugnoli et al. (2026): MACE potentials overcoming sampling limitations for water-in-salt electrolytes" ;
    mlips:reportedIn entity:article-brugnoli2026 .

entity:article-brugnoli2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://arxiv.org/abs/2603.22099> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Overcoming sampling limitations using machine-learned interatomic potentials: the case of water-in-salt electrolytes" ;
    schema:author entity:person-Brugnoli-brugnoli2026 ,
        entity:person-Salanne-brugnoli2026 ,
        entity:person-Saitta-brugnoli2026 ,
        entity:person-Serva-brugnoli2026 ,
        entity:person-FranceLanord-brugnoli2026 .

entity:person-Brugnoli-brugnoli2026 a schema:Person ;
    schema:name "Luca Brugnoli" ;
    schema:givenName "Luca" ;
    schema:familyName "Brugnoli" .

entity:person-Salanne-brugnoli2026 a schema:Person ;
    schema:name "Mathieu Salanne" ;
    schema:givenName "Mathieu" ;
    schema:familyName "Salanne" .

entity:person-Saitta-brugnoli2026 a schema:Person ;
    schema:name "A. Marco Saitta" ;
    schema:givenName "A. Marco" ;
    schema:familyName "Saitta" .

entity:person-Serva-brugnoli2026 a schema:Person ;
    schema:name "Alessandra Serva" ;
    schema:givenName "Alessandra" ;
    schema:familyName "Serva" .

entity:person-FranceLanord-brugnoli2026 a schema:Person ;
    schema:name "Arthur France-Lanord" ;
    schema:givenName "Arthur" ;
    schema:familyName "France-Lanord" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-wise-brugnoli2026 a mlips:MaterialSystem ;
    rdfs:label "21 m LiTFSI-H2O water-in-salt electrolyte (Li64 and Li128 cells)" ;
    mlips:materialClass "concentrated aqueous electrolyte" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scan-brugnoli2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scan-brugnoli2026 mlips:hasDFTSettings entity:calc-settings-r2scan-brugnoli2026 .

entity:calc-settings-r2scan-brugnoli2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-brugnoli2026 ;
    mlips:xcFunctional entity:xc-r2SCAN-brugnoli2026 ;
    mlips:pseudopotentialType entity:pp-GTH-brugnoli2026 ;
    mlips:basisSet "TZV2P-GTH-SCAN" ;
    rdfs:comment "CP2K 9.1; 1200 Ry cutoff (relative 70 Ry); SCF 1e-7 Ha; recomputed on published BLYP-D3 AIMD configurations." .

entity:lib-CP2K-brugnoli2026 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-r2SCAN-brugnoli2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:pp-GTH-brugnoli2026 a mlips:PseudopotentialType ;
    rdfs:label "GTH" ;
    mlips:candidateForVocabulary mlips:PseudopotentialType .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-wise-brugnoli2026 a mlips:TrainingDataset ;
    rdfs:label "r2SCAN LiTFSI water-in-salt training data (90/10 split; Li64 and Li128 configurations)" ;
    mlips:coversMaterial entity:mat-wise-brugnoli2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 1245 ;
    mlips:hasDFTCalculation entity:calc-r2scan-brugnoli2026 .

entity:ds-wise-s50-brugnoli2026 a mlips:TrainingDataset ;
    rdfs:label "50 Li64 configurations (data-efficiency subset)" ;
    mlips:coversMaterial entity:mat-wise-brugnoli2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 50 ;
    mlips:hasDFTCalculation entity:calc-r2scan-brugnoli2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-wise-brugnoli2026 mlips:samplingStrategy
    entity:sampling-aimd-brugnoli2026 .

entity:ds-wise-s50-brugnoli2026 mlips:samplingStrategy
    entity:sampling-aimd-brugnoli2026 .

entity:sampling-aimd-brugnoli2026 a mlips:SamplingStrategy ;
    rdfs:label "Configurations from published Li64 and Li128 BLYP-D3 AIMD trajectories (Goloviznina et al.), filtered for SCF failures and forces above 10 eV/A" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-brugnoli2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-brugnoli2026 ;
    mlips:hasImplementation entity:impl-MACE-brugnoli2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-brugnoli2026 a mlips:LossFunction ;
    rdfs:label "Energy and force loss; force weight 200 for FT and 10 for TfS (SI Tables S2-S3)" .

entity:alg-MACE-brugnoli2026 a mls:Algorithm ;
    rdfs:label "FT by multi-head replay; architecture of the OMAT-medium foundation model for FT and TfS" .

entity:impl-MACE-brugnoli2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

