    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-wise-brugnoli2026 ;
    mlips:produces entity:model-tfs-c64-brugnoli2026 .

entity:model-tfs-c64-brugnoli2026 a mlips:TrainedModel ;
