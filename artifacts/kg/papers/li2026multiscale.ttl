entity:run-fpemlp-li2026multiscale a mlips:MLIPRun ;
    rdfs:label "FP-EMLP" ;
    mlips:appliesMethod entity:FP-EMLP ;
    mlips:runsOn entity:ds-fp-li2026multiscale ;
    mlips:hasHyperparameterSetting entity:setting-fpemlp-numLayers-li2026multiscale ,
