entity:run-chgnet-li2026multiscale a mlips:MLIPRun ;
    rdfs:label "CHGNet baseline (training data not described separately)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-li2026multiscale .

