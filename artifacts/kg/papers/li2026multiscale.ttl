# Canonical Turtle for the protocol-derived encoding of:
#   Yan Li et al. (2026). Multiscale Digital-Twin Modeling of Energy-Storage Materials by Integrating First-Principles Calculations and Machine-Learning Interatomic Potentials.
#   EAI Endorsed Transactions on Energy Web. doi:10.4108/ew.14196
#
# Version read: publisher (sha256 56d7cbb393290224...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 591 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/li2026multiscale.yaml.
#
# Encoding scope: the atomistic part of the FP-EMLP-DT framework: the
# FP-EMLP potential (pretrained on 120,000 MPtrj energy-storage
# configurations, fine-tuned on Materials Project Battery electrode data
# and an active-learning LiFePO4/FePO4 set) and six baseline MLIPs, with
# energy and force MAEs on the shared held-out atomistic test partition
# (Table 2). Voltage, migration-barrier and field errors, digital-twin
# state estimation and control results are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-li2026multiscale a mlips:BenchmarkStudy ;
    rdfs:label "Li and Tang (2026): multiscale digital-twin modelling of energy-storage materials with a first-principles-informed equivariant MLIP (FP-EMLP)" ;
    mlips:reportedIn entity:article-li2026multiscale .

entity:article-li2026multiscale a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.4108/ew.14196> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Multiscale Digital-Twin Modeling of Energy-Storage Materials by Integrating First-Principles Calculations and Machine-Learning Interatomic Potentials" ;
    schema:author <https://orcid.org/0009-0002-0397-505X> ,
        entity:person-Tang-li2026multiscale .

<https://orcid.org/0009-0002-0397-505X> a schema:Person ;
    schema:name "Yan Li" ;
    schema:givenName "Yan" ;
    schema:familyName "Li" ;
    schema:identifier <https://orcid.org/0009-0002-0397-505X> .

entity:person-Tang-li2026multiscale a schema:Person ;
    schema:name "Duochang Tang" ;
    schema:givenName "Duochang" ;
    schema:familyName "Tang" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lfp-li2026multiscale a mlips:MaterialSystem ;
    rdfs:label "LiFePO4/FePO4 and other intercalation electrodes (LiCoO2, LiMn2O4, NMC)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbeu-li2026multiscale a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbeu-li2026multiscale mlips:hasDFTSettings entity:calc-settings-pbeu-li2026multiscale .

entity:calc-settings-pbeu-li2026multiscale a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "520"^^xsd:double ;
    rdfs:comment "PBE+U; public MPtrj, Materials Project Battery and JARVIS-DFT data plus active-learning labels" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fp-li2026multiscale a mlips:TrainingDataset ;
    rdfs:label "FP-EMLP training data (MPtrj pretraining, Materials Project Battery fine-tuning, LiFePO4/FePO4 active-learning set)" ;
    mlips:coversMaterial entity:mat-lfp-li2026multiscale ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-pbeu-li2026multiscale .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-fp-li2026multiscale mlips:samplingStrategy
    entity:sampling-mix-li2026multiscale .

entity:sampling-mix-li2026multiscale a mlips:SamplingStrategy ;
    rdfs:label "120,000 MPtrj energy-storage configurations (pretraining), 7,840 Materials Project Battery electrode configurations, and active learning from 2,000 to 6,000 LiFePO4/FePO4 structures (joint sampling); 70/15/15 split by composition, prototype and trajectory" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:FP-EMLP a mlips:MLIPMethod ;
    rdfs:label "FP-EMLP (first-principles-informed equivariant MLIP with electrochemical-state gating and a long-range electrostatics branch)" ;
    mlips:hasLossFunction entity:loss-FP-EMLP-li2026multiscale ;
    mlips:hasTrainingAlgorithm entity:alg-FP-EMLP-li2026multiscale ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-FP-EMLP-li2026multiscale a mlips:LossFunction ;
    rdfs:label "Energies and forces with auxiliary voltage and migration-barrier supervision" .

entity:alg-FP-EMLP-li2026multiscale a mls:Algorithm ;
    rdfs:label "AdamW, up to 500 epochs" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-fpemlp-numLayers-li2026multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-fpemlp-numFeatures-li2026multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-fpemlp-cutoffRadius-li2026multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-fpemlp-learningRate-li2026multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-fpemlp-batchSize-li2026multiscale a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "16"^^xsd:integer .

###############################################################################
