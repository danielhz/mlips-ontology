# Canonical Turtle for the protocol-derived encoding of:
#   Andrea Angeletti et al. (2025). Hydrogen diffusion in magnesium using machine learning potentials: a comparative study.
#   npj Computational Materials. doi:10.1038/s41524-025-01555-z  arXiv:2407.21088v2
#
# Version read: arxiv-preprint arXiv:2407.21088v2 (sha256 894e6f8732cc3c8c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 697 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/angeletti2025.yaml.
#
# Encoding scope: the VASP on-the-fly MLFF for H in hcp Mg, the
# pre-trained MACE and CHGNet universal potentials (MPtrj) as distributed,
# their fine-tunes on the VASP on-the-fly data, and a MACE trained from
# scratch on the same data. Energy and force RMSEs on the 1200-structure
# test set are shown only in Fig. 3 (the text gives bounds), so there are
# no results. Diffusion coefficients and NEB barriers are property
# results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-angeletti2025 a mlips:BenchmarkStudy ;
    rdfs:label "Angeletti et al. (2025): hydrogen diffusion in magnesium with machine-learning potentials, a comparative study" ;
    mlips:reportedIn entity:article-angeletti2025 .

entity:article-angeletti2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01555-z> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Hydrogen diffusion in magnesium using machine learning potentials: a comparative study" ;
    schema:author <https://orcid.org/0000-0002-7142-6768> ,
        <https://orcid.org/0009-0007-5648-0719> ,
        <https://orcid.org/0000-0002-3131-3996> ,
        entity:person-Pasquini-angeletti2025 ,
        entity:person-Papanikolaou-angeletti2025 ,
        <https://orcid.org/0000-0002-7990-2984> .

<https://orcid.org/0000-0002-7142-6768> a schema:Person ;
    schema:name "Andrea Angeletti" ;
    schema:givenName "Andrea" ;
    schema:familyName "Angeletti" ;
    schema:identifier <https://orcid.org/0000-0002-7142-6768> .

<https://orcid.org/0009-0007-5648-0719> a schema:Person ;
    schema:name "Luca Leoni" ;
    schema:givenName "Luca" ;
    schema:familyName "Leoni" ;
    schema:identifier <https://orcid.org/0009-0007-5648-0719> .

<https://orcid.org/0000-0002-3131-3996> a schema:Person ;
    schema:name "Dario Massa" ;
    schema:givenName "Dario" ;
    schema:familyName "Massa" ;
    schema:identifier <https://orcid.org/0000-0002-3131-3996> .

entity:person-Pasquini-angeletti2025 a schema:Person ;
    schema:name "Luca Pasquini" ;
    schema:givenName "Luca" ;
    schema:familyName "Pasquini" .

entity:person-Papanikolaou-angeletti2025 a schema:Person ;
    schema:name "Stefanos Papanikolaou" ;
    schema:givenName "Stefanos" ;
    schema:familyName "Papanikolaou" .

<https://orcid.org/0000-0002-7990-2984> a schema:Person ;
    schema:name "Cesare Franchini" ;
    schema:givenName "Cesare" ;
    schema:familyName "Franchini" ;
    schema:identifier <https://orcid.org/0000-0002-7990-2984> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mgh-angeletti2025 a mlips:MaterialSystem ;
    rdfs:label "hcp Mg with interstitial H (MgH0.0625; 128 Mg + 8 H, also 4-10 H)" ;
    mlips:materialClass "metal hydride (dilute H in Mg)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-angeletti2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-angeletti2025 mlips:hasDFTSettings entity:calc-settings-pbe-angeletti2025 .

entity:calc-settings-pbe-angeletti2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "4x4x4" ;
    rdfs:comment "VASP 6.4.2/6.4.3; non-spin-polarised; Gaussian smearing 0.05 eV; Materials Project-compatible settings." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mgh-angeletti2025 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly ab initio configurations (over 3,700)" ;
    mlips:coversMaterial entity:mat-mgh-angeletti2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-angeletti2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mgh-angeletti2025 mlips:samplingStrategy
    entity:sampling-otf-angeletti2025 .

entity:sampling-otf-angeletti2025 a mlips:SamplingStrategy ;
    rdfs:label "VASP on-the-fly MLFF-MD heating 0-700 K over 0.2 ns plus 100 ps NpT at 300, 480 and 673 K (Bayesian threshold 5 meV/A)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:VASP-MLFF a mlips:MLIPMethod ;
    rdfs:label "VASP on-the-fly machine-learned force field (kernel regression on two- and three-body distribution descriptors with Bayesian error estimates)" ;
    mlips:hasTrainingAlgorithm entity:alg-VASP-MLFF-angeletti2025 ;
    mlips:hasImplementation entity:impl-VASP-MLFF-angeletti2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:alg-VASP-MLFF-angeletti2025 a mls:Algorithm ;
    rdfs:label "VASP on-the-fly MLFF with default parameters" .

entity:impl-VASP-MLFF-angeletti2025 a mlips:Implementation ;
    mlips:implementedIn mlips:VASP .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-angeletti2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-MACE-angeletti2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasImplementation entity:impl-CHGNet-angeletti2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-CHGNet-angeletti2025 a mlips:Implementation ;
    mlips:implementedIn mlips:CHGNet .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-vasp-mlff-angeletti2025 a mlips:MLIPRun ;
    rdfs:label "VASP on-the-fly MLFF for H in Mg" ;
    mlips:appliesMethod entity:VASP-MLFF ;
    mlips:runsOn entity:ds-mgh-angeletti2025 ;
    mlips:produces entity:model-vasp-mlff-angeletti2025 .

entity:model-vasp-mlff-angeletti2025 a mlips:TrainedModel ;
    rdfs:label "VASP-MLFF MgH0.0625" .

entity:run-mace-mp-angeletti2025 a mlips:MLIPRun ;
    rdfs:label "MACE pre-trained on MPtrj as distributed (release not stated)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp-angeletti2025 .

entity:model-mace-mp-angeletti2025 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0" .

entity:run-chgnet-mp-angeletti2025 a mlips:MLIPRun ;
    rdfs:label "CHGNet pre-trained on MPtrj as distributed (version not stated)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-mp-angeletti2025 .

entity:model-chgnet-mp-angeletti2025 a mlips:TrainedModel ;
    rdfs:label "CHGNet pretrained" .

entity:run-mace-ft-angeletti2025 a mlips:MLIPRun ;
    rdfs:label "MACE_FT: MACE fine-tuned on the VASP on-the-fly data" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-mgh-angeletti2025 ;
    mlips:produces entity:model-mace-ft-angeletti2025 .

entity:model-mace-ft-angeletti2025 a mlips:TrainedModel ;
    rdfs:label "MACE_FT (Mg-H)" .

entity:run-chgnet-ft-angeletti2025 a mlips:MLIPRun ;
    rdfs:label "CHGNet_FT: CHGNet fine-tuned on the VASP on-the-fly data" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-mgh-angeletti2025 ;
    mlips:produces entity:model-chgnet-ft-angeletti2025 .

entity:model-chgnet-ft-angeletti2025 a mlips:TrainedModel ;
    rdfs:label "CHGNet_FT (Mg-H)" .

entity:run-mace-scratch-angeletti2025 a mlips:MLIPRun ;
    rdfs:label "MACE trained from scratch on the VASP on-the-fly data" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-mgh-angeletti2025 ;
    mlips:produces entity:model-mace-scratch-angeletti2025 .

entity:model-mace-scratch-angeletti2025 a mlips:TrainedModel ;
    rdfs:label "MACE scratch (Mg-H)" .

