    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-uracil-kwak2026 a mlips:MaterialSystem ;
    rdfs:label "Uracil (MD17)" ;
    mlips:chemicalFormula "C4H4N2O2" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-malonaldehyde-kwak2026 a mlips:MaterialSystem ;
