# Canonical Turtle for the protocol-derived encoding of:
#   Bumju Kwak et al. (2026). Hessian-Informed Conformation Augmentation for Potential Energy Surface Curvature in Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2609.05233  arXiv:2609.05233v3
#
# Version read: arxiv-preprint arXiv:2609.05233v3 (sha256 da9f1cee67f53c57...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 275 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/kwak2026.yaml.
#
# Encoding scope: EquiformerV2 (direct-force and autograd-force heads) and
# GotenNet-S trained on the HORM ts1x training split without augmentation
# or with the Hessian-derived UniAug and ModeAug augmentations (and, for
# GotenNet on 10% of the data, with Hessian row sampling), with the energy
# and force MAEs stated in the text for ts1x-val (in-domain) and RGD1
# (out-of-domain), and the zero-shot MD17 force MAEs of the direct-force
# EquiformerV2 models (Table 3). Values the text gives only as ranges over
# the two augmentations are not encoded; the HessianQM9 study (Table 2)
# does not name the architecture and is not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kwak2026 a mlips:BenchmarkStudy ;
    rdfs:label "Kwak and Jo (2026): Hessian-informed conformation augmentation (UniAug, ModeAug) for MLIP training" ;
    mlips:reportedIn entity:article-kwak2026 .

entity:article-kwak2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2609.05233> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Hessian-Informed Conformation Augmentation for Potential Energy Surface Curvature in Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Kwak-kwak2026 ,
        entity:person-Jo-kwak2026 .

entity:person-Kwak-kwak2026 a schema:Person ;
    schema:name "Bumju Kwak" ;
    schema:givenName "Bumju" ;
    schema:familyName "Kwak" .

entity:person-Jo-kwak2026 a schema:Person ;
    schema:name "Jeonghee Jo" ;
    schema:givenName "Jeonghee" ;
    schema:familyName "Jo" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-t1x-kwak2026 a mlips:MaterialSystem ;
    rdfs:label "Organic reactions of Transition-1x (C, H, N, O): reactants, products and NEB path structures" ;
    mlips:materialClass "Organic molecules off equilibrium (reaction paths)" .

entity:mat-rgd1-kwak2026 a mlips:MaterialSystem ;
    rdfs:label "RGD1 reactions with up to two bonds formed and broken (60k test set)" ;
    mlips:materialClass "Organic molecules off equilibrium (reaction paths)" .

entity:mat-aspirin-kwak2026 a mlips:MaterialSystem ;
    rdfs:label "Aspirin (MD17)" ;
    mlips:chemicalFormula "C9H8O4" ;
    mlips:materialClass "Small organic molecule (gas phase)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q18216> .

entity:mat-ethanol-kwak2026 a mlips:MaterialSystem ;
    rdfs:label "Ethanol (MD17)" ;
    mlips:chemicalFormula "C2H6O" ;
    mlips:materialClass "Small organic molecule (gas phase)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q153> .

