###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97x-kwak2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97x-kwak2026 mlips:hasDFTSettings entity:calc-settings-wb97x-kwak2026 .

entity:calc-settings-wb97x-kwak2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "HORM energies, forces and Hessians (Table 1)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-horm-kwak2026 a mlips:TrainingDataset ;
    rdfs:label "HORM ts1x-train split (HORM has 1,836,206 structures in three splits)" ;
    mlips:coversMaterial entity:mat-t1x-kwak2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-wb97x-kwak2026 ;
    rdfs:comment "HORM also provides DFT Hessians, used to generate the augmented structures and labels by second-order Taylor expansion." .

entity:ds-horm-aug-uni-kwak2026 a mlips:TrainingDataset ;
    rdfs:label "ts1x-train with UniAug (isotropic Gaussian displacements, sigma 0.05 A, 12.5% of atoms; 1:1 original:augmented)" ;
    mlips:coversMaterial entity:mat-t1x-kwak2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-wb97x-kwak2026 .

entity:ds-horm-aug-mode-kwak2026 a mlips:TrainingDataset ;
    rdfs:label "ts1x-train with ModeAug (normal-mode-weighted displacements, sigma 0.05 A; 1:1 original:augmented)" ;
    mlips:coversMaterial entity:mat-t1x-kwak2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-wb97x-kwak2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:hasLossFunction entity:loss-EquiformerV2-kwak2026 ;
    mlips:hasTrainingAlgorithm entity:alg-EquiformerV2-kwak2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-EquiformerV2-kwak2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-EquiformerV2-kwak2026 a mlips:LossFunction ;
    rdfs:label "Weighted energy and force MAE (Eq. S1)" .

entity:alg-EquiformerV2-kwak2026 a mls:Algorithm ;
    rdfs:label "AdamW (weight decay 1e-3, gradient clipping 10), linear warm-up and cosine decay" .

entity:impl-EquiformerV2-kwak2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-kwak2026 .

entity:GotenNet a mlips:MLIPMethod ;
    rdfs:label "GotenNet (geometric tensor network, E(3)-equivariant without irreducible representations or Clebsch-Gordan products)" ;
    mlips:hasLossFunction entity:loss-GotenNet-kwak2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:cutoffRadius .

entity:loss-GotenNet-kwak2026 a mlips:LossFunction ;
    rdfs:label "Weighted energy and force MAE (Eq. S1)" .

entity:lib-fairchem-kwak2026 a mlips:Library ;
    rdfs:label "fairchem" ;
    rdfs:comment "Upstream EquiformerV2 implementation of the HORM benchmark" ;
    mlips:candidateForVocabulary mlips:Library .

