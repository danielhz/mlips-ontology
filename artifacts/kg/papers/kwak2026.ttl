    mlips:chemicalFormula "C10H8" ;
    mlips:materialClass "Small organic molecule (gas phase)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q179724> .

entity:mat-salicylic-kwak2026 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid (MD17)" ;
    mlips:chemicalFormula "C7H6O3" ;
    mlips:materialClass "Small organic molecule (gas phase)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q193572> .

entity:mat-toluene-kwak2026 a mlips:MaterialSystem ;
