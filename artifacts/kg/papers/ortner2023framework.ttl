# Canonical Turtle for the protocol-derived encoding of:
#   Christoph Ortner et al. (2023). A Framework for a Generalization Analysis of Machine-Learned Interatomic Potentials.
#   Multiscale Modeling and Simulation. doi:10.1137/22m152267x  arXiv:2209.05366v1
#
# Version read: arxiv-preprint arXiv:2209.05366v1 (sha256 df5652c7f7bc6c85...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 633 (Software/implementation). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ortner2023framework.yaml.
#
# Encoding scope: the linear ACE models (ACE1.jl, rank-revealing QR least
# squares) fitted to perturbed defect configurations of two reference
# models used to test the theory: an EAM potential on a 2D triangular
# lattice (toy model) and the NRL tight-binding model for Si multi-
# vacancies. Errors are geometry and energy errors versus training-domain
# size shown in figures, and the toy-model RMSEs of Table 2 are in rescaled
# units, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ortner2023framework a mlips:BenchmarkStudy ;
    rdfs:label "Ortner and Wang (2023): a framework for a generalisation analysis of machine-learned interatomic potentials" ;
    mlips:reportedIn entity:article-ortner2023framework .

entity:article-ortner2023framework a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1137/22m152267x> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "A Framework for a Generalization Analysis of Machine-Learned Interatomic Potentials" ;
    schema:author <https://orcid.org/0000-0003-1498-8120> ,
        entity:person-Wang-ortner2023framework .

<https://orcid.org/0000-0003-1498-8120> a schema:Person ;
    schema:name "Christoph Ortner" ;
    schema:givenName "Christoph" ;
    schema:familyName "Ortner" ;
    schema:identifier <https://orcid.org/0000-0003-1498-8120> .

entity:person-Wang-ortner2023framework a schema:Person ;
    schema:name "Yangshuai Wang" ;
    schema:givenName "Yangshuai" ;
    schema:familyName "Wang" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-toy2d-ortner2023framework a mlips:MaterialSystem ;
    rdfs:label "2D triangular lattice with vacancies and interstitials (EAM reference)" ;
    mlips:materialClass "model system" .

entity:mat-si-ortner2023framework a mlips:MaterialSystem ;
    rdfs:label "Diamond silicon with multiple vacancies" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "covalent semiconductor" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-eam-ortner2023framework a mlips:ReferenceCalculation .

entity:calc-nrltb-ortner2023framework a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-eam-ortner2023framework mlips:hasReferenceSettings entity:calc-settings-eam-ortner2023framework .

entity:calc-settings-eam-ortner2023framework a mlips:ReferenceSettings ;
    rdfs:comment "Embedded atom model used as the reference for the 2D toy problem." .

entity:calc-nrltb-ortner2023framework mlips:hasReferenceSettings entity:calc-settings-nrltb-ortner2023framework .

entity:calc-settings-nrltb-ortner2023framework a mlips:ReferenceSettings ;
    rdfs:comment "NRL tight-binding model for Si (Appendix D)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-toy-ortner2023framework a mlips:TrainingDataset ;
    rdfs:label "Perturbed 2D defect configurations labelled with EAM" ;
    mlips:coversMaterial entity:mat-toy2d-ortner2023framework ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-eam-ortner2023framework .

entity:ds-si-tb-ortner2023framework a mlips:TrainingDataset ;
    rdfs:label "Perturbed Si multi-vacancy configurations labelled with NRL-TB" ;
    mlips:coversMaterial entity:mat-si-ortner2023framework ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-nrltb-ortner2023framework .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-toy-ortner2023framework mlips:samplingStrategy
    entity:sampling-perturb-ortner2023framework .

entity:ds-si-tb-ortner2023framework mlips:samplingStrategy
    entity:sampling-perturb-ortner2023framework .

entity:sampling-perturb-ortner2023framework a mlips:SamplingStrategy ;
    rdfs:label "Random perturbations (parameter 0.01) of equilibrated defect configurations in training domains of radius L" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-ortner2023framework ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-ortner2023framework ;
    mlips:hasImplementation entity:impl-ACE-ortner2023framework ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-ACE-ortner2023framework a mlips:LossFunction ;
    rdfs:label "Weighted energy and force least squares (force-constant terms dropped)" .

entity:alg-ACE-ortner2023framework a mls:Algorithm ;
    rdfs:label "Linear ACE fitted by rank-revealing QR with regularisation 1e-6" .

entity:impl-ACE-ortner2023framework a mlips:Implementation ;
    mlips:implementedIn entity:lib-ACE1_jl-ortner2023framework .

entity:lib-ACE1_jl-ortner2023framework a mlips:Library ;
    rdfs:label "ACE1.jl" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ace-toy-ortner2023framework a mlips:MLIPRun ;
    rdfs:label "Linear ACE models for the 2D EAM toy problem (series over training-domain size and basis size)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-toy-ortner2023framework ;
    mlips:produces entity:model-ace-toy-ortner2023framework .

entity:model-ace-toy-ortner2023framework a mlips:TrainedModel ;
    rdfs:label "ACE 2D toy (generalisation study)" .

entity:run-ace-si-ortner2023framework a mlips:MLIPRun ;
    rdfs:label "Linear ACE models for NRL-TB Si multi-vacancies (series over training-domain size)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-si-tb-ortner2023framework ;
    mlips:produces entity:model-ace-si-ortner2023framework .

entity:model-ace-si-ortner2023framework a mlips:TrainedModel ;
    rdfs:label "ACE Si NRL-TB (generalisation study)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Geometry and energy errors of relaxed defects versus fit RMSE and training-domain size are shown only in Figs. 4-9. The 2D toy-model RMSEs and force-constant errors of Table 2 are in rescaled, dimensionless units and are not encoded.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
