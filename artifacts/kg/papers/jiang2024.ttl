@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-jiang2024 a mlips:BenchmarkStudy ;
    rdfs:label "Jiang et al. (2024): neural network potential assisted exploration of ground states of vacancy and interstitial clusters in ThO2" ;
    mlips:reportedIn entity:article-jiang2024 .

entity:article-jiang2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-024-01207-8> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Machine learning potential assisted exploration of complex defect potential energy surfaces" ;
    schema:author <https://orcid.org/0000-0003-0610-6327> ,
