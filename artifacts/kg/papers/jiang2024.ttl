###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tho2-jiang2024 a mlips:MaterialSystem ;
    rdfs:label "ThO2 fluorite with vacancies, interstitials, voids, and liquid ThO2" ;
    mlips:chemicalFormula "ThO2" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-lda-jiang2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-lda-jiang2024 mlips:hasDFTSettings entity:calc-settings-lda-jiang2024 .

entity:calc-settings-lda-jiang2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:LDA ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "1x1x1 for 768-atom supercells" ;
    rdfs:comment "Charged defects with jellium background and monopole correction" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-tho2-jiang2024 a mlips:TrainingDataset ;
    rdfs:label "ThO2 DFT database (3,672 total energies, 3,521,988 force components)" ;
    mlips:coversMaterial entity:mat-tho2-jiang2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 3672 ;
    mlips:hasDFTCalculation entity:calc-lda-jiang2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-tho2-jiang2024 mlips:samplingStrategy
    entity:sampling-ht-jiang2024 .

entity:sampling-ht-jiang2024 a mlips:SamplingStrategy ;
    rdfs:label "High-throughput defect structures (vacancies, interstitials, voids), liquid ThO2 and AIMD snapshots" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-jiang2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-HDNNP-jiang2024 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-HDNNP-jiang2024 a mlips:LossFunction ;
    rdfs:label "Sum of energy and force MSEs" .

entity:impl-HDNNP-jiang2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-jiang2024 .

entity:lib-n2p2-jiang2024 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nnp-cutoffRadius-jiang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-nnp-angularCutoff-jiang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-nnp-numLayers-jiang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nnp-jiang2024 a mlips:MLIPRun ;
    rdfs:label "NNP for defect-containing ThO2" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-tho2-jiang2024 ;
    mlips:hasHyperparameterSetting entity:setting-nnp-cutoffRadius-jiang2024 ,
        entity:setting-nnp-angularCutoff-jiang2024 ,
        entity:setting-nnp-numLayers-jiang2024 ;
    mlips:produces entity:model-nnp-jiang2024 .

entity:model-nnp-jiang2024 a mlips:TrainedModel ;
    rdfs:label "NNP ThO2 defects (Jiang 2024)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-jiang2024 mlips:hasResult
    entity:result-nnp-all-jiang2024 .

entity:result-nnp-all-jiang2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nnp-jiang2024 ;
    mlips:targetMaterial entity:mat-tho2-jiang2024 ;
    mlips:hasAccuracyMetric entity:metric-nnp-all-1-jiang2024 ,
        entity:metric-nnp-all-2-jiang2024 .

entity:metric-nnp-all-1-jiang2024 a mlips:AccuracyMetric ;
    rdfs:label "energy RMS deviation on ThO2 training and test data: NNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.3"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nnp-all-2-jiang2024 a mlips:AccuracyMetric ;
    rdfs:label "force RMS deviation on ThO2 training and test data: NNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.18"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

