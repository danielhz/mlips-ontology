###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mehdizadeh2025 a mlips:BenchmarkStudy ;
    rdfs:label "Mehdizadeh and Schindler (2025): cleavage-energy benchmark of 19 universal MLIPs" ;
    mlips:reportedIn entity:article-mehdizadeh2025 .

entity:article-mehdizadeh2025 a schema:ScholarlyArticle ;
