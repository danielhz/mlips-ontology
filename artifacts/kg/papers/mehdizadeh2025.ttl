    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Surface stability modeling with universal machine learning interatomic potentials: a comprehensive cleavage energy benchmarking study" ;
    schema:author <https://orcid.org/0009-0007-2312-3790> ,
        <https://orcid.org/0000-0002-1319-6570> .

<https://orcid.org/0009-0007-2312-3790> a schema:Person ;
