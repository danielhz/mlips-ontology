###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-dynamat-gawkowski2026 a mlips:MaterialSystem ;
    rdfs:label "Dyna-Mat-v1.0 systems: pure metals, transition-metal dichalcogenides, metal alloys, perovskites (e.g. MAPbBr3), H2O on Pt(111), Cu3Au clusters and molecular crystals (naphthalene, anthracene, tetracene, pentacene, picene)" ;
    mlips:materialClass "Universal (materials and molecules)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-gawkowski2026 a mlips:DFTCalculation .

entity:calc-aims-gawkowski2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-gawkowski2026 mlips:hasDFTSettings entity:calc-settings-vasp-gawkowski2026 .

entity:calc-settings-vasp-gawkowski2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "700"^^xsd:double ;
    mlips:kPointMesh "4.54 1/A Gamma-centred k-point density" ;
    rdfs:comment "potpaw.64, Gaussian smearing 0.05 eV, dipole corrections for surfaces (Table I)." .

entity:calc-aims-gawkowski2026 mlips:hasDFTSettings entity:calc-settings-aims-gawkowski2026 .

entity:calc-settings-aims-gawkowski2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "PBE+D3 for molecular crystals, tight (2020) defaults, all-electron (Table I)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-dynamat-gawkowski2026 a mlips:TrainingDataset ;
    rdfs:label "Dyna-Mat-v1.0: 17 first-principles NVT MD trajectories (up to about 21 ps each)" ;
    mlips:coversMaterial entity:mat-dynamat-gawkowski2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-gawkowski2026 .

