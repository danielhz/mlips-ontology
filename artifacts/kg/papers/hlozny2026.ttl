        mlips:batchSize ;
    mlips:hasImplementation entity:impl-MACE-hlozny2026 ;
    mlips:supportsSimulation mlips:NudgedElasticBand ,
        mlips:MolecularDynamics ,
        mlips:ThermodynamicIntegration .

entity:loss-MACE-hlozny2026 a mlips:LossFunction ;
    rdfs:label "lambda_E MSE(E, E_QMC) + lambda_F thresholded force penalty against DFT forces (lambda_E 100, lambda_F 5, t = 16)" .

entity:alg-MACE-hlozny2026 a mls:Algorithm ;
    rdfs:label "AdamW with AMSGrad, ReduceLROnPlateau (patience 5), gradient clipping 10; message-passing stack frozen, energy readout trained" .

entity:impl-MACE-hlozny2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

