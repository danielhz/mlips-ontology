entity:calc-dmc-hlozny2026 mlips:hasWaveFunctionSettings entity:calc-settings-dmc-hlozny2026 .

entity:calc-settings-dmc-hlozny2026 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-FN-DMC-hlozny2026 ;
