    mlips:materialClass "2D material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-hlozny2026 a mlips:DFTCalculation .

entity:calc-dmc-hlozny2026 a mlips:WaveFunctionCalculation .

entity:calc-hse-hlozny2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-hlozny2026 mlips:hasDFTSettings entity:calc-settings-pbe-hlozny2026 .

entity:calc-settings-pbe-hlozny2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
