###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-DeePMD-zeng2025deepmd ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-DeePMD-zeng2025deepmd a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:DPA2 a mlips:MLIPMethod ;
    rdfs:label "DPA-2 (Deep Potential attention model, version 2, with representation initializer and Reperformer layers)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-DPA2-zeng2025deepmd ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-DPA2-zeng2025deepmd a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dpa1-l0-cutoffRadius-zeng2025deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dpa1-l0c-cutoffRadius-zeng2025deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dpa1-l2-cutoffRadius-zeng2025deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dpa1-l2-numLayers-zeng2025deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-dpa2-cutoffRadius-zeng2025deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dpa2-numLayers-zeng2025deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "6"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dpa1-l0-zeng2025deepmd a mlips:MLIPRun ;
    rdfs:label "DPA-1 water model without attention layers (L=0; se_atten descriptor)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:hasHyperparameterSetting entity:setting-dpa1-l0-cutoffRadius-zeng2025deepmd ;
    mlips:produces entity:model-dpa1-l0-zeng2025deepmd .

entity:model-dpa1-l0-zeng2025deepmd a mlips:TrainedModel ;
    rdfs:label "water DPA-1 (L=0)" .

entity:run-dpa1-l0c-zeng2025deepmd a mlips:MLIPRun ;
    rdfs:label "Compressed DPA-1 water model without attention layers (L=0)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:hasHyperparameterSetting entity:setting-dpa1-l0c-cutoffRadius-zeng2025deepmd ;
    mlips:produces entity:model-dpa1-l0c-zeng2025deepmd .

entity:model-dpa1-l0c-zeng2025deepmd a mlips:TrainedModel ;
    rdfs:label "water DPA-1 (L=0), compressed" .

entity:run-dpa1-l2-zeng2025deepmd a mlips:MLIPRun ;
    rdfs:label "DPA-1 water model with two attention layers (L=2; hidden vectors 128)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:hasHyperparameterSetting entity:setting-dpa1-l2-cutoffRadius-zeng2025deepmd ,
        entity:setting-dpa1-l2-numLayers-zeng2025deepmd ;
    mlips:produces entity:model-dpa1-l2-zeng2025deepmd .

entity:model-dpa1-l2-zeng2025deepmd a mlips:TrainedModel ;
    rdfs:label "water DPA-1 (L=2)" .

entity:run-dpa2-zeng2025deepmd a mlips:MLIPRun ;
    rdfs:label "DPA-2 (medium) water model (6 Reperformer layers; 6 A initializer, 4 A Reperformer and three-body cutoffs)" ;
    mlips:appliesMethod entity:DPA2 ;
    mlips:hasHyperparameterSetting entity:setting-dpa2-cutoffRadius-zeng2025deepmd ,
        entity:setting-dpa2-numLayers-zeng2025deepmd ;
    mlips:produces entity:model-dpa2-zeng2025deepmd .

entity:model-dpa2-zeng2025deepmd a mlips:TrainedModel ;
    rdfs:label "water DPA-2 (medium)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Each timing is the average of 500 repeated calculations (Sec. 4). The same benchmarks on a 40 GB NVIDIA A800/A100 and a 24 GB RTX 4090 are in Tables S2 and S3.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No energy or force errors are reported, and the training data and level of theory of the water models are not described. The A800/A100 (Table S2) and RTX 4090 (Table S3) timings are not encoded (same models and systems); out-of-memory entries are omitted.
# - DPA-1 is a DeePMD-kit descriptor (se_atten) and is encoded under DeePMD, with compression and attention depth as settings; DPA-2 is a new registry method (method paper not in the corpus). per_atom_us is ms per step divided by the atom count.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/zeng2025deepmd.yaml) until the schema has terms for them.
