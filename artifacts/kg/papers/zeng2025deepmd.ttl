entity:mat-water-zeng2025deepmd a mlips:MaterialSystem ;
    rdfs:label "Liquid water boxes of 192 to 98,304 atoms (benchmark systems)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

