# Canonical Turtle for the protocol-derived encoding of:
#   Johannes Gasteiger et al. (2020). Directional Message Passing for Molecular Graphs.
#   arXiv (Cornell University). doi:10.48550/arxiv.2003.03123  arXiv:2003.03123v2
#
# Version read: arxiv-preprint arXiv:2003.03123v2 (sha256 d9088bf46f33d616...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 195 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the DimeNet method (introduced here) and its eight
# MD17 models trained on 1000 samples each, with the shared
# hyperparameters of Appendix B and the energy and force MAEs of Table 2.
# The QM9 property benchmark is not an interatomic-potential task and is
# not encoded. Conference paper (ICLR 2020) read from arXiv v2.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gasteiger2020 a mlips:BenchmarkStudy ;
    rdfs:label "Gasteiger (Klicpera) et al. (2020): directional message passing for molecular graphs (DimeNet)" ;
    mlips:reportedIn entity:article-gasteiger2020 .

entity:article-gasteiger2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2003.03123> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Directional Message Passing for Molecular Graphs" ;
    schema:author entity:person-Gasteiger-gasteiger2020 ,
        entity:person-Gro-gasteiger2020 ,
        entity:person-Gunnemann-gasteiger2020 .

entity:person-Gasteiger-gasteiger2020 a schema:Person ;
    schema:name "Johannes Gasteiger" ;
    schema:givenName "Johannes" ;
    schema:familyName "Gasteiger" .

entity:person-Gro-gasteiger2020 a schema:Person ;
    schema:name "Janek Groß" ;
    schema:givenName "Janek" ;
    schema:familyName "Groß" .

entity:person-Gunnemann-gasteiger2020 a schema:Person ;
    schema:name "Stephan Günnemann" ;
    schema:givenName "Stephan" ;
    schema:familyName "Günnemann" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-aspirin-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-benzene-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-ethanol-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-malonaldehyde-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-naphthalene-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Naphthalene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-salicylic-acid-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-toluene-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-uracil-gasteiger2020 a mlips:MaterialSystem ;
    rdfs:label "Uracil molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-md17-aspirin-gasteiger2020 a mlips:TrainingDataset ;
    rdfs:label "MD17 aspirin: 1000 training samples" ;
    mlips:coversMaterial entity:mat-aspirin-gasteiger2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 .

entity:ds-md17-benzene-gasteiger2020 a mlips:TrainingDataset ;
    rdfs:label "MD17 benzene: 1000 training samples" ;
    mlips:coversMaterial entity:mat-benzene-gasteiger2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 .

