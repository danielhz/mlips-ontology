    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-aspirin-cutoffRadius-gasteiger2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-aspirin-learningRate-gasteiger2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

