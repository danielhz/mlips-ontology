###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-aspirin-gasteiger2020 a mlips:MLIPRun ;
    rdfs:label "DimeNet trained on MD17 aspirin (1000 samples)" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-md17-aspirin-gasteiger2020 ;
    mlips:hasHyperparameterSetting entity:setting-aspirin-numLayers-gasteiger2020 ,
        entity:setting-aspirin-numFeatures-gasteiger2020 ,
        entity:setting-aspirin-numRadialBasis-gasteiger2020 ,
        entity:setting-aspirin-numAngularBasis-gasteiger2020 ,
        entity:setting-aspirin-cutoffRadius-gasteiger2020 ,
        entity:setting-aspirin-learningRate-gasteiger2020 ,
        entity:setting-aspirin-batchSize-gasteiger2020 ,
        entity:setting-aspirin-force-weight-gasteiger2020 ;
    mlips:produces entity:model-aspirin-gasteiger2020 .

entity:model-aspirin-gasteiger2020 a mlips:TrainedModel ;
    rdfs:label "DimeNet model for aspirin (MD17, 1000 samples)" .

entity:run-benzene-gasteiger2020 a mlips:MLIPRun ;
