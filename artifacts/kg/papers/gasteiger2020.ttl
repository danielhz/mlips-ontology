###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-md17-aspirin-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:ds-md17-benzene-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:ds-md17-ethanol-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:ds-md17-malonaldehyde-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:ds-md17-naphthalene-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:ds-md17-salicylic-acid-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:ds-md17-toluene-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:ds-md17-uracil-gasteiger2020 mlips:samplingStrategy
    entity:sampling-md17-gasteiger2020 .

entity:sampling-md17-gasteiger2020 a mlips:SamplingStrategy ;
    rdfs:label "Thermalised DFT molecular-dynamics configurations of single molecules (MD17); 1000 training samples per molecule" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:hasLossFunction entity:loss-DimeNet-gasteiger2020 ;
    mlips:hasTrainingAlgorithm entity:alg-DimeNet-gasteiger2020 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:numAngularBasis ,
        mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize ,
        entity:hp-force-weight-gasteiger2020 .

entity:loss-DimeNet-gasteiger2020 a mlips:LossFunction ;
    rdfs:label "Energy error plus rho times force error (rho = 100 for MD17)" .

entity:alg-DimeNet-gasteiger2020 a mls:Algorithm ;
    rdfs:label "AMSGrad with linear learning-rate warm-up over 3000 steps and exponential decay; exponential moving average of the weights (decay 0.999); early stopping on the validation loss" .

entity:hp-force-weight-gasteiger2020 a mlips:Hyperparameter ;
    rdfs:label "Force weight rho in the loss" ;
    mlips:hyperparameterName "rho" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-aspirin-numLayers-gasteiger2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-aspirin-numFeatures-gasteiger2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

