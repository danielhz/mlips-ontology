# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-torabi2026 ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-torabi2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-ACE-torabi2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-ACE-torabi2026 a mlips:LossFunction ;
    rdfs:label "Linear least squares on energies and forces with solver-specific regularization or sparsity" .

entity:alg-ACE-torabi2026 a mls:Algorithm ;
    rdfs:label "RRQR, BLR, ARD, ASP (homotopy LASSO with TSVD de-biasing) or OMP basis selection" .

entity:impl-ACE-torabi2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-ACEpotentials_jl-torabi2026 .

entity:lib-ACEpotentials_jl-torabi2026 a mlips:Library ;
