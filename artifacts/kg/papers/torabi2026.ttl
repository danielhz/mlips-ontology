@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-torabi2026 a mlips:BenchmarkStudy ;
    rdfs:label "Torabi et al. (2026): scalable data-driven basis selection (ASP, OMP, ARD) for linear ACE potentials, benchmarked on single-element datasets and liquid water" ;
    mlips:reportedIn entity:article-torabi2026 .

