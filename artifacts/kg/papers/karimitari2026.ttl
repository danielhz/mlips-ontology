    entity:sampling-ce-karimitari2026 .

entity:sampling-relax-karimitari2026 a mlips:SamplingStrategy ;
    rdfs:label "First and last relaxation-trajectory frames of chemisorbed adsorbates on 2035 bimetallic alloy surfaces" .

entity:sampling-md-karimitari2026 a mlips:SamplingStrategy ;
    rdfs:label "MD sampling started from previously published metallic and metal-oxide catalyst structures" .

entity:sampling-ce-karimitari2026 a mlips:SamplingStrategy ;
    rdfs:label "Contour exploration (Utarget 150 meV/atom above the MLIP minimum)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-karimitari2026 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        entity:hp-lmax-karimitari2026 ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-karimitari2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand ,
        mlips:MolecularDynamics .

entity:loss-MACE-karimitari2026 a mlips:LossFunction ;
    rdfs:label "Per-atom energy and force MSE; FS weights (E,F) 1000,10 for 400 epochs then 1000,1000 for 100 epochs; FT weights 1,10 for 80 epochs then 10,10" .

entity:impl-MACE-karimitari2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:hp-lmax-karimitari2026 a mlips:Hyperparameter ;
    rdfs:label "Maximum equivariance order L of the MACE messages" ;
    mlips:hyperparameterName "L" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

