# Q6 -- Sampling strategies
###############################################################################

entity:ds-bma-karimitari2026 mlips:samplingStrategy
    entity:sampling-relax-karimitari2026 .

entity:ds-md-m-karimitari2026 mlips:samplingStrategy
    entity:sampling-md-karimitari2026 .

entity:ds-md-mo-karimitari2026 mlips:samplingStrategy
    entity:sampling-md-karimitari2026 .

