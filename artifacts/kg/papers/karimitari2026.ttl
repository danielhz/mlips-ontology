###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cat-m-karimitari2026 a mlips:MaterialSystem ;
    rdfs:label "Adsorbates (H, C, N, O, OH and C2+ intermediates) on transition-metal and bimetallic alloy surfaces" ;
    mlips:materialClass "metallic heterogeneous catalysts" .

entity:mat-cat-mo-karimitari2026 a mlips:MaterialSystem ;
    rdfs:label "O and OH adsorbates on metal-oxide surfaces" ;
    mlips:materialClass "metal-oxide heterogeneous catalysts" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-beef-karimitari2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-beef-karimitari2026 mlips:hasDFTSettings entity:calc-settings-beef-karimitari2026 .

entity:calc-settings-beef-karimitari2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-BEEF-vdW-karimitari2026 ;
    mlips:pseudopotentialType mlips:Ultrasoft ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack, 50 k-points per A in-plane" ;
    rdfs:comment "QE 7.2; GBRV ultrasoft pseudopotentials; charge-density cutoff 5000 eV; 0.15 eV Fermi smearing; at least 12 A vacuum; spin-polarized for partially filled d shells." .

entity:xc-BEEF-vdW-karimitari2026 a mlips:XCFunctional ;
    rdfs:label "BEEF-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

