    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 39983 ;
    mlips:hasDFTCalculation entity:calc-beef-karimitari2026 .

entity:ds-md-m-karimitari2026 a mlips:TrainingDataset ;
    rdfs:label "Metallic-catalyst MD configurations" ;
    mlips:coversMaterial entity:mat-cat-m-karimitari2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4976 ;
    mlips:hasDFTCalculation entity:calc-beef-karimitari2026 .

entity:ds-md-mo-karimitari2026 a mlips:TrainingDataset ;
    rdfs:label "Metal-oxide-catalyst MD configurations" ;
    mlips:coversMaterial entity:mat-cat-mo-karimitari2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2692 ;
    mlips:hasDFTCalculation entity:calc-beef-karimitari2026 .

entity:ds-ce-karimitari2026 a mlips:TrainingDataset ;
    rdfs:label "Contour-exploration configurations (Cu, Ag, Ir, Pd, Pt and Rh surfaces)" ;
    mlips:coversMaterial entity:mat-cat-m-karimitari2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2208 ;
    mlips:hasDFTCalculation entity:calc-beef-karimitari2026 .

entity:ds-all-karimitari2026 a mlips:TrainingDataset ;
    rdfs:label "Full training set (all five source datasets plus MD and CE sampling)" ;
    mlips:coversMaterial entity:mat-cat-m-karimitari2026 ,
        entity:mat-cat-mo-karimitari2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 49860 ;
    mlips:hasDFTCalculation entity:calc-beef-karimitari2026 .

