###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-electrolyte-molecules-ju2025 a mlips:MaterialSystem ;
    rdfs:label "Single molecules of Li-ion battery electrolytes: cyclic and linear carbonates, esters, fluorinated solvents and anions (e.g. EC, VC, DMC, EMC, PF6-, FSI-)" ;
    mlips:materialClass "Organic solvent molecules and salt anions (gas phase)" .

entity:mat-electrolyte-solvents-ju2025 a mlips:MaterialSystem ;
    rdfs:label "Liquid electrolyte solvents with scaled intermolecular distances (fine-tuning domain)" ;
    mlips:materialClass "Organic molecular liquids" .

entity:mat-mptrj-CHO-ju2025 a mlips:MaterialSystem ;
    rdfs:label "Structures containing O, C and H filtered from the SevenNet-0 training set" ;
    mlips:materialClass "Inorganic and organic-containing crystals from MPtrj" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-ju2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-ju2025 mlips:hasDFTSettings entity:calc-settings-dft-ju2025 .

entity:calc-settings-dft-ju2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-D3-BJ-ju2025 ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "Dipole correction in all directions for molecules; relaxation until forces are below 0.02 eV/A. Plane-wave cutoff and k-points were not captured." .

entity:xc-PBE-D3-BJ-ju2025 a mlips:XCFunctional ;
    rdfs:label "PBE-D3(BJ)" ;
    rdfs:comment "PBE with Grimme's D3 dispersion correction and Becke-Johnson damping; dispersion and coordination cutoff radii of 50.2 and 20.0 A." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ft-150-ju2025 a mlips:TrainingDataset ;
    rdfs:label "SevenNet-FT fine-tuning set (150 structures)" ;
    mlips:coversMaterial entity:mat-electrolyte-solvents-ju2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 150 ;
    mlips:hasDFTCalculation entity:calc-dft-ju2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ft-150-ju2025 mlips:samplingStrategy
    entity:sampling-scaled-liquids-ju2025 .

entity:sampling-scaled-liquids-ju2025 a mlips:SamplingStrategy ;
    rdfs:label "Liquid structures with scaled intermolecular distances" ;
    rdfs:comment "Liquid configurations whose intermolecular distances are scaled by factors of 0.9 and 1.1 at fixed intramolecular geometry (among others): 150 structures for fine-tuning." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-ju2025 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ,
        entity:hp-loss-weight-stress-ju2025 ;
    mlips:hasImplementation entity:impl-NequIP-ju2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-NequIP-ju2025 a mls:Algorithm ;
    rdfs:label "Fine-tuning with the SevenNet-0 parameters; learning rate decreasing linearly from 1e-4 to 1e-6 over 600 epochs; stress loss weight raised from 0.01 to 1.0" .

entity:impl-NequIP-ju2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-ju2025 .

entity:lib-SevenNet-ju2025 a mlips:Library ;
    rdfs:label "SevenNet" ;
    rdfs:comment "SevenNet with an in-house CUDA implementation of the D3(BJ) dispersion correction; ASE for static calculations and LAMMPS for MD." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-loss-weight-stress-ju2025 a mlips:Hyperparameter ;
    rdfs:label "Stress loss weight" ;
    mlips:hyperparameterName "stress_loss_weight" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-sevennet-ft-learningRate-ju2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-sevennet-ft-numEpochs-ju2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "600"^^xsd:integer .

entity:setting-sevennet-ft-loss-weight-stress-ju2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-loss-weight-stress-ju2025 ;
    mlips:settingValue "1"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-sevennet-ft-ju2025 a mlips:MLIPRun ;
    rdfs:label "SevenNet-FT: fine-tuning of pretrained SevenNet-0 on 150 electrolyte structures" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-ft-150-ju2025 ;
    mlips:hasHyperparameterSetting entity:setting-sevennet-ft-learningRate-ju2025 ,
        entity:setting-sevennet-ft-numEpochs-ju2025 ,
        entity:setting-sevennet-ft-loss-weight-stress-ju2025 ;
    mlips:produces entity:model-sevennet-ft-ju2025 .

entity:model-sevennet-ft-ju2025 a mlips:TrainedModel ;
    rdfs:label "SevenNet-FT (fine-tuned SevenNet-0, checkpoint after 50 epochs)" .

# Registry stub for the externally trained model SevenNet-0 (not trained in this paper).
entity:run-SevenNet-0 a mlips:MLIPRun ;
    rdfs:label "Training run of SevenNet-0 (842k parameters, trained on MPtrj)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-SevenNet-0 .

entity:model-SevenNet-0 a mlips:TrainedModel ;
    rdfs:label "SevenNet-0 (842k parameters, trained on MPtrj)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-ju2025 mlips:hasResult
    entity:result-sevennet0-molecules-ju2025 ,
    entity:result-sevennet-ft-retention-ju2025 .

entity:result-sevennet0-molecules-ju2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-SevenNet-0 ;
    mlips:targetMaterial entity:mat-electrolyte-molecules-ju2025 ;
    mlips:hasAccuracyMetric entity:metric-sevennet0-molecules-1-ju2025 .

entity:metric-sevennet0-molecules-1-ju2025 a mlips:AccuracyMetric ;
    rdfs:label "MAE on per-atom energies of relaxed single molecules against DFT relaxation: pretrained SevenNet-0 with D3 (largest deviation 51 meV/atom, for VC)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "23"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:result-sevennet-ft-retention-ju2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-sevennet-ft-ju2025 ;
    mlips:targetMaterial entity:mat-mptrj-CHO-ju2025 ;
    mlips:hasAccuracyMetric entity:metric-sevennet-ft-retention-1-ju2025 ,
        entity:metric-sevennet-ft-retention-2-ju2025 ,
        entity:metric-sevennet-ft-retention-3-ju2025 .

entity:metric-sevennet-ft-retention-1-ju2025 a mlips:AccuracyMetric ;
    rdfs:label "MAE on energy, in eV/atom, on a retention test set of 19,072 O/C/H-containing structures from the SevenNet-0 training set: SevenNet-FT" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.032"^^xsd:double .

entity:metric-sevennet-ft-retention-2-ju2025 a mlips:AccuracyMetric ;
    rdfs:label "MAE on forces on the retention test set of 19,072 structures: SevenNet-FT" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.086"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:metric-sevennet-ft-retention-3-ju2025 a mlips:AccuracyMetric ;
    rdfs:label "MAE on stress, in kbar, on the retention test set of 19,072 structures: SevenNet-FT" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.57"^^xsd:double .

