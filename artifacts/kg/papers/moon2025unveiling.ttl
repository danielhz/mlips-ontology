###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-moon2025unveiling ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-HDNNP-moon2025unveiling ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-moon2025unveiling a mlips:LossFunction ;
    rdfs:label "MSE of energy per atom, forces and stresses, L2 regularization 1e-8" .

entity:impl-HDNNP-moon2025unveiling a mlips:Implementation ;
    mlips:implementedIn entity:lib-SIMPLE-NN-moon2025unveiling .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-moon2025unveiling ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-MTP-moon2025unveiling ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MTP-moon2025unveiling a mlips:LossFunction ;
    rdfs:label "MSE of energies, forces and stresses" .

entity:impl-MTP-moon2025unveiling a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-NequIP-moon2025unveiling ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:impl-NequIP-moon2025unveiling a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-moon2025unveiling .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-nu-moon2025unveiling ;
    mlips:hasImplementation entity:impl-MACE-moon2025unveiling ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-moon2025unveiling a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-moon2025unveiling .

entity:lib-SIMPLE-NN-moon2025unveiling a mlips:Library ;
    rdfs:label "SIMPLE-NN" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-SevenNet-moon2025unveiling a mlips:Library ;
    rdfs:label "SevenNet" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-nu-moon2025unveiling a mlips:Hyperparameter ;
    rdfs:label "Maximum correlation order nu (number of self-tensor products)" ;
    mlips:hyperparameterName "nu" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

