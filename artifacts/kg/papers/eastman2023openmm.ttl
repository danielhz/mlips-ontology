###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-revpbe-eastman2023openmm mlips:hasDFTSettings entity:calc-settings-revpbe-eastman2023openmm .

entity:calc-settings-revpbe-eastman2023openmm a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-eastman2023openmm ;
    mlips:xcFunctional entity:xc-revPBE-D3-eastman2023openmm ;
