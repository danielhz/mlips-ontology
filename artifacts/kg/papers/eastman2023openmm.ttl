###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gfp-eastman2023openmm mlips:samplingStrategy
    entity:sampling-aimd-eastman2023openmm .

entity:sampling-aimd-eastman2023openmm a mlips:SamplingStrategy ;
    rdfs:label "Every 2 fs from 10 classical AIMD trajectories (about 150 ps) and AI-PIMD (15 ps)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasImplementation entity:impl-ANI-eastman2023openmm ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-ANI-eastman2023openmm a mlips:Implementation ;
    mlips:implementedIn mlips:TorchANI .

entity:TorchMD-ET a mlips:MLIPMethod ;
    rdfs:label "Equivariant Transformer (TorchMD-NET)" ;
    mlips:hasLossFunction entity:loss-TorchMD-ET-eastman2023openmm ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numRadialBasis ,
        mlips:numFeatures ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-TorchMD-ET-eastman2023openmm ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-TorchMD-ET-eastman2023openmm a mlips:LossFunction ;
    rdfs:label "Forces" .

entity:impl-TorchMD-ET-eastman2023openmm a mlips:Implementation ;
    mlips:implementedIn entity:lib-TorchMD-NET-eastman2023openmm .

entity:lib-TorchMD-NET-eastman2023openmm a mlips:Library ;
    rdfs:label "TorchMD-NET" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-et-numLayers-eastman2023openmm a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-et-numRadialBasis-eastman2023openmm a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-et-numFeatures-eastman2023openmm a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-et-numEpochs-eastman2023openmm a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-et-eastman2023openmm a mlips:MLIPRun ;
    rdfs:label "Equivariant transformer for the GFP chromophore in water" ;
    mlips:appliesMethod entity:TorchMD-ET ;
    mlips:runsOn entity:ds-gfp-eastman2023openmm ;
    mlips:hasHyperparameterSetting entity:setting-et-numLayers-eastman2023openmm ,
        entity:setting-et-numRadialBasis-eastman2023openmm ,
        entity:setting-et-numFeatures-eastman2023openmm ,
        entity:setting-et-numEpochs-eastman2023openmm ;
    mlips:produces entity:model-et-eastman2023openmm .

entity:model-et-eastman2023openmm a mlips:TrainedModel ;
    rdfs:label "TorchMD-ET GFP chromophore in water" .

# Registry stub for the externally trained model ANI-2x (not trained in this paper).
entity:run-ANI-2x a mlips:MLIPRun ;
    rdfs:label "Training run of ANI-2x general-purpose neural network potential" ;
    mlips:appliesMethod entity:ANI ;
    mlips:produces entity:model-ANI-2x .

entity:model-ANI-2x a mlips:TrainedModel ;
    rdfs:label "ANI-2x general-purpose neural network potential" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-eastman2023openmm mlips:hasResult
    entity:result-et-test-eastman2023openmm .

entity:result-et-test-eastman2023openmm a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-et-eastman2023openmm ;
    mlips:targetMaterial entity:mat-gfp-eastman2023openmm ;
    mlips:hasAccuracyMetric entity:metric-et-test-1-eastman2023openmm ;
    mlips:inferenceTimePerAtom "16.48"^^xsd:double ;
    mlips:inferenceHardware "NVIDIA RTX 4080 (AIMD: 13.2 s on two 64-core AMD EPYC 7763)" .

entity:metric-et-test-1-eastman2023openmm a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on GFP chromophore in water: TorchMD-ET" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "45.7"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

