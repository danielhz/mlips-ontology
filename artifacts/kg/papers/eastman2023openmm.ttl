entity:ds-gfp-eastman2023openmm a mlips:TrainingDataset ;
    rdfs:label "GFP chromophore in water: 75,008 AIMD plus 7,500 AI-PIMD configurations (80/10/10 split)" ;
    mlips:coversMaterial entity:mat-gfp-eastman2023openmm ;
    mlips:coversProperty mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
