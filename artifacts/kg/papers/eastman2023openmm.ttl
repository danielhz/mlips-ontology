entity:mat-cdk8-eastman2023openmm a mlips:MaterialSystem ;
    rdfs:label "53-atom inhibitor (lig_30) bound to CDK8 in TIP3P-FB water (134,099 atoms, ligand treated by the MLP)" ;
    mlips:materialClass "Organic and biochemical molecules (C, N, O, H)" .

entity:mat-gfp-eastman2023openmm a mlips:MaterialSystem ;
    rdfs:label "Anionic GFP chromophore (HBDI-) with 167 waters (528 atoms, periodic)" ;
    mlips:materialClass "Solvated molecule" .

