# Canonical Turtle for the protocol-derived encoding of:
#   Burak Gurlek et al. (2025). Accurate machine learning interatomic potentials for polyacene molecular crystals: application to single molecule host-guest systems.
#   npj Computational Materials. doi:10.1038/s41524-025-01825-w  arXiv:2504.11224v3
#
# Version read: arxiv-preprint arXiv:2504.11224v3 (sha256 3301a5b80046beb8...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 383 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/gurlek2025.yaml.
#
# Encoding scope: VASP on-the-fly MLFFs and MACE models for crystalline
# naphthalene (single-temperature 295 K data, Table 1; multi-temperature
# VASP data and committee-selected FHI-aims data, Table 2; VASP MLFF on
# the MACE committee data, SI Table 1), and the generalized MACE
# committees for naphthalene to pentacene (Table 4). Phonon-frequency
# errors, VDOS and host-guest analyses are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gurlek2025 a mlips:BenchmarkStudy ;
    rdfs:label "Gurlek et al. (2025): VASP and MACE MLIPs for polyacene molecular crystals, committee uncertainty propagation to phonons, and pentacene in naphthalene" ;
    mlips:reportedIn entity:article-gurlek2025 .

entity:article-gurlek2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01825-w> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Accurate machine learning interatomic potentials for polyacene molecular crystals: application to single molecule host-guest systems" ;
    schema:author entity:person-Gurlek-gurlek2025 ,
        entity:person-Sharma-gurlek2025 ,
        entity:person-Lazzaroni-gurlek2025 ,
        entity:person-Rubio-gurlek2025 ,
        entity:person-Rossi-gurlek2025 .

entity:person-Gurlek-gurlek2025 a schema:Person ;
    schema:name "Burak Gurlek" ;
    schema:givenName "Burak" ;
    schema:familyName "Gurlek" .

entity:person-Sharma-gurlek2025 a schema:Person ;
    schema:name "Shubham Sharma" ;
    schema:givenName "Shubham" ;
    schema:familyName "Sharma" .

entity:person-Lazzaroni-gurlek2025 a schema:Person ;
    schema:name "Paolo Lazzaroni" ;
    schema:givenName "Paolo" ;
    schema:familyName "Lazzaroni" .

entity:person-Rubio-gurlek2025 a schema:Person ;
    schema:name "Angel Rubio" ;
    schema:givenName "Angel" ;
    schema:familyName "Rubio" .

entity:person-Rossi-gurlek2025 a schema:Person ;
    schema:name "Mariana Rossi" ;
    schema:givenName "Mariana" ;
    schema:familyName "Rossi" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-naph-gurlek2025 a mlips:MaterialSystem ;
    rdfs:label "Crystalline naphthalene (80-295 K)" ;
    mlips:chemicalFormula "C10H8" ;
    mlips:materialClass "Organic molecular crystal" .

entity:mat-acenes-gurlek2025 a mlips:MaterialSystem ;
    rdfs:label "Crystalline naphthalene, anthracene, tetracene and pentacene" ;
    mlips:materialClass "Organic molecular crystal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-gurlek2025 a mlips:DFTCalculation .

entity:calc-aims-gurlek2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-gurlek2025 mlips:hasDFTSettings entity:calc-settings-vasp-gurlek2025 .

entity:calc-settings-vasp-gurlek2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:energyCutoff "1000"^^xsd:double ;
    mlips:kPointMesh "2x2x1 Monkhorst-Pack" ;
    rdfs:comment "VASP 6.4.2 on-the-fly MD data; the exchange-correlation functional is not named in the main text (Methods)." .

entity:calc-aims-gurlek2025 mlips:hasDFTSettings entity:calc-settings-aims-gurlek2025 .

entity:calc-settings-aims-gurlek2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    rdfs:comment "FHI-aims with the tight basis-set defaults (no vocabulary individual for tight); functional not named in the main text." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-v295-gurlek2025 a mlips:TrainingDataset ;
    rdfs:label "VASP on-the-fly naphthalene data at 295 K" ;
    mlips:coversMaterial entity:mat-naph-gurlek2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1402 ;
    mlips:hasDFTCalculation entity:calc-vasp-gurlek2025 .

entity:ds-vmulti-gurlek2025 a mlips:TrainingDataset ;
    rdfs:label "VASP on-the-fly naphthalene data at 295, 220, 150, 120 and 80 K (940, 22, 145, 14, 47 structures)" ;
    mlips:coversMaterial entity:mat-naph-gurlek2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1168 ;
    mlips:hasDFTCalculation entity:calc-vasp-gurlek2025 .

entity:ds-mcomm-gurlek2025 a mlips:TrainingDataset ;
    rdfs:label "Committee-selected naphthalene structures at 80-295 K (FHI-aims single points; 9:1 train/validation)" ;
    mlips:coversMaterial entity:mat-naph-gurlek2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 450 ;
    mlips:hasDFTCalculation entity:calc-aims-gurlek2025 .

entity:ds-g1-gurlek2025 a mlips:TrainingDataset ;
    rdfs:label "Generalized set G-MLIP 1: 450 naphthalene + 125 anthracene structures" ;
    mlips:coversMaterial entity:mat-acenes-gurlek2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 575 ;
    mlips:hasDFTCalculation entity:calc-aims-gurlek2025 .

entity:ds-g2-gurlek2025 a mlips:TrainingDataset ;
    rdfs:label "Generalized set G-MLIP 2: 450 naphthalene + 125 anthracene + 125 tetracene structures" ;
    mlips:coversMaterial entity:mat-acenes-gurlek2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 700 ;
    mlips:hasDFTCalculation entity:calc-aims-gurlek2025 .

entity:ds-g3-gurlek2025 a mlips:TrainingDataset ;
    rdfs:label "Generalized set G-MLIP 3: 450 naphthalene + 125 each of anthracene, tetracene and pentacene" ;
    mlips:coversMaterial entity:mat-acenes-gurlek2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 825 ;
    mlips:hasDFTCalculation entity:calc-aims-gurlek2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-v295-gurlek2025 mlips:samplingStrategy
    entity:sampling-otf-gurlek2025 .

entity:ds-vmulti-gurlek2025 mlips:samplingStrategy
    entity:sampling-otf-gurlek2025 .

entity:ds-mcomm-gurlek2025 mlips:samplingStrategy
    entity:sampling-committee-gurlek2025 .

entity:ds-g1-gurlek2025 mlips:samplingStrategy
    entity:sampling-committee-gurlek2025 .

entity:ds-g2-gurlek2025 mlips:samplingStrategy
    entity:sampling-committee-gurlek2025 .

entity:ds-g3-gurlek2025 mlips:samplingStrategy
    entity:sampling-committee-gurlek2025 .

entity:sampling-otf-gurlek2025 a mlips:SamplingStrategy ;
    rdfs:label "VASP on-the-fly Bayesian active learning during MD of a 1x2x2 naphthalene supercell" .

entity:sampling-committee-gurlek2025 a mlips:SamplingStrategy ;
    rdfs:label "Committee (8 MACE models) active learning on energy uncertainty from an AIMD/MACE-OFF structure pool, starting from 100 farthest-point-sampled structures, 25 added per iteration" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:VASP-MLFF a mlips:MLIPMethod ;
    rdfs:label "VASP on-the-fly machine-learned force field (kernel regression on two- and three-body distribution descriptors with Bayesian error estimates)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-VASP-MLFF-gurlek2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:impl-VASP-MLFF-gurlek2025 a mlips:Implementation ;
    mlips:implementedIn mlips:VASP .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-gurlek2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-MACE-gurlek2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:loss-MACE-gurlek2025 a mlips:LossFunction ;
    rdfs:label "Energy weight 10, force weight 1000" .

entity:impl-MACE-gurlek2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

