###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-mtp-CHfTa-10-roberts2024 a mlips:MLIPRun ;
    rdfs:label "Robust MTP of level 10 for C-Hf-Ta (active learning with PRAPs)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-CHfTa-roberts2024 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-CHfTa-10-momentLevel-roberts2024 ,
        entity:setting-mtp-CHfTa-10-cutoffRadius-roberts2024 ,
        entity:setting-mtp-CHfTa-10-min-distance-roberts2024 ;
    mlips:produces entity:model-mtp-CHfTa-10-roberts2024 .

entity:model-mtp-CHfTa-10-roberts2024 a mlips:TrainedModel ;
    rdfs:label "Robust MTP, level 10, C-Hf-Ta" .

entity:run-mtp-CHfTa-16-roberts2024 a mlips:MLIPRun ;
    rdfs:label "Robust MTP of level 16 for C-Hf-Ta (active learning with PRAPs)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-CHfTa-roberts2024 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-CHfTa-16-momentLevel-roberts2024 ,
        entity:setting-mtp-CHfTa-16-cutoffRadius-roberts2024 ,
        entity:setting-mtp-CHfTa-16-min-distance-roberts2024 ;
    mlips:produces entity:model-mtp-CHfTa-16-roberts2024 .

