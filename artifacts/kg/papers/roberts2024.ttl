###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-CHfTa-roberts2024 a mlips:MaterialSystem ;
    rdfs:label "C-Hf-Ta ternary carbides (AFLOW structures and RANDSPG-generated structures)" ;
    mlips:chemicalFormula "C-Hf-Ta" ;
    mlips:materialClass "Refractory ternary carbide system" .

entity:mat-CHfZr-roberts2024 a mlips:MaterialSystem ;
    rdfs:label "C-Hf-Zr ternary carbides (AFLOW structures and RANDSPG-generated structures)" ;
    mlips:chemicalFormula "C-Hf-Zr" ;
    mlips:materialClass "Refractory ternary carbide system" .

entity:mat-CMoW-roberts2024 a mlips:MaterialSystem ;
    rdfs:label "C-Mo-W ternary carbides (AFLOW structures and RANDSPG-generated structures)" ;
    mlips:chemicalFormula "C-Mo-W" ;
    mlips:materialClass "Refractory ternary carbide system" .

entity:mat-CTaTi-roberts2024 a mlips:MaterialSystem ;
    rdfs:label "C-Ta-Ti ternary carbides (AFLOW structures and RANDSPG-generated structures)" ;
    mlips:chemicalFormula "C-Ta-Ti" ;
    mlips:materialClass "Refractory ternary carbide system" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-roberts2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-roberts2024 mlips:hasDFTSettings entity:calc-settings-dft-roberts2024 .

entity:calc-settings-dft-roberts2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred Monkhorst-Pack meshes with (number of divisions) x (lattice constant) = 30 A" ;
    rdfs:comment "VASP 5.4.12, used for the single-point calculations of the active-learning procedure; AFLOW standard settings for the relaxations of the convex-hull analysis." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-CHfTa-roberts2024 a mlips:TrainingDataset ;
    rdfs:label "C-Hf-Ta MTP training data (AFLOW relaxation steps plus actively selected configurations)" ;
    mlips:coversMaterial entity:mat-CHfTa-roberts2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-dft-roberts2024 ;
    rdfs:comment "The numbers of AFLOW structures, ionic steps and RANDSPG structures per system are in Table I, which was not captured from the extracted text." .

entity:ds-CHfZr-roberts2024 a mlips:TrainingDataset ;
    rdfs:label "C-Hf-Zr MTP training data (AFLOW relaxation steps plus actively selected configurations)" ;
    mlips:coversMaterial entity:mat-CHfZr-roberts2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-dft-roberts2024 ;
    rdfs:comment "The numbers of AFLOW structures, ionic steps and RANDSPG structures per system are in Table I, which was not captured from the extracted text." .

entity:ds-CMoW-roberts2024 a mlips:TrainingDataset ;
    rdfs:label "C-Mo-W MTP training data (AFLOW relaxation steps plus actively selected configurations)" ;
    mlips:coversMaterial entity:mat-CMoW-roberts2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-dft-roberts2024 ;
    rdfs:comment "The numbers of AFLOW structures, ionic steps and RANDSPG structures per system are in Table I, which was not captured from the extracted text." .

entity:ds-CTaTi-roberts2024 a mlips:TrainingDataset ;
    rdfs:label "C-Ta-Ti MTP training data (AFLOW relaxation steps plus actively selected configurations)" ;
    mlips:coversMaterial entity:mat-CTaTi-roberts2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-dft-roberts2024 ;
    rdfs:comment "The numbers of AFLOW structures, ionic steps and RANDSPG structures per system are in Table I, which was not captured from the extracted text." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-CHfTa-roberts2024 mlips:samplingStrategy
    entity:sampling-aflow-relaxations-roberts2024 ,
    entity:sampling-randspg-active-learning-roberts2024 .

entity:ds-CHfZr-roberts2024 mlips:samplingStrategy
    entity:sampling-aflow-relaxations-roberts2024 ,
    entity:sampling-randspg-active-learning-roberts2024 .

entity:ds-CMoW-roberts2024 mlips:samplingStrategy
    entity:sampling-aflow-relaxations-roberts2024 ,
    entity:sampling-randspg-active-learning-roberts2024 .

entity:ds-CTaTi-roberts2024 mlips:samplingStrategy
    entity:sampling-aflow-relaxations-roberts2024 ,
    entity:sampling-randspg-active-learning-roberts2024 .

entity:sampling-aflow-relaxations-roberts2024 a mlips:SamplingStrategy ;
    rdfs:label "Ionic steps of AFLOW structural relaxations" ;
    rdfs:comment "All individual ionic steps of the relaxations of the system's structures in the AFLOW database; about 800 configurations with minimum interatomic distance above 1.1 A are chosen at random for the initial training (pre-robust potential)." .

entity:sampling-randspg-active-learning-roberts2024 a mlips:SamplingStrategy ;
    rdfs:label "Active learning during relaxation of RANDSPG-generated structures" ;
    rdfs:comment "Structures from AFLOW and from the random symmetric structure generator RANDSPG are relaxed with the MTP; configurations with extrapolation grade 2 < gamma <= 10 are computed with DFT and added until no structure is selected (for level 22, until fewer than 1% would be added)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-roberts2024 ;
    mlips:hasHyperparameter mlips:momentLevel ,
        mlips:cutoffRadius ,
        entity:hp-min-distance-roberts2024 ;
    mlips:hasImplementation entity:impl-MTP-roberts2024 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:alg-MTP-roberts2024 a mls:Algorithm ;
    rdfs:label "Pre-training on AFLOW data (best of five trainings), then active learning into a robust potential and an accurate potential restricted to low-energy structures, automated by the PRAPs workflow" .

entity:impl-MTP-roberts2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:hp-min-distance-roberts2024 a mlips:Hyperparameter ;
    rdfs:label "Minimum interatomic distance of the MTP (Angstrom)" ;
    mlips:hyperparameterName "min_dist" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-CHfTa-10-momentLevel-roberts2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-mtp-CHfTa-10-cutoffRadius-roberts2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-mtp-CHfTa-10-min-distance-roberts2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-min-distance-roberts2024 ;
    mlips:settingValue "1.1"^^xsd:double .

entity:setting-mtp-CHfTa-16-momentLevel-roberts2024 a mlips:HyperparameterSetting ;
