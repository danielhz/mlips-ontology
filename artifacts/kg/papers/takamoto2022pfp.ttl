###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-universal-takamoto2022pfp a mlips:MaterialSystem ;
    rdfs:label "Arbitrary combinations of 45 elements (molecules, bulk, clusters, slabs, adsorbates, disordered structures)" ;
    mlips:materialClass "Universal (multi-element)" .

entity:mat-disordered-takamoto2022pfp a mlips:MaterialSystem ;
    rdfs:label "Disordered multi-element structures from high-temperature MD (37 elements in HME21)" ;
    mlips:materialClass "Disordered multi-element structures" .

entity:mat-adsorbed-takamoto2022pfp a mlips:MaterialSystem ;
    rdfs:label "Small molecules adsorbed on crystal surfaces" ;
    mlips:materialClass "Adsorbate-surface systems" .

entity:mat-molecules-takamoto2022pfp a mlips:MaterialSystem ;
    rdfs:label "Organic molecules with eight heavy atoms (C, N, O, P, S), normal-mode sampled" ;
    mlips:materialClass "Organic molecules" .

entity:mat-oc20-takamoto2022pfp a mlips:MaterialSystem ;
    rdfs:label "Adsorbate-catalyst structures of Open Catalyst 2020" ;
    mlips:materialClass "Adsorbate-surface systems" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-crystal-takamoto2022pfp a mlips:DFTCalculation .

entity:calc-molecule-takamoto2022pfp a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-crystal-takamoto2022pfp mlips:hasDFTSettings entity:calc-settings-crystal-takamoto2022pfp .

entity:calc-settings-crystal-takamoto2022pfp a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "1000 k-points per reciprocal atom; Gamma only for structures with vacuum in all directions" ;
    rdfs:comment "VASP 5.4.4 with GPU acceleration; spin-polarised; GGA+U (Dudarev) with Materials Project U-J values applied to all structures; Gaussian smearing 0.05 eV." .

entity:calc-molecule-takamoto2022pfp mlips:hasDFTSettings entity:calc-settings-molecule-takamoto2022pfp .

entity:calc-settings-molecule-takamoto2022pfp a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:Gaussian ;
    mlips:xcFunctional entity:xc-omegaB97X-D-takamoto2022pfp ;
    mlips:dftBasisSet entity:basis-6-31G-d-takamoto2022pfp ;
    rdfs:comment "Gaussian 16; unrestricted calculations with a symmetry-broken initial guess." .

entity:xc-omegaB97X-D-takamoto2022pfp a mlips:XCFunctional ;
    rdfs:label "omegaB97X-D" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-6-31G-d-takamoto2022pfp a mlips:DftBasisSet ;
    rdfs:label "6-31G(d)" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-pfp-takamoto2022pfp a mlips:TrainingDataset ;
    rdfs:label "PFP data set (PFP molecule and PFP crystal data sets) together with OC20" ;
    mlips:coversMaterial entity:mat-universal-takamoto2022pfp ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-crystal-takamoto2022pfp ;
    rdfs:comment "Atomic charges (Bader) are a supplementary training target. The molecule part is computed at a different level (omegaB97X-D/6-31G(d)) and selected at inference by a 'calculation mode' input." .

entity:ds-oc20-takamoto2022pfp a mlips:TrainingDataset ;
    rdfs:label "Open Catalyst 2020 (S2EF)" ;
    mlips:coversMaterial entity:mat-oc20-takamoto2022pfp ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-hme21-takamoto2022pfp a mlips:TrainingDataset ;
    rdfs:label "HME21 (high-temperature multi-element 2021; 19,956 training, 2,498 validation and 2,495 test structures)" ;
    mlips:coversMaterial entity:mat-disordered-takamoto2022pfp ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 19956 ;
    mlips:hasDFTCalculation entity:calc-crystal-takamoto2022pfp .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-pfp-takamoto2022pfp mlips:samplingStrategy
    entity:sampling-crystal-takamoto2022pfp ,
    entity:sampling-molecule-takamoto2022pfp ,
    entity:sampling-published-takamoto2022pfp .

entity:ds-oc20-takamoto2022pfp mlips:samplingStrategy
    entity:sampling-published-takamoto2022pfp .

entity:ds-hme21-takamoto2022pfp mlips:samplingStrategy
    entity:sampling-crystal-takamoto2022pfp .

entity:sampling-crystal-takamoto2022pfp a mlips:SamplingStrategy ;
    rdfs:label "Cell volume and shape changes and random atomic displacements of bulk, cluster and slab structures; randomly placed and PFP-optimised adsorbates; high-temperature MD of randomly selected and placed atoms (disordered); two-body potentials" .

entity:sampling-molecule-takamoto2022pfp a mlips:SamplingStrategy ;
    rdfs:label "Geometry optimisation, normal-mode sampling and high-temperature MD of molecules, including radicals and ions" .

entity:sampling-published-takamoto2022pfp a mlips:SamplingStrategy ;
    rdfs:label "Published data set used as provided" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:TeaNet a mlips:MLIPMethod ;
    rdfs:label "TeaNet (tensor embedded atom network)" ;
    mlips:hasFunctionalForm entity:ff-TeaNet ;
    mlips:hasLossFunction entity:loss-TeaNet-takamoto2022pfp ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        entity:hp-layer-cutoffs-takamoto2022pfp ,
        mlips:batchSize ,
        mlips:learningRate ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:MonteCarlo ,
        mlips:GeometryOptimization ;
    mlips:inferenceComplexity "Fully local model; receptive field 22 Angstrom (sum of the layer cutoffs)" .

entity:ff-TeaNet a mlips:FunctionalForm ;
    rdfs:label "Graph convolutional network whose message passing carries scalar, vector and rank-2 tensor values on atoms and bonds, motivated by rewriting the embedded-atom and bond-order (Tersoff-type) potentials as graph convolutions and by iterative electronic relaxation; energies are sums of atomic contributions and forces come from backpropagation" .

entity:loss-TeaNet-takamoto2022pfp a mlips:LossFunction ;
    rdfs:label "Energy-per-atom MSE (coefficient 0.0001, then retrained with 1.0 and 10.0) plus force loss (coefficient 1.0) in the HME21 benchmark" .

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        entity:hp-lmax-takamoto2022pfp .

entity:hp-layer-cutoffs-takamoto2022pfp a mlips:Hyperparameter ;
    rdfs:label "Cutoff distance per GNN layer (Angstrom)" ;
    mlips:hyperparameterName "layer_cutoffs" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lmax-takamoto2022pfp a mlips:Hyperparameter ;
    rdfs:label "Maximum rotation order l_max" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-pfp-numLayers-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-pfp-layer-cutoffs-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-layer-cutoffs-takamoto2022pfp ;
    mlips:settingValue "3, 3, 4, 6, 6" .

entity:setting-teanet-hme21-numLayers-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-teanet-hme21-cutoffRadius-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-teanet-hme21-batchSize-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "16"^^xsd:integer .

entity:setting-teanet-hme21-learningRate-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-schnet-hme21-numLayers-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-schnet-hme21-cutoffRadius-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-schnet-hme21-batchSize-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-schnet-hme21-learningRate-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0005"^^xsd:double .

entity:setting-painn-hme21-numLayers-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-painn-hme21-cutoffRadius-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-painn-hme21-batchSize-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-painn-hme21-learningRate-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0005"^^xsd:double .

entity:setting-nequip0-hme21-numLayers-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-nequip0-hme21-cutoffRadius-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-nequip0-hme21-batchSize-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-nequip0-hme21-learningRate-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-nequip0-hme21-lmax-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lmax-takamoto2022pfp ;
    mlips:settingValue "0"^^xsd:integer .

entity:setting-nequip1-hme21-numLayers-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-nequip1-hme21-cutoffRadius-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-nequip1-hme21-batchSize-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-nequip1-hme21-learningRate-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-nequip1-hme21-lmax-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lmax-takamoto2022pfp ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-nequip2-hme21-numLayers-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-nequip2-hme21-cutoffRadius-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-nequip2-hme21-batchSize-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-nequip2-hme21-learningRate-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
