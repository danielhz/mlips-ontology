entity:setting-nequip2-hme21-lmax-takamoto2022pfp a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lmax-takamoto2022pfp ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-pfp-takamoto2022pfp a mlips:MLIPRun ;
    rdfs:label "Training of PFP (TeaNet with Morse-style two-body term and calculation-mode input)" ;
    mlips:appliesMethod entity:TeaNet ;
    mlips:runsOn entity:ds-pfp-takamoto2022pfp ;
    mlips:hasHyperparameterSetting entity:setting-pfp-numLayers-takamoto2022pfp ,
        entity:setting-pfp-layer-cutoffs-takamoto2022pfp ;
    mlips:produces entity:model-pfp-takamoto2022pfp .

entity:model-pfp-takamoto2022pfp a mlips:TrainedModel ;
    rdfs:label "PFP" .

entity:run-pfp-oc20-takamoto2022pfp a mlips:MLIPRun ;
    rdfs:label "PFP architecture trained on OC20 only" ;
    mlips:appliesMethod entity:TeaNet ;
    mlips:runsOn entity:ds-oc20-takamoto2022pfp ;
    mlips:produces entity:model-pfp-oc20-takamoto2022pfp .

entity:model-pfp-oc20-takamoto2022pfp a mlips:TrainedModel ;
    rdfs:label "PFP (OC20)" .

entity:run-teanet-hme21-takamoto2022pfp a mlips:MLIPRun ;
    rdfs:label "TeaNet trained on HME21" ;
    mlips:appliesMethod entity:TeaNet ;
    mlips:runsOn entity:ds-hme21-takamoto2022pfp ;
    mlips:hasHyperparameterSetting entity:setting-teanet-hme21-numLayers-takamoto2022pfp ,
        entity:setting-teanet-hme21-cutoffRadius-takamoto2022pfp ,
        entity:setting-teanet-hme21-batchSize-takamoto2022pfp ,
        entity:setting-teanet-hme21-learningRate-takamoto2022pfp ;
    mlips:produces entity:model-teanet-hme21-takamoto2022pfp .

entity:model-teanet-hme21-takamoto2022pfp a mlips:TrainedModel ;
    rdfs:label "TeaNet (PFP base model) trained on HME21" .

entity:run-schnet-hme21-takamoto2022pfp a mlips:MLIPRun ;
    rdfs:label "SchNet trained on HME21" ;
    mlips:appliesMethod entity:SchNet ;
    mlips:runsOn entity:ds-hme21-takamoto2022pfp ;
    mlips:hasHyperparameterSetting entity:setting-schnet-hme21-numLayers-takamoto2022pfp ,
        entity:setting-schnet-hme21-cutoffRadius-takamoto2022pfp ,
