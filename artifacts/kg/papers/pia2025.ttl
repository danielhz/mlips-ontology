###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vdw-pia2025 a mlips:DFTCalculation .

entity:calc-revpbe-pia2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vdw-pia2025 mlips:hasDFTSettings entity:calc-settings-vdw-pia2025 .

entity:calc-settings-vdw-pia2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-vdW-DF2-pia2025 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "1000"^^xsd:double ;
    mlips:kPointMesh "System-specific grids converging lattice energies to 1 meV (Table S1); Gamma point for gas phase" ;
    rdfs:comment "Hard PAW potentials, SCF break 1e-7 eV." .

entity:calc-revpbe-pia2025 mlips:hasDFTSettings entity:calc-settings-revpbe-pia2025 .

entity:calc-settings-revpbe-pia2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-revPBE-D3-pia2025 ;
    rdfs:comment "Reference for the ice polymorphs (SI S14)." .

entity:xc-vdW-DF2-pia2025 a mlips:XCFunctional ;
    rdfs:label "vdW-DF2" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-revPBE-D3-pia2025 a mlips:XCFunctional ;
    rdfs:label "revPBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

