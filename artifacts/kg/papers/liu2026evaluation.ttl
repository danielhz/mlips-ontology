@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liu2026evaluation a mlips:BenchmarkStudy ;
    rdfs:label "Liu et al. (2026): Bond Smoothness Characterization Test (BSCT) and the MinDScAIP architecture" ;
    mlips:reportedIn entity:article-liu2026evaluation .

entity:article-liu2026evaluation a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2602.04861> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "From Evaluation to Design: Using Potential Energy Surface Smoothness Metrics to Guide Machine Learning Interatomic Potential Architectures" ;
    schema:author entity:person-Liu-liu2026evaluation ,
        entity:person-Qu-liu2026evaluation ,
        entity:person-Kreiman-liu2026evaluation ,
        entity:person-Blau-liu2026evaluation ,
        entity:person-Krishnapriyan-liu2026evaluation .

