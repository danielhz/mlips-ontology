###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MinDScAIP a mlips:MLIPMethod ;
    rdfs:label "MinDScAIP (minimally constrained differentiable scaled attention interatomic potential)" ;
    mlips:hasLossFunction entity:loss-MinDScAIP-liu2026evaluation ;
    mlips:hasTrainingAlgorithm entity:alg-MinDScAIP-liu2026evaluation ;
    mlips:hasHyperparameter mlips:numFeatures ,
        mlips:numLayers ,
        mlips:numRadialBasis ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MinDScAIP-liu2026evaluation ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-MinDScAIP-liu2026evaluation a mlips:LossFunction ;
    rdfs:label "Energy (weight 1) and force (weight 2; 4 when fine-tuning on MPtrj) MAE-type loss, stress weight 10 on MPtrj" .

entity:alg-MinDScAIP-liu2026evaluation a mls:Algorithm ;
    rdfs:label "Weight decay, EMA 0.999, gradient clipping 100; MPtrj models pretrained with direct forces and DeNS, then fine-tuned with gradient forces" .

entity:impl-MinDScAIP-liu2026evaluation a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-liu2026evaluation .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:GemNet a mlips:MLIPMethod ;
    rdfs:label "GemNet (geometric message passing neural network)" ;
    mlips:hasFunctionalForm entity:ff-GemNet ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-GemNet a mlips:FunctionalForm ;
    rdfs:label "Directional graph neural network with geometric message passing over atom triplets and, in the two-hop form, quadruplets, built on spherical representations; energies are sums of atomic contributions and forces are obtained by backpropagation or, in the direct variants, predicted directly" .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" .

entity:lib-fairchem-liu2026evaluation a mlips:Library ;
    rdfs:label "fairchem" ;
    rdfs:comment "Diff-kNN released in the fairchem repository" ;
    mlips:candidateForVocabulary mlips:Library .

