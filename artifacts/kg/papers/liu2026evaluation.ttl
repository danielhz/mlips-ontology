###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-spice-liu2026evaluation a mlips:MaterialSystem ;
    rdfs:label "SPICE drug-like molecules, peptides, dimers and water clusters (MACE-OFF split)" ;
    mlips:materialClass "Organic molecules and molecular clusters" .

entity:mat-mptrj-liu2026evaluation a mlips:MaterialSystem ;
    rdfs:label "Materials Project relaxation trajectories (inorganic crystals)" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-wbm-liu2026evaluation a mlips:MaterialSystem ;
    rdfs:label "WBM test set of Matbench Discovery (inorganic crystals)" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-diamond-liu2026evaluation a mlips:MaterialSystem ;
    rdfs:label "Diamond supercells (216 to 2,744 atoms)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental covalent solid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q623> .

