    schema:name "Ryan Liu" ;
    schema:givenName "Ryan" ;
    schema:familyName "Liu" .

entity:person-Qu-liu2026evaluation a schema:Person ;
    schema:name "Eric Qu" ;
    schema:givenName "Eric" ;
    schema:familyName "Qu" .

entity:person-Kreiman-liu2026evaluation a schema:Person ;
    schema:name "Tobias Kreiman" ;
