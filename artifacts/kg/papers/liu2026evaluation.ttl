entity:run-m-wd-liu2026evaluation a mlips:MLIPRun ;
    rdfs:label "MinDScAIP on SPICE, weight decay 0.05" ;
    mlips:appliesMethod entity:MinDScAIP ;
    mlips:runsOn entity:ds-spice-liu2026evaluation ;
    mlips:hasHyperparameterSetting entity:setting-m-wd-numFeatures-liu2026evaluation ,
        entity:setting-m-wd-numLayers-liu2026evaluation ,
        entity:setting-m-wd-numRadialBasis-liu2026evaluation ,
        entity:setting-m-wd-cutoffRadius-liu2026evaluation ,
        entity:setting-m-wd-batchSize-liu2026evaluation ,
        entity:setting-m-wd-numEpochs-liu2026evaluation ;
    mlips:produces entity:model-m-wd-liu2026evaluation .

