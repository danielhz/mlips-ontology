entity:ds-spice-liu2026evaluation a mlips:TrainingDataset ;
    rdfs:label "SPICE training split of MACE-OFF" ;
    mlips:coversMaterial entity:mat-spice-liu2026evaluation ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-mptrj-liu2026evaluation a mlips:TrainingDataset ;
    rdfs:label "MPtrj" ;
    mlips:coversMaterial entity:mat-mptrj-liu2026evaluation ;
