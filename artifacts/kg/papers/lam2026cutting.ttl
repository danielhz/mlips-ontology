# Canonical Turtle for the protocol-derived encoding of:
#   Terry C. W. Lam et al. (2026). Cutting Through the Noise: On-the-fly Outlier Detection for Robust Training of Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2602.08849  arXiv:2602.08849v1
#
# Version read: arxiv-preprint arXiv:2602.08849v1 (sha256 d991660defe5e0e5...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 689 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/lam2026cutting.yaml.
#
# Encoding scope: MACE models trained with and without the on-the-fly
# outlier down-weighting on noisy data: aspirin with 10% MD17 forces mixed
# into revMD17, liquid water from loosely converged revPBE calculations
# (plus a reference model on clean data), and the SPICE v2 data set. The
# only numbers stated in the text are median force errors and approximate
# values, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-lam2026cutting a mlips:BenchmarkStudy ;
    rdfs:label "Lam, O'Neill, Schran and Schaaf (2026): on-the-fly outlier detection (bootstrapping) for robust MLIP training" ;
    mlips:reportedIn entity:article-lam2026cutting .

entity:article-lam2026cutting a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2602.08849> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Cutting Through the Noise: On-the-fly Outlier Detection for Robust Training of Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Lam-lam2026cutting ,
        entity:person-ONeill-lam2026cutting ,
        entity:person-Schran-lam2026cutting ,
        entity:person-Schaaf-lam2026cutting .

entity:person-Lam-lam2026cutting a schema:Person ;
    schema:name "Terry C. W. Lam" ;
    schema:givenName "Terry C. W." ;
    schema:familyName "Lam" .

entity:person-ONeill-lam2026cutting a schema:Person ;
    schema:name "Niamh O'Neill" ;
    schema:givenName "Niamh" ;
    schema:familyName "O'Neill" .

entity:person-Schran-lam2026cutting a schema:Person ;
    schema:name "Christoph Schran" ;
    schema:givenName "Christoph" ;
    schema:familyName "Schran" .

entity:person-Schaaf-lam2026cutting a schema:Person ;
    schema:name "Lars L. Schaaf" ;
    schema:givenName "Lars L." ;
    schema:familyName "Schaaf" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-aspirin-lam2026cutting a mlips:MaterialSystem ;
    rdfs:label "Aspirin (revMD17 with 10% MD17 force labels)" ;
    mlips:materialClass "small organic molecule" .

entity:mat-water-lam2026cutting a mlips:MaterialSystem ;
    rdfs:label "Liquid water (126 molecules)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid" .

entity:mat-organics-lam2026cutting a mlips:MaterialSystem ;
    rdfs:label "SPICE v2 molecules" ;
    mlips:materialClass "organic and biomolecular systems" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-svp-lam2026cutting a mlips:DFTCalculation .

entity:calc-revpbe-lam2026cutting a mlips:DFTCalculation .

entity:calc-spice-lam2026cutting a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-svp-lam2026cutting mlips:hasDFTSettings entity:calc-settings-pbe-svp-lam2026cutting .

entity:calc-settings-pbe-svp-lam2026cutting a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "revMD17 labels; 10% of forces replaced by MD17 values to emulate noise." .

entity:calc-revpbe-lam2026cutting mlips:hasDFTSettings entity:calc-settings-revpbe-lam2026cutting .

entity:calc-settings-revpbe-lam2026cutting a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional entity:xc-revPBE-lam2026cutting ;
    rdfs:comment "Loose SCF thresholds for the noisy set; tight thresholds for the clean reference set." .

entity:calc-spice-lam2026cutting mlips:hasDFTSettings entity:calc-settings-spice-lam2026cutting .

entity:calc-settings-spice-lam2026cutting a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-wB97M-D3-BJ-lam2026cutting ;
    mlips:basisSet "def2-TZVPPD" ;
    rdfs:comment "SPICE v2 (Psi4)." .

entity:xc-revPBE-lam2026cutting a mlips:XCFunctional ;
    rdfs:label "revPBE" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-wB97M-D3-BJ-lam2026cutting a mlips:XCFunctional ;
    rdfs:label "wB97M-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aspirin-lam2026cutting a mlips:TrainingDataset ;
    rdfs:label "1000 revMD17 aspirin samples with 10% MD17 forces" ;
    mlips:coversMaterial entity:mat-aspirin-lam2026cutting ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-pbe-svp-lam2026cutting .

entity:ds-water-noisy-lam2026cutting a mlips:TrainingDataset ;
    rdfs:label "Noisy water data (1616 loosely converged configurations)" ;
    mlips:coversMaterial entity:mat-water-lam2026cutting ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1616 ;
    mlips:hasDFTCalculation entity:calc-revpbe-lam2026cutting .

entity:ds-water-clean-lam2026cutting a mlips:TrainingDataset ;
    rdfs:label "Clean water data (tightly converged)" ;
    mlips:coversMaterial entity:mat-water-lam2026cutting ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-revpbe-lam2026cutting .

entity:ds-spice-lam2026cutting a mlips:TrainingDataset ;
    rdfs:label "SPICE v2" ;
    mlips:coversMaterial entity:mat-organics-lam2026cutting ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-spice-lam2026cutting .

