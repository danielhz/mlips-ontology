# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-lam2026cutting ;
    mlips:hasImplementation entity:impl-MACE-lam2026cutting ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-MACE-lam2026cutting a mls:Algorithm ;
    rdfs:label "Per-configuration loss weights updated on the fly from the convergence rate of each configuration's error (bootstrapping), versus standard training and iterative refinement" .

entity:impl-MACE-lam2026cutting a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

