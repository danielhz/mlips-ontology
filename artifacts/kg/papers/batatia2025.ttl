# Canonical Turtle for the protocol-derived encoding of:
#   Ilyes Batatia et al. (2025). The design space of E(3)-equivariant atom-centred interatomic potentials.
#   Nature Machine Intelligence. doi:10.1038/s42256-024-00956-x  arXiv:2205.06643v2
#
# Version read: arxiv-preprint arXiv:2205.06643v2 (sha256 50dd938e81dd300e...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 16 (Overview/taxonomy). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the BOTNet method (introduced here within the
# Multi-ACE framework) and the benchmark models the authors train:
# BOTNet and NequIP on 3BPA (500 configurations at 300 K; Table IX) and
# BOTNet, NequIP and linear ACE on acetylacetone (500 configurations at
# 300 K; Table X), with test RMSEs at each temperature. The design-space
# ablations (Tables III to VII) and rMD17 (Table VIII) are not encoded.
# The manifest files the paper under 'Overview/taxonomy'; it also
# reports original results. Read from the arXiv preprint (v2).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-batatia2025 a mlips:BenchmarkStudy ;
    rdfs:label "Batatia et al. (2025): the design space of E(3)-equivariant atom-centred interatomic potentials" ;
    mlips:reportedIn entity:article-batatia2025 .

entity:article-batatia2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s42256-024-00956-x> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "The design space of E(3)-equivariant atom-centred interatomic potentials" ;
    schema:author entity:person-Batatia-batatia2025 ,
        <https://orcid.org/0000-0002-8826-2712> ,
        entity:person-Kovacs-batatia2025 ,
        entity:person-Musaelian-batatia2025 ,
        entity:person-Simm-batatia2025 ,
        entity:person-Drautz-batatia2025 ,
        entity:person-Ortner-batatia2025 ,
        <https://orcid.org/0000-0002-0638-539X> ,
        <https://orcid.org/0000-0002-8180-2034> .

entity:person-Batatia-batatia2025 a schema:Person ;
    schema:name "Ilyes Batatia" ;
    schema:givenName "Ilyes" ;
    schema:familyName "Batatia" .

<https://orcid.org/0000-0002-8826-2712> a schema:Person ;
    schema:name "Simon Batzner" ;
    schema:givenName "Simon" ;
    schema:familyName "Batzner" ;
    schema:identifier <https://orcid.org/0000-0002-8826-2712> .

entity:person-Kovacs-batatia2025 a schema:Person ;
    schema:name "Dávid Péter Kovács" ;
    schema:givenName "Dávid Péter" ;
    schema:familyName "Kovács" .

