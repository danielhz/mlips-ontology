    schema:name "Albert Musaelian" ;
    schema:givenName "Albert" ;
    schema:familyName "Musaelian" .

entity:person-Simm-batatia2025 a schema:Person ;
    schema:name "Gregor N. C. Simm" ;
    schema:givenName "Gregor N. C." ;
    schema:familyName "Simm" .

entity:person-Drautz-batatia2025 a schema:Person ;
    schema:name "Ralf Drautz" ;
    schema:givenName "Ralf" ;
    schema:familyName "Drautz" .

entity:person-Ortner-batatia2025 a schema:Person ;
    schema:name "Christoph Ortner" ;
    schema:givenName "Christoph" ;
    schema:familyName "Ortner" .

