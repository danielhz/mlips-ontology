###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-3BPA-batatia2025 a mlips:MaterialSystem ;
    rdfs:label "3-(benzyloxy)pyridin-2-amine (3BPA), flexible drug-like molecule" ;
    mlips:chemicalFormula "C12H12N2O" ;
    mlips:materialClass "Organic molecule" .

entity:mat-acac-batatia2025 a mlips:MaterialSystem ;
    rdfs:label "Acetylacetone" ;
    mlips:chemicalFormula "C5H8O2" ;
    mlips:materialClass "Organic molecule" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-acac-dft-batatia2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-acac-dft-batatia2025 mlips:hasDFTSettings entity:calc-settings-acac-dft-batatia2025 .

entity:calc-settings-acac-dft-batatia2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional mlips:PBE ;
    mlips:dftBasisSet entity:basis-def2-SVP-batatia2025 ;
    rdfs:comment "PBE with D3 dispersion correction, VeryTightSCF settings." .

entity:basis-def2-SVP-batatia2025 a mlips:DftBasisSet ;
    rdfs:label "def2-SVP" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-3BPA-batatia2025 a mlips:TrainingDataset ;
    rdfs:label "3BPA training set (500 configurations sampled at 300 K)" ;
    mlips:coversMaterial entity:mat-3BPA-batatia2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 500 ;
    rdfs:comment "Reference level of the published 3BPA data is not restated in the part read." .

entity:ds-acac-batatia2025 a mlips:TrainingDataset ;
    rdfs:label "Acetylacetone training set (500 configurations sampled at 300 K)" ;
    mlips:coversMaterial entity:mat-acac-batatia2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 500 ;
    mlips:hasDFTCalculation entity:calc-acac-dft-batatia2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-3BPA-batatia2025 mlips:samplingStrategy
    entity:sampling-3bpa-batatia2025 .

entity:ds-acac-batatia2025 mlips:samplingStrategy
    entity:sampling-acac-batatia2025 .

entity:sampling-3bpa-batatia2025 a mlips:SamplingStrategy ;
    rdfs:label "Published 3BPA data: snapshots from MD at 300 K (training); test sets at 300, 600 and 1200 K and a DFT dihedral scan" .

entity:sampling-acac-batatia2025 a mlips:SamplingStrategy ;
    rdfs:label "Long Langevin MD at 300 K at the GFN2-xTB level, sampled every 1 ps and recomputed with DFT; test sets at 300 K and 600 K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:BOTNet a mlips:MLIPMethod ;
    rdfs:label "BOTNet (body-ordered tensor network)" ;
    mlips:hasHyperparameter entity:hp-num-parameters-batatia2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter entity:hp-num-parameters-batatia2025 .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasHyperparameter entity:hp-num-parameters-batatia2025 .

entity:hp-num-parameters-batatia2025 a mlips:Hyperparameter ;
    rdfs:label "Number of model parameters" ;
    mlips:hyperparameterName "num_parameters" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-BOTNet-acac-num-parameters-batatia2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-num-parameters-batatia2025 ;
    mlips:settingValue "2756416"^^xsd:integer .

entity:setting-NequIP-acac-num-parameters-batatia2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-num-parameters-batatia2025 ;
    mlips:settingValue "3190488"^^xsd:integer .

entity:setting-ACE-acac-num-parameters-batatia2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-num-parameters-batatia2025 ;
    mlips:settingValue "35594"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-BOTNet-3BPA-batatia2025 a mlips:MLIPRun ;
    rdfs:label "BOTNet trained on 3BPA (300 K)" ;
    mlips:appliesMethod entity:BOTNet ;
    mlips:runsOn entity:ds-3BPA-batatia2025 ;
    mlips:produces entity:model-BOTNet-3BPA-batatia2025 .

entity:model-BOTNet-3BPA-batatia2025 a mlips:TrainedModel ;
    rdfs:label "BOTNet model for 3BPA" .

entity:run-NequIP-3BPA-batatia2025 a mlips:MLIPRun ;
    rdfs:label "NequIP trained on 3BPA (300 K)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-3BPA-batatia2025 ;
    mlips:produces entity:model-NequIP-3BPA-batatia2025 .

entity:model-NequIP-3BPA-batatia2025 a mlips:TrainedModel ;
    rdfs:label "NequIP model for 3BPA" .

entity:run-BOTNet-acac-batatia2025 a mlips:MLIPRun ;
    rdfs:label "BOTNet trained on acetylacetone (300 K)" ;
    mlips:appliesMethod entity:BOTNet ;
    mlips:runsOn entity:ds-acac-batatia2025 ;
    mlips:hasHyperparameterSetting entity:setting-BOTNet-acac-num-parameters-batatia2025 ;
    mlips:produces entity:model-BOTNet-acac-batatia2025 .

entity:model-BOTNet-acac-batatia2025 a mlips:TrainedModel ;
    rdfs:label "BOTNet model for acetylacetone" .

entity:run-NequIP-acac-batatia2025 a mlips:MLIPRun ;
    rdfs:label "NequIP trained on acetylacetone (300 K)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-acac-batatia2025 ;
    mlips:hasHyperparameterSetting entity:setting-NequIP-acac-num-parameters-batatia2025 ;
    mlips:produces entity:model-NequIP-acac-batatia2025 .

entity:model-NequIP-acac-batatia2025 a mlips:TrainedModel ;
    rdfs:label "NequIP model for acetylacetone" .

entity:run-ACE-acac-batatia2025 a mlips:MLIPRun ;
    rdfs:label "Linear ACE trained on acetylacetone (300 K)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-acac-batatia2025 ;
    mlips:hasHyperparameterSetting entity:setting-ACE-acac-num-parameters-batatia2025 ;
    mlips:produces entity:model-ACE-acac-batatia2025 .

entity:model-ACE-acac-batatia2025 a mlips:TrainedModel ;
    rdfs:label "Linear ACE model for acetylacetone" .

