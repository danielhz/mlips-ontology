@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bilbrey2025 a mlips:BenchmarkStudy ;
    rdfs:label "Bilbrey, Firoz, Lee and Choudhury (2025): uncertainty quantification for neural network potential foundation models" ;
    mlips:reportedIn entity:article-bilbrey2025 .

entity:article-bilbrey2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01572-y> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Uncertainty quantification for neural network potential foundation models" ;
    schema:author entity:person-Bilbrey-bilbrey2025 ,
        entity:person-Firoz-bilbrey2025 ,
        entity:person-Lee-bilbrey2025 ,
        entity:person-Choudhury-bilbrey2025 .

entity:person-Bilbrey-bilbrey2025 a schema:Person ;
    schema:name "Jenna A. Bilbrey" ;
    schema:givenName "Jenna A." ;
    schema:familyName "Bilbrey" .

entity:person-Firoz-bilbrey2025 a schema:Person ;
    schema:name "Jesun S. Firoz" ;
    schema:givenName "Jesun S." ;
    schema:familyName "Firoz" .

entity:person-Lee-bilbrey2025 a schema:Person ;
    schema:name "Mal-Soon Lee" ;
    schema:givenName "Mal-Soon" ;
    schema:familyName "Lee" .

entity:person-Choudhury-bilbrey2025 a schema:Person ;
    schema:name "Sutanay Choudhury" ;
    schema:givenName "Sutanay" ;
    schema:familyName "Choudhury" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-inorganic-bilbrey2025 a mlips:MaterialSystem ;
    rdfs:label "Materials Project structures (MPtrj)" ;
    mlips:materialClass "inorganic materials" .

entity:mat-hea-bilbrey2025 a mlips:MaterialSystem ;
    rdfs:label "HEA25 high-entropy alloy structures (25 elements)" ;
    mlips:materialClass "high-entropy alloys" .

entity:mat-zsm5-bilbrey2025 a mlips:MaterialSystem ;
    rdfs:label "H-ZSM-5 zeolite with n = 1-16 water molecules" ;
    mlips:materialClass "aluminosilicate zeolite" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mp-bilbrey2025 a mlips:DFTCalculation .

entity:calc-hea-ref-bilbrey2025 a mlips:DFTCalculation .

entity:calc-zsm-ref-bilbrey2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mp-bilbrey2025 mlips:hasDFTSettings entity:calc-settings-mp-bilbrey2025 .

entity:calc-settings-mp-bilbrey2025 a mlips:DFTSettings ;
    rdfs:comment "MPtrj published labels." .

entity:calc-hea-ref-bilbrey2025 mlips:hasDFTSettings entity:calc-settings-hea-ref-bilbrey2025 .

entity:calc-settings-hea-ref-bilbrey2025 a mlips:DFTSettings ;
    rdfs:comment "HEA25 published labels (Ref. 43)." .

entity:calc-zsm-ref-bilbrey2025 mlips:hasDFTSettings entity:calc-settings-zsm-ref-bilbrey2025 .

entity:calc-settings-zsm-ref-bilbrey2025 a mlips:DFTSettings ;
