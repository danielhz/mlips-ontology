###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mptrj-sub-bilbrey2025 a mlips:TrainingDataset ;
    rdfs:label "Random 90,000-structure MPtrj subsets per model (80,000 train / 10,000 validation)" ;
    mlips:coversMaterial entity:mat-inorganic-bilbrey2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-mp-bilbrey2025 .

entity:ds-hea25-bilbrey2025 a mlips:TrainingDataset ;
    rdfs:label "HEA25 data set" ;
