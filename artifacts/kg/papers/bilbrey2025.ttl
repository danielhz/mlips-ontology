###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-bilbrey2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-bilbrey2025 .

entity:loss-MACE-bilbrey2025 a mlips:LossFunction ;
    rdfs:label "Huber loss (ensemble readouts); smoothed quantile loss at q = 0.05 and 0.95 (quantile model)" .

entity:alg-MACE-bilbrey2025 a mls:Algorithm ;
    rdfs:label "Frozen MACE-MP-0 interaction head; only the final readout module is trained" .

