    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-hea-ref-bilbrey2025 .

entity:ds-zsm5-bilbrey2025 a mlips:TrainingDataset ;
    rdfs:label "H-ZSM-5 with 1-3 water molecules (training); 8 and 16 held out" ;
    mlips:coversMaterial entity:mat-zsm5-bilbrey2025 ;
    mlips:coversProperty mlips:Energy ,
