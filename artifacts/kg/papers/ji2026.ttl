# Canonical Turtle for the protocol-derived encoding of:
#   Yajie Ji et al. (2026). Accurate learning of long-range interatomic potentials by coupling Cartesian atomic cluster expansion and sum-of-Gaussians neural networks.
#   The Journal of Chemical Physics. doi:10.1063/5.0303312
#
# Version read: publisher (sha256 d8574f159461222e...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 60 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the CACE-SOG method (introduced here) and the fits
# whose errors the paper tabulates: molecular dimers of three interaction
# types (Table I) and ionic NaCl clusters (Table III), each with the
# short-range CACE and the CACE-LES comparison models trained by the
# authors, and CACE-SOG on Au2-MgO(001), Cu-BTA and Ag3 clusters
# (Table IV).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ji2026 a mlips:BenchmarkStudy ;
    rdfs:label "Ji et al. (2026): long-range interatomic potentials by coupling Cartesian atomic cluster expansion with sum-of-Gaussians neural networks (CACE-SOG)" ;
    mlips:reportedIn entity:article-ji2026 .

entity:article-ji2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0303312> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Accurate learning of long-range interatomic potentials by coupling Cartesian atomic cluster expansion and sum-of-Gaussians neural networks" ;
    schema:author <https://orcid.org/0009-0000-6789-4385> ,
        <https://orcid.org/0000-0003-0247-4149> ,
        <https://orcid.org/0000-0001-7645-4998> .

<https://orcid.org/0009-0000-6789-4385> a schema:Person ;
    schema:name "Yajie Ji" ;
    schema:givenName "Yajie" ;
    schema:familyName "Ji" ;
    schema:identifier <https://orcid.org/0009-0000-6789-4385> .

<https://orcid.org/0000-0003-0247-4149> a schema:Person ;
    schema:name "Jiuyang Liang" ;
    schema:givenName "Jiuyang" ;
    schema:familyName "Liang" ;
    schema:identifier <https://orcid.org/0000-0003-0247-4149> .

<https://orcid.org/0000-0001-7645-4998> a schema:Person ;
    schema:name "Zhenli Xu" ;
    schema:givenName "Zhenli" ;
    schema:familyName "Xu" ;
    schema:identifier <https://orcid.org/0000-0001-7645-4998> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-NaCl-clusters-ji2026 a mlips:MaterialSystem ;
    rdfs:label "Ionic Na9Cl8+ and Na8Cl8+ clusters" ;
    mlips:materialClass "Charged ionic clusters with global charge transfer" .

entity:mat-dimer-CC-ji2026 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers: charge-charge dimers (1/r decay)" ;
    mlips:materialClass "Molecular dimers at separations of about 5 to 15 A" .

entity:mat-dimer-PP-ji2026 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers: polar-polar dimers (1/r^3 decay)" ;
    mlips:materialClass "Molecular dimers at separations of about 5 to 15 A" .

entity:mat-dimer-AA-ji2026 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers: apolar-apolar dimers (1/r^6 decay)" ;
    mlips:materialClass "Molecular dimers at separations of about 5 to 15 A" .

entity:mat-Au2-MgO-ji2026 a mlips:MaterialSystem ;
    rdfs:label "Au2 cluster on MgO(001)" ;
    mlips:materialClass "Benchmark system for long-range and charge-state effects" .

entity:mat-Cu-BTA-ji2026 a mlips:MaterialSystem ;
    rdfs:label "Benzotriazole (BTA) on copper" ;
    mlips:materialClass "Benchmark system for long-range and charge-state effects" .

entity:mat-Ag3-ji2026 a mlips:MaterialSystem ;
    rdfs:label "Ag3 clusters in two charge states (+/-)" ;
    mlips:materialClass "Benchmark system for long-range and charge-state effects" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dimer-dft-ji2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dimer-dft-ji2026 mlips:hasDFTSettings entity:calc-settings-dimer-dft-ji2026 .

entity:calc-settings-dimer-dft-ji2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-HSE06-many-body-dispersion-ji2026 ;
    rdfs:comment "Level of the molecular dimer data set (ref. 51 of the paper); code and basis not restated." .

entity:xc-HSE06-many-body-dispersion-ji2026 a mlips:XCFunctional ;
    rdfs:label "HSE06 + many-body dispersion" ;
    rdfs:comment "HSE06 hybrid functional with a many-body dispersion correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-NaCl-clusters-ji2026 a mlips:TrainingDataset ;
    rdfs:label "Na9Cl8+ / Na8Cl8+ cluster data set" ;
    mlips:coversMaterial entity:mat-NaCl-clusters-ji2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Size and reference level were not captured from the parts read." .

entity:ds-dimer-CC-ji2026 a mlips:TrainingDataset ;
    rdfs:label "Dimer data set, charge-charge dimers (1/r decay)" ;
    mlips:coversMaterial entity:mat-dimer-CC-ji2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dimer-dft-ji2026 .

entity:ds-dimer-PP-ji2026 a mlips:TrainingDataset ;
    rdfs:label "Dimer data set, polar-polar dimers (1/r^3 decay)" ;
    mlips:coversMaterial entity:mat-dimer-PP-ji2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dimer-dft-ji2026 .

entity:ds-dimer-AA-ji2026 a mlips:TrainingDataset ;
    rdfs:label "Dimer data set, apolar-apolar dimers (1/r^6 decay)" ;
    mlips:coversMaterial entity:mat-dimer-AA-ji2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dimer-dft-ji2026 .

entity:ds-Au2-MgO-ji2026 a mlips:TrainingDataset ;
    rdfs:label "Au2 cluster on MgO(001) data set" ;
    mlips:coversMaterial entity:mat-Au2-MgO-ji2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Size and reference level were not captured from the parts read." .

entity:ds-Cu-BTA-ji2026 a mlips:TrainingDataset ;
    rdfs:label "Benzotriazole (BTA) on copper data set" ;
    mlips:coversMaterial entity:mat-Cu-BTA-ji2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Size and reference level were not captured from the parts read." .

entity:ds-Ag3-ji2026 a mlips:TrainingDataset ;
    rdfs:label "Ag3 clusters in two charge states (+/-) data set" ;
    mlips:coversMaterial entity:mat-Ag3-ji2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "11,013 configurations of Ag trimers in two charge states (Ko et al.)." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-dimer-CC-ji2026 mlips:samplingStrategy
    entity:sampling-dimer-separation-ji2026 .

entity:ds-dimer-PP-ji2026 mlips:samplingStrategy
    entity:sampling-dimer-separation-ji2026 .

entity:ds-dimer-AA-ji2026 mlips:samplingStrategy
    entity:sampling-dimer-separation-ji2026 .

entity:sampling-dimer-separation-ji2026 a mlips:SamplingStrategy ;
    rdfs:label "Dimer separation scan with long-range extrapolation split" ;
    rdfs:comment "Training set of ten configurations with intermolecular separations from about 5 to 12 A; test set of three configurations between 12 and 15 A." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CACE a mlips:MLIPMethod ;
    rdfs:label "Cartesian Atomic Cluster Expansion (CACE)" ;
    mlips:hasFunctionalForm entity:ff-CACE ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        entity:hp-radial-channels-ji2026 ,
        mlips:bodyOrder ,
        entity:hp-n-embedding-ji2026 ,
        mlips:numLayers .

entity:ff-CACE a mlips:FunctionalForm ;
    rdfs:label "Body-ordered atomic cluster expansion whose rotationally invariant features are built by symmetrising Cartesian angular basis functions, with optional message passing between atoms; atomic energies are summed to the total energy" .

entity:CACE-LES a mlips:MLIPMethod ;
    rdfs:label "CACE with latent Ewald summation (CACE-LES)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        entity:hp-radial-channels-ji2026 ,
        mlips:bodyOrder ,
        entity:hp-n-embedding-ji2026 ,
        mlips:numLayers ,
        entity:hp-latent-dim-ji2026 .

entity:CACE-SOG a mlips:MLIPMethod ;
    rdfs:label "CACE with sum-of-Gaussians long-range network (CACE-SOG)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        entity:hp-radial-channels-ji2026 ,
        mlips:bodyOrder ,
        entity:hp-n-embedding-ji2026 ,
        mlips:numLayers ,
        entity:hp-latent-dim-ji2026 ,
        entity:hp-num-gaussians-ji2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:hp-radial-channels-ji2026 a mlips:Hyperparameter ;
    rdfs:label "CACE number of radial channels c" ;
    mlips:hyperparameterName "c" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-n-embedding-ji2026 a mlips:Hyperparameter ;
    rdfs:label "CACE dimension of the element embedding N_embedding" ;
    mlips:hyperparameterName "N_embedding" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-num-gaussians-ji2026 a mlips:Hyperparameter ;
    rdfs:label "SOG-Net number of Gaussians M" ;
    mlips:hyperparameterName "M" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-latent-dim-ji2026 a mlips:Hyperparameter ;
    rdfs:label "Dimension P of the latent charge variable" ;
    mlips:hyperparameterName "P" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

