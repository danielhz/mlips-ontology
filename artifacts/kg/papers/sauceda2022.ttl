###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:BIGDML a mlips:MLIPMethod ;
    rdfs:label "BIGDML (Bravais-inspired gradient-domain machine learning for periodic materials)" ;
    mlips:hasLossFunction entity:loss-BIGDML-sauceda2022 ;
    mlips:hasTrainingAlgorithm entity:alg-BIGDML-sauceda2022 ;
    mlips:hasImplementation entity:impl-BIGDML-sauceda2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:NudgedElasticBand .

entity:loss-BIGDML-sauceda2022 a mlips:LossFunction ;
    rdfs:label "Gradient-domain Gaussian process on forces with energy integration" .

entity:alg-BIGDML-sauceda2022 a mls:Algorithm ;
    rdfs:label "Closed-form kernel regression with periodic Coulomb-matrix descriptor and Bravais/translational permutation symmetries" .

entity:impl-BIGDML-sauceda2022 a mlips:Implementation ;
    mlips:implementedIn entity:lib-sGDML-sauceda2022 .

entity:lib-sGDML-sauceda2022 a mlips:Library ;
    rdfs:label "sGDML" ;
    mlips:candidateForVocabulary mlips:Library .

