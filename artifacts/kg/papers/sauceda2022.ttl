entity:calc-settings-aims-sauceda2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "All-electron PBE with many-body dispersion (MBD)" .

