# Canonical Turtle for the protocol-derived encoding of:
#   Natascia L. Fragapane et al. (2026). Amorphous materials as a frontier challenge for universal interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2607.11384  arXiv:2607.11384v1
#
# Version read: arxiv-preprint arXiv:2607.11384v1 (sha256 7aee28ea9b219f88...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 656 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/fragapane2026amorphous.yaml.
#
# Encoding scope: the AM26 benchmark data set introduced in the paper, the
# zero-shot MACE-MP-0b3 used as the fine-tuning case study, and the
# MACE-MP-0b3 models fine-tuned on new a-SiO2, a-C and a-GST data. The 41
# pre-trained universal MLIPs are ranked by relative RMSEs shown only in
# figures; fine-tuning errors are also figure-only or approximate, so
# there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-fragapane2026amorphous a mlips:BenchmarkStudy ;
    rdfs:label "Fragapane and Deringer (2026): amorphous materials as a frontier challenge for universal interatomic potentials (AM26 benchmark)" ;
    mlips:reportedIn entity:article-fragapane2026amorphous .

entity:article-fragapane2026amorphous a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2607.11384> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Amorphous materials as a frontier challenge for universal interatomic potentials" ;
    schema:author entity:person-Fragapane-fragapane2026amorphous ,
        entity:person-Deringer-fragapane2026amorphous .

entity:person-Fragapane-fragapane2026amorphous a schema:Person ;
    schema:name "Natascia L. Fragapane" ;
    schema:givenName "Natascia L." ;
    schema:familyName "Fragapane" .

entity:person-Deringer-fragapane2026amorphous a schema:Person ;
    schema:name "Volker L. Deringer" ;
    schema:givenName "Volker L." ;
    schema:familyName "Deringer" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-a-c-fragapane2026amorphous a mlips:MaterialSystem ;
    rdfs:label "Amorphous carbon (1.5-3.5 g/cm3)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "amorphous elemental solid" .

entity:mat-a-si-fragapane2026amorphous a mlips:MaterialSystem ;
    rdfs:label "Amorphous silicon" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "amorphous elemental solid" .

entity:mat-a-sio2-fragapane2026amorphous a mlips:MaterialSystem ;
    rdfs:label "Amorphous silica (quench rates 1e11-1e14 K/s)" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "oxide glass" .

entity:mat-a-gst-fragapane2026amorphous a mlips:MaterialSystem ;
    rdfs:label "Amorphous Ge-Sb-Te along the GeTe-Sb2Te3 tie-line" ;
    mlips:materialClass "phase-change chalcogenide glass" .

entity:mat-a-lips-fragapane2026amorphous a mlips:MaterialSystem ;
    rdfs:label "Amorphous Li-P-S along the Li2S-P2S5 tie-line" ;
    mlips:materialClass "sulfide glass electrolyte" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-fragapane2026amorphous a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-fragapane2026amorphous mlips:hasDFTSettings entity:calc-settings-pbe-fragapane2026amorphous .

entity:calc-settings-pbe-fragapane2026amorphous a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    rdfs:comment "VASP 6.4.3 with MPStaticSet (Materials Project defaults) and PBE 5.4 pseudopotentials; energies converged to 5e-5 eV/atom." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-am26-fragapane2026amorphous a mlips:TrainingDataset ;
    rdfs:label "AM26 amorphous benchmark (934 cells, 197,996 atoms: a-C, a-Si, a-SiO2, a-GST, a-LiPS)" ;
    mlips:coversMaterial entity:mat-a-c-fragapane2026amorphous ,
        entity:mat-a-si-fragapane2026amorphous ,
        entity:mat-a-sio2-fragapane2026amorphous ,
        entity:mat-a-gst-fragapane2026amorphous ,
        entity:mat-a-lips-fragapane2026amorphous ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 934 ;
    mlips:hasDFTCalculation entity:calc-pbe-fragapane2026amorphous .

entity:ds-ft-sio2-fragapane2026amorphous a mlips:TrainingDataset ;
    rdfs:label "Independent a-SiO2 fine-tuning structures (melt-quench, all quench rates)" ;
    mlips:coversMaterial entity:mat-a-sio2-fragapane2026amorphous ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-fragapane2026amorphous .

entity:ds-ft-c-fragapane2026amorphous a mlips:TrainingDataset ;
    rdfs:label "Independent a-C fine-tuning structures" ;
    mlips:coversMaterial entity:mat-a-c-fragapane2026amorphous ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-fragapane2026amorphous .

entity:ds-ft-gst-fragapane2026amorphous a mlips:TrainingDataset ;
    rdfs:label "Independent a-GST fine-tuning structures" ;
    mlips:coversMaterial entity:mat-a-gst-fragapane2026amorphous ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-fragapane2026amorphous .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-am26-fragapane2026amorphous mlips:samplingStrategy
    entity:sampling-mq-fragapane2026amorphous .

entity:ds-ft-sio2-fragapane2026amorphous mlips:samplingStrategy
    entity:sampling-mq-fragapane2026amorphous .

entity:ds-ft-c-fragapane2026amorphous mlips:samplingStrategy
    entity:sampling-mq-fragapane2026amorphous .

entity:ds-ft-gst-fragapane2026amorphous mlips:samplingStrategy
    entity:sampling-mq-fragapane2026amorphous .

entity:sampling-mq-fragapane2026amorphous a mlips:SamplingStrategy ;
    rdfs:label "Melt-quench MD with specialist potentials (C-GAP-17, SiOx-ACE-24, Li-P-S model of Ref. 36) and published a-Si and GST-GAP-22 structures, relabelled with DFT" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

