@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wu2026 a mlips:BenchmarkStudy ;
    rdfs:label "Wu et al. (2026): entropic control of O3/P2 stacking preference in Na-ion layered oxide cathodes via fine-tuned CHGNet" ;
    mlips:reportedIn entity:article-wu2026 .

