###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbeu-wu2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbeu-wu2026 mlips:hasDFTSettings entity:calc-settings-pbeu-wu2026 .

entity:calc-settings-pbeu-wu2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-D3-U-wu2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "2x3x2 (O3) and 2x3x1 (P2) Monkhorst-Pack; Gamma point for AIMD" ;
    rdfs:comment "Spin-polarised PBE+U (U = 6.2, 5.3, 3.32, 3.9, 5.10 eV for Ni, Fe, Co, Mn, Ti, Materials Project values) with Grimme D3; _pv pseudopotentials for Na, Ni, Fe, Mn, Ti." .

entity:xc-PBE-D3-U-wu2026 a mlips:XCFunctional ;
    rdfs:label "PBE-D3+U" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ft-wu2026 a mlips:TrainingDataset ;
    rdfs:label "CHGNet fine-tuning data: 6000 AIMD frames (80:10:10 train/validation/test)" ;
    mlips:coversMaterial entity:mat-he-wu2026 ,
        entity:mat-le-wu2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 6000 ;
    mlips:hasDFTCalculation entity:calc-pbeu-wu2026 .

entity:ds-indep-wu2026 a mlips:TrainingDataset ;
    rdfs:label "Independent test set: 700 AIMD frames from 28 conformations not used in fine-tuning" ;
    mlips:coversMaterial entity:mat-he-wu2026 ,
        entity:mat-le-wu2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 700 ;
    mlips:hasDFTCalculation entity:calc-pbeu-wu2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ft-wu2026 mlips:samplingStrategy
    entity:sampling-aimd-wu2026 .

entity:ds-indep-wu2026 mlips:samplingStrategy
    entity:sampling-aimd-indep-wu2026 .

entity:sampling-aimd-wu2026 a mlips:SamplingStrategy ;
    rdfs:label "First 500 steps of twelve 600 K NVT AIMD runs (2 fs) on three GOAC-screened conformations each of O3-HE, P2-HE, O3-LE and P2-LE" .

entity:sampling-aimd-indep-wu2026 a mlips:SamplingStrategy ;
    rdfs:label "25-step AIMD runs on the 28 remaining GOAC conformations" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasTrainingAlgorithm entity:alg-CHGNet-wu2026 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:GeometryOptimization .

entity:alg-CHGNet-wu2026 a mls:Algorithm ;
    rdfs:label "CosineAnnealingLR schedule from 0.01 to 1e-4" .

