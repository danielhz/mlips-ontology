###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-he-wu2026 a mlips:MaterialSystem ;
    rdfs:label "High-entropy O3- and P2-type Na0.8Ni0.2Fe0.2Co0.2Mn0.2Ti0.2O2" ;
    mlips:chemicalFormula "Na0.8Ni0.2Fe0.2Co0.2Mn0.2Ti0.2O2" ;
    mlips:materialClass "layered oxide cathode (Na-ion)" .

entity:mat-le-wu2026 a mlips:MaterialSystem ;
