<https://orcid.org/0000-0002-4458-6598> schema:affiliation entity:org-CaliforniaInstituteofTechnology-bartok2010 .
<https://orcid.org/0000-0002-4458-6598> schema:affiliation mlips:UniversityofCambridge .
<https://orcid.org/0000-0002-8180-2034> schema:affiliation mlips:UniversityofCambridge .

entity:org-CaliforniaInstituteofTechnology-bartok2010 a schema:Organization ;
    rdfs:label "California Institute of Technology" ;
    schema:name "California Institute of Technology" ;
    schema:identifier <https://ror.org/05dxps055> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .
