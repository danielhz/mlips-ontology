# Canonical Turtle for the protocol-derived encoding of:
#   Bartok, Payne, Kondor, Csanyi. Gaussian Approximation Potentials:
#   The Accuracy of Quantum Mechanics, without the Electrons.
#   Phys. Rev. Lett. 104, 136403 (2010).
#   doi:10.1103/PhysRevLett.104.136403  arXiv:0910.1019
#
# Encoding scope: the original GAP method, demonstrated on bulk
# semiconductors (C, Si, Ge), GaN, and alpha-Fe. We encode silicon
# (the diamond-cubic lead demonstration system) and document the
# broader set in Q12. Specific DFT settings beyond the engine
# (CASTEP) are stated in the Supplementary Information rather than
# the main letter; only main-letter facts are encoded.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bartok2010 a mlips:BenchmarkStudy ;
    rdfs:label "Bartok et al. (2010): GAP for bulk crystals (Si as lead system)" ;
    mlips:reportedIn entity:article-bartok2010 .

entity:article-bartok2010 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/PhysRevLett.104.136403> ;
    schema:datePublished "2010"^^xsd:gYear ;
    schema:name "Gaussian Approximation Potentials: The Accuracy of Quantum Mechanics, without the Electrons" ;
    schema:author
        <https://orcid.org/0000-0002-4347-8819> ,
        <https://orcid.org/0000-0002-5250-8549> ,
        <https://orcid.org/0000-0002-4458-6598> ,
        <https://orcid.org/0000-0002-8180-2034> .

<https://orcid.org/0000-0002-4347-8819> a schema:Person ;
    schema:name "Albert P. Bartók" ;
    schema:givenName "Albert P." ;
    schema:familyName "Bartók" ;
    schema:identifier <https://orcid.org/0000-0002-4347-8819> .
<https://orcid.org/0000-0002-5250-8549> a schema:Person ;
    schema:name "Mike C. Payne" ;
    schema:givenName "Mike C." ;
    schema:familyName "Payne" ;
    schema:identifier <https://orcid.org/0000-0002-5250-8549> .
<https://orcid.org/0000-0002-4458-6598> a schema:Person ;
    schema:name "Risi Kondor" ;
    schema:givenName "Risi" ;
    schema:familyName "Kondor" ;
    schema:identifier <https://orcid.org/0000-0002-4458-6598> .
<https://orcid.org/0000-0002-8180-2034> a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" ;
    schema:identifier <https://orcid.org/0000-0002-8180-2034> .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Si-bartok2010 a mlips:MaterialSystem ;
    rdfs:label "Bulk silicon (diamond-cubic phase, lead demonstration system)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental crystalline solid; diamond-cubic phase as the lead demonstration system. The paper also demonstrates GAP on diamond (carbon), germanium, GaN, and alpha-Fe." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q670> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-bartok2010 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-bartok2010 mlips:hasDFTSettings entity:dft-settings-bartok2010 .

entity:dft-settings-bartok2010 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:CASTEP .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Si-bartok2010 a mlips:TrainingDataset ;
    rdfs:label "Si GAP training set: random atomic and lattice displacements (up to 0.2 A) of equilibrium unit cells of 2, 8, 16, and 64 atoms" ;
    mlips:coversMaterial entity:mat-Si-bartok2010 ;
    mlips:coversProperty mlips:Energy , mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:dft-bartok2010 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Si-bartok2010 mlips:samplingStrategy entity:displacement-sampling-bartok2010 .

entity:displacement-sampling-bartok2010 a mlips:SamplingStrategy ;
    rdfs:label "Random atomic and lattice displacements" ;
    rdfs:comment "Reference configurations are obtained by randomly displacing the atoms and the lattice vectors from their equilibrium values in 2-, 8-, 16-, and 64-atom cubic unit cells by up to 0.2 A. The model is later extended with random displacements around a diamond vacancy and a graphite-to-diamond transition path." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP-bartok2010 a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential (GAP) with bispectrum descriptors" ;
    mlips:hasFunctionalForm entity:gap-functional-form-bartok2010;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:gap-loss-bartok2010 ;
    mlips:hasTrainingAlgorithm entity:gpr-bartok2010 ;
    mlips:hasHyperparameter mlips:cutoffRadius , entity:hp-jmax-bartok2010 , mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-gap-bartok2010 .

entity:gap-functional-form-bartok2010 a mlips:FunctionalForm ;
    rdfs:label "Gaussian-process regression on a four-dimensional bispectrum descriptor of the atomic neighbour density inside a smooth cosine cutoff; total energy is the sum over atoms" .

entity:gap-loss-bartok2010 a mlips:LossFunction ;
    rdfs:label "GP regression with regularised pseudo-covariance on energies and forces (sparse-GP marginal-likelihood objective)" .

entity:gpr-bartok2010 a mls:Algorithm ;
    rdfs:label "Sparse Gaussian-process regression with random selection of M sparse atomic-neighbourhood configurations" .

entity:impl-gap-bartok2010 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# Q8 has no HyperparameterSetting instances: the main letter does not
# tabulate explicit numerical values for r_cut, J_max, or M (these
# are reported in the SI and are taken to be paper-default).

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-gap-Si-bartok2010 a mlips:MLIPRun ;
    rdfs:label "GAP training run, bulk silicon" ;
    mlips:appliesMethod entity:GAP-bartok2010 ;
    mlips:runsOn entity:ds-Si-bartok2010 ;
    mlips:produces entity:model-gap-Si-bartok2010 .

entity:model-gap-Si-bartok2010 a mlips:TrainedModel ;
    rdfs:label "GAP for bulk silicon (diamond-cubic)" ;
    mlips:inferenceTimePerAtom 0.01 .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-bartok2010 mlips:hasResult entity:result-gap-Si-energy-bartok2010 .

entity:result-gap-Si-energy-bartok2010 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-Si-bartok2010 ;
    mlips:targetMaterial entity:mat-Si-bartok2010 ;
    mlips:hasAccuracyMetric entity:metric-rmse-energy-bartok2010 .

entity:metric-rmse-energy-bartok2010 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE on near-bulk Si configurations (paper bound: <1 meV/atom; the same bound holds for diamond and iron)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1"^^xsd:double ;
    mlips:hasUnit unit:MeV-PER-ATOM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Captured in Q9 (model) where the predicates allow it:
#   - mlips:inferenceTimePerAtom = 0.01 (s/atom/timestep, single CPU core)
# The paper does not report training duration, GPU/CPU hours,
# training hardware, peak memory, or inference hardware.

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-jmax-bartok2010 a mlips:Hyperparameter ;
    rdfs:label "GAP bispectrum truncation Jmax" ;
    mlips:hyperparameterName "j_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

