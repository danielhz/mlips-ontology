###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:TACE a mlips:MLIPMethod ;
    rdfs:label "TACE (tensor atomic cluster expansion in Cartesian space)" ;
    mlips:hasHyperparameter mlips:numFeatures ,
        entity:hp-correlation-order-xu2025spectral ,
        entity:hp-Lmax-xu2025spectral ;
    mlips:hasImplementation entity:impl-TACE-xu2025spectral ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:impl-TACE-xu2025spectral a mlips:Implementation ;
    mlips:implementedIn entity:lib-TACE-xu2025spectral .

entity:lib-TACE-xu2025spectral a mlips:Library ;
    rdfs:label "TACE" ;
    rdfs:comment "Implementation of the paper; details in the Methods and SI" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-correlation-order-xu2025spectral a mlips:Hyperparameter ;
    rdfs:label "ACE correlation order of the product basis" ;
    mlips:hyperparameterName "correlation order" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-Lmax-xu2025spectral a mlips:Hyperparameter ;
    rdfs:label "Maximum rank Lmax of the irreducible Cartesian tensor features" ;
    mlips:hyperparameterName "Lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

