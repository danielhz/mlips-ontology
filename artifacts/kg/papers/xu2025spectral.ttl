# Canonical Turtle for the protocol-derived encoding of:
#   Zemin Xu et al. (2025). Spectral/Spatial Tensor Atomic Cluster Expansion with Universal Embeddings in Cartesian Space.
#   arXiv (Cornell University). doi:10.48550/arxiv.2509.14961  arXiv:2509.14961v3
#
# Version read: arxiv-preprint arXiv:2509.14961v3 (sha256 c397b632e82ce6a9...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 215 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/xu2025spectral.yaml.
#
# Encoding scope: TACE (introduced here) with its tabulated energy and force
# errors: four TACE variants on 3BPA (Table 1), the 32-molecule water
# system (Table 2), the GAP17 carbon set (Table 4), the field-embedded
# FITACE on BaTiO3 (Table 5, energy and force only), four charged systems
# (Table 6) and MatPES-PBE (Table 10). Dipole and polarisability errors
# (Table 3), the multi-fidelity study (Fig. 2), adsorption geometries and
# reaction barriers (Tables 7-9) and values of other models quoted from the
# literature are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-xu2025spectral a mlips:BenchmarkStudy ;
    rdfs:label "Xu, Xie and Hu (2025): tensor atomic cluster expansion (TACE) in Cartesian space" ;
    mlips:reportedIn entity:article-xu2025spectral .

entity:article-xu2025spectral a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2509.14961> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Spectral/Spatial Tensor Atomic Cluster Expansion with Universal Embeddings in Cartesian Space" ;
    schema:author entity:person-Xu-xu2025spectral ,
        entity:person-Xie-xu2025spectral ,
        entity:person-Hu-xu2025spectral .

entity:person-Xu-xu2025spectral a schema:Person ;
    schema:name "Zemin Xu" ;
    schema:givenName "Zemin" ;
    schema:familyName "Xu" .

entity:person-Xie-xu2025spectral a schema:Person ;
    schema:name "Wenbo Xie" ;
    schema:givenName "Wenbo" ;
    schema:familyName "Xie" .

entity:person-Hu-xu2025spectral a schema:Person ;
    schema:name "P. Hu" ;
    schema:givenName "P." ;
    schema:familyName "Hu" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-3BPA-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "3-(benzyloxy)pyridin-2-amine (3BPA) molecule" ;
    mlips:materialClass "Flexible drug-like organic molecule (gas phase)" .

entity:mat-water-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "Liquid water (32-molecule system)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-carbon-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "Carbon allotropes (GAP17 data set)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental solid and liquid carbon" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q623> .

entity:mat-BaTiO3-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "Barium titanate under external electric fields" ;
    mlips:chemicalFormula "BaTiO3" ;
    mlips:materialClass "Ferroelectric perovskite" .

entity:mat-C10H2-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "C10H2 / C10H3+ carbon chains (neutral and positively charged)" ;
    mlips:materialClass "Charged system (Ko et al. benchmark)" .

entity:mat-Ag3-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "Ag3 trimers with total charge +1 and -1" ;
    mlips:materialClass "Charged system (Ko et al. benchmark)" .

entity:mat-NaCl-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "Na8/9Cl8+ ionic clusters" ;
    mlips:materialClass "Charged system (Ko et al. benchmark)" .

entity:mat-AuMgO-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "Au2 cluster on a MgO(001) slab" ;
    mlips:materialClass "Charged system (Ko et al. benchmark)" .

entity:mat-matpes-xu2025spectral a mlips:MaterialSystem ;
    rdfs:label "Inorganic materials of MatPES-PBE" ;
    mlips:materialClass "Inorganic crystalline materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-bpa-xu2025spectral a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-bpa-xu2025spectral mlips:hasDFTSettings entity:calc-settings-bpa-xu2025spectral .

entity:calc-settings-bpa-xu2025spectral a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "3BPA configurations reevaluated at wB97X/6-31G(d) (Sec. 2.4)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-3BPA-xu2025spectral a mlips:TrainingDataset ;
    rdfs:label "3BPA training set at 300 K" ;
    mlips:coversMaterial entity:mat-3BPA-xu2025spectral ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-bpa-xu2025spectral .

entity:ds-water-xu2025spectral a mlips:TrainingDataset ;
    rdfs:label "32-water data set (Refs. [15, 43])" ;
    mlips:coversMaterial entity:mat-water-xu2025spectral ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-gap17-xu2025spectral a mlips:TrainingDataset ;
    rdfs:label "GAP17 carbon data set" ;
    mlips:coversMaterial entity:mat-carbon-xu2025spectral ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-batio3-xu2025spectral a mlips:TrainingDataset ;
    rdfs:label "BaTiO3 data set of Allegro-pol (59 zero-field MD frames)" ;
    mlips:coversMaterial entity:mat-BaTiO3-xu2025spectral ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 59 ;
    rdfs:comment "Also polarisation, polarisability and Born effective charges." .

entity:ds-chg-C10H2-xu2025spectral a mlips:TrainingDataset ;
    rdfs:label "Charged-system data set of Ko et al.: C10H2 / C10H3+ carbon chains (neutral and positively charged)" ;
    mlips:coversMaterial entity:mat-C10H2-xu2025spectral ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Charges also used as labels." .

entity:ds-chg-Ag3-xu2025spectral a mlips:TrainingDataset ;
    rdfs:label "Charged-system data set of Ko et al.: Ag3 trimers with total charge +1 and -1" ;
