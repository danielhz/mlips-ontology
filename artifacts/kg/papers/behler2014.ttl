@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-behler2014 a mlips:BenchmarkStudy ;
    rdfs:label "Behler (2014): representing potential energy surfaces by high-dimensional neural network potentials (topical review)" ;
    mlips:reportedIn entity:article-behler2014 .

entity:article-behler2014 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/0953-8984/26/18/183001> ;
    schema:datePublished "2014"^^xsd:gYear ;
    schema:name "Representing potential energy surfaces by high-dimensional neural network potentials" ;
    schema:author entity:person-Behler-behler2014 .

entity:person-Behler-behler2014 a schema:Person ;
    schema:name "J Behler" ;
    schema:givenName "J" ;
    schema:familyName "Behler" .

