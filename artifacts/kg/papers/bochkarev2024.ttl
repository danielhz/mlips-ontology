    rdfs:label "Configurations from ab initio molecular dynamics (MD17)" ;
    rdfs:comment "1,000 (or 50) training configurations drawn at random per molecule; the remaining 99,000 used for testing (Sec. IX B, Table I)." .

entity:sampling-bpa-300K-bochkarev2024 a mlips:SamplingStrategy ;
    rdfs:label "3BPA training configurations from ab initio MD at 300 K" ;
    rdfs:comment "Test sets: MD at 300 K, 600 K and 1200 K, and relaxed dihedral slices (Sec. IX B)." .

entity:sampling-si-random-bochkarev2024 a mlips:SamplingStrategy ;
    rdfs:label "Randomised four-atom Si clusters" ;
    rdfs:comment "Unrelaxed clusters with completely randomised positions, all interatomic distances below 8 A (Sec. IX A)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:hasLossFunction entity:loss-GRACE-bochkarev2024 ;
    mlips:hasTrainingAlgorithm entity:alg-GRACE-bochkarev2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-lmax-bochkarev2024 ,
        entity:hp-nmax-bochkarev2024 ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-GRACE-bochkarev2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:loss-GRACE-bochkarev2024 a mlips:LossFunction ;
    rdfs:label "Weighted sum of squared energy and force errors with L2 regularisation of the expansion coefficients (Eqs. C4, C5)" .

entity:alg-GRACE-bochkarev2024 a mls:Algorithm ;
    rdfs:label "L-BFGS-B (scipy); for carbon the AMSGrad variant of Adam followed by L-BFGS-B" .

entity:impl-GRACE-bochkarev2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-tensorpotential-bochkarev2024 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-bochkarev2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        entity:hp-lmax-bochkarev2024 ,
        mlips:learningRate ,
        mlips:batchSize .

entity:alg-MACE-bochkarev2024 a mls:Algorithm ;
    rdfs:label "AMSGrad variant of Adam" .

entity:lib-tensorpotential-bochkarev2024 a mlips:Library ;
    rdfs:label "tensorpotential" ;
    rdfs:comment "TensorFlow implementation of ACE(g) fitting and evaluation, double precision; MD through a LAMMPS pair style calling the TensorFlow graph on the GPU" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-lmax-bochkarev2024 a mlips:Hyperparameter ;
    rdfs:label "Maximum angular momentum lmax of the atomic base and intermediate couplings" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-nmax-bochkarev2024 a mlips:Hyperparameter ;
    rdfs:label "Number of radial basis functions nmax" ;
    mlips:hyperparameterName "nmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

