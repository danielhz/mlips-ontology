# Canonical Turtle for the protocol-derived encoding of:
#   Jeff Armstrong et al. (2026). High-Pressure Inelastic Neutron Spectroscopy: Experimental Validation of Machine-Learned Interatomic Potential Energy Landscapes.
#   The Journal of Physical Chemistry Letters. doi:10.1021/acs.jpclett.6c00720  arXiv:2603.05442v1
#
# Version read: arxiv-preprint arXiv:2603.05442v1 (sha256 6541b29d46e39076...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 449 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/armstrong2026.yaml.
#
# Encoding scope: the VASP training data for crystalline
# 2,5-diiodothiophene (geometry optimisation, volume scans, NPT MD at
# 0-2 GPa, non-diagonal 288-atom supercells; 1,412/176/176 split) at
# PBE-D3(BJ) and, for a subset, r2SCAN-D4, the three fine-tuned MACE
# models (naive fine-tune of mace_mp_0b3; multihead fine-tunes of
# mace_omat-0 and MACE-MH-1) with the fitting RMSEs of SI S4.2, and
# MACE-POLAR-1-L as a comparison. INS spectra, lattice parameters and MD
# validations are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-armstrong2026 a mlips:BenchmarkStudy ;
    rdfs:label "Armstrong et al. (2026): high-pressure inelastic neutron spectroscopy of 2,5-diiodothiophene as an experimental test of fine-tuned MACE potentials" ;
    mlips:reportedIn entity:article-armstrong2026 .

entity:article-armstrong2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpclett.6c00720> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "High-Pressure Inelastic Neutron Spectroscopy: Experimental Validation of Machine-Learned Interatomic Potential Energy Landscapes" ;
    schema:author <https://orcid.org/0000-0002-8326-3097> ,
        <https://orcid.org/0000-0001-5272-6530> ,
        entity:person-Elena-armstrong2026 .

<https://orcid.org/0000-0002-8326-3097> a schema:Person ;
    schema:name "Jeff Armstrong" ;
    schema:givenName "Jeff" ;
    schema:familyName "Armstrong" ;
    schema:identifier <https://orcid.org/0000-0002-8326-3097> .

<https://orcid.org/0000-0001-5272-6530> a schema:Person ;
    schema:name "Adam Jackson" ;
    schema:givenName "Adam" ;
    schema:familyName "Jackson" ;
    schema:identifier <https://orcid.org/0000-0001-5272-6530> .

entity:person-Elena-armstrong2026 a schema:Person ;
    schema:name "Alin Elena" ;
    schema:givenName "Alin" ;
    schema:familyName "Elena" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-dit-armstrong2026 a mlips:MaterialSystem ;
    rdfs:label "Crystalline 2,5-diiodothiophene at 0-2 GPa" ;
    mlips:chemicalFormula "C4H2I2S" ;
    mlips:materialClass "Organic molecular crystal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbed3-armstrong2026 a mlips:DFTCalculation .

entity:calc-r2scand4-armstrong2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbed3-armstrong2026 mlips:hasDFTSettings entity:calc-settings-pbed3-armstrong2026 .

entity:calc-settings-pbed3-armstrong2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "0.2 1/A spacing, off Gamma" ;
    rdfs:comment "PBE-D3(BJ), Gaussian smearing 0.01 eV, MPtrj-compatible settings (SI S3.1)." .

entity:calc-r2scand4-armstrong2026 mlips:hasDFTSettings entity:calc-settings-r2scand4-armstrong2026 .

entity:calc-settings-r2scand4-armstrong2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-D4-armstrong2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "680"^^xsd:double ;
    rdfs:comment "MatPES-compatible r2SCAN settings with a D4 correction (SI S3.1)." .

entity:xc-r2SCAN-D4-armstrong2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN-D4" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-pbe-armstrong2026 a mlips:TrainingDataset ;
    rdfs:label "PBE-D3 fine-tuning data (1,412 training, 176 validation, 176 test)" ;
    mlips:coversMaterial entity:mat-dit-armstrong2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1412 ;
    mlips:hasDFTCalculation entity:calc-pbed3-armstrong2026 .

entity:ds-pbe-sub-armstrong2026 a mlips:TrainingDataset ;
    rdfs:label "PBE-D3 subset used for the multihead fine-tune (1,068 training, 133 validation/test)" ;
    mlips:coversMaterial entity:mat-dit-armstrong2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1068 ;
    mlips:hasDFTCalculation entity:calc-pbed3-armstrong2026 .

entity:ds-r2scan-armstrong2026 a mlips:TrainingDataset ;
    rdfs:label "r2SCAN-D4 relabelling of the 1,068-structure subset" ;
    mlips:coversMaterial entity:mat-dit-armstrong2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1068 ;
    mlips:hasDFTCalculation entity:calc-r2scand4-armstrong2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-pbe-armstrong2026 mlips:samplingStrategy
    entity:sampling-ft-armstrong2026 .

entity:ds-pbe-sub-armstrong2026 mlips:samplingStrategy
    entity:sampling-ft-armstrong2026 .

entity:ds-r2scan-armstrong2026 mlips:samplingStrategy
    entity:sampling-ft-armstrong2026 .

entity:sampling-ft-armstrong2026 a mlips:SamplingStrategy ;
    rdfs:label "DFT geometry-optimisation frames (> 50 meV apart), +-10 % volume scans, 300 K NPT MD at 0-2 GPa with MACE-descriptor farthest-point selection, and NPT MD of non-diagonal 288-atom supercells" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-armstrong2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:impl-MACE-armstrong2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:MACE-POLAR a mlips:MLIPMethod ;
    rdfs:label "MACE-POLAR (polarizable MACE with an explicit long-range electrostatic term conditioned on total charge and spin multiplicity)" ;
    mlips:supportsSimulation mlips:PhononCalculation .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ft-pbe-learningRate-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.005"^^xsd:double .

entity:setting-ft-pbe-batchSize-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-ft-pbe-numEpochs-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "2000"^^xsd:integer .

entity:setting-ft-r2scan-learningRate-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-ft-r2scan-batchSize-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-ft-r2scan-numEpochs-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-ft-mh1-learningRate-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-ft-mh1-batchSize-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-ft-mh1-numEpochs-armstrong2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "10"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mp0b3-armstrong2026 a mlips:MLIPRun ;
    rdfs:label "mace_mp_0b3 as distributed (size not stated)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mp0b3-armstrong2026 .

entity:model-mp0b3-armstrong2026 a mlips:TrainedModel ;
    rdfs:label "mace_mp_0b3" .

entity:run-omat0-armstrong2026 a mlips:MLIPRun ;
    rdfs:label "mace_omat-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-omat0-armstrong2026 .

entity:model-omat0-armstrong2026 a mlips:TrainedModel ;
    rdfs:label "mace_omat-0" .

entity:run-mh1-armstrong2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MH-1 (omat_pbe head) as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mh1-armstrong2026 .

entity:model-mh1-armstrong2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MH-1 (omat_pbe head)" .

entity:run-ft-pbe-armstrong2026 a mlips:MLIPRun ;
    rdfs:label "FT-PBE-D3: naive fine-tune of mace_mp_0b3 on the PBE-D3 data" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-pbe-armstrong2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-pbe-learningRate-armstrong2026 ,
        entity:setting-ft-pbe-batchSize-armstrong2026 ,
        entity:setting-ft-pbe-numEpochs-armstrong2026 ;
    mlips:trainingHardware "NVIDIA A100 (about 20 s per epoch)" ;
    mlips:produces entity:model-ft-pbe-armstrong2026 .

entity:model-ft-pbe-armstrong2026 a mlips:TrainedModel ;
    rdfs:label "FT-PBE-D3 (2,5-diiodothiophene)" .

entity:run-ft-r2scan-armstrong2026 a mlips:MLIPRun ;
    rdfs:label "FT-R2SCAN-D4: multihead fine-tune of mace_omat-0 on r2SCAN-D4 data (MP/OMAT replay)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-r2scan-armstrong2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-r2scan-learningRate-armstrong2026 ,
        entity:setting-ft-r2scan-batchSize-armstrong2026 ,
        entity:setting-ft-r2scan-numEpochs-armstrong2026 ;
    mlips:trainingHardware "4 NVIDIA A100 (1 h 18 min per epoch)" ;
    mlips:produces entity:model-ft-r2scan-armstrong2026 .

entity:model-ft-r2scan-armstrong2026 a mlips:TrainedModel ;
    rdfs:label "FT-R2SCAN-D4 (2,5-diiodothiophene)" .

entity:run-ft-mh1-armstrong2026 a mlips:MLIPRun ;
    rdfs:label "FT-MH-1-PBE-D3: multihead fine-tune of MACE-MH-1 (omat_pbe head) on PBE-D3 data with 30,000 MP replay structures" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-pbe-sub-armstrong2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-mh1-learningRate-armstrong2026 ,
        entity:setting-ft-mh1-batchSize-armstrong2026 ,
        entity:setting-ft-mh1-numEpochs-armstrong2026 ;
    mlips:trainingHardware "4 NVIDIA A100 (56 min per epoch)" ;
    mlips:produces entity:model-ft-mh1-armstrong2026 .

entity:model-ft-mh1-armstrong2026 a mlips:TrainedModel ;
    rdfs:label "FT-MH-1-PBE-D3 (2,5-diiodothiophene)" .

entity:run-polar-armstrong2026 a mlips:MLIPRun ;
    rdfs:label "MACE-POLAR-1-L as distributed" ;
    mlips:appliesMethod entity:MACE-POLAR ;
    mlips:produces entity:model-polar-armstrong2026 .

entity:model-polar-armstrong2026 a mlips:TrainedModel ;
