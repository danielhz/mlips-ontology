# Canonical Turtle for the protocol-derived encoding of:
#   Yuto Iwasaki et al. (2026). Cluster-based Structural Similarity for Dataset Visualization and Data Selection for Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2609.39984  arXiv:2609.39984v1
#
# Version read: arxiv-preprint arXiv:2609.39984v1 (sha256 c93ba2e79f917300...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 659 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/iwasaki2026.yaml.
#
# Encoding scope: the GAP models (Turbo-GAP) trained on training sets
# selected by farthest-point sampling with data-wise, atom-wise and
# (distribution-aware) cluster-wise similarity, or randomly, from a 64-atom
# amorphous-carbon pool and a Ge-Sb-Te pool. Learning-curve RMSEs are
# shown only in figures, so there are no results; the similarity metrics
# themselves are data-analysis tools.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-iwasaki2026 a mlips:BenchmarkStudy ;
    rdfs:label "Iwasaki and Caro (2026): cluster-based structural similarity for data-set visualisation and data selection for MLIPs" ;
    mlips:reportedIn entity:article-iwasaki2026 .

entity:article-iwasaki2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2609.39984> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Cluster-based Structural Similarity for Dataset Visualization and Data Selection for Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Iwasaki-iwasaki2026 ,
        entity:person-Caro-iwasaki2026 .

entity:person-Iwasaki-iwasaki2026 a schema:Person ;
    schema:name "Yuto Iwasaki" ;
    schema:givenName "Yuto" ;
    schema:familyName "Iwasaki" .

entity:person-Caro-iwasaki2026 a schema:Person ;
    schema:name "Miguel A. Caro" ;
    schema:givenName "Miguel A." ;
    schema:familyName "Caro" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-a-c-iwasaki2026 a mlips:MaterialSystem ;
    rdfs:label "Amorphous carbon, 64-atom cells" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "amorphous elemental solid" .

entity:mat-gst-iwasaki2026 a mlips:MaterialSystem ;
    rdfs:label "Ge-Sb-Te structures of 351-363 atoms with varying composition" ;
    mlips:materialClass "phase-change chalcogenide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ac-ref-iwasaki2026 a mlips:DFTCalculation .

entity:calc-gst-ref-iwasaki2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ac-ref-iwasaki2026 mlips:hasDFTSettings entity:calc-settings-ac-ref-iwasaki2026 .

entity:calc-settings-ac-ref-iwasaki2026 a mlips:DFTSettings ;
    rdfs:comment "Published amorphous-carbon data set labels (Ref. 3); not restated." .

entity:calc-gst-ref-iwasaki2026 mlips:hasDFTSettings entity:calc-settings-gst-ref-iwasaki2026 .

entity:calc-settings-gst-ref-iwasaki2026 a mlips:DFTSettings ;
    rdfs:comment "Published GST data set labels (Ref. 45); not restated." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ac-pool-iwasaki2026 a mlips:TrainingDataset ;
    rdfs:label "Amorphous-carbon candidate pool (225 structures; 2168-structure test set)" ;
    mlips:coversMaterial entity:mat-a-c-iwasaki2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 225 ;
    mlips:hasDFTCalculation entity:calc-ac-ref-iwasaki2026 .

entity:ds-gst-pool-iwasaki2026 a mlips:TrainingDataset ;
    rdfs:label "GST candidate pool (800 structures; 800-structure test set)" ;
    mlips:coversMaterial entity:mat-gst-iwasaki2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 800 ;
    mlips:hasDFTCalculation entity:calc-gst-ref-iwasaki2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ac-pool-iwasaki2026 mlips:samplingStrategy
    entity:sampling-fps-iwasaki2026 .

entity:ds-gst-pool-iwasaki2026 mlips:samplingStrategy
    entity:sampling-fps-iwasaki2026 .

entity:sampling-fps-iwasaki2026 a mlips:SamplingStrategy ;
    rdfs:label "Farthest-point sampling with SOAP-Turbo-based similarity (data-wise, atom-wise, cluster-wise or distribution-aware cluster-wise), versus random selection" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-iwasaki2026 ;
    mlips:hasImplementation entity:impl-GAP-iwasaki2026 .

entity:alg-GAP-iwasaki2026 a mls:Algorithm ;
    rdfs:label "GAP with SOAP-Turbo descriptors; trained on FPS-selected subsets of increasing size (5 or 3 repeats)" .

entity:impl-GAP-iwasaki2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-TurboGAP-iwasaki2026 .

entity:lib-TurboGAP-iwasaki2026 a mlips:Library ;
    rdfs:label "TurboGAP" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-ac-iwasaki2026 a mlips:MLIPRun ;
    rdfs:label "GAP models for amorphous carbon trained on similarity-selected subsets (learning-curve series)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-ac-pool-iwasaki2026 ;
    mlips:produces entity:model-gap-ac-iwasaki2026 .

entity:model-gap-ac-iwasaki2026 a mlips:TrainedModel ;
    rdfs:label "GAP a-C (similarity-based selection)" .

entity:run-gap-gst-iwasaki2026 a mlips:MLIPRun ;
    rdfs:label "GAP models for GST trained on similarity-selected subsets (learning-curve series)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-gst-pool-iwasaki2026 ;
    mlips:produces entity:model-gap-gst-iwasaki2026 .

entity:model-gap-gst-iwasaki2026 a mlips:TrainedModel ;
    rdfs:label "GAP GST (similarity-based selection)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

