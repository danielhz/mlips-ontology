    rdfs:label "PET HME21 models (five random seeds)" .

entity:run-pet-hea25-pozdnyakov2023 a mlips:MLIPRun ;
    rdfs:label "PET fit to HEA25" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-hea25-pozdnyakov2023 ;
    mlips:produces entity:model-pet-hea25-pozdnyakov2023 .

entity:model-pet-hea25-pozdnyakov2023 a mlips:TrainedModel ;
    rdfs:label "PET HEA25 model" .

entity:run-pet-water-pozdnyakov2023 a mlips:MLIPRun ;
    rdfs:label "PET fit to liquid water with n_GNN = 6, n_TL = 2, Rc = 4.25 A" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-water-pozdnyakov2023 ;
    mlips:hasHyperparameterSetting entity:setting-pet-water-cutoffRadius-pozdnyakov2023 ,
        entity:setting-pet-water-numLayers-pozdnyakov2023 ,
        entity:setting-pet-water-nTL-pozdnyakov2023 ;
    mlips:produces entity:model-pet-water-pozdnyakov2023 .

entity:model-pet-water-pozdnyakov2023 a mlips:TrainedModel ;
    rdfs:label "PET water model 6x2, Rc 4.25 A" .

entity:run-pet-qm9-pozdnyakov2023 a mlips:MLIPRun ;
    rdfs:label "PET fit to QM9 atomization energies" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-qm9-pozdnyakov2023 ;
    mlips:produces entity:model-pet-qm9-pozdnyakov2023 .

entity:model-pet-qm9-pozdnyakov2023 a mlips:TrainedModel ;
    rdfs:label "PET QM9 energy model" .

