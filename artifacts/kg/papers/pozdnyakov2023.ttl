###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PET a mlips:MLIPMethod ;
    rdfs:label "Point Edge Transformer (PET)" ;
    mlips:hasLossFunction entity:loss-PET-pozdnyakov2023 ;
    mlips:hasTrainingAlgorithm entity:alg-PET-pozdnyakov2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        entity:hp-nTL-pozdnyakov2023 ;
    mlips:hasImplementation entity:impl-PET-pozdnyakov2023 .

entity:loss-PET-pozdnyakov2023 a mlips:LossFunction ;
    rdfs:label "Weighted sum of energy and force mean squared errors (Eq. 8); per-atom energy MSE for HME21" .

entity:alg-PET-pozdnyakov2023 a mls:Algorithm ;
    rdfs:label "StepLR or fast-decay learning-rate schedule (App. C.2)" .

entity:impl-PET-pozdnyakov2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PET-pozdnyakov2023 .

entity:lib-PET-pozdnyakov2023 a mlips:Library ;
    rdfs:label "PET" ;
    rdfs:comment "Released implementation of the paper (App. D)" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-nTL-pozdnyakov2023 a mlips:Hyperparameter ;
    rdfs:label "PET number of transformer layers per message-passing block n_TL" ;
    mlips:hyperparameterName "n_TL" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-pet-coll-numFeatures-pozdnyakov2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-pet-water-cutoffRadius-pozdnyakov2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.25"^^xsd:double .

entity:setting-pet-water-numLayers-pozdnyakov2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-pet-water-nTL-pozdnyakov2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nTL-pozdnyakov2023 ;
    mlips:settingValue "2"^^xsd:integer .

