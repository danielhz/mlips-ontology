# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-pet-coll-pozdnyakov2023 a mlips:MLIPRun ;
    rdfs:label "PET-256 fit to COLL" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-coll-pozdnyakov2023 ;
    mlips:hasHyperparameterSetting entity:setting-pet-coll-numFeatures-pozdnyakov2023 ;
    mlips:produces entity:model-pet-coll-pozdnyakov2023 .

entity:model-pet-coll-pozdnyakov2023 a mlips:TrainedModel ;
    rdfs:label "PET-256 COLL model" .

entity:run-pet-MnO-pozdnyakov2023 a mlips:MLIPRun ;
    rdfs:label "PET with discretised spins fit to MnO" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-MnO-pozdnyakov2023 ;
    mlips:produces entity:model-pet-MnO-pozdnyakov2023 .

entity:model-pet-MnO-pozdnyakov2023 a mlips:TrainedModel ;
    rdfs:label "PET MnO model (spins discretised)" .

entity:run-pet-hme21-pozdnyakov2023 a mlips:MLIPRun ;
    rdfs:label "PET fit to HME21 (five seeds)" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-hme21-pozdnyakov2023 ;
