    rdfs:comment "100 validation and 190 test structures." .

entity:ds-qm9-pozdnyakov2023 a mlips:TrainingDataset ;
    rdfs:label "QM9 training set (110,000 molecules)" ;
    mlips:coversMaterial entity:mat-qm9-pozdnyakov2023 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 110000 ;
    rdfs:comment "10,000 validation and 10,831 test molecules." .

