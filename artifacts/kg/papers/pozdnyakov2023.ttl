# Canonical Turtle for the protocol-derived encoding of:
#   Sergey N. Pozdnyakov et al. (2023). Smooth, exact rotational symmetrization for deep learning on point clouds.
#   neural information processing systems. doi:10.52202/075280-3478  arXiv:2305.19302v3
#
# Version read: arxiv-preprint arXiv:2305.19302v3 (sha256 33ce0c25fb3c07af...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 216 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/pozdnyakov2023.yaml.
#
# Encoding scope: the Point Edge Transformer (introduced here; PET in the
# registry) with its tabulated errors on COLL (Tables 1, 2), MnO (Tables 1,
# 4), HME21 (Tables 1, 3), the HEA25 high-entropy alloys (Table 1), liquid water (text) and QM9
# atomization energies (Table 5). The ECSE symmetrisation is a protocol
# applied at inference; results of the plain (y0) and symmetrised (yS)
# model are both encoded where tabulated. CH4 and QM9-dipole learning
# curves (Fig. 3) and ensemble results are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-pozdnyakov2023 a mlips:BenchmarkStudy ;
    rdfs:label "Pozdnyakov and Ceriotti (2023): Point Edge Transformer (PET) with equivariant coordinate system ensembles (ECSE)" ;
    mlips:reportedIn entity:article-pozdnyakov2023 .

entity:article-pozdnyakov2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.52202/075280-3478> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Smooth, exact rotational symmetrization for deep learning on point clouds" ;
    schema:author entity:person-Pozdnyakov-pozdnyakov2023 ,
        entity:person-Ceriotti-pozdnyakov2023 .

entity:person-Pozdnyakov-pozdnyakov2023 a schema:Person ;
    schema:name "Sergey Pozdnyakov" ;
    schema:givenName "Sergey" ;
    schema:familyName "Pozdnyakov" .

entity:person-Ceriotti-pozdnyakov2023 a schema:Person ;
    schema:name "Michele Ceriotti" ;
    schema:givenName "Michele" ;
    schema:familyName "Ceriotti" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-coll-pozdnyakov2023 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules in collision configurations (COLL)" ;
    mlips:materialClass "Small organic molecules (distorted)" .

entity:mat-MnO-pozdnyakov2023 a mlips:MaterialSystem ;
    rdfs:label "Manganese oxide with collinear atomic spins" ;
    mlips:chemicalFormula "MnO" ;
    mlips:materialClass "Antiferromagnetic transition-metal oxide" .

entity:mat-hme21-pozdnyakov2023 a mlips:MaterialSystem ;
    rdfs:label "Diverse inorganic structures from high-temperature MD (HME21)" ;
    mlips:materialClass "Inorganic materials, multi-element" .

entity:mat-hea25-pozdnyakov2023 a mlips:MaterialSystem ;
    rdfs:label "High-entropy alloys of up to 25 transition metals (distorted fcc and bcc lattices)" ;
    mlips:materialClass "High-entropy alloy" .

entity:mat-water-pozdnyakov2023 a mlips:MaterialSystem ;
    rdfs:label "Liquid water (path-integral MD configurations)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-qm9-pozdnyakov2023 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules with up to nine heavy atoms (QM9)" ;
    mlips:materialClass "Small organic molecules (equilibrium geometries)" .

