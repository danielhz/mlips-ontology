entity:ds-coll-pozdnyakov2023 a mlips:TrainingDataset ;
    rdfs:label "COLL training data" ;
    mlips:coversMaterial entity:mat-coll-pozdnyakov2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-MnO-pozdnyakov2023 a mlips:TrainingDataset ;
    rdfs:label "MnO data set of Eckhoff and Behler (2,608 training structures)" ;
    mlips:coversMaterial entity:mat-MnO-pozdnyakov2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 2608 ;
    rdfs:comment "200 validation and 293 test structures; atomic spins as discretised labels." .

entity:ds-hme21-pozdnyakov2023 a mlips:TrainingDataset ;
    rdfs:label "HME21 training data" ;
    mlips:coversMaterial entity:mat-hme21-pozdnyakov2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-hea25-pozdnyakov2023 a mlips:TrainingDataset ;
    rdfs:label "HEA25 training set (24,630 structures)" ;
    mlips:coversMaterial entity:mat-hea25-pozdnyakov2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 24630 ;
    rdfs:comment "500 validation and 500 test structures." .

entity:ds-water-pozdnyakov2023 a mlips:TrainingDataset ;
    rdfs:label "Liquid water data set of Ref. [85] (1,303 training structures)" ;
    mlips:coversMaterial entity:mat-water-pozdnyakov2023 ;
    mlips:coversProperty mlips:Energy ,
