# Canonical Turtle for the protocol-derived encoding of:
#   А. А. Соловых et al. (2025). Path-integral molecular dynamics with actively-trained and universal machine learning force fields.
#   arXiv (Cornell University). doi:10.48550/arxiv.2505.14245  arXiv:2505.14245v1
#
# Version read: arxiv-preprint arXiv:2505.14245v1 (sha256 0ce26db431331c00...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 666 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/anon2025.yaml.
#
# Encoding scope: the actively learned MTPs for LiH and Si (MLIP-2 with
# i-PI, active learning in classical MD and PIMD) with their training
# RMSEs (Table 1), and MatterSim-v1.0.0-1M used as distributed for
# comparison. Lattice parameters, thermal expansion and RDFs from PIMD are
# property results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-anon2025 a mlips:BenchmarkStudy ;
    rdfs:label "Solovykh, Rybin, Novikov and Shapeev (2025): path-integral MD with actively trained MTPs and a universal force field" ;
    mlips:reportedIn entity:article-anon2025 .

entity:article-anon2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2505.14245> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Path-integral molecular dynamics with actively-trained and universal machine learning force fields" ;
    schema:author entity:person-Solovykh-anon2025 ,
        entity:person-Rybin-anon2025 ,
        entity:person-Novikov-anon2025 ,
        entity:person-Shapeev-anon2025 .

entity:person-Solovykh-anon2025 a schema:Person ;
    schema:name "A. A. Solovykh" ;
    schema:givenName "A. A." ;
    schema:familyName "Solovykh" .

entity:person-Rybin-anon2025 a schema:Person ;
    schema:name "N. E. Rybin" ;
    schema:givenName "N. E." ;
    schema:familyName "Rybin" .

entity:person-Novikov-anon2025 a schema:Person ;
    schema:name "I. S. Novikov" ;
    schema:givenName "I. S." ;
    schema:familyName "Novikov" .

entity:person-Shapeev-anon2025 a schema:Person ;
    schema:name "A. V. Shapeev" ;
    schema:givenName "A. V." ;
    schema:familyName "Shapeev" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lih-anon2025 a mlips:MaterialSystem ;
    rdfs:label "LiH crystal" ;
    mlips:chemicalFormula "LiH" ;
    mlips:materialClass "ionic hydride" .

entity:mat-si-anon2025 a mlips:MaterialSystem ;
    rdfs:label "Diamond silicon (64-atom supercell)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "covalent semiconductor" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-lih-anon2025 a mlips:DFTCalculation .

entity:calc-pbe-si-anon2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-lih-anon2025 mlips:hasDFTSettings entity:calc-settings-pbe-lih-anon2025 .

entity:calc-settings-pbe-lih-anon2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "650"^^xsd:double ;
    mlips:kPointMesh "2x2x2" ;
    rdfs:comment "Single-point labels; AIMD at 300 eV, Gamma only." .

entity:calc-pbe-si-anon2025 mlips:hasDFTSettings entity:calc-settings-pbe-si-anon2025 .

entity:calc-settings-pbe-si-anon2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "4x4x4" ;
    rdfs:comment "Single-point labels; AIMD settings as for LiH." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-lih-anon2025 a mlips:TrainingDataset ;
    rdfs:label "LiH MTP training set (313 configurations)" ;
    mlips:coversMaterial entity:mat-lih-anon2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 313 ;
    mlips:hasDFTCalculation entity:calc-pbe-lih-anon2025 .

entity:ds-si-anon2025 a mlips:TrainingDataset ;
    rdfs:label "Si MTP training set (363 configurations)" ;
    mlips:coversMaterial entity:mat-si-anon2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 363 ;
    mlips:hasDFTCalculation entity:calc-pbe-si-anon2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-lih-anon2025 mlips:samplingStrategy
    entity:sampling-al-pimd-anon2025 .

entity:ds-si-anon2025 mlips:samplingStrategy
    entity:sampling-al-pimd-anon2025 .

entity:sampling-al-pimd-anon2025 a mlips:SamplingStrategy ;
    rdfs:label "Maxvol selection from AIMD, then active learning (gamma_th = 2.1, gamma_cr = 10) in classical NVT MD at 500 K and PIMD at 100 K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-anon2025 ;
    mlips:hasHyperparameter mlips:momentLevel ,
        mlips:cutoffRadius ,
        mlips:minInteratomicDistance ;
    mlips:hasImplementation entity:impl-MTP-anon2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MTP-anon2025 a mlips:LossFunction ;
    rdfs:label "Energy, force and stress weights 1.0, 0.01, 0.001" .

entity:impl-MTP-anon2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-lih-momentLevel-anon2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "16"^^xsd:integer .

entity:setting-mtp-lih-cutoffRadius-anon2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-mtp-lih-minInteratomicDistance-anon2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:minInteratomicDistance ;
    mlips:settingValue "1.42"^^xsd:double .

entity:setting-mtp-si-momentLevel-anon2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "24"^^xsd:integer .

entity:setting-mtp-si-cutoffRadius-anon2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-mtp-si-minInteratomicDistance-anon2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:minInteratomicDistance ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-lih-anon2025 a mlips:MLIPRun ;
    rdfs:label "Actively learned MTP for LiH (level 16, 222 parameters)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-lih-anon2025 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-lih-momentLevel-anon2025 ,
        entity:setting-mtp-lih-cutoffRadius-anon2025 ,
        entity:setting-mtp-lih-minInteratomicDistance-anon2025 ;
    mlips:produces entity:model-mtp-lih-anon2025 .

entity:model-mtp-lih-anon2025 a mlips:TrainedModel ;
    rdfs:label "MTP-16 LiH (PIMD)" .

entity:run-mtp-si-anon2025 a mlips:MLIPRun ;
    rdfs:label "Actively learned MTP for Si (level 24, 913 parameters)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-si-anon2025 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-si-momentLevel-anon2025 ,
        entity:setting-mtp-si-cutoffRadius-anon2025 ,
        entity:setting-mtp-si-minInteratomicDistance-anon2025 ;
    mlips:produces entity:model-mtp-si-anon2025 .

entity:model-mtp-si-anon2025 a mlips:TrainedModel ;
    rdfs:label "MTP-24 Si (PIMD)" .

entity:run-mattersim-1m-anon2025 a mlips:MLIPRun ;
    rdfs:label "MatterSim-v1.0.0-1M as distributed" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-mattersim-1m-anon2025 .

entity:model-mattersim-1m-anon2025 a mlips:TrainedModel ;
    rdfs:label "MatterSim-v1.0.0-1M" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-anon2025 mlips:hasResult
    entity:result-mtp-lih-train-anon2025 ,
    entity:result-mtp-si-train-anon2025 .

entity:result-mtp-lih-train-anon2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-lih-anon2025 ;
    mlips:targetMaterial entity:mat-lih-anon2025 ;
    mlips:hasAccuracyMetric entity:metric-mtp-lih-train-1-anon2025 ,
        entity:metric-mtp-lih-train-2-anon2025 ,
        entity:metric-mtp-lih-train-3-anon2025 .

entity:metric-mtp-lih-train-1-anon2025 a mlips:AccuracyMetric ;
    rdfs:label "train energy RMSE on LiH: MTP-16" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.26"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-mtp-lih-train-2-anon2025 a mlips:AccuracyMetric ;
    rdfs:label "train force RMSE on LiH: MTP-16" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "14.12"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-mtp-lih-train-3-anon2025 a mlips:AccuracyMetric ;
    rdfs:label "train stress RMSE on LiH: MTP-16" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.06175"^^xsd:double ;
    mlips:hasUnit unit:GigaPA .

entity:result-mtp-si-train-anon2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-si-anon2025 ;
    mlips:targetMaterial entity:mat-si-anon2025 ;
    mlips:hasAccuracyMetric entity:metric-mtp-si-train-1-anon2025 ,
        entity:metric-mtp-si-train-2-anon2025 ,
        entity:metric-mtp-si-train-3-anon2025 .

entity:metric-mtp-si-train-1-anon2025 a mlips:AccuracyMetric ;
    rdfs:label "train energy RMSE on Si: MTP-24" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.54"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-mtp-si-train-2-anon2025 a mlips:AccuracyMetric ;
    rdfs:label "train force RMSE on Si: MTP-24" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "33.4"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-mtp-si-train-3-anon2025 a mlips:AccuracyMetric ;
    rdfs:label "train stress RMSE on Si: MTP-24" ;
