# Canonical Turtle for the protocol-derived encoding of:
#   Rina Ibragimova et al. (2025). Unifying the Description of Hydrocarbons and Hydrogenated Carbon Materials with a Chemically Reactive Machine Learning Interatomic Potential.
#   Chemistry of Materials. doi:10.1021/acs.chemmater.4c02905  arXiv:2409.08194v1
#
# Version read: arxiv-preprint arXiv:2409.08194v1 (sha256 b301af79017f9dd9...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 362 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ibragimova2025.yaml.
#
# Encoding scope: the PBE (VASP) database of QM9 CH molecules,
# actively generated interacting-molecule pairs, high-temperature
# 'soup' structures, melt-quench structures and pure-carbon structures,
# the CH GAP (2b, 3b and soap_turbo many-body descriptors with tabulated
# core repulsion; gap_fit, TurboGAP) and its test RMSEs overall (6,941
# structures) and per structure type stated in Sec. III A. The local
# Hirshfeld-volume model for TS/MBD dispersion, defect energetics and the
# applications are properties or auxiliary models.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ibragimova2025 a mlips:BenchmarkStudy ;
    rdfs:label "Ibragimova et al. (2025): a chemically reactive CH GAP for hydrocarbons and hydrogenated carbon materials" ;
    mlips:reportedIn entity:article-ibragimova2025 .

entity:article-ibragimova2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.chemmater.4c02905> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Unifying the Description of Hydrocarbons and Hydrogenated Carbon Materials with a Chemically Reactive Machine Learning Interatomic Potential" ;
    schema:author <https://orcid.org/0000-0001-5773-3457> ,
        entity:person-Kuklin-ibragimova2025 ,
        entity:person-Zarrouk-ibragimova2025 ,
        <https://orcid.org/0000-0001-9304-4261> .

<https://orcid.org/0000-0001-5773-3457> a schema:Person ;
    schema:name "Rina Ibragimova" ;
    schema:givenName "Rina" ;
    schema:familyName "Ibragimova" ;
    schema:identifier <https://orcid.org/0000-0001-5773-3457> .

entity:person-Kuklin-ibragimova2025 a schema:Person ;
    schema:name "Mikhail S. Kuklin" ;
    schema:givenName "Mikhail S." ;
    schema:familyName "Kuklin" .

entity:person-Zarrouk-ibragimova2025 a schema:Person ;
    schema:name "Tigany Zarrouk" ;
    schema:givenName "Tigany" ;
    schema:familyName "Zarrouk" .

<https://orcid.org/0000-0001-9304-4261> a schema:Person ;
    schema:name "Miguel A. Caro" ;
