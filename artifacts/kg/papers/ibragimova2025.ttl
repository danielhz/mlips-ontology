###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ch-ibragimova2025 a mlips:MaterialSystem ;
    rdfs:label "Hydrocarbons and hydrogenated carbon: QM9 CH molecules, interacting molecule pairs, CH soups (300-15000 K), melt-quench structures and fragments, carbon chains, amorphous carbon, graphite and diamond" ;
    mlips:materialClass "Elemental solid and liquid carbon" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-ibragimova2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-ibragimova2025 mlips:hasDFTSettings entity:calc-settings-pbe-ibragimova2025 .

entity:calc-settings-pbe-ibragimova2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "650"^^xsd:double ;
    mlips:kPointMesh "automatic, minimum spacing 0.25 1/A" ;
    rdfs:comment "Identical convergence settings for all single points (Sec. II B)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ch-ibragimova2025 a mlips:TrainingDataset ;
    rdfs:label "CH GAP database (QM9 CH molecules, interacting molecules, soups, melt-quench structures, pure carbon); split into training and test sets" ;
    mlips:coversMaterial entity:mat-ch-ibragimova2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-ibragimova2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:loss-GAP-ibragimova2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-GAP-ibragimova2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-GAP-ibragimova2025 a mlips:LossFunction ;
    rdfs:label "Per-configuration-type regularisation (sigma from about 0.025 down to 0.001 eV/atom), CUR sparsification" .

entity:impl-GAP-ibragimova2025 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-chgap-cutoffRadius-ibragimova2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-chgap-angularCutoff-ibragimova2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chgap-ibragimova2025 a mlips:MLIPRun ;
    rdfs:label "CH GAP (2b + 3b + soap_turbo, tabulated core pair potentials)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-ch-ibragimova2025 ;
    mlips:hasHyperparameterSetting entity:setting-chgap-cutoffRadius-ibragimova2025 ,
        entity:setting-chgap-angularCutoff-ibragimova2025 ;
    mlips:produces entity:model-chgap-ibragimova2025 .

entity:model-chgap-ibragimova2025 a mlips:TrainedModel ;
    rdfs:label "CH GAP (Ibragimova 2025)" .

