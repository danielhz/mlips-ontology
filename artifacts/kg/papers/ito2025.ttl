    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "24.84"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-gen-NiMn125-ito2025 a mlips:BenchmarkResult ;
