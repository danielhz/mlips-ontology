entity:metric-gen-NiMn125-1-ito2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE, GeNNIP4MD data set, Ni-12.5 at.% Mn with 0-2 H" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
