###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-d0123-benedini2025 a mlips:MaterialSystem ;
    rdfs:label "0123D compounds: molecules and clusters (0D), chains (1D), layers (2D) and bulk crystals (3D) across most of the periodic table" ;
    mlips:materialClass "Universal (materials and molecules)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-benedini2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-benedini2025 mlips:hasDFTSettings entity:calc-settings-pbe-benedini2025 .

entity:calc-settings-pbe-benedini2025 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Alexandria/WBM-consistent settings (Ref. 16); geometry relaxations." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-d0123-benedini2025 a mlips:TrainingDataset ;
    rdfs:label "0123D benchmark (10,000 relaxed systems per dimensionality)" ;
    mlips:coversMaterial entity:mat-d0123-benedini2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 40000 ;
    mlips:hasDFTCalculation entity:calc-pbe-benedini2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DPA3 a mlips:MLIPMethod ;
    rdfs:label "DPA-3 (Deep Potential attention model, version 3)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

