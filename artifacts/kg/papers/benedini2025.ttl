    mlips:produces entity:model-grace-benedini2025 .

entity:model-grace-benedini2025 a mlips:TrainedModel ;
    rdfs:label "GRACE-2l-oam" .

entity:run-mace-benedini2025 a mlips:MLIPRun ;
    rdfs:label "MACE-mpa-0 as distributed (Table I)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-benedini2025 .

entity:model-mace-benedini2025 a mlips:TrainedModel ;
