entity:run-sevennet-benedini2025 a mlips:MLIPRun ;
    rdfs:label "SevenNet-mf-ompa as distributed (Table I)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-sevennet-benedini2025 .

