###############################################################################

entity:run-dpa3-benedini2025 a mlips:MLIPRun ;
    rdfs:label "DPA3-v1-openlam as distributed (Table I)" ;
    mlips:appliesMethod entity:DPA3 ;
    mlips:produces entity:model-dpa3-benedini2025 .

entity:model-dpa3-benedini2025 a mlips:TrainedModel ;
    rdfs:label "DPA3-v1-openlam" .

