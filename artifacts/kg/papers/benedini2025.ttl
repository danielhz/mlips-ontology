@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-benedini2025 a mlips:BenchmarkStudy ;
    rdfs:label "Benedini et al. (2025): universal MLIPs for systems of reduced dimensionality, benchmarked on the 0123D data set" ;
    mlips:reportedIn entity:article-benedini2025 .

