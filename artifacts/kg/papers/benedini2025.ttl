entity:run-orb2-benedini2025 a mlips:MLIPRun ;
    rdfs:label "ORB-v2 as distributed (Table I)" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb2-benedini2025 .

entity:model-orb2-benedini2025 a mlips:TrainedModel ;
