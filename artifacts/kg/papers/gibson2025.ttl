    schema:givenName "Richard G." ;
    schema:familyName "Hennig" ;
    schema:identifier <https://orcid.org/0000-0003-4933-7686> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sin-gibson2025 a mlips:MaterialSystem ;
    rdfs:label "Silicon nitride: crystalline alpha, beta, gamma Si3N4, amorphous SiNx and non-stoichiometric Si-N phases" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-gibson2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-gibson2025 mlips:hasDFTSettings entity:calc-settings-pbe-gibson2025 .

entity:calc-settings-pbe-gibson2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "45 per 1/A, Methfessel-Paxton smearing 100 meV" ;
    rdfs:comment "All data sets (p. 3)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-stoic-gibson2025 a mlips:TrainingDataset ;
    rdfs:label "Stoichiometric Si3N4 training data (3200 K AIMD held out for testing)" ;
    mlips:coversMaterial entity:mat-sin-gibson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-gibson2025 .

entity:ds-nonstoic-gibson2025 a mlips:TrainingDataset ;
    rdfs:label "Non-stoichiometric GA training data (80 % of the GA set)" ;
    mlips:coversMaterial entity:mat-sin-gibson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-gibson2025 .

entity:ds-total-gibson2025 a mlips:TrainingDataset ;
    rdfs:label "Stoichiometric + non-stoichiometric training data" ;
    mlips:coversMaterial entity:mat-sin-gibson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-pbe-gibson2025 .

entity:ds-final-gibson2025 a mlips:TrainingDataset ;
    rdfs:label "Stoichiometric training data + non-stoichiometric data without structures richer in N than Si3N5" ;
    mlips:coversMaterial entity:mat-sin-gibson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-pbe-gibson2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-stoic-gibson2025 mlips:samplingStrategy
    entity:sampling-aimd-gibson2025 .

entity:ds-nonstoic-gibson2025 mlips:samplingStrategy
    entity:sampling-ga-gibson2025 .

entity:ds-total-gibson2025 mlips:samplingStrategy
    entity:sampling-aimd-gibson2025 ,
    entity:sampling-ga-gibson2025 .

entity:ds-final-gibson2025 mlips:samplingStrategy
    entity:sampling-aimd-gibson2025 ,
    entity:sampling-ga-gibson2025 .

entity:sampling-aimd-gibson2025 a mlips:SamplingStrategy ;
    rdfs:label "AIMD of Si3N4 phases at 300, 1200, 1800 and 3200 K (5 ps), elastic-constant and high-pressure (up to 200 GPa) relaxation trajectories" .

entity:sampling-ga-gibson2025 a mlips:SamplingStrategy ;
    rdfs:label "Genetic-algorithm structure search (GASP) relaxation trajectories over Si-N compositions" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:UF3 a mlips:MLIPMethod ;
    rdfs:label "UF3 (ultra-fast force fields: two- and three-body cubic B-spline potentials fitted by regularised linear regression)" ;
    mlips:hasLossFunction entity:loss-UF3-gibson2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-UF3-gibson2025 a mlips:LossFunction ;
    rdfs:label "Linear least squares with ridge and curvature regularisation for 2- and 3-body terms" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-uf3-stoic-gibson2025 a mlips:MLIPRun ;
    rdfs:label "UF3 (2+3-body) trained on the stoichiometric data" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-stoic-gibson2025 ;
    mlips:produces entity:model-uf3-stoic-gibson2025 .

entity:model-uf3-stoic-gibson2025 a mlips:TrainedModel ;
    rdfs:label "SiN UF3 stoic." .

entity:run-uf3-nonstoic-gibson2025 a mlips:MLIPRun ;
    rdfs:label "UF3 (2+3-body) trained on the non-stoichiometric GA data" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-nonstoic-gibson2025 ;
    mlips:produces entity:model-uf3-nonstoic-gibson2025 .

entity:model-uf3-nonstoic-gibson2025 a mlips:TrainedModel ;
    rdfs:label "SiN UF3 nonstoic." .

entity:run-uf3-total-gibson2025 a mlips:MLIPRun ;
    rdfs:label "UF3 (2+3-body) trained on stoichiometric + non-stoichiometric data" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-total-gibson2025 ;
    mlips:produces entity:model-uf3-total-gibson2025 .

entity:model-uf3-total-gibson2025 a mlips:TrainedModel ;
    rdfs:label "SiN UF3 total" .

entity:run-uf3-final-gibson2025 a mlips:MLIPRun ;
    rdfs:label "UF3 (2+3-body) trained on stoichiometric + N-filtered non-stoichiometric data (hyperparameters optimised for this variant)" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-final-gibson2025 ;
    mlips:produces entity:model-uf3-final-gibson2025 .

entity:model-uf3-final-gibson2025 a mlips:TrainedModel ;
    rdfs:label "SiN UF3 final" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# UF3 is stated to be 9,269 times faster than DFT and 8 times faster than GAP (Ref. 16) for 100 NVE steps of a 3,024-atom beta-Si3N4 cell on 4 Intel Xeon E5-2698 CPUs (Fig. 1); absolute times are figure-only.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Force MAEs and R2 values for the stoichiometric and non-stoichiometric test sets are in tables inside Fig. 3, which the text does not repeat (except R2 = 0.99 and -32.62 for UF3 stoic.); not encoded.
# - Data-set sizes and UF3 cutoffs and knot counts are not stated in the text. Elastic-constant MAPEs (12.0 % stoic., 8.5 % final), densities and RDF/ADF are properties.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
