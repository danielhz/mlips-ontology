# Canonical Turtle for the protocol-derived encoding of:
#   Jason Gibson et al. (2025). When more data hurts: Optimizing data coverage while mitigating diversity-induced underfitting in an ultrafast machine-learned potential.
#   Physical Review Materials. doi:10.1103/physrevmaterials.9.043802  arXiv:2409.07610v1
#
# Version read: arxiv-preprint arXiv:2409.07610v1 (sha256 a9fa143e7806f2bd...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 366 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/gibson2025.yaml.
#
# Encoding scope: the PBE data sets for Si-N (stoichiometric: AIMD of
# alpha, beta and gamma Si3N4 at 300-3200 K, elastic and high-pressure
# relaxations; non-stoichiometric: GASP genetic-algorithm relaxation
# trajectories, filtered at 20 eV/A and 3 eV/atom above the hull) and the
# four UF3 variants trained on them (stoic., nonstoic., total, final).
# Force MAEs and R2 values are given in tables inside Fig. 3 (figure-
# only); elastic constants, density and RDF/ADF are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gibson2025 a mlips:BenchmarkStudy ;
    rdfs:label "Gibson et al. (2025): when more data hurts, training-data diversity and underfitting in UF3 potentials for amorphous silicon nitride" ;
    mlips:reportedIn entity:article-gibson2025 .

entity:article-gibson2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.9.043802> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "When more data hurts: Optimizing data coverage while mitigating diversity-induced underfitting in an ultrafast machine-learned potential" ;
    schema:author <https://orcid.org/0000-0001-7974-5264> ,
        <https://orcid.org/0000-0001-6008-6414> ,
        <https://orcid.org/0000-0003-3147-2521> ,
        entity:person-Bishop-gibson2025 ,
        <https://orcid.org/0000-0002-7878-9158> ,
        <https://orcid.org/0000-0003-4933-7686> .

<https://orcid.org/0000-0001-7974-5264> a schema:Person ;
    schema:name "Jason B. Gibson" ;
    schema:givenName "Jason B." ;
    schema:familyName "Gibson" ;
    schema:identifier <https://orcid.org/0000-0001-7974-5264> .

<https://orcid.org/0000-0001-6008-6414> a schema:Person ;
    schema:name "Tesia D. Janicki" ;
    schema:givenName "Tesia D." ;
    schema:familyName "Janicki" ;
    schema:identifier <https://orcid.org/0000-0001-6008-6414> .

<https://orcid.org/0000-0003-3147-2521> a schema:Person ;
    schema:name "Ajinkya C. Hire" ;
    schema:givenName "Ajinkya C." ;
    schema:familyName "Hire" ;
    schema:identifier <https://orcid.org/0000-0003-3147-2521> .

entity:person-Bishop-gibson2025 a schema:Person ;
    schema:name "Chris Bishop" ;
    schema:givenName "Chris" ;
    schema:familyName "Bishop" .

<https://orcid.org/0000-0002-7878-9158> a schema:Person ;
    schema:name "J. Matthew D. Lane" ;
    schema:givenName "J. Matthew D." ;
    schema:familyName "Lane" ;
    schema:identifier <https://orcid.org/0000-0002-7878-9158> .

<https://orcid.org/0000-0003-4933-7686> a schema:Person ;
