###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-bpa-dft-kovacs2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-bpa-dft-kovacs2021 mlips:hasDFTSettings entity:calc-settings-bpa-dft-kovacs2021 .

entity:calc-settings-bpa-dft-kovacs2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional mlips:omegaB97X ;
    mlips:dftBasisSet entity:basis-6-31G-d-kovacs2021 ;
    rdfs:comment "omegaB97X/6-31G(d) with ORCA, settings similar to those of the ANI-1x data set." .

entity:basis-6-31G-d-kovacs2021 a mlips:DftBasisSet ;
    rdfs:label "6-31G(d)" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

