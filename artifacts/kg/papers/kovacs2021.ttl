entity:sampling-rmd17-kovacs2021 a mlips:SamplingStrategy ;
    rdfs:label "Revised MD17 train-test splits" ;
    rdfs:comment "The five published rMD17 splits with 1000 training configurations; the underlying MD17 trajectories were sampled from DFT molecular dynamics at 500 K." .

entity:sampling-bpa-md-kovacs2021 a mlips:SamplingStrategy ;
    rdfs:label "Dihedral-grid start points and MD at 300, 600 and 1200 K (3BPA)" ;
    rdfs:comment "Grid over the three dihedral angles, short 0.5 ps MD with ANI-1x from each grid point (7000 configurations), then 25 ps MD at 300, 600 and 1200 K (Langevin thermostat, 1 fs); 460 configurations sampled per trajectory after 2 ps, 2300 in total, re-evaluated with DFT." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:sGDML a mlips:MLIPMethod ;
    rdfs:label "Symmetric Gradient-Domain Machine Learning (sGDML)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:supportsSimulation mlips:GeometryOptimization .

