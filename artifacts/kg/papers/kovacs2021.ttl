entity:ds-3BPA-300K-kovacs2021 a mlips:TrainingDataset ;
    rdfs:label "3BPA training set: 500 configurations from the 300 K set" ;
    mlips:coversMaterial entity:mat-3BPA-kovacs2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 500 ;
    mlips:hasDFTCalculation entity:calc-bpa-dft-kovacs2021 .

entity:ds-3BPA-mixedT-kovacs2021 a mlips:TrainingDataset ;
    rdfs:label "3BPA 'mixed-T' training set: 133 configurations from each of the 300, 600 and 1200 K trajectories" ;
