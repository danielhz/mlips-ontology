###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mos2wse2-georgaras2026 a mlips:MaterialSystem ;
    rdfs:label "MoS2 and WSe2 monolayers and MoS2/WSe2 bilayers (0 and 60 degree stackings)" ;
    mlips:materialClass "2D lateral heterostructure" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-c09-georgaras2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-c09-georgaras2026 mlips:hasDFTSettings entity:calc-settings-c09-georgaras2026 .

entity:calc-settings-c09-georgaras2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-vdW-DF-C09-georgaras2026 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:kPointMesh "12x12x1 (primitive and interlayer cells), 4x4x1 (3x3 supercells)" ;
    rdfs:comment "QE 7.2, 60 Ry, PseudoDojo scalar-relativistic pseudopotentials, SCF 1e-8 Ry (Methods)." .

entity:xc-vdW-DF-C09-georgaras2026 a mlips:XCFunctional ;
    rdfs:label "vdW-DF-C09" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-intra-mos2-georgaras2026 a mlips:TrainingDataset ;
    rdfs:label "MoS2 intralayer data (1,000 perturbed 3x3 supercells; random train/validation/test split)" ;
    mlips:coversMaterial entity:mat-mos2wse2-georgaras2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-c09-georgaras2026 .

entity:ds-intra-wse2-georgaras2026 a mlips:TrainingDataset ;
    rdfs:label "WSe2 intralayer data (1,000 perturbed 3x3 supercells; random split)" ;
    mlips:coversMaterial entity:mat-mos2wse2-georgaras2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-c09-georgaras2026 .

entity:ds-inter-georgaras2026 a mlips:TrainingDataset ;
    rdfs:label "MoS2/WSe2 interlayer data (intralayer contributions subtracted; 6x6 registry test grid held out)" ;
    mlips:coversMaterial entity:mat-mos2wse2-georgaras2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4000 ;
    mlips:hasDFTCalculation entity:calc-c09-georgaras2026 .

entity:ds-union-georgaras2026 a mlips:TrainingDataset ;
    rdfs:label "Union of the intralayer and interlayer data sets (unified models)" ;
    mlips:coversMaterial entity:mat-mos2wse2-georgaras2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-c09-georgaras2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-intra-mos2-georgaras2026 mlips:samplingStrategy
    entity:sampling-perturb-georgaras2026 .

entity:ds-intra-wse2-georgaras2026 mlips:samplingStrategy
    entity:sampling-perturb-georgaras2026 .

entity:ds-inter-georgaras2026 mlips:samplingStrategy
    entity:sampling-scan-georgaras2026 .

entity:ds-union-georgaras2026 mlips:samplingStrategy
    entity:sampling-perturb-georgaras2026 ,
    entity:sampling-scan-georgaras2026 .

entity:sampling-perturb-georgaras2026 a mlips:SamplingStrategy ;
    rdfs:label "1,000 random perturbations of atomic positions and cell parameters of 3x3 monolayer supercells" .

entity:sampling-scan-georgaras2026 a mlips:SamplingStrategy ;
    rdfs:label "Interlayer separations (0.1 A steps from l0 to 2 l0, 0.5 A to 3 l0) times 12x12 in-plane registries; a 6x6 subgrid held out as test set" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-Allegro-georgaras2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:impl-Allegro-georgaras2026 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

