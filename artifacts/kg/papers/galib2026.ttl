    mlips:metricType mlips:R2 ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.99"^^xsd:double .

entity:metric-allegro-val-2-galib2026 a mlips:AccuracyMetric ;
    rdfs:label "validation force R2 on Al2O3: Allegro" ;
    mlips:metricType mlips:R2 ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.96"^^xsd:double .

entity:result-mace-val-galib2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-galib2026 ;
    mlips:targetMaterial entity:mat-al2o3-galib2026 ;
    mlips:hasAccuracyMetric entity:metric-mace-val-1-galib2026 ,
