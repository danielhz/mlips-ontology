entity:metric-mace-val-1-galib2026 a mlips:AccuracyMetric ;
    rdfs:label "validation energy R2 on Al2O3: MACE" ;
    mlips:metricType mlips:R2 ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.99"^^xsd:double .

entity:metric-mace-val-2-galib2026 a mlips:AccuracyMetric ;
