@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-galib2026 a mlips:BenchmarkStudy ;
    rdfs:label "Galib, Isiet and Ponga (2026): AtomProNet, a data pipeline for MLIPs, demonstrated with Allegro and MACE potentials for alumina" ;
    mlips:reportedIn entity:article-galib2026 .

entity:article-galib2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/ae72ec> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "AtomProNet: data flow to and from machine learning interatomic potentials in materials science" ;
    schema:author <https://orcid.org/0000-0002-1735-7546> ,
        <https://orcid.org/0000-0002-0924-2159> ,
        <https://orcid.org/0000-0001-5058-1454> .

<https://orcid.org/0000-0002-1735-7546> a schema:Person ;
    schema:name "Musanna Galib" ;
    schema:givenName "Musanna" ;
    schema:familyName "Galib" ;
    schema:identifier <https://orcid.org/0000-0002-1735-7546> .

<https://orcid.org/0000-0002-0924-2159> a schema:Person ;
    schema:name "Mewael Isiet" ;
    schema:givenName "Mewael" ;
    schema:familyName "Isiet" ;
    schema:identifier <https://orcid.org/0000-0002-0924-2159> .

<https://orcid.org/0000-0001-5058-1454> a schema:Person ;
    schema:name "Mauricio Ponga" ;
    schema:givenName "Mauricio" ;
    schema:familyName "Ponga" ;
    schema:identifier <https://orcid.org/0000-0001-5058-1454> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-al2o3-galib2026 a mlips:MaterialSystem ;
    rdfs:label "Alumina (Al2O3) with Al and O vacancies, hydrostatically strained 80-atom supercells" ;
    mlips:chemicalFormula "Al2O3" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-galib2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-galib2026 mlips:hasDFTSettings entity:calc-settings-vasp-galib2026 .

entity:calc-settings-vasp-galib2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "4x4x4 Monkhorst-Pack" ;
    rdfs:comment "Gaussian smearing 0.026 eV" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-al2o3-galib2026 a mlips:TrainingDataset ;
    rdfs:label "Al2O3 strained-supercell dataset (16,000 structures; 14,000 training)" ;
    mlips:coversMaterial entity:mat-al2o3-galib2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 14000 ;
    mlips:hasDFTCalculation entity:calc-vasp-galib2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-al2o3-galib2026 mlips:samplingStrategy
    entity:sampling-strain-galib2026 .

entity:sampling-strain-galib2026 a mlips:SamplingStrategy ;
    rdfs:label "Relaxed vacancy-containing supercells strained hydrostatically by up to +/-10% of the lattice parameter in steps of 0.01%" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-galib2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-galib2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-Allegro-galib2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-Allegro-galib2026 a mlips:LossFunction ;
    rdfs:label "Equal force and total-energy weights" .

entity:alg-Allegro-galib2026 a mls:Algorithm ;
    rdfs:label "Adam" .

entity:impl-Allegro-galib2026 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-galib2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-galib2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-galib2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-MACE-galib2026 a mlips:LossFunction ;
    rdfs:label "Energy/force weights 1:100, then 1000:100" .

entity:alg-MACE-galib2026 a mls:Algorithm ;
    rdfs:label "Adam" .

entity:impl-MACE-galib2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-allegro-cutoffRadius-galib2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3"^^xsd:double .

entity:setting-allegro-numEpochs-galib2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "150"^^xsd:integer .

entity:setting-mace-cutoffRadius-galib2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3"^^xsd:double .

entity:setting-mace-numFeatures-galib2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-mace-numEpochs-galib2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "150"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-allegro-galib2026 a mlips:MLIPRun ;
    rdfs:label "Allegro for Al2O3" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-al2o3-galib2026 ;
    mlips:hasHyperparameterSetting entity:setting-allegro-cutoffRadius-galib2026 ,
        entity:setting-allegro-numEpochs-galib2026 ;
    mlips:produces entity:model-allegro-galib2026 .

entity:model-allegro-galib2026 a mlips:TrainedModel ;
    rdfs:label "Allegro Al2O3 (AtomProNet)" .

entity:run-mace-galib2026 a mlips:MLIPRun ;
    rdfs:label "MACE for Al2O3" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-al2o3-galib2026 ;
    mlips:hasHyperparameterSetting entity:setting-mace-cutoffRadius-galib2026 ,
        entity:setting-mace-numFeatures-galib2026 ,
        entity:setting-mace-numEpochs-galib2026 ;
    mlips:produces entity:model-mace-galib2026 .

entity:model-mace-galib2026 a mlips:TrainedModel ;
    rdfs:label "MACE Al2O3 (AtomProNet)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-galib2026 mlips:hasResult
    entity:result-allegro-val-galib2026 ,
    entity:result-mace-val-galib2026 .

entity:result-allegro-val-galib2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-allegro-galib2026 ;
    mlips:targetMaterial entity:mat-al2o3-galib2026 ;
    mlips:hasAccuracyMetric entity:metric-allegro-val-1-galib2026 ,
        entity:metric-allegro-val-2-galib2026 .

entity:metric-allegro-val-1-galib2026 a mlips:AccuracyMetric ;
