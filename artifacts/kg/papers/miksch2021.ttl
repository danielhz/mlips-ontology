# Canonical Turtle for the protocol-derived encoding of:
#   April M Miksch et al. (2021). Strategies for the construction of machine-learning potentials for accurate and efficient atomic-scale simulations.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/abfd96  arXiv:2101.10468v2
#
# Version read: arxiv-preprint arXiv:2101.10468v2 (sha256 d0c33e04abf60b93...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 441 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/miksch2021.yaml.
#
# Encoding scope: the tutorial's worked example, an initial
# Behler-Parrinello-type ANN potential for liquid water (descriptor
# dimension 51 for H and 46 for O, 6.35 A cutoff, two hidden layers of 25
# tanh nodes; from Refs. 88 and 91) trained on 5,369 DFT structures
# (classical and path-integral AIMD snapshots plus randomly displaced
# structures; 90/10 split), with the training and validation RMSEs
# stated in Sec. IV B. The rest of the paper (descriptor choices, a LiSi
# example from Ref. 128, active learning) is review and recipe.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-miksch2021 a mlips:BenchmarkStudy ;
    rdfs:label "Miksch et al. (2021): strategies for constructing artificial-neural-network potentials, with a liquid-water worked example" ;
    mlips:reportedIn entity:article-miksch2021 .

entity:article-miksch2021 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/abfd96> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "Strategies for the construction of machine-learning potentials for accurate and efficient atomic-scale simulations" ;
    schema:author <https://orcid.org/0000-0002-3776-515X> ,
        <https://orcid.org/0000-0002-9385-8721> ,
        <https://orcid.org/0000-0001-6178-7669> ,
        <https://orcid.org/0000-0002-9021-279X> ,
        <https://orcid.org/0000-0003-1153-6583> .

<https://orcid.org/0000-0002-3776-515X> a schema:Person ;
    schema:name "April M Miksch" ;
    schema:givenName "April M" ;
    schema:familyName "Miksch" ;
    schema:identifier <https://orcid.org/0000-0002-3776-515X> .

<https://orcid.org/0000-0002-9385-8721> a schema:Person ;
    schema:name "Tobias Morawietz" ;
    schema:givenName "Tobias" ;
    schema:familyName "Morawietz" ;
    schema:identifier <https://orcid.org/0000-0002-9385-8721> .

<https://orcid.org/0000-0001-6178-7669> a schema:Person ;
    schema:name "Johannes Kästner" ;
    schema:givenName "Johannes" ;
    schema:familyName "Kästner" ;
    schema:identifier <https://orcid.org/0000-0001-6178-7669> .

<https://orcid.org/0000-0002-9021-279X> a schema:Person ;
    schema:name "Alexander Urban" ;
    schema:givenName "Alexander" ;
    schema:familyName "Urban" ;
    schema:identifier <https://orcid.org/0000-0002-9021-279X> .

<https://orcid.org/0000-0003-1153-6583> a schema:Person ;
    schema:name "Nongnuch Artrith" ;
    schema:givenName "Nongnuch" ;
    schema:familyName "Artrith" ;
    schema:identifier <https://orcid.org/0000-0003-1153-6583> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-miksch2021 a mlips:MaterialSystem ;
    rdfs:label "Liquid water (periodic cells of 64 H2O)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-miksch2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-miksch2021 mlips:hasDFTSettings entity:calc-settings-dft-miksch2021 .

entity:calc-settings-dft-miksch2021 a mlips:DFTSettings ;
    rdfs:comment "DFT level of the cited water studies (Refs. 88, 89, 91); not restated here." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-water-miksch2021 a mlips:TrainingDataset ;
    rdfs:label "Initial liquid-water reference set (90 % training, 10 % validation)" ;
    mlips:coversMaterial entity:mat-water-miksch2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 5369 ;
    mlips:hasDFTCalculation entity:calc-dft-miksch2021 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-water-miksch2021 mlips:samplingStrategy
    entity:sampling-aimd-miksch2021 .

entity:sampling-aimd-miksch2021 a mlips:SamplingStrategy ;
    rdfs:label "AIMD and path-integral AIMD snapshots at ambient conditions plus random displacements (up to 0.05 and 0.10 A)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ann-water-cutoffRadius-miksch2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.35"^^xsd:double .

entity:setting-ann-water-numLayers-miksch2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ann-water-miksch2021 a mlips:MLIPRun ;
    rdfs:label "Initial ANN potential for liquid water (two hidden layers of 25 nodes)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-water-miksch2021 ;
    mlips:hasHyperparameterSetting entity:setting-ann-water-cutoffRadius-miksch2021 ,
        entity:setting-ann-water-numLayers-miksch2021 ;
    mlips:produces entity:model-ann-water-miksch2021 .

entity:model-ann-water-miksch2021 a mlips:TrainedModel ;
    rdfs:label "liquid-water ANN (initial data set)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-miksch2021 mlips:hasResult
    entity:result-ann-water-train-miksch2021 ,
    entity:result-ann-water-val-miksch2021 .

entity:result-ann-water-train-miksch2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ann-water-miksch2021 ;
    mlips:targetMaterial entity:mat-water-miksch2021 ;
    mlips:hasAccuracyMetric entity:metric-ann-water-train-1-miksch2021 ,
        entity:metric-ann-water-train-2-miksch2021 .

entity:metric-ann-water-train-1-miksch2021 a mlips:AccuracyMetric ;
    rdfs:label "train energy RMSE on water in meV/H2O: initial water ANN" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.2"^^xsd:double .

entity:metric-ann-water-train-2-miksch2021 a mlips:AccuracyMetric ;
    rdfs:label "train force RMSE on water: initial water ANN" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "84.7"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-ann-water-val-miksch2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ann-water-miksch2021 ;
    mlips:targetMaterial entity:mat-water-miksch2021 ;
    mlips:hasAccuracyMetric entity:metric-ann-water-val-1-miksch2021 ,
        entity:metric-ann-water-val-2-miksch2021 .

entity:metric-ann-water-val-1-miksch2021 a mlips:AccuracyMetric ;
    rdfs:label "validation energy RMSE on water in meV/H2O: initial water ANN" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.4"^^xsd:double .

entity:metric-ann-water-val-2-miksch2021 a mlips:AccuracyMetric ;
    rdfs:label "validation force RMSE on water: initial water ANN" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "83.2"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

