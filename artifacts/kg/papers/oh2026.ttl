# Canonical Turtle for the protocol-derived encoding of:
#   Sangmin Oh et al. (2026). A Lightweight Universal Machine-Learning Interatomic Potential via Knowledge Distillation for Scalable Atomistic Simulations.
#   arXiv (Cornell University). doi:  arXiv:2604.10887v1
#
# Version read: arxiv-preprint arXiv:2604.10887v1 (sha256 80eb173d4dc66c16...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 296 (Software/implementation). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/oh2026.yaml.
#
# Encoding scope: the four SevenNet-Nano models (cutoff 4.5, 5.0, 5.5 and
# 6.0 A; 105k parameters) distilled from the mpa channel of SevenNet-Omni
# on teacher-labelled structures of the SevenNet-Omni training databases,
# the fine-tuned SevenNet-Nano-5.0 models, and the MD throughputs on
# amorphous SiO2 (Sec. on speed, Fig. 11). Benchmark accuracies (Figs.
# 2-10) are figure-only; validation MAEs are stated only as ranges over the
# four cutoffs.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-oh2026 a mlips:BenchmarkStudy ;
    rdfs:label "Oh et al. (2026): SevenNet-Nano, a lightweight universal MLIP distilled from SevenNet-Omni" ;
    mlips:reportedIn entity:article-oh2026 .

entity:article-oh2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "A Lightweight Universal Machine-Learning Interatomic Potential via Knowledge Distillation for Scalable Atomistic Simulations" ;
    schema:author entity:person-Oh-oh2026 ,
        entity:person-You-oh2026 ,
        entity:person-Kim-oh2026 ,
        entity:person-Lee-oh2026 ,
        entity:person-An-oh2026 ,
        entity:person-Han-oh2026 ,
        entity:person-Kang-oh2026 .

entity:person-Oh-oh2026 a schema:Person ;
    schema:name "Sangmin Oh" ;
    schema:givenName "Sangmin" ;
    schema:familyName "Oh" .

entity:person-You-oh2026 a schema:Person ;
    schema:name "Jinmu You" ;
    schema:givenName "Jinmu" ;
    schema:familyName "You" .

entity:person-Kim-oh2026 a schema:Person ;
    schema:name "Jaesun Kim" ;
    schema:givenName "Jaesun" ;
    schema:familyName "Kim" .

entity:person-Lee-oh2026 a schema:Person ;
    schema:name "Jiho Lee" ;
    schema:givenName "Jiho" ;
    schema:familyName "Lee" .

entity:person-An-oh2026 a schema:Person ;
    schema:name "Hyungmin An" ;
    schema:givenName "Hyungmin" ;
    schema:familyName "An" .

entity:person-Han-oh2026 a schema:Person ;
    schema:name "Seungwu Han" ;
    schema:givenName "Seungwu" ;
    schema:familyName "Han" .

entity:person-Kang-oh2026 a schema:Person ;
    schema:name "Youngho Kang" ;
    schema:givenName "Youngho" ;
    schema:familyName "Kang" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-universal-oh2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals, molecules, surfaces, MOFs and multi-domain structures of the SevenNet-Omni training databases" ;
    mlips:materialClass "Universal (materials and molecules)" .

entity:mat-sse-oh2026 a mlips:MaterialSystem ;
    rdfs:label "Li solid-state electrolytes (eight argyrodites, LLZO, LATP, LGPS, Li7P3S11, Li3YCl6, Li3YBr6, Li3N, Li9S3N)" ;
    mlips:materialClass "Li solid electrolytes" .

entity:mat-sio2-oh2026 a mlips:MaterialSystem ;
    rdfs:label "Amorphous SiO2 (70 to 70,000 atoms)" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "Amorphous oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-teacher-oh2026 a mlips:ReferenceCalculation .

entity:calc-pbe-oh2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-teacher-oh2026 mlips:hasReferenceSettings entity:calc-settings-teacher-oh2026 .

entity:calc-settings-teacher-oh2026 a mlips:ReferenceSettings ;
    rdfs:comment "Labels are inferences of the SevenNet-Omni teacher (mpa channel, PBE level) including atomic energies; no DFT labels are used for training." .

entity:calc-pbe-oh2026 mlips:hasDFTSettings entity:calc-settings-pbe-oh2026 .

entity:calc-settings-pbe-oh2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    rdfs:comment "Benchmark DFT (MPtrj-consistent, spin-polarised)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-omni-distill-oh2026 a mlips:TrainingDataset ;
    rdfs:label "SevenNet-Omni-labelled distillation set from MPtrj, MPtrj-r2SCAN, Alex, OMat24, MatPES, OMol25, SPICE, QCML, OC20, OC22, ODAC23 and MAD structures (with oversampling)" ;
    mlips:coversMaterial entity:mat-universal-oh2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasReferenceCalculation entity:calc-teacher-oh2026 .

entity:ds-lsn-ft-oh2026 a mlips:TrainingDataset ;
    rdfs:label "SevenNet-Omni-labelled fine-tuning set from SevenNet-Nano-5.0 MD of the solid electrolytes (7,515 configurations, 90/10 split)" ;
    mlips:coversMaterial entity:mat-sse-oh2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 7515 ;
    mlips:hasReferenceCalculation entity:calc-teacher-oh2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-oh2026 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-oh2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-NequIP-oh2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-NequIP-oh2026 a mlips:LossFunction ;
    rdfs:label "MAE-type loss on energy (1.0), forces (1.0), stress (2e-4) and atomic energies (0.5) from the teacher" .

entity:alg-NequIP-oh2026 a mls:Algorithm ;
    rdfs:label "Knowledge distillation from SevenNet-Omni (AdamW, two epochs); fine-tuning with Adam, warm-up to 0.03 then cosine annealing" .

entity:impl-NequIP-oh2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-oh2026 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:lib-SevenNet-oh2026 a mlips:Library ;
    rdfs:label "SevenNet" ;
    rdfs:comment "SevenNet; LAMMPS with FlashTP" ;
    mlips:candidateForVocabulary mlips:Library .

