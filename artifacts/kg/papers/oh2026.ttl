entity:run-ft-nano-50-oh2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Nano-5.0 fine-tuned on teacher-labelled solid-electrolyte MD snapshots" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lsn-ft-oh2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-nano-50-numEpochs-oh2026 ,
