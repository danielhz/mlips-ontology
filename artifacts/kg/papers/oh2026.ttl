###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-7net-omni-oh2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Omni as distributed (teacher, 26M parameters)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-7net-omni-oh2026 .

entity:model-7net-omni-oh2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Omni" .

entity:run-7net-0-oh2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 as distributed (MPtrj)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-7net-0-oh2026 .

entity:model-7net-0-oh2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-0 (7net-0)" .

entity:run-mace-mp-0-small-oh2026 a mlips:MLIPRun ;
    rdfs:label "MACE-mp-0-small as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp-0-small-oh2026 .

entity:model-mace-mp-0-small-oh2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0 small" .

entity:run-nano-45-oh2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Nano-4.5 distilled from SevenNet-Omni (mpa channel)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-omni-distill-oh2026 ;
    mlips:hasHyperparameterSetting entity:setting-nano-45-cutoffRadius-oh2026 ,
        entity:setting-nano-45-numFeatures-oh2026 ,
        entity:setting-nano-45-numLayers-oh2026 ,
        entity:setting-nano-45-numEpochs-oh2026 ;
    mlips:produces entity:model-nano-45-oh2026 .

entity:model-nano-45-oh2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Nano-4.5 (105k parameters)" .

entity:run-nano-50-oh2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Nano-5.0 distilled from SevenNet-Omni (mpa channel)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-omni-distill-oh2026 ;
    mlips:hasHyperparameterSetting entity:setting-nano-50-cutoffRadius-oh2026 ,
        entity:setting-nano-50-numFeatures-oh2026 ,
        entity:setting-nano-50-numLayers-oh2026 ,
        entity:setting-nano-50-numEpochs-oh2026 ;
    mlips:produces entity:model-nano-50-oh2026 .

entity:model-nano-50-oh2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Nano-5.0 (105k parameters)" .

entity:run-nano-55-oh2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Nano-5.5 distilled from SevenNet-Omni (mpa channel)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-omni-distill-oh2026 ;
    mlips:hasHyperparameterSetting entity:setting-nano-55-cutoffRadius-oh2026 ,
        entity:setting-nano-55-numFeatures-oh2026 ,
        entity:setting-nano-55-numLayers-oh2026 ,
        entity:setting-nano-55-numEpochs-oh2026 ;
    mlips:produces entity:model-nano-55-oh2026 .

entity:model-nano-55-oh2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Nano-5.5 (105k parameters)" .

entity:run-nano-60-oh2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Nano-6.0 distilled from SevenNet-Omni (mpa channel)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-omni-distill-oh2026 ;
    mlips:hasHyperparameterSetting entity:setting-nano-60-cutoffRadius-oh2026 ,
