entity:mat-un-chen2025predicting a mlips:MaterialSystem ;
    rdfs:label "Uranium nitride (rocksalt UN), crystalline, defective and high-temperature/amorphous configurations" ;
    mlips:chemicalFormula "UN" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-chen2025predicting a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-chen2025predicting mlips:hasDFTSettings entity:calc-settings-pbe-chen2025predicting .

entity:calc-settings-pbe-chen2025predicting a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "3x3x3" ;
    rdfs:comment "VASP 6.4.1, spin-orbit coupling, ferromagnetic ordering, no Hubbard U, Gaussian smearing 0.05 eV, 2x2x2 conventional supercell (64 atoms) (Sec. II B)." .

###############################################################################
