# Canonical Turtle for the protocol-derived encoding of:
#   Achinthya Krishna Bheemaguli et al. (2026). Evaluation of foundational machine learned interatomic potentials for migration barrier predictions.
#   Digital Discovery. doi:10.1039/d5dd00534e  arXiv:2512.03642v1
#
# Version read: arxiv-preprint arXiv:2512.03642v1 (sha256 1c95b5ebba26e1b3...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 624 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/bheemaguli2026.yaml.
#
# Encoding scope: the five universal MLIPs evaluated as distributed
# (MACE-MP-0 large, SevenNet-MF-ompa, Orb-v3-conservative-inf-omat, CHGNet
# v0.3.0, M3GNet MP-2021.2.8-EFS) in ASE NEB calculations on 60 + 574
# DFT migration barriers. All accuracy figures are migration-barrier
# errors and classification or geometry metrics, which are property
# errors, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bheemaguli2026 a mlips:BenchmarkStudy ;
    rdfs:label "Bheemaguli, Xiao and Sai Gautam (2026): foundational MLIPs for migration-barrier prediction in battery materials" ;
    mlips:reportedIn entity:article-bheemaguli2026 .

entity:article-bheemaguli2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/d5dd00534e> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Evaluation of foundational machine learned interatomic potentials for migration barrier predictions" ;
    schema:author entity:person-Bheemaguli-bheemaguli2026 ,
        entity:person-Xiao-bheemaguli2026 ,
        <https://orcid.org/0000-0002-1303-0976> .

entity:person-Bheemaguli-bheemaguli2026 a schema:Person ;
    schema:name "Achinthya Krishna Bheemaguli" ;
    schema:givenName "Achinthya Krishna" ;
    schema:familyName "Bheemaguli" .

entity:person-Xiao-bheemaguli2026 a schema:Person ;
    schema:name "Penghao Xiao" ;
    schema:givenName "Penghao" ;
    schema:familyName "Xiao" .

<https://orcid.org/0000-0002-1303-0976> a schema:Person ;
    schema:name "Gopalakrishnan Sai Gautam" ;
    schema:givenName "Gopalakrishnan" ;
    schema:familyName "Sai Gautam" ;
    schema:identifier <https://orcid.org/0000-0002-1303-0976> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ionic-bheemaguli2026 a mlips:MaterialSystem ;
    rdfs:label "Battery-relevant ionic conductors and electrodes (layered oxides, weberites, spinels, olivines, perovskites, NaSICONs and literature systems)" ;
    mlips:materialClass "inorganic ionic conductors" .

