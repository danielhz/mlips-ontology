###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-aspirin-allen2024 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule" ;
    mlips:chemicalFormula "C9H8O4" ;
    mlips:materialClass "Small organic molecule (gas phase)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q18216> .

entity:mat-organics-allen2024 a mlips:MaterialSystem ;
    rdfs:label "Organic molecules (H, C, N, O) of ANI-1x, ANI-1ccx, QMugs, GEOM, QM7-x and Transition-1x" ;
    mlips:materialClass "Organic molecules (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-asp-wb97x-allen2024 a mlips:DFTCalculation .

entity:calc-asp-b3lyp-allen2024 a mlips:DFTCalculation .

entity:calc-asp-hf-allen2024 a mlips:WaveFunctionCalculation .

entity:calc-asp-mp2-allen2024 a mlips:WaveFunctionCalculation .

entity:calc-ani1x-dz-allen2024 a mlips:DFTCalculation .

entity:calc-ani1x-tz-allen2024 a mlips:DFTCalculation .

entity:calc-ccsdt-allen2024 a mlips:WaveFunctionCalculation .

entity:calc-qmugs-dft-allen2024 a mlips:DFTCalculation .

entity:calc-geom-dft-allen2024 a mlips:DFTCalculation .

entity:calc-qm7x-dft-allen2024 a mlips:DFTCalculation .

entity:calc-t1x-dft-allen2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-asp-wb97x-allen2024 mlips:hasDFTSettings entity:calc-settings-asp-wb97x-allen2024 .

entity:calc-settings-asp-wb97x-allen2024 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G*" ;
    rdfs:comment "Aspirin 300 K structures (Sec. II C 1)." .

entity:calc-asp-b3lyp-allen2024 mlips:hasDFTSettings entity:calc-settings-asp-b3lyp-allen2024 .

entity:calc-settings-asp-b3lyp-allen2024 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-B3LYP-allen2024 ;
    mlips:basisSet "def2-TZVP" ;
    rdfs:comment "Aspirin 600 K structures (Sec. II C 1)." .

entity:calc-asp-hf-allen2024 mlips:hasWaveFunctionSettings entity:calc-settings-asp-hf-allen2024 .

entity:calc-settings-asp-hf-allen2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:HF ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "Aspirin 900 K structures (Sec. II C 1)." .

entity:calc-asp-mp2-allen2024 mlips:hasWaveFunctionSettings entity:calc-settings-asp-mp2-allen2024 .

entity:calc-settings-asp-mp2-allen2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:MP2 ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "Aspirin refit and test data (Sec. II C 1)." .

entity:calc-ani1x-dz-allen2024 mlips:hasDFTSettings entity:calc-settings-ani1x-dz-allen2024 .

entity:calc-settings-ani1x-dz-allen2024 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G*" ;
    rdfs:comment "ANI-1x (Table I); Gaussian." .

entity:calc-ani1x-tz-allen2024 mlips:hasDFTSettings entity:calc-settings-ani1x-tz-allen2024 .

entity:calc-settings-ani1x-tz-allen2024 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "def2-TZVPP" ;
    rdfs:comment "ANI-1x (Table I)." .

entity:calc-ccsdt-allen2024 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-allen2024 .

entity:calc-settings-ccsdt-allen2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "CBS" ;
    rdfs:comment "ANI-1ccx, CCSD(T)*/CBS (Table I)." .

entity:calc-qmugs-dft-allen2024 mlips:hasDFTSettings entity:calc-settings-qmugs-dft-allen2024 .

entity:calc-settings-qmugs-dft-allen2024 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-wB97X-D-allen2024 ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "QMugs (Table I)." .

entity:calc-geom-dft-allen2024 mlips:hasDFTSettings entity:calc-settings-geom-dft-allen2024 .

entity:calc-settings-geom-dft-allen2024 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-r2SCAN-3c-allen2024 ;
    mlips:basisSet "mTZVPP" ;
    rdfs:comment "GEOM (Table I)." .

entity:calc-qm7x-dft-allen2024 mlips:hasDFTSettings entity:calc-settings-qm7x-dft-allen2024 .

entity:calc-settings-qm7x-dft-allen2024 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE0 ;
    rdfs:comment "QM7-x, PBE0+MBD (Table I)." .

entity:calc-t1x-dft-allen2024 mlips:hasDFTSettings entity:calc-settings-t1x-dft-allen2024 .

entity:calc-settings-t1x-dft-allen2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "Transition-1x (Table I; ORCA, Sec. II C 3)." .

entity:xc-B3LYP-allen2024 a mlips:XCFunctional ;
    rdfs:label "B3LYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-wB97X-D-allen2024 a mlips:XCFunctional ;
    rdfs:label "wB97X-D" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-r2SCAN-3c-allen2024 a mlips:XCFunctional ;
    rdfs:label "r2SCAN-3c" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-asp-wb97x-allen2024 a mlips:TrainingDataset ;
    rdfs:label "Aspirin pre-training data, 300 K structures at wB97x/6-31G* (400)" ;
    mlips:coversMaterial entity:mat-aspirin-allen2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 400 ;
    mlips:hasDFTCalculation entity:calc-asp-wb97x-allen2024 .

entity:ds-asp-b3lyp-allen2024 a mlips:TrainingDataset ;
    rdfs:label "Aspirin pre-training data, 600 K structures at B3LYP/def2-TZVP (400)" ;
    mlips:coversMaterial entity:mat-aspirin-allen2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 400 ;
    mlips:hasDFTCalculation entity:calc-asp-b3lyp-allen2024 .

entity:ds-asp-hf-allen2024 a mlips:TrainingDataset ;
    rdfs:label "Aspirin pre-training data, 900 K structures at HF/def2-SVP (400)" ;
    mlips:coversMaterial entity:mat-aspirin-allen2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 400 ;
    mlips:hasReferenceCalculation entity:calc-asp-hf-allen2024 .

entity:ds-asp-mp2-allen2024 a mlips:TrainingDataset ;
    rdfs:label "Aspirin MP2/def2-SVP refit set (400 MD configurations at 300 K)" ;
    mlips:coversMaterial entity:mat-aspirin-allen2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 400 ;
    mlips:hasReferenceCalculation entity:calc-asp-mp2-allen2024 .

entity:ds-ani1ccx-allen2024 a mlips:TrainingDataset ;
    rdfs:label "ANI-1ccx CCSD(T)*/CBS data set (489,571 conformers)" ;
    mlips:coversMaterial entity:mat-organics-allen2024 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 489571 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-allen2024 .

entity:ds-ani1x-allen2024 a mlips:TrainingDataset ;
    rdfs:label "ANI-1x at wB97x/6-31G* and wB97x/def2-TZVPP" ;
    mlips:coversMaterial entity:mat-organics-allen2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-ani1x-dz-allen2024 ;
    rdfs:comment "Both levels of theory are used as separate tasks." .

entity:ds-multi-allen2024 a mlips:TrainingDataset ;
    rdfs:label "Organic pre-training set from ANI-1x (dz, tz), QMugs, QM7-x, GEOM and Transition-1x after three rounds of error-based selection (3,149,452 structures)" ;
    mlips:coversMaterial entity:mat-organics-allen2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 3149452 ;
    rdfs:comment "100,000 random structures per data set, extended three times with the highest-error structures (Sec. II E, SI S1.6)." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-asp-wb97x-allen2024 mlips:samplingStrategy
    entity:sampling-dftb-md-allen2024 .

entity:ds-asp-b3lyp-allen2024 mlips:samplingStrategy
    entity:sampling-dftb-md-allen2024 .

entity:ds-asp-hf-allen2024 mlips:samplingStrategy
    entity:sampling-dftb-md-allen2024 .

entity:ds-asp-mp2-allen2024 mlips:samplingStrategy
    entity:sampling-dftb-md-allen2024 .

entity:sampling-dftb-md-allen2024 a mlips:SamplingStrategy ;
    rdfs:label "DFTB molecular dynamics of aspirin at 300, 600 and 900 K (400 structures per temperature)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasLossFunction entity:loss-ANI-allen2024 ;
    mlips:hasTrainingAlgorithm entity:alg-ANI-allen2024 ;
    mlips:hasHyperparameter mlips:batchSize ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-ANI-allen2024 .

entity:loss-ANI-allen2024 a mlips:LossFunction ;
    rdfs:label "Energy and force loss" .

entity:alg-ANI-allen2024 a mls:Algorithm ;
    rdfs:label "Reptile meta-learning over data sets at different levels of theory (k steps per task, epsilon = 1); k = 1 is joint training" .

entity:impl-ANI-allen2024 a mlips:Implementation ;
    mlips:implementedIn mlips:TorchANI .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-asp-nopre-batchSize-allen2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-asp-k1-batchSize-allen2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "8"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-asp-nopre-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI trained on aspirin MP2 data without pre-training" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-asp-mp2-allen2024 ;
    mlips:hasHyperparameterSetting entity:setting-asp-nopre-batchSize-allen2024 ;
    mlips:produces entity:model-asp-nopre-allen2024 .

entity:model-asp-nopre-allen2024 a mlips:TrainedModel ;
    rdfs:label "ANI aspirin potential, no pre-training" .

entity:run-asp-k1-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI jointly pre-trained (k = 1) on the three aspirin levels of theory and refitted to MP2" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-asp-mp2-allen2024 ;
    mlips:hasHyperparameterSetting entity:setting-asp-k1-batchSize-allen2024 ;
    mlips:produces entity:model-asp-k1-allen2024 .

entity:model-asp-k1-allen2024 a mlips:TrainedModel ;
    rdfs:label "ANI aspirin potential, k = 1 pre-training" .

entity:run-ccx-meta-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI meta-learned on ANI-1x (two levels of theory) and refitted to ANI-1ccx" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1ccx-allen2024 ;
    mlips:produces entity:model-ccx-meta-allen2024 .

entity:model-ccx-meta-allen2024 a mlips:TrainedModel ;
    rdfs:label "ANI-1ccx refit after meta-learning on ANI-1x" .

entity:run-ccx-tl-dz-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI trained on ANI-1x wB97x/6-31G* and transfer-learned to ANI-1ccx" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1ccx-allen2024 ;
    mlips:produces entity:model-ccx-tl-dz-allen2024 .

entity:model-ccx-tl-dz-allen2024 a mlips:TrainedModel ;
    rdfs:label "ANI-1ccx refit after training on ANI-1x (6-31G*)" .

entity:run-ccx-tl-tz-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI trained on ANI-1x wB97x/def2-TZVPP and transfer-learned to ANI-1ccx" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1ccx-allen2024 ;
    mlips:produces entity:model-ccx-tl-tz-allen2024 .

entity:model-ccx-tl-tz-allen2024 a mlips:TrainedModel ;
    rdfs:label "ANI-1ccx refit after training on ANI-1x (def2-TZVPP)" .

entity:run-multi-meta-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI meta-learned on the six organic data sets (pre-trained model)" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-multi-allen2024 ;
    mlips:produces entity:model-multi-meta-allen2024 .

entity:model-multi-meta-allen2024 a mlips:TrainedModel ;
    rdfs:label "Meta-learning organic pre-trained ANI potential" .

entity:run-ccx-multi-meta-allen2024 a mlips:MLIPRun ;
    rdfs:label "Meta-learned organic ANI potential refitted to ANI-1ccx" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1ccx-allen2024 ;
    mlips:produces entity:model-ccx-multi-meta-allen2024 .

entity:model-ccx-multi-meta-allen2024 a mlips:TrainedModel ;
    rdfs:label "ANI-1ccx refit after organic meta-learning" .

entity:run-ccx-multi-k1-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI jointly pre-trained (k = 1) on the six organic data sets and refitted to ANI-1ccx" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1ccx-allen2024 ;
    mlips:produces entity:model-ccx-multi-k1-allen2024 .

entity:model-ccx-multi-k1-allen2024 a mlips:TrainedModel ;
    rdfs:label "ANI-1ccx refit after organic k = 1 pre-training" .

entity:run-s1-ani1x-dz-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI pre-trained on 10,000 structures of ANI-1x dz (wB97x/6-31G*) and refitted to CCSD(T) (Table S1)" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1ccx-allen2024 ;
    mlips:produces entity:model-s1-ani1x-dz-allen2024 .

entity:model-s1-ani1x-dz-allen2024 a mlips:TrainedModel ;
    rdfs:label "CCSD(T) refit after pre-training on ANI-1x dz (wB97x/6-31G*)" .

entity:run-s1-ani1x-tz-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI pre-trained on 10,000 structures of ANI-1x tz (wB97x/def2-TZVPP) and refitted to CCSD(T) (Table S1)" ;
    mlips:appliesMethod entity:ANI ;
