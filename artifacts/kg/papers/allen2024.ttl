entity:run-s1-t1x-allen2024 a mlips:MLIPRun ;
    rdfs:label "ANI pre-trained on 10,000 structures of Transition-1x and refitted to CCSD(T) (Table S1)" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-ani1ccx-allen2024 ;
