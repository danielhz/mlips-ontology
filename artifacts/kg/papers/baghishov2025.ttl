###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:qSNAP a mlips:MLIPMethod ;
    rdfs:label "Quadratic Spectral Neighbor Analysis Potential (qSNAP)" ;
    mlips:hasFunctionalForm entity:ff-qSNAP ;
    mlips:hasLossFunction entity:loss-qSNAP-baghishov2025 ;
    mlips:hasTrainingAlgorithm entity:alg-qSNAP-baghishov2025 ;
    mlips:hasHyperparameter entity:hp-twoJmax-baghishov2025 ;
    mlips:hasImplementation entity:impl-qSNAP-baghishov2025 .

entity:ff-qSNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components plus all their distinct pairwise products" .

entity:loss-qSNAP-baghishov2025 a mlips:LossFunction ;
    rdfs:label "Weighted least squares on per-atom energies and force components (Eq. 1); energy:force weights 150:1 or 12:1" .

entity:alg-qSNAP-baghishov2025 a mls:Algorithm ;
    rdfs:label "Linear least squares (weighted), descriptors from FitSNAP" .

entity:impl-qSNAP-baghishov2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-FitSNAP-baghishov2025 .

entity:lib-FitSNAP-baghishov2025 a mlips:Library ;
    rdfs:label "FitSNAP" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-twoJmax-baghishov2025 a mlips:Hyperparameter ;
    rdfs:label "SNAP/qSNAP angular order 2Jmax of the bispectrum expansion" ;
    mlips:hyperparameterName "2Jmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

