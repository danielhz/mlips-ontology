entity:run-sevennet-0-lebeda2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 as distributed (version not stated)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-sevennet-0-lebeda2026 .

entity:model-sevennet-0-lebeda2026 a mlips:TrainedModel ;
