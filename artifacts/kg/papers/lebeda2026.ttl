entity:run-mace-matpes-lebeda2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MATPES-PBE-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-matpes-lebeda2026 .

entity:model-mace-matpes-lebeda2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MATPES-PBE-0" .

entity:run-orb-v3-lebeda2026 a mlips:MLIPRun ;
