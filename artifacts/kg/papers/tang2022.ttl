# Canonical Turtle for the protocol-derived encoding of:
#   Jialin Tang et al. (2022). Machine Learning Interatomic Potential for Anisotropic Thermal Transport in Bulk Hexagonal Boron Nitride.
#   arXiv (Cornell University). doi:10.48550/arxiv.2208.10082  arXiv:2208.10082v1
#
# Version read: arxiv-preprint arXiv:2208.10082v1 (sha256 5e7899f4ced97232...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 589 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/tang2022.yaml.
#
# Encoding scope: the GAP for bulk h-BN (2b, 3b and SOAP descriptors,
# 4.5 A cutoff) trained on 200 LDA AIMD snapshots of a 200-atom
# supercell, with training and test RMSEs; the published multi-phase
# h-BN GAP (GAP-Ref, as distributed) evaluated on the same test set; MD
# cost. Thermal conductivities and phonons are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-tang2022 a mlips:BenchmarkStudy ;
    rdfs:label "Tang et al. (2022): a GAP for anisotropic thermal transport in bulk hexagonal boron nitride" ;
    mlips:reportedIn entity:article-tang2022 .

entity:article-tang2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2208.10082> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Machine Learning Interatomic Potential for Anisotropic Thermal Transport in Bulk Hexagonal Boron Nitride" ;
    schema:author entity:person-Tang-tang2022 ,
        entity:person-Wang-tang2022 ,
        entity:person-Zheng-tang2022 ,
        entity:person-Cheng-tang2022 ,
        entity:person-Guo-tang2022 .

entity:person-Tang-tang2022 a schema:Person ;
    schema:name "Jialin Tang" ;
    schema:givenName "Jialin" ;
    schema:familyName "Tang" .

entity:person-Wang-tang2022 a schema:Person ;
    schema:name "Qi Wang" ;
    schema:givenName "Qi" ;
    schema:familyName "Wang" .

entity:person-Zheng-tang2022 a schema:Person ;
    schema:name "Jiongzhi Zheng" ;
    schema:givenName "Jiongzhi" ;
    schema:familyName "Zheng" .

entity:person-Cheng-tang2022 a schema:Person ;
    schema:name "Lin Cheng" ;
    schema:givenName "Lin" ;
    schema:familyName "Cheng" .

entity:person-Guo-tang2022 a schema:Person ;
    schema:name "Ruiqiang Guo" ;
    schema:givenName "Ruiqiang" ;
    schema:familyName "Guo" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-hbn-tang2022 a mlips:MaterialSystem ;
    rdfs:label "Bulk hexagonal boron nitride (5x5x2 supercell, 200 atoms)" ;
    mlips:chemicalFormula "BN" ;
    mlips:materialClass "2D material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-lda-tang2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-lda-tang2022 mlips:hasDFTSettings entity:calc-settings-lda-tang2022 .

entity:calc-settings-lda-tang2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:LDA ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "2x2x2 for labels" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-hbn-tang2022 a mlips:TrainingDataset ;
    rdfs:label "h-BN training database (200 configurations)" ;
    mlips:coversMaterial entity:mat-hbn-tang2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 200 ;
    mlips:hasDFTCalculation entity:calc-lda-tang2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-hbn-tang2022 mlips:samplingStrategy
    entity:sampling-aimd-tang2022 .

entity:sampling-aimd-tang2022 a mlips:SamplingStrategy ;
    rdfs:label "NVT AIMD at 300 K, one snapshot every 75 steps, relabelled with SCF calculations" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:loss-GAP-tang2022 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-GAP-tang2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-GAP-tang2022 a mlips:LossFunction ;
    rdfs:label "Energies and forces (virials in the GAP-Stress variant)" .

entity:impl-GAP-tang2022 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-cutoffRadius-tang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-tang2022 a mlips:MLIPRun ;
    rdfs:label "GAP for bulk h-BN" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-hbn-tang2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-cutoffRadius-tang2022 ;
    mlips:produces entity:model-gap-tang2022 .

entity:model-gap-tang2022 a mlips:TrainedModel ;
    rdfs:label "GAP h-BN (Tang 2022)" .

entity:run-gapref-tang2022 a mlips:MLIPRun ;
    rdfs:label "GAP-Ref: multi-phase h-BN GAP of Ref. 61 (as distributed)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:produces entity:model-gapref-tang2022 .

entity:model-gapref-tang2022 a mlips:TrainedModel ;
    rdfs:label "GAP-Ref h-BN (Ref. 61)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-tang2022 mlips:hasResult
    entity:result-gap-train-tang2022 ,
    entity:result-gap-test-tang2022 ,
    entity:result-gapref-test-tang2022 .

entity:result-gap-train-tang2022 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-tang2022 ;
    mlips:targetMaterial entity:mat-hbn-tang2022 ;
    mlips:hasAccuracyMetric entity:metric-gap-train-1-tang2022 ,
        entity:metric-gap-train-2-tang2022 ,
        entity:metric-gap-train-3-tang2022 .

entity:metric-gap-train-1-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "training energy RMSE on h-BN: GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.052"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-gap-train-2-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "training force RMSE on B atoms in h-BN: GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.01"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:metric-gap-train-3-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "training force RMSE on N atoms in h-BN: GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.009"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:result-gap-test-tang2022 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-tang2022 ;
    mlips:targetMaterial entity:mat-hbn-tang2022 ;
    mlips:hasAccuracyMetric entity:metric-gap-test-1-tang2022 ,
        entity:metric-gap-test-2-tang2022 ,
        entity:metric-gap-test-3-tang2022 ;
    mlips:inferenceTimePerAtom "3500"^^xsd:double ;
    mlips:inferenceHardware "One Intel Xeon Gold 6254 CPU (18 cores); AIMD 111.2 s (1x1x1 k) and 1742.9 s (2x2x2 k) per step" .

entity:metric-gap-test-1-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on h-BN: GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.051"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-gap-test-2-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on B atoms in h-BN: GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.01"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:metric-gap-test-3-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on N atoms in h-BN: GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.009"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:result-gapref-test-tang2022 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gapref-tang2022 ;
    mlips:targetMaterial entity:mat-hbn-tang2022 ;
    mlips:hasAccuracyMetric entity:metric-gapref-test-1-tang2022 ,
        entity:metric-gapref-test-2-tang2022 .

entity:metric-gapref-test-1-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "force RMSE on B atoms in bulk h-BN: GAP-Ref" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.096"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:metric-gapref-test-2-tang2022 a mlips:AccuracyMetric ;
    rdfs:label "force RMSE on N atoms in bulk h-BN: GAP-Ref" ;
