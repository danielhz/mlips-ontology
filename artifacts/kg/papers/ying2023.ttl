# Canonical Turtle for the protocol-derived encoding of:
#   Penghua Ying et al. (2023). Combining the D3 dispersion correction with the neuroevolution machine-learned potential.
#   Journal of Physics Condensed Matter. doi:10.1088/1361-648x/ad1278  arXiv:2310.05279v1
#
# Version read: arxiv-preprint arXiv:2310.05279v1 (sha256 f7f3941d7878adb2...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 700 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ying2023.yaml.
#
# Encoding scope: the bilayer-graphene NEP-D3 model (NEP trained on PBE
# data with cutoffs 4.5/4.5 A, plus the GPUMD D3 correction) and three pure
# NEP models trained on PBE-D3 data with radial cutoffs 6, 8 and 10 A,
# with their RMSEs against the PBE-D3 reference and MD speeds (Table I).
# The D3 implementation check on MOFs and thermal conductivities are not
# MLIP metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ying2023 a mlips:BenchmarkStudy ;
    rdfs:label "Ying and Fan (2023): combining the D3 dispersion correction with the neuroevolution potential (NEP-D3)" ;
    mlips:reportedIn entity:article-ying2023 .

entity:article-ying2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1361-648x/ad1278> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Combining the D3 dispersion correction with the neuroevolution machine-learned potential" ;
    schema:author <https://orcid.org/0000-0002-5758-2369> ,
        <https://orcid.org/0000-0002-2253-8210> .

<https://orcid.org/0000-0002-5758-2369> a schema:Person ;
    schema:name "Penghua Ying" ;
    schema:givenName "Penghua" ;
    schema:familyName "Ying" ;
    schema:identifier <https://orcid.org/0000-0002-5758-2369> .

<https://orcid.org/0000-0002-2253-8210> a schema:Person ;
    schema:name "Zheyong Fan" ;
    schema:givenName "Zheyong" ;
    schema:familyName "Fan" ;
    schema:identifier <https://orcid.org/0000-0002-2253-8210> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-blg-ying2023 a mlips:MaterialSystem ;
    rdfs:label "Bilayer graphene with interlayer distances 2-10 A and lateral shifts (AA, AB, saddle point), plus MD structures at 300-1500 K" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "layered 2D carbon" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-ying2023 a mlips:DFTCalculation .

entity:calc-pbe-d3-ying2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-ying2023 mlips:hasDFTSettings entity:calc-settings-pbe-ying2023 .

entity:calc-settings-pbe-ying2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "850"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, k-spacing 0.15 1/A" ;
    rdfs:comment "Gaussian smearing 0.1 eV; SCF 1e-7 eV." .

entity:calc-pbe-d3-ying2023 mlips:hasDFTSettings entity:calc-settings-pbe-d3-ying2023 .

entity:calc-settings-pbe-d3-ying2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-D3-ying2023 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "850"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, k-spacing 0.15 1/A" ;
    rdfs:comment "IVDW = 12 (D3 with Becke-Johnson damping)." .

entity:xc-PBE-D3-ying2023 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-blg-pbe-ying2023 a mlips:TrainingDataset ;
    rdfs:label "Bilayer graphene data with PBE labels" ;
    mlips:coversMaterial entity:mat-blg-ying2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-ying2023 .

entity:ds-blg-pbed3-ying2023 a mlips:TrainingDataset ;
    rdfs:label "Bilayer graphene data with PBE-D3 labels" ;
    mlips:coversMaterial entity:mat-blg-ying2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-ying2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-blg-pbe-ying2023 mlips:samplingStrategy
    entity:sampling-blg-ying2023 .

entity:ds-blg-pbed3-ying2023 mlips:samplingStrategy
    entity:sampling-blg-ying2023 .

entity:sampling-blg-ying2023 a mlips:SamplingStrategy ;
    rdfs:label "Bilayer configurations over interlayer distance and stacking, plus REBO + registry-dependent ILP MD snapshots (300-1500 K)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-ying2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NEP-ying2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-NEP-ying2023 a mls:Algorithm ;
    rdfs:label "Separable natural evolution strategy (population 50, 300,000 generations); NEP-D3 adds a GPUMD D3(BJ) term with R_pot = 12 A and R_cn = 6 A" .

entity:impl-NEP-ying2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-ying2023 .

entity:lib-GPUMD-ying2023 a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nep-d3-cutoffRadius-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-nep-d3-batchSize-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "10000"^^xsd:integer .

entity:setting-nep-6-cutoffRadius-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-nep-6-batchSize-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "10000"^^xsd:integer .

entity:setting-nep-8-cutoffRadius-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:double .

entity:setting-nep-8-batchSize-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "10000"^^xsd:integer .

entity:setting-nep-10-cutoffRadius-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "10"^^xsd:double .

entity:setting-nep-10-batchSize-ying2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "10000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nep-d3-ying2023 a mlips:MLIPRun ;
    rdfs:label "NEP(4.5 A, 4.5 A)-D3: NEP trained on PBE data plus D3 correction" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-blg-pbe-ying2023 ;
    mlips:hasHyperparameterSetting entity:setting-nep-d3-cutoffRadius-ying2023 ,
        entity:setting-nep-d3-batchSize-ying2023 ;
    mlips:produces entity:model-nep-d3-ying2023 .

entity:model-nep-d3-ying2023 a mlips:TrainedModel ;
    rdfs:label "NEP(4.5,4.5)-D3 bilayer graphene" .

entity:run-nep-6-ying2023 a mlips:MLIPRun ;
    rdfs:label "NEP(6.0 A, 4.5 A) trained on PBE-D3 data" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-blg-pbed3-ying2023 ;
    mlips:hasHyperparameterSetting entity:setting-nep-6-cutoffRadius-ying2023 ,
        entity:setting-nep-6-batchSize-ying2023 ;
    mlips:produces entity:model-nep-6-ying2023 .

entity:model-nep-6-ying2023 a mlips:TrainedModel ;
    rdfs:label "NEP(6.0,4.5) bilayer graphene (PBE-D3)" .

entity:run-nep-8-ying2023 a mlips:MLIPRun ;
    rdfs:label "NEP(8.0 A, 4.5 A) trained on PBE-D3 data" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-blg-pbed3-ying2023 ;
    mlips:hasHyperparameterSetting entity:setting-nep-8-cutoffRadius-ying2023 ,
        entity:setting-nep-8-batchSize-ying2023 ;
    mlips:produces entity:model-nep-8-ying2023 .

entity:model-nep-8-ying2023 a mlips:TrainedModel ;
    rdfs:label "NEP(8.0,4.5) bilayer graphene (PBE-D3)" .

entity:run-nep-10-ying2023 a mlips:MLIPRun ;
    rdfs:label "NEP(10.0 A, 4.5 A) trained on PBE-D3 data" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-blg-pbed3-ying2023 ;
    mlips:hasHyperparameterSetting entity:setting-nep-10-cutoffRadius-ying2023 ,
        entity:setting-nep-10-batchSize-ying2023 ;
    mlips:produces entity:model-nep-10-ying2023 .

entity:model-nep-10-ying2023 a mlips:TrainedModel ;
