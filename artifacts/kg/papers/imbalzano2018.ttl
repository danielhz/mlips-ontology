# Canonical Turtle for the protocol-derived encoding of:
#   Giulio Imbalzano et al. (2018). Automatic selection of atomic fingerprints and reference configurations for machine-learning potentials.
#   The Journal of Chemical Physics. doi:10.1063/1.5024611  arXiv:1804.02150v1
#
# Version read: arxiv-preprint arXiv:1804.02150v1 (sha256 5611f96eea217048...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 601 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/imbalzano2018.yaml.
#
# Encoding scope: the Behler-Parrinello neural-network potentials (RuNNer)
# for liquid water and Al-Si-Mg alloys trained with automatically selected
# (CUR) symmetry functions and with the published hand-chosen sets, with
# the test RMSEs of Tables I and II and the water MD cost per step. The
# SOAP-GPR feature-selection study on QM7b atomization energies is a
# molecular-property regression, not a potential, and is not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-imbalzano2018 a mlips:BenchmarkStudy ;
    rdfs:label "Imbalzano et al. (2018): automatic selection of atomic fingerprints and reference configurations for ML potentials" ;
    mlips:reportedIn entity:article-imbalzano2018 .

entity:article-imbalzano2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/1.5024611> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Automatic selection of atomic fingerprints and reference configurations for machine-learning potentials" ;
    schema:author entity:person-Imbalzano-imbalzano2018 ,
        <https://orcid.org/0000-0001-9230-1342> ,
        <https://orcid.org/0000-0002-8211-9392> ,
        entity:person-Klees-imbalzano2018 ,
        <https://orcid.org/0000-0002-1220-1542> ,
        <https://orcid.org/0000-0003-2571-2832> .

entity:person-Imbalzano-imbalzano2018 a schema:Person ;
    schema:name "Giulio Imbalzano" ;
    schema:givenName "Giulio" ;
    schema:familyName "Imbalzano" .

<https://orcid.org/0000-0001-9230-1342> a schema:Person ;
    schema:name "Andrea Anelli" ;
    schema:givenName "Andrea" ;
    schema:familyName "Anelli" ;
    schema:identifier <https://orcid.org/0000-0001-9230-1342> .

<https://orcid.org/0000-0002-8211-9392> a schema:Person ;
    schema:name "Daniele Giofré" ;
    schema:givenName "Daniele" ;
    schema:familyName "Giofré" ;
    schema:identifier <https://orcid.org/0000-0002-8211-9392> .

entity:person-Klees-imbalzano2018 a schema:Person ;
    schema:name "Sinja Klees" ;
    schema:givenName "Sinja" ;
    schema:familyName "Klees" .

<https://orcid.org/0000-0002-1220-1542> a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" ;
    schema:identifier <https://orcid.org/0000-0002-1220-1542> .

<https://orcid.org/0000-0003-2571-2832> a schema:Person ;
    schema:name "Michele Ceriotti" ;
    schema:givenName "Michele" ;
    schema:familyName "Ceriotti" ;
    schema:identifier <https://orcid.org/0000-0003-2571-2832> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-imbalzano2018 a mlips:MaterialSystem ;
    rdfs:label "Liquid water" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid" .

entity:mat-alsimg-imbalzano2018 a mlips:MaterialSystem ;
    rdfs:label "Al-Si-Mg alloys (Al-6xxx), including beta''-phase precipitates and interfaces" ;
    mlips:materialClass "aluminium alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-water-dft-imbalzano2018 a mlips:DFTCalculation .

entity:calc-alsimg-dft-imbalzano2018 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-water-dft-imbalzano2018 mlips:hasDFTSettings entity:calc-settings-water-dft-imbalzano2018 .

entity:calc-settings-water-dft-imbalzano2018 a mlips:DFTSettings ;
    rdfs:comment "DFT reference data set of Refs. 25 and 45 (settings not restated)." .

entity:calc-alsimg-dft-imbalzano2018 mlips:hasDFTSettings entity:calc-settings-alsimg-dft-imbalzano2018 .

entity:calc-settings-alsimg-dft-imbalzano2018 a mlips:DFTSettings ;
    rdfs:comment "DFT settings of Refs. 51 and 52 (Kobayashi et al.); not restated." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-water-fps-imbalzano2018 a mlips:TrainingDataset ;
    rdfs:label "1000 FPS-selected liquid-water structures from the data set of Ref. 25 (3:1 train:test split)" ;
    mlips:coversMaterial entity:mat-water-imbalzano2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-water-dft-imbalzano2018 .

entity:ds-alsimg-fps-imbalzano2018 a mlips:TrainingDataset ;
    rdfs:label "2000 FPS-selected Al-Si-Mg structures from the 10,551 structures of Ref. 51 plus 609 precipitate/interface structures of Ref. 52" ;
    mlips:coversMaterial entity:mat-alsimg-imbalzano2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 2000 ;
    mlips:hasDFTCalculation entity:calc-alsimg-dft-imbalzano2018 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-water-fps-imbalzano2018 mlips:samplingStrategy
    entity:sampling-fps-imbalzano2018 .

entity:ds-alsimg-fps-imbalzano2018 mlips:samplingStrategy
    entity:sampling-fps-imbalzano2018 .

entity:sampling-fps-imbalzano2018 a mlips:SamplingStrategy ;
    rdfs:label "Farthest-point sampling of a published structure pool (1000 water structures; 2000 of 11,160 Al-Si-Mg structures)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-imbalzano2018 ;
    mlips:hasHyperparameter mlips:numFeatures ;
    mlips:hasImplementation entity:impl-HDNNP-imbalzano2018 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:alg-HDNNP-imbalzano2018 a mls:Algorithm ;
    rdfs:label "Atomic NNs with two hidden layers of 20 neurons; symmetry functions selected by CUR decomposition from a pool of G2/G3 functions" .

entity:impl-HDNNP-imbalzano2018 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-w-cur64-numFeatures-imbalzano2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-w-default-numFeatures-imbalzano2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "36"^^xsd:integer .

entity:setting-a-cur64-numFeatures-imbalzano2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-a-ref51-numFeatures-imbalzano2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "40"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-w-cur64-imbalzano2018 a mlips:MLIPRun ;
    rdfs:label "Water HDNNP with 64 CUR-selected SFs per element" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-water-fps-imbalzano2018 ;
    mlips:hasHyperparameterSetting entity:setting-w-cur64-numFeatures-imbalzano2018 ;
    mlips:produces entity:model-w-cur64-imbalzano2018 .

entity:model-w-cur64-imbalzano2018 a mlips:TrainedModel ;
    rdfs:label "Water NNP (CUR, 64+64 SFs)" .

entity:run-w-default-imbalzano2018 a mlips:MLIPRun ;
    rdfs:label "Water HDNNP with the default SF set (36 SFs per element)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-water-fps-imbalzano2018 ;
    mlips:hasHyperparameterSetting entity:setting-w-default-numFeatures-imbalzano2018 ;
    mlips:produces entity:model-w-default-imbalzano2018 .

entity:model-w-default-imbalzano2018 a mlips:TrainedModel ;
    rdfs:label "Water NNP (default SF set)" .

entity:run-w-ref45-imbalzano2018 a mlips:MLIPRun ;
    rdfs:label "Water HDNNP with the SF set of Ref. 45 (30 O, 27 H)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-water-fps-imbalzano2018 ;
    mlips:produces entity:model-w-ref45-imbalzano2018 .

entity:model-w-ref45-imbalzano2018 a mlips:TrainedModel ;
    rdfs:label "Water NNP (SFs of Ref. 45)" .

entity:run-a-cur64-imbalzano2018 a mlips:MLIPRun ;
    rdfs:label "Al-Si-Mg HDNNP with 64 CUR-selected SFs per species" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-alsimg-fps-imbalzano2018 ;
    mlips:hasHyperparameterSetting entity:setting-a-cur64-numFeatures-imbalzano2018 ;
    mlips:produces entity:model-a-cur64-imbalzano2018 .

entity:model-a-cur64-imbalzano2018 a mlips:TrainedModel ;
    rdfs:label "Al-Si-Mg NNP (CUR, 64 SFs per species)" .

entity:run-a-ref51-imbalzano2018 a mlips:MLIPRun ;
    rdfs:label "Al-Si-Mg HDNNP with the G2-only SF set of Ref. 51 (40 per species), re-optimized" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-alsimg-fps-imbalzano2018 ;
    mlips:hasHyperparameterSetting entity:setting-a-ref51-numFeatures-imbalzano2018 ;
    mlips:produces entity:model-a-ref51-imbalzano2018 .

entity:model-a-ref51-imbalzano2018 a mlips:TrainedModel ;
    rdfs:label "Al-Si-Mg NNP (SFs of Ref. 51)" .

