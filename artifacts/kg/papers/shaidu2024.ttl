# Canonical Turtle for the protocol-derived encoding of:
#   Yusuf Shaidu et al. (2024). Incorporating long-range electrostatics in neural network potentials via variational charge equilibration from shortsighted ingredients.
#   npj Computational Materials. doi:10.1038/s41524-024-01225-6
#
# Version read: publisher (sha256 06357e847a0ef15f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 446 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/shaidu2024.yaml.
#
# Encoding scope: short-range (SR, 2G-like) and long-range (LR) PANNA
# potentials, the LR model trained with Hirshfeld-charge targets
# (gamma_q > 0) or without (gamma_q = 0), on the four 4G-HDNNP benchmark
# data sets of Ref. 20 (Tables 1-4), on a molten-NaCl data set (Ref. 11)
# and on Li adsorbed on graphene, with the training and validation RMSEs
# stated. Rows for 2G- and 4G-HDNNP in Tables 1-4 are quoted from Ref. 20
# and not encoded. Charges in milli-e are not energy/force metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-shaidu2024 a mlips:BenchmarkStudy ;
    rdfs:label "Shaidu et al. (2024): long-range electrostatics in neural-network potentials via variational charge equilibration from short-range ingredients" ;
    mlips:reportedIn entity:article-shaidu2024 .

entity:article-shaidu2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-024-01225-6> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Incorporating long-range electrostatics in neural network potentials via variational charge equilibration from shortsighted ingredients" ;
    schema:author <https://orcid.org/0000-0001-9378-3910> ,
        entity:person-Pellegrini-shaidu2024 ,
        entity:person-Kucukbenli-shaidu2024 ,
        entity:person-Lot-shaidu2024 ,
        <https://orcid.org/0000-0002-2307-0998> .

<https://orcid.org/0000-0001-9378-3910> a schema:Person ;
    schema:name "Yusuf Shaidu" ;
    schema:givenName "Yusuf" ;
    schema:familyName "Shaidu" ;
    schema:identifier <https://orcid.org/0000-0001-9378-3910> .

entity:person-Pellegrini-shaidu2024 a schema:Person ;
    schema:name "Franco Pellegrini" ;
    schema:givenName "Franco" ;
    schema:familyName "Pellegrini" .

entity:person-Kucukbenli-shaidu2024 a schema:Person ;
    schema:name "Emine Küçükbenli" ;
    schema:givenName "Emine" ;
    schema:familyName "Küçükbenli" .

entity:person-Lot-shaidu2024 a schema:Person ;
