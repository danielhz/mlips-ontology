    schema:givenName "Stefano" ;
    schema:familyName "de Gironcoli" ;
    schema:identifier <https://orcid.org/0000-0002-2307-0998> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cc-shaidu2024 a mlips:MaterialSystem ;
    rdfs:label "Carbon chains C10H2 and C10H3+" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-ag-shaidu2024 a mlips:MaterialSystem ;
    rdfs:label "Silver trimers Ag3+ and Ag3-" ;
    mlips:materialClass "Metal cluster" .

entity:mat-nacl-shaidu2024 a mlips:MaterialSystem ;
    rdfs:label "NaCl clusters Na9Cl8+ and Na8Cl8" ;
    mlips:materialClass "Metal cluster" .

entity:mat-au-shaidu2024 a mlips:MaterialSystem ;
    rdfs:label "Au dimer on MgO(001)" ;
    mlips:materialClass "Supported metal nanoparticle catalyst / oxide surface" .

entity:mat-molten-shaidu2024 a mlips:MaterialSystem ;
    rdfs:label "Crystalline and molten NaCl and NaCl dimers" ;
    mlips:chemicalFormula "NaCl" ;
    mlips:materialClass "Molten salt" .

entity:mat-ligr-shaidu2024 a mlips:MaterialSystem ;
    rdfs:label "Li adsorbed on graphene" ;
    mlips:materialClass "2D material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ref20-shaidu2024 a mlips:DFTCalculation .

entity:calc-ref11-shaidu2024 a mlips:DFTCalculation .

entity:calc-ligr-dft-shaidu2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ref20-shaidu2024 mlips:hasDFTSettings entity:calc-settings-ref20-shaidu2024 .

entity:calc-settings-ref20-shaidu2024 a mlips:DFTSettings ;
    rdfs:comment "Reference energies, forces and Hirshfeld charges of the 4G-HDNNP benchmark sets (Ref. 20)." .

entity:calc-ref11-shaidu2024 mlips:hasDFTSettings entity:calc-settings-ref11-shaidu2024 .

entity:calc-settings-ref11-shaidu2024 a mlips:DFTSettings ;
    rdfs:comment "Molten-NaCl data set of Ref. 11 (no atomic charges)." .

entity:calc-ligr-dft-shaidu2024 mlips:hasDFTSettings entity:calc-settings-ligr-dft-shaidu2024 .

entity:calc-settings-ligr-dft-shaidu2024 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Li/graphene data; details in Supplementary Note 3." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cc-shaidu2024 a mlips:TrainingDataset ;
