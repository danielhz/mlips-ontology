###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasImplementation entity:impl-HDNNP-shaidu2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-HDNNP-shaidu2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PANNA-shaidu2024 .

entity:PANNA-LR a mlips:MLIPMethod ;
    rdfs:label "Long-range neural-network potential with variational charge equilibration from short-range ingredients (PANNA long-range model)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-PANNA-LR-shaidu2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-PANNA-LR-shaidu2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PANNA-shaidu2024 .

entity:lib-PANNA-shaidu2024 a mlips:Library ;
    rdfs:label "PANNA" ;
    mlips:candidateForVocabulary mlips:Library .

