###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Si-fan2021 a mlips:MaterialSystem ;
    rdfs:label "Silicon, general purpose (bulk crystals, liquid, amorphous, surfaces, defects)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental semiconductor" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q670> .

entity:mat-silicene-fan2021 a mlips:MaterialSystem ;
    rdfs:label "Two-dimensional silicene (60-atom rectangular cells)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "2D material" .

entity:mat-PbTe-fan2021 a mlips:MaterialSystem ;
    rdfs:label "Bulk lead telluride (250-atom cells)" ;
    mlips:chemicalFormula "PbTe" ;
    mlips:materialClass "Ionic semiconductor crystal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-silicene-dft-fan2021 a mlips:DFTCalculation .

entity:calc-pbte-dft-fan2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-silicene-dft-fan2021 mlips:hasDFTSettings entity:calc-settings-silicene-dft-fan2021 .

entity:calc-settings-silicene-dft-fan2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:energyCutoff "40"^^xsd:double ;
    mlips:kPointMesh "3x3x1" ;
    rdfs:comment "Optimised norm-conserving Vanderbilt pseudopotential; energy cutoff 40 Ry; SCF threshold 1e-10 Ry." .

entity:calc-pbte-dft-fan2021 mlips:hasDFTSettings entity:calc-settings-pbte-dft-fan2021 .

entity:calc-settings-pbte-dft-fan2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "1x1x1" ;
    rdfs:comment "Energy cutoff 400 eV; SCF threshold 1e-7 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Si-fan2021 a mlips:TrainingDataset ;
    rdfs:label "General-purpose silicon data set of Ref. [47] (2,475 structures)" ;
    mlips:coversMaterial entity:mat-Si-fan2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 2475 .

entity:ds-silicene-fan2021 a mlips:TrainingDataset ;
    rdfs:label "2D silicene training set (914 cells of 60 atoms)" ;
    mlips:coversMaterial entity:mat-silicene-fan2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 914 ;
    mlips:hasDFTCalculation entity:calc-silicene-dft-fan2021 .

entity:ds-PbTe-fan2021 a mlips:TrainingDataset ;
    rdfs:label "Bulk PbTe training set (325 cells of 250 atoms)" ;
    mlips:coversMaterial entity:mat-PbTe-fan2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 325 ;
    mlips:hasDFTCalculation entity:calc-pbte-dft-fan2021 ;
    rdfs:comment "Also used for a GAP-SOAP potential in Ref. [59]; virials not used." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-silicene-fan2021 mlips:samplingStrategy
    entity:sampling-silicene-al-fan2021 .

entity:ds-PbTe-fan2021 mlips:samplingStrategy
    entity:sampling-pbte-md-fan2021 .

entity:sampling-silicene-al-fan2021 a mlips:SamplingStrategy ;
    rdfs:label "MTP active learning over 100-900 K and -1% to 1% biaxial strain" ;
    rdfs:comment "Selection threshold gamma_select = 2; stopped when six independent 10 ps MD runs selected nothing (mlip package)." .

entity:sampling-pbte-md-fan2021 a mlips:SamplingStrategy ;
    rdfs:label "DFT-MD at 300-900 K plus random displacements" ;
    rdfs:comment "305 cells from DFT-MD and 20 cells with small random displacements from hiphive." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-fan2021 ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-fan2021 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        entity:hp-Nneu-fan2021 ,
        entity:hp-Ngen-fan2021 ;
    mlips:hasImplementation entity:impl-NEP-fan2021 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NEP-fan2021 a mlips:LossFunction ;
    rdfs:label "Energy, force and virial RMSEs plus L1 and L2 regularisation (lambda1 = lambda2 = 0.05)" .

entity:alg-NEP-fan2021 a mls:Algorithm ;
    rdfs:label "Separable natural evolution strategy (SNES), population 50" .

entity:impl-NEP-fan2021 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-fan2021 .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-fan2021 .

entity:impl-GAP-fan2021 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-MTP-fan2021 .

entity:impl-MTP-fan2021 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-DeePMD-fan2021 .

entity:impl-DeePMD-fan2021 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:lib-GPUMD-fan2021 a mlips:Library ;
    rdfs:label "GPUMD" ;
    rdfs:comment "nep executable in the open-source gpumd package; GPU only" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Nneu-fan2021 a mlips:Hyperparameter ;
    rdfs:label "NEP number of neurons in the single hidden layer N_neu" ;
    mlips:hyperparameterName "N_neu" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-Ngen-fan2021 a mlips:Hyperparameter ;
    rdfs:label "NEP maximum number of generations of the natural evolution strategy N_gen" ;
    mlips:hyperparameterName "N_gen" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nep-Si-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-nep-Si-angularCutoff-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-nep-Si-Nneu-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Nneu-fan2021 ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-nep-Si-Ngen-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Ngen-fan2021 ;
    mlips:settingValue "200000"^^xsd:integer .

entity:setting-nep-silicene-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-nep-silicene-angularCutoff-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-nep-silicene-Nneu-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Nneu-fan2021 ;
    mlips:settingValue "40"^^xsd:integer .

entity:setting-nep-silicene-Ngen-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Ngen-fan2021 ;
    mlips:settingValue "200000"^^xsd:integer .

entity:setting-nep-PbTe-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-nep-PbTe-angularCutoff-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-nep-PbTe-Nneu-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Nneu-fan2021 ;
    mlips:settingValue "40"^^xsd:integer .

entity:setting-nep-PbTe-Ngen-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Ngen-fan2021 ;
    mlips:settingValue "200000"^^xsd:integer .

entity:setting-gap-PbTe-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-gap-PbTe-numSparseConfigs-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "600"^^xsd:integer .

entity:setting-mtp-silicene-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-dp-Si-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-dp-silicene-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-dp-PbTe-cutoffRadius-fan2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nep-Si-fan2021 a mlips:MLIPRun ;
    rdfs:label "NEP fit to general-purpose silicon" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-Si-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-nep-Si-cutoffRadius-fan2021 ,
        entity:setting-nep-Si-angularCutoff-fan2021 ,
        entity:setting-nep-Si-Nneu-fan2021 ,
        entity:setting-nep-Si-Ngen-fan2021 ;
    mlips:produces entity:model-nep-Si-fan2021 .

entity:model-nep-Si-fan2021 a mlips:TrainedModel ;
    rdfs:label "NEP general silicon potential (4,101 parameters)" .

entity:run-nep-silicene-fan2021 a mlips:MLIPRun ;
    rdfs:label "NEP fit to 2D silicene" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-silicene-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-nep-silicene-cutoffRadius-fan2021 ,
        entity:setting-nep-silicene-angularCutoff-fan2021 ,
        entity:setting-nep-silicene-Nneu-fan2021 ,
        entity:setting-nep-silicene-Ngen-fan2021 ;
    mlips:produces entity:model-nep-silicene-fan2021 .

entity:model-nep-silicene-fan2021 a mlips:TrainedModel ;
    rdfs:label "NEP silicene potential (2,681 parameters)" .

entity:run-nep-PbTe-fan2021 a mlips:MLIPRun ;
    rdfs:label "NEP fit to bulk PbTe" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-PbTe-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-nep-PbTe-cutoffRadius-fan2021 ,
        entity:setting-nep-PbTe-angularCutoff-fan2021 ,
        entity:setting-nep-PbTe-Nneu-fan2021 ,
        entity:setting-nep-PbTe-Ngen-fan2021 ;
    mlips:produces entity:model-nep-PbTe-fan2021 .

entity:model-nep-PbTe-fan2021 a mlips:TrainedModel ;
    rdfs:label "NEP PbTe potential (1,721 parameters)" .

entity:run-gap-silicene-fan2021 a mlips:MLIPRun ;
    rdfs:label "GAP-SOAP comparison fit to 2D silicene (trained by the authors)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-silicene-fan2021 ;
    mlips:produces entity:model-gap-silicene-fan2021 .

entity:model-gap-silicene-fan2021 a mlips:TrainedModel ;
    rdfs:label "GAP-SOAP silicene potential" .

entity:run-gap-PbTe-fan2021 a mlips:MLIPRun ;
    rdfs:label "GAP-SOAP comparison fit to bulk PbTe (trained by the authors)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-PbTe-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-gap-PbTe-cutoffRadius-fan2021 ,
        entity:setting-gap-PbTe-numSparseConfigs-fan2021 ;
    mlips:produces entity:model-gap-PbTe-fan2021 .

entity:model-gap-PbTe-fan2021 a mlips:TrainedModel ;
    rdfs:label "GAP-SOAP PbTe potential" .

entity:run-mtp-silicene-fan2021 a mlips:MLIPRun ;
    rdfs:label "MTP comparison fit to 2D silicene (trained by the authors)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-silicene-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-silicene-cutoffRadius-fan2021 ;
    mlips:produces entity:model-mtp-silicene-fan2021 .

entity:model-mtp-silicene-fan2021 a mlips:TrainedModel ;
    rdfs:label "MTP silicene potential" .

entity:run-mtp-PbTe-fan2021 a mlips:MLIPRun ;
    rdfs:label "MTP comparison fit to bulk PbTe (trained by the authors)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-PbTe-fan2021 ;
    mlips:produces entity:model-mtp-PbTe-fan2021 .

entity:model-mtp-PbTe-fan2021 a mlips:TrainedModel ;
    rdfs:label "MTP PbTe potential" .

entity:run-dp-Si-fan2021 a mlips:MLIPRun ;
    rdfs:label "DP (smooth edition) comparison fit to general-purpose silicon" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-Si-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-dp-Si-cutoffRadius-fan2021 ;
    mlips:produces entity:model-dp-Si-fan2021 .

entity:model-dp-Si-fan2021 a mlips:TrainedModel ;
    rdfs:label "DP general silicon potential" .

entity:run-dp-silicene-fan2021 a mlips:MLIPRun ;
    rdfs:label "DP (smooth edition) comparison fit to 2D silicene" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-silicene-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-dp-silicene-cutoffRadius-fan2021 ;
    mlips:produces entity:model-dp-silicene-fan2021 .

entity:model-dp-silicene-fan2021 a mlips:TrainedModel ;
    rdfs:label "DP silicene potential" .

entity:run-dp-PbTe-fan2021 a mlips:MLIPRun ;
    rdfs:label "DP (smooth edition) comparison fit to bulk PbTe" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-PbTe-fan2021 ;
    mlips:hasHyperparameterSetting entity:setting-dp-PbTe-cutoffRadius-fan2021 ;
    mlips:produces entity:model-dp-PbTe-fan2021 .

entity:model-dp-PbTe-fan2021 a mlips:TrainedModel ;
    rdfs:label "DP PbTe potential" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-fan2021 mlips:hasResult
    entity:result-nep-Si-fan2021 ,
    entity:result-dp-Si-fan2021 ,
    entity:result-nep-silicene-fan2021 ,
    entity:result-gap-silicene-fan2021 ,
    entity:result-mtp-silicene-fan2021 ,
    entity:result-dp-silicene-fan2021 ,
    entity:result-nep-PbTe-fan2021 ,
    entity:result-gap-PbTe-fan2021 ,
    entity:result-mtp-PbTe-fan2021 ,
    entity:result-dp-PbTe-fan2021 .

entity:result-nep-Si-fan2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nep-Si-fan2021 ;
    mlips:targetMaterial entity:mat-Si-fan2021 ;
    mlips:hasAccuracyMetric entity:metric-nep-Si-1-fan2021 ;
    mlips:inferenceHardware "One Nvidia Tesla V100: above 1e7 atom-steps per second in gpumd (Fig. 4; exact bar values per material not legible as a table)" .

entity:metric-nep-Si-1-fan2021 a mlips:AccuracyMetric ;
    rdfs:label "Training-set force RMSE: NEP, general silicon" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "107"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-dp-Si-fan2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-dp-Si-fan2021 ;
    mlips:targetMaterial entity:mat-Si-fan2021 ;
    mlips:hasAccuracyMetric entity:metric-dp-Si-1-fan2021 .

entity:metric-dp-Si-1-fan2021 a mlips:AccuracyMetric ;
    rdfs:label "Training-set force RMSE: DP, general silicon" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "165"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-nep-silicene-fan2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nep-silicene-fan2021 ;
    mlips:targetMaterial entity:mat-silicene-fan2021 ;
    mlips:hasAccuracyMetric entity:metric-nep-silicene-1-fan2021 ,
        entity:metric-nep-silicene-2-fan2021 .

entity:metric-nep-silicene-1-fan2021 a mlips:AccuracyMetric ;
    rdfs:label "RMSE on energy: NEP, 2D silicene" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.5"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nep-silicene-2-fan2021 a mlips:AccuracyMetric ;
    rdfs:label "RMSE on forces: NEP, 2D silicene" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "56"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-gap-silicene-fan2021 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-silicene-fan2021 ;
    mlips:targetMaterial entity:mat-silicene-fan2021 ;
    mlips:hasAccuracyMetric entity:metric-gap-silicene-1-fan2021 ,
        entity:metric-gap-silicene-2-fan2021 .

entity:metric-gap-silicene-1-fan2021 a mlips:AccuracyMetric ;
    rdfs:label "RMSE on energy: GAP-SOAP, 2D silicene" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.6"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-gap-silicene-2-fan2021 a mlips:AccuracyMetric ;
    rdfs:label "RMSE on forces: GAP-SOAP, 2D silicene" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "65"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

