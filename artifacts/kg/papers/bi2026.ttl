# Canonical Turtle for the protocol-derived encoding of:
#   Jia Bi et al. (2026). Scalar-pathway fidelity improves physical accuracy in short-range equivariant interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2606.15892  arXiv:2606.15892v1
#
# Version read: arxiv-preprint arXiv:2606.15892v1 (sha256 f4a1f29b19aa1e11...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 94 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the controlled comparison of Table S1: Allegro, NequIP
# and MACE, each trained with and without the paper's scalar-pathway
# correction (PAN + PGS modules), on metallic Ag, covalent Si and a
# LiF/Li-F subset of MPtrj: 18 runs with energy and force MAEs (means
# over five seeds). The many ablations and molecular benchmarks of the
# supplement are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bi2026 a mlips:BenchmarkStudy ;
    rdfs:label "Bi et al. (2026): scalar-pathway fidelity improves physical accuracy in short-range equivariant interatomic potentials (PAN + PGS)" ;
    mlips:reportedIn entity:article-bi2026 .

entity:article-bi2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2606.15892> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Scalar-pathway fidelity improves physical accuracy in short-range equivariant interatomic potentials" ;
    schema:author entity:person-Bi-bi2026 ,
        entity:person-Elena-bi2026 ,
        entity:person-Pinilla-bi2026 .

entity:person-Bi-bi2026 a schema:Person ;
    schema:name "Jia Bi" ;
    schema:givenName "Jia" ;
    schema:familyName "Bi" .

entity:person-Elena-bi2026 a schema:Person ;
    schema:name "Alin Marin Elena" ;
    schema:givenName "Alin Marin" ;
    schema:familyName "Elena" .

entity:person-Pinilla-bi2026 a schema:Person ;
    schema:name "Samuel Pinilla" ;
    schema:givenName "Samuel" ;
    schema:familyName "Pinilla" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Ag-bi2026 a mlips:MaterialSystem ;
    rdfs:label "Silver: bulk fcc, strained, defective, surface and high-temperature configurations" ;
    mlips:chemicalFormula "Ag" ;
    mlips:materialClass "Elemental fcc metal" .

entity:mat-Si-bi2026 a mlips:MaterialSystem ;
    rdfs:label "Silicon (public Silicon MLIP data sets)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental covalent semiconductor" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q670> .

entity:mat-LiF-bi2026 a mlips:MaterialSystem ;
    rdfs:label "Li-F-containing compounds (LiF and other chemistries containing Li and F), subset of MPtrj" ;
    mlips:chemicalFormula "Li-F" ;
    mlips:materialClass "Short-range ionic materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ag-dft-bi2026 a mlips:DFTCalculation .

entity:calc-mptrj-dft-bi2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ag-dft-bi2026 mlips:hasDFTSettings entity:calc-settings-ag-dft-bi2026 .

entity:calc-settings-ag-dft-bi2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "Author-generated Ag data; convergence parameters, smearing and k-point rules are in Supplementary Table S13 (not read)." .

entity:calc-mptrj-dft-bi2026 mlips:hasDFTSettings entity:calc-settings-mptrj-dft-bi2026 .

entity:calc-settings-mptrj-dft-bi2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Materials Project GGA/GGA+U static and relaxation trajectories (MPtrj)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Ag-bi2026 a mlips:TrainingDataset ;
    rdfs:label "Ag data set (4.6 x 10^4 configurations)" ;
    mlips:coversMaterial entity:mat-Ag-bi2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 46000 ;
    mlips:hasDFTCalculation entity:calc-ag-dft-bi2026 .

entity:ds-Si-bi2026 a mlips:TrainingDataset ;
    rdfs:label "Silicon data set (3.4 x 10^4 configurations)" ;
    mlips:coversMaterial entity:mat-Si-bi2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 34000 .

entity:ds-LiF-bi2026 a mlips:TrainingDataset ;
    rdfs:label "LiF/Li-F subset of MPtrj (3.9 x 10^4 configurations)" ;
    mlips:coversMaterial entity:mat-LiF-bi2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 39000 ;
    mlips:hasDFTCalculation entity:calc-mptrj-dft-bi2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Ag-bi2026 mlips:samplingStrategy
    entity:sampling-ag-configs-bi2026 .

entity:ds-Si-bi2026 mlips:samplingStrategy
    entity:sampling-si-public-bi2026 .

entity:ds-LiF-bi2026 mlips:samplingStrategy
    entity:sampling-mptrj-filter-bi2026 .

entity:sampling-ag-configs-bi2026 a mlips:SamplingStrategy ;
    rdfs:label "Bulk, strained, defective, surface and high-temperature Ag configurations" ;
    rdfs:comment "Duplicates removed before an 80/10/10 train/validation/test split." .

entity:sampling-si-public-bi2026 a mlips:SamplingStrategy ;
    rdfs:label "Public silicon MLIP data sets" ;
    rdfs:comment "Release-provided splits where available, otherwise 80/10/10 with a fixed seed; no stress labels." .

entity:sampling-mptrj-filter-bi2026 a mlips:SamplingStrategy ;
    rdfs:label "MPtrj configurations whose formula contains both Li and F" ;
    rdfs:comment "Configurations more than 1.5 eV/atom above the ground state removed; 80/10/10 split at the configuration level." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-bi2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-bi2026 ;
    mlips:hasHyperparameter entity:hp-scalar-pathway-bi2026 ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-MACE-bi2026 .

entity:loss-MACE-bi2026 a mlips:LossFunction ;
    rdfs:label "L1 loss on energy, forces and stress with weights w_E = 1.0, w_F = 10.0 and w_sigma = 10.0 (0 without stress labels)" .

entity:alg-MACE-bi2026 a mls:Algorithm ;
    rdfs:label "AdamW, initial learning rate 8e-3, weight decay 1e-8, ReduceLROnPlateau (patience 5, factor 0.5), EMA decay 0.99999, stochastic weight averaging after epoch 30, batch size 4, gradient clipping at 100" .

entity:impl-MACE-bi2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE ;
    mlips:version "ASE-MACE framework, float64" .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter entity:hp-scalar-pathway-bi2026 .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasHyperparameter entity:hp-scalar-pathway-bi2026 .

entity:hp-scalar-pathway-bi2026 a mlips:Hyperparameter ;
    rdfs:label "Scalar-pathway treatment (baseline, or with the PAN and PGS modules)" ;
    mlips:hyperparameterName "scalar_pathway" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

