###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-mortazavi2020accelerating mlips:hasDFTSettings entity:calc-settings-pbe-mortazavi2020accelerating .

entity:calc-settings-pbe-mortazavi2020accelerating a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:kPointMesh "3x3x1 (2D), 2x2x2 (bulk)" .

