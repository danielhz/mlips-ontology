###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lpsc-ord-ou2024 a mlips:MaterialSystem ;
    rdfs:label "Anion-ordered bulk Li6PS5Cl" ;
    mlips:chemicalFormula "Li6PS5Cl" ;
    mlips:materialClass "argyrodite sulfide solid electrolyte" .

entity:mat-lpsc-dis-ou2024 a mlips:MaterialSystem ;
    rdfs:label "Anion-disordered bulk Li6PS5Cl" ;
    mlips:chemicalFormula "Li6PS5Cl" ;
    mlips:materialClass "argyrodite sulfide solid electrolyte" .

entity:mat-lpsc-gb-ou2024 a mlips:MaterialSystem ;
    rdfs:label "Li6PS5Cl grain boundaries Sigma3(-112)[110], Sigma3(-111)[110] and Sigma5(001)[001]" ;
    mlips:chemicalFormula "Li6PS5Cl" ;
    mlips:materialClass "argyrodite sulfide solid electrolyte (grain boundaries)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-ou2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-ou2024 mlips:hasDFTSettings entity:calc-settings-pbe-ou2024 .

entity:calc-settings-pbe-ou2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred 2x2x2 (unit cell, tetrahedron with Bloechl corrections); Gamma point with 0.03 eV Gaussian smearing for GBs" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ord-ou2024 a mlips:TrainingDataset ;
    rdfs:label "Accumulated MTP training set for the anion-ordered bulk (104-atom cells)" ;
    mlips:coversMaterial entity:mat-lpsc-ord-ou2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2219 ;
    mlips:hasDFTCalculation entity:calc-pbe-ou2024 .

entity:ds-dis-ou2024 a mlips:TrainingDataset ;
    rdfs:label "Accumulated MTP training set for the anion-disordered bulk (208-atom cells)" ;
