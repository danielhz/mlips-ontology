###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ord-ou2024 mlips:samplingStrategy
    entity:sampling-al-ou2024 .

entity:ds-dis-ou2024 mlips:samplingStrategy
    entity:sampling-al-ou2024 .

entity:ds-gb3a-ou2024 mlips:samplingStrategy
    entity:sampling-al-ou2024 .

entity:ds-gb3b-ou2024 mlips:samplingStrategy
    entity:sampling-al-ou2024 .

entity:ds-gb5-ou2024 mlips:samplingStrategy
    entity:sampling-al-ou2024 .

entity:sampling-al-ou2024 a mlips:SamplingStrategy ;
    rdfs:label "Quality-level-based active learning: bulk AIMD initialisation, pre-training with select-add of AIMD frames, then standard MTP-MD active learning on the target structure for levels 4, 6, ... 18" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-ou2024 ;
    mlips:hasHyperparameter mlips:momentLevel ;
    mlips:hasImplementation entity:impl-MTP-ou2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-MTP-ou2024 a mls:Algorithm ;
    rdfs:label "Level-18 MTP with 807 fitting parameters, reached through successively higher levels in active learning" .

entity:impl-MTP-ou2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-ord-momentLevel-ou2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "18"^^xsd:integer .

entity:setting-mtp-dis-momentLevel-ou2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "18"^^xsd:integer .

entity:setting-mtp-gb3a-momentLevel-ou2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "18"^^xsd:integer .

entity:setting-mtp-gb3b-momentLevel-ou2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "18"^^xsd:integer .

entity:setting-mtp-gb5-momentLevel-ou2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "18"^^xsd:integer .

