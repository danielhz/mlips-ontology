    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2210 ;
    mlips:hasDFTCalculation entity:calc-pbe-ou2024 .

entity:ds-gb3a-ou2024 a mlips:TrainingDataset ;
    rdfs:label "Accumulated MTP training set for the GB Sigma3(-112)[110] (312-atom cells)" ;
