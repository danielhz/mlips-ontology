###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-copt-nascimento2026 a mlips:MaterialSystem ;
    rdfs:label "Pt bulk, Pt(111)/(100) slabs with CO coverage, Pt nanoparticles, clusters and gas-phase CO" ;
    mlips:materialClass "Solid-liquid interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-nascimento2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-nascimento2026 mlips:hasDFTSettings entity:calc-settings-vasp-nascimento2026 .

entity:calc-settings-vasp-nascimento2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-optB88-vdW-nascimento2026 ;
    rdfs:comment "Labels recomputed for the FLARE active-learning configurations of Owen et al." .

entity:xc-optB88-vdW-nascimento2026 a mlips:XCFunctional ;
    rdfs:label "optB88-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-copt-nascimento2026 a mlips:TrainingDataset ;
    rdfs:label "CO/Pt dataset (2,446 configurations; 80% training)" ;
    mlips:coversMaterial entity:mat-copt-nascimento2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 2446 ;
    mlips:hasDFTCalculation entity:calc-vasp-nascimento2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-copt-nascimento2026 mlips:samplingStrategy
    entity:sampling-flare-nascimento2026 .

entity:sampling-flare-nascimento2026 a mlips:SamplingStrategy ;
    rdfs:label "Configurations from the Bayesian active-learning workflow of Owen et al. (FLARE); 80/10/10 split" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-nascimento2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-Allegro-nascimento2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-Allegro-nascimento2026 a mlips:LossFunction ;
    rdfs:label "Energies and forces plus (co-training) an agreement loss on bulk atoms weighted by alpha" .

entity:impl-Allegro-nascimento2026 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-hifi-numLayers-nascimento2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-hifi-numFeatures-nascimento2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-lofi-numLayers-nascimento2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-lofi-numFeatures-nascimento2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "32"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-hifi-nascimento2026 a mlips:MLIPRun ;
    rdfs:label "High-fidelity Allegro (independent, full dataset)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-copt-nascimento2026 ;
    mlips:hasHyperparameterSetting entity:setting-hifi-numLayers-nascimento2026 ,
        entity:setting-hifi-numFeatures-nascimento2026 ;
    mlips:produces entity:model-hifi-nascimento2026 .

entity:model-hifi-nascimento2026 a mlips:TrainedModel ;
    rdfs:label "Allegro CO/Pt high-fidelity" .

entity:run-lofi-nascimento2026 a mlips:MLIPRun ;
    rdfs:label "Low-fidelity Allegro (independent, full dataset)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-copt-nascimento2026 ;
    mlips:hasHyperparameterSetting entity:setting-lofi-numLayers-nascimento2026 ,
        entity:setting-lofi-numFeatures-nascimento2026 ;
    mlips:produces entity:model-lofi-nascimento2026 .

entity:model-lofi-nascimento2026 a mlips:TrainedModel ;
    rdfs:label "Allegro CO/Pt low-fidelity" .

entity:run-moe10-nascimento2026 a mlips:MLIPRun ;
    rdfs:label "Co-trained mixture, alpha = 1.0 (no agreement constraint)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-copt-nascimento2026 ;
    mlips:produces entity:model-moe10-nascimento2026 .

entity:model-moe10-nascimento2026 a mlips:TrainedModel ;
    rdfs:label "Allegro CO/Pt mixture (alpha = 1.0)" .

entity:run-moe08-nascimento2026 a mlips:MLIPRun ;
    rdfs:label "Co-trained mixture, alpha = 0.8" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-copt-nascimento2026 ;
    mlips:produces entity:model-moe08-nascimento2026 .

entity:model-moe08-nascimento2026 a mlips:TrainedModel ;
    rdfs:label "Allegro CO/Pt mixture (alpha = 0.8)" .

entity:run-moe05-nascimento2026 a mlips:MLIPRun ;
    rdfs:label "Co-trained mixture, alpha = 0.5" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-copt-nascimento2026 ;
    mlips:produces entity:model-moe05-nascimento2026 .

entity:model-moe05-nascimento2026 a mlips:TrainedModel ;
    rdfs:label "Allegro CO/Pt mixture (alpha = 0.5)" .

