###############################################################################

entity:study-nascimento2026 a mlips:BenchmarkStudy ;
    rdfs:label "de Miranda Nascimento et al. (2026): spatial mixture-of-experts MLIPs with co-trained high- and low-fidelity Allegro models for CO on platinum" ;
    mlips:reportedIn entity:article-nascimento2026 .

