# Q10 -- Benchmark results
###############################################################################

entity:study-korotaev2019 mlips:hasResult
    entity:result-300K-korotaev2019 ,
    entity:result-500K-korotaev2019 ,
    entity:result-700K-korotaev2019 ,
    entity:result-300K-1-korotaev2019 ,
    entity:result-300K-2-korotaev2019 ,
    entity:result-300K-3-korotaev2019 ,
    entity:result-300K-4-korotaev2019 .

entity:result-300K-korotaev2019 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-300K-korotaev2019 ;
    mlips:targetMaterial entity:mat-CoSb3-korotaev2019 ;
    mlips:hasAccuracyMetric entity:metric-300K-1-korotaev2019 ,
        entity:metric-300K-2-korotaev2019 ,
        entity:metric-300K-3-korotaev2019 .

entity:metric-300K-1-korotaev2019 a mlips:AccuracyMetric ;
    rdfs:label "Average absolute energy error per atom, 250 random AIMD configurations not in the training set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.08"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

