        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 579 ;
    mlips:hasDFTCalculation entity:calc-dft-korotaev2019 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-300K-korotaev2019 mlips:samplingStrategy
    entity:sampling-active-korotaev2019 .

entity:ds-500K-korotaev2019 mlips:samplingStrategy
    entity:sampling-active-korotaev2019 .

entity:ds-700K-korotaev2019 mlips:samplingStrategy
    entity:sampling-active-korotaev2019 .

entity:ds-300K-1-korotaev2019 mlips:samplingStrategy
    entity:sampling-active-korotaev2019 .

entity:ds-300K-2-korotaev2019 mlips:samplingStrategy
    entity:sampling-active-korotaev2019 .

entity:ds-300K-3-korotaev2019 mlips:samplingStrategy
    entity:sampling-active-korotaev2019 .

entity:ds-300K-4-korotaev2019 mlips:samplingStrategy
    entity:sampling-active-korotaev2019 .

entity:sampling-active-korotaev2019 a mlips:SamplingStrategy ;
    rdfs:label "Active learning: pretraining on about 100 AIMD steps, then classical MD with the MTP on independent systems with selection by extrapolation grade, repeated selection to remove correlated configurations, DFT on the selected set, retraining until no configuration is selected" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-korotaev2019 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-korotaev2019 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MTP-korotaev2019 a mlips:LossFunction ;
    rdfs:label "Weighted errors in energies, forces and stresses with relative weights 1, 0.1 and 0.1" .

entity:alg-MTP-korotaev2019 a mls:Algorithm ;
    rdfs:label "Active learning with selection by extrapolation grade" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-300K-cutoffRadius-korotaev2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.2"^^xsd:double .

entity:setting-500K-cutoffRadius-korotaev2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.2"^^xsd:double .

entity:setting-700K-cutoffRadius-korotaev2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.2"^^xsd:double .

entity:setting-300K-1-cutoffRadius-korotaev2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.2"^^xsd:double .

entity:setting-300K-2-cutoffRadius-korotaev2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.2"^^xsd:double .

entity:setting-300K-3-cutoffRadius-korotaev2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.2"^^xsd:double .

entity:setting-300K-4-cutoffRadius-korotaev2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.2"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-300K-korotaev2019 a mlips:MLIPRun ;
    rdfs:label "MTP training for CoSb3 at 300 K" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-300K-korotaev2019 ;
    mlips:hasHyperparameterSetting entity:setting-300K-cutoffRadius-korotaev2019 ;
    mlips:produces entity:model-300K-korotaev2019 .

entity:model-300K-korotaev2019 a mlips:TrainedModel ;
    rdfs:label "MTP for CoSb3 at 300 K" .

