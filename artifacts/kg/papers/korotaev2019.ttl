    rdfs:label "Active training set for CoSb3 at 300 K (MTP-1) (838 configurations)" ;
    mlips:coversMaterial entity:mat-CoSb3-korotaev2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 838 ;
    mlips:hasDFTCalculation entity:calc-dft-korotaev2019 .

entity:ds-300K-2-korotaev2019 a mlips:TrainingDataset ;
    rdfs:label "Active training set for CoSb3 at 300 K (MTP-2) (778 configurations)" ;
    mlips:coversMaterial entity:mat-CoSb3-korotaev2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 778 ;
    mlips:hasDFTCalculation entity:calc-dft-korotaev2019 .

entity:ds-300K-3-korotaev2019 a mlips:TrainingDataset ;
    rdfs:label "Active training set for CoSb3 at 300 K (MTP-3) (897 configurations)" ;
    mlips:coversMaterial entity:mat-CoSb3-korotaev2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 897 ;
    mlips:hasDFTCalculation entity:calc-dft-korotaev2019 .

entity:ds-300K-4-korotaev2019 a mlips:TrainingDataset ;
    rdfs:label "Active training set for CoSb3 at 300 K (MTP-4) (579 configurations)" ;
    mlips:coversMaterial entity:mat-CoSb3-korotaev2019 ;
