# Canonical Turtle for the protocol-derived encoding of:
#   Pavel Yu. Korotaev et al. (2019). Accessing thermal conductivity of complex compounds by machine learning interatomic potentials.
#   Physical review. B./Physical review. B. doi:10.1103/physrevb.100.144308
#
# Version read: publisher (sha256 f9188832da2de9fd...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 155 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the actively learned MTPs for the skutterudite CoSb3
# (one per temperature, plus four independent repeats at 300 K), their
# VASP reference calculations, active training sets and the validation
# errors of Tables I and II. Lattice thermal conductivities are not
# encoded (no metric property).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-korotaev2019 a mlips:BenchmarkStudy ;
    rdfs:label "Korotaev et al. (2019): thermal conductivity of complex compounds by machine learning interatomic potentials (CoSb3)" ;
    mlips:reportedIn entity:article-korotaev2019 .

entity:article-korotaev2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevb.100.144308> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "Accessing thermal conductivity of complex compounds by machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-2617-6341> ,
        <https://orcid.org/0000-0002-4652-6863> ,
        entity:person-Yanilkin-korotaev2019 ,
        <https://orcid.org/0000-0002-7497-5594> .

<https://orcid.org/0000-0002-2617-6341> a schema:Person ;
    schema:name "Pavel Korotaev" ;
    schema:givenName "Pavel" ;
    schema:familyName "Korotaev" ;
    schema:identifier <https://orcid.org/0000-0002-2617-6341> .

<https://orcid.org/0000-0002-4652-6863> a schema:Person ;
    schema:name "Ivan Novoselov" ;
    schema:givenName "Ivan" ;
    schema:familyName "Novoselov" ;
    schema:identifier <https://orcid.org/0000-0002-4652-6863> .

entity:person-Yanilkin-korotaev2019 a schema:Person ;
    schema:name "Aleksey Yanilkin" ;
    schema:givenName "Aleksey" ;
    schema:familyName "Yanilkin" .

<https://orcid.org/0000-0002-7497-5594> a schema:Person ;
    schema:name "Alexander Shapeev" ;
    schema:givenName "Alexander" ;
    schema:familyName "Shapeev" ;
    schema:identifier <https://orcid.org/0000-0002-7497-5594> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-CoSb3-korotaev2019 a mlips:MaterialSystem ;
    rdfs:label "Skutterudite CoSb3 (2x2x2 supercell Co32Sb96, 128 atoms)" ;
    mlips:chemicalFormula "CoSb3" ;
    mlips:materialClass "Thermoelectric skutterudite" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-korotaev2019 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-korotaev2019 mlips:hasDFTSettings entity:calc-settings-dft-korotaev2019 .

entity:calc-settings-dft-korotaev2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "450"^^xsd:double ;
    mlips:kPointMesh "2x2x2 Gamma-centred grid" ;
    rdfs:comment "VASP 5.4.1; Co 3d7 4s2 and Sb 5s2 5p3 valence electrons; experimental lattice constants at each temperature." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-300K-korotaev2019 a mlips:TrainingDataset ;
    rdfs:label "Active training set for CoSb3 at 300 K (271 configurations)" ;
    mlips:coversMaterial entity:mat-CoSb3-korotaev2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 271 ;
    mlips:hasDFTCalculation entity:calc-dft-korotaev2019 .

entity:ds-500K-korotaev2019 a mlips:TrainingDataset ;
    rdfs:label "Active training set for CoSb3 at 500 K (717 configurations)" ;
    mlips:coversMaterial entity:mat-CoSb3-korotaev2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 717 ;
    mlips:hasDFTCalculation entity:calc-dft-korotaev2019 .

