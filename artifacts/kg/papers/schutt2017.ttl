###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-iso17-schutt2017 mlips:samplingStrategy
    entity:sampling-iso17-md-schutt2017 .

entity:sampling-iso17-md-schutt2017 a mlips:SamplingStrategy ;
    rdfs:label "Short MD trajectories of 129 C7O2H10 isomers (5,000 conformations each)" ;
    rdfs:comment "Isomers drawn randomly from the largest set of isomers in QM9 (Sec. 5.3)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:hasLossFunction entity:loss-SchNet-schutt2017 ;
    mlips:hasTrainingAlgorithm entity:alg-SchNet-schutt2017 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize .

entity:loss-SchNet-schutt2017 a mlips:LossFunction ;
    rdfs:label "rho * squared energy error plus mean squared force error (Eq. 5), rho = 0.01 for combined training" .

entity:alg-SchNet-schutt2017 a mls:Algorithm ;
    rdfs:label "Adam (mini-batches of 32), exponential learning-rate decay 0.96 every 100,000 steps, exponential moving average of weights (0.99)" .

