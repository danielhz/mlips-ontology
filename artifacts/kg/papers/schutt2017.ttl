# Canonical Turtle for the protocol-derived encoding of:
#   Kristof T. Schütt et al. (2017). SchNet: A continuous-filter convolutional neural network for modeling quantum interactions.
#   arXiv. doi:10.48550/arxiv.1706.08566  arXiv:1706.08566v5
#
# Version read: arxiv-preprint arXiv:1706.08566v5 (sha256 5c537d6464ed412a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 217 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/schutt2017.yaml.
#
# Encoding scope: SchNet as introduced here (NeurIPS 2017) with its QM9
# U0 errors (Table 1), MD17 energy and force MAEs for models trained on
# energies only or on energies and forces with 1,000 and 50,000 examples
# (Table 2), and the ISO17 data set (introduced here) with the SchNet
# errors on its two test scenarios (Table 3). Values quoted for GDML, DTNN
# and MPNNs are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-schutt2017 a mlips:BenchmarkStudy ;
    rdfs:label "Schütt et al. (2017): SchNet continuous-filter convolutional network, and the ISO17 data set" ;
    mlips:reportedIn entity:article-schutt2017 .

entity:article-schutt2017 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.1706.08566> ;
    schema:datePublished "2017"^^xsd:gYear ;
    schema:name "SchNet: A continuous-filter convolutional neural network for modeling quantum interactions" ;
    schema:author entity:person-Schutt-schutt2017 ,
        entity:person-Kindermans-schutt2017 ,
        entity:person-Sauceda-schutt2017 ,
        entity:person-Chmiela-schutt2017 ,
        entity:person-Tkatchenko-schutt2017 ,
        entity:person-Muller-schutt2017 .

entity:person-Schutt-schutt2017 a schema:Person ;
    schema:name "Kristof T. Schütt" ;
    schema:givenName "Kristof T." ;
    schema:familyName "Schütt" .

entity:person-Kindermans-schutt2017 a schema:Person ;
    schema:name "Pieter-Jan Kindermans" ;
    schema:givenName "Pieter-Jan" ;
    schema:familyName "Kindermans" .

entity:person-Sauceda-schutt2017 a schema:Person ;
    schema:name "Huziel E. Sauceda" ;
    schema:givenName "Huziel E." ;
    schema:familyName "Sauceda" .

entity:person-Chmiela-schutt2017 a schema:Person ;
    schema:name "Stefan Chmiela" ;
    schema:givenName "Stefan" ;
    schema:familyName "Chmiela" .

entity:person-Tkatchenko-schutt2017 a schema:Person ;
