# Canonical Turtle for the protocol-derived encoding of:
#   Qi, Aitken, Pei, Tan, Zuo, Jhon, Quek, Wen, Wu, Ong. Machine
#   Learning Moment Tensor Potential for Modelling Dislocation and
#   Fracture in L1_0-TiAl and D0_19-Ti3Al Alloys.
#   Phys. Rev. Materials 7, 103602 (2023).
#   doi:10.1103/PhysRevMaterials.7.103602  arXiv:2305.11825
#
# Encoding scope: one MTP trained across the Ti-Al binary; benchmarked
# on the L1_0 (gamma-TiAl) and D0_19 (alpha2-Ti3Al) phases plus other
# stable Ti-Al polymorphs.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-qi2023 a mlips:BenchmarkStudy ;
    rdfs:label "Qi et al. (2023): MTP for L1_0-TiAl and D0_19-Ti3Al" ;
    mlips:reportedIn entity:article-qi2023 .

entity:article-qi2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/PhysRevMaterials.7.103602> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Machine Learning Moment Tensor Potential for Modelling Dislocation and Fracture in L1_0-TiAl and D0_19-Ti3Al Alloys" ;
    schema:author
        <https://orcid.org/0000-0001-5808-9931> ,
        entity:person-Aitken-qi2023 ,
        <https://orcid.org/0000-0001-8711-2854> ,
        <https://orcid.org/0000-0002-5074-4660> ,
        <https://orcid.org/0000-0002-2734-7720> ,
        <https://orcid.org/0000-0002-9407-8452> ,
        <https://orcid.org/0000-0002-8181-9485> ,
        <https://orcid.org/0000-0003-1692-2512> ,
        <https://orcid.org/0000-0002-4739-1139> ,
        <https://orcid.org/0000-0001-5726-2587> .

<https://orcid.org/0000-0001-5808-9931> a schema:Person ;
    schema:name "Ji Qi" ;
    schema:givenName "Ji" ;
    schema:familyName "Qi" ;
    schema:identifier <https://orcid.org/0000-0001-5808-9931> .

entity:person-Aitken-qi2023 a schema:Person ;
    schema:name "Z. H. Aitken" ;
    schema:givenName "Z. H." ;
    schema:familyName "Aitken" ;
    rdfs:comment "No ORCID found via Crossref / arXiv API as of 2026-05-04." .

<https://orcid.org/0000-0001-8711-2854> a schema:Person ;
    schema:name "Qingxiang Pei" ;
    schema:givenName "Qingxiang" ;
    schema:familyName "Pei" ;
    schema:identifier <https://orcid.org/0000-0001-8711-2854> .

<https://orcid.org/0000-0002-5074-4660> a schema:Person ;
    schema:name "Anne Marie Z. Tan" ;
    schema:givenName "Anne Marie Z." ;
    schema:familyName "Tan" ;
    schema:identifier <https://orcid.org/0000-0002-5074-4660> .

<https://orcid.org/0000-0002-2734-7720> a schema:Person ;
    schema:name "Yunxing Zuo" ;
    schema:givenName "Yunxing" ;
    schema:familyName "Zuo" ;
    schema:identifier <https://orcid.org/0000-0002-2734-7720> .
<https://orcid.org/0000-0002-9407-8452> a schema:Person ;
    schema:name "M. H. Jhon" ;
    schema:givenName "M. H." ;
    schema:familyName "Jhon" ;
    schema:identifier <https://orcid.org/0000-0002-9407-8452> .

<https://orcid.org/0000-0002-8181-9485> a schema:Person ;
    schema:name "S. S. Quek" ;
    schema:givenName "S. S." ;
    schema:familyName "Quek" ;
    schema:identifier <https://orcid.org/0000-0002-8181-9485> .

<https://orcid.org/0000-0003-1692-2512> a schema:Person ;
    schema:name "T. Wen" ;
    schema:givenName "T." ;
    schema:familyName "Wen" ;
