###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-TiAl a mlips:MaterialSystem ;
    rdfs:label "Ti-Al binary (focus on L1_0 gamma-TiAl and D0_19 alpha2-Ti3Al)" ;
    mlips:chemicalFormula "Ti-Al" ;
    mlips:materialClass "Binary intermetallic; benchmarked on L1_0 (P4/mmm) gamma-TiAl and D0_19 (P6_3/mmc) alpha2-Ti3Al phases" ;
    rdfs:comment "Wikidata Q408746 ('titanium aluminide', intermetallic chemical compound) is the closest entry covering the gamma-TiAl and alpha2-Ti3Al phases; the Ti-Al binary system itself has no Wikidata entry as of 2026-07-25." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q408746> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-qi2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-qi2023 mlips:hasDFTSettings entity:dft-settings-qi2023 .

entity:dft-settings-qi2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack with k-point density >= 100/Ang^3 for static; single Gamma point for AIMD" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-TiAl a mlips:TrainingDataset ;
    rdfs:label "Ti-Al MTP training set (33 polymorphs + 2160 AIMD + 185 surfaces + 580 solid-solutions + 840 strained = 3798 configs)" ;
    mlips:coversMaterial entity:mat-TiAl ;
    mlips:coversProperty mlips:Energy , mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 3798 ;
    mlips:hasDFTCalculation entity:dft-qi2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-TiAl mlips:samplingStrategy
    entity:polymorph-sampling , entity:aimd-sampling , entity:surface-sampling ,
    entity:solid-solution-sampling , entity:strain-sampling .

entity:polymorph-sampling a mlips:SamplingStrategy ;
    rdfs:label "Ground-state polymorph enumeration" ;
    rdfs:comment "33 ground-state polymorphs of the Ti-Al system retrieved from the Materials Project." .

entity:aimd-sampling a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling (NVT AIMD)" ;
    rdfs:comment "2160 snapshots from NVT AIMD trajectories of 6 stable phases at 300, 1000 and 3000 K, 90/100/110% of ground-state volume; 40 configs per 10 ps run." .

entity:surface-sampling a mlips:SamplingStrategy ;
    rdfs:label "Surface enumeration" ;
    rdfs:comment "185 surface structures with Miller indices up to three for the 6 stable Ti-Al phases." .

entity:solid-solution-sampling a mlips:SamplingStrategy ;
    rdfs:label "Solid-solution chemical sampling" ;
    rdfs:comment "580 Al_xTi_{1-x} solid-solution structures (x from 12.5 to 87.5 at.% in 12.5% steps), up to 30 enumerations per scenario." .

entity:strain-sampling a mlips:SamplingStrategy ;
    rdfs:label "Homogeneous strain sampling" ;
    rdfs:comment "840 strained supercells: +/-10% strain at 1% intervals across 6 strain modes for the 6 stable phases." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    mlips:supportsSimulation mlips:GeometryOptimization ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasFunctionalForm entity:mtp-functional-form;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:mtp-loss-100-1-0 ;
    mlips:hasHyperparameter mlips:cutoffRadius , mlips:momentLevel ;
    mlips:hasImplementation entity:mlip-package .

entity:mtp-functional-form a mlips:FunctionalForm ;
    rdfs:label "MTP moment-tensor polynomial" .

entity:mtp-loss-100-1-0 a mlips:LossFunction ;
    rdfs:label "Weighted MSE (energy 100, force 1, stress 0)" .

entity:mlip-package a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-4_8 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.8"^^xsd:double .

entity:setting-levmax-22 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "22"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-mtp-TiAl a mlips:MLIPRun ;
    rdfs:label "MTP training run, Ti-Al binary" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-TiAl ;
    mlips:hasHyperparameterSetting entity:setting-rcut-4_8 , entity:setting-levmax-22 ;
    mlips:produces entity:model-mtp-TiAl .

entity:model-mtp-TiAl a mlips:TrainedModel ;
    rdfs:label "Ti-Al MTP (rcut=4.8 Ang, levmax=22)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-qi2023 mlips:hasResult entity:result-mtp-surface , entity:result-mtp-polymorph .

entity:result-mtp-surface a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-TiAl ;
    mlips:targetMaterial entity:mat-TiAl ;
    mlips:hasAccuracyMetric entity:metric-mae-surface .

entity:metric-mae-surface a mlips:AccuracyMetric ;
    rdfs:label "MAE on formation energies of surface structures (vs. DFT)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:result-mtp-polymorph a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-TiAl ;
    mlips:targetMaterial entity:mat-TiAl ;
    mlips:hasAccuracyMetric entity:metric-mae-polymorph .

entity:metric-mae-polymorph a mlips:AccuracyMetric ;
    rdfs:label "MAE on formation energies of polymorph structures (vs. DFT)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "18"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

###############################################################################
