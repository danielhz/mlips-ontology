# Canonical Turtle for the protocol-derived encoding of:
#   Jisu Kim et al. (2025). An efficient forgetting-aware fine-tuning framework for pretrained universal machine-learning interatomic potentials.
#   npj Computational Materials. doi:10.1038/s41524-025-01895-w
#
# Version read: publisher (sha256 ae77c92fc8c6a4af...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 269 (Software/implementation). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/kim2025forgetting.yaml.
#
# Encoding scope: SevenNet-0 (11 July 2024, MPtrj) fine-tuned on Li6PS5Cl
# (LPSC) AIMD data with six strategies (Vanilla, layer freezing, lower
# learning rate, Replay, EWC, reEWC), evaluated on argyrodite and
# non-argyrodite Li solid-electrolyte AIMD test sets and in MD
# diffusivities. Energy/force MAEs and softening scales are shown only as
# violin plots and composite losses; the validation RMSEs are stated only
# approximately, so no error metric is encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kim2025forgetting a mlips:BenchmarkStudy ;
    rdfs:label "Kim et al. (2025): forgetting-aware fine-tuning (EWC, Replay, reEWC) of SevenNet-0 for Li solid-state electrolytes" ;
    mlips:reportedIn entity:article-kim2025forgetting .

entity:article-kim2025forgetting a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01895-w> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "An efficient forgetting-aware fine-tuning framework for pretrained universal machine-learning interatomic potentials" ;
    schema:author entity:person-Kim-kim2025forgetting ,
        entity:person-Lee-kim2025forgetting ,
        entity:person-Oh-kim2025forgetting ,
        entity:person-Park-kim2025forgetting ,
        entity:person-Hwang-kim2025forgetting ,
