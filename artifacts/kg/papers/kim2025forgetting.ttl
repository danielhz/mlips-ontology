entity:run-reewc-kim2025forgetting a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 after reEWC (Replay + EWC) fine-tuning on LPSC" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lpsc-kim2025forgetting ;
    mlips:hasHyperparameterSetting entity:setting-reewc-numEpochs-kim2025forgetting ,
