###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lpsc-kim2025forgetting a mlips:MaterialSystem ;
    rdfs:label "Li6PS5Cl argyrodite (52-atom unit cell, 50% Cl@4c)" ;
    mlips:chemicalFormula "Li6PS5Cl" ;
    mlips:materialClass "Argyrodite Li solid electrolyte" .

entity:mat-argyrodites-kim2025forgetting a mlips:MaterialSystem ;
    rdfs:label "126 argyrodite compounds Li(24+x)M4S20X4 (M = Si, Ge, Sn, P, As, Sb; X = Cl, Br, I) with five S/X disorder levels" ;
    mlips:materialClass "Argyrodite Li solid electrolytes" .

entity:mat-li-sse-kim2025forgetting a mlips:MaterialSystem ;
    rdfs:label "Nine non-argyrodite Li solid electrolytes (LLZO, LATP, LGPS, Li7P3S11, Li3YCl6, Li3YBr6, Li3N, Li9S3N, LiBH4)" ;
    mlips:materialClass "Li solid electrolytes (oxides, sulfides, halides, nitrides, hydrides)" .

entity:mat-mptrj-kim2025forgetting a mlips:MaterialSystem ;
    rdfs:label "Materials Project relaxation trajectories (inorganic crystals)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-kim2025forgetting a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-kim2025forgetting mlips:hasDFTSettings entity:calc-settings-pbe-kim2025forgetting .

entity:calc-settings-pbe-kim2025forgetting a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "Gamma point for AIMD" ;
    rdfs:comment "MPtrj-consistent settings; cutoff and k-points converged to 10 meV/atom, 0.02 eV/A and 10 kbar." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-lpsc-kim2025forgetting a mlips:TrainingDataset ;
    rdfs:label "LPSC fine-tuning set (1,000 structures, 9:1 training/validation)" ;
    mlips:coversMaterial entity:mat-lpsc-kim2025forgetting ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-pbe-kim2025forgetting .

entity:ds-replay-kim2025forgetting a mlips:TrainingDataset ;
    rdfs:label "Replay set: random 10% of MPtrj" ;
    mlips:coversMaterial entity:mat-mptrj-kim2025forgetting ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-lpsc-kim2025forgetting mlips:samplingStrategy
    entity:sampling-lpsc-aimd-kim2025forgetting .

entity:sampling-lpsc-aimd-kim2025forgetting a mlips:SamplingStrategy ;
    rdfs:label "NVT AIMD of LPSC at 600 and 1000 K, 100 ps, 2 fs step, 500 structures per temperature sampled every 200 fs" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-kim2025forgetting ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-kim2025forgetting ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-kim2025forgetting ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-NequIP-kim2025forgetting a mlips:LossFunction ;
    rdfs:label "Huber loss (delta 0.01) on per-atom energy, forces (weight 1) and stress (weight 0.01); EWC adds a diagonal-Fisher penalty (lambda 10 for EWC, 1e5 for reEWC)" .

entity:alg-NequIP-kim2025forgetting a mls:Algorithm ;
    rdfs:label "Adam with two cycles of linear warm-up and cosine annealing; Replay alternates mini-batches from the fine-tuning and Replay sets" .

entity:impl-NequIP-kim2025forgetting a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-kim2025forgetting .

entity:lib-SevenNet-kim2025forgetting a mlips:Library ;
    rdfs:label "SevenNet" ;
    rdfs:comment "SevenNet implementation of NequIP; MD with LAMMPS" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-vanilla-numEpochs-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

entity:setting-vanilla-learningRate-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-freeze-numEpochs-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

entity:setting-freeze-learningRate-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-lowlr-numEpochs-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

entity:setting-replay-numEpochs-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

entity:setting-replay-learningRate-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-ewc-numEpochs-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

entity:setting-ewc-learningRate-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-reewc-numEpochs-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

entity:setting-reewc-learningRate-kim2025forgetting a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-vanilla-kim2025forgetting a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 after Vanilla fine-tuning on LPSC" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lpsc-kim2025forgetting ;
    mlips:hasHyperparameterSetting entity:setting-vanilla-numEpochs-kim2025forgetting ,
        entity:setting-vanilla-learningRate-kim2025forgetting ;
    mlips:produces entity:model-vanilla-kim2025forgetting .

entity:model-vanilla-kim2025forgetting a mlips:TrainedModel ;
    rdfs:label "SevenNet-0 LPSC Vanilla fine-tuning model" .

entity:run-freeze-kim2025forgetting a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 after layer-freezing fine-tuning (output block only) on LPSC" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lpsc-kim2025forgetting ;
    mlips:hasHyperparameterSetting entity:setting-freeze-numEpochs-kim2025forgetting ,
        entity:setting-freeze-learningRate-kim2025forgetting ;
    mlips:produces entity:model-freeze-kim2025forgetting .

entity:model-freeze-kim2025forgetting a mlips:TrainedModel ;
    rdfs:label "SevenNet-0 LPSC layer-freezing fine-tuning (output block only) model" .

entity:run-lowlr-kim2025forgetting a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 after lower-learning-rate fine-tuning (one tenth of the learning rate) on LPSC" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lpsc-kim2025forgetting ;
    mlips:hasHyperparameterSetting entity:setting-lowlr-numEpochs-kim2025forgetting ;
    mlips:produces entity:model-lowlr-kim2025forgetting .

entity:model-lowlr-kim2025forgetting a mlips:TrainedModel ;
    rdfs:label "SevenNet-0 LPSC lower-learning-rate fine-tuning (one tenth of the learning rate) model" .

entity:run-replay-kim2025forgetting a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 after Replay fine-tuning on LPSC" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lpsc-kim2025forgetting ;
    mlips:hasHyperparameterSetting entity:setting-replay-numEpochs-kim2025forgetting ,
        entity:setting-replay-learningRate-kim2025forgetting ;
    mlips:produces entity:model-replay-kim2025forgetting .

entity:model-replay-kim2025forgetting a mlips:TrainedModel ;
    rdfs:label "SevenNet-0 LPSC Replay fine-tuning model" .

entity:run-ewc-kim2025forgetting a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 after EWC fine-tuning on LPSC" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-lpsc-kim2025forgetting ;
    mlips:hasHyperparameterSetting entity:setting-ewc-numEpochs-kim2025forgetting ,
