    entity:result-lpscl-15-on-10-goodwin2024 ,
    entity:result-lpscl-15-on-15-goodwin2024 .

entity:result-lpscl-all-on-05-goodwin2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-lpscl-all-goodwin2024 ;
    mlips:targetMaterial entity:mat-lpscl05-goodwin2024 ;
    mlips:hasAccuracyMetric entity:metric-lpscl-all-on-05-1-goodwin2024 ,
        entity:metric-lpscl-all-on-05-2-goodwin2024 .

entity:metric-lpscl-all-on-05-1-goodwin2024 a mlips:AccuracyMetric ;
    rdfs:label "Energy MAE on the LPSCl|0.5 test frames (trained-on composition)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.7"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-lpscl-all-on-05-2-goodwin2024 a mlips:AccuracyMetric ;
    rdfs:label "Force MAE on the LPSCl|0.5 test frames (trained-on composition)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "28.8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-lpscl-all-on-10-goodwin2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-lpscl-all-goodwin2024 ;
    mlips:targetMaterial entity:mat-lpscl10-goodwin2024 ;
    mlips:hasAccuracyMetric entity:metric-lpscl-all-on-10-1-goodwin2024 ,
        entity:metric-lpscl-all-on-10-2-goodwin2024 .

entity:metric-lpscl-all-on-10-1-goodwin2024 a mlips:AccuracyMetric ;
    rdfs:label "Energy MAE on the LPSCl|1.0 test frames (trained-on composition)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.5"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-lpscl-all-on-10-2-goodwin2024 a mlips:AccuracyMetric ;
    rdfs:label "Force MAE on the LPSCl|1.0 test frames (trained-on composition)" ;
    mlips:metricType mlips:MAE ;
