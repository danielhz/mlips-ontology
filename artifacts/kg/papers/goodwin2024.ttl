###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-goodwin2024 mlips:hasResult
    entity:result-lpscl-all-on-05-goodwin2024 ,
    entity:result-lpscl-all-on-10-goodwin2024 ,
    entity:result-lpscl-all-on-15-goodwin2024 ,
    entity:result-lpscl-05-10-on-05-goodwin2024 ,
    entity:result-lpscl-05-10-on-10-goodwin2024 ,
    entity:result-lpscl-05-10-on-15-goodwin2024 ,
    entity:result-lpscl-10-15-on-05-goodwin2024 ,
    entity:result-lpscl-10-15-on-10-goodwin2024 ,
    entity:result-lpscl-10-15-on-15-goodwin2024 ,
    entity:result-lpscl-05-15-on-05-goodwin2024 ,
    entity:result-lpscl-05-15-on-10-goodwin2024 ,
    entity:result-lpscl-05-15-on-15-goodwin2024 ,
    entity:result-lpscl-05-on-05-goodwin2024 ,
    entity:result-lpscl-05-on-10-goodwin2024 ,
    entity:result-lpscl-05-on-15-goodwin2024 ,
