###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-IL-goodwin2024 a mlips:MaterialSystem ;
    rdfs:label "Ionic liquid [F-OMIM]+ [C4F9CO2]-" ;
    mlips:materialClass "Ionic liquid" .

entity:mat-lpscl05-goodwin2024 a mlips:MaterialSystem ;
    rdfs:label "Argyrodite solid electrolyte LPSCl|0.5" ;
    mlips:chemicalFormula "Li6.5PS5.5Cl0.5" ;
    mlips:materialClass "Solid electrolyte" .

entity:mat-lpscl10-goodwin2024 a mlips:MaterialSystem ;
    rdfs:label "Argyrodite solid electrolyte LPSCl|1.0" ;
    mlips:chemicalFormula "Li6PS5Cl" ;
    mlips:materialClass "Solid electrolyte" .

entity:mat-lpscl15-goodwin2024 a mlips:MaterialSystem ;
    rdfs:label "Argyrodite solid electrolyte LPSCl|1.5" ;
    mlips:chemicalFormula "Li5.5PS4.5Cl1.5" ;
    mlips:materialClass "Solid electrolyte" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qe-goodwin2024 a mlips:DFTCalculation .

entity:calc-vasp-goodwin2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qe-goodwin2024 mlips:hasDFTSettings entity:calc-settings-qe-goodwin2024 .

entity:calc-settings-qe-goodwin2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:Ultrasoft ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "PBE with D3 dispersion; cutoffs 50 Ry (wave functions) and 500 Ry (charge density), stated in Ry and not converted; convergence threshold 1e-10 Ry." .

entity:calc-vasp-goodwin2024 mlips:hasDFTSettings entity:calc-settings-vasp-goodwin2024 .

entity:calc-settings-vasp-goodwin2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "700"^^xsd:double ;
    mlips:kPointMesh "4x4x4 mesh" ;
    rdfs:comment "VASP 6; cubic cells with experimental lattice parameters; SCF convergence 1e-5 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-IL-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "[F-OMIM][C4F9CO2] DFT data set (OPLS-sampled frames with AIMD and relaxation steps)" ;
    mlips:coversMaterial entity:mat-IL-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-qe-goodwin2024 ;
    rdfs:comment "The abstract-level description is 'about 200 DFT frames'; the exact composition of the final set (SI Section 5) is not encoded." .

entity:ds-lpscl-all-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "LPSCl training frames of LPSCl|0.5 + LPSCl|1.0 + LPSCl|1.5 (132 frames)" ;
    mlips:coversMaterial entity:mat-lpscl05-goodwin2024 ,
        entity:mat-lpscl10-goodwin2024 ,
        entity:mat-lpscl15-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 132 ;
    mlips:hasDFTCalculation entity:calc-vasp-goodwin2024 .

entity:ds-lpscl-05-10-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "LPSCl training frames of LPSCl|0.5 + LPSCl|1.0 (85 frames)" ;
    mlips:coversMaterial entity:mat-lpscl05-goodwin2024 ,
        entity:mat-lpscl10-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 85 ;
    mlips:hasDFTCalculation entity:calc-vasp-goodwin2024 .

entity:ds-lpscl-10-15-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "LPSCl training frames of LPSCl|1.0 + LPSCl|1.5 (80 frames)" ;
    mlips:coversMaterial entity:mat-lpscl10-goodwin2024 ,
        entity:mat-lpscl15-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 80 ;
    mlips:hasDFTCalculation entity:calc-vasp-goodwin2024 .

entity:ds-lpscl-05-15-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "LPSCl training frames of LPSCl|0.5 + LPSCl|1.5 (99 frames)" ;
    mlips:coversMaterial entity:mat-lpscl05-goodwin2024 ,
        entity:mat-lpscl15-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 99 ;
    mlips:hasDFTCalculation entity:calc-vasp-goodwin2024 .

entity:ds-lpscl-05-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "LPSCl training frames of LPSCl|0.5 (52 frames)" ;
    mlips:coversMaterial entity:mat-lpscl05-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 52 ;
    mlips:hasDFTCalculation entity:calc-vasp-goodwin2024 .

entity:ds-lpscl-10-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "LPSCl training frames of LPSCl|1.0 (33 frames)" ;
    mlips:coversMaterial entity:mat-lpscl10-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 33 ;
    mlips:hasDFTCalculation entity:calc-vasp-goodwin2024 .

entity:ds-lpscl-15-goodwin2024 a mlips:TrainingDataset ;
    rdfs:label "LPSCl training frames of LPSCl|1.5 (47 frames)" ;
    mlips:coversMaterial entity:mat-lpscl15-goodwin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 47 ;
    mlips:hasDFTCalculation entity:calc-vasp-goodwin2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-IL-goodwin2024 mlips:samplingStrategy
    entity:sampling-opls-goodwin2024 ,
    entity:sampling-aimd-goodwin2024 .

entity:ds-lpscl-all-goodwin2024 mlips:samplingStrategy
    entity:sampling-flare-goodwin2024 .

entity:ds-lpscl-05-10-goodwin2024 mlips:samplingStrategy
    entity:sampling-flare-goodwin2024 .

entity:ds-lpscl-10-15-goodwin2024 mlips:samplingStrategy
    entity:sampling-flare-goodwin2024 .

entity:ds-lpscl-05-15-goodwin2024 mlips:samplingStrategy
    entity:sampling-flare-goodwin2024 .

entity:ds-lpscl-05-goodwin2024 mlips:samplingStrategy
    entity:sampling-flare-goodwin2024 .

entity:ds-lpscl-10-goodwin2024 mlips:samplingStrategy
    entity:sampling-flare-goodwin2024 .

entity:ds-lpscl-15-goodwin2024 mlips:samplingStrategy
    entity:sampling-flare-goodwin2024 .

entity:sampling-opls-goodwin2024 a mlips:SamplingStrategy ;
    rdfs:label "Classical OPLS-AA molecular dynamics with rescaled charges (NPT at 300, 450 and 600 K, snapshots every 20 ps); 60 equally spaced frames per temperature" .

entity:sampling-aimd-goodwin2024 a mlips:SamplingStrategy ;
    rdfs:label "Short fixed-cell ab initio MD (50 steps) and 10 steps of fixed-cell relaxation started from each selected frame" .

entity:sampling-flare-goodwin2024 a mlips:SamplingStrategy ;
    rdfs:label "On-the-fly active learning with FLARE during LAMMPS NVT MD at 300 K (1 ns); the last frames collected form the test set" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-goodwin2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-lmax-goodwin2024 ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        entity:hp-stress-weight-goodwin2024 ;
    mlips:hasImplementation entity:impl-Allegro-goodwin2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-Allegro-goodwin2024 a mlips:LossFunction ;
    rdfs:label "Weighted energy, force and stress loss (weights 1, 1 and 100 for the ionic-liquid model); single-atom energies used as references when training on several compositions" .

entity:impl-Allegro-goodwin2024 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

entity:hp-lmax-goodwin2024 a mlips:Hyperparameter ;
    rdfs:label "Maximum rotation order l_max" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-stress-weight-goodwin2024 a mlips:Hyperparameter ;
    rdfs:label "Loss weight on the stress (force and energy weights 1)" ;
    mlips:hyperparameterName "stress_weight" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-IL-cutoffRadius-goodwin2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-IL-lmax-goodwin2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lmax-goodwin2024 ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-IL-numLayers-goodwin2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-IL-learningRate-goodwin2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-IL-batchSize-goodwin2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-IL-stress-weight-goodwin2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-stress-weight-goodwin2024 ;
    mlips:settingValue "100"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-IL-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Allegro model for [F-OMIM][C4F9CO2]" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-IL-goodwin2024 ;
    mlips:hasHyperparameterSetting entity:setting-IL-cutoffRadius-goodwin2024 ,
        entity:setting-IL-lmax-goodwin2024 ,
        entity:setting-IL-numLayers-goodwin2024 ,
        entity:setting-IL-learningRate-goodwin2024 ,
        entity:setting-IL-batchSize-goodwin2024 ,
        entity:setting-IL-stress-weight-goodwin2024 ;
    mlips:produces entity:model-IL-goodwin2024 .

entity:model-IL-goodwin2024 a mlips:TrainedModel ;
    rdfs:label "Allegro model for [F-OMIM][C4F9CO2]" .

entity:run-lpscl-all-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Model trained on LPSCl|0.5 + LPSCl|1.0 + LPSCl|1.5" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-lpscl-all-goodwin2024 ;
    mlips:produces entity:model-lpscl-all-goodwin2024 .

entity:model-lpscl-all-goodwin2024 a mlips:TrainedModel ;
    rdfs:label "LPSCl model trained on LPSCl|0.5 + LPSCl|1.0 + LPSCl|1.5" .

entity:run-lpscl-05-10-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Model trained on LPSCl|0.5 + LPSCl|1.0" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-lpscl-05-10-goodwin2024 ;
    mlips:produces entity:model-lpscl-05-10-goodwin2024 .

entity:model-lpscl-05-10-goodwin2024 a mlips:TrainedModel ;
    rdfs:label "LPSCl model trained on LPSCl|0.5 + LPSCl|1.0" .

entity:run-lpscl-10-15-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Model trained on LPSCl|1.0 + LPSCl|1.5" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-lpscl-10-15-goodwin2024 ;
    mlips:produces entity:model-lpscl-10-15-goodwin2024 .

entity:model-lpscl-10-15-goodwin2024 a mlips:TrainedModel ;
    rdfs:label "LPSCl model trained on LPSCl|1.0 + LPSCl|1.5" .

entity:run-lpscl-05-15-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Model trained on LPSCl|0.5 + LPSCl|1.5" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-lpscl-05-15-goodwin2024 ;
    mlips:produces entity:model-lpscl-05-15-goodwin2024 .

entity:model-lpscl-05-15-goodwin2024 a mlips:TrainedModel ;
    rdfs:label "LPSCl model trained on LPSCl|0.5 + LPSCl|1.5" .

entity:run-lpscl-05-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Model trained on LPSCl|0.5" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-lpscl-05-goodwin2024 ;
    mlips:produces entity:model-lpscl-05-goodwin2024 .

entity:model-lpscl-05-goodwin2024 a mlips:TrainedModel ;
    rdfs:label "LPSCl model trained on LPSCl|0.5" .

entity:run-lpscl-10-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Model trained on LPSCl|1.0" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-lpscl-10-goodwin2024 ;
    mlips:produces entity:model-lpscl-10-goodwin2024 .

entity:model-lpscl-10-goodwin2024 a mlips:TrainedModel ;
    rdfs:label "LPSCl model trained on LPSCl|1.0" .

entity:run-lpscl-15-goodwin2024 a mlips:MLIPRun ;
    rdfs:label "Model trained on LPSCl|1.5" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-lpscl-15-goodwin2024 ;
    mlips:produces entity:model-lpscl-15-goodwin2024 .

entity:model-lpscl-15-goodwin2024 a mlips:TrainedModel ;
