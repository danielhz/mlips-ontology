###############################################################################

entity:study-goodwin2024 a mlips:BenchmarkStudy ;
    rdfs:label "Goodwin et al. (2024): transferability and accuracy of ionic liquid simulations with equivariant MLIPs" ;
    mlips:reportedIn entity:article-goodwin2024 .

