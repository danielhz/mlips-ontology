# Canonical Turtle for the protocol-derived encoding of:
#   Paul Fuchs et al. (2025). chemtrain: Learning deep potential models via automatic differentiation and statistical physics.
#   Computer Physics Communications. doi:10.1016/j.cpc.2025.109512  arXiv:2408.15852v2
#
# Version read: arxiv-preprint arXiv:2408.15852v2 (sha256 b1803b78bb25825e...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 480 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/fuchs2025.yaml.
#
# Encoding scope: the software paper's atomistic example only, a
# DimeNet++ Ti potential pre-trained on DFT energies, forces and virials
# (from Rocken and Zavadlav, rocken2024) and further trained by
# interleaving force matching on the DFT data with DiffTRe on
# experimental elastic constants at 323 and 923 K. The alanine-dipeptide
# example is a coarse-grained model (not an interatomic potential) and is
# not encoded. No error metrics are reported.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-fuchs2025 a mlips:BenchmarkStudy ;
    rdfs:label "Fuchs et al. (2025): chemtrain, a JAX framework for training potential models by force matching, relative entropy minimization and differentiable trajectory reweighting" ;
    mlips:reportedIn entity:article-fuchs2025 .

entity:article-fuchs2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.cpc.2025.109512> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "chemtrain: Learning deep potential models via automatic differentiation and statistical physics" ;
    schema:author entity:person-Fuchs-fuchs2025 ,
        entity:person-Thaler-fuchs2025 ,
        entity:person-Rocken-fuchs2025 ,
        <https://orcid.org/0000-0002-4495-9956> .

entity:person-Fuchs-fuchs2025 a schema:Person ;
    schema:name "Paul Fuchs" ;
    schema:givenName "Paul" ;
    schema:familyName "Fuchs" .

entity:person-Thaler-fuchs2025 a schema:Person ;
    schema:name "Stephan Thaler" ;
    schema:givenName "Stephan" ;
    schema:familyName "Thaler" .

entity:person-Rocken-fuchs2025 a schema:Person ;
    schema:name "Sebastien Röcken" ;
    schema:givenName "Sebastien" ;
    schema:familyName "Röcken" .

<https://orcid.org/0000-0002-4495-9956> a schema:Person ;
    schema:name "Julija Zavadlav" ;
    schema:givenName "Julija" ;
    schema:familyName "Zavadlav" ;
    schema:identifier <https://orcid.org/0000-0002-4495-9956> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ti-fuchs2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk titanium" ;
    mlips:chemicalFormula "Ti" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-fuchs2025 a mlips:DFTCalculation .

entity:calc-exp-fuchs2025 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-fuchs2025 mlips:hasDFTSettings entity:calc-settings-dft-fuchs2025 .

entity:calc-settings-dft-fuchs2025 a mlips:DFTSettings ;
    rdfs:comment "Curated Ti DFT dataset of energies, forces and virials (Ref. 111), as used in rocken2024" .

entity:calc-exp-fuchs2025 mlips:hasReferenceSettings entity:calc-settings-exp-fuchs2025 .

entity:calc-settings-exp-fuchs2025 a mlips:ReferenceSettings ;
    rdfs:comment "Experimental bulk elastic constants at 323 and 923 K (Ref. 112), used by DiffTRe" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ti-dft-fuchs2025 a mlips:TrainingDataset ;
    rdfs:label "Ti DFT dataset (energies, forces, virials) of rocken2024" ;
    mlips:coversMaterial entity:mat-ti-fuchs2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-fuchs2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ti-dft-fuchs2025 mlips:samplingStrategy
    entity:sampling-pub-fuchs2025 .

entity:sampling-pub-fuchs2025 a mlips:SamplingStrategy ;
    rdfs:label "Published Ti DFT dataset of rocken2024" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:hasLossFunction entity:loss-DimeNet-fuchs2025 ;
    mlips:hasTrainingAlgorithm entity:alg-DimeNet-fuchs2025 ;
    mlips:hasImplementation entity:impl-DimeNet-fuchs2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-DimeNet-fuchs2025 a mlips:LossFunction ;
    rdfs:label "Force matching (energy, force and virial weights 1e-6, 1e-2, 4e-6) interleaved with DiffTRe on elastic constants and pressure" .

entity:alg-DimeNet-fuchs2025 a mls:Algorithm ;
    rdfs:label "100 repetitions of one FM epoch and one DiffTRe update per state point (InterleaveTrainers)" .

entity:impl-DimeNet-fuchs2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-chemtrain-fuchs2025 .

entity:lib-chemtrain-fuchs2025 a mlips:Library ;
    rdfs:label "chemtrain" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ti-fused-fuchs2025 a mlips:MLIPRun ;
    rdfs:label "DimeNet++ Ti model trained by fused FM and DiffTRe" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-ti-dft-fuchs2025 ;
    mlips:produces entity:model-ti-fused-fuchs2025 .

entity:model-ti-fused-fuchs2025 a mlips:TrainedModel ;
    rdfs:label "DimeNet++ Ti fused (chemtrain example)" .

