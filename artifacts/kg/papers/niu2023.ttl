# Canonical Turtle for the protocol-derived encoding of:
#   Hongwei Niu et al. (2023). Stable Solid Molecular Hydrogen above 900 K from a Machine-Learned Potential Trained with Diffusion Quantum Monte Carlo.
#   Physical Review Letters. doi:10.1103/physrevlett.130.076102  arXiv:2209.00658v2
#
# Version read: arxiv-preprint arXiv:2209.00658v2 (sha256 848b484b63c58759...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 657 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/niu2023.yaml.
#
# Encoding scope: the hierarchical Delta-learning Deep Potential for dense
# hydrogen (H2 pair potential + DPMD fit to vdW-DF1 DFT + DPMD fit to the
# DMC residual), used in PIMD to map the phase diagram. No energy or force
# errors are stated, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-niu2023 a mlips:BenchmarkStudy ;
    rdfs:label "Niu et al. (2023): stable solid molecular hydrogen above 900 K from a DMC-trained machine-learned potential" ;
    mlips:reportedIn entity:article-niu2023 .

entity:article-niu2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevlett.130.076102> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Stable Solid Molecular Hydrogen above 900 K from a Machine-Learned Potential Trained with Diffusion Quantum Monte Carlo" ;
    schema:author <https://orcid.org/0000-0001-5451-4961> ,
        <https://orcid.org/0000-0002-8800-9426> ,
