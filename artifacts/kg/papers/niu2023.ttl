###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-h-niu2023 a mlips:MaterialSystem ;
    rdfs:label "Dense hydrogen (molecular solid and liquid phases, 60-220 GPa)" ;
    mlips:chemicalFormula "H" ;
    mlips:materialClass "high-pressure molecular solid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vdwdf1-niu2023 a mlips:DFTCalculation .

entity:calc-dmc-niu2023 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vdwdf1-niu2023 mlips:hasDFTSettings entity:calc-settings-vdwdf1-niu2023 .

entity:calc-settings-vdwdf1-niu2023 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-vdW-DF1-niu2023 ;
    rdfs:comment "Energies, forces and stresses of all configurations (PBE also computed)." .

entity:calc-dmc-niu2023 mlips:hasWaveFunctionSettings entity:calc-settings-dmc-niu2023 .

entity:calc-settings-dmc-niu2023 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-DMC-niu2023 ;
    rdfs:comment "Diffusion Monte Carlo energies and forces (CCZ force estimator) for about 20,000 configurations; statistical errors 0.1 meV and 130 meV/A." .

entity:xc-vdW-DF1-niu2023 a mlips:XCFunctional ;
    rdfs:label "vdW-DF1" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:wf-DMC-niu2023 a mlips:WfMethod ;
    rdfs:label "DMC" ;
    mlips:candidateForVocabulary mlips:WfMethod .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-dft-niu2023 a mlips:TrainingDataset ;
    rdfs:label "Hydrogen configurations with vdW-DF1 labels (about 1e5)" ;
    mlips:coversMaterial entity:mat-h-niu2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vdwdf1-niu2023 .

entity:ds-dmc-niu2023 a mlips:TrainingDataset ;
    rdfs:label "DMC-labelled subset (about 20,000 configurations)" ;
    mlips:coversMaterial entity:mat-h-niu2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-dmc-niu2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-dft-niu2023 mlips:samplingStrategy
    entity:sampling-md-pimd-niu2023 .

entity:ds-dmc-niu2023 mlips:samplingStrategy
    entity:sampling-md-pimd-niu2023 .

entity:sampling-md-pimd-niu2023 a mlips:SamplingStrategy ;
    rdfs:label "96-proton configurations from classical MD, PIMD and CEIMC simulations over the relevant pressure-temperature range" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-niu2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-DeePMD-niu2023 a mls:Algorithm ;
    rdfs:label "Hierarchical Delta-learning: E = E_pair (repulsive exact H2 BO pair potential) + Delta E_DFT (DPMD fit to DFT minus pair) + Delta E_DMC (smaller DPMD fit to the DMC residual)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-dft-niu2023 a mlips:MLIPRun ;
    rdfs:label "DPMD Delta-DFT model (vdW-DF1 minus pair potential)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-dft-niu2023 ;
    mlips:produces entity:model-dp-dft-niu2023 .

entity:model-dp-dft-niu2023 a mlips:TrainedModel ;
    rdfs:label "DPMD Delta-DFT hydrogen (vdW-DF1)" .

entity:run-dp-dmc-niu2023 a mlips:MLIPRun ;
    rdfs:label "DMC-trained DPMD: Delta-DMC correction fitted on top of the Delta-DFT model" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-dmc-niu2023 ;
    mlips:produces entity:model-dp-dmc-niu2023 .

entity:model-dp-dmc-niu2023 a mlips:TrainedModel ;
    rdfs:label "DMC-trained DPMD hydrogen" .

