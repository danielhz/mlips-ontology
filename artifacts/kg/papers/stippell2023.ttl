entity:run-ani-dftu-stippell2023 a mlips:MLIPRun ;
    rdfs:label "MLIP-DFT+U: MLIP-DFT transfer-learned to DFT+U with layers 0 and 3 frozen, TL(0,3)" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-dftu-stippell2023 ;
    mlips:produces entity:model-ani-dftu-stippell2023 .

entity:model-ani-dftu-stippell2023 a mlips:TrainedModel ;
