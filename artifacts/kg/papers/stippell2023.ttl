    mlips:hasLossFunction entity:loss-ANI-stippell2023 ;
    mlips:hasTrainingAlgorithm entity:alg-ANI-stippell2023 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-ANI-stippell2023 a mlips:LossFunction ;
    rdfs:label "Energy and force weights 1 and 0.1, L2 regularisation 1e-6" .

entity:alg-ANI-stippell2023 a mls:Algorithm ;
    rdfs:label "Adam with learning-rate annealing from 1e-3 to 1e-5, early stopping (patience 100 epochs)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ani-dft-learningRate-stippell2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-ani-dft-batchSize-stippell2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "64"^^xsd:integer .

