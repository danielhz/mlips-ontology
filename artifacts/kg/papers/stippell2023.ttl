###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-uo2-stippell2023 a mlips:MaterialSystem ;
    rdfs:label "Uranium dioxide (fluorite UO2), bulk at 300-2500 K, strained and with point defects" ;
    mlips:chemicalFormula "UO2" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-stippell2023 a mlips:DFTCalculation .

entity:calc-pbeu-stippell2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-stippell2023 mlips:hasDFTSettings entity:calc-settings-pbe-stippell2023 .

entity:calc-settings-pbe-stippell2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "2x2x2" ;
    rdfs:comment "96-atom supercells, ferromagnetic initial guess (Sec. 2.1)." .

entity:calc-pbeu-stippell2023 mlips:hasDFTSettings entity:calc-settings-pbeu-stippell2023 .

entity:calc-settings-pbeu-stippell2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "2x2x2" ;
    rdfs:comment "DFT+U with U ramped from 0.51 to 4.50 eV and J = 0.51 eV (U-J = 3.99 eV), antiferromagnetic initial guess (Sec. 2.2)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-dft-stippell2023 a mlips:TrainingDataset ;
    rdfs:label "UO2 PBE active-learning data set (about 25k configurations; 87.5/6.25/6.25 % train/validation/test per ensemble member)" ;
    mlips:coversMaterial entity:mat-uo2-stippell2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-stippell2023 .

entity:ds-dftu-stippell2023 a mlips:TrainingDataset ;
    rdfs:label "UO2 DFT+U reduced data set (about 2,000 configurations)" ;
    mlips:coversMaterial entity:mat-uo2-stippell2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbeu-stippell2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-dft-stippell2023 mlips:samplingStrategy
    entity:sampling-al-stippell2023 .

entity:ds-dftu-stippell2023 mlips:samplingStrategy
    entity:sampling-reduce-stippell2023 .

entity:sampling-al-stippell2023 a mlips:SamplingStrategy ;
    rdfs:label "Active learning with MLIP-MD (ASE, Nose-Hoover, up to 1 ns) from about 6,500 classical-FF configurations; query by committee of eight ANI models (typical thresholds 4 kcal/mol and 1 kcal/mol/A)" .

entity:sampling-reduce-stippell2023 a mlips:SamplingStrategy ;
    rdfs:label "Iterative data reduction selecting the hardest DFT configurations (about 8 % of the DFT set) for DFT+U" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
