# Canonical Turtle for the protocol-derived encoding of:
#   Lorenzo Piersante et al. (2026). Machine learning interatomic potentials for solid-state precipitation.
#   Physical Review Materials. doi:10.1103/qyb1-7j1p  arXiv:2601.12984v1
#
# Version read: arxiv-preprint arXiv:2601.12984v1 (sha256 cf7900f60dd054f3...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 545 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/piersante2026.yaml.
#
# Encoding scope: three pacemaker ACE potentials (pure Mg, pure Nd and
# the Mg-Nd binary with 4,246 cluster functions, 7.8 A cutoff, ZBL core)
# trained on Mahalanobis-distance-sampled VASP PBE datasets with
# low-energy weighting and active learning; the training and validation
# MAEs stated in Sec. IV. Phase stability, pathways, precipitate and
# kinetic properties are not metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-piersante2026 a mlips:BenchmarkStudy ;
    rdfs:label "Piersante and Natarajan (2026): ACE potentials for Mg, Nd and Mg-Nd built for solid-state precipitation (hcp-bcc pathways, phase stability, defects)" ;
    mlips:reportedIn entity:article-piersante2026 .

entity:article-piersante2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/qyb1-7j1p> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Machine learning interatomic potentials for solid-state precipitation" ;
    schema:author <https://orcid.org/0000-0003-2349-0834> ,
        <https://orcid.org/0000-0002-0252-9480> .

<https://orcid.org/0000-0003-2349-0834> a schema:Person ;
    schema:name "Lorenzo Piersante" ;
    schema:givenName "Lorenzo" ;
    schema:familyName "Piersante" ;
    schema:identifier <https://orcid.org/0000-0003-2349-0834> .

<https://orcid.org/0000-0002-0252-9480> a schema:Person ;
    schema:name "Anirudh Raju Natarajan" ;
    schema:givenName "Anirudh Raju" ;
    schema:familyName "Natarajan" ;
    schema:identifier <https://orcid.org/0000-0002-0252-9480> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mg-piersante2026 a mlips:MaterialSystem ;
    rdfs:label "Pure Mg (hcp and other lattices, defects)" ;
    mlips:chemicalFormula "Mg" ;
    mlips:materialClass "Metals" .

entity:mat-nd-piersante2026 a mlips:MaterialSystem ;
    rdfs:label "Pure Nd (dhcp, fcc, hcp and other lattices)" ;
    mlips:chemicalFormula "Nd" ;
    mlips:materialClass "Metals" .

entity:mat-mgnd-piersante2026 a mlips:MaterialSystem ;
    rdfs:label "Mg-Nd orderings on hcp, bcc, fcc and C15 parent lattices and precipitate phases" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-piersante2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-piersante2026 mlips:hasDFTSettings entity:calc-settings-vasp-piersante2026 .

entity:calc-settings-vasp-piersante2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, smallest spacing about 0.02 1/A" ;
    rdfs:comment "Methfessel-Paxton 0.2 eV; Nd 5s2 5p6 4f1 6s2 valence" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mg-piersante2026 a mlips:TrainingDataset ;
    rdfs:label "Pure Mg training set" ;
    mlips:coversMaterial entity:mat-mg-piersante2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-piersante2026 .

entity:ds-nd-piersante2026 a mlips:TrainingDataset ;
    rdfs:label "Pure Nd training set" ;
    mlips:coversMaterial entity:mat-nd-piersante2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-piersante2026 .

entity:ds-mgnd-piersante2026 a mlips:TrainingDataset ;
    rdfs:label "Mg-Nd training set" ;
    mlips:coversMaterial entity:mat-mgnd-piersante2026 ,
        entity:mat-mg-piersante2026 ,
        entity:mat-nd-piersante2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-piersante2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mg-piersante2026 mlips:samplingStrategy
    entity:sampling-maha-piersante2026 .

entity:ds-nd-piersante2026 mlips:samplingStrategy
    entity:sampling-maha-piersante2026 .

entity:ds-mgnd-piersante2026 mlips:samplingStrategy
    entity:sampling-maha-piersante2026 .

entity:sampling-maha-piersante2026 a mlips:SamplingStrategy ;
    rdfs:label "Structures enumerated along hcp-bcc pathways and orderings, selected by largest Mahalanobis distance in descriptor space, plus one active-learning round for Mg-Nd" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-piersante2026 ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-piersante2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-nfunc-piersante2026 ;
    mlips:hasImplementation entity:impl-ACE-piersante2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:NudgedElasticBand .

entity:loss-ACE-piersante2026 a mlips:LossFunction ;
    rdfs:label "Weighted energies and forces with extra weight near the convex hull; L1/L2 regularization (about 1e-5 for Mg and Mg-Nd, 1e-8 for Nd)" .

entity:alg-ACE-piersante2026 a mls:Algorithm ;
    rdfs:label "Coarse fit (ladder or subset), then fine-tuning on the full set; unary parameters fitted before binary ones" .

entity:impl-ACE-piersante2026 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:hp-nfunc-piersante2026 a mlips:Hyperparameter ;
    rdfs:label "Number of ACE basis (cluster) functions" ;
    mlips:hyperparameterName "number of basis functions" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ace-mg-nfunc-piersante2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-piersante2026 ;
    mlips:settingValue "694"^^xsd:integer .

entity:setting-ace-nd-nfunc-piersante2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-piersante2026 ;
    mlips:settingValue "890"^^xsd:integer .

entity:setting-ace-mgnd-cutoffRadius-piersante2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7.8"^^xsd:double .

entity:setting-ace-mgnd-nfunc-piersante2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-piersante2026 ;
    mlips:settingValue "4246"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ace-mg-piersante2026 a mlips:MLIPRun ;
    rdfs:label "ACE for pure Mg (694 basis functions)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-mg-piersante2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-mg-nfunc-piersante2026 ;
    mlips:produces entity:model-ace-mg-piersante2026 .

entity:model-ace-mg-piersante2026 a mlips:TrainedModel ;
    rdfs:label "ACE Mg (Piersante 2026)" .

entity:run-ace-nd-piersante2026 a mlips:MLIPRun ;
    rdfs:label "ACE for pure Nd (890 basis functions)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-nd-piersante2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-nd-nfunc-piersante2026 ;
    mlips:produces entity:model-ace-nd-piersante2026 .

entity:model-ace-nd-piersante2026 a mlips:TrainedModel ;
    rdfs:label "ACE Nd (Piersante 2026)" .

entity:run-ace-mgnd-piersante2026 a mlips:MLIPRun ;
    rdfs:label "ACE for Mg-Nd (4,246 cluster functions)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-mgnd-piersante2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-mgnd-cutoffRadius-piersante2026 ,
        entity:setting-ace-mgnd-nfunc-piersante2026 ;
    mlips:produces entity:model-ace-mgnd-piersante2026 .

entity:model-ace-mgnd-piersante2026 a mlips:TrainedModel ;
    rdfs:label "ACE Mg-Nd (Piersante 2026)" .

