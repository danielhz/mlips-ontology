# Canonical Turtle for the protocol-derived encoding of:
#   Gabriele Cesare Sosso et al. (2012). Neural network interatomic potential for the phase change material GeTe.
#   Physical Review B. doi:10.1103/physrevb.85.174103  arXiv:1201.2026v1
#
# Version read: arxiv-preprint arXiv:1201.2026v1 (sha256 bbbdca3ebebbfd5f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 669 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/sosso2012.yaml.
#
# Encoding scope: the Behler-Parrinello NN potential for GeTe (RuNNer)
# trained on about 30,000 PBE configurations of crystalline, liquid and
# amorphous GeTe, with its training and test RMSEs. Crystal, liquid and
# amorphous properties are property comparisons.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-sosso2012 a mlips:BenchmarkStudy ;
    rdfs:label "Sosso et al. (2012): neural network interatomic potential for the phase-change material GeTe" ;
    mlips:reportedIn entity:article-sosso2012 .

entity:article-sosso2012 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevb.85.174103> ;
    schema:datePublished "2012"^^xsd:gYear ;
    schema:name "Neural network interatomic potential for the phase change material GeTe" ;
    schema:author entity:person-Sosso-sosso2012 ,
        entity:person-Miceli-sosso2012 ,
        entity:person-Caravati-sosso2012 ,
        entity:person-Behler-sosso2012 ,
        entity:person-Bernasconi-sosso2012 .

entity:person-Sosso-sosso2012 a schema:Person ;
    schema:name "Gabriele C. Sosso" ;
    schema:givenName "Gabriele C." ;
    schema:familyName "Sosso" .

entity:person-Miceli-sosso2012 a schema:Person ;
    schema:name "Giacomo Miceli" ;
    schema:givenName "Giacomo" ;
    schema:familyName "Miceli" .

entity:person-Caravati-sosso2012 a schema:Person ;
    schema:name "Sebastiano Caravati" ;
    schema:givenName "Sebastiano" ;
    schema:familyName "Caravati" .

entity:person-Behler-sosso2012 a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" .

entity:person-Bernasconi-sosso2012 a schema:Person ;
    schema:name "Marco Bernasconi" ;
    schema:givenName "Marco" ;
    schema:familyName "Bernasconi" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-gete-sosso2012 a mlips:MaterialSystem ;
    rdfs:label "GeTe: trigonal crystal, liquid and amorphous phases (64-216 atom cells; 4096-atom amorphous models)" ;
    mlips:chemicalFormula "GeTe" ;
    mlips:materialClass "phase-change chalcogenide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-sosso2012 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-sosso2012 mlips:hasDFTSettings entity:calc-settings-pbe-sosso2012 .

entity:calc-settings-pbe-sosso2012 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:kPointMesh "4x4x4 Monkhorst-Pack for 64 atoms, equivalent density for larger cells" ;
    rdfs:comment "40 Ry plane-wave cutoff; outermost s and p valence electrons; configurations from CP2K AIMD (up to 3000 K) and metadynamics." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-gete-sosso2012 a mlips:TrainingDataset ;
    rdfs:label "GeTe training and test configurations (about 30,000)" ;
    mlips:coversMaterial entity:mat-gete-sosso2012 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-sosso2012 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gete-sosso2012 mlips:samplingStrategy
    entity:sampling-aimd-sosso2012 .

entity:sampling-aimd-sosso2012 a mlips:SamplingStrategy ;
    rdfs:label "CP2K AIMD (up to 3000 K) and metadynamics crystallisation snapshots, random distortions, off-stoichiometric models and NN-driven MD refinement" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-sosso2012 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-HDNNP-sosso2012 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-HDNNP-sosso2012 a mls:Algorithm ;
    rdfs:label "Three hidden layers of 20 sigmoid nodes; 159 symmetry functions" .

entity:impl-HDNNP-sosso2012 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nn-cutoffRadius-sosso2012 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.88"^^xsd:double .

entity:setting-nn-numLayers-sosso2012 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-nn-numFeatures-sosso2012 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "159"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nn-sosso2012 a mlips:MLIPRun ;
    rdfs:label "NN potential for GeTe" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-gete-sosso2012 ;
    mlips:hasHyperparameterSetting entity:setting-nn-cutoffRadius-sosso2012 ,
        entity:setting-nn-numLayers-sosso2012 ,
        entity:setting-nn-numFeatures-sosso2012 ;
    mlips:produces entity:model-nn-sosso2012 .

entity:model-nn-sosso2012 a mlips:TrainedModel ;
    rdfs:label "NN GeTe (Sosso 2012)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-sosso2012 mlips:hasResult
    entity:result-nn-train-sosso2012 ,
    entity:result-nn-test-sosso2012 .

entity:result-nn-train-sosso2012 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nn-sosso2012 ;
    mlips:targetMaterial entity:mat-gete-sosso2012 ;
    mlips:hasAccuracyMetric entity:metric-nn-train-1-sosso2012 ,
        entity:metric-nn-train-2-sosso2012 .

entity:metric-nn-train-1-sosso2012 a mlips:AccuracyMetric ;
    rdfs:label "train energy RMSE on GeTe: NN potential" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "5.01"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nn-train-2-sosso2012 a mlips:AccuracyMetric ;
    rdfs:label "train force RMSE on GeTe: NN potential" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "460"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-nn-test-sosso2012 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nn-sosso2012 ;
    mlips:targetMaterial entity:mat-gete-sosso2012 ;
    mlips:hasAccuracyMetric entity:metric-nn-test-1-sosso2012 ,
        entity:metric-nn-test-2-sosso2012 .

entity:metric-nn-test-1-sosso2012 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on GeTe: NN potential" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "5.6"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nn-test-2-sosso2012 a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on GeTe: NN potential" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "470"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

