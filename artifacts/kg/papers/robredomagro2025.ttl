###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:VASP-MLFF a mlips:MLIPMethod ;
    rdfs:label "VASP on-the-fly machine-learned force field (kernel regression on two- and three-body distribution descriptors with Bayesian error estimates)" ;
    mlips:hasTrainingAlgorithm entity:alg-VASP-MLFF-robredomagro2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-VASP-MLFF-robredomagro2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:NudgedElasticBand .

entity:alg-VASP-MLFF-robredomagro2025 a mls:Algorithm ;
    rdfs:label "Kernel ridge regression on SOAP-type descriptors with Bayesian error estimates (radial cutoff 8 A, angular cutoff 5 A); default hyperparameters" .

entity:impl-VASP-MLFF-robredomagro2025 a mlips:Implementation ;
    mlips:implementedIn mlips:VASP .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-robredomagro2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-Allegro-robredomagro2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:NudgedElasticBand .

entity:alg-Allegro-robredomagro2025 a mls:Algorithm ;
    rdfs:label "Modest hyperparameters following the Allegro example (2 tensor layers)" .

entity:impl-Allegro-robredomagro2025 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

