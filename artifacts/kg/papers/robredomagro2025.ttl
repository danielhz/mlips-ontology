###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-batio3-robredomagro2025 a mlips:MaterialSystem ;
    rdfs:label "BaTiO3 (40-atom perovskite cells)" ;
    mlips:chemicalFormula "BaTiO3" ;
    mlips:materialClass "ferroelectric perovskite" .

entity:mat-bifeo3-robredomagro2025 a mlips:MaterialSystem ;
    rdfs:label "BiFeO3 (40-atom cells)" ;
    mlips:chemicalFormula "BiFeO3" ;
    mlips:materialClass "multiferroic perovskite" .

entity:mat-pbzro3-robredomagro2025 a mlips:MaterialSystem ;
    rdfs:label "PbZrO3 (40-atom cells)" ;
    mlips:chemicalFormula "PbZrO3" ;
    mlips:materialClass "antiferroelectric perovskite" .

entity:mat-hfo2-robredomagro2025 a mlips:MaterialSystem ;
    rdfs:label "HfO2 (24-atom supercells)" ;
    mlips:chemicalFormula "HfO2" ;
    mlips:materialClass "ferroelectric fluorite oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbesol-robredomagro2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbesol-robredomagro2025 mlips:hasDFTSettings entity:calc-settings-pbesol-robredomagro2025 .

entity:calc-settings-pbesol-robredomagro2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBEsol-robredomagro2025 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred 3x3x3 (BaTiO3, PbZrO3, HfO2) or 2x2x2 (BiFeO3)" ;
    rdfs:comment "Hubbard U = 4 eV on Fe for BiFeO3." .

entity:xc-PBEsol-robredomagro2025 a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

