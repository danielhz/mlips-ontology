# Canonical Turtle for the protocol-derived encoding of:
#   Iñigo Robredo-Magro et al. (2025). Minimalist machine-learned interatomic potentials can predict complex structural behaviors accurately.
#   arXiv (Cornell University). doi:10.48550/arxiv.2511.17449  arXiv:2511.17449v1
#
# Version read: arxiv-preprint arXiv:2511.17449v1 (sha256 a5f21c128ad7c484...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 694 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/robredomagro2025.yaml.
#
# Encoding scope: for BaTiO3, BiFeO3, PbZrO3 and HfO2, the kernel models
# trained with VASP's Bayesian on-the-fly framework ('VASP MLIPs') on
# small supercells, and Allegro models trained on the same data sets.
# Training errors are stated only as bounds and extrapolation tests are
# property comparisons, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-robredomagro2025 a mlips:BenchmarkStudy ;
    rdfs:label "Robredo-Magro, Mukherjee, Aramberri and Íñiguez-González (2025): minimalist MLIPs predict complex structural behaviour of ferroelectrics" ;
    mlips:reportedIn entity:article-robredomagro2025 .

entity:article-robredomagro2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2511.17449> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Minimalist machine-learned interatomic potentials can predict complex structural behaviors accurately" ;
    schema:author entity:person-RobredoMagro-robredomagro2025 ,
        entity:person-Mukherjee-robredomagro2025 ,
        entity:person-Aramberri-robredomagro2025 ,
        entity:person-IniguezGonzalez-robredomagro2025 .

entity:person-RobredoMagro-robredomagro2025 a schema:Person ;
    schema:name "Iñigo Robredo-Magro" ;
    schema:givenName "Iñigo" ;
    schema:familyName "Robredo-Magro" .

entity:person-Mukherjee-robredomagro2025 a schema:Person ;
    schema:name "Binayak Mukherjee" ;
    schema:givenName "Binayak" ;
    schema:familyName "Mukherjee" .

entity:person-Aramberri-robredomagro2025 a schema:Person ;
