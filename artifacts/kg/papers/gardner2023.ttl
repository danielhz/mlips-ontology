    mlips:coversMaterial entity:mat-carbon-gardner2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasReferenceCalculation entity:calc-synth-gardner2023 .

entity:ds-synth-edip-gardner2023 a mlips:TrainingDataset ;
    rdfs:label "C-SYNTH-23M structures labelled with EDIP" ;
    mlips:coversMaterial entity:mat-carbon-gardner2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasReferenceCalculation entity:calc-synth-gardner2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-gardner2023 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-gardner2023 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-NequIP-gardner2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-gardner2023 a mlips:LossFunction ;
    rdfs:label "Per-atom energy MSE and force MSE weighted 4:1" .

entity:alg-NequIP-gardner2023 a mls:Algorithm ;
    rdfs:label "Adam with EMA 0.99; fine-tuning updates all weights of the best pre-trained model" .

entity:impl-NequIP-gardner2023 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

