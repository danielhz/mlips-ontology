entity:study-gardner2023 mlips:hasResult
    entity:result-direct-test-gardner2023 ,
    entity:result-ft-ace-test-gardner2023 ,
    entity:result-ft-gap-test-gardner2023 ,
    entity:result-ft-lcbop-test-gardner2023 ,
    entity:result-ft-edip-test-gardner2023 .

entity:result-direct-test-gardner2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-direct-gardner2023 ;
    mlips:targetMaterial entity:mat-carbon-gardner2023 ;
    mlips:hasAccuracyMetric entity:metric-direct-test-1-gardner2023 .

entity:metric-direct-test-1-gardner2023 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on carbon (3200 DFT structures): NequIP direct training (mean of 5, +/-6.2, one run diverged)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "51"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

