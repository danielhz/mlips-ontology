# Canonical Turtle for the protocol-derived encoding of:
#   John L. A. Gardner et al. (2023). Synthetic pre-training for neural-network interatomic potentials.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/ad1626  arXiv:2307.15714v1
#
# Version read: arxiv-preprint arXiv:2307.15714v1 (sha256 840df468d9334e04...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 663 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/gardner2023.yaml.
#
# Encoding scope: NequIP models for carbon trained directly on the
# C-GAP-17 DFT training data, and NequIP models pre-trained on the
# C-SYNTH-23M structures re-labelled by C-ACE, C-GAP-20U, LCBOP or EDIP
# and then fine-tuned on the same DFT data; the encoded results are the
# mean test energy RMSEs with 3200 DFT structures (Table 1). Smaller
# training-set sizes, force learning curves, MD stability and the
# alchemical (Si) experiments are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gardner2023 a mlips:BenchmarkStudy ;
    rdfs:label "Gardner, Baker and Deringer (2023): synthetic pre-training for neural-network interatomic potentials" ;
    mlips:reportedIn entity:article-gardner2023 .

entity:article-gardner2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/ad1626> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Synthetic pre-training for neural-network interatomic potentials" ;
    schema:author <https://orcid.org/0009-0006-7377-7146> ,
        entity:person-Baker-gardner2023 ,
        <https://orcid.org/0000-0001-6873-0278> .

<https://orcid.org/0009-0006-7377-7146> a schema:Person ;
    schema:name "John L A Gardner" ;
    schema:givenName "John L A" ;
    schema:familyName "Gardner" ;
    schema:identifier <https://orcid.org/0009-0006-7377-7146> .

entity:person-Baker-gardner2023 a schema:Person ;
    schema:name "Kathryn T Baker" ;
    schema:givenName "Kathryn T" ;
    schema:familyName "Baker" .

<https://orcid.org/0000-0001-6873-0278> a schema:Person ;
    schema:name "Volker L Deringer" ;
    schema:givenName "Volker L" ;
    schema:familyName "Deringer" ;
    schema:identifier <https://orcid.org/0000-0001-6873-0278> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-carbon-gardner2023 a mlips:MaterialSystem ;
    rdfs:label "Liquid, amorphous and crystalline carbon (C-GAP-17 data; C-SYNTH-23M structures at 1.0-3.5 g/cm3)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "elemental carbon phases" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-cgap17-dft-gardner2023 a mlips:DFTCalculation .

entity:calc-synth-gardner2023 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-cgap17-dft-gardner2023 mlips:hasDFTSettings entity:calc-settings-cgap17-dft-gardner2023 .

entity:calc-settings-cgap17-dft-gardner2023 a mlips:DFTSettings ;
    rdfs:comment "C-GAP-17 training/test labels (published DFT; not restated)." .

entity:calc-synth-gardner2023 mlips:hasReferenceSettings entity:calc-settings-synth-gardner2023 .

entity:calc-settings-synth-gardner2023 a mlips:ReferenceSettings ;
    rdfs:comment "Synthetic labels from C-ACE, C-GAP-20U, LCBOP or EDIP on C-SYNTH-23M structures." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cgap17-gardner2023 a mlips:TrainingDataset ;
    rdfs:label "C-GAP-17 DFT training data (subsets of 25-3200 structures)" ;
    mlips:coversMaterial entity:mat-carbon-gardner2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-cgap17-dft-gardner2023 .

entity:ds-synth-ace-gardner2023 a mlips:TrainingDataset ;
    rdfs:label "C-SYNTH-23M structures labelled with C-ACE" ;
    mlips:coversMaterial entity:mat-carbon-gardner2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasReferenceCalculation entity:calc-synth-gardner2023 .

entity:ds-synth-gap-gardner2023 a mlips:TrainingDataset ;
    rdfs:label "C-SYNTH-23M structures labelled with C-GAP-20U" ;
    mlips:coversMaterial entity:mat-carbon-gardner2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasReferenceCalculation entity:calc-synth-gardner2023 .

entity:ds-synth-lcbop-gardner2023 a mlips:TrainingDataset ;
