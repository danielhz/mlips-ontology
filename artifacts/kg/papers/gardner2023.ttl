entity:run-direct-gardner2023 a mlips:MLIPRun ;
    rdfs:label "NequIP trained directly on 3200 C-GAP-17 DFT structures" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-cgap17-gardner2023 ;
    mlips:hasHyperparameterSetting entity:setting-direct-numLayers-gardner2023 ,
        entity:setting-direct-numFeatures-gardner2023 ,
        entity:setting-direct-cutoffRadius-gardner2023 ;
    mlips:trainingHardware "single NVIDIA RTX A6000 (about 590 GPU hours for all models)" ;
    mlips:produces entity:model-direct-gardner2023 .

entity:model-direct-gardner2023 a mlips:TrainedModel ;
    rdfs:label "NequIP C (direct, 3200 DFT)" .

