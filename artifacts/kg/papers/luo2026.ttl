# Canonical Turtle for the protocol-derived encoding of:
#   Mingxiang Luo et al. (2026). Active rejection enables reliable generalization of universal machine-learning interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2607.09456  arXiv:2607.09456v1
#
# Version read: arxiv-preprint arXiv:2607.09456v1 (sha256 74a9747cc8afc439...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 283 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/luo2026.yaml.
#
# Encoding scope: the ATR pseudo-label data set (2.89 million accepted
# r2SCAN-level labels from universal-MLIP teachers, calibrated on about
# 18,000 r2SCAN single points), the CHGNet student and control models and
# the teacher references of Table 3 (held-out r2SCAN and MP-r2SCAN energy
# and force MAEs), the SevenNet-Omni-i12-MP calibration-set errors (Fig.
# 2a, b) and the HgInSn AIMD energy MAEs (Table 4). Router screening
# metrics (Tables 1, 2) and MD stability statistics are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-luo2026 a mlips:BenchmarkStudy ;
    rdfs:label "Luo et al. (2026): Adaptive Multi-Teacher Routing (ATR) with active rejection for r2SCAN-level pseudo-labels and CHGNet students" ;
    mlips:reportedIn entity:article-luo2026 .

entity:article-luo2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2607.09456> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Active rejection enables reliable generalization of universal machine-learning interatomic potentials" ;
    schema:author entity:person-Luo-luo2026 ,
        entity:person-Mao-luo2026 ,
        entity:person-Wang-luo2026 ,
        entity:person-Bai-luo2026 ,
        entity:person-Ding-luo2026 ,
        entity:person-Li-luo2026 .

entity:person-Luo-luo2026 a schema:Person ;
    schema:name "Mingxiang Luo" ;
    schema:givenName "Mingxiang" ;
    schema:familyName "Luo" .

entity:person-Mao-luo2026 a schema:Person ;
    schema:name "Xinnan Mao" ;
    schema:givenName "Xinnan" ;
    schema:familyName "Mao" .

entity:person-Wang-luo2026 a schema:Person ;
    schema:name "Lu Wang" ;
    schema:givenName "Lu" ;
    schema:familyName "Wang" .

entity:person-Bai-luo2026 a schema:Person ;
    schema:name "Lei Bai" ;
    schema:givenName "Lei" ;
    schema:familyName "Bai" .

entity:person-Ding-luo2026 a schema:Person ;
    schema:name "Feng Ding" ;
    schema:givenName "Feng" ;
    schema:familyName "Ding" .

entity:person-Li-luo2026 a schema:Person ;
    schema:name "Yuqiang Li" ;
    schema:givenName "Yuqiang" ;
    schema:familyName "Li" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-open-materials-luo2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic materials from Materials Project, Alexandria, MPtrj and OQMD (86 elements, up to 240 atoms; mostly bulk alloys, halides, chalcogenides and oxides)" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-hginsn-luo2026 a mlips:MaterialSystem ;
    rdfs:label "Hg16In20Sn12 alloy supercell at 300 K" ;
    mlips:chemicalFormula "Hg16In20Sn12" ;
    mlips:materialClass "Soft-metal alloy" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scan-luo2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scan-luo2026 mlips:hasDFTSettings entity:calc-settings-r2scan-luo2026 .

entity:calc-settings-r2scan-luo2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-luo2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "680"^^xsd:double ;
    mlips:kPointMesh "KSPACING = 0.22 1/A" ;
    rdfs:comment "MatPES-compatible static workflow, PBE_64 PAW, ENAUG 1360 eV, PREC Accurate, EDIFF 1e-5, spin-polarised; AIMD with 450 eV and Gamma point." .

entity:xc-r2SCAN-luo2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-atr-luo2026 a mlips:TrainingDataset ;
    rdfs:label "ATR pseudo-label pretraining set: about 2.6 million of 2,893,331 accepted r2SCAN-level pseudo-labels (from 7,674,241 PBE candidate structures)" ;
    mlips:coversMaterial entity:mat-open-materials-luo2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-r2scan-luo2026 ;
    rdfs:comment "Pseudo-labels from SevenNet, MACE, CHGNet and PET-MAD teachers selected by the ATR router; calibration set of about 18,000 real r2SCAN single points." .

entity:ds-pbe-orig-luo2026 a mlips:TrainingDataset ;
    rdfs:label "Same 2.6M structure pool with original (non-routed) labels, for the without-ATR controls" ;
    mlips:coversMaterial entity:mat-open-materials-luo2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-mp-r2scan-luo2026 a mlips:TrainingDataset ;
    rdfs:label "MP-r2SCAN training data" ;
    mlips:coversMaterial entity:mat-open-materials-luo2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasLossFunction entity:loss-CHGNet-luo2026 ;
    mlips:hasTrainingAlgorithm entity:alg-CHGNet-luo2026 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-CHGNet-luo2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-CHGNet-luo2026 a mlips:LossFunction ;
    rdfs:label "Huber loss on energies and forces (wE:wF = 1:1 in pretraining, 3:1 in fine-tuning)" .

entity:alg-CHGNet-luo2026 a mls:Algorithm ;
    rdfs:label "4-GPU DDP, cosine annealing from 1e-3 to 1e-5" .

entity:impl-CHGNet-luo2026 a mlips:Implementation ;
    mlips:implementedIn mlips:CHGNet .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-student-pre-learningRate-luo2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-student-pre-batchSize-luo2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-student-pre-numEpochs-luo2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "40"^^xsd:integer .

entity:setting-student-learningRate-luo2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-student-batchSize-luo2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-student-numEpochs-luo2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-baseline-luo2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet trained only on MP-r2SCAN (baseline)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-mp-r2scan-luo2026 ;
    mlips:produces entity:model-baseline-luo2026 .

entity:model-baseline-luo2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet baseline (MP-r2SCAN only)" .

entity:run-noatr1-luo2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet without ATR, control 1 (non-routed pretraining on the same structure pool)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-pbe-orig-luo2026 ;
    mlips:produces entity:model-noatr1-luo2026 .

entity:model-noatr1-luo2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet without ATR 1" .

entity:run-noatr2-luo2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet without ATR, control 2 (non-routed pretraining on the same structure pool, different protocol)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-pbe-orig-luo2026 ;
    mlips:produces entity:model-noatr2-luo2026 .

entity:model-noatr2-luo2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet without ATR 2" .

entity:run-student-pre-luo2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet pretrained from scratch on ATR pseudo-labels" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-atr-luo2026 ;
    mlips:hasHyperparameterSetting entity:setting-student-pre-learningRate-luo2026 ,
        entity:setting-student-pre-batchSize-luo2026 ,
        entity:setting-student-pre-numEpochs-luo2026 ;
    mlips:produces entity:model-student-pre-luo2026 .

entity:model-student-pre-luo2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet ATR-pretrained checkpoint" .

entity:run-student-luo2026 a mlips:MLIPRun ;
    rdfs:label "ATR student: ATR-pretrained CHGNet fine-tuned on MP-r2SCAN" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-mp-r2scan-luo2026 ;
    mlips:hasHyperparameterSetting entity:setting-student-learningRate-luo2026 ,
        entity:setting-student-batchSize-luo2026 ,
        entity:setting-student-numEpochs-luo2026 ;
    mlips:produces entity:model-student-luo2026 .

entity:model-student-luo2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet ATR student" .

entity:run-chgnet-r2scan-luo2026 a mlips:MLIPRun ;
    rdfs:label "Official CHGNet-r2SCAN checkpoint as distributed" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-r2scan-luo2026 .

entity:model-chgnet-r2scan-luo2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet-r2SCAN" .

entity:run-7net-mp-luo2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Omni-i12 (MP-r2SCAN channel) as distributed" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-7net-mp-luo2026 .

entity:model-7net-mp-luo2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Omni-i12-MP (r2SCAN)" .

entity:run-7net-matpes-luo2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Omni-i12 (MatPES-r2SCAN channel) as distributed" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-7net-matpes-luo2026 .

entity:model-7net-matpes-luo2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Omni-i12-MatPES (r2SCAN)" .

