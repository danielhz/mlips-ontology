entity:ds-rmd17-aspirin-christensen2020 a mlips:TrainingDataset ;
    rdfs:label "rMD17 aspirin (100,000 structures; training sets of up to 1,000)" ;
    mlips:coversMaterial entity:mat-aspirin-christensen2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100000 ;
    mlips:hasDFTCalculation entity:calc-rmd17-christensen2020 ;
