    rdfs:comment "Single-point recomputation of energies and forces at PBE/def2-SVP (Sec. 4.3.1)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:FCHL19 a mlips:MLIPMethod ;
    rdfs:label "FCHL19 representation with Gaussian kernel regression (operator quantum machine learning)" ;
    mlips:hasLossFunction entity:loss-FCHL19-christensen2020 ;
    mlips:hasTrainingAlgorithm entity:alg-FCHL19-christensen2020 ;
    mlips:hasImplementation entity:impl-FCHL19-christensen2020 .

entity:loss-FCHL19-christensen2020 a mlips:LossFunction ;
    rdfs:label "Kernel ridge regression on energies, forces (via kernel derivatives) or both; hyperparameters chosen with the score of Eq. 19" .

entity:alg-FCHL19-christensen2020 a mls:Algorithm ;
    rdfs:label "Closed-form kernel regression with nested cross-validation grid search over kernel width and regularisation" .

entity:impl-FCHL19-christensen2020 a mlips:Implementation ;
    mlips:implementedIn entity:lib-QML-christensen2020 .

entity:lib-QML-christensen2020 a mlips:Library ;
    rdfs:label "QML" ;
    rdfs:comment "QML machine learning package (Python)" ;
    mlips:candidateForVocabulary mlips:Library .

