###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-rmd17-christensen2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-rmd17-christensen2020 mlips:hasDFTSettings entity:calc-settings-rmd17-christensen2020 .

entity:calc-settings-rmd17-christensen2020 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional mlips:PBE ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "ORCA 4.0.1 with the RI approximation for the Coulomb integrals, VeryTightSCF, Grid7 and NoFinalGrid (Sec. 4.3.1)." .

