    schema:givenName "Anders S" ;
    schema:familyName "Christensen" ;
    schema:identifier <https://orcid.org/0000-0002-7253-6897> .

entity:person-vonLilienfeld-christensen2020 a schema:Person ;
    schema:name "O Anatole von Lilienfeld" ;
    schema:givenName "O Anatole" ;
    schema:familyName "von Lilienfeld" .

