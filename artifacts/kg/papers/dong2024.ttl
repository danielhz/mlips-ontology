        entity:setting-nep1-Ngen-dong2024 ,
        entity:setting-nep1-batchSize-dong2024 ;
    mlips:produces entity:model-nep1-dong2024 .

entity:model-nep1-dong2024 a mlips:TrainedModel ;
    rdfs:label "Si NEP-iteration-1 (Dong 2024)" .

