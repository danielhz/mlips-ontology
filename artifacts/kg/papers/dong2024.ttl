###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-si-dong2024 a mlips:MaterialSystem ;
    rdfs:label "Crystalline (diamond-cubic) silicon, 100-1000 K" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental semiconductor" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-dong2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-dong2024 mlips:hasDFTSettings entity:calc-settings-pbe-dong2024 .

entity:calc-settings-pbe-dong2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "4x4x4 (64-atom supercells), 12x12x12 (8-atom cells)" ;
    rdfs:comment "EDIFF 1e-6 eV (Sec. III B 1)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-it1-dong2024 a mlips:TrainingDataset ;
    rdfs:label "Initial silicon training set (150 structures, 6,800 atoms)" ;
    mlips:coversMaterial entity:mat-si-dong2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 150 ;
    mlips:hasDFTCalculation entity:calc-pbe-dong2024 .

entity:ds-it2-dong2024 a mlips:TrainingDataset ;
    rdfs:label "Expanded silicon training set (250 structures)" ;
    mlips:coversMaterial entity:mat-si-dong2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 250 ;
    mlips:hasDFTCalculation entity:calc-pbe-dong2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-it1-dong2024 mlips:samplingStrategy
    entity:sampling-init-dong2024 .

entity:ds-it2-dong2024 mlips:samplingStrategy
    entity:sampling-init-dong2024 ,
    entity:sampling-iter-dong2024 .

entity:sampling-init-dong2024 a mlips:SamplingStrategy ;
    rdfs:label "50 randomly strained (+-3 %) and perturbed (0.1 A) 8-atom cells plus 100 snapshots of a 10 ps 1000 K AIMD of a 64-atom cell" .

entity:sampling-iter-dong2024 a mlips:SamplingStrategy ;
    rdfs:label "NEP-iteration-1 NPT MD at 0 GPa and 100-1000 K (10 ps), 100 snapshots added" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-dong2024 ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-dong2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        entity:hp-Nneu-dong2024 ,
        entity:hp-Ngen-dong2024 ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NEP-dong2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-NEP-dong2024 a mlips:LossFunction ;
    rdfs:label "Weighted RMSEs of energy, force and virial (weights 1, 1, 0.1) with l1 and l2 regularisation" .

entity:alg-NEP-dong2024 a mls:Algorithm ;
    rdfs:label "Separable natural evolution strategy (SNES), population 50" .

entity:impl-NEP-dong2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-dong2024 .

entity:lib-GPUMD-dong2024 a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Nneu-dong2024 a mlips:Hyperparameter ;
    rdfs:label "Number of neurons in the hidden layer of the NEP network" ;
    mlips:hyperparameterName "N_neu" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-Ngen-dong2024 a mlips:Hyperparameter ;
    rdfs:label "Number of SNES training generations" ;
    mlips:hyperparameterName "N_gen" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

