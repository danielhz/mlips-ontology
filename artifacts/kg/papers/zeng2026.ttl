###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-pdbdimers-zeng2026 a mlips:MaterialSystem ;
    rdfs:label "Protein fragment dimers (17 fragment types, 153 combinations) from high-resolution PDB structures" ;
    mlips:materialClass "Molecular dimers and noncovalent complexes" .

entity:mat-csd-zeng2026 a mlips:MaterialSystem ;
    rdfs:label "Fragment dimers from CSD small-molecule crystal geometries" ;
    mlips:materialClass "Molecular dimers and noncovalent complexes" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97x-zeng2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97x-zeng2026 mlips:hasDFTSettings entity:calc-settings-wb97x-zeng2026 .

entity:calc-settings-wb97x-zeng2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-wB97X-D3BJ-zeng2026 ;
    mlips:basisSet "def2-TZVPP" ;
    rdfs:comment "RIJCOSX, ma-def2-TZVPP on anionic oxygens, counterpoise-corrected interaction energies" .

entity:xc-wB97X-D3BJ-zeng2026 a mlips:XCFunctional ;
    rdfs:label "wB97X-D3BJ" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fragid-zeng2026 a mlips:TrainingDataset ;
    rdfs:label "PDB-FRAGID (about 3.15 million dimers, wB97X-D3BJ/def2-TZVPP interaction energies)" ;
    mlips:coversMaterial entity:mat-pdbdimers-zeng2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97x-zeng2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-fragid-zeng2026 mlips:samplingStrategy
    entity:sampling-mfal-zeng2026 .

entity:sampling-mfal-zeng2026 a mlips:SamplingStrategy ;
    rdfs:label "Multi-fidelity active learning: NequIP surrogate on r2SCAN-3c labels flags high-error dimers from 36.3 million PDB dimers (normalized error above 0.04 kcal/mol)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-zeng2026 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-zeng2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NequIP-zeng2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-NequIP-zeng2026 a mlips:LossFunction ;
    rdfs:label "Interaction energies" .

entity:alg-NequIP-zeng2026 a mls:Algorithm ;
    rdfs:label "Ensemble of 5 models by five-fold cross-validation; early stopping (patience 100)" .

entity:impl-NequIP-zeng2026 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-panip-cutoffRadius-zeng2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7.5"^^xsd:double .

entity:setting-panip-batchSize-zeng2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "512"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-panip-zeng2026 a mlips:MLIPRun ;
    rdfs:label "PANIP (NequIP ensemble of 5)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-fragid-zeng2026 ;
    mlips:hasHyperparameterSetting entity:setting-panip-cutoffRadius-zeng2026 ,
        entity:setting-panip-batchSize-zeng2026 ;
    mlips:produces entity:model-panip-zeng2026 .

entity:model-panip-zeng2026 a mlips:TrainedModel ;
    rdfs:label "PANIP" .

# Registry stub for the externally trained model ANI-2x (not trained in this paper).
entity:run-ANI-2x a mlips:MLIPRun ;
    rdfs:label "Training run of ANI-2x general-purpose neural network potential" ;
    mlips:appliesMethod entity:ANI ;
    mlips:produces entity:model-ANI-2x .

entity:model-ANI-2x a mlips:TrainedModel ;
    rdfs:label "ANI-2x general-purpose neural network potential" .

