# Canonical Turtle for the protocol-derived encoding of:
#   Bangchen Yin et al. (2026). Hessian-informed machine learning interatomic potential towards bridging theory and experiments.
#   arXiv (Cornell University). doi:10.48550/arxiv.2603.25373  arXiv:2603.25373v1
#
# Version read: arxiv-preprint arXiv:2603.25373v1 (sha256 af76672d36201989...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 513 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/yin2026.yaml.
#
# Encoding scope: AlphaNet models pre-trained on GFN2-xTB Hessian
# datasets (HORM-xTB-Hess, T1x-xTB-Hess) and fine-tuned on the HORM
# wB97X/6-31G(d) dataset with sparse Hessian labels, and the H3S model
# fine-tuned with supercell Hessian and unit-cell data. The text states
# only Hessian and eigenvalue MAEs (not energy/force/stress metrics);
# energy/force MAEs are figure-only. TS search, free energies and
# anharmonic phonons are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-yin2026 a mlips:BenchmarkStudy ;
    rdfs:label "Yin et al. (2026): Hessian-informed training (HINT) of AlphaNet potentials with xTB Hessian pre-training, curriculum learning and stochastic projected Hessian loss" ;
    mlips:reportedIn entity:article-yin2026 .

entity:article-yin2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2603.25373> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Hessian-informed machine learning interatomic potential towards bridging theory and experiments" ;
    schema:author entity:person-Yin-yin2026 ,
        entity:person-Ouyang-yin2026 ,
        entity:person-Fan-yin2026 ,
        entity:person-Lin-yin2026 ,
        entity:person-Hu-yin2026 ,
        entity:person-Lv-yin2026 ,
        entity:person-Ren-yin2026 ,
        entity:person-Xiao-yin2026 ,
        entity:person-Chen-yin2026 ,
        entity:person-Cao-yin2026 .

