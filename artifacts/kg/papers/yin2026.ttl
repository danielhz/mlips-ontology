###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-orgrx-yin2026 a mlips:MaterialSystem ;
    rdfs:label "Organic reaction configurations of Transition1x/RGD1 (HORM)" ;
    mlips:materialClass "Organic molecules (gas phase)" .

entity:mat-h3s-yin2026 a mlips:MaterialSystem ;
    rdfs:label "H3S at about 150 GPa (Im-3m and R3m)" ;
    mlips:chemicalFormula "H3S" ;
    mlips:materialClass "Hydrides under pressure" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-xtb-yin2026 a mlips:ReferenceCalculation .

entity:calc-horm-yin2026 a mlips:DFTCalculation .

entity:calc-h3sdft-yin2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-xtb-yin2026 mlips:hasReferenceSettings entity:calc-settings-xtb-yin2026 .

entity:calc-settings-xtb-yin2026 a mlips:ReferenceSettings ;
    rdfs:comment "GFN2-xTB energies, forces and full Hessians (pre-training)" .

entity:calc-horm-yin2026 mlips:hasDFTSettings entity:calc-settings-horm-yin2026 .

entity:calc-settings-horm-yin2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "HORM labels with full Hessians" .

entity:calc-h3sdft-yin2026 mlips:hasDFTSettings entity:calc-settings-h3sdft-yin2026 .

entity:calc-settings-h3sdft-yin2026 a mlips:DFTSettings ;
    rdfs:comment "Supercell Hessian of the SSCHA workflow and 30 displaced unit cells, converged k-points" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-horm-xtb-yin2026 a mlips:TrainingDataset ;
    rdfs:label "HORM-xTB-Hess (about 1.7M configurations, GFN2-xTB Hessians)" ;
    mlips:coversMaterial entity:mat-orgrx-yin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasReferenceCalculation entity:calc-xtb-yin2026 .

entity:ds-t1x-xtb-yin2026 a mlips:TrainingDataset ;
    rdfs:label "T1x-xTB-Hess (about 9.6M configurations, GFN2-xTB Hessians)" ;
    mlips:coversMaterial entity:mat-orgrx-yin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasReferenceCalculation entity:calc-xtb-yin2026 .

entity:ds-horm-100k-yin2026 a mlips:TrainingDataset ;
    rdfs:label "HORM fine-tuning subset of 100,000 configurations with 10-100,000 Hessian labels" ;
    mlips:coversMaterial entity:mat-orgrx-yin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 100000 ;
    mlips:hasDFTCalculation entity:calc-horm-yin2026 .

entity:ds-horm-full-yin2026 a mlips:TrainingDataset ;
    rdfs:label "Full HORM dataset (1,725,362 configurations with Hessians)" ;
    mlips:coversMaterial entity:mat-orgrx-yin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1725362 ;
    mlips:hasDFTCalculation entity:calc-horm-yin2026 .

entity:ds-h3s-yin2026 a mlips:TrainingDataset ;
    rdfs:label "H3S fine-tuning data (supercell Hessian and 30 displaced unit cells)" ;
    mlips:coversMaterial entity:mat-h3s-yin2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-h3sdft-yin2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-horm-xtb-yin2026 mlips:samplingStrategy
    entity:sampling-hormconf-yin2026 .

entity:ds-t1x-xtb-yin2026 mlips:samplingStrategy
    entity:sampling-t1x-yin2026 .

entity:ds-horm-100k-yin2026 mlips:samplingStrategy
    entity:sampling-hsub-yin2026 .

entity:ds-horm-full-yin2026 mlips:samplingStrategy
    entity:sampling-hormconf-yin2026 .

entity:ds-h3s-yin2026 mlips:samplingStrategy
    entity:sampling-h3srand-yin2026 .

entity:sampling-t1x-yin2026 a mlips:SamplingStrategy ;
    rdfs:label "Configurations of Transition1x (about 9.6M) relabelled with GFN2-xTB" .

entity:sampling-hormconf-yin2026 a mlips:SamplingStrategy ;
    rdfs:label "HORM configurations (about 1.7M)" .

entity:sampling-hsub-yin2026 a mlips:SamplingStrategy ;
    rdfs:label "Fine-tuning subset with full E/F labels and a small random fraction of Hessian labels (SOAP weighted-local-density or energy-based ranking)" .

entity:sampling-h3srand-yin2026 a mlips:SamplingStrategy ;
    rdfs:label "SSCHA supercell plus 30 unit cells with Gaussian displacements (0.4 A)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:AlphaNet a mlips:MLIPMethod ;
    rdfs:label "AlphaNet (local-frame equivariant graph neural network potential)" ;
    mlips:hasLossFunction entity:loss-AlphaNet-yin2026 ;
    mlips:hasTrainingAlgorithm entity:alg-AlphaNet-yin2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-AlphaNet-yin2026 a mlips:LossFunction ;
    rdfs:label "w_E 4, w_F 100, Hessian weight ramped linearly from 0 to 0.1; stochastic Hessian-vector projection with Rademacher vectors (m = 5)" .

entity:alg-AlphaNet-yin2026 a mls:Algorithm ;
    rdfs:label "Low-fidelity Hessian pre-training, then curriculum fine-tuning" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-pt-horm-yin2026 a mlips:MLIPRun ;
    rdfs:label "AlphaNet pre-trained on HORM-xTB-Hess" ;
    mlips:appliesMethod entity:AlphaNet ;
    mlips:runsOn entity:ds-horm-xtb-yin2026 ;
    mlips:produces entity:model-pt-horm-yin2026 .

entity:model-pt-horm-yin2026 a mlips:TrainedModel ;
    rdfs:label "AlphaNet HORM-xTB-Hess pre-trained" .

entity:run-pt-t1x-yin2026 a mlips:MLIPRun ;
    rdfs:label "AlphaNet pre-trained on T1x-xTB-Hess" ;
    mlips:appliesMethod entity:AlphaNet ;
    mlips:runsOn entity:ds-t1x-xtb-yin2026 ;
    mlips:produces entity:model-pt-t1x-yin2026 .

entity:model-pt-t1x-yin2026 a mlips:TrainedModel ;
    rdfs:label "AlphaNet T1x-xTB-Hess pre-trained" .

entity:run-hi-100k-yin2026 a mlips:MLIPRun ;
    rdfs:label "Hi-MLIP: AlphaNet fine-tuned on 100,000 HORM configurations with sparse Hessians" ;
    mlips:appliesMethod entity:AlphaNet ;
    mlips:runsOn entity:ds-horm-100k-yin2026 ;
    mlips:produces entity:model-hi-100k-yin2026 .

entity:model-hi-100k-yin2026 a mlips:TrainedModel ;
    rdfs:label "Hi-MLIP AlphaNet HORM 100k" .

entity:run-hi-best-yin2026 a mlips:MLIPRun ;
    rdfs:label "Hi-MLIP 'best': AlphaNet fine-tuned on full HORM after T1x-xTB-Hess pre-training" ;
    mlips:appliesMethod entity:AlphaNet ;
    mlips:runsOn entity:ds-horm-full-yin2026 ;
    mlips:produces entity:model-hi-best-yin2026 .

entity:model-hi-best-yin2026 a mlips:TrainedModel ;
    rdfs:label "Hi-MLIP AlphaNet best" .

entity:run-hi-h3s-yin2026 a mlips:MLIPRun ;
    rdfs:label "Hi-MLIP AlphaNet for H3S (OMat24 pre-training, Hessian fine-tuning)" ;
    mlips:appliesMethod entity:AlphaNet ;
    mlips:runsOn entity:ds-h3s-yin2026 ;
    mlips:produces entity:model-hi-h3s-yin2026 .

entity:model-hi-h3s-yin2026 a mlips:TrainedModel ;
    rdfs:label "Hi-MLIP AlphaNet H3S" .

