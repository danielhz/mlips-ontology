###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:SO3krates a mlips:MLIPMethod ;
    rdfs:label "SO3krates (equivariant message-passing transformer with Euclidean self-attention)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:sGDML a mlips:MLIPMethod ;
    rdfs:label "Symmetric Gradient-Domain Machine Learning (sGDML)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:FCHL19 a mlips:MLIPMethod ;
    rdfs:label "FCHL19 representation with Gaussian kernel regression (operator quantum machine learning)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-poltavsky2025 a mlips:MLIPRun ;
    rdfs:label "MACE models of the TEA Challenge 2023 (one per system, trained in part 1)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-poltavsky2025 .

entity:model-mace-poltavsky2025 a mlips:TrainedModel ;
    rdfs:label "TEA 2023 MACE models" .

entity:run-so3krates-poltavsky2025 a mlips:MLIPRun ;
    rdfs:label "SO3krates models of the TEA Challenge 2023 (one per system, trained in part 1)" ;
    mlips:appliesMethod entity:SO3krates ;
    mlips:produces entity:model-so3krates-poltavsky2025 .

entity:model-so3krates-poltavsky2025 a mlips:TrainedModel ;
    rdfs:label "TEA 2023 SO3krates models" .

entity:run-sgdml-poltavsky2025 a mlips:MLIPRun ;
    rdfs:label "sGDML models of the TEA Challenge 2023 (one per system, trained in part 1)" ;
    mlips:appliesMethod entity:sGDML ;
    mlips:produces entity:model-sgdml-poltavsky2025 .

entity:model-sgdml-poltavsky2025 a mlips:TrainedModel ;
    rdfs:label "TEA 2023 sGDML models" .

entity:run-gap-poltavsky2025 a mlips:MLIPRun ;
    rdfs:label "SOAP/GAP models of the TEA Challenge 2023 (one per system, trained in part 1)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:produces entity:model-gap-poltavsky2025 .

entity:model-gap-poltavsky2025 a mlips:TrainedModel ;
    rdfs:label "TEA 2023 SOAP/GAP models" .

entity:run-fchl19-poltavsky2025 a mlips:MLIPRun ;
    rdfs:label "FCHL19* models of the TEA Challenge 2023 (one per system, trained in part 1)" ;
    mlips:appliesMethod entity:FCHL19 ;
    mlips:produces entity:model-fchl19-poltavsky2025 .

entity:model-fchl19-poltavsky2025 a mlips:TrainedModel ;
    rdfs:label "TEA 2023 FCHL19* models" .

