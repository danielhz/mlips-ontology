###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ala4-poltavsky2025 a mlips:MaterialSystem ;
    rdfs:label "Alanine tetrapeptide (gas phase)" ;
    mlips:materialClass "Biomolecule (peptide)" .

entity:mat-ac-phe-ala5-lys-poltavsky2025 a mlips:MaterialSystem ;
    rdfs:label "N-acetylphenylalanyl-pentaalanyl-lysine (gas phase)" ;
    mlips:materialClass "Biomolecule (peptide)" .

entity:mat-naph-graphene-poltavsky2025 a mlips:MaterialSystem ;
    rdfs:label "1,8-naphthyridine adsorbed on graphene" ;
    mlips:materialClass "Molecule-surface interface" .

entity:mat-mapbi3-poltavsky2025 a mlips:MaterialSystem ;
    rdfs:label "Methylammonium lead iodide perovskite" ;
    mlips:chemicalFormula "CH3NH3PbI3" ;
    mlips:materialClass "Hybrid organic-inorganic perovskite" .

