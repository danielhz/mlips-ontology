@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-edwards2026benchmarking a mlips:BenchmarkStudy ;
    rdfs:label "Edwards and Evans (2026): benchmarking universal MLIPs on high-temperature AIMD of nine MOFs" ;
    mlips:reportedIn entity:article-edwards2026benchmarking .

entity:article-edwards2026benchmarking a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2604.25262> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Benchmarking Universal Machine-Learned Interatomic Potentials for High-Temperature Metal-Organic Framework Chemistry" ;
    schema:author entity:person-Edwards-edwards2026benchmarking ,
        entity:person-Evans-edwards2026benchmarking .

entity:person-Edwards-edwards2026benchmarking a schema:Person ;
    schema:name "Connor W. Edwards" ;
    schema:givenName "Connor W." ;
    schema:familyName "Edwards" .

entity:person-Evans-edwards2026benchmarking a schema:Person ;
    schema:name "Jack D. Evans" ;
    schema:givenName "Jack D." ;
    schema:familyName "Evans" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mofs-edwards2026benchmarking a mlips:MaterialSystem ;
    rdfs:label "Nine MOFs: ZIF-8, CALF-20, MOF-10, MOF-5, MIP-206, UiO-66, UiO-67, UiO-66-NH2 and NU-1000" ;
    mlips:materialClass "Zn and Zr metal-organic frameworks" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-edwards2026benchmarking a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-edwards2026benchmarking mlips:hasDFTSettings entity:calc-settings-pbe-d3-edwards2026benchmarking .

entity:calc-settings-pbe-d3-edwards2026benchmarking a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-edwards2026benchmarking ;
    mlips:xcFunctional entity:xc-PBE-D3-edwards2026benchmarking ;
    mlips:pseudopotentialType mlips:NormConserving ;
    rdfs:comment "CP2K 2023.2 Quickstep, TZV2P-type triple-zeta valence polarised basis, GTH pseudopotentials; 500 Ry cutoff and 50 Ry relative cutoff for MD (1000/60 Ry for optimisation); SCF 1e-6 Ha." .

entity:lib-CP2K-edwards2026benchmarking a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE-D3-edwards2026benchmarking a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mof-aimd-edwards2026benchmarking a mlips:TrainingDataset ;
    rdfs:label "High-temperature MOF AIMD data set (nine MOFs x three temperatures, 40 ps each)" ;
    mlips:coversMaterial entity:mat-mofs-edwards2026benchmarking ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-edwards2026benchmarking ;
    rdfs:comment "Extends the 16 ps ZIF-8 and CALF-20 trajectories of Ref. [16]; Figshare 10.25909/32061111." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mof-aimd-edwards2026benchmarking mlips:samplingStrategy
    entity:sampling-aimd-edwards2026benchmarking .

entity:sampling-aimd-edwards2026benchmarking a mlips:SamplingStrategy ;
    rdfs:label "NVT AIMD of each MOF at 300, 1000 and 2000 K for 40 ps (0.5 fs step, CSVR thermostat)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

