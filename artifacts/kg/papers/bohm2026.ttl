# Canonical Turtle for the protocol-derived encoding of:
#   Jonas Böhm et al. (2026). Predicting Crystal Structures and Ionic Conductivities in Li 3 YCl 6−x Br x Halide Solid Electrolytes Using a Fine‐Tuned Machine Learning Interatomic Potential.
#   Advanced Intelligent Systems. doi:10.1002/aisy.202501382  arXiv:2510.09861v3
#
# Version read: arxiv-preprint arXiv:2510.09861v3 (sha256 1f1987c13793ce47...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 411 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/bohm2026.yaml.
#
# Encoding scope: M3GNet-based energy ranking of enumerated orderings,
# the pretrained CHGNet 0.3.0 and its iterative fine-tuning on DFT (PBE)
# labels of furthest-point-sampled MD snapshots of LYC and LYB at
# increasing temperatures (CHGNet_T models, 200 K steps; CHGNet_600K used
# for production), SevenNet-MF-ompa as a comparison, and the MD of the
# Li3YCl6-xBrx series. Accuracy is stated only as upper bounds (gaps);
# volumes, diffusivities and conductivities are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bohm2026 a mlips:BenchmarkStudy ;
    rdfs:label "Böhm and Champagne (2026): crystal structures and ionic conductivities of Li3YCl6-xBrx halide solid electrolytes with an iteratively fine-tuned CHGNet" ;
    mlips:reportedIn entity:article-bohm2026 .

entity:article-bohm2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1002/aisy.202501382> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Predicting Crystal Structures and Ionic Conductivities in Li 3 YCl 6−x Br x Halide Solid Electrolytes Using a Fine‐Tuned Machine Learning Interatomic Potential" ;
    schema:author <https://orcid.org/0009-0002-0064-495X> ,
        <https://orcid.org/0000-0002-6013-2887> .

<https://orcid.org/0009-0002-0064-495X> a schema:Person ;
    schema:name "Jonas Böhm" ;
    schema:givenName "Jonas" ;
    schema:familyName "Böhm" ;
    schema:identifier <https://orcid.org/0009-0002-0064-495X> .

<https://orcid.org/0000-0002-6013-2887> a schema:Person ;
    schema:name "Aurélie Champagne" ;
    schema:givenName "Aurélie" ;
    schema:familyName "Champagne" ;
    schema:identifier <https://orcid.org/0000-0002-6013-2887> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lycb-bohm2026 a mlips:MaterialSystem ;
    rdfs:label "Li3YCl6-xBrx (x = 0-6) ordered supercells of the P-3m1 (LYC) and C2/m (LYB) parent phases" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-bohm2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-bohm2026 mlips:hasDFTSettings entity:calc-settings-pbe-bohm2026 .

entity:calc-settings-pbe-bohm2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "350"^^xsd:double ;
    mlips:kPointMesh "3x3x3 Gamma-centred (static training labels)" ;
    rdfs:comment "Energies converged to 0.5 meV/atom; 520 eV and 0.2 1/A for optimisations (Computational Methods)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ft-bohm2026 a mlips:TrainingDataset ;
    rdfs:label "Iterative fine-tuning data: DFT-labelled LYC and LYB snapshots (50/50) from each temperature step" ;
    mlips:coversMaterial entity:mat-lycb-bohm2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-bohm2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ft-bohm2026 mlips:samplingStrategy
    entity:sampling-fps-bohm2026 .

entity:sampling-fps-bohm2026 a mlips:SamplingStrategy ;
    rdfs:label "CHGNet_(T-1)-driven NpT/NVT MD of LYC0 and LYB0 at temperature T (1,000,000 steps), furthest-point sampling of 150-300 snapshots per iteration" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chgnet-600k-bohm2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet_600K: CHGNet 0.3.0 fine-tuned iteratively on DFT snapshots up to 600 K (frozen layers, batch size, epochs and learning rate optimised per step)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-ft-bohm2026 ;
    mlips:produces entity:model-chgnet-600k-bohm2026 .

entity:model-chgnet-600k-bohm2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet_600K (LYCB)" .

entity:run-m3gnet-bohm2026 a mlips:MLIPRun ;
    rdfs:label "M3GNet (matgl 0.2.4; pretrained model not named) used for energy ranking" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-m3gnet-bohm2026 .

entity:model-m3gnet-bohm2026 a mlips:TrainedModel ;
    rdfs:label "M3GNet (matgl 0.2.4 default)" .

entity:run-sevennet-bohm2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-MF-ompa (sevenn 0.11.0) as distributed" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-sevennet-bohm2026 .

entity:model-sevennet-bohm2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-MF-ompa" .

# Registry stub for the externally trained model CHGNet-0.3.0 (not trained in this paper).
entity:run-CHGNet-0_3_0 a mlips:MLIPRun ;
    rdfs:label "Training run of CHGNet v0.3.0 pretrained universal MLIP (412.5K parameters, trained on MPtrj)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-CHGNet-0_3_0 .

entity:model-CHGNet-0_3_0 a mlips:TrainedModel ;
    rdfs:label "CHGNet v0.3.0 pretrained universal MLIP (412.5K parameters, trained on MPtrj)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# CHGNet relaxations take about 50 s CPU per structure against about 33 h CPU for DFT; MD with CHGNet costs about 0.8 s per atom per picosecond on a GPU for the 60- and 40-atom supercells; each fine-tuning step takes about 5-10 minutes on a GPU for 150-300 structures (Computational Methods).

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Accuracy is stated only as bounds: pretrained CHGNet energy MAEs below 11 meV/atom at 0 K (Fig. S1) and errors up to 70 meV/atom at T >= 600 K; CHGNet_600K energy, force and stress MAEs below 3.5 meV/atom, 50 meV/A and 85 MPa on an independent 0-800 K test set (Fig. 2c). No exact values are encoded.
# - The intermediate CHGNet_T models (200 and 400 K) and per-iteration data sizes are not encoded separately. Timings are approximate and kept in resources. Volumes, energy differences between phases (Table 3), diffusion coefficients and conductivities are properties.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/bohm2026.yaml) until the schema has terms for them.
