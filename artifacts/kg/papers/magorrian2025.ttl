@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-magorrian2025 a mlips:BenchmarkStudy ;
    rdfs:label "Magorrian, Siddiqui and Hine (2025): MACE potential and continuum model for strong atomic reconstruction in twisted InSe bilayers" ;
    mlips:reportedIn entity:article-magorrian2025 .

entity:article-magorrian2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.9.014004> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Strong atomic reconstruction in twisted bilayers of highly flexible InSe: Machine-learned interatomic potential and continuum model approaches" ;
    schema:author entity:person-Magorrian-magorrian2025 ,
        <https://orcid.org/0009-0009-3974-3788> ,
        <https://orcid.org/0000-0001-5613-3679> .

entity:person-Magorrian-magorrian2025 a schema:Person ;
    schema:name "S. J. Magorrian" ;
