###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-inse-magorrian2025 a mlips:MaterialSystem ;
    rdfs:label "InSe monolayers and parallel/antiparallel (twisted) bilayers" ;
    mlips:chemicalFormula "InSe" ;
    mlips:materialClass "2D material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qe-magorrian2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qe-magorrian2025 mlips:hasDFTSettings entity:calc-settings-qe-magorrian2025 .

entity:calc-settings-qe-magorrian2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-optB88-vdW-magorrian2025 ;
    rdfs:comment "SSSP pseudopotentials (PSlibrary In, GBRV Se), 80 Ry" .

entity:xc-optB88-vdW-magorrian2025 a mlips:XCFunctional ;
    rdfs:label "optB88-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-inse-magorrian2025 a mlips:TrainingDataset ;
    rdfs:label "InSe training set (666 configurations; 90/5/5 train/test/validation)" ;
    mlips:coversMaterial entity:mat-inse-magorrian2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 666 ;
    mlips:hasDFTCalculation entity:calc-qe-magorrian2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-inse-magorrian2025 mlips:samplingStrategy
    entity:sampling-mixed-magorrian2025 .

entity:sampling-mixed-magorrian2025 a mlips:SamplingStrategy ;
    rdfs:label "Strained primitive monolayers (25), final frames of MACE-MP-0 Langevin MD of 6x6 monolayers at 7 temperatures and 9 strains (63), rigid bilayer shifts and separations (572), rigid and relaxed 21.79 and 13.17 degree twisted bilayers" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-magorrian2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-magorrian2025 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-MACE-magorrian2025 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-MACE-magorrian2025 a mlips:LossFunction ;
    rdfs:label "Energy:force:stress weights 1:10:1 for 200 epochs, then 100:10:1 with stochastic weight averaging" .

entity:alg-MACE-magorrian2025 a mls:Algorithm ;
    rdfs:label "AMSGrad Adam" .

entity:impl-MACE-magorrian2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mace-numLayers-magorrian2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-mace-cutoffRadius-magorrian2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-mace-batchSize-magorrian2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-mace-numEpochs-magorrian2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "1200"^^xsd:integer .

entity:setting-mace-learningRate-magorrian2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-magorrian2025 a mlips:MLIPRun ;
    rdfs:label "MACE potential for InSe bilayers" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-inse-magorrian2025 ;
    mlips:hasHyperparameterSetting entity:setting-mace-numLayers-magorrian2025 ,
