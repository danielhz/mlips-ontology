# Canonical Turtle for the protocol-derived encoding of:
#   Nitik Bhatia et al. (2025). Leveraging active learning-enhanced machine-learned interatomic potential for efficient infrared spectra prediction.
#   npj Computational Materials. doi:10.1038/s41524-025-01827-8  arXiv:2506.13486v1
#
# Version read: arxiv-preprint arXiv:2506.13486v1 (sha256 14a7ddd9fbd66b22...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 613 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/bhatia2025.yaml.
#
# Encoding scope: the final MACE MLIP (first member of the 3-model
# committee after 40 active-learning iterations) trained on 16,067
# FHI-aims PBE structures of 24 small organic molecules, with its energy
# and force errors on the 480-structure MLMD test set (Table 1). Harmonic
# frequencies, dipole-model errors and IR spectra are not energy/force
# metrics of the potential.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bhatia2025 a mlips:BenchmarkStudy ;
    rdfs:label "Bhatia, Rinke and Krejčí (2025): PALIRS, active-learning MACE potentials for infrared spectra of small organic molecules" ;
    mlips:reportedIn entity:article-bhatia2025 .

entity:article-bhatia2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01827-8> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Leveraging active learning-enhanced machine-learned interatomic potential for efficient infrared spectra prediction" ;
    schema:author entity:person-Bhatia-bhatia2025 ,
        entity:person-Rinke-bhatia2025 ,
        entity:person-Krejci-bhatia2025 .

entity:person-Bhatia-bhatia2025 a schema:Person ;
    schema:name "Nitik Bhatia" ;
    schema:givenName "Nitik" ;
    schema:familyName "Bhatia" .

entity:person-Rinke-bhatia2025 a schema:Person ;
    schema:name "Patrick Rinke" ;
    schema:givenName "Patrick" ;
    schema:familyName "Rinke" .

entity:person-Krejci-bhatia2025 a schema:Person ;
    schema:name "Ondřej Krejčí" ;
    schema:givenName "Ondřej" ;
    schema:familyName "Krejčí" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-organics-bhatia2025 a mlips:MaterialSystem ;
    rdfs:label "24 small organic molecules with H, C, N, O and up to two carbon atoms (from QM9)" ;
    mlips:materialClass "small organic molecules" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-ts-bhatia2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-ts-bhatia2025 mlips:hasDFTSettings entity:calc-settings-pbe-ts-bhatia2025 .

entity:calc-settings-pbe-ts-bhatia2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    mlips:basisSet "tier-1, light grids" ;
    rdfs:comment "ZORA scalar relativity; Hirshfeld (Tkatchenko-Scheffler) van der Waals correction." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-final-bhatia2025 a mlips:TrainingDataset ;
    rdfs:label "Final PALIRS training data (2085 normal-mode structures plus active-learning additions; 80:20 split)" ;
    mlips:coversMaterial entity:mat-organics-bhatia2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 16067 ;
    mlips:hasDFTCalculation entity:calc-pbe-ts-bhatia2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-final-bhatia2025 mlips:samplingStrategy
    entity:sampling-nms-bhatia2025 ,
    entity:sampling-al-bhatia2025 .

entity:sampling-nms-bhatia2025 a mlips:SamplingStrategy ;
    rdfs:label "Normal-mode sampling (first 10 geometries per mode) of DFT-optimised QM9 geometries" .

entity:sampling-al-bhatia2025 a mlips:SamplingStrategy ;
    rdfs:label "Committee active learning: 15 most uncertain structures per molecule and iteration from 5 ps MLMD at 300, 500 and 700 K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-bhatia2025 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:bodyOrder ;
    mlips:hasImplementation entity:impl-MACE-bhatia2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-MACE-bhatia2025 a mls:Algorithm ;
    rdfs:label "L=1 equivariant messages; 3-model committee differing in random seed" .

entity:impl-MACE-bhatia2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mace-numFeatures-bhatia2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-mace-cutoffRadius-bhatia2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3"^^xsd:double .

entity:setting-mace-numLayers-bhatia2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-mace-bodyOrder-bhatia2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-bhatia2025 a mlips:MLIPRun ;
    rdfs:label "Final MACE MLIP (iteration 40, first committee member)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-final-bhatia2025 ;
    mlips:hasHyperparameterSetting entity:setting-mace-numFeatures-bhatia2025 ,
        entity:setting-mace-cutoffRadius-bhatia2025 ,
        entity:setting-mace-numLayers-bhatia2025 ,
        entity:setting-mace-bodyOrder-bhatia2025 ;
    mlips:trainingHardware "NVIDIA V100 GPUs" ;
    mlips:produces entity:model-mace-bhatia2025 .

entity:model-mace-bhatia2025 a mlips:TrainedModel ;
    rdfs:label "PALIRS MACE MLIP" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-bhatia2025 mlips:hasResult
    entity:result-mace-test-bhatia2025 .

entity:result-mace-test-bhatia2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-bhatia2025 ;
    mlips:targetMaterial entity:mat-organics-bhatia2025 ;
    mlips:hasAccuracyMetric entity:metric-mace-test-1-bhatia2025 ,
        entity:metric-mace-test-2-bhatia2025 ,
        entity:metric-mace-test-3-bhatia2025 ,
        entity:metric-mace-test-4-bhatia2025 .

entity:metric-mace-test-1-bhatia2025 a mlips:AccuracyMetric ;
    rdfs:label "test energy MAE on organics: PALIRS MACE" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "2.64"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV .

entity:metric-mace-test-2-bhatia2025 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on organics: PALIRS MACE" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.61"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV .

entity:metric-mace-test-3-bhatia2025 a mlips:AccuracyMetric ;
    rdfs:label "test force MAE on organics: PALIRS MACE" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "3.96"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-mace-test-4-bhatia2025 a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on organics: PALIRS MACE" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "5.69"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

