@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-shayestehpour2023 a mlips:BenchmarkStudy ;
    rdfs:label "Shayestehpour and Zahn (2023): MD of deep eutectic solvents with first-principles accuracy using MLIPs (reline)" ;
    mlips:reportedIn entity:article-shayestehpour2023 .

entity:article-shayestehpour2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.3c00944> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Efficient Molecular Dynamics Simulations of Deep Eutectic Solvents with First-Principles Accuracy Using Machine Learning Interatomic Potentials" ;
    schema:author <https://orcid.org/0000-0002-2088-8508> ,
        <https://orcid.org/0000-0002-4858-0687> .

<https://orcid.org/0000-0002-2088-8508> a schema:Person ;
    schema:name "Omid Shayestehpour" ;
    schema:givenName "Omid" ;
    schema:familyName "Shayestehpour" ;
    schema:identifier <https://orcid.org/0000-0002-2088-8508> .

<https://orcid.org/0000-0002-4858-0687> a schema:Person ;
    schema:name "Stefan Zahn" ;
