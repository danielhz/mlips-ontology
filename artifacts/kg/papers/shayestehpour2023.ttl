    schema:identifier <https://orcid.org/0000-0002-4858-0687> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-reline-shayestehpour2023 a mlips:MaterialSystem ;
    rdfs:label "Reline deep eutectic solvent, choline chloride : urea 1:2 (8 ChCl + 16 urea, 304 atoms)" ;
    mlips:chemicalFormula "ChCl:urea 1:2" ;
    mlips:materialClass "Deep eutectic solvent" .

entity:mat-reline-large-shayestehpour2023 a mlips:MaterialSystem ;
    rdfs:label "Reline, larger system of 18 ChCl + 36 urea (684 atoms)" ;
    mlips:chemicalFormula "ChCl:urea 1:2" ;
    mlips:materialClass "Deep eutectic solvent" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-shayestehpour2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-shayestehpour2023 mlips:hasDFTSettings entity:calc-settings-dft-shayestehpour2023 .

entity:calc-settings-dft-shayestehpour2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-shayestehpour2023 ;
    mlips:xcFunctional entity:xc-BLYP-D3-shayestehpour2023 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:dftBasisSet entity:basis-MOLOPT-TZVP-shayestehpour2023 ;
    rdfs:comment "Goedecker-Teter-Hutter pseudopotentials; periodic boundary conditions." .

entity:lib-CP2K-shayestehpour2023 a mlips:Library ;
    rdfs:label "CP2K" ;
    rdfs:comment "Gaussian and plane-wave (GPW) method, plane-wave cutoff 700 Ry." ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-BLYP-D3-shayestehpour2023 a mlips:XCFunctional ;
    rdfs:label "BLYP-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-MOLOPT-TZVP-shayestehpour2023 a mlips:DftBasisSet ;
    rdfs:label "MOLOPT-TZVP" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-reline-shayestehpour2023 a mlips:TrainingDataset ;
    rdfs:label "Reline training data: 18,000 primary configurations plus about 10,000 from active learning" ;
    mlips:coversMaterial entity:mat-reline-shayestehpour2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-shayestehpour2023 ;
    rdfs:comment "The final size is given only approximately (18,000 + about 10,000), so no mlips:numConfigurations is stated." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-reline-shayestehpour2023 mlips:samplingStrategy
    entity:sampling-dftb-shayestehpour2023 ,
    entity:sampling-dpgen-shayestehpour2023 .

entity:sampling-dftb-shayestehpour2023 a mlips:SamplingStrategy ;
    rdfs:label "Configurations sampled from DFTB molecular-dynamics trajectories of 8 ChCl + 16 urea and labelled with the target DFT (19,000 configurations; 18,000 training, 1,000 validation)" .

entity:sampling-dpgen-shayestehpour2023 a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN active learning: 30 Deep Potential MD runs per iteration (LAMMPS, 360-440 K, 10 to 200 ps), candidates with ensemble force deviation between 0.15 and 0.30 eV/A over four models, up to 900 labelled per iteration, until fewer than 100 candidates remain (about 10,000 configurations added)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-shayestehpour2023 ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-shayestehpour2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-rcut-smooth-shayestehpour2023 ,
        entity:hp-embedding-net-shayestehpour2023 ,
        entity:hp-axis-neurons-shayestehpour2023 ,
        entity:hp-fitting-net-shayestehpour2023 ,
        mlips:batchSize ,
        mlips:learningRate ,
        entity:hp-lr-decay-steps-shayestehpour2023 ;
    mlips:hasImplementation entity:impl-DeePMD-shayestehpour2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-DeePMD-shayestehpour2023 a mlips:LossFunction ;
    rdfs:label "DeePMD loss with energy prefactor from 0.02 to 1 and force prefactor from 1000 to 1" .

entity:alg-DeePMD-shayestehpour2023 a mls:Algorithm ;
    rdfs:label "Adam with learning rate decaying exponentially from 1e-3 to 5e-8; ensemble of four models, the one with the lowest test RMSE used for production" .

entity:impl-DeePMD-shayestehpour2023 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:hp-rcut-smooth-shayestehpour2023 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential smoothing cutoff r_s (Angstrom)" ;
    mlips:hyperparameterName "rcut_smth" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-embedding-net-shayestehpour2023 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential embedding network sizes" ;
    mlips:hyperparameterName "embedding_net" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-axis-neurons-shayestehpour2023 a mlips:Hyperparameter ;
    rdfs:label "Number of axis neurons M2" ;
    mlips:hyperparameterName "axis_neuron" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-fitting-net-shayestehpour2023 a mlips:Hyperparameter ;
