    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-han2025distmlip .

entity:model-mace-han2025distmlip a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b-small" .

entity:run-tensornet-han2025distmlip a mlips:MLIPRun ;
    rdfs:label "TensorNet-MatPES-0.8M (as distributed)" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:produces entity:model-tensornet-han2025distmlip .

entity:model-tensornet-han2025distmlip a mlips:TrainedModel ;
    rdfs:label "TensorNet-MatPES-0.8M" .

entity:run-chgnet-han2025distmlip a mlips:MLIPRun ;
    rdfs:label "CHGNet-MatPES-2.7M (as distributed)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-han2025distmlip .

entity:model-chgnet-han2025distmlip a mlips:TrainedModel ;
    rdfs:label "CHGNet-MatPES-2.7M" .

entity:run-esen-han2025distmlip a mlips:MLIPRun ;
    rdfs:label "eSEN-3.2M (as distributed)" ;
    mlips:appliesMethod entity:eSEN ;
    mlips:produces entity:model-esen-han2025distmlip .

entity:model-esen-han2025distmlip a mlips:TrainedModel ;
