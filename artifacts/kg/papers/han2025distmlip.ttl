###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-han2025distmlip ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-han2025distmlip a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" ;
    mlips:hasImplementation entity:impl-TensorNet-han2025distmlip ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-TensorNet-han2025distmlip a mlips:Implementation ;
    mlips:implementedIn entity:lib-matgl-han2025distmlip .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasImplementation entity:impl-CHGNet-han2025distmlip ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-CHGNet-han2025distmlip a mlips:Implementation ;
    mlips:implementedIn mlips:CHGNet .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:hasImplementation entity:impl-eSEN-han2025distmlip ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-eSEN-han2025distmlip a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-han2025distmlip .

entity:lib-matgl-han2025distmlip a mlips:Library ;
    rdfs:label "matgl" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-fairchem-han2025distmlip a mlips:Library ;
    rdfs:label "fairchem" ;
    mlips:candidateForVocabulary mlips:Library .

