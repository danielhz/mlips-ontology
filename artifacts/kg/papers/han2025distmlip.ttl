# Canonical Turtle for the protocol-derived encoding of:
#   Kevin Han et al. (2025). DistMLIP: A Distributed Inference Platform for Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2506.02023  arXiv:2506.02023v2
#
# Version read: arxiv-preprint arXiv:2506.02023v2 (sha256 c295c0ce23d3848d...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 542 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/han2025distmlip.yaml.
#
# Encoding scope: the four public pretrained checkpoints run through
# DistMLIP (MACE-MP-0b-small 3.8M, TensorNet-MatPES 0.8M, CHGNet-MatPES
# 2.7M, eSEN 3.2M) as paper-local runs, with the MD step times of
# Table 1 (1 and 8 GPUs, maximum-capacity cells of Li3PO4, water, GaN, a
# MOF and the 2w49 biomolecule). No accuracy metrics are reported;
# scaling curves are figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-han2025distmlip a mlips:BenchmarkStudy ;
    rdfs:label "Han et al. (2025): DistMLIP, graph-partitioned multi-GPU inference for MLIPs, benchmarked with pretrained MACE, TensorNet, CHGNet and eSEN" ;
    mlips:reportedIn entity:article-han2025distmlip .

entity:article-han2025distmlip a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2506.02023> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "DistMLIP: A Distributed Inference Platform for Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Han-han2025distmlip ,
        entity:person-Deng-han2025distmlip ,
        entity:person-Farimani-han2025distmlip ,
        entity:person-Ceder-han2025distmlip .

entity:person-Han-han2025distmlip a schema:Person ;
    schema:name "Kevin Han" ;
    schema:givenName "Kevin" ;
    schema:familyName "Han" .

entity:person-Deng-han2025distmlip a schema:Person ;
    schema:name "Bowen Deng" ;
    schema:givenName "Bowen" ;
    schema:familyName "Deng" .

entity:person-Farimani-han2025distmlip a schema:Person ;
    schema:name "Amir Barati Farimani" ;
    schema:givenName "Amir Barati" ;
    schema:familyName "Farimani" .

entity:person-Ceder-han2025distmlip a schema:Person ;
    schema:name "Gerbrand Ceder" ;
    schema:givenName "Gerbrand" ;
    schema:familyName "Ceder" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-li3po4-han2025distmlip a mlips:MaterialSystem ;
    rdfs:label "Li3PO4 battery-electrolyte supercells" ;
    mlips:chemicalFormula "Li3PO4" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-h2o-han2025distmlip a mlips:MaterialSystem ;
    rdfs:label "Water supercells" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

entity:mat-gan-han2025distmlip a mlips:MaterialSystem ;
    rdfs:label "GaN semiconductor supercells" ;
    mlips:chemicalFormula "GaN" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-mof-han2025distmlip a mlips:MaterialSystem ;
    rdfs:label "Metal-organic framework supercells" ;
    mlips:materialClass "Metal-organic frameworks" .

entity:mat-bio-han2025distmlip a mlips:MaterialSystem ;
    rdfs:label "Biomolecule 2w49 (69.3k atoms)" ;
    mlips:materialClass "Organic and biochemical molecules (C, N, O, H)" .

