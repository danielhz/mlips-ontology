###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mos2-bilgili2026 a mlips:MaterialSystem ;
    rdfs:label "Mo-S system: MoS2 polymorphs (1H, 2H, 3R), slabs, monolayers, nanoribbons and non-stoichiometric Mo-S structures" ;
    mlips:chemicalFormula "MoS2" ;
    mlips:materialClass "layered transition-metal dichalcogenide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-bilgili2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-bilgili2026 mlips:hasDFTSettings entity:calc-settings-pbe-d3-bilgili2026 .

entity:calc-settings-pbe-d3-bilgili2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-D3-bilgili2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, density 40 1/A for bulk; 6x6x1 for slabs and monolayers; 12x1x1 for nanoribbons" ;
    rdfs:comment "Gaussian smearing 0.05 eV; 20 A vacuum with dipole corrections." .

entity:xc-PBE-D3-bilgili2026 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mos2-db-bilgili2026 a mlips:TrainingDataset ;
    rdfs:label "UF3 Mo-S training/test data set (28,579 structures after filtering; 25,792 train, 2,787 test)" ;
    mlips:coversMaterial entity:mat-mos2-bilgili2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 28579 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-bilgili2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mos2-db-bilgili2026 mlips:samplingStrategy
    entity:sampling-gasp-bilgili2026 ,
    entity:sampling-mixed-bilgili2026 .

entity:sampling-gasp-bilgili2026 a mlips:SamplingStrategy ;
    rdfs:label "GASP genetic-algorithm structure searches (stoichiometric and across Mo-S composition space) with relaxation trajectories" .

entity:sampling-mixed-bilgili2026 a mlips:SamplingStrategy ;
    rdfs:label "Materials Project polymorphs, pressure relaxations, VASPKIT strains, Phonopy distortions, AIMD at 600/1500/3000 K, slabs, surfaces, monolayers and nanoribbons; filtered by force, distance and energy windows and FPS in energy per atom" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:UF3 a mlips:MLIPMethod ;
    rdfs:label "UF3 (ultra-fast force fields: two- and three-body cubic B-spline potentials fitted by regularised linear regression)" ;
    mlips:hasTrainingAlgorithm entity:alg-UF3-bilgili2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:bodyOrder ;
    mlips:hasImplementation entity:impl-UF3-bilgili2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:alg-UF3-bilgili2026 a mls:Algorithm ;
    rdfs:label "Cubic B-spline 2-body (0.001-9 A, 54 knots) and 3-body (short legs 0.5-3.6 A with 10 knots, long leg 7.2 A with 20 knots) terms; Optuna TPE search over more than 7,000 candidate fits with property-based validation" .

entity:impl-UF3-bilgili2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-UF3Tools-bilgili2026 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" .

entity:lib-UF3Tools-bilgili2026 a mlips:Library ;
    rdfs:label "UF3Tools" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-uf3-cutoffRadius-bilgili2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "9"^^xsd:integer .

entity:setting-uf3-bodyOrder-bilgili2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-uf3-bilgili2026 a mlips:MLIPRun ;
    rdfs:label "Selected UF3 Mo-S potential (UF3-MoS2)" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-mos2-db-bilgili2026 ;
    mlips:hasHyperparameterSetting entity:setting-uf3-cutoffRadius-bilgili2026 ,
        entity:setting-uf3-bodyOrder-bilgili2026 ;
    mlips:produces entity:model-uf3-bilgili2026 .

entity:model-uf3-bilgili2026 a mlips:TrainedModel ;
    rdfs:label "UF3-MoS2" .

entity:run-mp0-bilgili2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0 as distributed (size not stated)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mp0-bilgili2026 .

entity:model-mp0-bilgili2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0" .

entity:run-chgnet-bilgili2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet as distributed (version not stated)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-bilgili2026 .

entity:model-chgnet-bilgili2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet pretrained" .

