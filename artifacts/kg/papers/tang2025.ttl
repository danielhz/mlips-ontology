# Canonical Turtle for the protocol-derived encoding of:
#   Ling Tang et al. (2025). Developing a neural network machine learning interatomic potential for molecular dynamics simulations of La–Si–P systems.
#   The Journal of Chemical Physics. doi:10.1063/5.0284672  arXiv:2506.08339v1
#
# Version read: arxiv-preprint arXiv:2506.08339v1 (sha256 8ca7e0e6c13b6733...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 679 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/tang2025.yaml.
#
# Encoding scope: the DeePMD potential for the La-Si-P system trained
# iteratively (usage-probability reweighting and data addition) on about
# 71,800 distorted crystals and 130,000 liquid snapshots. Training errors
# are stated only approximately, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-tang2025 a mlips:BenchmarkStudy ;
    rdfs:label "Tang et al. (2025): a neural-network interatomic potential for MD of La-Si-P systems" ;
    mlips:reportedIn entity:article-tang2025 .

entity:article-tang2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0284672> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Developing a neural network machine learning interatomic potential for molecular dynamics simulations of La–Si–P systems" ;
    schema:author <https://orcid.org/0000-0002-9241-4328> ,
        <https://orcid.org/0000-0001-7669-6305> ,
        <https://orcid.org/0000-0002-9693-8225> ,
        entity:person-Soto-tang2025 ,
        <https://orcid.org/0000-0003-1152-1912> ,
        <https://orcid.org/0000-0002-0269-4785> .

<https://orcid.org/0000-0002-9241-4328> a schema:Person ;
    schema:name "Ling Tang" ;
    schema:givenName "Ling" ;
    schema:familyName "Tang" ;
    schema:identifier <https://orcid.org/0000-0002-9241-4328> .

<https://orcid.org/0000-0001-7669-6305> a schema:Person ;
    schema:name "Weiyi Xia" ;
    schema:givenName "Weiyi" ;
    schema:familyName "Xia" ;
    schema:identifier <https://orcid.org/0000-0001-7669-6305> .

<https://orcid.org/0000-0002-9693-8225> a schema:Person ;
    schema:name "Gayatri Viswanathan" ;
    schema:givenName "Gayatri" ;
    schema:familyName "Viswanathan" ;
    schema:identifier <https://orcid.org/0000-0002-9693-8225> .

entity:person-Soto-tang2025 a schema:Person ;
    schema:name "Ernesto Soto" ;
    schema:givenName "Ernesto" ;
    schema:familyName "Soto" .

<https://orcid.org/0000-0003-1152-1912> a schema:Person ;
    schema:name "Kirill Kovnir" ;
    schema:givenName "Kirill" ;
    schema:familyName "Kovnir" ;
    schema:identifier <https://orcid.org/0000-0003-1152-1912> .

<https://orcid.org/0000-0002-0269-4785> a schema:Person ;
    schema:name "Cai-Zhuang Wang" ;
    schema:givenName "Cai-Zhuang" ;
    schema:familyName "Wang" ;
    schema:identifier <https://orcid.org/0000-0002-0269-4785> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lasip-tang2025 a mlips:MaterialSystem ;
    rdfs:label "La-Si-P system: elemental, binary and ternary crystals (including La2SiP, La5SiP3, La2SiP3, La2SiP4) and liquids" ;
    mlips:materialClass "rare-earth silicide phosphides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-tang2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-tang2025 mlips:hasDFTSettings entity:calc-settings-pbe-tang2025 .

entity:calc-settings-pbe-tang2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "k-point grid 2pi x 0.02 1/A (single points); Gamma for AIMD" ;
    rdfs:comment "Non-spin-polarised; 256-atom liquid AIMD with 3 fs steps." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-lasip-tang2025 a mlips:TrainingDataset ;
    rdfs:label "La-Si-P training data (about 71,800 distorted crystal and 130,000 liquid structures)" ;
    mlips:coversMaterial entity:mat-lasip-tang2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-tang2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-lasip-tang2025 mlips:samplingStrategy
    entity:sampling-crystals-liquids-tang2025 .

entity:sampling-crystals-liquids-tang2025 a mlips:SamplingStrategy ;
    rdfs:label "Volume-scaled and randomly displaced (0.2 A) crystals of Materials Project and ML-predicted phases, plus AIMD liquid snapshots across compositions, augmented iteratively" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-tang2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-DeePMD-tang2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-DeePMD-tang2025 a mls:Algorithm ;
    rdfs:label "Fitting network of four hidden layers with 120 tanh nodes; phase-wise usage probabilities raised for poorly fitted phases" .

entity:impl-DeePMD-tang2025 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-cutoffRadius-tang2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:double .

entity:setting-dp-numLayers-tang2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-tang2025 a mlips:MLIPRun ;
    rdfs:label "Final ANN-ML (DeePMD) potential for La-Si-P" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-lasip-tang2025 ;
    mlips:hasHyperparameterSetting entity:setting-dp-cutoffRadius-tang2025 ,
        entity:setting-dp-numLayers-tang2025 ;
    mlips:produces entity:model-dp-tang2025 .

entity:model-dp-tang2025 a mlips:TrainedModel ;
    rdfs:label "DP La-Si-P (Tang 2025)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

