###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cross-domain-kim2026 a mlips:MaterialSystem ;
    rdfs:label "Cross-domain chemical space of 7net-Omni: inorganic crystals, metal and oxide catalyst surfaces with adsorbates, metal-organic frameworks and neutral molecules" ;
    mlips:materialClass "Universal: inorganic crystals, catalysts, MOFs, molecules (charged structures excluded)" .

entity:mat-inorganic-kim2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals of MPtrj, sAlex and OMat24" ;
    mlips:materialClass "Universal inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-multi-xc-kim2026 a mlips:DFTCalculation .

entity:calc-dbs-dft-kim2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-multi-xc-kim2026 mlips:hasDFTSettings entity:calc-settings-multi-xc-kim2026 .

entity:calc-settings-multi-xc-kim2026 a mlips:DFTSettings ;
    rdfs:comment "One task (channel) per computational protocol: PBE(+U) for MPtrj, Alexandria, OMat24, OC22 and the domain-bridging set; PBE for MatPES; RPBE for OC20; PBE-D3 for ODAC23; omegaB97M-V for OMol25; omegaB97M for SPICE; PBE0 for QCML; PBEsol for MAD; r2SCAN for MP-r2SCAN, MatPES-r2SCAN and MP-ALOE. The codes and settings are those of the source databases." .

entity:calc-dbs-dft-kim2026 mlips:hasDFTSettings entity:calc-settings-dbs-dft-kim2026 .

entity:calc-settings-dbs-dft-kim2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Domain-bridging set (DBS): about 125,000 structures (0.1%) selected from MatPES, OC20, OC22, ODAC23, OMol25 and QCML and recomputed with the pymatgen MPRelaxSet for consistency with MPtrj and Alexandria; no Hubbard U for structures from OC20, ODAC23, OMol25 and QCML." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-omni-kim2026 a mlips:TrainingDataset ;
    rdfs:label "7net-Omni training set (16 databases, 242 million structures)" ;
    mlips:coversMaterial entity:mat-cross-domain-kim2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 242000000 ;
    mlips:hasDFTCalculation entity:calc-multi-xc-kim2026 ,
        entity:calc-dbs-dft-kim2026 ;
    rdfs:comment "Structures in thousands (Table 1): MPtrj 1,580; Alexandria 12,069; DBS 121; OMat24 101,901; MatPES 412; OC20 30,757; OC22 8,210; ODAC23 4,082; OMol25 low-spin 60,852 and high-spin 1,390; SPICE 1,738; QCML 18,301; MAD 86; MP-r2SCAN 50; MatPES-r2SCAN 368; MP-ALOE 864. numConfigurations is the stated total of 242 million. Stresses are not available for all databases." .

entity:ds-ompa-kim2026 a mlips:TrainingDataset ;
    rdfs:label "MPtrj + sAlex + OMat24 (training set of the intermediate model 7net-ompa)" ;
    mlips:coversMaterial entity:mat-inorganic-kim2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-multi-xc-kim2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-omni-kim2026 mlips:samplingStrategy
    entity:sampling-database-subsampling-kim2026 ,
    entity:sampling-domain-bridging-kim2026 ,
    entity:sampling-oversampling-kim2026 .

entity:ds-ompa-kim2026 mlips:samplingStrategy
    entity:sampling-database-subsampling-kim2026 .

entity:sampling-database-subsampling-kim2026 a mlips:SamplingStrategy ;
    rdfs:label "Full use or subsampling of published databases" ;
    rdfs:comment "MPtrj, OMat24, MatPES, OC22, MAD, MatPES-r2SCAN and MP-ALOE in full; Alexandria, OC20, ODAC23, OMol25, SPICE, QCML and MP-r2SCAN subsampled (e.g. relaxation snapshots more than 10 meV/atom apart, every fifth MD step, 20% of rattled structures); charged molecular structures excluded." .

entity:sampling-domain-bridging-kim2026 a mlips:SamplingStrategy ;
    rdfs:label "Domain-bridging set sampled by model error" ;
    rdfs:comment "Structures far from inorganic systems or from databases whose settings differ from PBE are sampled with higher weight, quantified by the force error of 7net-ompa, and recomputed at the PBE(+U) level." .

entity:sampling-oversampling-kim2026 a mlips:SamplingStrategy ;
    rdfs:label "Oversampling to balance material domains" ;
    rdfs:comment "Per-database oversampling factors from 1 to 100 (Table 1) so that crystals, catalytic surfaces and molecules have comparable effective weight." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-kim2026 ;
    mlips:hasHyperparameter mlips:numAngularBasis ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-kim2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-NequIP-kim2026 a mls:Algorithm ;
    rdfs:label "Adam with learning-rate warm-up to 0.002 and cosine annealing to zero within one epoch; curriculum learning from inorganic bulk data (7net-ompa) through molecular data to all databases" .

entity:impl-NequIP-kim2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-MF-kim2026 .

entity:lib-SevenNet-MF-kim2026 a mlips:Library ;
    rdfs:label "SevenNet-MF" ;
    rdfs:comment "Multi-fidelity / multi-task SevenNet (NequIP architecture) with one task channel per computational protocol; node features 128 (l = 0), 64 (l = 1) and 32 (l > 1) with even and odd parity." ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-7net-ompa-numAngularBasis-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-7net-ompa-numLayers-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-7net-ompa-numFeatures-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-7net-omni-numAngularBasis-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-7net-omni-numLayers-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-7net-omni-numFeatures-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-7net-omni-learningRate-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.002"^^xsd:double .

entity:setting-7net-omni-numEpochs-kim2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "1"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-7net-ompa-kim2026 a mlips:MLIPRun ;
    rdfs:label "7net-ompa: SevenNet-MF trained on MPtrj, sAlex and OMat24 (intermediate model)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-ompa-kim2026 ;
    mlips:hasHyperparameterSetting entity:setting-7net-ompa-numAngularBasis-kim2026 ,
        entity:setting-7net-ompa-numLayers-kim2026 ,
        entity:setting-7net-ompa-numFeatures-kim2026 ;
    mlips:produces entity:model-7net-ompa-kim2026 .

entity:model-7net-ompa-kim2026 a mlips:TrainedModel ;
    rdfs:label "7net-ompa (SevenNet-MF-ompa)" .

entity:run-7net-omni-kim2026 a mlips:MLIPRun ;
    rdfs:label "7net-Omni: final training stage on all sixteen databases (one epoch, starting from the curriculum of 7net-ompa and OMol25)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-omni-kim2026 ;
    mlips:hasHyperparameterSetting entity:setting-7net-omni-numAngularBasis-kim2026 ,
        entity:setting-7net-omni-numLayers-kim2026 ,
        entity:setting-7net-omni-numFeatures-kim2026 ,
        entity:setting-7net-omni-learningRate-kim2026 ,
        entity:setting-7net-omni-numEpochs-kim2026 ;
    mlips:produces entity:model-7net-omni-kim2026 .

entity:model-7net-omni-kim2026 a mlips:TrainedModel ;
    rdfs:label "7net-Omni" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No AccuracyMetric is encoded: the paper evaluates 7net-Omni and other universal models on many benchmarks (Matbench Discovery, adsorption and reaction energies, molecular benchmarks, r2SCAN-fidelity tasks in Table 2, MD speed) whose numbers are in tables and figures that were not read in detail and mostly have no MetricProperty.
# - 7net-Omni is trained in three curriculum stages; the run encodes the last stage and names the earlier ones in its label. 7net-ompa is the 'SevenNet-MF-ompa' that lysogorskiy2026 compares against; it is paper-local here until a file evaluates it by IRI.
# - As in kim2024, SevenNet-MF is encoded as an implementation of the registry method entity:NequIP. The task channels (one per exchange-correlation protocol) mean one model reproduces several reference levels; schema 0.1.2 attaches reference calculations to the data set only, so the multi-protocol reference is one generic node with the protocols in its comment.
# - The manifest classes this paper as 'Application/model instance'; it presents a new pretrained universal model.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
