    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-cp2k-wen2025emff .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-emff-wen2025emff mlips:samplingStrategy
    entity:sampling-base-wen2025emff ,
    entity:sampling-dpgen-wen2025emff .

entity:sampling-base-wen2025emff a mlips:SamplingStrategy ;
    rdfs:label "AIMD of RDX, HMX and CL-20 at 300-4000 K (5,000 snapshots each) and 12,000 earlier DP-GEN configurations, cell scaling 0.92-1.08" .

entity:sampling-dpgen-wen2025emff a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN concurrent learning over 45 iterations adding one HEM at a time (force-deviation bounds 0.05-0.15 eV/A), 6,900 configurations" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-wen2025emff ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-wen2025emff ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-DeePMD-wen2025emff ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-DeePMD-wen2025emff a mlips:LossFunction ;
    rdfs:label "Energy and force MSE, p_e = 0.02, p_f = 1000" .

entity:alg-DeePMD-wen2025emff a mls:Algorithm ;
    rdfs:label "Embedding net (25, 50, 100), fitting net (240, 240, 240), 4.0e6 steps with exponential decay (0.98 every 4000 steps)" .

entity:impl-DeePMD-wen2025emff a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-emff-cutoffRadius-wen2025emff a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-emff-learningRate-wen2025emff a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-emff-wen2025emff a mlips:MLIPRun ;
    rdfs:label "EMFF-2025" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-emff-wen2025emff ;
    mlips:hasHyperparameterSetting entity:setting-emff-cutoffRadius-wen2025emff ,
