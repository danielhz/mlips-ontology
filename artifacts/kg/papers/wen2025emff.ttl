###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-emff-wen2025emff a mlips:TrainingDataset ;
    rdfs:label "EMFF-2025 training data (base RDX/HMX/CL-20 data plus 6,900 DP-GEN configurations for 20 HEMs)" ;
    mlips:coversMaterial entity:mat-hems-wen2025emff ;
    mlips:coversProperty mlips:Energy ,
