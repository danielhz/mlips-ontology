# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-mh1-inizan2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MH-1 as distributed (r2SCAN MatPES head)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mh1-inizan2026 .

entity:model-mace-mh1-inizan2026 a mlips:TrainedModel ;
    rdfs:label "mace-mh-1" .

entity:run-umof-mh-inizan2026 a mlips:MLIPRun ;
    rdfs:label "uMOF-MH: MACE-MH-1 r2SCAN head fine-tuned on uMOF (r2SCAN-D4)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-umof-inizan2026 ;
    mlips:produces entity:model-umof-mh-inizan2026 .

entity:model-umof-mh-inizan2026 a mlips:TrainedModel ;
    rdfs:label "uMOF-MH" .

entity:run-mace-polar-inizan2026 a mlips:MLIPRun ;
    rdfs:label "MACE-POLAR-1-M as distributed (OMol, wB97M-V)" ;
    mlips:appliesMethod entity:MACE-POLAR ;
    mlips:produces entity:model-mace-polar-inizan2026 .

entity:model-mace-polar-inizan2026 a mlips:TrainedModel ;
    rdfs:label "MACE-POLAR-1-M" .

entity:run-umof-polar-inizan2026 a mlips:MLIPRun ;
    rdfs:label "uMOF-POLAR: MACE-POLAR-1-M fine-tuned on uMOF (r2SCAN-D4)" ;
    mlips:appliesMethod entity:MACE-POLAR ;
    mlips:runsOn entity:ds-umof-inizan2026 ;
    mlips:produces entity:model-umof-polar-inizan2026 .

entity:model-umof-polar-inizan2026 a mlips:TrainedModel ;
    rdfs:label "uMOF-POLAR" .

entity:run-mof0-inizan2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-MOF0 v2 as distributed (PBE+D3(BJ) MOF fine-tune of MACE-MP-0b)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mof0-inizan2026 .

entity:model-mof0-inizan2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-MOF0-v2" .

entity:run-abl-with-inizan2026 a mlips:MLIPRun ;
    rdfs:label "MD ablation: MACE-MH-1 fine-tune with the Cu-MOF MD subset" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-umof-inizan2026 ;
    mlips:produces entity:model-abl-with-inizan2026 .

entity:model-abl-with-inizan2026 a mlips:TrainedModel ;
    rdfs:label "uMOF-MH ablation, with Cu-MOF MD" .

entity:run-abl-without-inizan2026 a mlips:MLIPRun ;
    rdfs:label "MD ablation: identical MACE-MH-1 fine-tune without the Cu-MOF MD subset" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-umof-nocu-inizan2026 ;
    mlips:produces entity:model-abl-without-inizan2026 .

entity:model-abl-without-inizan2026 a mlips:TrainedModel ;
    rdfs:label "uMOF-MH ablation, without Cu-MOF MD" .

