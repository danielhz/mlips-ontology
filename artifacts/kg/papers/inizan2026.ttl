# Canonical Turtle for the protocol-derived encoding of:
#   Théo Jaffrelot Inizan et al. (2026). uMOF: A Universal Database, Benchmark, and Machine Learning Interatomic Potentials for Metal-Organic Frameworks.
#   arXiv (Cornell University). doi:10.48550/arxiv.2608.28100  arXiv:2608.28100v2
#
# Version read: arxiv-preprint arXiv:2608.28100v2 (sha256 0868d94d469f3a07...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 354 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/inizan2026.yaml.
#
# Encoding scope: the uMOF r2SCAN-D4 data set (h5_mof, 85,524
# configurations of 19,950 MOFs, 79 elements; 68,394 / 8,470 / 8,660
# train / validation / test frames), the two fine-tuned models uMOF-MH
# (from the r2SCAN head of MACE-MH-1) and uMOF-POLAR (from
# MACE-POLAR-1-M) with their held-out validation RMSEs (Table 3), the
# Cu-MOF MD ablation (Tables 4 and 5), and the foundation baselines
# MACE-MH-1, MACE-POLAR-1-M and MACE-MP-MOF0-v2. The literature-mined
# experimental benchmark (3,986 property records) and the Tier-1 to
# Tier-3 property errors are properties, not energy/force errors.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-inizan2026 a mlips:BenchmarkStudy ;
    rdfs:label "Inizan et al. (2026): uMOF, an r2SCAN-D4 data set, experimental benchmark and fine-tuned MACE potentials for metal-organic frameworks" ;
    mlips:reportedIn entity:article-inizan2026 .

entity:article-inizan2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2608.28100> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "uMOF: A Universal Database, Benchmark, and Machine Learning Interatomic Potentials for Metal-Organic Frameworks" ;
    schema:author entity:person-Inizan-inizan2026 ,
        entity:person-Kamath-inizan2026 ,
        entity:person-Elena-inizan2026 ,
        entity:person-Persson-inizan2026 .

entity:person-Inizan-inizan2026 a schema:Person ;
    schema:name "Théo Jaffrelot Inizan" ;
    schema:givenName "Théo Jaffrelot" ;
    schema:familyName "Inizan" .

entity:person-Kamath-inizan2026 a schema:Person ;
    schema:name "Prathami Divakar Kamath" ;
    schema:givenName "Prathami Divakar" ;
    schema:familyName "Kamath" .

entity:person-Elena-inizan2026 a schema:Person ;
    schema:name "Alin Marin Elena" ;
    schema:givenName "Alin Marin" ;
    schema:familyName "Elena" .

entity:person-Persson-inizan2026 a schema:Person ;
    schema:name "Kristin A. Persson" ;
    schema:givenName "Kristin A." ;
    schema:familyName "Persson" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mof-inizan2026 a mlips:MaterialSystem ;
    rdfs:label "Metal-organic frameworks (QMOF and ~90 named experimental MOFs), empty and loaded with six gas adsorbates, plus isolated atoms and molecules" ;
    mlips:materialClass "Metal-organic frameworks" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-r2scand4-inizan2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-r2scand4-inizan2026 mlips:hasDFTSettings entity:calc-settings-r2scand4-inizan2026 .

entity:calc-settings-r2scand4-inizan2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-r2SCAN-D4-inizan2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "680"^^xsd:double ;
    rdfs:comment "VASP 6.4.2 via atomate2 (MatPES meta-GGA static settings), EDIFF 1e-5, LREAL False, spin polarization only for open-shell metals (Sec. 2.1.1)." .

entity:xc-r2SCAN-D4-inizan2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN-D4" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-umof-inizan2026 a mlips:TrainingDataset ;
    rdfs:label "uMOF h5_mof (r2SCAN-D4; 68,394 train / 8,470 validation / 8,660 test frames)" ;
    mlips:coversMaterial entity:mat-mof-inizan2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 85524 ;
    mlips:hasDFTCalculation entity:calc-r2scand4-inizan2026 .

entity:ds-umof-nocu-inizan2026 a mlips:TrainingDataset ;
    rdfs:label "uMOF h5_mof training frames without the Cu-MOF MD subset (ablation)" ;
    mlips:coversMaterial entity:mat-mof-inizan2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 67248 ;
    mlips:hasDFTCalculation entity:calc-r2scand4-inizan2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-umof-inizan2026 mlips:samplingStrategy
    entity:sampling-noise-inizan2026 .

entity:ds-umof-nocu-inizan2026 mlips:samplingStrategy
    entity:sampling-noise-inizan2026 .

entity:sampling-noise-inizan2026 a mlips:SamplingStrategy ;
    rdfs:label "Gaussian-noise perturbations of QMOF structures (sigma about 0.06 A), relaxation and equation-of-state trajectories, finite-temperature MD (Cu-MOF, temperature-sampled and empty-framework sets), adsorbate-loaded frameworks" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-inizan2026 ;
    mlips:hasImplementation entity:impl-MACE-inizan2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation ,
        mlips:MolecularDynamics ,
        mlips:MonteCarlo .

entity:loss-MACE-inizan2026 a mlips:LossFunction ;
    rdfs:label "Two stages with stochastic weight averaging; force/stress-weighted second stage; replay head of the foundation training kept" .

entity:impl-MACE-inizan2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:MACE-POLAR a mlips:MLIPMethod ;
    rdfs:label "MACE-POLAR (polarizable MACE with an explicit long-range electrostatic term conditioned on total charge and spin multiplicity)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation ,
        mlips:MolecularDynamics ,
        mlips:MonteCarlo .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

