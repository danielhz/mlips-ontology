# Canonical Turtle for the protocol-derived encoding of:
#   Cameron J. Nickerson et al. (2025). Assessment of a foundational machine-learned potential for energy ranking of molecular crystal polymorphs.
#   Physical Chemistry Chemical Physics. doi:10.1039/d5cp00593k
#
# Version read: submittedVersion (sha256 deecef2692119a33...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 313 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/nickerson2025.yaml.
#
# Encoding scope: the pretrained MACE-OFF23(M) potential used to
# re-optimise candidate crystal structures of 28 CSP blind-test compounds
# and 12 helicenes and to rank them (MACE//MACE, DFT//MACE), compared with
# B86bPBE(0)-XDM. Results are polymorph rankings, relative energies and
# structural similarity scores, not error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-nickerson2025 a mlips:BenchmarkStudy ;
    rdfs:label "Nickerson and Johnson (2025): MACE-OFF23(M) for geometry optimisation and energy ranking of molecular crystal polymorphs" ;
    mlips:reportedIn entity:article-nickerson2025 .

entity:article-nickerson2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/d5cp00593k> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Assessment of a foundational machine-learned potential for energy ranking of molecular crystal polymorphs" ;
    schema:author entity:person-Nickerson-nickerson2025 ,
        <https://orcid.org/0000-0002-5651-468X> .

entity:person-Nickerson-nickerson2025 a schema:Person ;
    schema:name "Cameron J. Nickerson" ;
    schema:givenName "Cameron J." ;
    schema:familyName "Nickerson" .

<https://orcid.org/0000-0002-5651-468X> a schema:Person ;
    schema:name "Erin R. Johnson" ;
    schema:givenName "Erin R." ;
    schema:familyName "Johnson" ;
    schema:identifier <https://orcid.org/0000-0002-5651-468X> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-csp-nickerson2025 a mlips:MaterialSystem ;
    rdfs:label "Candidate crystal structures of 28 CSP blind-test compounds (rigid and flexible molecules, co-crystals, organic salts) and 12 helicenes" ;
    mlips:materialClass "Organic molecular crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-xdm-nickerson2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-xdm-nickerson2025 mlips:hasDFTSettings entity:calc-settings-xdm-nickerson2025 .

entity:calc-settings-xdm-nickerson2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional entity:xc-B86bPBE-XDM-B86bPBE0-XDM-nickerson2025 ;
    rdfs:comment "FHI-aims 240206 single points with lightdense settings (geometries from lightdenser B86bPBE-XDM optimisations)." .

entity:xc-B86bPBE-XDM-B86bPBE0-XDM-nickerson2025 a mlips:XCFunctional ;
    rdfs:label "B86bPBE-XDM / B86bPBE0-XDM" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

