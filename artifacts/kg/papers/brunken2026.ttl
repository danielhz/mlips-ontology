# Q2 -- Material system
###############################################################################

entity:mat-organics-brunken2026 a mlips:MaterialSystem ;
    rdfs:label "Organic and biomolecular systems of 17 elements (SPICE2 subset of OMol25, including charged systems)" ;
    mlips:materialClass "organic molecules" .

entity:mat-chignolin-brunken2026 a mlips:MaterialSystem ;
    rdfs:label "1UAO chignolin (138 atoms)" ;
    mlips:materialClass "protein" .

entity:mat-1abt-brunken2026 a mlips:MaterialSystem ;
    rdfs:label "1ABT system (1205 atoms)" ;
    mlips:materialClass "biomolecular system" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-omol-brunken2026 a mlips:DFTCalculation .

