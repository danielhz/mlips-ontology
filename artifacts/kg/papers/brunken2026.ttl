###############################################################################

entity:calc-omol-brunken2026 mlips:hasDFTSettings entity:calc-settings-omol-brunken2026 .

entity:calc-settings-omol-brunken2026 a mlips:DFTSettings ;
    rdfs:comment "OMol25 published labels (level of theory not restated; Hessian references in Sec. 5.2 use wB97M-V/def2-TZVPD with PySCF)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-spice2-omol-brunken2026 a mlips:TrainingDataset ;
    rdfs:label "Curated SPICE2 subset of OMol25 (1,763,962 train / 172,838 validation / 17,477 test structures; SMILES-based split)" ;
    mlips:coversMaterial entity:mat-organics-brunken2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 1763962 ;
    mlips:hasDFTCalculation entity:calc-omol-brunken2026 .

