###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-brunken2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-brunken2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-brunken2026 a mlips:LossFunction ;
    rdfs:label "MSE with energy 40 / force 1000 weights flipped at epoch 115, charge and partial-charge terms" .

entity:impl-MACE-brunken2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-brunken2026 .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-brunken2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-NequIP-brunken2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-brunken2026 .

entity:ViSNet a mlips:MLIPMethod ;
    rdfs:label "ViSNet (vector-scalar interactive equivariant graph neural network)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-ViSNet-brunken2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-ViSNet-brunken2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-brunken2026 .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-eSEN-brunken2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-eSEN-brunken2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-brunken2026 .

entity:lib-mlip-brunken2026 a mlips:Library ;
    rdfs:label "mlip" ;
    mlips:candidateForVocabulary mlips:Library .

