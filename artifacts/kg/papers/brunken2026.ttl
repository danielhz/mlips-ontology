    mlips:runsOn entity:ds-spice2-omol-brunken2026 ;
    mlips:hasHyperparameterSetting entity:setting-mace-numLayers-brunken2026 ,
        entity:setting-mace-numFeatures-brunken2026 ,
        entity:setting-mace-cutoffRadius-brunken2026 ,
        entity:setting-mace-batchSize-brunken2026 ,
        entity:setting-mace-learningRate-brunken2026 ,
        entity:setting-mace-numEpochs-brunken2026 ;
    mlips:trainingHardware "NVIDIA H100 GPUs" ;
    mlips:produces entity:model-mace-brunken2026 .

entity:model-mace-brunken2026 a mlips:TrainedModel ;
    rdfs:label "mlip-v2 MACE (SPICE2/OMol25)" .

