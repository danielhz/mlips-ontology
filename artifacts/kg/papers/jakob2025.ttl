# Canonical Turtle for the protocol-derived encoding of:
#   Konstantin S. Jakob et al. (2025). Universally Accurate or Specifically Inadequate? Stress‐Testing General Purpose Machine Learning Interatomic Potentials.
#   Advanced Intelligent Discovery. doi:10.1002/aidi.202500031
#
# Version read: submittedVersion (sha256 bb04e63e7b0ee2df...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 304 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/jakob2025.yaml.
#
# Encoding scope: the default M3GNet model (m3gnet 0.2.4, MP relaxation
# trajectories) and MACE-MP-0b (medium) used to relax about 160,000
# element-substitution trial structures for 100 target compositions,
# compared with a full PBE workflow, and their RMSEs of the energy above
# the ground state against DFT single points on 16,126 relaxed structures.
# Discovery statistics, false-positive rates and Wasserstein distances are
# not error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-jakob2025 a mlips:BenchmarkStudy ;
    rdfs:label "Jakob, Reuter and Margraf (2025): stress-testing M3GNet and MACE-MP-0 in element-substitution crystal structure prediction" ;
    mlips:reportedIn entity:article-jakob2025 .

entity:article-jakob2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1002/aidi.202500031> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Universally Accurate or Specifically Inadequate? Stress‐Testing General Purpose Machine Learning Interatomic Potentials" ;
    schema:author <https://orcid.org/0009-0002-8173-5596> ,
        entity:person-Reuter-jakob2025 ,
        <https://orcid.org/0000-0002-0862-5289> .

<https://orcid.org/0009-0002-8173-5596> a schema:Person ;
    schema:name "Konstantin S. Jakob" ;
    schema:givenName "Konstantin S." ;
    schema:familyName "Jakob" ;
    schema:identifier <https://orcid.org/0009-0002-8173-5596> .

entity:person-Reuter-jakob2025 a schema:Person ;
    schema:name "Karsten Reuter" ;
    schema:givenName "Karsten" ;
    schema:familyName "Reuter" .

<https://orcid.org/0000-0002-0862-5289> a schema:Person ;
    schema:name "Johannes T. Margraf" ;
    schema:givenName "Johannes T." ;
    schema:familyName "Margraf" ;
    schema:identifier <https://orcid.org/0000-0002-0862-5289> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-inorganic-jakob2025 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals of 100 target compositions from the Materials Project (element-substitution trial structures)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-jakob2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-jakob2025 mlips:hasDFTSettings entity:calc-settings-pbe-jakob2025 .

entity:calc-settings-pbe-jakob2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "VASP 5.4.4 with MPRelaxSet/MPStaticSet (pymatgen 2022.9.8), Hubbard U for selected transition-metal oxides and fluorides." .

