###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-mp-0b-jakob2025 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0b (medium) as distributed (mace 0.3.9)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp-0b-jakob2025 .

entity:model-mace-mp-0b-jakob2025 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b (medium)" .

# entity:model-m3gnet-chen2022 (M3GNet-MPF-2021.2.8) is evaluated here; its run and model are declared in papers/chen2022.ttl.

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-jakob2025 mlips:hasResult
    entity:result-m3gnet-jakob2025 ,
    entity:result-mace-mp-0b-jakob2025 .

entity:result-m3gnet-jakob2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-m3gnet-chen2022 ;
    mlips:targetMaterial entity:mat-inorganic-jakob2025 ;
    mlips:hasAccuracyMetric entity:metric-m3gnet-1-jakob2025 .

entity:metric-m3gnet-1-jakob2025 a mlips:AccuracyMetric ;
    rdfs:label "RMSE of the energy above the ground state vs PBE: M3GNet" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "175"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:result-mace-mp-0b-jakob2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-mp-0b-jakob2025 ;
    mlips:targetMaterial entity:mat-inorganic-jakob2025 ;
    mlips:hasAccuracyMetric entity:metric-mace-mp-0b-1-jakob2025 .

entity:metric-mace-mp-0b-1-jakob2025 a mlips:AccuracyMetric ;
    rdfs:label "RMSE of the energy above the ground state vs PBE: MACE-MP-0b (medium)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "117"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

