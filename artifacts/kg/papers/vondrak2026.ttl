# Canonical Turtle for the protocol-derived encoding of:
#   Martin Vondrák et al. (2026). Integrating Charge Equilibration with Equivariant Machine-Learning Interatomic Potentials.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.6c00553
#
# Version read: publisher (sha256 ef232f343215c2c6...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 150 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the MACE-QEq method (introduced here) and the models of
# the two applications: charged oxygen vacancies in wurtzite ZnO (HSE06
# data) and water models trained on clusters only (RPBE data), trained
# from scratch, fine-tuned from MACE-OFF23, and compared with short-range
# MACE. All accuracies are shown as figures (error densities, learning
# curves), so no AccuracyMetric is encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-vondrak2026 a mlips:BenchmarkStudy ;
    rdfs:label "Vondrak et al. (2026): integrating charge equilibration with equivariant MLIPs (MACE-QEq)" ;
    mlips:reportedIn entity:article-vondrak2026 .

entity:article-vondrak2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.6c00553> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Integrating Charge Equilibration with Equivariant Machine-Learning Interatomic Potentials" ;
    schema:author entity:person-Vondrak-vondrak2026 ,
        <https://orcid.org/0009-0005-9863-6422> ,
        <https://orcid.org/0000-0002-8180-2034> ,
        <https://orcid.org/0000-0001-8473-8659> ,
        <https://orcid.org/0000-0002-0862-5289> .

entity:person-Vondrak-vondrak2026 a schema:Person ;
    schema:name "Martin Vondrák" ;
    schema:givenName "Martin" ;
    schema:familyName "Vondrák" .

<https://orcid.org/0009-0005-9863-6422> a schema:Person ;
    schema:name "William J. Baldwin" ;
    schema:givenName "William J." ;
    schema:familyName "Baldwin" ;
    schema:identifier <https://orcid.org/0009-0005-9863-6422> .

