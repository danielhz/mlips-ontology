    schema:familyName "Najm" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-c5h5-devereux2024 a mlips:MaterialSystem ;
    rdfs:label "C5H5 (cyclopentadienyl, 1,2-H-shift saddle point and product, and IRC structures)" ;
    mlips:chemicalFormula "C5H5" ;
    mlips:materialClass "hydrocarbon radical (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97xd-devereux2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97xd-devereux2024 mlips:hasDFTSettings entity:calc-settings-wb97xd-devereux2024 .

entity:calc-settings-wb97xd-devereux2024 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Q-Chem-devereux2024 ;
    mlips:xcFunctional entity:xc-wB97X-D-devereux2024 ;
    mlips:basisSet "6-311++G(d,p)" .

entity:lib-Q-Chem-devereux2024 a mlips:Library ;
    rdfs:label "Q-Chem" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-wB97X-D-devereux2024 a mlips:XCFunctional ;
    rdfs:label "wB97X-D" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-c5h5-devereux2024 a mlips:TrainingDataset ;
    rdfs:label "C5H5 normal-mode-sampled DFT pool (25 x 435 configurations); 59-structure held-out test set; 64-structure validation sets" ;
    mlips:coversMaterial entity:mat-c5h5-devereux2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10875 ;
    mlips:hasDFTCalculation entity:calc-wb97xd-devereux2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-c5h5-devereux2024 mlips:samplingStrategy
    entity:sampling-nms-devereux2024 .

entity:sampling-nms-devereux2024 a mlips:SamplingStrategy ;
    rdfs:label "Randomised normal-mode sampling at up to T = 2000 K around 25 anchor points (3 stationary points, 22 IRC points), 434 structures each, with damped low-frequency modes" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasLossFunction entity:loss-ANI-devereux2024 ;
    mlips:hasTrainingAlgorithm entity:alg-ANI-devereux2024 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-ANI-devereux2024 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-ANI-devereux2024 a mlips:LossFunction ;
    rdfs:label "Normalised energy and force L2 terms with weight lambda (0.5 for force-trained models); energy only for energy-trained models" .

entity:alg-ANI-devereux2024 a mls:Algorithm ;
    rdfs:label "256-long AEV; atomic networks 256:128:64:64:1 with Gaussian activations; Adam with step-wise learning-rate decay to 1e-6, at most 50,000 epochs; ensembles with random initialisation and splits" .

entity:impl-ANI-devereux2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-aevmod-devereux2024 .

entity:lib-aevmod-devereux2024 a mlips:Library ;
    rdfs:label "aevmod" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ft-numFeatures-devereux2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-ft-learningRate-devereux2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-ft-batchSize-devereux2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-et-numFeatures-devereux2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-et-learningRate-devereux2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-et-batchSize-devereux2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "8"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ft-devereux2024 a mlips:MLIPRun ;
    rdfs:label "Energy+force-trained NN PES ensemble (up to 2048 training structures)" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-c5h5-devereux2024 ;
    mlips:hasHyperparameterSetting entity:setting-ft-numFeatures-devereux2024 ,
        entity:setting-ft-learningRate-devereux2024 ,
        entity:setting-ft-batchSize-devereux2024 ;
    mlips:produces entity:model-ft-devereux2024 .

entity:model-ft-devereux2024 a mlips:TrainedModel ;
    rdfs:label "C5H5 NNPES (force trained)" .

entity:run-et-devereux2024 a mlips:MLIPRun ;
    rdfs:label "Energy-only-trained NN PES ensemble (up to 2048 training structures)" ;
    mlips:appliesMethod entity:ANI ;
    mlips:runsOn entity:ds-c5h5-devereux2024 ;
    mlips:hasHyperparameterSetting entity:setting-et-numFeatures-devereux2024 ,
        entity:setting-et-learningRate-devereux2024 ,
        entity:setting-et-batchSize-devereux2024 ;
    mlips:produces entity:model-et-devereux2024 .

entity:model-et-devereux2024 a mlips:TrainedModel ;
    rdfs:label "C5H5 NNPES (energy trained)" .

