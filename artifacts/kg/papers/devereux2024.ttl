# Canonical Turtle for the protocol-derived encoding of:
#   Christian Devereux et al. (2024). Force training neural network potential energy surface models.
#   International Journal of Chemical Kinetics. doi:10.1002/kin.21759  arXiv:2311.07910v1
#
# Version read: arxiv-preprint arXiv:2311.07910v1 (sha256 1a51a0e2d0a3c9cf...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 615 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/devereux2024.yaml.
#
# Encoding scope: the energy-trained and energy+force-trained neural
# network PES models (ANI-type atomic environment vectors after Smith et
# al., aevmod/PyTorch) for the cyclopentadienyl 1,2-H-shift region of the
# C5H5 PES. All energy and force errors (learning curves, F:E weight scans,
# per-structure errors) are shown only in figures, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-devereux2024 a mlips:BenchmarkStudy ;
    rdfs:label "Devereux et al. (2024): force training of neural-network potential energy surfaces for the C5H5 1,2-H shift" ;
    mlips:reportedIn entity:article-devereux2024 .

entity:article-devereux2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1002/kin.21759> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Force training neural network potential energy surface models" ;
    schema:author entity:person-Devereux-devereux2024 ,
        entity:person-Yang-devereux2024 ,
        entity:person-Marti-devereux2024 ,
        <https://orcid.org/0000-0002-9123-8238> ,
        entity:person-Eldred-devereux2024 ,
        entity:person-Najm-devereux2024 .

entity:person-Devereux-devereux2024 a schema:Person ;
    schema:name "Christian Devereux" ;
    schema:givenName "Christian" ;
    schema:familyName "Devereux" .

entity:person-Yang-devereux2024 a schema:Person ;
    schema:name "Yoona Yang" ;
    schema:givenName "Yoona" ;
    schema:familyName "Yang" .

