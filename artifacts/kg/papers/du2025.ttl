###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-halides-du2025 a mlips:MaterialSystem ;
    rdfs:label "Halide solid-state electrolytes (six systems; heated DeePMD trajectories, 100-1100 K)" ;
    mlips:materialClass "Lithium halide solid electrolytes" .

entity:mat-sse-du2025 a mlips:MaterialSystem ;
    rdfs:label "Sulfide, halide and oxide solid-state electrolytes (18 systems, 17 elements)" ;
    mlips:materialClass "Lithium solid-state electrolytes" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-sse-dft-du2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-sse-dft-du2025 mlips:hasDFTSettings entity:calc-settings-sse-dft-du2025 .

entity:calc-settings-sse-dft-du2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "KSPACING = 0.3" ;
    rdfs:comment "PBE functional consistent with the uMLIP training data (Sec. 3.1); 0.01 eV/A relaxation convergence." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-sse-du2025 a mlips:TrainingDataset ;
    rdfs:label "SSE energy and force benchmark set (1,980 DFT-labelled snapshots of 18 systems)" ;
    mlips:coversMaterial entity:mat-sse-du2025 ,
        entity:mat-halides-du2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1980 ;
    mlips:hasDFTCalculation entity:calc-sse-dft-du2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-sse-du2025 mlips:samplingStrategy
    entity:sampling-aimd-deepgen-du2025 .

entity:sampling-aimd-deepgen-du2025 a mlips:SamplingStrategy ;
    rdfs:label "Randomly perturbed structures sampled by short AIMD, then NPT MD at 100-1100 K and 0-2 GPa (AIMD and DeepGen)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

