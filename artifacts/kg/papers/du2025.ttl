@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-du2025 a mlips:BenchmarkStudy ;
    rdfs:label "Du et al. (2025): benchmark of universal MLIPs for solid-state electrolytes" ;
    mlips:reportedIn entity:article-du2025 .

entity:article-du2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2502.09970> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Universal Machine Learning Interatomic Potentials are Ready for Solid Ion Conductors" ;
    schema:author entity:person-Du-du2025 ,
        entity:person-Hui-du2025 ,
        entity:person-Zhang-du2025 ,
        entity:person-Wang-du2025 .

entity:person-Du-du2025 a schema:Person ;
