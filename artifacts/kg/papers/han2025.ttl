# Canonical Turtle for the protocol-derived encoding of:
#   Bowen Han et al. (2025). Benchmarking universal machine learning interatomic potentials for rapid analysis of inelastic neutron scattering data*.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/adfa68  arXiv:2506.01860v1
#
# Version read: arxiv-preprint arXiv:2506.01860v1 (sha256 e899efdf55aa3a95...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 246 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/han2025.yaml.
#
# Encoding scope: the twelve pretrained universal MLIPs of Table S7 and,
# as the one energy-valued error, the mean over about 5,000 crystals of the
# MAE of the phonon Helmholtz free energy against DFT (Table S4).
# Coordinate differences, phonon-frequency MAEs, DOS correlations, entropy
# and heat-capacity errors and the INS comparisons are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-han2025 a mlips:BenchmarkStudy ;
    rdfs:label "Han and Cheng (2025): benchmarking universal MLIPs for phonons and inelastic neutron scattering" ;
    mlips:reportedIn entity:article-han2025 .

entity:article-han2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/adfa68> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Benchmarking universal machine learning interatomic potentials for rapid analysis of inelastic neutron scattering data*" ;
    schema:author <https://orcid.org/0000-0002-1979-2402> ,
        <https://orcid.org/0000-0002-3263-4812> .

<https://orcid.org/0000-0002-1979-2402> a schema:Person ;
    schema:name "Bowen Han" ;
    schema:givenName "Bowen" ;
    schema:familyName "Han" ;
    schema:identifier <https://orcid.org/0000-0002-1979-2402> .

<https://orcid.org/0000-0002-3263-4812> a schema:Person ;
    schema:name "Yongqiang Cheng" ;
    schema:givenName "Yongqiang" ;
    schema:familyName "Cheng" ;
    schema:identifier <https://orcid.org/0000-0002-3263-4812> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-phonondb-han2025 a mlips:MaterialSystem ;
    rdfs:label "Nearly 5,000 dynamically stable inorganic crystals from the Materials Project (phonon database built here)" ;
    mlips:materialClass "Inorganic crystalline materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-han2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-han2025 mlips:hasDFTSettings entity:calc-settings-pbe-han2025 .

entity:calc-settings-pbe-han2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:kPointMesh "160 k-points per A^-3" ;
    rdfs:comment "Cutoff 1.6 x the largest ENMAX, PREC Accurate, 1e-8 eV; finite-displacement phonons with Phonopy, supercells of at least 12 A, Born charges for polar nonmetals (Methods)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-phonondb-han2025 a mlips:TrainingDataset ;
    rdfs:label "DFT phonon database of about 5,000 inorganic crystals (benchmark only)" ;
    mlips:coversMaterial entity:mat-phonondb-han2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-han2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-esen-oam-han2025 a mlips:MLIPRun ;
    rdfs:label "eSEN-30M-OAM as distributed (esen 30m oam)" ;
    mlips:appliesMethod entity:eSEN ;
    mlips:produces entity:model-esen-oam-han2025 .

entity:model-esen-oam-han2025 a mlips:TrainedModel ;
    rdfs:label "eSEN-30M-OAM (esen 30m oam)" .

