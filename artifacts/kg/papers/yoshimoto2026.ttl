###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-naf0-yoshimoto2026 a mlips:MaterialSystem ;
    rdfs:label "Nafion, hydration level lambda = 0 (4 monomers)" ;
    mlips:materialClass "perfluorosulfonic acid polymer electrolyte" .

entity:mat-naf1-yoshimoto2026 a mlips:MaterialSystem ;
    rdfs:label "Nafion, lambda = 1 (3 monomers, 3 H2O)" ;
    mlips:materialClass "perfluorosulfonic acid polymer electrolyte" .

entity:mat-naf7-yoshimoto2026 a mlips:MaterialSystem ;
    rdfs:label "Nafion, lambda = 7 (3 monomers, 21 H2O)" ;
    mlips:materialClass "perfluorosulfonic acid polymer electrolyte" .

entity:mat-naf13-yoshimoto2026 a mlips:MaterialSystem ;
    rdfs:label "Nafion, lambda = 13 (2 monomers, 26 H2O)" ;
    mlips:materialClass "perfluorosulfonic acid polymer electrolyte" .

entity:mat-water-yoshimoto2026 a mlips:MaterialSystem ;
    rdfs:label "Liquid water (32 molecules)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-revpbe-d3-yoshimoto2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-revpbe-d3-yoshimoto2026 mlips:hasDFTSettings entity:calc-settings-revpbe-d3-yoshimoto2026 .

entity:calc-settings-revpbe-d3-yoshimoto2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-revPBE-D3-yoshimoto2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "Gamma point (Nafion); four k-points (water)" ;
    rdfs:comment "Wavefunction cutoff 70 Ry, charge-density cutoff 280 Ry." .

entity:xc-revPBE-D3-yoshimoto2026 a mlips:XCFunctional ;
    rdfs:label "revPBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-nafion-yoshimoto2026 a mlips:TrainingDataset ;
    rdfs:label "Accumulated Nafion and water DFT data after 17 AL loops (8:2 train/validation per iteration)" ;
    mlips:coversMaterial entity:mat-naf0-yoshimoto2026 ,
        entity:mat-naf1-yoshimoto2026 ,
        entity:mat-naf7-yoshimoto2026 ,
        entity:mat-naf13-yoshimoto2026 ,
        entity:mat-water-yoshimoto2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-revpbe-d3-yoshimoto2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-nafion-yoshimoto2026 mlips:samplingStrategy
    entity:sampling-aimd-yoshimoto2026 ,
    entity:sampling-al-yoshimoto2026 .

entity:sampling-aimd-yoshimoto2026 a mlips:SamplingStrategy ;
    rdfs:label "1 ps AIMD at 400 K (Nafion) and 353 K (water), frames every 50 fs (1000 frames)" .

entity:sampling-al-yoshimoto2026 a mlips:SamplingStrategy ;
    rdfs:label "17 active-learning loops: DPMD (NVT/NPT) and non-equilibrium volume-change MD sampling, ensemble and structural-feature screening, 1000 structures labelled per loop" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-yoshimoto2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-DeePMD-yoshimoto2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-DeePMD-yoshimoto2026 a mls:Algorithm ;
    rdfs:label "se_e2_a descriptor; embedding (25, 50, 100) and fitting (120, 120, 120) ResNet-like networks; exponential learning-rate decay 1e-3 to 1e-8; 2,000,000 steps in iteration 17" .

entity:impl-DeePMD-yoshimoto2026 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp17-cutoffRadius-yoshimoto2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dp17-batchSize-yoshimoto2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-dp17-learningRate-yoshimoto2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp17-yoshimoto2026 a mlips:MLIPRun ;
    rdfs:label "Final DP model for Nafion and water (AL iteration 17)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-nafion-yoshimoto2026 ;
    mlips:hasHyperparameterSetting entity:setting-dp17-cutoffRadius-yoshimoto2026 ,
        entity:setting-dp17-batchSize-yoshimoto2026 ,
        entity:setting-dp17-learningRate-yoshimoto2026 ;
    mlips:produces entity:model-dp17-yoshimoto2026 .

entity:model-dp17-yoshimoto2026 a mlips:TrainedModel ;
    rdfs:label "DP Nafion (iteration 17)" .

