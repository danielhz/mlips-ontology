###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-li-compounds-maevskiy2025 a mlips:MaterialSystem ;
    rdfs:label "Li-containing Materials Project compounds without transition metals (band gap >= 0.5 eV, E_hull <= 0.05 eV/atom)" ;
    mlips:materialClass "Li solid-electrolyte candidates" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-siesta-maevskiy2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-siesta-maevskiy2025 mlips:hasDFTSettings entity:calc-settings-siesta-maevskiy2025 .

entity:calc-settings-siesta-maevskiy2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-SIESTA-maevskiy2025 ;
    rdfs:comment "GGA (vdW-DF LMKLL for molecular solids), Troullier-Martins pseudopotentials, DZP basis; AIMD validation of top-ranked candidates." .

entity:lib-SIESTA-maevskiy2025 a mlips:Library ;
    rdfs:label "SIESTA" ;
    mlips:candidateForVocabulary mlips:Library .

