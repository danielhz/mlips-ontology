###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-uio66-vandenhaute2023 a mlips:MaterialSystem ;
    rdfs:label "UiO-66(Zr)" ;
    mlips:materialClass "Metal-organic frameworks" .

entity:mat-mil53-vandenhaute2023 a mlips:MaterialSystem ;
    rdfs:label "MIL-53(Al) (large- and closed-pore phases)" ;
    mlips:materialClass "Metal-organic frameworks" .

entity:mat-mofs-vandenhaute2023 a mlips:MaterialSystem ;
    rdfs:label "Al- and Zr-based MOFs (CAU-13, A-520, DUT-4, MIL-68, NOTT-300, UiO-66[CDC], UiO-67, MIL-140, MOF-808, BD899C1)" ;
    mlips:materialClass "Metal-organic frameworks" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbed3-vandenhaute2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbed3-vandenhaute2023 mlips:hasDFTSettings entity:calc-settings-pbed3-vandenhaute2023 .

entity:calc-settings-pbed3-vandenhaute2023 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "PBE-D3(BJ)" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-uio66-vandenhaute2023 a mlips:TrainingDataset ;
    rdfs:label "UiO-66(Zr) incremental-learning data (11 iterations, 600 QM evaluations)" ;
    mlips:coversMaterial entity:mat-uio66-vandenhaute2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbed3-vandenhaute2023 .

entity:ds-mil53-vandenhaute2023 a mlips:TrainingDataset ;
    rdfs:label "MIL-53(Al) incremental-learning data (19 iterations, 1,000 QM evaluations)" ;
    mlips:coversMaterial entity:mat-mil53-vandenhaute2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbed3-vandenhaute2023 .

entity:ds-mofs-vandenhaute2023 a mlips:TrainingDataset ;
    rdfs:label "Ten-framework incremental-learning data (about 3,100 configurations)" ;
    mlips:coversMaterial entity:mat-mofs-vandenhaute2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbed3-vandenhaute2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-uio66-vandenhaute2023 mlips:samplingStrategy
    entity:sampling-mtd-vandenhaute2023 .

entity:ds-mil53-vandenhaute2023 mlips:samplingStrategy
    entity:sampling-mtd-vandenhaute2023 .

entity:ds-mofs-vandenhaute2023 mlips:samplingStrategy
    entity:sampling-mtd-vandenhaute2023 .

entity:sampling-mtd-vandenhaute2023 a mlips:SamplingStrategy ;
    rdfs:label "Incremental learning: 50 metadynamics walkers biased on unit-cell volume per iteration (45 training, 5 validation configurations), starting from the DFT-optimized structure" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-vandenhaute2023 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-vandenhaute2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-NequIP-vandenhaute2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-NequIP-vandenhaute2023 a mlips:LossFunction ;
    rdfs:label "Weighted average of energy and force errors" .

entity:alg-NequIP-vandenhaute2023 a mls:Algorithm ;
    rdfs:label "Adam; incremental learning managed with Snakemake" .

entity:impl-NequIP-vandenhaute2023 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nq-uio66-cutoffRadius-vandenhaute2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-nq-uio66-numLayers-vandenhaute2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

