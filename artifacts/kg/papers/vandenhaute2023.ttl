# Canonical Turtle for the protocol-derived encoding of:
#   Sander Vandenhaute et al. (2023). Machine learning potentials for metal-organic frameworks using an incremental learning approach.
#   npj Computational Materials. doi:10.1038/s41524-023-00969-x
#
# Version read: publisher (sha256 36b78c23c4f4fe07...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 571 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/vandenhaute2023.yaml.
#
# Encoding scope: NequIP models (5 A cutoff, 4 interaction layers, about
# 200,000 weights) trained by incremental learning (50 MTD walkers on
# the unit-cell volume per iteration) for UiO-66(Zr) and MIL-53(Al), and
# one model trained on 10 Al/Zr frameworks (about 3,100 configurations)
# with per-framework test force and stress MAEs at 600 K (Table 1), two
# of the frameworks held out. Single-system errors are stated only as
# bounds. Stiffness tensors and the MIL-53 transition pressure are
# properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-vandenhaute2023 a mlips:BenchmarkStudy ;
    rdfs:label "Vandenhaute et al. (2023): NequIP potentials for metal-organic frameworks built by incremental learning with metadynamics walkers" ;
    mlips:reportedIn entity:article-vandenhaute2023 .

entity:article-vandenhaute2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-023-00969-x> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Machine learning potentials for metal-organic frameworks using an incremental learning approach" ;
    schema:author entity:person-Vandenhaute-vandenhaute2023 ,
