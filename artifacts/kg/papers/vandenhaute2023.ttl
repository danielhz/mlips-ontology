entity:setting-nq-mil53-learningRate-vandenhaute2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.005"^^xsd:double .

entity:setting-nq-mofs-cutoffRadius-vandenhaute2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-nq-mofs-numLayers-vandenhaute2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
