###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nq-uio66-vandenhaute2023 a mlips:MLIPRun ;
    rdfs:label "NequIP for UiO-66(Zr)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-uio66-vandenhaute2023 ;
