###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-cace-water-T0-cheng2024 a mlips:MLIPRun ;
    rdfs:label "CACE fit to liquid water, no message passing (T=0)" ;
    mlips:appliesMethod entity:CACE ;
    mlips:runsOn entity:ds-water-cheng2024 ;
    mlips:hasHyperparameterSetting entity:setting-cace-water-T0-cutoffRadius-cheng2024 ,
        entity:setting-cace-water-T0-numRadialBasis-cheng2024 ,
        entity:setting-cace-water-T0-radial-channels-cheng2024 ,
        entity:setting-cace-water-T0-numAngularBasis-cheng2024 ,
        entity:setting-cace-water-T0-bodyOrder-cheng2024 ,
        entity:setting-cace-water-T0-n-embedding-cheng2024 ,
        entity:setting-cace-water-T0-numLayers-cheng2024 ;
    mlips:trainingHardware "GeForce GTX 1080 Ti GPU; about two days" ;
    mlips:produces entity:model-cace-water-T0-cheng2024 .

entity:model-cace-water-T0-cheng2024 a mlips:TrainedModel ;
    rdfs:label "CACE water model, T=0 (24,572 trainable parameters)" .

entity:run-cace-water-T1-cheng2024 a mlips:MLIPRun ;
    rdfs:label "CACE fit to liquid water, one message-passing layer (T=1)" ;
    mlips:appliesMethod entity:CACE ;
    mlips:runsOn entity:ds-water-cheng2024 ;
    mlips:hasHyperparameterSetting entity:setting-cace-water-T1-cutoffRadius-cheng2024 ,
        entity:setting-cace-water-T1-numRadialBasis-cheng2024 ,
        entity:setting-cace-water-T1-radial-channels-cheng2024 ,
        entity:setting-cace-water-T1-numAngularBasis-cheng2024 ,
        entity:setting-cace-water-T1-bodyOrder-cheng2024 ,
        entity:setting-cace-water-T1-n-embedding-cheng2024 ,
        entity:setting-cace-water-T1-numLayers-cheng2024 ;
    mlips:trainingHardware "GeForce GTX 1080 Ti GPU; about two days" ;
    mlips:produces entity:model-cace-water-T1-cheng2024 .

entity:model-cace-water-T1-cheng2024 a mlips:TrainedModel ;
    rdfs:label "CACE water model, T=1 (69,320 trainable parameters)" ;
    mlips:inferenceHardware "Single Nvidia A100 GPU: 24 / 8 / 3.5 / 1.7 ps of MD per hour for 1,536 / 5,184 / 12,288 / 24,000 atoms of liquid water (Table V)" .

entity:run-cace-ethanol-cheng2024 a mlips:MLIPRun ;
    rdfs:label "CACE fit to MD17 ethanol" ;
    mlips:appliesMethod entity:CACE ;
    mlips:runsOn entity:ds-ethanol-cheng2024 ;
    mlips:hasHyperparameterSetting entity:setting-cace-ethanol-cutoffRadius-cheng2024 ,
        entity:setting-cace-ethanol-numRadialBasis-cheng2024 ,
        entity:setting-cace-ethanol-radial-channels-cheng2024 ,
        entity:setting-cace-ethanol-numAngularBasis-cheng2024 ,
        entity:setting-cace-ethanol-bodyOrder-cheng2024 ,
        entity:setting-cace-ethanol-n-embedding-cheng2024 ,
        entity:setting-cace-ethanol-numLayers-cheng2024 ;
    mlips:produces entity:model-cace-ethanol-cheng2024 .

entity:model-cace-ethanol-cheng2024 a mlips:TrainedModel ;
    rdfs:label "CACE ethanol model" .

entity:run-cace-3BPA-cheng2024 a mlips:MLIPRun ;
    rdfs:label "CACE fit to 3BPA (300 K training data)" ;
    mlips:appliesMethod entity:CACE ;
    mlips:runsOn entity:ds-3BPA-cheng2024 ;
    mlips:hasHyperparameterSetting entity:setting-cace-3BPA-cutoffRadius-cheng2024 ,
        entity:setting-cace-3BPA-numRadialBasis-cheng2024 ,
        entity:setting-cace-3BPA-radial-channels-cheng2024 ,
        entity:setting-cace-3BPA-numAngularBasis-cheng2024 ,
        entity:setting-cace-3BPA-bodyOrder-cheng2024 ,
        entity:setting-cace-3BPA-n-embedding-cheng2024 ,
        entity:setting-cace-3BPA-numLayers-cheng2024 ;
    mlips:produces entity:model-cace-3BPA-cheng2024 .

entity:model-cace-3BPA-cheng2024 a mlips:TrainedModel ;
    rdfs:label "CACE 3BPA model" .

entity:run-cace-HEA25-cheng2024 a mlips:MLIPRun ;
    rdfs:label "CACE fit to HEA25" ;
    mlips:appliesMethod entity:CACE ;
    mlips:runsOn entity:ds-HEA25-cheng2024 ;
    mlips:hasHyperparameterSetting entity:setting-cace-HEA25-cutoffRadius-cheng2024 ,
        entity:setting-cace-HEA25-numAngularBasis-cheng2024 ,
        entity:setting-cace-HEA25-bodyOrder-cheng2024 ,
        entity:setting-cace-HEA25-n-embedding-cheng2024 ,
        entity:setting-cace-HEA25-numLayers-cheng2024 ;
    mlips:trainingHardware "GeForce GTX 1080 Ti GPU; about two days" ;
    mlips:produces entity:model-cace-HEA25-cheng2024 .

entity:model-cace-HEA25-cheng2024 a mlips:TrainedModel ;
    rdfs:label "CACE HEA25 model (91,232 trainable parameters)" .

entity:run-nequip-water-cheng2024 a mlips:MLIPRun ;
    rdfs:label "NequIP comparison fit to liquid water (trained by the author)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-water-cheng2024 ;
    mlips:hasHyperparameterSetting entity:setting-nequip-water-cutoffRadius-cheng2024 ,
        entity:setting-nequip-water-numLayers-cheng2024 ;
    mlips:produces entity:model-nequip-water-cheng2024 .

entity:model-nequip-water-cheng2024 a mlips:TrainedModel ;
    rdfs:label "NequIP water model (4.5 A, T=3)" ;
    mlips:inferenceHardware "Single Nvidia A100 GPU: 20 / 7 / 3 / 1.65 ps of MD per hour for 1,536 / 5,184 / 12,288 / 24,000 atoms (Table V)" .

entity:run-deepmd-water-cheng2024 a mlips:MLIPRun ;
    rdfs:label "DeepMD comparison fit to liquid water (trained by the author)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-water-cheng2024 ;
    mlips:hasHyperparameterSetting entity:setting-deepmd-water-cutoffRadius-cheng2024 ;
    mlips:produces entity:model-deepmd-water-cheng2024 .

entity:model-deepmd-water-cheng2024 a mlips:TrainedModel ;
    rdfs:label "DeepMD water model (6 A)" .

entity:run-mace-water-cheng2024 a mlips:MLIPRun ;
    rdfs:label "MACE comparison fit to liquid water (trained by the author)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-water-cheng2024 ;
    mlips:produces entity:model-mace-water-cheng2024 .

entity:model-mace-water-cheng2024 a mlips:TrainedModel ;
    rdfs:label "MACE water model trained in this work" .

entity:run-bpnn-water-cheng2024 a mlips:MLIPRun ;
    rdfs:label "BPNN comparison fit to liquid water with N2P2 (trained by the author)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-water-cheng2024 ;
    mlips:produces entity:model-bpnn-water-cheng2024 .

entity:model-bpnn-water-cheng2024 a mlips:TrainedModel ;
    rdfs:label "BPNN (N2P2) water model" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-cheng2024 mlips:hasResult
    entity:result-cace-water-T0-cheng2024 ,
    entity:result-cace-water-T1-cheng2024 ,
    entity:result-nequip-water-cheng2024 ,
    entity:result-deepmd-water-cheng2024 ,
