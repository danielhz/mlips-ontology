# Canonical Turtle for the protocol-derived encoding of:
#   Bingqing Cheng et al. (2024). Cartesian atomic cluster expansion for machine learning interatomic potentials.
#   npj Computational Materials. doi:10.1038/s41524-024-01332-4  arXiv:2402.07472v3
#
# Version read: arxiv-preprint arXiv:2402.07472v3 (sha256 b236f28b24322d53...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 4 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the CACE method and the five CACE fits of the paper
# (liquid water with T=0 and T=1, MD17 ethanol, 3BPA, HEA25), plus the
# comparison models the author trained on the water data set (NequIP,
# DeepMD, MACE, a BPNN with N2P2). Errors quoted from other papers in
# Tables I-IV are not results of this study and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-cheng2024 a mlips:BenchmarkStudy ;
    rdfs:label "Cheng (2024): Cartesian atomic cluster expansion (CACE)" ;
    mlips:reportedIn entity:article-cheng2024 .

entity:article-cheng2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-024-01332-4> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Cartesian atomic cluster expansion for machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-3584-9632> .

<https://orcid.org/0000-0002-3584-9632> a schema:Person ;
    schema:name "Bingqing Cheng" ;
    schema:givenName "Bingqing" ;
    schema:familyName "Cheng" ;
    schema:identifier <https://orcid.org/0000-0002-3584-9632> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-cheng2024 a mlips:MaterialSystem ;
    rdfs:label "Bulk liquid water" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-ethanol-cheng2024 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule (MD17)" ;
    mlips:chemicalFormula "C2H6O" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-3BPA-cheng2024 a mlips:MaterialSystem ;
    rdfs:label "3-(benzyloxy)pyridin-2-amine (3BPA) molecule" ;
    mlips:materialClass "Flexible drug-like organic molecule (gas phase)" .

entity:mat-HEA25-cheng2024 a mlips:MaterialSystem ;
    rdfs:label "25-element d-block transition-metal high-entropy alloys (HEA25)" ;
    mlips:materialClass "High-entropy alloy; distorted bcc and fcc crystalline structures of 36 or 48 atoms" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-water-dft-cheng2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-water-dft-cheng2024 mlips:hasDFTSettings entity:calc-settings-water-dft-cheng2024 .

entity:calc-settings-water-dft-cheng2024 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-revPBE0-D3-cheng2024 ;
    rdfs:comment "revPBE0-D3 level of DFT, as stated for the water data set of Ref. [37]; code and numerical settings are not given in this paper." .

entity:xc-revPBE0-D3-cheng2024 a mlips:XCFunctional ;
    rdfs:label "revPBE0-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-water-cheng2024 a mlips:TrainingDataset ;
    rdfs:label "Liquid water data set (1,593 configurations of 64 molecules)" ;
    mlips:coversMaterial entity:mat-water-cheng2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1593 ;
    mlips:hasDFTCalculation entity:calc-water-dft-cheng2024 ;
    rdfs:comment "From Ref. [37] (github.com/BingqingCheng/ab-initio-thermodynamics-of-water); 90% of the data used for training." .

entity:ds-ethanol-cheng2024 a mlips:TrainingDataset ;
    rdfs:label "MD17 ethanol subset (1,000 structures)" ;
    mlips:coversMaterial entity:mat-ethanol-cheng2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 ;
    rdfs:comment "90% train / 10% validation split; tested on another 10,000 random structures." .

entity:ds-3BPA-cheng2024 a mlips:TrainingDataset ;
    rdfs:label "3BPA training set (500 structures at 300 K)" ;
    mlips:coversMaterial entity:mat-3BPA-cheng2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 500 .

entity:ds-HEA25-cheng2024 a mlips:TrainingDataset ;
    rdfs:label "HEA25 training and validation pool (up to 24,630 structures)" ;
    mlips:coversMaterial entity:mat-HEA25-cheng2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 24630 ;
    rdfs:comment "The HEA25 data set has 25,630 structures; 1,000 are held out as the test set and up to the remaining 24,630 are used for training and validation." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ethanol-cheng2024 mlips:samplingStrategy
    entity:sampling-md17-aimd-cheng2024 .

entity:ds-3BPA-cheng2024 mlips:samplingStrategy
    entity:sampling-bpa-300K-cheng2024 .

entity:ds-HEA25-cheng2024 mlips:samplingStrategy
    entity:sampling-hea-distorted-cheng2024 .

entity:sampling-md17-aimd-cheng2024 a mlips:SamplingStrategy ;
    rdfs:label "DFT molecular dynamics at 500 K (MD17)" ;
    rdfs:comment "MD17 ethanol configurations sampled from DFT molecular dynamics at 500 K; 1,000 structures drawn at random." .

entity:sampling-bpa-300K-cheng2024 a mlips:SamplingStrategy ;
    rdfs:label "3BPA training configurations at 300 K" ;
    rdfs:comment "500 training structures at 300 K; test data from simulations at 300 K, 600 K and 1200 K." .

entity:sampling-hea-distorted-cheng2024 a mlips:SamplingStrategy ;
    rdfs:label "Distorted crystalline HEA structures" ;
    rdfs:comment "Distorted bcc or fcc structures of 36 or 48 atoms from the HEA25 data set of Ref. [54]." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CACE a mlips:MLIPMethod ;
    rdfs:label "Cartesian Atomic Cluster Expansion (CACE)" ;
    mlips:hasFunctionalForm entity:ff-CACE ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:numAngularBasis ,
        mlips:bodyOrder ,
        mlips:numLayers ,
        entity:hp-radial-channels-cheng2024 ,
        entity:hp-n-embedding-cheng2024 ;
    mlips:hasImplementation entity:impl-CACE-cheng2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-CACE a mlips:FunctionalForm ;
    rdfs:label "Body-ordered atomic cluster expansion whose rotationally invariant features are built by symmetrising Cartesian angular basis functions, with optional message passing between atoms; atomic energies are summed to the total energy" .

entity:impl-CACE-cheng2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-cace-cheng2024 .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers .

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasImplementation entity:impl-HDNNP-cheng2024 .

entity:impl-HDNNP-cheng2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-cheng2024 .

entity:lib-cace-cheng2024 a mlips:Library ;
    rdfs:label "cace" ;
    rdfs:comment "PyTorch implementation, https://github.com/BingqingCheng/cace; MD through ASE, no LAMMPS interface at the time of the paper." ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-n2p2-cheng2024 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-radial-channels-cheng2024 a mlips:Hyperparameter ;
    rdfs:label "CACE number of radial channels c" ;
    mlips:hyperparameterName "c" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-n-embedding-cheng2024 a mlips:Hyperparameter ;
    rdfs:label "CACE dimension of the element embedding N_embedding" ;
    mlips:hyperparameterName "N_embedding" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-cace-water-T0-cutoffRadius-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-cace-water-T0-numRadialBasis-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-cace-water-T0-radial-channels-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-radial-channels-cheng2024 ;
    mlips:settingValue "12"^^xsd:integer .

entity:setting-cace-water-T0-numAngularBasis-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-cace-water-T0-bodyOrder-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-cace-water-T0-n-embedding-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-n-embedding-cheng2024 ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-cace-water-T0-numLayers-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "0"^^xsd:integer .

entity:setting-cace-water-T1-cutoffRadius-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-cace-water-T1-numRadialBasis-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-cace-water-T1-radial-channels-cheng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-radial-channels-cheng2024 ;
    mlips:settingValue "12"^^xsd:integer .

