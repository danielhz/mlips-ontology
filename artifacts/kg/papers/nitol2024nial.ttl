# Canonical Turtle for the protocol-derived encoding of:
#   Wang, Liu, Zhu, Liu, Ma, Chen, Sun, Chen. Efficient moment tensor
#   machine-learning interatomic potential for accurate description of
#   defects in Ni-Al alloys. arXiv:2411.01282 (2024/2025).
#
# Note on paper-id: this corpus entry is filed under the paper-id
# "nitol2024nial" by upstream convention; the source paper is by Wang
# et al. of the Shenyang National Laboratory for Materials Science,
# not Nitol et al. We retain the paper-id but record the actual
# bibliographic data faithfully.
#
# Encoding scope: a single MTP for the Ni-Al binary system, trained
# with active learning (on-the-fly during AIMD plus D-optimality
# cycles) and benchmarked on point and planar defects in fcc Ni and
# L1_2-Ni3Al. Conventional one-method x one-material-system encoding
# (cf. kumar2025, qi2023).

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-nitol2024nial a mlips:BenchmarkStudy ;
    rdfs:label "Wang et al. (2024): efficient MTP for defects in Ni-Al alloys" ;
    mlips:reportedIn entity:article-nitol2024nial .

entity:article-nitol2024nial a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arXiv.2411.01282> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Efficient Moment Tensor Machine-Learning Interatomic Potential for Accurate Description of Defects in Ni-Al Alloys" ;
    schema:author
        <https://orcid.org/0009-0000-2049-1829> ,
        <https://orcid.org/0000-0003-4962-7691> ,
        entity:person-Zhu-nitol2024nial ,
        <https://orcid.org/0000-0003-4962-7691> ,
        <https://orcid.org/0009-0009-7643-8723> ,
        <https://orcid.org/0000-0002-5904-6578> ,
        entity:person-Sun-nitol2024nial ,
        <https://orcid.org/0000-0002-5904-6578> .

<https://orcid.org/0009-0000-2049-1829> a schema:Person ;
    schema:name "Jiantao Wang" ;
    schema:givenName "Jiantao" ;
    schema:familyName "Wang" ;
    schema:identifier <https://orcid.org/0009-0000-2049-1829> .
<https://orcid.org/0000-0003-4962-7691> a schema:Person ;
    schema:name "Peitao Liu" ;
    schema:givenName "Peitao" ;
    schema:familyName "Liu" ;
    schema:identifier <https://orcid.org/0000-0003-4962-7691> .
entity:person-Zhu-nitol2024nial a schema:Person ;
    schema:name "Heyu Zhu" ;
    schema:givenName "Heyu" ;
    schema:familyName "Zhu" ;
    rdfs:comment "No ORCID found via Crossref / arXiv API as of 2026-05-04." .

<https://orcid.org/0009-0009-7643-8723> a schema:Person ;
    schema:name "Hui Ma" ;
    schema:givenName "Hui" ;
    schema:familyName "Ma" ;
    schema:identifier <https://orcid.org/0009-0009-7643-8723> .
<https://orcid.org/0000-0002-5904-6578> a schema:Person ;
    schema:name "Yun Chen" ;
    schema:givenName "Yun" ;
    schema:familyName "Chen" ;
    schema:identifier <https://orcid.org/0000-0002-5904-6578> .
entity:person-Sun-nitol2024nial a schema:Person ;
    schema:name "Yan Sun" ;
    schema:givenName "Yan" ;
    schema:familyName "Sun" ;
    rdfs:comment "No ORCID found via Crossref / arXiv API as of 2026-05-04." .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-NiAl-nitol2024nial a mlips:MaterialSystem ;
    rdfs:label "Ni-Al binary alloy (fcc Ni and L1_2-Ni3Al phases plus their interface and defects)" ;
    mlips:chemicalFormula "Ni-Al" ;
    mlips:materialClass "Binary intermetallic; fcc Ni (Fm-3m), L1_2-Ni3Al (Pm-3m), Ni/Ni3Al interface; with vacancies, vacancy clusters, antisites, and generalised stacking-fault (GSF) defects" ;
    rdfs:comment "Wikidata Q7028279 ('nickel aluminide') covers the Ni3Al intermetallic specifically, which is the dominant target of this paper's MTP. The broader Ni-Al binary alloy has no dedicated Wikidata entry as of 2026-04-28." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q7028279> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-nitol2024nial a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-nitol2024nial mlips:hasDFTSettings entity:dft-settings-nitol2024nial .

entity:dft-settings-nitol2024nial a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack with k-point spacing ~0.2 A^-1; total energies converged to 1 meV/atom; SCF convergence 1e-6 eV; ionic-relaxation force convergence 0.01 eV/A" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-NiAl-nitol2024nial a mlips:TrainingDataset ;
    rdfs:label "Ni-Al MTP training set: 8450 configurations (6092 from on-the-fly active learning during AIMD + 2358 added through D-optimality active-learning cycles)" ;
    mlips:coversMaterial entity:mat-NiAl-nitol2024nial ;
    mlips:coversProperty mlips:Energy , mlips:Forces , mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 8450 ;
    mlips:hasDFTCalculation entity:dft-nitol2024nial .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-NiAl-nitol2024nial mlips:samplingStrategy
    entity:on-the-fly-aimd-sampling-nitol2024nial ,
    entity:d-optimality-active-learning-nitol2024nial ,
    entity:defect-prototype-sampling-nitol2024nial .

entity:on-the-fly-aimd-sampling-nitol2024nial a mlips:SamplingStrategy ;
    rdfs:label "On-the-fly active learning during AIMD (kernel-based Bayesian regression in VASP)" ;
    rdfs:comment "First-pass training-set generation: on-the-fly Bayesian-regression active learning during AIMD heating from 700 to 1600 K at ambient pressure (NPT, Langevin thermostat + Parrinello-Rahman barostat). Yields 6092 reference configurations." .

entity:d-optimality-active-learning-nitol2024nial a mlips:SamplingStrategy ;
    rdfs:label "D-optimality active learning (Shapeev's generalised D-optimality criterion)" ;
    rdfs:comment "Second-pass active learning: 200 ps MD trajectories with the current MTP are screened for configurations whose extrapolation grade exceeds 5; selected configurations have their DFT energies, forces, and stresses computed and added to the training set; the MTP is refitted; iterations continue until no configurations exceed the threshold. Adds 2358 configurations." .

entity:defect-prototype-sampling-nitol2024nial a mlips:SamplingStrategy ;
    rdfs:label "Defect-prototype enumeration" ;
    rdfs:comment "Initial configurations span fcc Ni, L1_2-Ni3Al, the Ni/Ni3Al interface, GSF supercells of Ni and Ni3Al, plus combinations with vacancies, vacancy clusters, and antisite defects; an independent validation set of 815 configurations was constructed from the same prototypes." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP-nitol2024nial a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential with optimised tensor-contraction scheme (Wang et al. 2024)" ;
    mlips:hasFunctionalForm entity:mtp-functional-form-nitol2024nial;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:mtp-loss-1-001-0005-nitol2024nial ;
    mlips:hasTrainingAlgorithm entity:lbfgs-nitol2024nial ;
    mlips:hasHyperparameter mlips:cutoffRadius , mlips:momentLevel ,
        mlips:numRadialBasis , mlips:bodyOrder ,
        entity:hp-num-linear-params-nitol2024nial ;
    mlips:hasImplementation entity:mlip-package-nitol2024nial .

entity:mtp-functional-form-nitol2024nial a mlips:FunctionalForm ;
    rdfs:label "MTP moment-tensor polynomial with genetic-algorithm-optimised tensor contractions; rank of moment tensors limited to 4 (mu <= 3) and the redefined level lev(M_{mu,nu}) = 2*mu + nu + 1 with maximum-level threshold 2653" .

entity:mtp-loss-1-001-0005-nitol2024nial a mlips:LossFunction ;
    rdfs:label "Weighted MSE on energy, forces, and stresses with weights 1 : 0.01 : 0.005" .

entity:lbfgs-nitol2024nial a mls:Algorithm ;
    rdfs:label "Two-step fitting: (i) initial linear coefficients on a minimal basis followed by linear optimisation on the full basis with shared radial functions; (ii) L-BFGS for 5000 iterations followed by a least-squares linear refinement" .

entity:mlip-package-nitol2024nial a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-5_4-nitol2024nial a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.4"^^xsd:double .

entity:setting-levmax-2653-nitol2024nial a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "2653"^^xsd:integer .

entity:setting-num-radial-8-nitol2024nial a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-max-body-order-5-nitol2024nial a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-num-linear-params-2653-nitol2024nial a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-num-linear-params-nitol2024nial ;
    mlips:settingValue "2653"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-mtp-NiAl-nitol2024nial a mlips:MLIPRun ;
    rdfs:label "MTP training run (2653 basis set, r_cut=5.4 A) on the Ni-Al training set" ;
    mlips:appliesMethod entity:MTP-nitol2024nial ;
    mlips:runsOn entity:ds-NiAl-nitol2024nial ;
    mlips:hasHyperparameterSetting
        entity:setting-rcut-5_4-nitol2024nial ,
        entity:setting-levmax-2653-nitol2024nial ,
        entity:setting-num-radial-8-nitol2024nial ,
        entity:setting-max-body-order-5-nitol2024nial ,
        entity:setting-num-linear-params-2653-nitol2024nial ;
    mlips:trainingHardware "96 CPU cores (Intel Xeon Platinum 9242 @ 2.30 GHz)" ;
    mlips:produces entity:model-mtp-NiAl-nitol2024nial .

entity:model-mtp-NiAl-nitol2024nial a mlips:TrainedModel ;
    rdfs:label "Optimised MTP for Ni-Al alloys (2653 basis set, 5.4 A cutoff)" ;
    mlips:inferenceHardware "96 CPU cores (Intel Xeon Platinum 9242 @ 2.30 GHz): 100,000 MD steps on a 2048-atom Ni3Al supercell take ~241 s" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-nitol2024nial mlips:hasResult
    entity:result-rmse-energy-nitol2024nial ,
    entity:result-rmse-force-nitol2024nial ,
    entity:result-rmse-stress-nitol2024nial .

entity:result-rmse-energy-nitol2024nial a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-NiAl-nitol2024nial ;
    mlips:targetMaterial entity:mat-NiAl-nitol2024nial ;
    mlips:hasAccuracyMetric entity:metric-rmse-energy-nitol2024nial .

entity:metric-rmse-energy-nitol2024nial a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on energy per atom (Ni-Al validation set, 815 configs)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.64"^^xsd:double ;
    mlips:hasUnit unit:MeV-PER-ATOM .

entity:result-rmse-force-nitol2024nial a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-NiAl-nitol2024nial ;
    mlips:targetMaterial entity:mat-NiAl-nitol2024nial ;
    mlips:hasAccuracyMetric entity:metric-rmse-force-nitol2024nial .

entity:metric-rmse-force-nitol2024nial a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on force components (Ni-Al validation set)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.028"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

entity:result-rmse-stress-nitol2024nial a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-NiAl-nitol2024nial ;
    mlips:targetMaterial entity:mat-NiAl-nitol2024nial ;
    mlips:hasAccuracyMetric entity:metric-rmse-stress-nitol2024nial .

entity:metric-rmse-stress-nitol2024nial a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on stress components (Ni-Al validation set)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue "0.09"^^xsd:double ;
    mlips:hasUnit unit:GigaPA .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Captured in Q9 where the predicates allow it:
#   - mlips:trainingHardware = "96 CPU cores (Intel Xeon Platinum 9242 @ 2.30 GHz)"
#   - mlips:inferenceHardware on the trained model = same hardware,
#     with a concrete MD-throughput data point
# Wall-clock total training duration, GPU hours (none used; CPU run),
# peak memory, and explicit per-atom inference time are not reported.

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-num-linear-params-nitol2024nial a mlips:Hyperparameter ;
    rdfs:label "MTP linear-parameter count (after GA-optimised contractions)" ;
    mlips:hyperparameterName "num_linear_params" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .
