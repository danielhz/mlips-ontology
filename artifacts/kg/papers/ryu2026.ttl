###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:AIMNet2 a mlips:MLIPMethod ;
    rdfs:label "AIMNet2 (atoms-in-molecules neural network potential with learned charges and explicit long-range terms)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-maceoff-ryu2026 a mlips:MLIPRun ;
    rdfs:label "MACE-OFF23(M) (as distributed)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-maceoff-ryu2026 .

entity:model-maceoff-ryu2026 a mlips:TrainedModel ;
    rdfs:label "MACE-OFF23(M)" .

entity:run-aimnet2-ryu2026 a mlips:MLIPRun ;
    rdfs:label "AIMNet2 (as distributed)" ;
    mlips:appliesMethod entity:AIMNet2 ;
    mlips:produces entity:model-aimnet2-ryu2026 .

entity:model-aimnet2-ryu2026 a mlips:TrainedModel ;
    rdfs:label "AIMNet2" .

entity:run-aceff2-ryu2026 a mlips:MLIPRun ;
    rdfs:label "AceFF-2 / TensorNet2 (as distributed)" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:produces entity:model-aceff2-ryu2026 .

entity:model-aceff2-ryu2026 a mlips:TrainedModel ;
    rdfs:label "AceFF-2" .

