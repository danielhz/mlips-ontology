# Canonical Turtle for the protocol-derived encoding of:
#   Kun Ryu et al. (2026). Risk-Controlled DFT Selection for Machine-Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2610.19630  arXiv:2610.19630v1
#
# Version read: arxiv-preprint arXiv:2610.19630v1 (sha256 09e5374f55083f26...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 553 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ryu2026.yaml.
#
# Encoding scope: the three pretrained MLIPs whose residuals are scored
# (MACE-OFF23(M), AIMNet2, AceFF-2/TensorNet2), as distributed, on three
# molecular datasets (COMP6-GDB07to09, MACE-OFF23-FULL, QCML-6950-9).
# The paper reports DFT-call savings, normalized gains and selection
# rates under a risk budget, not energy/force error metrics of the
# models; no results are encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ryu2026 a mlips:BenchmarkStudy ;
    rdfs:label "Ryu et al. (2026): risk-controlled selection of configurations for DFT recomputation using conformal risk control on MLIP error scores" ;
    mlips:reportedIn entity:article-ryu2026 .

entity:article-ryu2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.19630> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Risk-Controlled DFT Selection for Machine-Learned Interatomic Potentials" ;
    schema:author entity:person-Ryu-ryu2026 ,
        entity:person-Jung-ryu2026 ,
        entity:person-Ong-ryu2026 ,
        entity:person-Donnat-ryu2026 ,
        entity:person-Meng-ryu2026 .

entity:person-Ryu-ryu2026 a schema:Person ;
    schema:name "Kun Ryu" ;
    schema:givenName "Kun" ;
    schema:familyName "Ryu" .

entity:person-Jung-ryu2026 a schema:Person ;
    schema:name "Yeo Jin Jung" ;
    schema:givenName "Yeo Jin" ;
    schema:familyName "Jung" .

entity:person-Ong-ryu2026 a schema:Person ;
    schema:name "Shyue Ping Ong" ;
    schema:givenName "Shyue Ping" ;
    schema:familyName "Ong" .

entity:person-Donnat-ryu2026 a schema:Person ;
    schema:name "Claire Donnat" ;
    schema:givenName "Claire" ;
    schema:familyName "Donnat" .

entity:person-Meng-ryu2026 a schema:Person ;
    schema:name "Ying Shirley Meng" ;
    schema:givenName "Ying Shirley" ;
    schema:familyName "Meng" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mol-ryu2026 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules of COMP6-GDB07to09, MACE-OFF23 and QCML (H, C, N, O, F, P, S, Cl, Br, I)" ;
    mlips:materialClass "Organic molecules (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
