        entity:hp-fitting-net-jiang2026 ,
        entity:hp-training-steps-jiang2026 ,
        entity:hp-sel-jiang2026 ;
    mlips:hasImplementation entity:impl-DeePMD-jiang2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-DeePMD-jiang2026 a mlips:LossFunction ;
    rdfs:label "DeePMD-kit loss with prefactors P_e from 0.02 to 1, P_f from 1000 to 1 and P_v = 0" .

entity:impl-DeePMD-jiang2026 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit ;
    mlips:version "DeepPot-SE descriptor; run in LAMMPS through the DeePMD-kit interface" .

entity:hp-embedding-net-jiang2026 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential embedding network sizes" ;
    mlips:hyperparameterName "embedding_net" ;
