###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-FLiBeEu-jiang2026 a mlips:MaterialSystem ;
    rdfs:label "Molten LiF-BeF2-EuF2 (FLiBeEu) at 823 K, 0.50 to 6.25 mol% EuF2" ;
    mlips:chemicalFormula "LiF-BeF2-EuF2" ;
    mlips:materialClass "Molten fluoride salt with a lanthanide fission-product solute" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-jiang2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-jiang2026 mlips:hasDFTSettings entity:calc-settings-dft-jiang2026 .

entity:calc-settings-dft-jiang2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "550"^^xsd:double ;
    mlips:kPointMesh "1x1x1" ;
    rdfs:comment "First-principles MD with DFT-D3 dispersion corrections; valence configurations Li 1s2 2s1, Be 2s2, F 2s2 2p5, Eu 5p6 6s2. Spin-polarised DFT+U (U - J = 5) with Eu 4f electrons was also tested; the paper states that FPMD data containing 4f electrons are excluded from the training data set." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-FLiBeEu-jiang2026 a mlips:TrainingDataset ;
    rdfs:label "FLiBeEu first-principles MD data set (60,000 configurations)" ;
    mlips:coversMaterial entity:mat-FLiBeEu-jiang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 60000 ;
    mlips:hasDFTCalculation entity:calc-dft-jiang2026 ;
    rdfs:comment "Randomly shuffled and split into training (80%), validation (10%) and testing (10%) subsets." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-FLiBeEu-jiang2026 mlips:samplingStrategy
    entity:sampling-fpmd-jiang2026 .

entity:sampling-fpmd-jiang2026 a mlips:SamplingStrategy ;
    rdfs:label "First-principles MD in NPT and NVT ensembles" ;
    rdfs:comment "For each of three EuF2 concentrations (2.17, 4.26, 6.25 mol%; 30 Li, 15 Be, 62-66 F, 1-3 Eu atoms), 10,000 NPT steps followed by 10,000 NVT steps with a 1 fs time step; all trajectory frames are used without filtering." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
