###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-jiang2026 mlips:hasResult
    entity:result-dp-FLiBeEu-jiang2026 .

entity:result-dp-FLiBeEu-jiang2026 a mlips:BenchmarkResult ;
