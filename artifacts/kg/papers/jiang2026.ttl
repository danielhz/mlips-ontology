    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-training-steps-jiang2026 a mlips:Hyperparameter ;
    rdfs:label "Number of training steps" ;
    mlips:hyperparameterName "training_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-sel-jiang2026 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential maximum number of neighbours per atom type" ;
    mlips:hyperparameterName "sel" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-FLiBeEu-cutoffRadius-jiang2026 a mlips:HyperparameterSetting ;
