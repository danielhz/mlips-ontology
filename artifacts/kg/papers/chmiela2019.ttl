# Canonical Turtle for the protocol-derived encoding of:
#   Stefan Chmiela et al. (2019). sGDML: Constructing accurate and data efficient molecular force fields using machine learning.
#   Computer Physics Communications. doi:10.1016/j.cpc.2019.02.007  arXiv:1812.04986v3
#
# Version read: arxiv-preprint arXiv:1812.04986v3 (sha256 6178e9f05e8c623b...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 53 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the sGDML software paper. The ten molecular sGDML
# models of Table I (1000 reference geometries each) are encoded with
# their reported training times and prediction speeds; the paracetamol
# walk-through at the PBE0+MBD level is described in the gaps.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-chmiela2019 a mlips:BenchmarkStudy ;
    rdfs:label "Chmiela et al. (2019): sGDML software for accurate and data-efficient molecular force fields" ;
    mlips:reportedIn entity:article-chmiela2019 .

entity:article-chmiela2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.cpc.2019.02.007> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "sGDML: Constructing accurate and data efficient molecular force fields using machine learning" ;
    schema:author entity:person-Chmiela-chmiela2019 ,
        <https://orcid.org/0000-0001-6091-3408> ,
        entity:person-Poltavsky-chmiela2019 ,
        entity:person-Muller-chmiela2019 ,
        entity:person-Tkatchenko-chmiela2019 .

entity:person-Chmiela-chmiela2019 a schema:Person ;
    schema:name "Stefan Chmiela" ;
    schema:givenName "Stefan" ;
    schema:familyName "Chmiela" .

<https://orcid.org/0000-0001-6091-3408> a schema:Person ;
    schema:name "Huziel E. Sauceda" ;
    schema:givenName "Huziel E." ;
    schema:familyName "Sauceda" ;
    schema:identifier <https://orcid.org/0000-0001-6091-3408> .

entity:person-Poltavsky-chmiela2019 a schema:Person ;
    schema:name "Igor Poltavsky" ;
    schema:givenName "Igor" ;
    schema:familyName "Poltavsky" .

entity:person-Muller-chmiela2019 a schema:Person ;
    schema:name "Klaus-Robert Müller" ;
    schema:givenName "Klaus-Robert" ;
    schema:familyName "Müller" .

entity:person-Tkatchenko-chmiela2019 a schema:Person ;
    schema:name "Alexandre Tkatchenko" ;
    schema:givenName "Alexandre" ;
    schema:familyName "Tkatchenko" .

