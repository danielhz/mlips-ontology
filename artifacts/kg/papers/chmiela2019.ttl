###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-benzene-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-uracil-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-naphthalene-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-aspirin-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-salicylic-acid-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-malonaldehyde-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-ethanol-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-toluene-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-paracetamol-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:ds-azobenzene-chmiela2019 mlips:samplingStrategy
    entity:sampling-md-subset-chmiela2019 .

entity:sampling-md-subset-chmiela2019 a mlips:SamplingStrategy ;
    rdfs:label "Subset of an MD trajectory (1000 reference geometries)" ;
    rdfs:comment "Training and validation points are sampled from the bulk data set by the sgdml create command; for the paracetamol example the subset follows the Maxwell-Boltzmann energy distribution of a 500 K DFT-PBE+TS trajectory." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:sGDML a mlips:MLIPMethod ;
    rdfs:label "Symmetric Gradient-Domain Machine Learning (sGDML)" ;
    mlips:hasTrainingAlgorithm entity:alg-sGDML-chmiela2019 ;
    mlips:hasImplementation entity:impl-sGDML-chmiela2019 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-sGDML-chmiela2019 a mls:Algorithm ;
    rdfs:label "Kernel ridge regression in the gradient domain with permutational symmetries recovered from the data; analytic solver; kernel length scale sigma selected over a list or range by validation" .

entity:impl-sGDML-chmiela2019 a mlips:Implementation ;
    mlips:implementedIn entity:lib-sGDML-chmiela2019 .

entity:lib-sGDML-chmiela2019 a mlips:Library ;
    rdfs:label "sGDML" ;
    rdfs:comment "The sgdml Python package (command-line interface: create, train, validate, select, test; ASE and i-PI interfaces)." ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

