# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-sgdml-benzene-chmiela2019 a mlips:MLIPRun ;
    rdfs:label "sGDML model for benzene trained on 1000 reference geometries" ;
    mlips:appliesMethod entity:sGDML ;
    mlips:runsOn entity:ds-benzene-chmiela2019 ;
    mlips:trainingHardware "Intel Xeon E5-2640 CPU at 2.40 GHz, analytic solver: 1.9 minutes" ;
    mlips:produces entity:model-sgdml-benzene-chmiela2019 .

entity:model-sgdml-benzene-chmiela2019 a mlips:TrainedModel ;
    rdfs:label "sGDML model for benzene (1000 training points)" ;
    mlips:inferenceHardware "2.8 GHz Intel Core i7 notebook: 434.7 geometries per second (sequential force and energy evaluations)" .

