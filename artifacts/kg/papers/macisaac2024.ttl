@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-macisaac2024 a mlips:BenchmarkStudy ;
    rdfs:label "MacIsaac et al. (2024): a UF3 potential for the Si-C system trained on genetic-algorithm structures" ;
    mlips:reportedIn entity:article-macisaac2024 .

entity:article-macisaac2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpcc.4c02205> ;
