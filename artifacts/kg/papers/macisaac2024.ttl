###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sic-macisaac2024 a mlips:MaterialSystem ;
    rdfs:label "Si-C system: SiC polytypes (3C, 2H, 4H, 6H, 15R and others), non-equimolar Si-C structures, Si and C" ;
    mlips:materialClass "Covalent ceramic and elemental solids" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-macisaac2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-macisaac2024 mlips:hasDFTSettings entity:calc-settings-pbe-macisaac2024 .

entity:calc-settings-pbe-macisaac2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred automatic mesh, length 30" ;
    rdfs:comment "Electronic convergence 1e-6 eV, ionic 1e-5 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-sic-macisaac2024 a mlips:TrainingDataset ;
    rdfs:label "Si-C training data (41,225 structures: 41,145 from GASP, 80 from AIMD; trajectories assigned wholly to training or testing)" ;
    mlips:coversMaterial entity:mat-sic-macisaac2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 41225 ;
    mlips:hasDFTCalculation entity:calc-pbe-macisaac2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-sic-macisaac2024 mlips:samplingStrategy
    entity:sampling-gasp-macisaac2024 ,
    entity:sampling-aimd-macisaac2024 .

entity:sampling-gasp-macisaac2024 a mlips:SamplingStrategy ;
    rdfs:label "GASP genetic-algorithm structure searches over the whole Si-C composition space (relaxation trajectories and unrelaxed structures)" .

entity:sampling-aimd-macisaac2024 a mlips:SamplingStrategy ;
    rdfs:label "AIMD of SiC-3C (zinc blende and rock salt), SiC-2H and SiC-6H" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:UF3 a mlips:MLIPMethod ;
    rdfs:label "UF3 (ultra-fast force fields: two- and three-body cubic B-spline potentials fitted by regularised linear regression)" ;
    mlips:hasLossFunction entity:loss-UF3-macisaac2024 ;
    mlips:hasTrainingAlgorithm entity:alg-UF3-macisaac2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-UF3-macisaac2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-UF3-macisaac2024 a mlips:LossFunction ;
    rdfs:label "Energy- and force-weighted least squares with Tikhonov ridge and curvature regularisers" .

entity:alg-UF3-macisaac2024 a mls:Algorithm ;
    rdfs:label "Custom knot placement concentrated around the C-Si energy well (introduced here, now in UF3); grid search over regularisers and energy weight" .

entity:impl-UF3-macisaac2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-uf3-macisaac2024 .

entity:lib-uf3-macisaac2024 a mlips:Library ;
    rdfs:label "uf3" ;
    rdfs:comment "LAMMPS for property simulations" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-uf3-sic-cutoffRadius-macisaac2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-uf3-sic-angularCutoff-macisaac2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-uf3-sic-macisaac2024 a mlips:MLIPRun ;
    rdfs:label "Final UF3 Si-C potential (custom knots)" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-sic-macisaac2024 ;
    mlips:hasHyperparameterSetting entity:setting-uf3-sic-cutoffRadius-macisaac2024 ,
        entity:setting-uf3-sic-angularCutoff-macisaac2024 ;
    mlips:produces entity:model-uf3-sic-macisaac2024 .

entity:model-uf3-sic-macisaac2024 a mlips:TrainedModel ;
    rdfs:label "UF3 Si-C MLIP" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-macisaac2024 mlips:hasResult
    entity:result-uf3-sic-macisaac2024 .

entity:result-uf3-sic-macisaac2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-uf3-sic-macisaac2024 ;
    mlips:targetMaterial entity:mat-sic-macisaac2024 ;
    mlips:hasAccuracyMetric entity:metric-uf3-sic-1-macisaac2024 ,
        entity:metric-uf3-sic-2-macisaac2024 .

entity:metric-uf3-sic-1-macisaac2024 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE: UF3 Si-C MLIP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "145"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-uf3-sic-2-macisaac2024 a mlips:AccuracyMetric ;
    rdfs:label "Force RMSE: UF3 Si-C MLIP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "332"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

