    mlips:coversMaterial entity:mat-water-zhang2024modelling ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe0-zhang2024modelling .

entity:ds-da-water-zhang2024modelling a mlips:TrainingDataset ;
    rdfs:label "Endo/exo Diels-Alder training data in explicit water (about 600 points for the endo model)" ;
    mlips:coversMaterial entity:mat-da-water-zhang2024modelling ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97m-zhang2024modelling .

entity:ds-da-meoh-zhang2024modelling a mlips:TrainingDataset ;
