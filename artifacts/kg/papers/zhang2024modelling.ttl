# Canonical Turtle for the protocol-derived encoding of:
#   Hanwen Zhang et al. (2024). Modelling chemical processes in explicit solvents with machine learning potentials.
#   Nature Communications. doi:10.1038/s41467-024-50418-6
#
# Version read: publisher (sha256 570470730e47dec9...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 681 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/zhang2024modelling.yaml.
#
# Encoding scope: the linear ACE potentials (ACE.jl via mlp-train) trained
# with active learning: water models comparing energy-, similarity- and
# distance-based selectors (PBE0-D3BJ), and the models for the endo and exo
# Diels-Alder reaction of cyclopentadiene with methyl vinyl ketone in
# explicit water, explicit methanol and implicit solvent (wB97M-D3BJ).
# Errors are stated only as bounds or as unnamed single values, so there
# are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhang2024modelling a mlips:BenchmarkStudy ;
    rdfs:label "Zhang, Juraskova and Duarte (2024): modelling chemical processes in explicit solvents with ACE potentials and active learning" ;
    mlips:reportedIn entity:article-zhang2024modelling .

entity:article-zhang2024modelling a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41467-024-50418-6> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Modelling chemical processes in explicit solvents with machine learning potentials" ;
    schema:author <https://orcid.org/0000-0002-6326-9774> ,
        <https://orcid.org/0000-0002-6293-5616> ,
        <https://orcid.org/0000-0002-6062-8209> .

<https://orcid.org/0000-0002-6326-9774> a schema:Person ;
    schema:name "Hanwen Zhang" ;
    schema:givenName "Hanwen" ;
    schema:familyName "Zhang" ;
    schema:identifier <https://orcid.org/0000-0002-6326-9774> .

<https://orcid.org/0000-0002-6293-5616> a schema:Person ;
    schema:name "Veronika Juraskova" ;
    schema:givenName "Veronika" ;
    schema:familyName "Juraskova" ;
    schema:identifier <https://orcid.org/0000-0002-6293-5616> .

<https://orcid.org/0000-0002-6062-8209> a schema:Person ;
