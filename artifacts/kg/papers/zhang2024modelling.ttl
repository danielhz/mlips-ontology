entity:ds-da-implicit-zhang2024modelling a mlips:TrainingDataset ;
    rdfs:label "Endo/exo Diels-Alder training data in implicit solvent" ;
    mlips:coversMaterial entity:mat-da-implicit-zhang2024modelling ;
    mlips:coversProperty mlips:Energy ,
