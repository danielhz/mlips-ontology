    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97m-zhang2024modelling .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-water-zhang2024modelling mlips:samplingStrategy
    entity:sampling-al-zhang2024modelling .

entity:ds-da-water-zhang2024modelling mlips:samplingStrategy
    entity:sampling-al-subsets-zhang2024modelling .

entity:ds-da-meoh-zhang2024modelling mlips:samplingStrategy
    entity:sampling-al-subsets-zhang2024modelling .

entity:ds-da-implicit-zhang2024modelling mlips:samplingStrategy
    entity:sampling-al-zhang2024modelling .

entity:sampling-al-zhang2024modelling a mlips:SamplingStrategy ;
    rdfs:label "mlp-train active learning (MD up to 5 ps) with energy-, SOAP-similarity- or distance-based selectors" .

entity:sampling-al-subsets-zhang2024modelling a mlips:SamplingStrategy ;
    rdfs:label "Active learning over four subsets: substrate complex, substrate with 2 and with 33 solvent molecules, and pure solvent" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-zhang2024modelling ;
    mlips:hasImplementation entity:impl-ACE-zhang2024modelling ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:alg-ACE-zhang2024modelling a mls:Algorithm ;
    rdfs:label "Linear ACE; hyperparameters in SI Sec. S2" .

entity:impl-ACE-zhang2024modelling a mlips:Implementation ;
    mlips:implementedIn entity:lib-ACE_jl-zhang2024modelling .

entity:lib-ACE_jl-zhang2024modelling a mlips:Library ;
    rdfs:label "ACE.jl" ;
    mlips:candidateForVocabulary mlips:Library .

