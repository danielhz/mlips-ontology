###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-zhang2024modelling a mlips:MaterialSystem ;
    rdfs:label "Liquid water (27-molecule clusters and 216-molecule periodic boxes)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid" .

entity:mat-da-water-zhang2024modelling a mlips:MaterialSystem ;
    rdfs:label "Cyclopentadiene + methyl vinyl ketone Diels-Alder reaction in explicit water" ;
    mlips:materialClass "organic reaction in solution" .

entity:mat-da-meoh-zhang2024modelling a mlips:MaterialSystem ;
    rdfs:label "Cyclopentadiene + methyl vinyl ketone Diels-Alder reaction in explicit methanol" ;
    mlips:materialClass "organic reaction in solution" .

entity:mat-da-implicit-zhang2024modelling a mlips:MaterialSystem ;
    rdfs:label "Cyclopentadiene + methyl vinyl ketone Diels-Alder reaction in implicit solvent" ;
    mlips:materialClass "organic reaction (implicit solvent)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe0-zhang2024modelling a mlips:DFTCalculation .

entity:calc-wb97m-zhang2024modelling a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe0-zhang2024modelling mlips:hasDFTSettings entity:calc-settings-pbe0-zhang2024modelling .

entity:calc-settings-pbe0-zhang2024modelling a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-PBE0-D3BJ-zhang2024modelling ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "ORCA 4.2.1 via autodE; water systems." .

entity:calc-wb97m-zhang2024modelling mlips:hasDFTSettings entity:calc-settings-wb97m-zhang2024modelling .

entity:calc-settings-wb97m-zhang2024modelling a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-wB97M-D3BJ-zhang2024modelling ;
    mlips:basisSet "def2-TZVP" ;
    rdfs:comment "Diels-Alder systems." .

entity:xc-PBE0-D3BJ-zhang2024modelling a mlips:XCFunctional ;
    rdfs:label "PBE0-D3BJ" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-wB97M-D3BJ-zhang2024modelling a mlips:XCFunctional ;
    rdfs:label "wB97M-D3BJ" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

