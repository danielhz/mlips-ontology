# Canonical Turtle for the protocol-derived encoding of:
#   Vlad Cărare et al. (2025). Global properties of the energy landscape: a testing and training arena for machine learned potentials.
#   npj Computational Materials. doi:10.1038/s41524-025-01878-x
#
# Version read: publisher (sha256 96448317e5c3a774...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 286 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/carare2025.yaml.
#
# Encoding scope: the Landscape17 data set introduced here (wB97X/6-31G(d)
# minima, transition states and approximate steepest-descent pathways of
# six rMD17 molecules), NequIP, MACE and Allegro models trained per molecule
# on rMD17 only (N-L) or on rMD17 plus 40% of the Landscape17 pathways (L),
# and the pretrained ANI2x, AIMNet2, MACE-MP-0b3 (medium) and SO3LR used to
# construct MLIP energy landscapes. All errors are given in figures or in
# Supplementary Tables S2-S5 that are not part of the PDF, so no metric is
# encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-carare2025 a mlips:BenchmarkStudy ;
    rdfs:label "Cărare et al. (2025): Landscape17, kinetic transition networks of rMD17 molecules as a test and training arena for MLIPs" ;
    mlips:reportedIn entity:article-carare2025 .

entity:article-carare2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01878-x> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Global properties of the energy landscape: a testing and training arena for machine learned potentials" ;
    schema:author entity:person-Carare-carare2025 ,
        entity:person-Thiemann-carare2025 ,
        entity:person-Morrow-carare2025 ,
        entity:person-Wales-carare2025 ,
        entity:person-PyzerKnapp-carare2025 ,
        entity:person-Dicks-carare2025 .

entity:person-Carare-carare2025 a schema:Person ;
    schema:name "Vlad Cărare" ;
    schema:givenName "Vlad" ;
    schema:familyName "Cărare" .

entity:person-Thiemann-carare2025 a schema:Person ;
    schema:name "Fabian L. Thiemann" ;
    schema:givenName "Fabian L." ;
    schema:familyName "Thiemann" .

entity:person-Morrow-carare2025 a schema:Person ;
    schema:name "Joe D. Morrow" ;
    schema:givenName "Joe D." ;
    schema:familyName "Morrow" .

entity:person-Wales-carare2025 a schema:Person ;
    schema:name "David J. Wales" ;
    schema:givenName "David J." ;
    schema:familyName "Wales" .

entity:person-PyzerKnapp-carare2025 a schema:Person ;
    schema:name "Edward O. Pyzer-Knapp" ;
    schema:givenName "Edward O." ;
    schema:familyName "Pyzer-Knapp" .

entity:person-Dicks-carare2025 a schema:Person ;
    schema:name "Luke Dicks" ;
    schema:givenName "Luke" ;
    schema:familyName "Dicks" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-rmd17-mols-carare2025 a mlips:MaterialSystem ;
    rdfs:label "Ethanol, malonaldehyde, salicylic acid, azobenzene, paracetamol and aspirin (rMD17 molecules with several minima)" ;
    mlips:materialClass "Small organic molecules (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97x-carare2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97x-carare2025 mlips:hasDFTSettings entity:calc-settings-wb97x-carare2025 .

entity:calc-settings-wb97x-carare2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Psi4-carare2025 ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "Restricted Kohn-Sham, energy and density convergence 1e-9, (100, 770) integration grid; basin hopping, TopSearch/OPTIM transition-state searches." .

entity:lib-Psi4-carare2025 a mlips:Library ;
    rdfs:label "Psi4" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-landscape17-carare2025 a mlips:TrainingDataset ;
    rdfs:label "Landscape17: 28 minima, 67 transition states and pathway configurations of six rMD17 molecules with energies, forces and Hessian eigenspectra" ;
    mlips:coversMaterial entity:mat-rmd17-mols-carare2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97x-carare2025 ;
    rdfs:comment "Estimated cost above 1e5 CPU hours; publicly available (Ref. [80])." .

entity:ds-rmd17-train-carare2025 a mlips:TrainingDataset ;
    rdfs:label "rMD17 training split (950/50 split as in the original papers) for the six molecules" ;
    mlips:coversMaterial entity:mat-rmd17-mols-carare2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-rmd17-l-carare2025 a mlips:TrainingDataset ;
    rdfs:label "rMD17 training split plus 40% of the Landscape17 pathway configurations (up to 500 structures per molecule)" ;
    mlips:coversMaterial entity:mat-rmd17-mols-carare2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-wb97x-carare2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-landscape17-carare2025 mlips:samplingStrategy
    entity:sampling-dps-carare2025 .

entity:sampling-dps-carare2025 a mlips:SamplingStrategy ;
    rdfs:label "Basin-hopping global optimisation and single- and double-ended transition-state searches (discrete path sampling), with approximate steepest-descent paths from each transition state" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:AIMNet2 a mlips:MLIPMethod ;
    rdfs:label "AIMNet2 (atoms-in-molecules neural network potential with learned charges and explicit long-range terms)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:SO3LR a mlips:MLIPMethod ;
    rdfs:label "SO3LR (So3krates-based molecular force field with long-range terms)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nequip-nl-carare2025 a mlips:MLIPRun ;
    rdfs:label "NequIP trained per molecule on rMD17 (non-landscape, N-L)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-rmd17-train-carare2025 ;
    mlips:produces entity:model-nequip-nl-carare2025 .

entity:model-nequip-nl-carare2025 a mlips:TrainedModel ;
    rdfs:label "NequIP N-L models (one per molecule)" .

entity:run-nequip-l-carare2025 a mlips:MLIPRun ;
    rdfs:label "NequIP trained per molecule on rMD17 plus Landscape17 pathways (L)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-rmd17-l-carare2025 ;
    mlips:produces entity:model-nequip-l-carare2025 .

entity:model-nequip-l-carare2025 a mlips:TrainedModel ;
    rdfs:label "NequIP L models (one per molecule)" .

entity:run-mace-nl-carare2025 a mlips:MLIPRun ;
    rdfs:label "MACE trained per molecule on rMD17 (N-L)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-rmd17-train-carare2025 ;
    mlips:produces entity:model-mace-nl-carare2025 .

entity:model-mace-nl-carare2025 a mlips:TrainedModel ;
    rdfs:label "MACE N-L models (one per molecule)" .

entity:run-mace-l-carare2025 a mlips:MLIPRun ;
    rdfs:label "MACE trained per molecule on rMD17 plus Landscape17 pathways (L)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-rmd17-l-carare2025 ;
    mlips:produces entity:model-mace-l-carare2025 .

entity:model-mace-l-carare2025 a mlips:TrainedModel ;
    rdfs:label "MACE L models (one per molecule)" .

entity:run-allegro-nl-carare2025 a mlips:MLIPRun ;
    rdfs:label "Allegro trained per molecule on rMD17 (N-L)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-rmd17-train-carare2025 ;
    mlips:produces entity:model-allegro-nl-carare2025 .

entity:model-allegro-nl-carare2025 a mlips:TrainedModel ;
    rdfs:label "Allegro N-L models (one per molecule)" .

entity:run-allegro-l-carare2025 a mlips:MLIPRun ;
    rdfs:label "Allegro trained per molecule on rMD17 plus Landscape17 pathways (L)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-rmd17-l-carare2025 ;
    mlips:produces entity:model-allegro-l-carare2025 .

entity:model-allegro-l-carare2025 a mlips:TrainedModel ;
    rdfs:label "Allegro L models (one per molecule)" .

entity:run-aimnet2-carare2025 a mlips:MLIPRun ;
    rdfs:label "AIMNet2 as distributed" ;
    mlips:appliesMethod entity:AIMNet2 ;
    mlips:produces entity:model-aimnet2-carare2025 .

entity:model-aimnet2-carare2025 a mlips:TrainedModel ;
    rdfs:label "AIMNet2" .

entity:run-so3lr-carare2025 a mlips:MLIPRun ;
    rdfs:label "SO3LR as distributed" ;
    mlips:appliesMethod entity:SO3LR ;
    mlips:produces entity:model-so3lr-carare2025 .

entity:model-so3lr-carare2025 a mlips:TrainedModel ;
    rdfs:label "SO3LR" .

# Registry stub for the externally trained model ANI-2x (not trained in this paper).
entity:run-ANI-2x a mlips:MLIPRun ;
    rdfs:label "Training run of ANI-2x general-purpose neural network potential" ;
    mlips:appliesMethod entity:ANI ;
    mlips:produces entity:model-ANI-2x .

entity:model-ANI-2x a mlips:TrainedModel ;
    rdfs:label "ANI-2x general-purpose neural network potential" .

# entity:model-mace-mp-0-batatia2024mp0 (MACE-MP-0b3-medium) is evaluated here; its run and model are declared in papers/batatia2024mp0.ttl.

