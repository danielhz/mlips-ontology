# Canonical Turtle for the protocol-derived encoding of:
#   Bingqing Cheng et al. (2025). Latent Ewald summation for machine learning of long-range interactions.
#   npj Computational Materials. doi:10.1038/s41524-025-01577-7  arXiv:2408.15165v2
#
# Version read: arxiv-preprint arXiv:2408.15165v2 (sha256 6ab8c09ed43c8d72...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 208 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/cheng2025.yaml.
#
# Encoding scope: the latent Ewald summation combined with CACE (CACE-LES
# in the registry; introduced here) and the short-range CACE models it is
# compared with: the three molecular dimer classes (test RMSEs printed in
# Fig. 1), molten NaCl, bulk liquid water and the water liquid-vapour
# interface. Only the dimer errors are given as numbers in an energy or
# force unit; NaCl errors are percentages (Table I) and the water errors are
# learning curves (Figs. 2, 5, 7), so those models have no result.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-cheng2025 a mlips:BenchmarkStudy ;
    rdfs:label "Cheng (2025): latent Ewald summation (LES) for long-range interactions, combined with CACE (CACE-LES)" ;
    mlips:reportedIn entity:article-cheng2025 .

entity:article-cheng2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01577-7> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Latent Ewald summation for machine learning of long-range interactions" ;
    schema:author entity:person-Cheng-cheng2025 .

entity:person-Cheng-cheng2025 a schema:Person ;
    schema:name "Bingqing Cheng" ;
    schema:givenName "Bingqing" ;
    schema:familyName "Cheng" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-CC-cheng2025 a mlips:MaterialSystem ;
    rdfs:label "Charged-charged molecular dimer (CC) in a periodic 30 A box" ;
    mlips:materialClass "Molecular dimer (BioFragment Database)" .

entity:mat-CP-cheng2025 a mlips:MaterialSystem ;
    rdfs:label "Charged-polar molecular dimer (CP) in a periodic 30 A box" ;
    mlips:materialClass "Molecular dimer (BioFragment Database)" .

entity:mat-PP-cheng2025 a mlips:MaterialSystem ;
    rdfs:label "Polar-polar molecular dimer (PP) in a periodic 30 A box" ;
    mlips:materialClass "Molecular dimer (BioFragment Database)" .

entity:mat-NaCl-cheng2025 a mlips:MaterialSystem ;
    rdfs:label "Molten sodium chloride (64 Na and 64 Cl atoms)" ;
    mlips:chemicalFormula "NaCl" ;
    mlips:materialClass "Molten salt" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q2314> .

entity:mat-water-cheng2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk liquid water" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-interface-cheng2025 a mlips:MaterialSystem ;
    rdfs:label "Liquid-vapour interface of water (slabs of 522 molecules)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Liquid-vapour interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dimer-dft-cheng2025 a mlips:DFTCalculation .

entity:calc-water-dft-cheng2025 a mlips:DFTCalculation .

entity:calc-interface-dft-cheng2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dimer-dft-cheng2025 mlips:hasDFTSettings entity:calc-settings-dimer-dft-cheng2025 .

entity:calc-settings-dimer-dft-cheng2025 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:HSE06 ;
    rdfs:comment "HSE06 hybrid functional with a many-body dispersion correction (data set of Ref. [7], from the BioFragment Database)." .

entity:calc-water-dft-cheng2025 mlips:hasDFTSettings entity:calc-settings-water-dft-cheng2025 .

entity:calc-settings-water-dft-cheng2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-revPBE0-D3-cheng2025 ;
    rdfs:comment "Bulk water data set of Ref. [36]." .

entity:calc-interface-dft-cheng2025 mlips:hasDFTSettings entity:calc-settings-interface-dft-cheng2025 .

entity:calc-settings-interface-dft-cheng2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-revPBE-D3-cheng2025 ;
    rdfs:comment "Liquid-vapour interface data set of Ref. [4]." .

entity:xc-revPBE0-D3-cheng2025 a mlips:XCFunctional ;
    rdfs:label "revPBE0-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-revPBE-D3-cheng2025 a mlips:XCFunctional ;
    rdfs:label "revPBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-CC-cheng2025 a mlips:TrainingDataset ;
    rdfs:label "CC dimer binding-curve training set (10 configurations, separations 5-12 A)" ;
    mlips:coversMaterial entity:mat-CC-cheng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 10 ;
    mlips:hasDFTCalculation entity:calc-dimer-dft-cheng2025 ;
    rdfs:comment "Test set: 3 configurations at separations of about 12 to 15 A." .

entity:ds-CP-cheng2025 a mlips:TrainingDataset ;
    rdfs:label "CP dimer binding-curve training set (10 configurations, separations 5-12 A)" ;
    mlips:coversMaterial entity:mat-CP-cheng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 10 ;
    mlips:hasDFTCalculation entity:calc-dimer-dft-cheng2025 ;
    rdfs:comment "Test set: 3 configurations at separations of about 12 to 15 A." .

entity:ds-PP-cheng2025 a mlips:TrainingDataset ;
    rdfs:label "PP dimer binding-curve training set (10 configurations, separations 5-12 A)" ;
    mlips:coversMaterial entity:mat-PP-cheng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 10 ;
    mlips:hasDFTCalculation entity:calc-dimer-dft-cheng2025 ;
    rdfs:comment "Test set: 3 configurations at separations of about 12 to 15 A." .

entity:ds-NaCl-cheng2025 a mlips:TrainingDataset ;
    rdfs:label "Molten NaCl data set (1,014 structures; 80% training)" ;
    mlips:coversMaterial entity:mat-NaCl-cheng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1014 ;
    rdfs:comment "Data set of Ref. [25]; 80% training, 20% validation." .

entity:ds-water-cheng2025 a mlips:TrainingDataset ;
    rdfs:label "Bulk liquid water data set (1,593 configurations of 64 molecules)" ;
    mlips:coversMaterial entity:mat-water-cheng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1593 ;
    mlips:hasDFTCalculation entity:calc-water-dft-cheng2025 .

entity:ds-interface-cheng2025 a mlips:TrainingDataset ;
    rdfs:label "Water liquid-vapour interface subset (500 configurations of 522 molecules)" ;
    mlips:coversMaterial entity:mat-interface-cheng2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 500 ;
    mlips:hasDFTCalculation entity:calc-interface-dft-cheng2025 ;
    rdfs:comment "Subset of the data set of Ref. [4]; three random 90/10 splits." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CACE a mlips:MLIPMethod ;
    rdfs:label "Cartesian Atomic Cluster Expansion (CACE)" ;
    mlips:hasFunctionalForm entity:ff-CACE ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        entity:hp-radial-channels-cheng2025 ,
        mlips:numAngularBasis ,
        mlips:bodyOrder ,
        entity:hp-n-embedding-cheng2025 ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-CACE-cheng2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-CACE a mlips:FunctionalForm ;
    rdfs:label "Body-ordered atomic cluster expansion whose rotationally invariant features are built by symmetrising Cartesian angular basis functions, with optional message passing between atoms; atomic energies are summed to the total energy" .

entity:impl-CACE-cheng2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-cace-cheng2025 .

entity:CACE-LES a mlips:MLIPMethod ;
    rdfs:label "CACE with latent Ewald summation (CACE-LES)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        entity:hp-radial-channels-cheng2025 ,
        mlips:numAngularBasis ,
        mlips:bodyOrder ,
        entity:hp-n-embedding-cheng2025 ,
        mlips:numLayers ,
        entity:hp-q-dim-cheng2025 ,
        entity:hp-les-sigma-cheng2025 ,
        entity:hp-les-kc-cheng2025 ;
    mlips:hasImplementation entity:impl-CACE-LES-cheng2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-CACE-LES-cheng2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-cace-cheng2025 .

entity:lib-cace-cheng2025 a mlips:Library ;
    rdfs:label "cace" ;
    rdfs:comment "PyTorch, https://github.com/BingqingCheng/cace; MD through ASE" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-radial-channels-cheng2025 a mlips:Hyperparameter ;
    rdfs:label "CACE number of radial channels c" ;
    mlips:hyperparameterName "c" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-n-embedding-cheng2025 a mlips:Hyperparameter ;
    rdfs:label "CACE dimension of the element embedding N_embedding" ;
    mlips:hyperparameterName "N_embedding" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-q-dim-cheng2025 a mlips:Hyperparameter ;
    rdfs:label "LES dimension of the latent variable q" ;
    mlips:hyperparameterName "dim(q)" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-les-sigma-cheng2025 a mlips:Hyperparameter ;
    rdfs:label "LES Ewald smearing factor sigma (A)" ;
    mlips:hyperparameterName "sigma" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-les-kc-cheng2025 a mlips:Hyperparameter ;
    rdfs:label "LES reciprocal-space cutoff k_c" ;
    mlips:hyperparameterName "k_c" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

