# Canonical Turtle for the protocol-derived encoding of:
#   Emil Jonathan Annevelink et al. (2023). Statistical methods for resolving poor uncertainty quantification in machine learning interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2308.15653  arXiv:2308.15653v1
#
# Version read: arxiv-preprint arXiv:2308.15653v1 (sha256 58d582baa2a0c9ef...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 608 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/annevelink2023.yaml.
#
# Encoding scope: the study record and its Li and Li-Mg DFT benchmark data
# sets. The paper fits Maxwell distributions to force-error magnitudes and
# derives statistical error and uncertainty cutoffs for ensemble, sparse
# GP and latent-distance UQ in a simulated active-learning workflow, but
# it does not name the MLIP architecture it trains and states no error
# values in the text, so no run or result is encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-annevelink2023 a mlips:BenchmarkStudy ;
    rdfs:label "Annevelink and Viswanathan (2023): statistical cutoffs for uncertainty quantification in MLIP active learning" ;
    mlips:reportedIn entity:article-annevelink2023 .

entity:article-annevelink2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2308.15653> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Statistical methods for resolving poor uncertainty quantification in machine learning interatomic potentials" ;
    schema:author entity:person-Annevelink-annevelink2023 ,
        entity:person-Viswanathan-annevelink2023 .

entity:person-Annevelink-annevelink2023 a schema:Person ;
    schema:name "Emil Annevelink" ;
    schema:givenName "Emil" ;
    schema:familyName "Annevelink" .

entity:person-Viswanathan-annevelink2023 a schema:Person ;
    schema:name "Venkatasubramanian Viswanathan" ;
    schema:givenName "Venkatasubramanian" ;
    schema:familyName "Viswanathan" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-li-annevelink2023 a mlips:MaterialSystem ;
    rdfs:label "Liquid lithium at 600 K" ;
    mlips:chemicalFormula "Li" ;
    mlips:materialClass "alkali metal" .

entity:mat-limg-annevelink2023 a mlips:MaterialSystem ;
    rdfs:label "Li-Mg system (Li, Li3Mg, LiMg, LiMg3, Mg; BCC and HCP, solid and liquid, three vacancies per cell) at 600 K" ;
    mlips:materialClass "binary light-metal alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-gpaw-annevelink2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-gpaw-annevelink2023 mlips:hasDFTSettings entity:calc-settings-gpaw-annevelink2023 .

entity:calc-settings-gpaw-annevelink2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-GPAW-annevelink2023 ;
    mlips:kPointMesh "k-point density 30" ;
    rdfs:comment "Methfessel-Paxton occupation width 0.05, grid spacing h = 0.18; functional not stated." .

entity:lib-GPAW-annevelink2023 a mlips:Library ;
    rdfs:label "GPAW" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-li-annevelink2023 a mlips:TrainingDataset ;
    rdfs:label "Lithium benchmark (SI datasets 1-3; 250-atom cells)" ;
    mlips:coversMaterial entity:mat-li-annevelink2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-gpaw-annevelink2023 .

entity:ds-limg-annevelink2023 a mlips:TrainingDataset ;
    rdfs:label "Li-Mg benchmark (SI datasets 4-13; 61-125-atom cells)" ;
    mlips:coversMaterial entity:mat-limg-annevelink2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-gpaw-annevelink2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-li-annevelink2023 mlips:samplingStrategy
    entity:sampling-classical-md-annevelink2023 .

entity:ds-limg-annevelink2023 mlips:samplingStrategy
    entity:sampling-classical-md-annevelink2023 .

entity:sampling-classical-md-annevelink2023 a mlips:SamplingStrategy ;
    rdfs:label "NVT/NPT MD with the classical Li-Mg potential of Kim, Jung and Lee (SI Ref. 1), 1 ps and 10 ns runs, relabelled with DFT" .

