    schema:givenName "Silvana" ;
    schema:familyName "Botti" ;
    schema:identifier <https://orcid.org/0000-0002-4920-2370> .

<https://orcid.org/0000-0003-0170-8222> a schema:Person ;
    schema:name "Miguel A. L. Marques" ;
    schema:givenName "Miguel A. L." ;
    schema:familyName "Marques" ;
    schema:identifier <https://orcid.org/0000-0003-0170-8222> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mdr-semiconductors-loew2025 a mlips:MaterialSystem ;
    rdfs:label "About 10,000 non-magnetic semiconductors of the MDR phonon database" ;
    mlips:materialClass "Inorganic crystalline semiconductors, mostly ternary and quaternary compounds (many oxides); no triclinic systems" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-loew2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-loew2025 mlips:hasDFTSettings entity:calc-settings-dft-loew2025 .

entity:calc-settings-dft-loew2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "The MDR data set recomputed with PBE instead of PBEsol, all other parameters as in MDR; pre-relaxation to 1e-7 eV/cell and 1e-5 eV/A, stringent relaxation to 1e-8 eV/cell and 1e-8 eV/A; force constants by finite displacements with phonopy. This is the benchmark reference, not training data." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

# entity:model-m3gnet-chen2022 (M3GNet-MPF-2021.2.8) is evaluated here; its run and model are declared in papers/chen2022.ttl.

# Registry stub for the externally trained model CHGNet-0.3.0 (not trained in this paper).
entity:run-CHGNet-0_3_0 a mlips:MLIPRun ;
    rdfs:label "Training run of CHGNet v0.3.0 pretrained universal MLIP (412.5K parameters, trained on MPtrj)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-CHGNet-0_3_0 .

entity:model-CHGNet-0_3_0 a mlips:TrainedModel ;
    rdfs:label "CHGNet v0.3.0 pretrained universal MLIP (412.5K parameters, trained on MPtrj)" .

# Registry stub for the externally trained model MACE-MP-0-2023.12.03 (not trained in this paper).
entity:run-MACE-MP-0-2023_12_03 a mlips:MLIPRun ;
    rdfs:label "Training run of MACE-MP-0 release 2023.12.03 (4.69M parameters, trained on MPtrj)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-MACE-MP-0-2023_12_03 .

entity:model-MACE-MP-0-2023_12_03 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0 release 2023.12.03 (4.69M parameters, trained on MPtrj)" .

# Registry stub for the externally trained model SevenNet-0 (not trained in this paper).
entity:run-SevenNet-0 a mlips:MLIPRun ;
    rdfs:label "Training run of SevenNet-0 (842k parameters, trained on MPtrj)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-SevenNet-0 .

entity:model-SevenNet-0 a mlips:TrainedModel ;
    rdfs:label "SevenNet-0 (842k parameters, trained on MPtrj)" .

# Registry stub for the externally trained model MatterSim-v1 (not trained in this paper).
entity:run-MatterSim-v1 a mlips:MLIPRun ;
    rdfs:label "Training run of MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-MatterSim-v1 .

entity:model-MatterSim-v1 a mlips:TrainedModel ;
    rdfs:label "MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" .

# Registry stub for the externally trained model ORB-MPtrj (not trained in this paper).
entity:run-ORB-MPtrj a mlips:MLIPRun ;
    rdfs:label "Training run of ORB trained on MPtrj (25.2M parameters)" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-ORB-MPtrj .

entity:model-ORB-MPtrj a mlips:TrainedModel ;
    rdfs:label "ORB trained on MPtrj (25.2M parameters)" .

# Registry stub for the externally trained model eqV2-M (not trained in this paper).
entity:run-eqV2-M a mlips:MLIPRun ;
    rdfs:label "Training run of eqV2-M (86M parameters, trained on MPtrj, Alexandria and OMat)" ;
    mlips:appliesMethod entity:EquiformerV2 ;
    mlips:produces entity:model-eqV2-M .

entity:model-eqV2-M a mlips:TrainedModel ;
    rdfs:label "eqV2-M (86M parameters, trained on MPtrj, Alexandria and OMat)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-loew2025 mlips:hasResult
    entity:result-m3gnet-loew2025 ,
    entity:result-chgnet-loew2025 ,
    entity:result-mace-mp-0-loew2025 ,
    entity:result-sevennet-0-loew2025 ,
    entity:result-mattersim-v1-loew2025 ,
    entity:result-orb-loew2025 ,
    entity:result-eqv2-m-loew2025 .

entity:result-m3gnet-loew2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-m3gnet-chen2022 ;
    mlips:targetMaterial entity:mat-mdr-semiconductors-loew2025 ;
    mlips:hasAccuracyMetric entity:metric-m3gnet-1-loew2025 .

entity:metric-m3gnet-1-loew2025 a mlips:AccuracyMetric ;
    rdfs:label "MAE on the energy of the converged relaxation with respect to PBE: M3GNet (Table I)" ;
