# Canonical Turtle for the protocol-derived encoding of:
#   Antoine Loew et al. (2025). Universal machine learning interatomic potentials are ready for phonons.
#   npj Computational Materials. doi:10.1038/s41524-025-01650-1  arXiv:2412.16551v2
#
# Version read: arxiv-preprint arXiv:2412.16551v2 (sha256 5521f56fc8807daa...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 62 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: a benchmark of seven pretrained universal MLIPs
# (M3GNet, CHGNet, MACE-MP-0, SevenNet-0, MatterSim-v1, ORB, eqV2-M; none
# trained here) on geometry relaxation and phonons of the MDR data set
# recomputed with PBE. Only the energy MAE after relaxation (Table I) is
# expressible as a metric.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-loew2025 a mlips:BenchmarkStudy ;
    rdfs:label "Loew et al. (2025): universal MLIPs benchmarked on phonons of about 10,000 semiconductors" ;
    mlips:reportedIn entity:article-loew2025 .

entity:article-loew2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01650-1> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Universal machine learning interatomic potentials are ready for phonons" ;
    schema:author <https://orcid.org/0009-0008-5018-4895> ,
        <https://orcid.org/0009-0003-3487-5593> ,
        <https://orcid.org/0000-0002-2892-5879> ,
        <https://orcid.org/0000-0002-4920-2370> ,
        <https://orcid.org/0000-0003-0170-8222> .

<https://orcid.org/0009-0008-5018-4895> a schema:Person ;
    schema:name "Antoine Loew" ;
    schema:givenName "Antoine" ;
    schema:familyName "Loew" ;
    schema:identifier <https://orcid.org/0009-0008-5018-4895> .

<https://orcid.org/0009-0003-3487-5593> a schema:Person ;
    schema:name "Dewen Sun" ;
    schema:givenName "Dewen" ;
    schema:familyName "Sun" ;
    schema:identifier <https://orcid.org/0009-0003-3487-5593> .

<https://orcid.org/0000-0002-2892-5879> a schema:Person ;
    schema:name "Hai-Chen Wang" ;
    schema:givenName "Hai-Chen" ;
    schema:familyName "Wang" ;
