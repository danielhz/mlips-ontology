@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zguns2025 a mlips:BenchmarkStudy ;
    rdfs:label "Žguns, Pudza and Kuzmin (2025): benchmarking and fine-tuning CHGNet for 2Hc-WS2 against PBE-D3 and EXAFS" ;
    mlips:reportedIn entity:article-zguns2025 .

entity:article-zguns2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.5c00955> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Benchmarking CHGNet Universal Machine Learning Interatomic Potential against DFT and EXAFS: The Case of Layered WS2 and MoS2" ;
    schema:author <https://orcid.org/0000-0002-3387-2919> ,
        <https://orcid.org/0000-0002-8692-3089> ,
        <https://orcid.org/0000-0003-4641-6354> .

<https://orcid.org/0000-0002-3387-2919> a schema:Person ;
    schema:name "Pjotrs Žguns" ;
    schema:givenName "Pjotrs" ;
    schema:familyName "Žguns" ;
    schema:identifier <https://orcid.org/0000-0002-3387-2919> .

<https://orcid.org/0000-0002-8692-3089> a schema:Person ;
    schema:name "Inga Pudza" ;
    schema:givenName "Inga" ;
    schema:familyName "Pudza" ;
    schema:identifier <https://orcid.org/0000-0002-8692-3089> .

<https://orcid.org/0000-0003-4641-6354> a schema:Person ;
