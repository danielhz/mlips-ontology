###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-WS2-zguns2025 a mlips:MaterialSystem ;
    rdfs:label "Layered 2Hc-WS2 (54-atom 3a x 3a x c supercells)" ;
    mlips:chemicalFormula "WS2" ;
    mlips:materialClass "Layered transition-metal dichalcogenide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-zguns2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-zguns2025 mlips:hasDFTSettings entity:calc-settings-pbe-d3-zguns2025 .

entity:calc-settings-pbe-d3-zguns2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "3x3x2 (54-atom supercell)" ;
    rdfs:comment "D3 van der Waals correction; Gamma-centred grids converging the total energy to about 0.05 meV/atom (Sec. 2.1)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ws2-7000-zguns2025 a mlips:TrainingDataset ;
    rdfs:label "WS2 PBE-D3 relaxation snapshots (7,000 frames; 8:1:1 split)" ;
    mlips:coversMaterial entity:mat-WS2-zguns2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 7000 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-zguns2025 .

entity:ds-ws2-350-zguns2025 a mlips:TrainingDataset ;
    rdfs:label "WS2 fine-tuning subset (350 frames)" ;
    mlips:coversMaterial entity:mat-WS2-zguns2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 350 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-zguns2025 .

entity:ds-ws2-70-zguns2025 a mlips:TrainingDataset ;
    rdfs:label "WS2 fine-tuning subset (70 frames)" ;
    mlips:coversMaterial entity:mat-WS2-zguns2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 70 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-zguns2025 .

entity:ds-ws2-1-zguns2025 a mlips:TrainingDataset ;
    rdfs:label "WS2 fine-tuning subset (one frame)" ;
    mlips:coversMaterial entity:mat-WS2-zguns2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-zguns2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ws2-7000-zguns2025 mlips:samplingStrategy
    entity:sampling-strained-relax-zguns2025 .

entity:sampling-strained-relax-zguns2025 a mlips:SamplingStrategy ;
    rdfs:label "Short relaxations from randomly displaced atoms at seven isotropic strains" ;
    rdfs:comment "Strains -1.5% to 1.5% in 0.5% steps; 100 trajectories per strain from 0.2 A random displacements, 10 relaxation steps each (Sec. 2.2)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasLossFunction entity:loss-CHGNet-zguns2025 ;
    mlips:hasTrainingAlgorithm entity:alg-CHGNet-zguns2025 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-CHGNet-zguns2025 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses (CHGNet trainer); most layers frozen" .

entity:alg-CHGNet-zguns2025 a mls:Algorithm ;
    rdfs:label "Adam" .

