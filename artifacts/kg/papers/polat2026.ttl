# Canonical Turtle for the protocol-derived encoding of:
#   Can Polat et al. (2026). CliffordIP: Clifford algebra equivariant interatomic potentials for heterogeneous catalysis.
#   npj Computational Materials. doi:10.1038/s41524-026-02259-8
#
# Version read: publisher (sha256 367362f89047f09d...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 162 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the CliffordIP method (introduced here) and the S2EF
# energy MAEs the text states for CliffordIP and the EquiformerV2 and
# NequIP baselines, all trained by the authors under one protocol on the
# OC20 200K split and on OC22. The full benchmark (twelve baselines,
# IS2RE, OOD splits, rMD17) is in figures and supplementary tables; see
# gaps. Read from the publisher's 'article in press' PDF.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-polat2026 a mlips:BenchmarkStudy ;
    rdfs:label "Polat et al. (2026): CliffordIP, Clifford algebra equivariant interatomic potentials for heterogeneous catalysis" ;
    mlips:reportedIn entity:article-polat2026 .

entity:article-polat2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-02259-8> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "CliffordIP: Clifford algebra equivariant interatomic potentials for heterogeneous catalysis" ;
    schema:author entity:person-Polat-polat2026 ,
        entity:person-Serpedin-polat2026 ,
        entity:person-Kurban-polat2026 ,
        entity:person-KurbanHasan-polat2026 .

entity:person-Polat-polat2026 a schema:Person ;
    schema:name "Can Polat" ;
    schema:givenName "Can" ;
    schema:familyName "Polat" .

entity:person-Serpedin-polat2026 a schema:Person ;
    schema:name "Erchin Serpedin" ;
    schema:givenName "Erchin" ;
    schema:familyName "Serpedin" .

entity:person-Kurban-polat2026 a schema:Person ;
    schema:name "Mustafa Kurban" ;
    schema:givenName "Mustafa" ;
    schema:familyName "Kurban" .

entity:person-KurbanHasan-polat2026 a schema:Person ;
    schema:name "Hasan Kurban" ;
    schema:givenName "Hasan" ;
    schema:familyName "Kurban" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-oc20-polat2026 a mlips:MaterialSystem ;
    rdfs:label "Adsorbate-catalyst structures of Open Catalyst 2020 (metallic surfaces)" ;
    mlips:materialClass "Adsorbate-surface systems" .

entity:mat-oc22-polat2026 a mlips:MaterialSystem ;
    rdfs:label "Adsorbate-catalyst structures of Open Catalyst 2022 (oxide surfaces)" ;
    mlips:materialClass "Adsorbate-surface systems" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-oc20-polat2026 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF 200K training split" ;
    mlips:coversMaterial entity:mat-oc20-polat2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 200000 .

entity:ds-oc22-polat2026 a mlips:TrainingDataset ;
    rdfs:label "OC22 S2EF complete training set" ;
    mlips:coversMaterial entity:mat-oc22-polat2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-oc20-polat2026 mlips:samplingStrategy
    entity:sampling-published-polat2026 .

entity:ds-oc22-polat2026 mlips:samplingStrategy
    entity:sampling-published-polat2026 .

entity:sampling-published-polat2026 a mlips:SamplingStrategy ;
    rdfs:label "Published data set used as provided" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CliffordIP a mlips:MLIPMethod ;
    rdfs:label "CliffordIP (Clifford algebra equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-CliffordIP-polat2026 ;
    mlips:hasTrainingAlgorithm entity:alg-CliffordIP-polat2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-max-neighbors-polat2026 ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-CliffordIP-polat2026 .

entity:loss-CliffordIP-polat2026 a mlips:LossFunction ;
    rdfs:label "Weighted sum of a per-atom energy MAE and a per-atom force-vector norm loss (forces on free atoms only)" .

entity:alg-CliffordIP-polat2026 a mls:Algorithm ;
    rdfs:label "Adam, fixed learning rate, no weight decay; early stopping with patience 30" .

entity:impl-CliffordIP-polat2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-cliffordip-polat2026 .

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-max-neighbors-polat2026 ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:numLayers ,
        mlips:numFeatures ,
        entity:hp-lmax-polat2026 .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-max-neighbors-polat2026 ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        entity:hp-lmax-polat2026 .

entity:lib-cliffordip-polat2026 a mlips:Library ;
    rdfs:label "cliffordip" ;
    rdfs:comment "PyPI package cliffordip; https://github.com/KurbanIntelligenceLab/CliffordIP" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-lmax-polat2026 a mlips:Hyperparameter ;
    rdfs:label "Maximum rotation order L_max" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-max-neighbors-polat2026 a mlips:Hyperparameter ;
    rdfs:label "Maximum number of neighbours per atom" ;
    mlips:hyperparameterName "max_neighbors" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

