###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-zro2-verdi2021 a mlips:MaterialSystem ;
    rdfs:label "Zirconia (monoclinic, tetragonal and cubic ZrO2) up to 2800 K" ;
    mlips:chemicalFormula "ZrO2" ;
    mlips:materialClass "Transition-metal oxide" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbesol-verdi2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbesol-verdi2021 mlips:hasDFTSettings entity:calc-settings-pbesol-verdi2021 .

entity:calc-settings-pbesol-verdi2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBEsol-verdi2021 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "4x4x4 Monkhorst-Pack for 12-atom cells" ;
    rdfs:comment "Structures optimised to forces below 1e-4 eV/A." .

entity:xc-PBEsol-verdi2021 a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-zro2-verdi2021 a mlips:TrainingDataset ;
    rdfs:label "On-the-fly ZrO2 training set (592 structures of 96 atoms; 831 Zr and 1,090 O local reference configurations)" ;
    mlips:coversMaterial entity:mat-zro2-verdi2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 592 ;
    mlips:hasDFTCalculation entity:calc-pbesol-verdi2021 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-zro2-verdi2021 mlips:samplingStrategy
    entity:sampling-otf-verdi2021 .

entity:sampling-otf-verdi2021 a mlips:SamplingStrategy ;
    rdfs:label "On-the-fly NPT MD of a 96-atom cell (heating 1600-2800 K and 500-1600 K over 180 ps each, plus 100 K steps), DFT called when the Bayesian force error is large" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:VASP-MLFF a mlips:MLIPMethod ;
    rdfs:label "VASP on-the-fly machine-learned force field (kernel regression on two- and three-body distribution descriptors with Bayesian error estimates)" ;
    mlips:hasLossFunction entity:loss-VASP-MLFF-verdi2021 ;
    mlips:hasTrainingAlgorithm entity:alg-VASP-MLFF-verdi2021 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-VASP-MLFF-verdi2021 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-VASP-MLFF-verdi2021 a mlips:LossFunction ;
    rdfs:label "Linear regression on energies (weighted 10x), forces and stresses" .

entity:alg-VASP-MLFF-verdi2021 a mls:Algorithm ;
    rdfs:label "Bayesian linear regression or singular value decomposition for the kernel coefficients; CUR sparsification of three-body descriptors; dot-product kernel zeta = 4" .

entity:impl-VASP-MLFF-verdi2021 a mlips:Implementation ;
    mlips:implementedIn mlips:VASP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-blr-cutoffRadius-verdi2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-blr-numRadialBasis-verdi2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "15"^^xsd:integer .

entity:setting-svd-cutoffRadius-verdi2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-svd-numRadialBasis-verdi2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "15"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-blr-verdi2021 a mlips:MLIPRun ;
    rdfs:label "ZrO2 MLFF with Bayesian linear regression (BLR)" ;
    mlips:appliesMethod entity:VASP-MLFF ;
    mlips:runsOn entity:ds-zro2-verdi2021 ;
    mlips:hasHyperparameterSetting entity:setting-blr-cutoffRadius-verdi2021 ,
        entity:setting-blr-numRadialBasis-verdi2021 ;
    mlips:produces entity:model-blr-verdi2021 .

entity:model-blr-verdi2021 a mlips:TrainedModel ;
    rdfs:label "ZrO2 MLFF (BLR)" .

entity:run-svd-verdi2021 a mlips:MLIPRun ;
    rdfs:label "ZrO2 MLFF with singular value decomposition (SVD)" ;
    mlips:appliesMethod entity:VASP-MLFF ;
    mlips:runsOn entity:ds-zro2-verdi2021 ;
    mlips:hasHyperparameterSetting entity:setting-svd-cutoffRadius-verdi2021 ,
        entity:setting-svd-numRadialBasis-verdi2021 ;
    mlips:produces entity:model-svd-verdi2021 .

entity:model-svd-verdi2021 a mlips:TrainedModel ;
    rdfs:label "ZrO2 MLFF (SVD)" .

