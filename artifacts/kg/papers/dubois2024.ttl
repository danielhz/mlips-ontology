# Canonical Turtle for the protocol-derived encoding of:
#   E.T. Dubois et al. (2024). Atomistic simulations of nuclear fuel UO 2 with machine learning interatomic potentials.
#   Physical Review Materials. doi:10.1103/physrevmaterials.8.025402
#
# Version read: publisher (sha256 8a545af16c608ffa...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 168 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the SNAP and Behler-Parrinello HDNNP potentials for
# UO2, their DFT+U reference calculations (ABINIT), the actively learned
# training database (Table V), settings, and the test errors of Table I
# for each group of configurations and in total. Defect formation
# energies, stacking-fault surfaces and thermal properties are not
# encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-dubois2024 a mlips:BenchmarkStudy ;
    rdfs:label "Dubois et al. (2024): atomistic simulations of nuclear fuel UO2 with machine learning interatomic potentials" ;
    mlips:reportedIn entity:article-dubois2024 .

entity:article-dubois2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.8.025402> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Atomistic simulations of nuclear fuel UO 2 with machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0009-0000-1293-129X> ,
        <https://orcid.org/0000-0003-2782-1282> ,
        entity:person-Bouchet-dubois2024 ,
        <https://orcid.org/0000-0003-4461-2394> .

<https://orcid.org/0009-0000-1293-129X> a schema:Person ;
    schema:name "Eliott T. Dubois" ;
    schema:givenName "Eliott T." ;
    schema:familyName "Dubois" ;
    schema:identifier <https://orcid.org/0009-0000-1293-129X> .

<https://orcid.org/0000-0003-2782-1282> a schema:Person ;
    schema:name "Julien Tranchida" ;
    schema:givenName "Julien" ;
    schema:familyName "Tranchida" ;
    schema:identifier <https://orcid.org/0000-0003-2782-1282> .

entity:person-Bouchet-dubois2024 a schema:Person ;
    schema:name "Johann Bouchet" ;
    schema:givenName "Johann" ;
    schema:familyName "Bouchet" .

<https://orcid.org/0000-0003-4461-2394> a schema:Person ;
    schema:name "Jean-Bernard Maillet" ;
    schema:givenName "Jean-Bernard" ;
    schema:familyName "Maillet" ;
    schema:identifier <https://orcid.org/0000-0003-4461-2394> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-UO2-dubois2024 a mlips:MaterialSystem ;
    rdfs:label "Uranium dioxide (fluorite and other polymorphs, hot bulk, defects, generalised stacking faults)" ;
    mlips:chemicalFormula "UO2" ;
    mlips:materialClass "Actinide oxide (nuclear fuel)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-dubois2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-dubois2024 mlips:hasDFTSettings entity:calc-settings-dft-dubois2024 .

entity:calc-settings-dft-dubois2024 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-ABINIT-dubois2024 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "680"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack 4x4x4 for 12-atom cells and 2x2x2 for 96- and 144-atom cells" ;
    rdfs:comment "DFT+U (Liechtenstein scheme, U = 4.5 eV, J = 0.54 eV) with occupation-matrix control; longitudinal 1k antiferromagnetic order; spin-orbit coupling neglected." .

entity:lib-ABINIT-dubois2024 a mlips:Library ;
    rdfs:label "ABINIT" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-UO2-dubois2024 a mlips:TrainingDataset ;
    rdfs:label "UO2 database (1844 configurations, 446,375 data; about 10% held out for testing)" ;
    mlips:coversMaterial entity:mat-UO2-dubois2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1844 ;
    mlips:hasDFTCalculation entity:calc-dft-dubois2024 ;
    rdfs:comment "Groups (configurations): Fm-3m 130, polymorphs 300, hot bulk 1 409, hot bulk 2 145, hot bulk 3 223, defects 375, gamma surfaces 262. The count is the whole database; the testing subset is drawn from it." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-UO2-dubois2024 mlips:samplingStrategy
    entity:sampling-initial-dubois2024 ,
    entity:sampling-active-dubois2024 ,
    entity:sampling-targeted-dubois2024 .

entity:sampling-initial-dubois2024 a mlips:SamplingStrategy ;
    rdfs:label "Initial database from physical intuition: cold curves of several crystal structures (Fm-3m, P42/mnm, Pnma, Pbcn) and small deformations of Fm-3m" .

entity:sampling-active-dubois2024 a mlips:SamplingStrategy ;
    rdfs:label "Batch active learning: candidates from classical NVT MD of a 96-atom cell with a first SNAP potential, selected by a weighted sum (gamma = 0.5) of an uncertainty criterion and a Mahalanobis-distance diversity criterion, labelled with single-point DFT" .

entity:sampling-targeted-dubois2024 a mlips:SamplingStrategy ;
    rdfs:label "Configurations targeting specific properties (defects, gamma surfaces) and machine-learning-assisted canonical sampling (MLACS)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP ;
    mlips:hasLossFunction entity:loss-SNAP-dubois2024 ;
    mlips:hasTrainingAlgorithm entity:alg-SNAP-dubois2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

entity:loss-SNAP-dubois2024 a mlips:LossFunction ;
    rdfs:label "Weighted linear least squares on energies, forces and stresses, with one weight per training group for each quantity" .

entity:alg-SNAP-dubois2024 a mls:Algorithm ;
    rdfs:label "Linear solve for the coefficients; group weights, cutoff and per-element radii optimised with an evolutionary algorithm (Dakota)" .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-dubois2024 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-dubois2024 ;
    mlips:hasHyperparameter entity:hp-nn-architecture-dubois2024 ,
        entity:hp-force-weight-dubois2024 ;
    mlips:hasImplementation entity:impl-HDNNP-dubois2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-HDNNP-dubois2024 a mlips:LossFunction ;
    rdfs:label "Squared energy error plus lambda times squared force errors (not trained on stress)" .

entity:alg-HDNNP-dubois2024 a mls:Algorithm ;
    rdfs:label "Multi-stream extended Kalman filter; symmetry functions generated systematically and selected by CUR decomposition; several networks trained and the best retained" .

entity:impl-HDNNP-dubois2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-dubois2024 .

entity:lib-n2p2-dubois2024 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-nn-architecture-dubois2024 a mlips:Hyperparameter ;
    rdfs:label "Network architecture" ;
    mlips:hyperparameterName "nn_architecture" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-force-weight-dubois2024 a mlips:Hyperparameter ;
    rdfs:label "Force weighting factor lambda in the loss" ;
    mlips:hyperparameterName "force_weight" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-SNAP-cutoffRadius-dubois2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.18"^^xsd:double .

entity:setting-HDNNP-nn-architecture-dubois2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nn-architecture-dubois2024 ;
    mlips:settingValue "60 x 45 x 45 x 1" .

entity:setting-HDNNP-force-weight-dubois2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-force-weight-dubois2024 ;
    mlips:settingValue "2"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-SNAP-dubois2024 a mlips:MLIPRun ;
    rdfs:label "SNAP training for UO2" ;
    mlips:appliesMethod entity:SNAP ;
    mlips:runsOn entity:ds-UO2-dubois2024 ;
    mlips:hasHyperparameterSetting entity:setting-SNAP-cutoffRadius-dubois2024 ;
    mlips:produces entity:model-SNAP-dubois2024 .

entity:model-SNAP-dubois2024 a mlips:TrainedModel ;
    rdfs:label "SNAP potential for UO2" .

entity:run-HDNNP-dubois2024 a mlips:MLIPRun ;
    rdfs:label "Behler-Parrinello HDNNP training for UO2" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-UO2-dubois2024 ;
    mlips:hasHyperparameterSetting entity:setting-HDNNP-nn-architecture-dubois2024 ,
        entity:setting-HDNNP-force-weight-dubois2024 ;
    mlips:produces entity:model-HDNNP-dubois2024 .

entity:model-HDNNP-dubois2024 a mlips:TrainedModel ;
    rdfs:label "BP-HDNNP potential for UO2" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-dubois2024 mlips:hasResult
