###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-hanseroth2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-hanseroth2025 ;
    mlips:hasHyperparameter mlips:batchSize ,
        mlips:numEpochs ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-MACE-hanseroth2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-hanseroth2025 a mlips:LossFunction ;
    rdfs:label "Force weight 10, energy weight 0.1" .

entity:alg-MACE-hanseroth2025 a mls:Algorithm ;
    rdfs:label "Naive fine-tuning of MACE-MP-0 small (MACE 0.3.6); multi-head fine-tuning for A2 and B3" .

entity:impl-MACE-hanseroth2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

