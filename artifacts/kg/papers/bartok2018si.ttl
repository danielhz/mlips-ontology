# Canonical Turtle for the protocol-derived encoding of:
#   Bartok, Kermode, Bernstein, Csanyi. Machine learning a general
#   purpose interatomic potential for silicon.
#   Phys. Rev. X 8, 041048 (2018). doi:10.1103/PhysRevX.8.041048
#   arXiv:1805.01568
#
# Encoding scope: the single general-purpose Si GAP trained over a
# diverse 2475-structure database (171,815 atomic environments,
# M=9000 representatives) covering crystal phases, surfaces, defects,
# liquid, amorphous, and crack-tip configurations.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bartok2018si a mlips:BenchmarkStudy ;
    rdfs:label "Bartok et al. (2018): general-purpose GAP for silicon" ;
    mlips:reportedIn entity:article-bartok2018si .

entity:article-bartok2018si a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/PhysRevX.8.041048> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Machine learning a general purpose interatomic potential for silicon" ;
    schema:author
        <https://orcid.org/0000-0002-4347-8819> ,
        <https://orcid.org/0000-0001-6755-6271> ,
        <https://orcid.org/0000-0002-6532-1337> ,
        entity:person-Csanyi-bartok2018si .

<https://orcid.org/0000-0001-6755-6271> a schema:Person ;
    schema:name "James Kermode" ;
    schema:givenName "James" ;
    schema:familyName "Kermode" ;
    schema:identifier <https://orcid.org/0000-0001-6755-6271> .
<https://orcid.org/0000-0002-6532-1337> a schema:Person ;
    schema:name "Noam Bernstein" ;
    schema:givenName "Noam" ;
    schema:familyName "Bernstein" ;
    schema:identifier <https://orcid.org/0000-0002-6532-1337> .
entity:person-Csanyi-bartok2018si a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" ;
    rdfs:comment "No ORCID found via Crossref / arXiv API as of 2026-05-04." .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Si-bartok2018 a mlips:MaterialSystem ;
    rdfs:label "Silicon (general-purpose: crystal, liquid, amorphous, defective)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Single-element semiconductor; benchmarked on diamond, beta-Sn, simple hexagonal, hex-diamond, bcc, bc8, fcc, hcp, st12, liquid, amorphous, surfaces, point defects, crack tips" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q670> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-bartok2018si a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-bartok2018si mlips:hasDFTSettings entity:dft-settings-bartok2018si .

entity:dft-settings-bartok2018si a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:CASTEP ;
    mlips:xcFunctional mlips:PW91 ;
    mlips:pseudopotentialType mlips:Ultrasoft ;
    mlips:energyCutoff "250"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack with 0.03 Ang^-1 spacing (with 0.05 eV electronic smearing); 0.015 Ang^-1 for E(V) testing curves; 0.07 Ang^-1 for amorphous re-optimization" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Si-bartok2018 a mlips:TrainingDataset ;
    rdfs:label "Si general-purpose GAP fitting database (2475 unit cells, 171,815 atomic environments, 531,710 pieces of electronic-structure data)" ;
    mlips:coversMaterial entity:mat-Si-bartok2018 ;
    mlips:coversProperty mlips:Energy , mlips:Forces , mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2475 ;
    mlips:hasDFTCalculation entity:dft-bartok2018si .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Si-bartok2018 mlips:samplingStrategy
    entity:phase-sampling-bartok2018si ,
    entity:surface-sampling-bartok2018si ,
    entity:defect-sampling-bartok2018si ,
    entity:liquid-sampling-bartok2018si ,
    entity:amorphous-sampling-bartok2018si ,
    entity:crack-sampling-bartok2018si ,
    entity:dislocation-sampling-bartok2018si ,
    entity:isolated-atom-sampling-bartok2018si .

entity:phase-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Crystal-phase enumeration with strain perturbations" ;
    rdfs:comment "Configurations covering diamond, beta-Sn, simple hexagonal, hex-diamond, bcc, bc8, fcc, hcp, st12 across a range of unit-cell sizes and lattice strains." .

entity:surface-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Surface enumeration including reconstructions and decohesion paths" ;
    rdfs:comment "Diamond (001), (110), (111) surfaces with unreconstructed, adatom, and Pandey/DAS reconstructions, plus decohesion separation paths along (100), (110), (111)." .

entity:defect-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Point-defect enumeration" ;
    rdfs:comment "Vacancy, divacancy, and interstitial (hexagonal, tetrahedral, dumbbell) configurations in diamond Si, sampled by DFT MD around the defect." .

entity:liquid-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Liquid-phase MD sampling" ;
    rdfs:comment "Snapshots from DFT MD trajectories of molten silicon at high temperature in 64- and 128-atom supercells." .

entity:amorphous-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Amorphous-phase quench sampling" ;
    rdfs:comment "Configurations from quenched-melt amorphous-Si trajectories in 64- and 216-atom cells." .

entity:crack-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Crack-tip sampling" ;
    rdfs:comment "Small (110) and (111) crack-tip geometries with bond-breaking environments." .

entity:dislocation-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Screw-dislocation core sampling" ;
    rdfs:comment "Screw-dislocation core configurations in 144-atom periodic cells." .

entity:isolated-atom-sampling-bartok2018si a mlips:SamplingStrategy ;
    rdfs:label "Isolated-atom anchor" ;
    rdfs:comment "A single isolated Si atom is included to anchor the cohesive-energy zero." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    mlips:supportsSimulation mlips:MolecularDynamics, mlips:GeometryOptimization, mlips:PhononCalculation, mlips:NudgedElasticBand ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasFunctionalForm entity:gap-functional-form;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:gap-loss-bartok2018si ;
    mlips:hasTrainingAlgorithm entity:gpr-bartok2018si ;
    mlips:hasHyperparameter mlips:cutoffRadius , entity:hp-sigma-atom , entity:hp-zeta , entity:hp-delta , mlips:numSparseConfigs , mlips:numAngularBasis , mlips:numRadialBasis ;
    mlips:hasImplementation entity:quip-impl .

entity:gap-functional-form a mlips:FunctionalForm ;
    rdfs:label "Pair potential (cubic-spline repulsive) plus SOAP-kernel many-body Gaussian-process regression" .

entity:gap-loss-bartok2018si a mlips:LossFunction ;
    rdfs:label "Regularised least squares on energies, forces, virials with per-class regularisation (sigma_E, sigma_F, sigma_V)" .

entity:gpr-bartok2018si a mls:Algorithm ;
    rdfs:label "Sparse Gaussian-process regression with CUR-selected representative environments" .

entity:quip-impl a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-5-bartok2018si a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-sigma-atom-05 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-sigma-atom ;
    mlips:settingValue "0.5"^^xsd:double .

entity:setting-zeta-4 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-zeta ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-delta-3 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-delta ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-M-9000 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "9000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-gap-Si a mlips:MLIPRun ;
    rdfs:label "GAP training run on the general-purpose Si database" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-Si-bartok2018 ;
    mlips:hasHyperparameterSetting entity:setting-rcut-5-bartok2018si , entity:setting-sigma-atom-05 , entity:setting-zeta-4 , entity:setting-delta-3 , entity:setting-M-9000 ;
    mlips:produces entity:model-gap-Si .

entity:model-gap-Si a mlips:TrainedModel ;
    rdfs:label "GAP-6 silicon potential" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-bartok2018si mlips:hasResult entity:result-gap-si-forces .

entity:result-gap-si-forces a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-Si ;
    mlips:targetMaterial entity:mat-Si-bartok2018 ;
    mlips:hasAccuracyMetric entity:metric-gap-si-forces-median .

entity:metric-gap-si-forces-median a mlips:AccuracyMetric ;
    rdfs:label "Median absolute force-component error on the testing database (held-out grain boundary, di-interstitials, GSF paths, amorphous)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.025"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Bartok et al. (2018) does not report GAP training duration, GPU
# hours, training hardware, peak memory, or per-atom inference time.
# Recorded as a Q12 gap.

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-delta a mlips:Hyperparameter ;
    rdfs:label "SOAP / Huber delta" ;
    mlips:hyperparameterName "delta" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-sigma-atom a mlips:Hyperparameter ;
    rdfs:label "SOAP atomic Gaussian width" ;
    mlips:hyperparameterName "sigma_atom" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-zeta a mlips:Hyperparameter ;
    rdfs:label "SOAP kernel polynomial power" ;
    mlips:hyperparameterName "zeta" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

