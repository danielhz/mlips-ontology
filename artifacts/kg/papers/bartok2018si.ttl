<https://orcid.org/0000-0002-6532-1337> schema:affiliation mlips:ScienceandTechnologyFacilitiesCouncil .
entity:person-Csanyi-bartok2018si schema:affiliation mlips:ScienceandTechnologyFacilitiesCouncil .
entity:person-Csanyi-bartok2018si schema:affiliation mlips:RutherfordAppletonLaboratory .
