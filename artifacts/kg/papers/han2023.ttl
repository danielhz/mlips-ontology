###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sulfur-han2023 a mlips:MaterialSystem ;
    rdfs:label "Amorphous sulfur (S8 rings at 300 K, broken rings at 1500 K), 128 atoms" ;
    mlips:chemicalFormula "S" ;
    mlips:materialClass "Elemental solid and liquid" .

entity:mat-carbon-han2023 a mlips:MaterialSystem ;
    rdfs:label "Carbon phases (diamond, graphene, graphenylene, M-carbon), 64 atoms, 300-3500 K" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental solid and liquid carbon" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pwmat-han2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pwmat-han2023 mlips:hasDFTSettings entity:calc-settings-pwmat-han2023 .

entity:calc-settings-pwmat-han2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-PWmat-han2023 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "60 Ry (S) and 80 Ry (C); atomic energies from energy decomposition" .

entity:lib-PWmat-han2023 a mlips:Library ;
    rdfs:label "PWmat" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-s-comb-han2023 a mlips:TrainingDataset ;
    rdfs:label "Combined sulfur 300 K and 1500 K AIMD data (4,000 images)" ;
    mlips:coversMaterial entity:mat-sulfur-han2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pwmat-han2023 .

entity:ds-c4-han2023 a mlips:TrainingDataset ;
    rdfs:label "Carbon four-phase AIMD data (4,000 images)" ;
    mlips:coversMaterial entity:mat-carbon-han2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4000 ;
    mlips:hasDFTCalculation entity:calc-pwmat-han2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-s-comb-han2023 mlips:samplingStrategy
    entity:sampling-aimd-han2023 .

entity:ds-c4-han2023 mlips:samplingStrategy
    entity:sampling-aimd-han2023 .

entity:sampling-aimd-han2023 a mlips:SamplingStrategy ;
    rdfs:label "NVT AIMD trajectories, every step used (Table 1)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-han2023 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-han2023 ;
    mlips:hasImplementation entity:impl-MTP-han2023 .

entity:loss-MTP-han2023 a mlips:LossFunction ;
    rdfs:label "Total energy, group energy and forces" .

entity:alg-MTP-han2023 a mls:Algorithm ;
    rdfs:label "Linear regression on about 180 features" .

entity:impl-MTP-han2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PWmat-MLFF-han2023 .

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP ;
    mlips:hasLossFunction entity:loss-SNAP-han2023 ;
    mlips:hasTrainingAlgorithm entity:alg-SNAP-han2023 ;
    mlips:hasImplementation entity:impl-SNAP-han2023 .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

entity:loss-SNAP-han2023 a mlips:LossFunction ;
    rdfs:label "Total energy, group energy and forces" .

entity:alg-SNAP-han2023 a mls:Algorithm ;
    rdfs:label "Linear regression on about 180 features" .

entity:impl-SNAP-han2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PWmat-MLFF-han2023 .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-han2023 ;
    mlips:hasImplementation entity:impl-ACE-han2023 .

entity:loss-ACE-han2023 a mlips:LossFunction ;
    rdfs:label "Total energy and forces" .

entity:impl-ACE-han2023 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:lib-PWmat-MLFF-han2023 a mlips:Library ;
    rdfs:label "PWmat-MLFF" ;
    mlips:candidateForVocabulary mlips:Library .

