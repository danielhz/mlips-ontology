# Canonical Turtle for the protocol-derived encoding of:
#   Johannes Gasteiger et al. (2020). Fast and Uncertainty-Aware Directional Message Passing for Non-Equilibrium Molecules.
#   arXiv. doi:10.48550/arxiv.2011.14115  arXiv:2011.14115v3
#
# Version read: arxiv-preprint arXiv:2011.14115v3 (sha256 c187777f22b037bb...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 222 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/gasteiger2020coll.yaml.
#
# Encoding scope: the COLL data set introduced here and the DimeNet++ and
# SchNet models trained on it (Table 3), plus the DimeNet++ QM9 U0 error
# (Table 2). The other QM9 targets, the ablation of Table 1 and the
# ensemble's errors are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gasteiger2020coll a mlips:BenchmarkStudy ;
    rdfs:label "Gasteiger et al. (2020): DimeNet++ and the COLL data set of colliding molecules" ;
    mlips:reportedIn entity:article-gasteiger2020coll .

entity:article-gasteiger2020coll a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2011.14115> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Fast and Uncertainty-Aware Directional Message Passing for Non-Equilibrium Molecules" ;
    schema:author entity:person-Gasteiger-gasteiger2020coll ,
        entity:person-Giri-gasteiger2020coll ,
        entity:person-Margraf-gasteiger2020coll ,
        entity:person-Gunnemann-gasteiger2020coll .

entity:person-Gasteiger-gasteiger2020coll a schema:Person ;
    schema:name "Johannes Gasteiger" ;
    schema:givenName "Johannes" ;
    schema:familyName "Gasteiger" .

entity:person-Giri-gasteiger2020coll a schema:Person ;
    schema:name "Shankari Giri" ;
    schema:givenName "Shankari" ;
    schema:familyName "Giri" .

entity:person-Margraf-gasteiger2020coll a schema:Person ;
    schema:name "Johannes T. Margraf" ;
    schema:givenName "Johannes T." ;
    schema:familyName "Margraf" .

entity:person-Gunnemann-gasteiger2020coll a schema:Person ;
    schema:name "Stephan Günnemann" ;
    schema:givenName "Stephan" ;
    schema:familyName "Günnemann" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-coll-gasteiger2020coll a mlips:MaterialSystem ;
    rdfs:label "Pairs of small molecules during high-energy collisions (COLL)" ;
    mlips:materialClass "Small organic molecules (reactive, far from equilibrium)" .

entity:mat-qm9-gasteiger2020coll a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules with up to nine heavy atoms (QM9)" ;
    mlips:materialClass "Small organic molecules (equilibrium geometries)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-coll-dft-gasteiger2020coll a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-coll-dft-gasteiger2020coll mlips:hasDFTSettings entity:calc-settings-coll-dft-gasteiger2020coll .

entity:calc-settings-coll-dft-gasteiger2020coll a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-revPBE-D3-gasteiger2020coll ;
    mlips:basisSet "def2-TZVP" ;
    rdfs:comment "Broken spin symmetry; lowest of several SCF solutions from randomised initial wavefunctions; Fermi smearing at 5000 K (Sec. 3)." .

entity:xc-revPBE-D3-gasteiger2020coll a mlips:XCFunctional ;
    rdfs:label "revPBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-coll-gasteiger2020coll a mlips:TrainingDataset ;
    rdfs:label "COLL data set (140,000 configurations; introduced here)" ;
    mlips:coversMaterial entity:mat-coll-gasteiger2020coll ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 140000 ;
    mlips:hasDFTCalculation entity:calc-coll-dft-gasteiger2020coll .

entity:ds-qm9-gasteiger2020coll a mlips:TrainingDataset ;
    rdfs:label "QM9" ;
    mlips:coversMaterial entity:mat-qm9-gasteiger2020coll ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-coll-gasteiger2020coll mlips:samplingStrategy
    entity:sampling-collisions-gasteiger2020coll .

entity:sampling-collisions-gasteiger2020coll a mlips:SamplingStrategy ;
    rdfs:label "GFN2-xTB molecular-collision MD, random snapshots recomputed with DFT" ;
    rdfs:comment "140,000 random snapshots from semiempirical collision trajectories (Sec. 3)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DimeNet a mlips:MLIPMethod ;
    rdfs:label "DimeNet / DimeNet++ (directional message passing neural network)" ;
    mlips:hasHyperparameter mlips:numLayers ;
    mlips:hasImplementation entity:impl-DimeNet-gasteiger2020coll .

entity:impl-DimeNet-gasteiger2020coll a mlips:Implementation ;
    mlips:implementedIn entity:lib-DimeNet-reference-implementation-gasteiger2020coll .

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" .

entity:lib-DimeNet-reference-implementation-gasteiger2020coll a mlips:Library ;
    rdfs:label "DimeNet++ reference implementation" ;
    rdfs:comment "https://www.daml.in.tum.de/dimenet" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dimenetpp-coll-numLayers-gasteiger2020coll a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-dimenetpp-mve-coll-numLayers-gasteiger2020coll a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-dimenetpp-qm9-numLayers-gasteiger2020coll a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "4"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dimenetpp-coll-gasteiger2020coll a mlips:MLIPRun ;
    rdfs:label "DimeNet++ trained on COLL" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-coll-gasteiger2020coll ;
    mlips:hasHyperparameterSetting entity:setting-dimenetpp-coll-numLayers-gasteiger2020coll ;
    mlips:produces entity:model-dimenetpp-coll-gasteiger2020coll .

entity:model-dimenetpp-coll-gasteiger2020coll a mlips:TrainedModel ;
    rdfs:label "DimeNet++ COLL model" .

entity:run-dimenetpp-mve-coll-gasteiger2020coll a mlips:MLIPRun ;
    rdfs:label "DimeNet++ with mean-variance estimation trained on COLL" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-coll-gasteiger2020coll ;
    mlips:hasHyperparameterSetting entity:setting-dimenetpp-mve-coll-numLayers-gasteiger2020coll ;
    mlips:produces entity:model-dimenetpp-mve-coll-gasteiger2020coll .

entity:model-dimenetpp-mve-coll-gasteiger2020coll a mlips:TrainedModel ;
    rdfs:label "DimeNet++ MVE COLL model" .

entity:run-schnet-coll-gasteiger2020coll a mlips:MLIPRun ;
    rdfs:label "SchNet (reference implementation) trained on COLL" ;
    mlips:appliesMethod entity:SchNet ;
    mlips:runsOn entity:ds-coll-gasteiger2020coll ;
    mlips:produces entity:model-schnet-coll-gasteiger2020coll .

entity:model-schnet-coll-gasteiger2020coll a mlips:TrainedModel ;
    rdfs:label "SchNet COLL model" .

entity:run-dimenetpp-qm9-gasteiger2020coll a mlips:MLIPRun ;
    rdfs:label "DimeNet++ trained on the QM9 U0 target" ;
    mlips:appliesMethod entity:DimeNet ;
    mlips:runsOn entity:ds-qm9-gasteiger2020coll ;
    mlips:hasHyperparameterSetting entity:setting-dimenetpp-qm9-numLayers-gasteiger2020coll ;
    mlips:produces entity:model-dimenetpp-qm9-gasteiger2020coll .

entity:model-dimenetpp-qm9-gasteiger2020coll a mlips:TrainedModel ;
    rdfs:label "DimeNet++ QM9 U0 model" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-gasteiger2020coll mlips:hasResult
    entity:result-dimenetpp-coll-gasteiger2020coll ,
    entity:result-dimenetpp-mve-coll-gasteiger2020coll ,
    entity:result-schnet-coll-gasteiger2020coll ,
    entity:result-dimenetpp-qm9-gasteiger2020coll .

entity:result-dimenetpp-coll-gasteiger2020coll a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-dimenetpp-coll-gasteiger2020coll ;
    mlips:targetMaterial entity:mat-coll-gasteiger2020coll ;
    mlips:hasAccuracyMetric entity:metric-dimenetpp-coll-1-gasteiger2020coll ,
        entity:metric-dimenetpp-coll-2-gasteiger2020coll .

entity:metric-dimenetpp-coll-1-gasteiger2020coll a mlips:AccuracyMetric ;
    rdfs:label "COLL energy MAE: DimeNet++" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.047"^^xsd:double ;
    mlips:hasUnit unit:EV .

entity:metric-dimenetpp-coll-2-gasteiger2020coll a mlips:AccuracyMetric ;
