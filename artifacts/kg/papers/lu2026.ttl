###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-omc-lu2026 a mlips:MaterialSystem ;
    rdfs:label "Organic molecular crystals from the CSD (H, B, C, N, O, F, P, S, Cl, Br, I; under 400 atoms per cell)" ;
    mlips:materialClass "Organic molecular crystal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbed3-lu2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbed3-lu2026 mlips:hasDFTSettings entity:calc-settings-pbed3-lu2026 .

entity:calc-settings-pbed3-lu2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, KSPACING 0.4 1/A" ;
    rdfs:comment "D3(BJ) dispersion" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-omc-lu2026 a mlips:TrainingDataset ;
    rdfs:label "OMC training dataset (about 2.07 million configurations)" ;
    mlips:coversMaterial entity:mat-omc-lu2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbed3-lu2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-omc-lu2026 mlips:samplingStrategy
    entity:sampling-omc-lu2026 .

entity:sampling-omc-lu2026 a mlips:SamplingStrategy ;
    rdfs:label "DFT geometry-optimization trajectories, AIMD at 600 K and 1 GPa, and fixed all-atom displacements (0.01-0.30 A) of CSD-derived crystals; benchmark sets by dual-objective farthest-point sampling in SOAP-UMAP space" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:AlphaNet a mlips:MLIPMethod ;
    rdfs:label "AlphaNet (local-frame equivariant graph neural network potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:AtomBit a mlips:MLIPMethod ;
    rdfs:label "AtomBit (SE(3)-equivariant Cartesian-tensor message passing with physics-informed edge gating)" ;
    mlips:hasLossFunction entity:loss-AtomBit-lu2026 ;
    mlips:hasTrainingAlgorithm entity:alg-AtomBit-lu2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-AtomBit-lu2026 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses" .

entity:alg-AtomBit-lu2026 a mls:Algorithm ;
    rdfs:label "OneCycle learning rate 1e-5 to 1e-3 to 1e-6, EMA 0.999, cost-aware dynamic batch sampler" .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:DPA3 a mlips:MLIPMethod ;
    rdfs:label "DPA-3 (Deep Potential attention model, version 3)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:Eqnorm a mlips:MLIPMethod ;
    rdfs:label "Eqnorm (equivariant MLIP with equivariant normalization)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:MatRIS a mlips:MLIPMethod ;
    rdfs:label "MatRIS (invariant graph-attention interatomic potential with three-body features)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:NEMP a mlips:MLIPMethod ;
    rdfs:label "Node-Equivariant Message Passing (NEMP)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:Nequix a mlips:MLIPMethod ;
    rdfs:label "Nequix (compact E(3)-equivariant interatomic potential, JAX implementation)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-atombits-cutoffRadius-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-atombits-numLayers-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-atombits-numFeatures-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-atombits-numEpochs-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "15"^^xsd:integer .

entity:setting-atombitl-cutoffRadius-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-atombitl-numLayers-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-atombitl-numFeatures-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-atombitl-numEpochs-lu2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "15"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-grace1l-lu2026 a mlips:MLIPRun ;
    rdfs:label "GRACE-1L-OAM (off-the-shelf, as distributed)" ;
    mlips:appliesMethod entity:GRACE ;
    mlips:produces entity:model-grace1l-lu2026 .

entity:model-grace1l-lu2026 a mlips:TrainedModel ;
    rdfs:label "GRACE-1L-OAM" .

entity:run-macemp0-lu2026 a mlips:MLIPRun ;
