entity:run-nempomc-lu2026 a mlips:MLIPRun ;
    rdfs:label "NEMP-OMC (trained from scratch on the OMC dataset)" ;
    mlips:appliesMethod entity:NEMP ;
    mlips:runsOn entity:ds-omc-lu2026 ;
