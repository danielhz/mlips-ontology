###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-lu2026 mlips:hasResult
    entity:result-grace1l-task1-lu2026 ,
    entity:result-macemp0-task1-lu2026 ,
    entity:result-alphanet-task1-lu2026 ,
    entity:result-macempa0-task1-lu2026 ,
    entity:result-chgnet-task1-lu2026 ,
    entity:result-sevennet-task1-lu2026 ,
    entity:result-eqnorm-task1-lu2026 ,
    entity:result-nequix-task1-lu2026 ,
    entity:result-dpa31-task1-lu2026 ,
    entity:result-orbv3-task1-lu2026 ,
    entity:result-matrisoam-task1-lu2026 ,
    entity:result-esen30m-task1-lu2026 ,
    entity:result-maceomol-task1-lu2026 ,
    entity:result-umamd-task1-lu2026 ,
    entity:result-nempomc-task1-lu2026 ,
    entity:result-maceomc-task1-lu2026 ,
    entity:result-matrisomc-task1-lu2026 ,
    entity:result-atombits-task1-lu2026 ,
    entity:result-atombitl-task1-lu2026 .

entity:result-grace1l-task1-lu2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-grace1l-lu2026 ;
    mlips:targetMaterial entity:mat-omc-lu2026 ;
    mlips:hasAccuracyMetric entity:metric-grace1l-task1-1-lu2026 ,
        entity:metric-grace1l-task1-2-lu2026 .

entity:metric-grace1l-task1-1-lu2026 a mlips:AccuracyMetric ;
    rdfs:label "OMC-bench Task 1 force MAE: GRACE-1L-OAM" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "134.7"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-grace1l-task1-2-lu2026 a mlips:AccuracyMetric ;
    rdfs:label "OMC-bench Task 1 stress MAE: GRACE-1L-OAM" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.68"^^xsd:double ;
    mlips:hasUnit unit:GigaPA .

entity:result-macemp0-task1-lu2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-macemp0-lu2026 ;
    mlips:targetMaterial entity:mat-omc-lu2026 ;
    mlips:hasAccuracyMetric entity:metric-macemp0-task1-1-lu2026 ,
        entity:metric-macemp0-task1-2-lu2026 .

entity:metric-macemp0-task1-1-lu2026 a mlips:AccuracyMetric ;
    rdfs:label "OMC-bench Task 1 force MAE: MACE-MP-0" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "121.4"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-macemp0-task1-2-lu2026 a mlips:AccuracyMetric ;
    rdfs:label "OMC-bench Task 1 stress MAE: MACE-MP-0" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.55"^^xsd:double ;
    mlips:hasUnit unit:GigaPA .

entity:result-alphanet-task1-lu2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-alphanet-lu2026 ;
    mlips:targetMaterial entity:mat-omc-lu2026 ;
