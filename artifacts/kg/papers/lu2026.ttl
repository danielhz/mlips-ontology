    rdfs:label "AtomBit-OMC-s" .

entity:run-atombitl-lu2026 a mlips:MLIPRun ;
    rdfs:label "AtomBit-OMC-l (trained from scratch on the OMC dataset)" ;
    mlips:appliesMethod entity:AtomBit ;
    mlips:runsOn entity:ds-omc-lu2026 ;
    mlips:hasHyperparameterSetting entity:setting-atombitl-cutoffRadius-lu2026 ,
        entity:setting-atombitl-numLayers-lu2026 ,
