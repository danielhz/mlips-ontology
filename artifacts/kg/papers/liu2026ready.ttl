entity:calc-vasp-liu2026ready mlips:hasDFTSettings entity:calc-settings-vasp-liu2026ready .

entity:calc-settings-vasp-liu2026ready a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    rdfs:comment "Na/Na3SbS4 labels: Gaussian smearing 0.1 eV, EDIFF 1e-6 eV, KSPACING 0.5 (Gamma only for large cells)." .

