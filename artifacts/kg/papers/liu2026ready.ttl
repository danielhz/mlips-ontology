    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType entity:pp-GTH-liu2026ready ;
    rdfs:comment "LiCl/GaF3 labels: PBE-D3, MOLOPT basis, 600 Ry." .

entity:calc-published-liu2026ready mlips:hasDFTSettings entity:calc-settings-published-liu2026ready .

entity:calc-settings-published-liu2026ready a mlips:DFTSettings ;
    rdfs:comment "Li2CO3/LiF, Li3PS4/Li3B11O18 and Li/Li6PS5Cl data sets used as published (Refs. 42, 44, 45); LLZO data in SI S.2." .

