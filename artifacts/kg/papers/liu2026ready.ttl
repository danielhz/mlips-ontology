# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-liu2026ready ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-liu2026ready ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-liu2026ready ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-MACE-liu2026ready a mlips:LossFunction ;
    rdfs:label "Universal loss, energy/force weights 1:10 (stress 10 for Na/Na3SbS4), SWA for the last 75 epochs; replay buffer of 1,000 pretraining configurations" .

entity:alg-MACE-liu2026ready a mls:Algorithm ;
    rdfs:label "Adam, weight decay 1e-6, EMA 0.99" .

entity:impl-MACE-liu2026ready a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

