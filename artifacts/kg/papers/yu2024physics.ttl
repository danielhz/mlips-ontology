###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cri3-yu2024physics a mlips:MaterialSystem ;
    rdfs:label "Monolayer CrI3 with noncollinear spins" ;
    mlips:chemicalFormula "CrI3" ;
    mlips:materialClass "2D magnetic semiconductor" .

entity:mat-crte2-yu2024physics a mlips:MaterialSystem ;
    rdfs:label "Monolayer CrTe2 with noncollinear spins" ;
    mlips:chemicalFormula "CrTe2" ;
    mlips:materialClass "2D magnetic material" .

entity:mat-mnge-yu2024physics a mlips:MaterialSystem ;
    rdfs:label "MnGe-type structure with an artificial spin-lattice model (4149 interaction terms)" ;
    mlips:materialClass "model magnetic system" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-cri3-dft-yu2024physics a mlips:DFTCalculation .

entity:calc-crte2-dft-yu2024physics a mlips:DFTCalculation .

entity:calc-pasp-yu2024physics a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-cri3-dft-yu2024physics mlips:hasDFTSettings entity:calc-settings-cri3-dft-yu2024physics .

entity:calc-settings-cri3-dft-yu2024physics a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-U-yu2024physics ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "Spin-polarised with SOC; U = 4 eV on Cr." .

entity:calc-crte2-dft-yu2024physics mlips:hasDFTSettings entity:calc-settings-crte2-dft-yu2024physics .

entity:calc-settings-crte2-dft-yu2024physics a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-U-yu2024physics ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "2x3x1 Monkhorst-Pack" ;
    rdfs:comment "Spin-polarised with SOC; rotationally invariant DFT+U with U = 3 eV, J = 0.6 eV on Cr." .

entity:calc-pasp-yu2024physics mlips:hasReferenceSettings entity:calc-settings-pasp-yu2024physics .

entity:calc-settings-pasp-yu2024physics a mlips:ReferenceSettings ;
    rdfs:comment "Artificial spin-lattice model evaluated with PASP." .

entity:xc-PBE-U-yu2024physics a mlips:XCFunctional ;
    rdfs:label "PBE+U" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-PBE-U-yu2024physics a mlips:XCFunctional ;
    rdfs:label "PBE+U" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cri3-yu2024physics a mlips:TrainingDataset ;
    rdfs:label "Monolayer CrI3 data set (4900 train / 611 validation / 611 test)" ;
    mlips:coversMaterial entity:mat-cri3-yu2024physics ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 6122 ;
    mlips:hasDFTCalculation entity:calc-cri3-dft-yu2024physics .

entity:ds-crte2-yu2024physics a mlips:TrainingDataset ;
    rdfs:label "Monolayer CrTe2 data set (5661 train / 708 validation / 708 test)" ;
    mlips:coversMaterial entity:mat-crte2-yu2024physics ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 7077 ;
    mlips:hasDFTCalculation entity:calc-crte2-dft-yu2024physics .

entity:ds-mnge-yu2024physics a mlips:TrainingDataset ;
    rdfs:label "Artificial MnGe-type spin-lattice benchmark (5696 train / 712 validation / 712 test; energy only)" ;
    mlips:coversMaterial entity:mat-mnge-yu2024physics ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 7120 ;
    mlips:hasReferenceCalculation entity:calc-pasp-yu2024physics .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cri3-yu2024physics mlips:samplingStrategy
    entity:sampling-npt-spins-yu2024physics .

entity:ds-crte2-yu2024physics mlips:samplingStrategy
    entity:sampling-npt-spins-yu2024physics .

entity:ds-mnge-yu2024physics mlips:samplingStrategy
    entity:sampling-random-yu2024physics .

entity:sampling-npt-spins-yu2024physics a mlips:SamplingStrategy ;
    rdfs:label "NPT MD structures (72-atom CrI3 and 48-atom CrTe2 supercells) with randomly sampled spin configurations" .

entity:sampling-random-yu2024physics a mlips:SamplingStrategy ;
    rdfs:label "Random displacements and spin vectors" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Spin-Allegro-pp a mlips:MLIPMethod ;
    rdfs:label "Spin-Allegro++ (SpinGNN++: Allegro with multitask spin equivariant (MSENN) and time-reversal equivariant (TENN) networks for spin-lattice potentials with spin-orbit coupling)" ;
    mlips:hasTrainingAlgorithm entity:alg-Spin-Allegro-yu2024physics ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-Spin-Allegro-yu2024physics ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-Spin-Allegro-yu2024physics a mls:Algorithm ;
    rdfs:label "Allegro-based SpinGNN++ with MSENN (Heisenberg/DM/Kitaev J matrix, biquadratic and single-ion anisotropy terms) and TENN time-reversal equivariant convolutions" .

entity:impl-Spin-Allegro-yu2024physics a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-Allegro-yu2024physics .

entity:impl-Allegro-yu2024physics a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

