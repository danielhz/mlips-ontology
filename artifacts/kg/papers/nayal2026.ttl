# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-b97-3c-nayal2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-b97-3c-nayal2026 mlips:hasDFTSettings entity:calc-settings-b97-3c-nayal2026 .

entity:calc-settings-b97-3c-nayal2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-B97-3c-nayal2026 ;
    rdfs:comment "ORCA 5, restricted Kohn-Sham, TightSCF/SlowConv, RIJCOSX, DEFGRID2 (Sec. 2.1.3)." .

entity:xc-B97-3c-nayal2026 a mlips:XCFunctional ;
    rdfs:label "B97-3c" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aimnet25-nayal2026 a mlips:TrainingDataset ;
    rdfs:label "Extended AIMNet2(2025) data set (3.8 million B97-3c structures)" ;
    mlips:coversMaterial entity:mat-organics-nayal2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-b97-3c-nayal2026 ;
    rdfs:comment "Added to the about 20 million B97-3c structures of AIMNet2(2023); doi:10.1184/R1/31141138." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-aimnet25-nayal2026 mlips:samplingStrategy
    entity:sampling-aimnet25-data-nayal2026 .

entity:sampling-aimnet25-data-nayal2026 a mlips:SamplingStrategy ;
    rdfs:label "SPICE v2.0.1 and CREMP geometries, normal-mode and metadynamics sampling of PubChem molecules, and random CSD monomer pairs loosely optimised with AIMNet2" ;
    rdfs:comment "3.8 million new structures (Sec. 2.1.3)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:AIMNet2 a mlips:MLIPMethod ;
    rdfs:label "AIMNet2 (atoms-in-molecules neural network potential with learned charges and explicit long-range terms)" ;
    mlips:hasLossFunction entity:loss-AIMNet2-nayal2026 ;
    mlips:hasTrainingAlgorithm entity:alg-AIMNet2-nayal2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-AIMNet2-nayal2026 .

entity:loss-AIMNet2-nayal2026 a mlips:LossFunction ;
    rdfs:label "Weighted MSE of energy (1.0), forces (0.2) and partial charges (0.5)" .

entity:alg-AIMNet2-nayal2026 a mls:Algorithm ;
    rdfs:label "RAdam with cosine annealing from 4e-4 to 1e-6 over 400 epochs, weight decay 1e-8" .

entity:impl-AIMNet2-nayal2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-aimnetcentral-nayal2026 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-nayal2026 .

entity:impl-MACE-nayal2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" .

entity:lib-aimnetcentral-nayal2026 a mlips:Library ;
    rdfs:label "aimnetcentral" ;
    rdfs:comment "https://github.com/isayevlab/aimnetcentral" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-a25-cutoffRadius-nayal2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-a25-learningRate-nayal2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0004"^^xsd:double .

entity:setting-a25-numEpochs-nayal2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-a23-nayal2026 a mlips:MLIPRun ;
    rdfs:label "AIMNet2(2023) B97-3c as distributed" ;
    mlips:appliesMethod entity:AIMNet2 ;
    mlips:produces entity:model-a23-nayal2026 .

entity:model-a23-nayal2026 a mlips:TrainedModel ;
    rdfs:label "AIMNet2-B97-3c (2023)" .

entity:run-a25-nayal2026 a mlips:MLIPRun ;
    rdfs:label "AIMNet2(2025): AIMNet2(2023) continually pretrained on 3.8 million additional B97-3c structures" ;
    mlips:appliesMethod entity:AIMNet2 ;
    mlips:runsOn entity:ds-aimnet25-nayal2026 ;
    mlips:hasHyperparameterSetting entity:setting-a25-cutoffRadius-nayal2026 ,
        entity:setting-a25-learningRate-nayal2026 ,
        entity:setting-a25-numEpochs-nayal2026 ;
    mlips:trainingHardware "Single H200 GPU; about 4 million steps" ;
    mlips:produces entity:model-a25-nayal2026 .

entity:model-a25-nayal2026 a mlips:TrainedModel ;
    rdfs:label "AIMNet2(2025)" .

entity:run-moff-nayal2026 a mlips:MLIPRun ;
    rdfs:label "MACE-OFF23(M) as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-moff-nayal2026 .

entity:model-moff-nayal2026 a mlips:TrainedModel ;
    rdfs:label "MACE-OFF23 medium" .

entity:run-momol-nayal2026 a mlips:MLIPRun ;
    rdfs:label "MACE-OMol as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-momol-nayal2026 .

entity:model-momol-nayal2026 a mlips:TrainedModel ;
    rdfs:label "MACE-OMol (trained on OMol25)" .

entity:run-uma-nayal2026 a mlips:MLIPRun ;
    rdfs:label "UMA-S (OMol task) as distributed" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-nayal2026 .

entity:model-uma-nayal2026 a mlips:TrainedModel ;
    rdfs:label "UMA-S, OMol task" .

