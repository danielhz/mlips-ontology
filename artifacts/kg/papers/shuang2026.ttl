###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-metals16-shuang2026 a mlips:MaterialSystem ;
    rdfs:label "16 elemental metals (Ag, Al, Au, Cr, Cu, Mg, Mo, Ni, Pb, Pd, Pt, Ta, Ti, V, W, Zr) and their alloys under diverse deformation states" ;
    mlips:materialClass "Metals and multicomponent alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-shuang2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-shuang2026 mlips:hasDFTSettings entity:calc-settings-pbe-shuang2026 .

entity:calc-settings-pbe-shuang2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack, reciprocal density 2 pi x 0.03 1/A (VASPKIT)" ;
    rdfs:comment "EDIFF 1e-6 eV (for newly generated configurations)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-unep-shuang2026 a mlips:TrainingDataset ;
    rdfs:label "UNEP-v1 training set of Ref. [38] (16 metals, unary and binary structures)" ;
    mlips:coversMaterial entity:mat-metals16-shuang2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbe-shuang2026 ;
    rdfs:comment "Zenodo 10.5281/zenodo.11533864." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasImplementation entity:impl-NEP-shuang2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-NEP-shuang2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-shuang2026 .

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-GRACE-shuang2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:impl-GRACE-shuang2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-gracemaker-shuang2026 .

entity:lib-GPUMD-shuang2026 a mlips:Library ;
    rdfs:label "GPUMD" ;
    rdfs:comment "GPUMD v5.0 for inference benchmarks" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-gracemaker-shuang2026 a mlips:Library ;
    rdfs:label "gracemaker" ;
    rdfs:comment "GRACE / tensorpotential; LAMMPS with Kokkos" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-grace-fs-s-cutoffRadius-shuang2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-grace-fs-m-cutoffRadius-shuang2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-grace-fs-l-cutoffRadius-shuang2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-grace-2l-cutoffRadius-shuang2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-unep-v1-shuang2026 a mlips:MLIPRun ;
    rdfs:label "UNEP-v1 (NEP4) as published in Ref. [38] (not retrained)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:produces entity:model-unep-v1-shuang2026 .

entity:model-unep-v1-shuang2026 a mlips:TrainedModel ;
    rdfs:label "UNEP-v1 (70,401 parameters)" .

entity:run-grace-fs-s-shuang2026 a mlips:MLIPRun ;
    rdfs:label "GRACE-FS-S trained on the UNEP-v1 data" ;
    mlips:appliesMethod entity:GRACE ;
    mlips:runsOn entity:ds-unep-shuang2026 ;
    mlips:hasHyperparameterSetting entity:setting-grace-fs-s-cutoffRadius-shuang2026 ;
    mlips:produces entity:model-grace-fs-s-shuang2026 .

entity:model-grace-fs-s-shuang2026 a mlips:TrainedModel ;
    rdfs:label "GRACE-FS-S (9,312 parameters)" .

entity:run-grace-fs-m-shuang2026 a mlips:MLIPRun ;
    rdfs:label "GRACE-FS-M trained on the UNEP-v1 data" ;
    mlips:appliesMethod entity:GRACE ;
    mlips:runsOn entity:ds-unep-shuang2026 ;
    mlips:hasHyperparameterSetting entity:setting-grace-fs-m-cutoffRadius-shuang2026 ;
    mlips:gpuHours "24"^^xsd:double ;
    mlips:trainingHardware "Single NVIDIA A100 GPU, converged within one day in fewer than 2,000 epochs" ;
    mlips:produces entity:model-grace-fs-m-shuang2026 .

entity:model-grace-fs-m-shuang2026 a mlips:TrainedModel ;
    rdfs:label "GRACE-FS-M (17,824 parameters)" .

entity:run-grace-fs-l-shuang2026 a mlips:MLIPRun ;
    rdfs:label "GRACE-FS-L trained on the UNEP-v1 data" ;
    mlips:appliesMethod entity:GRACE ;
    mlips:runsOn entity:ds-unep-shuang2026 ;
    mlips:hasHyperparameterSetting entity:setting-grace-fs-l-cutoffRadius-shuang2026 ;
    mlips:produces entity:model-grace-fs-l-shuang2026 .

entity:model-grace-fs-l-shuang2026 a mlips:TrainedModel ;
    rdfs:label "GRACE-FS-L (28,592 parameters)" .

entity:run-grace-2l-shuang2026 a mlips:MLIPRun ;
    rdfs:label "GRACE-2L (two-layer graph model) trained on the UNEP-v1 data" ;
    mlips:appliesMethod entity:GRACE ;
    mlips:runsOn entity:ds-unep-shuang2026 ;
    mlips:hasHyperparameterSetting entity:setting-grace-2l-cutoffRadius-shuang2026 ;
    mlips:produces entity:model-grace-2l-shuang2026 .

entity:model-grace-2l-shuang2026 a mlips:TrainedModel ;
