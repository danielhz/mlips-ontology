# Canonical Turtle for the protocol-derived encoding of:
#   Gubaev, Zaverkin, Srinivasan, Duff, Kaestner, Grabowski.
#   Performance of two complementary machine-learned potentials in
#   modelling chemically complex systems.
#   npj Comp. Mat. 9, 129 (2023).
#   doi:10.1038/s41524-023-01073-w
#
# Encoding scope: this paper trains two MLIP families side-by-side
# on the TaVCrW BCC refractory high-entropy alloy: a Moment Tensor
# Potential (MTP) and a Gaussian-Moment Neural Network (GM-NN),
# from a shared 6711-configuration DFT training/validation set. We
# encode the MTP arm here, mirroring the Kumar-2025 worked example
# (the same Grabowski-group MTP/MLIP-2 toolchain), and document the
# GM-NN arm + cross-method comparison in Q12. A sibling file
# gubaev2023-gmnn.ttl could cover the GM-NN pass.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex:     <https://example.org/mlips/kg/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

ex:study-gubaev2023 a mlips:BenchmarkStudy ;
    rdfs:label "Gubaev et al. (2023): MTP for TaVCrW BCC refractory high-entropy alloy" ;
    mlips:reportedIn ex:article-gubaev2023 .

ex:article-gubaev2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-023-01073-w> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Performance of two complementary machine-learned potentials in modelling chemically complex systems" .

###############################################################################
# Q2 -- Material system
###############################################################################

ex:mat-TaVCrW a mlips:MaterialSystem ;
    rdfs:label "TaVCrW equiatomic BCC refractory high-entropy alloy (with binary, ternary, and quaternary subsystems)" ;
    mlips:chemicalFormula "TaVCrW" ;
    mlips:materialClass "Refractory high-entropy alloy, BCC (Im-3m), four equiatomic constituents (Ta, V, Cr, W); training set spans 2-, 3-, and 4-component BCC subsystems plus a deformed B2/B2 phase-segregated quaternary used as out-of-distribution test" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

ex:dft-TaVCrW a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

ex:dft-TaVCrW mlips:hasDFTSettings ex:dft-settings-TaVCrW .

ex:dft-settings-TaVCrW a mlips:DFTSettings ;
    mlips:usedDFTCode ex:lib-vasp ;
    mlips:xcFunctional "PBE (GGA)" ;
    mlips:pseudopotentialType "PAW (11 valence electrons for Ta and V; 12 for Cr and W; spin-unpolarized)" ;
    mlips:energyCutoff 350 ;
    mlips:kPointMesh "Automatic k-mesh with KSPACING=0.12, Methfessel-Paxton smearing of order 1 with sigma=0.1" .

ex:lib-vasp a mlips:Library ;
    rdfs:label "VASP" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

ex:ds-TaVCrW a mlips:TrainingDataset ;
    rdfs:label "TaVCrW MTP+GM-NN training+validation set: 6711 DFT configurations (5680 at 0 K = 4491 binary + 595 ternary + 594 quaternary; plus 1031 MD-sampled at 2500 K)" ;
    mlips:coversMaterial ex:mat-TaVCrW ;
    mlips:coversProperty mlips:Energy , mlips:Forces , mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 6711 ;
    mlips:hasDFTCalculation ex:dft-TaVCrW .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

ex:ds-TaVCrW mlips:samplingStrategy
    ex:enumlib-sampling-gubaev2023 ,
    ex:vib-sampling-gubaev2023 ,
    ex:active-learning-sampling-gubaev2023 ,
    ex:deformed-binary-sampling-gubaev2023 .

ex:enumlib-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "0 K small-supercell enumeration (enumlib)" ;
    rdfs:comment "0 K configurations in 2-8 atom supercells generated with the enumlib library; non-repetitive symmetries are enumerated and 2500 binary structures are sampled (plus ternaries, plus equiatomic and off-equiatomic quaternaries)." .

ex:vib-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling (DFT MD at 2500 K)" ;
    rdfs:comment "1031 unrelaxed snapshots from DFT MD at 2500 K (close to the melting point), spanning the disordered TaVCrW phase and its compositional subsystems." .

ex:active-learning-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "Active learning (MaxVol extrapolation grade)" ;
    rdfs:comment "Iterative dataset growth: an MD trajectory using the current MTP is mined for configurations whose extrapolation grade exceeds a threshold; selected configurations are re-computed with DFT and added to the training data, then the MTP is retrained. The same configurations are reused for the GM-NN comparison." .

ex:deformed-binary-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "Deformed-binary phase-segregation sampling" ;
    rdfs:comment "432-atom B2/B2 deformed quaternary structures constructed by joining strained binary halves (TaV +3.7%, CrW -1.28%, TaCr +0.27%, VW -0.14%, TaW +4.06%, VCr -4.71%) along [100], used as a test set for the phase-segregated quaternary." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

ex:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasFunctionalForm ex:mtp-functional-form ;
    mlips:hasLossFunction ex:mtp-loss-gubaev2023 ;
    mlips:hasHyperparameter ex:hp-rcut-gubaev2023 , ex:hp-levmax-gubaev2023 ;
    mlips:hasImplementation ex:mlip-package-gubaev2023 .

ex:mtp-functional-form a mlips:FunctionalForm ;
    rdfs:label "MTP moment-tensor polynomial with level-restricted basis (lev_max controls the radial+angular truncation)" .

ex:mtp-loss-gubaev2023 a mlips:LossFunction ;
    rdfs:label "Weighted MSE on energies, forces, and stresses with weights w_E=1/N_at, w_f=0.1, w_sigma=0.001" .

ex:mlip-package-gubaev2023 a mlips:Implementation ;
    mlips:implementedIn ex:lib-mlip .

ex:lib-mlip a mlips:Library ;
    rdfs:label "MLIP package" ;
    schema:url <https://gitlab.com/ashapeev/mlip-2> .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

ex:setting-rcut-50-gubaev2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-gubaev2023 ;
    mlips:settingValue "5.0" .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

ex:run-mtp-TaVCrW a mlips:MLIPRun ;
    rdfs:label "MTP training run on the TaVCrW HEA dataset (6711 configurations)" ;
    mlips:appliesMethod ex:MTP ;
    mlips:runsOn ex:ds-TaVCrW ;
    mlips:hasHyperparameterSetting ex:setting-rcut-50-gubaev2023 ;
    mlips:produces ex:model-mtp-TaVCrW .

ex:model-mtp-TaVCrW a mlips:TrainedModel ;
    rdfs:label "TaVCrW MTP" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

ex:study-gubaev2023 mlips:hasResult ex:result-mtp-energy-gubaev2023 , ex:result-mtp-forces-gubaev2023 .

ex:result-mtp-energy-gubaev2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TaVCrW ;
    mlips:targetMaterial ex:mat-TaVCrW ;
    mlips:hasAccuracyMetric ex:metric-rmse-energy-gubaev2023 .

ex:metric-rmse-energy-gubaev2023 a mlips:AccuracyMetric ;
    rdfs:label "Overall RMSE in predicted energy across in-distribution Ta-V-Cr-W subsystems (Table 1, MTP)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue 2.43 ;
    mlips:hasUnit unit:MeV-PER-ATOM .

ex:result-mtp-forces-gubaev2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TaVCrW ;
    mlips:targetMaterial ex:mat-TaVCrW ;
    mlips:hasAccuracyMetric ex:metric-rmse-forces-gubaev2023 .

ex:metric-rmse-forces-gubaev2023 a mlips:AccuracyMetric ;
    rdfs:label "Overall RMSE in predicted atomic forces across in-distribution Ta-V-Cr-W subsystems (Table 1, MTP)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue 0.054 ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Gubaev et al. (2023) reports relative comparisons (MTP vs GM-NN
# convergence with training-set size, MTP vs GM-NN execution speed)
# but no absolute training duration, GPU/CPU hours, training
# hardware, peak memory, or per-atom inference time. Recorded as a
# Q12 gap.
