# Canonical Turtle for the protocol-derived encoding of:
#   Gubaev, Zaverkin, Srinivasan, Duff, Kaestner, Grabowski.
#   Performance of two complementary machine-learned potentials in
#   modelling chemically complex systems.
#   npj Comp. Mat. 9, 129 (2023).
#   doi:10.1038/s41524-023-01073-w
#
# Encoding scope: this paper trains two MLIP families side-by-side
# on the TaVCrW BCC refractory high-entropy alloy: a Moment Tensor
# Potential (MTP) and a Gaussian-Moment Neural Network (GM-NN),
# from a shared 6711-configuration DFT training/validation set. We
# encode the MTP arm here, mirroring the Kumar-2025 worked example
# (the same Grabowski-group MTP/MLIP-2 toolchain), and document the
# GM-NN arm + cross-method comparison in Q12. A sibling file
# gubaev2023-gmnn.ttl could cover the GM-NN pass.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gubaev2023 a mlips:BenchmarkStudy ;
    rdfs:label "Gubaev et al. (2023): MTP for TaVCrW BCC refractory high-entropy alloy" ;
    mlips:reportedIn entity:article-gubaev2023 .

entity:article-gubaev2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-023-01073-w> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Performance of two complementary machine-learned potentials in modelling chemically complex systems" ;
    schema:author
        <https://orcid.org/0000-0003-2612-8515> ,
        <https://orcid.org/0000-0001-9940-8548> ,
        <https://orcid.org/0000-0002-9199-4340> ,
        <https://orcid.org/0000-0002-5073-4112> ,
        <https://orcid.org/0000-0001-6178-7669> ,
        <https://orcid.org/0000-0003-4281-5665> .

<https://orcid.org/0000-0003-2612-8515> a schema:Person ;
    schema:name "Konstantin Gubaev" ;
    schema:givenName "Konstantin" ;
    schema:familyName "Gubaev" ;
    schema:identifier <https://orcid.org/0000-0003-2612-8515> .

<https://orcid.org/0000-0001-9940-8548> a schema:Person ;
    schema:name "Viktor Zaverkin" ;
    schema:givenName "Viktor" ;
    schema:familyName "Zaverkin" ;
    schema:identifier <https://orcid.org/0000-0001-9940-8548> .

<https://orcid.org/0000-0002-9199-4340> a schema:Person ;
    schema:name "Prashanth Srinivasan" ;
    schema:givenName "Prashanth" ;
    schema:familyName "Srinivasan" ;
    schema:identifier <https://orcid.org/0000-0002-9199-4340> .

<https://orcid.org/0000-0002-5073-4112> a schema:Person ;
    schema:name "Andrew Ian Duff" ;
    schema:givenName "Andrew Ian" ;
    schema:familyName "Duff" ;
    schema:identifier <https://orcid.org/0000-0002-5073-4112> .

<https://orcid.org/0000-0001-6178-7669> a schema:Person ;
    schema:name "Johannes Kästner" ;
    schema:givenName "Johannes" ;
    schema:familyName "Kästner" ;
    schema:identifier <https://orcid.org/0000-0001-6178-7669> .

<https://orcid.org/0000-0003-4281-5665> a schema:Person ;
    schema:name "Blazej Grabowski" ;
    schema:givenName "Blazej" ;
    schema:familyName "Grabowski" ;
    schema:identifier <https://orcid.org/0000-0003-4281-5665> .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-TaVCrW a mlips:MaterialSystem ;
    rdfs:label "TaVCrW equiatomic BCC refractory high-entropy alloy (with binary, ternary, and quaternary subsystems)" ;
    mlips:chemicalFormula "TaVCrW" ;
    mlips:materialClass "Refractory high-entropy alloy, BCC (Im-3m), four equiatomic constituents (Ta, V, Cr, W); training set spans 2-, 3-, and 4-component BCC subsystems plus a deformed B2/B2 phase-segregated quaternary used as out-of-distribution test" ;
    rdfs:comment "Wikidata Q18405127 ('high entropy alloy') is the most generic appropriate entry; TaVCrW itself has no Wikidata entry as of 2026-04-28." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q18405127> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-TaVCrW a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-TaVCrW mlips:hasDFTSettings entity:dft-settings-TaVCrW .

entity:dft-settings-TaVCrW a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "350"^^xsd:double ;
    mlips:kPointMesh "Automatic k-mesh with KSPACING=0.12, Methfessel-Paxton smearing of order 1 with sigma=0.1" ;
    rdfs:comment "11 valence electrons for Ta and V; 12 for Cr and W; spin-unpolarised." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-TaVCrW a mlips:TrainingDataset ;
    rdfs:label "TaVCrW MTP+GM-NN training+validation set: 6711 DFT configurations (5680 at 0 K = 4491 binary + 595 ternary + 594 quaternary; plus 1031 MD-sampled at 2500 K)" ;
    mlips:coversMaterial entity:mat-TaVCrW ;
    mlips:coversProperty mlips:Energy , mlips:Forces , mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 6711 ;
    mlips:hasDFTCalculation entity:dft-TaVCrW .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-TaVCrW mlips:samplingStrategy
    entity:enumlib-sampling-gubaev2023 ,
    entity:vib-sampling-gubaev2023 ,
    entity:active-learning-sampling-gubaev2023 ,
    entity:deformed-binary-sampling-gubaev2023 .

entity:enumlib-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "0 K small-supercell enumeration (enumlib)" ;
    rdfs:comment "0 K configurations in 2-8 atom supercells generated with the enumlib library; non-repetitive symmetries are enumerated and 2500 binary structures are sampled (plus ternaries, plus equiatomic and off-equiatomic quaternaries)." .

entity:vib-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling (DFT MD at 2500 K)" ;
    rdfs:comment "1031 unrelaxed snapshots from DFT MD at 2500 K (close to the melting point), spanning the disordered TaVCrW phase and its compositional subsystems." .

entity:active-learning-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "Active learning (MaxVol extrapolation grade)" ;
    rdfs:comment "Iterative dataset growth: an MD trajectory using the current MTP is mined for configurations whose extrapolation grade exceeds a threshold; selected configurations are re-computed with DFT and added to the training data, then the MTP is retrained. The same configurations are reused for the GM-NN comparison." .

entity:deformed-binary-sampling-gubaev2023 a mlips:SamplingStrategy ;
    rdfs:label "Deformed-binary phase-segregation sampling" ;
    rdfs:comment "432-atom B2/B2 deformed quaternary structures constructed by joining strained binary halves (TaV +3.7%, CrW -1.28%, TaCr +0.27%, VW -0.14%, TaW +4.06%, VCr -4.71%) along [100], used as a test set for the phase-segregated quaternary." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    mlips:supportsSimulation mlips:MolecularDynamics, mlips:ThermodynamicIntegration ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasFunctionalForm entity:mtp-functional-form;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:mtp-loss-gubaev2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius , mlips:momentLevel ;
    mlips:hasImplementation entity:mlip-package-gubaev2023 .

entity:mtp-functional-form a mlips:FunctionalForm ;
    rdfs:label "MTP moment-tensor polynomial with level-restricted basis (lev_max controls the radial+angular truncation)" .

entity:mtp-loss-gubaev2023 a mlips:LossFunction ;
    rdfs:label "Weighted MSE on energies, forces, and stresses with weights w_E=1/N_at, w_f=0.1, w_sigma=0.001" .

entity:mlip-package-gubaev2023 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-50-gubaev2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-mtp-TaVCrW a mlips:MLIPRun ;
    rdfs:label "MTP training run on the TaVCrW HEA dataset (6711 configurations)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-TaVCrW ;
    mlips:hasHyperparameterSetting entity:setting-rcut-50-gubaev2023 ;
    mlips:produces entity:model-mtp-TaVCrW .

entity:model-mtp-TaVCrW a mlips:TrainedModel ;
    rdfs:label "TaVCrW MTP" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-gubaev2023 mlips:hasResult entity:result-mtp-energy-gubaev2023 , entity:result-mtp-forces-gubaev2023 .

entity:result-mtp-energy-gubaev2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-TaVCrW ;
    mlips:targetMaterial entity:mat-TaVCrW ;
    mlips:hasAccuracyMetric entity:metric-rmse-energy-gubaev2023 .

entity:metric-rmse-energy-gubaev2023 a mlips:AccuracyMetric ;
    rdfs:label "Overall RMSE in predicted energy across in-distribution Ta-V-Cr-W subsystems (Table 1, MTP)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "2.43"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:result-mtp-forces-gubaev2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mtp-TaVCrW ;
    mlips:targetMaterial entity:mat-TaVCrW ;
    mlips:hasAccuracyMetric entity:metric-rmse-forces-gubaev2023 .

entity:metric-rmse-forces-gubaev2023 a mlips:AccuracyMetric ;
    rdfs:label "Overall RMSE in predicted atomic forces across in-distribution Ta-V-Cr-W subsystems (Table 1, MTP)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.054"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Gubaev et al. (2023) reports relative comparisons (MTP vs GM-NN
# convergence with training-set size, MTP vs GM-NN execution speed)
# but no absolute training duration, GPU/CPU hours, training
# hardware, peak memory, or per-atom inference time. Recorded as a
# Q12 gap.

# schema:affiliation links added by issue-0005 sweep.
<https://orcid.org/0000-0003-2612-8515> schema:affiliation mlips:UniversityofStuttgart .
<https://orcid.org/0000-0001-9940-8548> schema:affiliation mlips:UniversityofStuttgart .
<https://orcid.org/0000-0002-9199-4340> schema:affiliation mlips:UniversityofStuttgart .
<https://orcid.org/0000-0002-5073-4112> schema:affiliation entity:org-DaresburyLaboratory-gubaev2023 .
<https://orcid.org/0000-0001-6178-7669> schema:affiliation mlips:UniversityofStuttgart .
<https://orcid.org/0000-0003-4281-5665> schema:affiliation mlips:UniversityofStuttgart .

entity:org-DaresburyLaboratory-gubaev2023 a schema:Organization ;
    rdfs:label "Daresbury Laboratory" ;
    schema:name "Daresbury Laboratory" ;
    schema:identifier <https://ror.org/0089bg420> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .
