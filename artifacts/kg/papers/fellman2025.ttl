    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.2"^^xsd:double .

entity:setting-tabgap-al-numSparseConfigs-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "700"^^xsd:integer .

entity:setting-gap-ni-cutoffRadius-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
