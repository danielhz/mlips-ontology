# Canonical Turtle for the protocol-derived encoding of:
#   Aslak Fellman et al. (2025). Fast and accurate machine-learned interatomic potentials for large-scale simulations of Cu, Al, and Ni.
#   Physical Review Materials. doi:10.1103/physrevmaterials.9.053807  arXiv:2408.15779v1
#
# Version read: arxiv-preprint arXiv:2408.15779v1 (sha256 dbef26647f9ede35...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 636 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/fellman2025.yaml.
#
# Encoding scope: the six potentials of the paper, a SOAP-GAP and a
# tabulated GAP (2b + 3b + EAM descriptors, tabGAP) for each of Cu, Al and
# Ni, with ZBL-type repulsion refitted to all-electron dimer data, their
# test RMSEs for crystalline and liquid structures (Table II) and the
# single-core CPU cost (Table III). Material properties, threshold
# displacement energies and compression simulations are property results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-fellman2025 a mlips:BenchmarkStudy ;
    rdfs:label "Fellman et al. (2025): GAP and tabGAP potentials for large-scale simulations of Cu, Al and Ni" ;
    mlips:reportedIn entity:article-fellman2025 .

entity:article-fellman2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.9.053807> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Fast and accurate machine-learned interatomic potentials for large-scale simulations of Cu, Al, and Ni" ;
    schema:author <https://orcid.org/0000-0003-3044-6348> ,
        <https://orcid.org/0000-0002-4898-6150> ,
        <https://orcid.org/0000-0001-9058-5652> ,
        <https://orcid.org/0000-0001-6244-1942> ,
        <https://orcid.org/0000-0002-5828-200X> .

<https://orcid.org/0000-0003-3044-6348> a schema:Person ;
    schema:name "A. Fellman" ;
    schema:givenName "A." ;
    schema:familyName "Fellman" ;
    schema:identifier <https://orcid.org/0000-0003-3044-6348> .

<https://orcid.org/0000-0002-4898-6150> a schema:Person ;
    schema:name "J. Byggmästar" ;
    schema:givenName "J." ;
    schema:familyName "Byggmästar" ;
    schema:identifier <https://orcid.org/0000-0002-4898-6150> .

<https://orcid.org/0000-0001-9058-5652> a schema:Person ;
    schema:name "F. Granberg" ;
    schema:givenName "F." ;
    schema:familyName "Granberg" ;
