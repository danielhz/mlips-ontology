    schema:givenName "K." ;
    schema:familyName "Nordlund" ;
    schema:identifier <https://orcid.org/0000-0001-6244-1942> .

<https://orcid.org/0000-0002-5828-200X> a schema:Person ;
    schema:name "F. Djurabekova" ;
    schema:givenName "F." ;
    schema:familyName "Djurabekova" ;
    schema:identifier <https://orcid.org/0000-0002-5828-200X> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cu-fellman2025 a mlips:MaterialSystem ;
    rdfs:label "Copper (crystalline, defects, surfaces, liquid, short-range)" ;
    mlips:chemicalFormula "Cu" ;
    mlips:materialClass "fcc metal" .

entity:mat-al-fellman2025 a mlips:MaterialSystem ;
    rdfs:label "Aluminium (crystalline, defects, surfaces, liquid, short-range)" ;
    mlips:chemicalFormula "Al" ;
    mlips:materialClass "fcc metal" .

entity:mat-ni-fellman2025 a mlips:MaterialSystem ;
    rdfs:label "Nickel (crystalline, defects, surfaces, liquid, short-range; ferromagnetic)" ;
    mlips:chemicalFormula "Ni" ;
    mlips:materialClass "fcc metal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-fellman2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-fellman2025 mlips:hasDFTSettings entity:calc-settings-pbe-fellman2025 .

entity:calc-settings-pbe-fellman2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred Monkhorst-Pack, spacing at most 0.15 1/A" ;
    rdfs:comment "PAW Cu_pv, Al, Ni; 0.1 eV Methfessel-Paxton smearing; collinear spin polarisation for Ni only." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cu-fellman2025 a mlips:TrainingDataset ;
    rdfs:label "Cu DFT training set (no trimers)" ;
    mlips:coversMaterial entity:mat-cu-fellman2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-fellman2025 .

entity:ds-al-fellman2025 a mlips:TrainingDataset ;
    rdfs:label "Al DFT training set (no dimers)" ;
    mlips:coversMaterial entity:mat-al-fellman2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-fellman2025 .

entity:ds-ni-fellman2025 a mlips:TrainingDataset ;
    rdfs:label "Ni DFT training set (no trimers)" ;
    mlips:coversMaterial entity:mat-ni-fellman2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-fellman2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cu-fellman2025 mlips:samplingStrategy
    entity:sampling-mixed-fellman2025 .

entity:ds-al-fellman2025 mlips:samplingStrategy
    entity:sampling-mixed-fellman2025 .

entity:ds-ni-fellman2025 mlips:samplingStrategy
    entity:sampling-mixed-fellman2025 .

entity:sampling-mixed-fellman2025 a mlips:SamplingStrategy ;
    rdfs:label "Distorted cells, finite-temperature FCC/BCC/HCP, vacancy and interstitial clusters, liquids, surfaces, stacking-fault-like slabs, dimers/trimers, short-range insertions and rigid-path trajectories; 5-10% per category held out for testing" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-fellman2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-GAP-fellman2025 a mls:Algorithm ;
    rdfs:label "Repulsive ZBL-type potential + 2-body + SOAP (nmax = lmax = 8); regularisation 1 meV/atom, 0.04 eV/A, 0.1 eV (10x for liquids, dense and short-range data)" .

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-tabGAP-fellman2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:alg-tabGAP-fellman2025 a mls:Algorithm ;
    rdfs:label "Repulsion + 2-body + 3-body + EAM-density GAP tabulated on 1D (5000 points) and 3D (80^3) cubic-spline grids" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-cu-cutoffRadius-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-gap-cu-numSparseConfigs-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "2000"^^xsd:integer .

entity:setting-tabgap-cu-cutoffRadius-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.2"^^xsd:double .

