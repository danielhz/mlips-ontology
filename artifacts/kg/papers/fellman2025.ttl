entity:setting-gap-ni-numSparseConfigs-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "2000"^^xsd:integer .

entity:setting-tabgap-ni-cutoffRadius-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.2"^^xsd:double .

entity:setting-tabgap-ni-numSparseConfigs-fellman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "700"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-cu-fellman2025 a mlips:MLIPRun ;
    rdfs:label "GAP (SOAP) for Cu" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-cu-fellman2025 ;
    mlips:hasHyperparameterSetting entity:setting-gap-cu-cutoffRadius-fellman2025 ,
        entity:setting-gap-cu-numSparseConfigs-fellman2025 ;
    mlips:produces entity:model-gap-cu-fellman2025 .

entity:model-gap-cu-fellman2025 a mlips:TrainedModel ;
    rdfs:label "GAP (SOAP) Cu (Fellman 2025)" .

entity:run-tabgap-cu-fellman2025 a mlips:MLIPRun ;
