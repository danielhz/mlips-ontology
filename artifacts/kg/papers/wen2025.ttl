# Canonical Turtle for the protocol-derived encoding of:
#   Mingjian Wen et al. (2025). Cartesian atomic moment machine learning interatomic potentials.
#   npj Computational Materials. doi:10.1038/s41524-025-01623-4  arXiv:2411.12096v2
#
# Version read: arxiv-preprint arXiv:2411.12096v2 (sha256 fc027e454a215710...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 79 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the CAMP method (introduced here) and its benchmark
# fits with the hyperparameters of Tables S4 and S5: the LiPS data set at
# four training sizes (Table 1), liquid water (Table 3), seven MD17
# molecules (Table 4) and bilayer graphene (Table 5). Errors are means
# over five independently trained models.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wen2025 a mlips:BenchmarkStudy ;
    rdfs:label "Wen et al. (2025): Cartesian atomic moment machine learning interatomic potentials (CAMP)" ;
    mlips:reportedIn entity:article-wen2025 .

entity:article-wen2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01623-4> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Cartesian atomic moment machine learning interatomic potentials" ;
    schema:author entity:person-Wen-wen2025 ,
        entity:person-Huang-wen2025 ,
        entity:person-Dai-wen2025 ,
        entity:person-Adhikari-wen2025 .

entity:person-Wen-wen2025 a schema:Person ;
    schema:name "Mingjian Wen" ;
    schema:givenName "Mingjian" ;
    schema:familyName "Wen" .

entity:person-Huang-wen2025 a schema:Person ;
    schema:name "Wei-Fan Huang" ;
    schema:givenName "Wei-Fan" ;
    schema:familyName "Huang" .

entity:person-Dai-wen2025 a schema:Person ;
    schema:name "Jin Dai" ;
    schema:givenName "Jin" ;
    schema:familyName "Dai" .

entity:person-Adhikari-wen2025 a schema:Person ;
    schema:name "Santosh Adhikari" ;
    schema:givenName "Santosh" ;
    schema:familyName "Adhikari" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-LiPS-wen2025 a mlips:MaterialSystem ;
    rdfs:label "Lithium phosphorus sulfide (LiPS) solid electrolyte" ;
    mlips:chemicalFormula "Li-P-S" ;
    mlips:materialClass "Sulfide Li-ion conductor (AIMD configurations)" .

entity:mat-water-wen2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk liquid water" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-bilayer-graphene-wen2025 a mlips:MaterialSystem ;
    rdfs:label "Bilayer graphene in different stacking states" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Two-dimensional layered material" .

entity:mat-aspirin-wen2025 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-ethanol-wen2025 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-malonaldehyde-wen2025 a mlips:MaterialSystem ;
