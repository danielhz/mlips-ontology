entity:sampling-published-benchmark-wen2025 a mlips:SamplingStrategy ;
    rdfs:label "Published benchmark data set with the usual split" ;
    rdfs:comment "LiPS: subsets of 10 to 19000 training samples; water: 1433 training configurations (the data set of 1,593); MD17: 950 training and 50 validation configurations per molecule; bilayer graphene: 5560 training configurations." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CAMP a mlips:MLIPMethod ;
    rdfs:label "Cartesian Atomic Moment Potential (CAMP)" ;
    mlips:hasFunctionalForm entity:ff-CAMP ;
    mlips:hasTrainingAlgorithm entity:alg-CAMP-wen2025 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        entity:hp-max-tensor-rank-wen2025 ,
        mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-CAMP a mlips:FunctionalForm ;
    rdfs:label "Message-passing potential built entirely in Cartesian space: atomic moment tensors of the neighbour density are contracted into hyper moments (analogous to the ACE B-basis), with information flowing from higher-rank tensors to scalars; atomic energies are summed to the total energy" .

entity:alg-CAMP-wen2025 a mls:Algorithm ;
    rdfs:label "Early stopping with a patience of 200 to 800 epochs; architecture chosen by grid search over channels u in {16, 32, 48, 64}, v_max in {2, 3}, layers T in {1, 2, 3} and cutoff in {5, 5.5, 6} A" .

entity:hp-max-tensor-rank-wen2025 a mlips:Hyperparameter ;
    rdfs:label "CAMP maximum tensor rank v_max" ;
    mlips:hyperparameterName "v_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

