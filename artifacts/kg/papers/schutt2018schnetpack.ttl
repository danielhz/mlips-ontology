    mlips:coversMaterial entity:mat-mal-schutt2018schnetpack ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 950 ;
    mlips:hasDFTCalculation entity:calc-md17-schutt2018schnetpack .

