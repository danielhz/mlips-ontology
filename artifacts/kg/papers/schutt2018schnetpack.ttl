# Canonical Turtle for the protocol-derived encoding of:
#   Kristof T. Schütt et al. (2018). SchNetPack: A Deep Learning Toolbox For Atomistic Systems.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.8b00908  arXiv:1809.01072v1
#
# Version read: arxiv-preprint arXiv:1809.01072v1 (sha256 d97dbe2309a9d706...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 543 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/schutt2018schnetpack.yaml.
#
# Encoding scope: the Table I benchmarks of SchNet and Behler-Parrinello
# networks with standard (ACSF) or weighted (wACSF) symmetry functions on
# MD17 malondialdehyde and acetylsalicylic acid (1k and 50k training
# sizes, energies and forces), QM9 U0 and ANI-1 energies (SchNet only),
# all on held-out test sets (Table II). Dipole moments and Materials
# Project formation energies are not interatomic-potential targets and
# are not encoded. wACSF is a descriptor setting of the HDNNP method.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-schutt2018schnetpack a mlips:BenchmarkStudy ;
    rdfs:label "Schutt et al. (2018): SchNetPack, a deep-learning toolbox for atomistic systems, with SchNet and Behler-Parrinello (ACSF, wACSF) benchmarks on MD17, QM9 and ANI-1" ;
    mlips:reportedIn entity:article-schutt2018schnetpack .

entity:article-schutt2018schnetpack a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.8b00908> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "SchNetPack: A Deep Learning Toolbox For Atomistic Systems" ;
    schema:author <https://orcid.org/0000-0001-8342-0964> ,
        entity:person-Kessel-schutt2018schnetpack ,
        entity:person-Gastegger-schutt2018schnetpack ,
        entity:person-Nicoli-schutt2018schnetpack ,
        <https://orcid.org/0000-0002-1012-4854> ,
        entity:person-Muller-schutt2018schnetpack .

<https://orcid.org/0000-0001-8342-0964> a schema:Person ;
    schema:name "K. T. Schütt" ;
    schema:givenName "K. T." ;
    schema:familyName "Schütt" ;
    schema:identifier <https://orcid.org/0000-0001-8342-0964> .

entity:person-Kessel-schutt2018schnetpack a schema:Person ;
    schema:name "P. Kessel" ;
    schema:givenName "P." ;
    schema:familyName "Kessel" .

entity:person-Gastegger-schutt2018schnetpack a schema:Person ;
    schema:name "M. Gastegger" ;
    schema:givenName "M." ;
    schema:familyName "Gastegger" .

entity:person-Nicoli-schutt2018schnetpack a schema:Person ;
    schema:name "K. A. Nicoli" ;
    schema:givenName "K. A." ;
    schema:familyName "Nicoli" .

<https://orcid.org/0000-0002-1012-4854> a schema:Person ;
    schema:name "A. Tkatchenko" ;
    schema:givenName "A." ;
    schema:familyName "Tkatchenko" ;
    schema:identifier <https://orcid.org/0000-0002-1012-4854> .

entity:person-Muller-schutt2018schnetpack a schema:Person ;
    schema:name "K.-R. Müller" ;
    schema:givenName "K.-R." ;
    schema:familyName "Müller" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mal-schutt2018schnetpack a mlips:MaterialSystem ;
    rdfs:label "Malondialdehyde MD trajectory (MD17)" ;
    mlips:materialClass "Small organic molecules (MD trajectories)" .

entity:mat-asp-schutt2018schnetpack a mlips:MaterialSystem ;
    rdfs:label "Acetylsalicylic acid MD trajectory (MD17)" ;
    mlips:materialClass "Small organic molecules (MD trajectories)" .

entity:mat-qm9-schutt2018schnetpack a mlips:MaterialSystem ;
    rdfs:label "QM9 small organic molecules (equilibrium geometries)" ;
    mlips:materialClass "Small organic molecules (equilibrium geometries)" .

entity:mat-ani1-schutt2018schnetpack a mlips:MaterialSystem ;
    rdfs:label "ANI-1 off-equilibrium conformations of small organic molecules" ;
    mlips:materialClass "Organic molecules (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-md17-schutt2018schnetpack a mlips:DFTCalculation .

entity:calc-qm9ref-schutt2018schnetpack a mlips:DFTCalculation .

entity:calc-ani1ref-schutt2018schnetpack a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-md17-schutt2018schnetpack mlips:hasDFTSettings entity:calc-settings-md17-schutt2018schnetpack .

entity:calc-settings-md17-schutt2018schnetpack a mlips:DFTSettings ;
    rdfs:comment "MD17 reference as published" .

entity:calc-qm9ref-schutt2018schnetpack mlips:hasDFTSettings entity:calc-settings-qm9ref-schutt2018schnetpack .

