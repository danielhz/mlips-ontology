###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:hasLossFunction entity:loss-SchNet-schutt2018schnetpack ;
    mlips:hasTrainingAlgorithm entity:alg-SchNet-schutt2018schnetpack ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-SchNet-schutt2018schnetpack ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-SchNet-schutt2018schnetpack a mlips:LossFunction ;
    rdfs:label "Energies, and forces with trade-off rho = 0.1 for MD17" .

entity:alg-SchNet-schutt2018schnetpack a mls:Algorithm ;
    rdfs:label "Adam with learning-rate decay on plateau (factor 0.5, minimum 1e-6)" .

entity:impl-SchNet-schutt2018schnetpack a mlips:Implementation ;
    mlips:implementedIn mlips:SchNet .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-schutt2018schnetpack ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-schutt2018schnetpack ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-HDNNP-schutt2018schnetpack .

entity:loss-HDNNP-schutt2018schnetpack a mlips:LossFunction ;
    rdfs:label "Energies, and forces with trade-off rho = 0.1 for MD17" .

entity:alg-HDNNP-schutt2018schnetpack a mls:Algorithm ;
    rdfs:label "Adam with learning-rate decay on plateau" .

entity:impl-HDNNP-schutt2018schnetpack a mlips:Implementation ;
    mlips:implementedIn entity:lib-SchNetPack-schutt2018schnetpack .

entity:lib-SchNetPack-schutt2018schnetpack a mlips:Library ;
    rdfs:label "SchNetPack" ;
    mlips:candidateForVocabulary mlips:Library .

