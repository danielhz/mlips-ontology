###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-zhang2022 a mlips:MaterialSystem ;
    rdfs:label "Liquid water (bulk, slabs with vacuum, low-density configurations; 128 molecules)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

entity:mat-nacl-zhang2022 a mlips:MaterialSystem ;
    rdfs:label "Crystalline NaCl (2x2x2 supercell, 64 atoms, 100 K)" ;
    mlips:chemicalFormula "NaCl" ;
    mlips:materialClass "Molten salt" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-zhang2022 a mlips:DFTCalculation .

entity:calc-pbe-nacl-zhang2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-zhang2022 mlips:hasDFTSettings entity:calc-settings-pbe-zhang2022 .

entity:calc-settings-pbe-zhang2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "1500"^^xsd:double ;
    rdfs:comment "VASP 5.4.4, EDIFF 1e-6 eV; maximally localised Wannier centres for the DW model (Sec. III A)." .

entity:calc-pbe-nacl-zhang2022 mlips:hasDFTSettings entity:calc-settings-pbe-nacl-zhang2022 .

entity:calc-settings-pbe-nacl-zhang2022 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    mlips:kPointMesh "4x4x4 Monkhorst-Pack" ;
    rdfs:comment "NaCl labels with Wannier distributions (Sec. V)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-water-zhang2022 a mlips:TrainingDataset ;
    rdfs:label "Water DP-GEN data set (583 configurations)" ;
    mlips:coversMaterial entity:mat-water-zhang2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 583 ;
    mlips:hasDFTCalculation entity:calc-pbe-zhang2022 .

entity:ds-nacl-zhang2022 a mlips:TrainingDataset ;
    rdfs:label "NaCl data from a 200 ps DPMD NPT trajectory at 100 K" ;
    mlips:coversMaterial entity:mat-nacl-zhang2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-nacl-zhang2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-water-zhang2022 mlips:samplingStrategy
    entity:sampling-dpgen-zhang2022 .

entity:sampling-dpgen-zhang2022 a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN concurrent learning over 23 iterations (bulk NPT, slab NVT, low-density NVT at 200-400 K), selecting configurations with force deviation 0.15-0.30 eV/A" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-DeePMD-zhang2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:impl-DeePMD-zhang2022 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:DPLR a mlips:MLIPMethod ;
    rdfs:label "DPLR (Deep Potential Long-Range: DP short-range model plus Ewald electrostatics of Gaussian charges at ions and Deep-Wannier centroids)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-DPLR-zhang2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:impl-DPLR-zhang2022 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-water-cutoffRadius-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dp-water-learningRate-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-dp-water-batchSize-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-dp-water-8-cutoffRadius-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-dplr-water-cutoffRadius-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dplr-water-angularCutoff-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-dp-nacl-cutoffRadius-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dplr-nacl-cutoffRadius-zhang2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-water-zhang2022 a mlips:MLIPRun ;
    rdfs:label "Standard DP for water (hybrid descriptor, rc = 6 A)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-water-zhang2022 ;
    mlips:hasHyperparameterSetting entity:setting-dp-water-cutoffRadius-zhang2022 ,
        entity:setting-dp-water-learningRate-zhang2022 ,
        entity:setting-dp-water-batchSize-zhang2022 ;
    mlips:produces entity:model-dp-water-zhang2022 .

entity:model-dp-water-zhang2022 a mlips:TrainedModel ;
    rdfs:label "water DP (rc 6 A)" .

entity:run-dp-water-8-zhang2022 a mlips:MLIPRun ;
    rdfs:label "Standard DP for water with rc = 8 A" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-water-zhang2022 ;
    mlips:hasHyperparameterSetting entity:setting-dp-water-8-cutoffRadius-zhang2022 ;
    mlips:produces entity:model-dp-water-8-zhang2022 .

entity:model-dp-water-8-zhang2022 a mlips:TrainedModel ;
    rdfs:label "water DP (rc 8 A)" .

entity:run-dplr-water-zhang2022 a mlips:MLIPRun ;
    rdfs:label "DPLR for water (beta = 0.4 1/A; Da cutoff 4 A, Dr cutoff 6 A)" ;
    mlips:appliesMethod entity:DPLR ;
    mlips:runsOn entity:ds-water-zhang2022 ;
    mlips:hasHyperparameterSetting entity:setting-dplr-water-cutoffRadius-zhang2022 ,
        entity:setting-dplr-water-angularCutoff-zhang2022 ;
    mlips:produces entity:model-dplr-water-zhang2022 .

entity:model-dplr-water-zhang2022 a mlips:TrainedModel ;
    rdfs:label "water DPLR (beta 0.4)" .

entity:run-dp-nacl-zhang2022 a mlips:MLIPRun ;
    rdfs:label "DP for NaCl (water hyperparameters)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-nacl-zhang2022 ;
    mlips:hasHyperparameterSetting entity:setting-dp-nacl-cutoffRadius-zhang2022 ;
    mlips:produces entity:model-dp-nacl-zhang2022 .

entity:model-dp-nacl-zhang2022 a mlips:TrainedModel ;
    rdfs:label "NaCl DP" .

entity:run-dplr-nacl-zhang2022 a mlips:MLIPRun ;
    rdfs:label "DPLR for NaCl (beta = 0.2 1/A)" ;
    mlips:appliesMethod entity:DPLR ;
    mlips:runsOn entity:ds-nacl-zhang2022 ;
    mlips:hasHyperparameterSetting entity:setting-dplr-nacl-cutoffRadius-zhang2022 ;
    mlips:produces entity:model-dplr-nacl-zhang2022 .

entity:model-dplr-nacl-zhang2022 a mlips:TrainedModel ;
    rdfs:label "NaCl DPLR (beta 0.2)" .

