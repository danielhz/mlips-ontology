    schema:name "A deep potential model with long-range electrostatic interactions" ;
    schema:author <https://orcid.org/0000-0002-8470-5846> ,
        <https://orcid.org/0000-0001-5623-1148> ,
        <https://orcid.org/0000-0001-7961-9807> ,
        <https://orcid.org/0000-0002-8152-6615> ,
