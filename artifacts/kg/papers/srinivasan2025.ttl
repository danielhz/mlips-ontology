@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-srinivasan2025 a mlips:BenchmarkStudy ;
    rdfs:label "Srinivasan et al. (2025): atomic cluster expansion potentials for lithium, solid and liquid phases" ;
    mlips:reportedIn entity:article-srinivasan2025 .

