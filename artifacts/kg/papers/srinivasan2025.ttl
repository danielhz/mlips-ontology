###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Li-srinivasan2025 a mlips:MaterialSystem ;
    rdfs:label "Lithium (bcc, fcc, hcp and 9R solid phases with vacancies, a self-interstitial and surfaces; liquid)" ;
    mlips:chemicalFormula "Li" ;
    mlips:materialClass "Elemental metal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-srinivasan2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-srinivasan2025 mlips:hasDFTSettings entity:calc-settings-dft-srinivasan2025 .

entity:calc-settings-dft-srinivasan2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "450"^^xsd:double ;
    mlips:kPointMesh "4x4x4 grid for 128-atom supercells" ;
    rdfs:comment "One valence electron for Li; Methfessel-Paxton smearing of 0.1 eV. An LDA variant is compared in the supplement." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Li-srinivasan2025 a mlips:TrainingDataset ;
    rdfs:label "Li training set (2500 liquid and 4700 solid snapshots)" ;
    mlips:coversMaterial entity:mat-Li-srinivasan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-srinivasan2025 ;
    rdfs:comment "The total (7200) is the sum of the two stated parts. The validation set is the final 1000 steps of each AIMD run." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Li-srinivasan2025 mlips:samplingStrategy
    entity:sampling-static-srinivasan2025 ,
    entity:sampling-aimd-srinivasan2025 .

entity:sampling-static-srinivasan2025 a mlips:SamplingStrategy ;
    rdfs:label "0 K static calculations: 100 volumes for each of the bcc, fcc, 9R and hcp phases" .

entity:sampling-aimd-srinivasan2025 a mlips:SamplingStrategy ;
    rdfs:label "NVT ab initio MD (2000 steps of 0.5 fs) at 400 K for bulk, defective and surface solid structures at several volumes and at 600-1400 K for the liquid at five volumes each; first 1000 steps for training (one configuration in ten, one in five for fcc), last 1000 for validation" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-srinivasan2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:bodyOrder ,
        entity:hp-nmax-per-order-srinivasan2025 ,
        entity:hp-lmax-per-order-srinivasan2025 ,
        entity:hp-num-parameters-srinivasan2025 ;
    mlips:hasImplementation entity:impl-ACE-srinivasan2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-ACE-srinivasan2025 a mls:Algorithm ;
    rdfs:label "Single-shot fit with BFGS (Pacemaker); Finnis-Sinclair-type energy expansion with spherical Bessel radial functions" .

entity:impl-ACE-srinivasan2025 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE ;
    mlips:version "fitted with Pacemaker; MD with the PACE library in LAMMPS" .

entity:hp-num-parameters-srinivasan2025 a mlips:Hyperparameter ;
    rdfs:label "Total number of fitted parameters" ;
    mlips:hyperparameterName "num_parameters" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-nmax-per-order-srinivasan2025 a mlips:Hyperparameter ;
    rdfs:label "n_max per body-order index T" ;
    mlips:hyperparameterName "nmax_per_order" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lmax-per-order-srinivasan2025 a mlips:Hyperparameter ;
    rdfs:label "l_max per body-order index T" ;
    mlips:hyperparameterName "lmax_per_order" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-Li-cutoffRadius-srinivasan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-Li-bodyOrder-srinivasan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-Li-nmax-per-order-srinivasan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nmax-per-order-srinivasan2025 ;
    mlips:settingValue "15 / 6 / 4" .

entity:setting-Li-lmax-per-order-srinivasan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lmax-per-order-srinivasan2025 ;
    mlips:settingValue "0 / 3 / 3" .

entity:setting-Li-num-parameters-srinivasan2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-num-parameters-srinivasan2025 ;
    mlips:settingValue "1166"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-Li-srinivasan2025 a mlips:MLIPRun ;
    rdfs:label "ACE parametrisation for lithium (primary potential)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-Li-srinivasan2025 ;
    mlips:hasHyperparameterSetting entity:setting-Li-cutoffRadius-srinivasan2025 ,
        entity:setting-Li-bodyOrder-srinivasan2025 ,
        entity:setting-Li-nmax-per-order-srinivasan2025 ,
        entity:setting-Li-lmax-per-order-srinivasan2025 ,
        entity:setting-Li-num-parameters-srinivasan2025 ;
    mlips:produces entity:model-Li-srinivasan2025 .

entity:model-Li-srinivasan2025 a mlips:TrainedModel ;
    rdfs:label "ACE potential for Li" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-srinivasan2025 mlips:hasResult
    entity:result-train-srinivasan2025 ,
    entity:result-validation-srinivasan2025 .

entity:result-train-srinivasan2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-Li-srinivasan2025 ;
    mlips:targetMaterial entity:mat-Li-srinivasan2025 ;
    mlips:hasAccuracyMetric entity:metric-train-1-srinivasan2025 ,
        entity:metric-train-2-srinivasan2025 ,
        entity:metric-train-3-srinivasan2025 ,
        entity:metric-train-4-srinivasan2025 .

entity:metric-train-1-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE, training set" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.81"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-train-2-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy MAE, training set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.79"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-train-3-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Force RMSE, training set" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "11.8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-train-4-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Force MAE, training set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "6.38"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-validation-srinivasan2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-Li-srinivasan2025 ;
    mlips:targetMaterial entity:mat-Li-srinivasan2025 ;
    mlips:hasAccuracyMetric entity:metric-validation-1-srinivasan2025 ,
        entity:metric-validation-2-srinivasan2025 ,
        entity:metric-validation-3-srinivasan2025 ,
        entity:metric-validation-4-srinivasan2025 .

entity:metric-validation-1-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE, validation set" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.64"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-validation-2-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy MAE, validation set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.82"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-validation-3-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Force RMSE, validation set" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "13.17"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-validation-4-srinivasan2025 a mlips:AccuracyMetric ;
    rdfs:label "Force MAE, validation set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "6.17"^^xsd:double ;
