# Canonical Turtle for the protocol-derived encoding of:
#   Martin Hoffmann Petersen et al. (2026). Importance of Configurational Charge Ordering for Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2603.26471  arXiv:2603.26471v2
#
# Version read: arxiv-preprint arXiv:2603.26471v2 (sha256 3df2d31ad968f124...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 315 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/petersen2026.yaml.
#
# Encoding scope: CHGNet, MACE and MACE-LES trained from scratch on Fe-only
# Na polyanion cathode data with and without charge-ordering encoding
# (Fe3+ as a surrogate species), and two MACE models trained on the full
# filtered polyanion data set (Fe, Mn, Co, Ni) with and without encoding,
# with the energy MAE of the latter on an out-of-distribution
# structure-optimisation test set (Table 3). Convex hulls, GA rankings and
# structural MAPEs are not energy/force/stress errors.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-petersen2026 a mlips:BenchmarkStudy ;
    rdfs:label "Petersen et al. (2026): encoding configurational Fe2+/Fe3+ charge ordering into MLIPs for Na polyanion cathodes" ;
    mlips:reportedIn entity:article-petersen2026 .

entity:article-petersen2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2603.26471> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Importance of Configurational Charge Ordering for Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Petersen-petersen2026 ,
        entity:person-Lysgaard-petersen2026 ,
        entity:person-Bhowmik-petersen2026 ,
        entity:person-Hippalgaonkar-petersen2026 ,
        entity:person-Lastra-petersen2026 .

entity:person-Petersen-petersen2026 a schema:Person ;
    schema:name "Martin Hoffmann Petersen" ;
    schema:givenName "Martin Hoffmann" ;
    schema:familyName "Petersen" .

entity:person-Lysgaard-petersen2026 a schema:Person ;
    schema:name "Steen Lysgaard" ;
    schema:givenName "Steen" ;
    schema:familyName "Lysgaard" .

entity:person-Bhowmik-petersen2026 a schema:Person ;
    schema:name "Arghya Bhowmik" ;
    schema:givenName "Arghya" ;
    schema:familyName "Bhowmik" .

entity:person-Hippalgaonkar-petersen2026 a schema:Person ;
    schema:name "Kedar Hippalgaonkar" ;
    schema:givenName "Kedar" ;
    schema:familyName "Hippalgaonkar" .

entity:person-Lastra-petersen2026 a schema:Person ;
    schema:name "Juan Maria Garcia Lastra" ;
    schema:givenName "Juan Maria Garcia" ;
    schema:familyName "Lastra" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-na-fe-petersen2026 a mlips:MaterialSystem ;
    rdfs:label "Fe-based Na polyanion cathodes (olivine and maricite NaFePO4, Na2FeSiO4, Na2.56Fe1.72(SO4)3) at varying Na content" ;
    mlips:materialClass "Na-ion battery cathode materials" .

entity:mat-na-tm-petersen2026 a mlips:MaterialSystem ;
    rdfs:label "Na polyanion cathodes with Fe, Mn, Co and Ni (single and co-doped)" ;
    mlips:materialClass "Na-ion battery cathode materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-u-petersen2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-u-petersen2026 mlips:hasDFTSettings entity:calc-settings-pbe-u-petersen2026 .

entity:calc-settings-pbe-u-petersen2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred 3x1x3" ;
    rdfs:comment "VASP 6.4, Hubbard U_Fe = 5.3 eV, spin-polarised, Gaussian smearing 0.01 eV, EDIFF 1e-5, forces below 0.03 eV/A (polyanion cathode data set protocol)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fe-only-petersen2026 a mlips:TrainingDataset ;
    rdfs:label "Fe-only Na polyanion cathode set after removing transition states and ambiguous magnetic moments (24,766 structures)" ;
    mlips:coversMaterial entity:mat-na-fe-petersen2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 24766 ;
    mlips:hasDFTCalculation entity:calc-pbe-u-petersen2026 .

entity:ds-general-petersen2026 a mlips:TrainingDataset ;
    rdfs:label "Filtered full polyanion sodium cathode data set with unambiguous oxidation states and zero total charge (172,696 structures)" ;
    mlips:coversMaterial entity:mat-na-tm-petersen2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 172696 ;
    mlips:hasDFTCalculation entity:calc-pbe-u-petersen2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasImplementation entity:impl-CHGNet-petersen2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:impl-CHGNet-petersen2026 a mlips:Implementation ;
    mlips:implementedIn mlips:CHGNet .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-petersen2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:impl-MACE-petersen2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:MACE-LES a mlips:MLIPMethod ;
    rdfs:label "MACE with latent Ewald summation (MACE-LES)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chgnet-plain-petersen2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet trained from scratch on Fe-only data, conventional Fe species" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-fe-only-petersen2026 ;
    mlips:produces entity:model-chgnet-plain-petersen2026 .

entity:model-chgnet-plain-petersen2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet (no charge-ordering encoding)" .

entity:run-chgnet-enc-petersen2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet trained from scratch on Fe-only data with Fe3+ encoded as a separate species" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-fe-only-petersen2026 ;
    mlips:produces entity:model-chgnet-enc-petersen2026 .

entity:model-chgnet-enc-petersen2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet (charge-ordering encoded)" .

entity:run-mace-plain-petersen2026 a mlips:MLIPRun ;
