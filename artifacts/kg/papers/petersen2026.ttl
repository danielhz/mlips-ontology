    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-fe-only-petersen2026 ;
    mlips:produces entity:model-mace-enc-petersen2026 .

entity:model-mace-enc-petersen2026 a mlips:TrainedModel ;
    rdfs:label "MACE (charge-ordering encoded)" .

entity:run-maceles-plain-petersen2026 a mlips:MLIPRun ;
    rdfs:label "MACE-LES trained from scratch on Fe-only data, conventional Fe species" ;
    mlips:appliesMethod entity:MACE-LES ;
    mlips:runsOn entity:ds-fe-only-petersen2026 ;
    mlips:produces entity:model-maceles-plain-petersen2026 .

entity:model-maceles-plain-petersen2026 a mlips:TrainedModel ;
