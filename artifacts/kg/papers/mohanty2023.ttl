###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-qrnn-m-mohanty2023 a mlips:MLIPRun ;
    rdfs:label "QRNN-M" ;
    mlips:appliesMethod entity:QRNN ;
    mlips:runsOn entity:ds-m-mohanty2023 ;
    mlips:hasHyperparameterSetting entity:setting-qrnn-m-learningRate-mohanty2023 ,
        entity:setting-qrnn-m-batchSize-mohanty2023 ,
        entity:setting-qrnn-m-numEpochs-mohanty2023 ;
    mlips:produces entity:model-qrnn-m-mohanty2023 .

entity:model-qrnn-m-mohanty2023 a mlips:TrainedModel ;
    rdfs:label "QRNN-M ethylene glycol" .

entity:run-qrnn-md-mohanty2023 a mlips:MLIPRun ;
    rdfs:label "QRNN-M,D" ;
    mlips:appliesMethod entity:QRNN ;
    mlips:runsOn entity:ds-md-mohanty2023 ;
