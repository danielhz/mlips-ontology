    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-qrnn-md-numEpochs-mohanty2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "500"^^xsd:integer .

entity:setting-qrnn-mdt-learningRate-mohanty2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-qrnn-mdt-batchSize-mohanty2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-qrnn-mdt-numEpochs-mohanty2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "500"^^xsd:integer .

entity:setting-qrnn-al-learningRate-mohanty2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
