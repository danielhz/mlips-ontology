entity:run-qrnn-mdt-mohanty2023 a mlips:MLIPRun ;
    rdfs:label "QRNN-M,D,T" ;
    mlips:appliesMethod entity:QRNN ;
    mlips:runsOn entity:ds-mdt-mohanty2023 ;
    mlips:hasHyperparameterSetting entity:setting-qrnn-mdt-learningRate-mohanty2023 ,
        entity:setting-qrnn-mdt-batchSize-mohanty2023 ,
        entity:setting-qrnn-mdt-numEpochs-mohanty2023 ;
    mlips:produces entity:model-qrnn-mdt-mohanty2023 .

entity:model-qrnn-mdt-mohanty2023 a mlips:TrainedModel ;
    rdfs:label "QRNN-M,D,T ethylene glycol" .

entity:run-qrnn-al-mohanty2023 a mlips:MLIPRun ;
    rdfs:label "QRNN after active learning" ;
    mlips:appliesMethod entity:QRNN ;
    mlips:runsOn entity:ds-mdt-al-mohanty2023 ;
    mlips:hasHyperparameterSetting entity:setting-qrnn-al-learningRate-mohanty2023 ,
