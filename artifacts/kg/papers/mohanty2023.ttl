    schema:familyName "Leswing" .

entity:person-Halls-mohanty2023 a schema:Person ;
    schema:name "Mathew D. Halls" ;
    schema:givenName "Mathew D." ;
    schema:familyName "Halls" .

entity:person-Afzal-mohanty2023 a schema:Person ;
    schema:name "Mohammad Atif Faiz Afzal" ;
    schema:givenName "Mohammad Atif Faiz" ;
    schema:familyName "Afzal" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-eg-mohanty2023 a mlips:MaterialSystem ;
    rdfs:label "Ethylene glycol oligomers (mono- to decaethylene glycol) and polymer chains of 25-100 monomers" ;
    mlips:materialClass "Polymers" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97x-mohanty2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97x-mohanty2023 mlips:hasDFTSettings entity:calc-settings-wb97x-mohanty2023 .

entity:calc-settings-wb97x-mohanty2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Psi4-mohanty2023 ;
    mlips:xcFunctional entity:xc-wB97X-D3BJ-mohanty2023 ;
    mlips:basisSet "def2-TZVPD" ;
    rdfs:comment "Energies, forces and dipoles; GFN2-xTB charges as optional charge targets" .

entity:lib-Psi4-mohanty2023 a mlips:Library ;
    rdfs:label "Psi4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-wB97X-D3BJ-mohanty2023 a mlips:XCFunctional ;
    rdfs:label "wB97X-D3BJ" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-m-mohanty2023 a mlips:TrainingDataset ;
    rdfs:label "Monomer (ethylene glycol) conformational and decomposed clusters" ;
    mlips:coversMaterial entity:mat-eg-mohanty2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97x-mohanty2023 .

entity:ds-md-mohanty2023 a mlips:TrainingDataset ;
    rdfs:label "Monomer and dimer clusters" ;
    mlips:coversMaterial entity:mat-eg-mohanty2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97x-mohanty2023 .

entity:ds-mdt-mohanty2023 a mlips:TrainingDataset ;
    rdfs:label "Monomer, dimer and trimer clusters (217,684 DFT-labelled clusters in total before active learning)" ;
    mlips:coversMaterial entity:mat-eg-mohanty2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 217684 ;
    mlips:hasDFTCalculation entity:calc-wb97x-mohanty2023 .

entity:ds-mdt-al-mohanty2023 a mlips:TrainingDataset ;
    rdfs:label "M,D,T clusters extended by two active-learning rounds" ;
    mlips:coversMaterial entity:mat-eg-mohanty2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-wb97x-mohanty2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-m-mohanty2023 mlips:samplingStrategy
    entity:sampling-clusters-mohanty2023 .

entity:ds-md-mohanty2023 mlips:samplingStrategy
    entity:sampling-clusters-mohanty2023 .

entity:ds-mdt-mohanty2023 mlips:samplingStrategy
    entity:sampling-clusters-mohanty2023 .

entity:ds-mdt-al-mohanty2023 mlips:samplingStrategy
    entity:sampling-clusters-mohanty2023 ,
    entity:sampling-al-mohanty2023 .

entity:sampling-clusters-mohanty2023 a mlips:SamplingStrategy ;
    rdfs:label "N-molecule clusters (up to 8 monomers, 6 dimers, 4 trimers) cut from OPLS4 MD, conformational and decomposed (bond-broken) samples" .

entity:sampling-al-mohanty2023 a mlips:SamplingStrategy ;
    rdfs:label "Two active-learning rounds: 5-model committee force variance, top and random samples from about 800,000 generated and about 313,000 QRNN-MD clusters" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:QRNN a mlips:MLIPMethod ;
    rdfs:label "QRNN (charge-recursive neural network potential with charge equilibration, long-range Coulomb and D3 dispersion)" ;
    mlips:hasLossFunction entity:loss-QRNN-mohanty2023 ;
    mlips:hasTrainingAlgorithm entity:alg-QRNN-mohanty2023 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-QRNN-mohanty2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-QRNN-mohanty2023 a mlips:LossFunction ;
    rdfs:label "Multitask loss with learned weights over energies, gradients and charges (dipoles or GFN2-xTB charges)" .

entity:alg-QRNN-mohanty2023 a mls:Algorithm ;
    rdfs:label "Weight normalization, weight decay 1e-4; epochs of 200,000 samples" .

entity:impl-QRNN-mohanty2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-Schrodinger-QRNN-mohanty2023 .

entity:lib-Schrodinger-QRNN-mohanty2023 a mlips:Library ;
    rdfs:label "Schrodinger QRNN" ;
    mlips:candidateForVocabulary mlips:Library .

