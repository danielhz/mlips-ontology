# Canonical Turtle for the protocol-derived encoding of:
#   Shaswat Mohanty et al. (2023). Development of scalable and generalizable machine learned force field for polymers.
#   Scientific Reports. doi:10.1038/s41598-023-43804-5
#
# Version read: publisher (sha256 8419641aa50bbdb6...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 498 (Software/implementation). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/mohanty2023.yaml.
#
# Encoding scope: three QRNN models trained on wB97X-D3BJ/def2-TZVPD
# clusters of ethylene glycol (M), plus diethylene glycol (M,D), plus
# triethylene glycol (M,D,T), and the active-learning extensions. No
# numeric energy/force errors are given in the text read (parity plots in
# the SI); pair scans, densities, diffusivities and other properties are
# not metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mohanty2023 a mlips:BenchmarkStudy ;
    rdfs:label "Mohanty et al. (2023): QRNN machine-learned force fields for ethylene glycol oligomers trained on monomer-to-trimer clusters, with active learning and MD of polymers up to 100 monomers" ;
    mlips:reportedIn entity:article-mohanty2023 .

entity:article-mohanty2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41598-023-43804-5> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Development of scalable and generalizable machine learned force field for polymers" ;
    schema:author entity:person-Mohanty-mohanty2023 ,
        entity:person-Stevenson-mohanty2023 ,
        entity:person-Browning-mohanty2023 ,
        entity:person-Jacobson-mohanty2023 ,
        entity:person-Leswing-mohanty2023 ,
        entity:person-Halls-mohanty2023 ,
        entity:person-Afzal-mohanty2023 .

entity:person-Mohanty-mohanty2023 a schema:Person ;
    schema:name "Shaswat Mohanty" ;
    schema:givenName "Shaswat" ;
    schema:familyName "Mohanty" .

entity:person-Stevenson-mohanty2023 a schema:Person ;
    schema:name "James Stevenson" ;
    schema:givenName "James" ;
    schema:familyName "Stevenson" .

