# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-orb-v3-stracke2026 a mlips:MLIPRun ;
    rdfs:label "Orb-v3 (conservative-inf-omat) as distributed" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb-v3-stracke2026 .

entity:model-orb-v3-stracke2026 a mlips:TrainedModel ;
    rdfs:label "Orb-v3 conservative-inf-omat (trained on OMat)" .

entity:run-mace-1-stracke2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0a as distributed (MACE-1)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-1-stracke2026 .

entity:model-mace-1-stracke2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0a (trained on MPtrj)" .

entity:run-mace-2-stracke2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed (MACE-2)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-2-stracke2026 .

entity:model-mace-2-stracke2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0 (trained on MPtrj and sAlex)" .

entity:run-mace-mof-stracke2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MOF as distributed (MACE-MP-0b medium fine-tuned on 127 MOFs)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mof-stracke2026 .

entity:model-mace-mof-stracke2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MOF" .

