entity:result-bpopnn-sparse-anion-xie2020 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-bpopnn-xie2020 ;
    mlips:targetMaterial entity:mat-lih-xie2020 ;
    mlips:hasAccuracyMetric entity:metric-bpopnn-sparse-anion-1-xie2020 .

entity:metric-bpopnn-sparse-anion-1-xie2020 a mlips:AccuracyMetric ;
