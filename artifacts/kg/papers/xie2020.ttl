# Canonical Turtle for the protocol-derived encoding of:
#   Xiaowei Xie et al. (2020). Incorporating Electronic Information into Machine Learning Potential Energy Surfaces via Approaching the Ground-State Electronic Energy as a Function of Atom-Based Electronic Populations.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.0c00217  arXiv:2003.01893v1
#
# Version read: arxiv-preprint arXiv:2003.01893v1 (sha256 238b1f3b07f37b33...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 612 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/xie2020.yaml.
#
# Encoding scope: the bpopNN model introduced in the paper (registry
# method bpopNN, origin), trained on constrained-DFT (CDFT) energies,
# nuclear forces and population gradients of LinHn clusters in charge
# states +1, 0 and -1, with its validation MAE and the energy MAEs on the
# Li29H29 sparse and Li32H32 non-sparse test sets (Table I). Charge errors,
# geometry-optimisation energies, IP/EA and reaction-path profiles are not
# energy/force error metrics of the potential.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-xie2020 a mlips:BenchmarkStudy ;
    rdfs:label "Xie, Persson and Small (2020): bpopNN, machine-learning PES as a function of atom-based electronic populations" ;
    mlips:reportedIn entity:article-xie2020 .

entity:article-xie2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.0c00217> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Incorporating Electronic Information into Machine Learning Potential Energy Surfaces via Approaching the Ground-State Electronic Energy as a Function of Atom-Based Electronic Populations" ;
    schema:author <https://orcid.org/0000-0001-5618-8768> ,
        <https://orcid.org/0000-0003-2495-5509> ,
        <https://orcid.org/0000-0002-3316-1885> .

<https://orcid.org/0000-0001-5618-8768> a schema:Person ;
    schema:name "Xiaowei Xie" ;
    schema:givenName "Xiaowei" ;
    schema:familyName "Xie" ;
    schema:identifier <https://orcid.org/0000-0001-5618-8768> .

<https://orcid.org/0000-0003-2495-5509> a schema:Person ;
    schema:name "Kristin A. Persson" ;
    schema:givenName "Kristin A." ;
    schema:familyName "Persson" ;
    schema:identifier <https://orcid.org/0000-0003-2495-5509> .

<https://orcid.org/0000-0002-3316-1885> a schema:Person ;
    schema:name "David W. Small" ;
    schema:givenName "David W." ;
    schema:familyName "Small" ;
    schema:identifier <https://orcid.org/0000-0002-3316-1885> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-lih-xie2020 a mlips:MaterialSystem ;
    rdfs:label "LinHn clusters (n = 1-32; sparse LiH assemblies and dense cubic structures; charges +1, 0, -1)" ;
    mlips:materialClass "lithium hydride clusters" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-cdft-xie2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-cdft-xie2020 mlips:hasDFTSettings entity:calc-settings-cdft-xie2020 .

entity:calc-settings-cdft-xie2020 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Q-Chem-xie2020 ;
    mlips:xcFunctional entity:xc-B3LYP-xie2020 ;
    mlips:basisSet "def2-SVPD" ;
    rdfs:comment "Constrained DFT on Becke populations with random charge fluctuations of up to 0.05 e per atom (10 CDFT calculations per geometry and charge state); structures from B3LYP-D3(BJ) or B3LYP optimisations and wB97X-D AIMD at 500 K, all re-labelled with B3LYP." .

entity:lib-Q-Chem-xie2020 a mlips:Library ;
    rdfs:label "Q-Chem" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-B3LYP-xie2020 a mlips:XCFunctional ;
    rdfs:label "B3LYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-lih-cdft-xie2020 a mlips:TrainingDataset ;
    rdfs:label "LinHn CDFT training data (about 37,000 points; 95% train, 5% validation)" ;
    mlips:coversMaterial entity:mat-lih-xie2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-cdft-xie2020 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-lih-cdft-xie2020 mlips:samplingStrategy
    entity:sampling-traj-xie2020 .

entity:sampling-traj-xie2020 a mlips:SamplingStrategy ;
    rdfs:label "Every 2nd-7th frame of DFT geometry-optimisation trajectories (sparse and non-sparse) and 500 K AIMD trajectories (non-sparse)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:bpopNN a mlips:MLIPMethod ;
    rdfs:label "bpopNN (Becke population neural network: atomic NN on a SOAP variant with electron-population channels, plus intra-atomic and pairwise electrostatic terms)" ;
    mlips:hasLossFunction entity:loss-bpopNN-xie2020 ;
    mlips:hasTrainingAlgorithm entity:alg-bpopNN-xie2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-gamma-xie2020 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-bpopNN-xie2020 a mlips:LossFunction ;
    rdfs:label "Per-atom squared errors of CDFT energy, nuclear forces and population gradients (gamma1 = gamma2 = 1.5)" .

entity:alg-bpopNN-xie2020 a mls:Algorithm ;
    rdfs:label "Element-wise NNs with two hidden layers of 30 neurons and a modified softplus; SOAP variant split by element channels with electronic population terms; Adam" .

entity:hp-gamma-xie2020 a mlips:Hyperparameter ;
    rdfs:label "Loss weight of the nuclear-force and population-gradient terms (gamma1 = gamma2)" ;
    mlips:hyperparameterName "gamma" ;
    mlips:hyperparameterDatatype xsd:decimal ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-bpopnn-cutoffRadius-xie2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "13.2"^^xsd:double .

entity:setting-bpopnn-numLayers-xie2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-bpopnn-gamma-xie2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-gamma-xie2020 ;
    mlips:settingValue "1.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-bpopnn-xie2020 a mlips:MLIPRun ;
    rdfs:label "bpopNN model of LinHn clusters" ;
    mlips:appliesMethod entity:bpopNN ;
    mlips:runsOn entity:ds-lih-cdft-xie2020 ;
    mlips:hasHyperparameterSetting entity:setting-bpopnn-cutoffRadius-xie2020 ,
        entity:setting-bpopnn-numLayers-xie2020 ,
        entity:setting-bpopnn-gamma-xie2020 ;
    mlips:produces entity:model-bpopnn-xie2020 .

entity:model-bpopnn-xie2020 a mlips:TrainedModel ;
    rdfs:label "bpopNN (LinHn)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-xie2020 mlips:hasResult
    entity:result-bpopnn-val-xie2020 ,
    entity:result-bpopnn-sparse-neutral-xie2020 ,
    entity:result-bpopnn-sparse-cation-xie2020 ,
    entity:result-bpopnn-sparse-anion-xie2020 ,
    entity:result-bpopnn-dense-neutral-xie2020 ,
    entity:result-bpopnn-dense-cation-xie2020 ,
    entity:result-bpopnn-dense-anion-xie2020 .

entity:result-bpopnn-val-xie2020 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-bpopnn-xie2020 ;
    mlips:targetMaterial entity:mat-lih-xie2020 ;
    mlips:hasAccuracyMetric entity:metric-bpopnn-val-1-xie2020 .

entity:metric-bpopnn-val-1-xie2020 a mlips:AccuracyMetric ;
    rdfs:label "validation energy MAE per molecule on lih: bpopNN" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.523"^^xsd:double ;
    mlips:hasUnit unit:KiloCAL-PER-MOL .

entity:result-bpopnn-sparse-neutral-xie2020 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-bpopnn-xie2020 ;
    mlips:targetMaterial entity:mat-lih-xie2020 ;
    mlips:hasAccuracyMetric entity:metric-bpopnn-sparse-neutral-1-xie2020 .

entity:metric-bpopnn-sparse-neutral-1-xie2020 a mlips:AccuracyMetric ;
    rdfs:label "test energy MAE in kcal/mol/atom on lih (Li29H29 sparse, neutral): bpopNN" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.188"^^xsd:double .

entity:result-bpopnn-sparse-cation-xie2020 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-bpopnn-xie2020 ;
    mlips:targetMaterial entity:mat-lih-xie2020 ;
    mlips:hasAccuracyMetric entity:metric-bpopnn-sparse-cation-1-xie2020 .

entity:metric-bpopnn-sparse-cation-1-xie2020 a mlips:AccuracyMetric ;
    rdfs:label "test energy MAE in kcal/mol/atom on lih (Li29H29 sparse, cation): bpopNN" ;
