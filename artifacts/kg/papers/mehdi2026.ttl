# Canonical Turtle for the protocol-derived encoding of:
#   Shams Mehdi et al. (2026). Knowing when to trust machine-learned interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2605.00640  arXiv:2605.00640v1
#
# Version read: arxiv-preprint arXiv:2605.00640v1 (sha256 e001364cfbdf46fd...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 649 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/mehdi2026.yaml.
#
# Encoding scope: the AIMNet2 models trained by the authors (a 4-model
# ensemble on the 20M-molecule B97-3c data; retrospective active-learning
# cycles selected by PROBE or by ensemble spread, with test RMSEs in
# Table 4) and MACE-OFF23 large used as distributed. PROBE itself is a
# reliability classifier on frozen MLIP embeddings, not a potential; its
# classification metrics are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mehdi2026 a mlips:BenchmarkStudy ;
    rdfs:label "Mehdi, Cho and Isayev (2026): PROBE, knowing when to trust machine-learned interatomic potentials" ;
    mlips:reportedIn entity:article-mehdi2026 .

entity:article-mehdi2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2605.00640> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Knowing when to trust machine-learned interatomic potentials" ;
    schema:author entity:person-Mehdi-mehdi2026 ,
        entity:person-Cho-mehdi2026 ,
        entity:person-Isayev-mehdi2026 .

entity:person-Mehdi-mehdi2026 a schema:Person ;
    schema:name "Shams Mehdi" ;
    schema:givenName "Shams" ;
    schema:familyName "Mehdi" .

entity:person-Cho-mehdi2026 a schema:Person ;
    schema:name "Ilkwon Cho" ;
    schema:givenName "Ilkwon" ;
    schema:familyName "Cho" .

entity:person-Isayev-mehdi2026 a schema:Person ;
    schema:name "Olexandr Isayev" ;
    schema:givenName "Olexandr" ;
    schema:familyName "Isayev" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-organics-mehdi2026 a mlips:MaterialSystem ;
    rdfs:label "Neutral and charged organic molecules (14 elements)" ;
    mlips:materialClass "organic molecules" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-b973c-mehdi2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-b973c-mehdi2026 mlips:hasDFTSettings entity:calc-settings-b973c-mehdi2026 .

entity:calc-settings-b973c-mehdi2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-B97-3c-mehdi2026 ;
    mlips:basisSet "def2-mTZVP" ;
    rdfs:comment "AIMNet2 training data (about 20M hybrid-DFT calculations)." .

entity:xc-B97-3c-mehdi2026 a mlips:XCFunctional ;
    rdfs:label "B97-3c" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-c0-mehdi2026 a mlips:TrainingDataset ;
    rdfs:label "Cycle-0 AIMNet2 training set (1M molecules)" ;
    mlips:coversMaterial entity:mat-organics-mehdi2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-b973c-mehdi2026 .

entity:ds-c2-probe-mehdi2026 a mlips:TrainingDataset ;
    rdfs:label "Cycle-2 training set selected by PROBE (3M molecules)" ;
    mlips:coversMaterial entity:mat-organics-mehdi2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-b973c-mehdi2026 .

entity:ds-c2-ens-mehdi2026 a mlips:TrainingDataset ;
    rdfs:label "Cycle-2 training set selected by ensemble spread (3M molecules)" ;
    mlips:coversMaterial entity:mat-organics-mehdi2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-b973c-mehdi2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-c0-mehdi2026 mlips:samplingStrategy
    entity:sampling-al-mehdi2026 .

entity:ds-c2-probe-mehdi2026 mlips:samplingStrategy
    entity:sampling-al-mehdi2026 .

entity:ds-c2-ens-mehdi2026 mlips:samplingStrategy
    entity:sampling-al-mehdi2026 .

entity:sampling-al-mehdi2026 a mlips:SamplingStrategy ;
    rdfs:label "Retrospective active learning from a fixed pool of about 20M molecules: 1M stratified random molecules (cycle 0), then 1M added per cycle by PROBE P(unreliable) or by ensemble standard deviation" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:AIMNet2 a mlips:MLIPMethod ;
    rdfs:label "AIMNet2 (atoms-in-molecules neural network potential with learned charges and explicit long-range terms)" ;
    mlips:hasTrainingAlgorithm entity:alg-AIMNet2-mehdi2026 .

entity:alg-AIMNet2-mehdi2026 a mls:Algorithm ;
    rdfs:label "Default AIMNet2 architecture and training procedure; parameters carried over between active-learning cycles" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

