# Canonical Turtle for the protocol-derived encoding of:
#   Christoph Schran et al. (2019). Automated Fitting of Neural Network Potentials at Coupled Cluster Accuracy: Protonated Water Clusters as Testing Ground.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.9b00805  arXiv:1908.08734v2
#
# Version read: arxiv-preprint arXiv:1908.08734v2 (sha256 2c06dd9b9d002e64...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 533 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/schran2019.yaml.
#
# Encoding scope: one RuNNer HDNNP for H2O and H3O+ to H9O4+, trained on
# energies only at CCSD(T*)-F12a/aug-cc-pVTZ for configurations selected
# automatically (two-network disagreement on DFT AIMD/AI-PIMD
# ensembles, then extrapolation detection in NNP-MD/PIMD); training and
# test energy RMSEs per cluster size (Table I) and the MADs printed in
# Fig. 3. Errors are in kJ/mol per atom (outside the schema units) and
# kept with unit null. Binding energies, frequencies and dynamics are
# properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-schran2019 a mlips:BenchmarkStudy ;
    rdfs:label "Schran, Behler and Marx (2019): automated fitting of a CCSD(T*)-F12a neural network potential for protonated water clusters H3O+ to H9O4+" ;
    mlips:reportedIn entity:article-schran2019 .

entity:article-schran2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.9b00805> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "Automated Fitting of Neural Network Potentials at Coupled Cluster Accuracy: Protonated Water Clusters as Testing Ground" ;
    schema:author <https://orcid.org/0000-0003-4595-5073> ,
        <https://orcid.org/0000-0002-1220-1542> ,
        entity:person-Marx-schran2019 .

<https://orcid.org/0000-0003-4595-5073> a schema:Person ;
    schema:name "Christoph Schran" ;
    schema:givenName "Christoph" ;
    schema:familyName "Schran" ;
    schema:identifier <https://orcid.org/0000-0003-4595-5073> .

<https://orcid.org/0000-0002-1220-1542> a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" ;
    schema:identifier <https://orcid.org/0000-0002-1220-1542> .

entity:person-Marx-schran2019 a schema:Person ;
    schema:name "Dominik Marx" ;
    schema:givenName "Dominik" ;
    schema:familyName "Marx" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-clusters-schran2019 a mlips:MaterialSystem ;
    rdfs:label "Protonated water clusters H3O+ to H9O4+ (all four H9O4+ isomers) and the water monomer" ;
    mlips:materialClass "Molecular dimers and noncovalent complexes" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-cc-schran2019 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-cc-schran2019 mlips:hasWaveFunctionSettings entity:calc-settings-cc-schran2019 .

entity:calc-settings-cc-schran2019 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "aug-cc-pVTZ" ;
    rdfs:comment "CCSD(T*)-F12a with size-consistent triples scaling (Molpro), energies only" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cc-schran2019 a mlips:TrainingDataset ;
    rdfs:label "CCSD(T*)-F12a reference set (49,242 training and 5,470 test structures)" ;
    mlips:coversMaterial entity:mat-clusters-schran2019 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 49242 ;
    mlips:hasReferenceCalculation entity:calc-cc-schran2019 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cc-schran2019 mlips:samplingStrategy
    entity:sampling-auto-schran2019 .

entity:sampling-auto-schran2019 a mlips:SamplingStrategy ;
    rdfs:label "Configurations from RPBE-D3 AIMD and AI-PIMD (300 K) selected by maximal disagreement of two NNPs (at least 80 stages of 20 points), then extrapolated structures from NNP-MD (10-600 K) and NNP-PIMD (1.67-300 K) and constrained MD for H9O4+ isomerization" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-schran2019 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-schran2019 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-HDNNP-schran2019 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:ThermodynamicIntegration .

entity:loss-HDNNP-schran2019 a mlips:LossFunction ;
    rdfs:label "Energies only" .

entity:alg-HDNNP-schran2019 a mls:Algorithm ;
    rdfs:label "Adaptive global extended Kalman filter; 90/10 train/test split" .

entity:impl-HDNNP-schran2019 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nnp-cutoffRadius-schran2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-nnp-numLayers-schran2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nnp-schran2019 a mlips:MLIPRun ;
    rdfs:label "CCSD(T*)-F12a HDNNP for protonated water clusters" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-cc-schran2019 ;
    mlips:hasHyperparameterSetting entity:setting-nnp-cutoffRadius-schran2019 ,
        entity:setting-nnp-numLayers-schran2019 ;
    mlips:produces entity:model-nnp-schran2019 .

entity:model-nnp-schran2019 a mlips:TrainedModel ;
    rdfs:label "NNP protonated water clusters CCSD(T*)" .

