entity:study-ho2026 a mlips:BenchmarkStudy ;
    rdfs:label "Ho et al. (2026): flexible uncertainty calibration for machine-learned interatomic potentials" ;
    mlips:reportedIn entity:article-ho2026 .

entity:article-ho2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-02080-3> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Flexible uncertainty calibration for machine-learned interatomic potentials" ;
    schema:author entity:person-Ho-ho2026 ,
        entity:person-Ortner-ho2026 ,
        entity:person-Wang-ho2026 .

entity:person-Ho-ho2026 a schema:Person ;
    schema:name "Cheuk Hin Ho" ;
    schema:givenName "Cheuk Hin" ;
    schema:familyName "Ho" .

entity:person-Ortner-ho2026 a schema:Person ;
    schema:name "Christoph Ortner" ;
    schema:givenName "Christoph" ;
    schema:familyName "Ortner" .

entity:person-Wang-ho2026 a schema:Person ;
    schema:name "YangShuai Wang" ;
    schema:givenName "YangShuai" ;
    schema:familyName "Wang" .

