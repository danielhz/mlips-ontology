# Canonical Turtle for the protocol-derived encoding of:
#   Kazuma Ito et al. (2025). Fast and accurate Fe–H machine-learning interatomic potential for elucidating hydrogen embrittlement mechanisms.
#   arXiv (Cornell University). doi:10.1016/j.ijhydene.2026.155600  arXiv:2512.22934v1
#
# Version read: arxiv-preprint arXiv:2512.22934v1 (sha256 598a809873edc099...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 561 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ito2025fast.yaml.
#
# Encoding scope: the pacemaker ACE potential for Fe-H (544 basis
# functions, 4,982 parameters, Fe-Fe cutoff 6.0 A, others 4.5 A) trained
# on the 36,438-structure DP-GEN dataset of the author's earlier work;
# its stated energy and force RMSEs and relative MD cost. Defect,
# segregation, dislocation and fracture results are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ito2025fast a mlips:BenchmarkStudy ;
    rdfs:label "Ito (2025): fast and accurate PACE (ACE) Fe-H potential for hydrogen embrittlement, trained on a concurrent-learning dataset" ;
    mlips:reportedIn entity:article-ito2025fast .

entity:article-ito2025fast a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.ijhydene.2026.155600> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Fast and accurate Fe–H machine-learning interatomic potential for elucidating hydrogen embrittlement mechanisms" ;
    schema:author <https://orcid.org/0000-0002-3456-1055> .

<https://orcid.org/0000-0002-3456-1055> a schema:Person ;
    schema:name "Kazuma Ito" ;
    schema:givenName "Kazuma" ;
    schema:familyName "Ito" ;
    schema:identifier <https://orcid.org/0000-0002-3456-1055> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-feh-ito2025fast a mlips:MaterialSystem ;
    rdfs:label "alpha-Fe with H: stacking faults, surfaces, symmetric tilt grain boundaries, vacancy clusters and H-containing counterparts" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-ito2025fast a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-ito2025fast mlips:hasDFTSettings entity:calc-settings-vasp-ito2025fast .

entity:calc-settings-vasp-ito2025fast a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Settings of Ref. 65" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-feh-ito2025fast a mlips:TrainingDataset ;
    rdfs:label "Fe-H training dataset (36,438 structures, 1,549,196 atomic environments)" ;
    mlips:coversMaterial entity:mat-feh-ito2025fast ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 36438 ;
    mlips:hasDFTCalculation entity:calc-vasp-ito2025fast .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-feh-ito2025fast mlips:samplingStrategy
    entity:sampling-dpgen-ito2025fast .

entity:sampling-dpgen-ito2025fast a mlips:SamplingStrategy ;
    rdfs:label "Initial dataset (six subsets) and DP-GEN concurrent-learning dataset (eight subsets) of Ref. 65 (Table 1)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-ito2025fast ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-ito2025fast ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-nfunc-ito2025fast ;
    mlips:hasImplementation entity:impl-ACE-ito2025fast ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-ACE-ito2025fast a mlips:LossFunction ;
    rdfs:label "Energies and forces with automatic weighting (0.52)" .

entity:alg-ACE-ito2025fast a mls:Algorithm ;
    rdfs:label "BFGS" .

entity:impl-ACE-ito2025fast a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:hp-nfunc-ito2025fast a mlips:Hyperparameter ;
    rdfs:label "Number of ACE basis functions" ;
    mlips:hyperparameterName "number of basis functions" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-pace-cutoffRadius-ito2025fast a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-pace-nfunc-ito2025fast a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-ito2025fast ;
    mlips:settingValue "544"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-pace-ito2025fast a mlips:MLIPRun ;
    rdfs:label "PACE Fe-H potential" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-feh-ito2025fast ;
    mlips:hasHyperparameterSetting entity:setting-pace-cutoffRadius-ito2025fast ,
        entity:setting-pace-nfunc-ito2025fast ;
    mlips:produces entity:model-pace-ito2025fast .

entity:model-pace-ito2025fast a mlips:TrainedModel ;
    rdfs:label "PACE Fe-H (Ito 2025)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-ito2025fast mlips:hasResult
    entity:result-pace-fit-ito2025fast .

entity:result-pace-fit-ito2025fast a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-pace-ito2025fast ;
    mlips:targetMaterial entity:mat-feh-ito2025fast ;
    mlips:hasAccuracyMetric entity:metric-pace-fit-1-ito2025fast ,
        entity:metric-pace-fit-2-ito2025fast .

entity:metric-pace-fit-1-ito2025fast a mlips:AccuracyMetric ;
    rdfs:label "energy RMSE on Fe-H dataset: PACE" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "5.85"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-pace-fit-2-ito2025fast a mlips:AccuracyMetric ;
    rdfs:label "force RMSE on Fe-H dataset: PACE" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "87.26"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# For a 250,000-atom alpha-Fe supercell the PACE potential costs 27 times EAM per atom per step, versus 272 (BNNP-Ito) and 837 (BNNP-Meng) times EAM (Fig. 5b; Sec. 3.1).

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - The RMSEs are not attributed to a training or test split in the text read, so the role is null. BNNP values (4.09 meV/atom, 109.16 meV/A) are from Ref. 65 and not encoded. Hydrogen segregation-energy RMSEs (0.046 and 0.039 eV) are property errors.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/ito2025fast.yaml) until the schema has terms for them.

