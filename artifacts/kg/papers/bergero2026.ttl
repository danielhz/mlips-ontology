# Canonical Turtle for the protocol-derived encoding of:
#   Alexandre Bergero et al. (2026). Machine-learned interatomic potential for sputtering of tungsten-boron surfaces.
#   arXiv (Cornell University). doi:10.48550/arxiv.2608.13038  arXiv:2608.13038v1
#
# Version read: arxiv-preprint arXiv:2608.13038v1 (sha256 ed582f6b2a006468...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 423 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/bergero2026.yaml.
#
# Encoding scope: the W-B training database (pure W from Byggmastar et
# al. 2019 plus bulk B and W-B phases with elastic and thermal
# distortions, liquids, surfaces, adsorption sites, depositions and
# near-surface displacements, built iteratively), the GAP with 2-body,
# 3-body and EAM-density descriptors and screened-Coulomb repulsion
# (QUIP), tabulated as a tabGAP, and its use for sputtering and
# deposition MD. No energy or force errors are stated; bulk moduli,
# lattice constants, surface energies, melting points and sputtering
# yields are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bergero2026 a mlips:BenchmarkStudy ;
    rdfs:label "Bergero et al. (2026): a tabGAP for sputtering and boronization of tungsten-boron surfaces" ;
    mlips:reportedIn entity:article-bergero2026 .

entity:article-bergero2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2608.13038> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Machine-learned interatomic potential for sputtering of tungsten-boron surfaces" ;
    schema:author entity:person-Bergero-bergero2026 ,
        entity:person-Byggmastar-bergero2026 ,
        entity:person-Granberg-bergero2026 .

entity:person-Bergero-bergero2026 a schema:Person ;
    schema:name "Alexandre Bergero" ;
    schema:givenName "Alexandre" ;
    schema:familyName "Bergero" .

entity:person-Byggmastar-bergero2026 a schema:Person ;
    schema:name "Jesper Byggmästar" ;
    schema:givenName "Jesper" ;
    schema:familyName "Byggmästar" .

entity:person-Granberg-bergero2026 a schema:Person ;
    schema:name "Fredric Granberg" ;
    schema:givenName "Fredric" ;
    schema:familyName "Granberg" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-wb-bergero2026 a mlips:MaterialSystem ;
    rdfs:label "Tungsten-boron system: W, alpha/beta-B, WB, WB2, W2B and other W-B phases, surfaces, liquids and B deposited on W" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-bergero2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-bergero2026 mlips:hasDFTSettings entity:calc-settings-pbe-bergero2026 .

entity:calc-settings-pbe-bergero2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "KSPACING 0.15 1/A" ;
    rdfs:comment "W_sv and standard B PAW, Gaussian smearing 0.05 eV, EDIFF 1e-6 eV, PREC Accurate (Methods)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-wb-bergero2026 a mlips:TrainingDataset ;
    rdfs:label "W-B training database (pure W from Ref. 36 plus the B and W-B groups of SI Table I)" ;
    mlips:coversMaterial entity:mat-wb-bergero2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-pbe-bergero2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-wb-bergero2026 mlips:samplingStrategy
    entity:sampling-iter-bergero2026 .

entity:sampling-iter-bergero2026 a mlips:SamplingStrategy ;
    rdfs:label "Iterative sampling: elastic deformations of Materials Project phases, thermal-displacement and melt-quench MD with intermediate potentials, AIMD for surfaces, adsorption-site and deposition snapshots, near-surface atom displacements" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:hasLossFunction entity:loss-tabGAP-bergero2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-tabGAP-bergero2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-tabGAP-bergero2026 a mlips:LossFunction ;
    rdfs:label "GAP regularisation 0.001 eV/atom (energy), 0.05 eV/A (force), 0.6 eV (virial)" .

entity:impl-tabGAP-bergero2026 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-tabgap-wb-cutoffRadius-bergero2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-tabgap-wb-angularCutoff-bergero2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4.1"^^xsd:double .

entity:setting-tabgap-wb-numSparseConfigs-bergero2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "300"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-tabgap-wb-bergero2026 a mlips:MLIPRun ;
    rdfs:label "W-B tabGAP (2-body cutoff 5 A, 3-body cutoff 4.1 A with 300 sparse points, EAM density cutoff 5 A; screened-Coulomb baseline)" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-wb-bergero2026 ;
    mlips:hasHyperparameterSetting entity:setting-tabgap-wb-cutoffRadius-bergero2026 ,
        entity:setting-tabgap-wb-angularCutoff-bergero2026 ,
        entity:setting-tabgap-wb-numSparseConfigs-bergero2026 ;
    mlips:produces entity:model-tabgap-wb-bergero2026 .

entity:model-tabgap-wb-bergero2026 a mlips:TrainedModel ;
    rdfs:label "W-B tabGAP (Bergero 2026)" .

