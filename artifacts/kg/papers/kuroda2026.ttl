# Canonical Turtle for the protocol-derived encoding of:
#   Naoya Kuroda et al. (2026). Expanding Universal Machine Learning Interatomic Potentials to 97 Elements Towards Nuclear Applications.
#   arXiv (Cornell University). doi:10.48550/arxiv.2603.03223  arXiv:2603.03223v1
#
# Version read: arxiv-preprint arXiv:2603.03223v1 (sha256 ce2c25803a0b8c8c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 317 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/kuroda2026.yaml.
#
# Encoding scope: the HE26 heavy-element data set (actinides and other
# heavy elements; built here), MACE-Osaka26 trained on MPtrj, OFF23 and
# HE26 (graph cutoff 6.0 A, 200 epochs), and the comparison with the
# earlier MACE-Osaka24, with energy, force and stress MAEs and RMSEs on the
# MPtrj and OFF23 training and test splits and on the HE26 training set
# (Table I). Lattice-parameter errors and thermal conductivities are
# properties, not energy/force/stress errors.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kuroda2026 a mlips:BenchmarkStudy ;
    rdfs:label "Kuroda et al. (2026): MACE-Osaka26, a 97-element universal MLIP with the heavy-element data set HE26" ;
    mlips:reportedIn entity:article-kuroda2026 .

entity:article-kuroda2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2603.03223> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Expanding Universal Machine Learning Interatomic Potentials to 97 Elements Towards Nuclear Applications" ;
    schema:author entity:person-Kuroda-kuroda2026 ,
        entity:person-Ishihara-kuroda2026 ,
        entity:person-Shiota-kuroda2026 ,
        entity:person-Mizukami-kuroda2026 .

entity:person-Kuroda-kuroda2026 a schema:Person ;
    schema:name "Naoya Kuroda" ;
    schema:givenName "Naoya" ;
    schema:familyName "Kuroda" .

entity:person-Ishihara-kuroda2026 a schema:Person ;
    schema:name "Kenji Ishihara" ;
    schema:givenName "Kenji" ;
    schema:familyName "Ishihara" .

entity:person-Shiota-kuroda2026 a schema:Person ;
    schema:name "Tomoya Shiota" ;
    schema:givenName "Tomoya" ;
    schema:familyName "Shiota" .

entity:person-Mizukami-kuroda2026 a schema:Person ;
    schema:name "Wataru Mizukami" ;
    schema:givenName "Wataru" ;
    schema:familyName "Mizukami" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mptrj-kuroda2026 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals of MPtrj" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-off23-kuroda2026 a mlips:MaterialSystem ;
    rdfs:label "Organic molecules of the MACE-OFF23 data (SPICE-based)" ;
    mlips:materialClass "Organic molecules (gas phase)" .

entity:mat-he26-kuroda2026 a mlips:MaterialSystem ;
    rdfs:label "Heavy-element compounds including minor actinides (Am, Cm, Cf and others): elemental solids, oxides, multi-component and fluorite oxides" ;
    mlips:materialClass "Heavy-element and actinide materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-kuroda2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-kuroda2026 mlips:hasDFTSettings entity:calc-settings-pbe-kuroda2026 .

entity:calc-settings-pbe-kuroda2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    rdfs:comment "HE26 labels: PREC Accurate, EDIFF 1e-5, Gaussian smearing 0.05 eV, LMAXMIX 6, several initial magnetic configurations (lowest energy kept); MPtrj-compatible settings." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-he26-kuroda2026 a mlips:TrainingDataset ;
    rdfs:label "HE26 heavy-element data set (59,438 training structures; no separate test split)" ;
    mlips:coversMaterial entity:mat-he26-kuroda2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 59438 ;
    mlips:hasDFTCalculation entity:calc-pbe-kuroda2026 .

entity:ds-combined-kuroda2026 a mlips:TrainingDataset ;
    rdfs:label "MPtrj (1,502,422 training structures) + OFF23 (951,005) + HE26 (59,438)" ;
    mlips:coversMaterial entity:mat-mptrj-kuroda2026 ,
        entity:mat-off23-kuroda2026 ,
        entity:mat-he26-kuroda2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    rdfs:comment "Combined training data of MACE-Osaka26." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-kuroda2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:impl-MACE-kuroda2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-osaka26-cutoffRadius-kuroda2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-osaka26-numEpochs-kuroda2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-osaka24-kuroda2026 a mlips:MLIPRun ;
    rdfs:label "MACE-Osaka24 as published (graph cutoff 4.5 A; no heavy elements)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-osaka24-kuroda2026 .

entity:model-osaka24-kuroda2026 a mlips:TrainedModel ;
    rdfs:label "MACE-Osaka24" .

entity:run-osaka26-kuroda2026 a mlips:MLIPRun ;
    rdfs:label "MACE-Osaka26 trained on MPtrj + OFF23 + HE26 (97 elements)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-combined-kuroda2026 ;
    mlips:hasHyperparameterSetting entity:setting-osaka26-cutoffRadius-kuroda2026 ,
        entity:setting-osaka26-numEpochs-kuroda2026 ;
    mlips:produces entity:model-osaka26-kuroda2026 .

entity:model-osaka26-kuroda2026 a mlips:TrainedModel ;
    rdfs:label "MACE-Osaka26" .

