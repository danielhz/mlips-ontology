# Canonical Turtle for the protocol-derived encoding of:
#   Bohayra Mortazavi et al. (2020). Machine-learning interatomic potentials enable first-principles multiscale modeling of lattice thermal conductivity in graphene/borophene heterostructures.
#   Materials Horizons. doi:10.1039/d0mh00787k  arXiv:2006.06794v1
#
# Version read: arxiv-preprint arXiv:2006.06794v1 (sha256 5189241e69289074...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 323 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/mortazavi2020.yaml.
#
# Encoding scope: moment tensor potentials trained on short PBE AIMD
# trajectories (with extrapolation-grade selection) for pristine graphene,
# pristine borophene and graphene/borophene heterostructures, used in NEMD
# and BTE thermal-transport calculations feeding a finite-element model.
# The MTP errors are in Supplementary Table S1 (not in the PDF; described
# as 'a few meV'), so no metric is encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mortazavi2020 a mlips:BenchmarkStudy ;
    rdfs:label "Mortazavi et al. (2020): MTP-based multiscale modelling of lattice thermal conductivity in graphene/borophene heterostructures" ;
    mlips:reportedIn entity:article-mortazavi2020 .

entity:article-mortazavi2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/d0mh00787k> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Machine-learning interatomic potentials enable first-principles multiscale modeling of lattice thermal conductivity in graphene/borophene heterostructures" ;
    schema:author <https://orcid.org/0000-0003-3031-5057> ,
        entity:person-Podryabinkin-mortazavi2020 ,
        entity:person-Roche-mortazavi2020 ,
        entity:person-Rabczuk-mortazavi2020 ,
        entity:person-Zhuang-mortazavi2020 ,
        entity:person-Shapeev-mortazavi2020 .

<https://orcid.org/0000-0003-3031-5057> a schema:Person ;
    schema:name "Bohayra Mortazavi" ;
    schema:givenName "Bohayra" ;
    schema:familyName "Mortazavi" ;
    schema:identifier <https://orcid.org/0000-0003-3031-5057> .

entity:person-Podryabinkin-mortazavi2020 a schema:Person ;
    schema:name "Evgeny V. Podryabinkin" ;
    schema:givenName "Evgeny V." ;
    schema:familyName "Podryabinkin" .

entity:person-Roche-mortazavi2020 a schema:Person ;
    schema:name "Stephan Roche" ;
    schema:givenName "Stephan" ;
    schema:familyName "Roche" .

entity:person-Rabczuk-mortazavi2020 a schema:Person ;
    schema:name "Timon Rabczuk" ;
    schema:givenName "Timon" ;
    schema:familyName "Rabczuk" .

entity:person-Zhuang-mortazavi2020 a schema:Person ;
    schema:name "Xiaoying Zhuang" ;
    schema:givenName "Xiaoying" ;
    schema:familyName "Zhuang" .

entity:person-Shapeev-mortazavi2020 a schema:Person ;
    schema:name "Alexander V. Shapeev" ;
    schema:givenName "Alexander V." ;
    schema:familyName "Shapeev" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-graphene-mortazavi2020 a mlips:MaterialSystem ;
    rdfs:label "Graphene" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "2D material" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q623> .

entity:mat-borophene-mortazavi2020 a mlips:MaterialSystem ;
    rdfs:label "Borophene" ;
    mlips:chemicalFormula "B" ;
    mlips:materialClass "2D material" .

entity:mat-gr-b-mortazavi2020 a mlips:MaterialSystem ;
    rdfs:label "Coplanar graphene/borophene heterostructures with ten grain-boundary configurations" ;
    mlips:materialClass "2D lateral heterostructure" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-mortazavi2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-mortazavi2020 mlips:hasDFTSettings entity:calc-settings-pbe-mortazavi2020 .

entity:calc-settings-pbe-mortazavi2020 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "3x3x1 Monkhorst-Pack for AIMD" ;
    rdfs:comment "AIMD with 1 fs time step at 100, 300, 600 and 700 K (fewer than 1,000 steps each)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-graphene-mortazavi2020 a mlips:TrainingDataset ;
    rdfs:label "Graphene AIMD training configurations" ;
    mlips:coversMaterial entity:mat-graphene-mortazavi2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-mortazavi2020 .

entity:ds-borophene-mortazavi2020 a mlips:TrainingDataset ;
    rdfs:label "Borophene AIMD training configurations" ;
    mlips:coversMaterial entity:mat-borophene-mortazavi2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-mortazavi2020 .

entity:ds-hetero-mortazavi2020 a mlips:TrainingDataset ;
    rdfs:label "Heterostructure AIMD training configurations (including the pristine graphene and borophene trajectories)" ;
    mlips:coversMaterial entity:mat-gr-b-mortazavi2020 ,
        entity:mat-graphene-mortazavi2020 ,
        entity:mat-borophene-mortazavi2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-mortazavi2020 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-graphene-mortazavi2020 mlips:samplingStrategy
    entity:sampling-aimd-mortazavi2020 .

entity:ds-borophene-mortazavi2020 mlips:samplingStrategy
    entity:sampling-aimd-mortazavi2020 .

entity:ds-hetero-mortazavi2020 mlips:samplingStrategy
    entity:sampling-aimd-mortazavi2020 .

entity:sampling-aimd-mortazavi2020 a mlips:SamplingStrategy ;
    rdfs:label "Every 10th step of short AIMD trajectories at 100-700 K, plus configurations with high extrapolation grade from the full trajectories" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-mortazavi2020 ;
    mlips:hasImplementation entity:impl-MTP-mortazavi2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:alg-MTP-mortazavi2020 a mls:Algorithm ;
    rdfs:label "Training on subsampled AIMD, then retraining after adding configurations with high extrapolation grades" .

entity:impl-MTP-mortazavi2020 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-graphene-mortazavi2020 a mlips:MLIPRun ;
    rdfs:label "Mono-elemental MTP for graphene" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-graphene-mortazavi2020 ;
    mlips:produces entity:model-mtp-graphene-mortazavi2020 .

entity:model-mtp-graphene-mortazavi2020 a mlips:TrainedModel ;
    rdfs:label "Graphene MTP" .

entity:run-mtp-borophene-mortazavi2020 a mlips:MLIPRun ;
    rdfs:label "Mono-elemental MTP for borophene" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-borophene-mortazavi2020 ;
    mlips:produces entity:model-mtp-borophene-mortazavi2020 .

entity:model-mtp-borophene-mortazavi2020 a mlips:TrainedModel ;
    rdfs:label "Borophene MTP" .

entity:run-mtp-hetero-mortazavi2020 a mlips:MLIPRun ;
    rdfs:label "Binary MTP for graphene/borophene heterostructures" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-hetero-mortazavi2020 ;
    mlips:produces entity:model-mtp-hetero-mortazavi2020 .

entity:model-mtp-hetero-mortazavi2020 a mlips:TrainedModel ;
    rdfs:label "Graphene/borophene MTP" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

