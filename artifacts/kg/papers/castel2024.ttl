###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-l1-r6-castel2024 a mlips:MLIPRun ;
    rdfs:label "Training of NequIP l = 1, r = 6 A" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-rand-castel2024 ;
    mlips:hasHyperparameterSetting entity:setting-l1-r6-cutoffRadius-castel2024 ,
        entity:setting-l1-r6-numLayers-castel2024 ,
        entity:setting-l1-r6-lmax-castel2024 ,
        entity:setting-l1-r6-parity-castel2024 ,
        entity:setting-l1-r6-learningRate-castel2024 ;
    mlips:produces entity:model-l1-r6-castel2024 .

entity:model-l1-r6-castel2024 a mlips:TrainedModel ;
    rdfs:label "NequIP l = 1, r = 6 A model for ZIF-4" ;
    mlips:inferenceHardware "NVIDIA Tesla V100; 240 ms per atom per call as printed in Table 1 (300 calls, 6 for warm-up)" .

entity:run-l2-r4-castel2024 a mlips:MLIPRun ;
    rdfs:label "Training of NequIP l = 2, r = 4 A" ;
