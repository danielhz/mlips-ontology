# Canonical Turtle for the protocol-derived encoding of:
#   Nicolas Castel et al. (2024). Machine learning interatomic potentials for amorphous zeolitic imidazolate frameworks.
#   Digital Discovery. doi:10.1039/d3dd00236e
#
# Version read: publisher (sha256 54c73418471b1db2...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 140 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the NequIP hyperparameter screen and the deployed NequIP
# and Allegro models for ZIF-4, trained on frames of ab initio MD of the
# liquid, with the reference DFT, the two sampling schemes and the
# held-out errors and efficiencies of Table 1.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-castel2024 a mlips:BenchmarkStudy ;
    rdfs:label "Castel et al. (2024): machine learning interatomic potentials for amorphous ZIF-4" ;
    mlips:reportedIn entity:article-castel2024 .

entity:article-castel2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/d3dd00236e> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Machine learning interatomic potentials for amorphous zeolitic imidazolate frameworks" ;
    schema:author entity:person-Castel-castel2024 ,
        entity:person-Andre-castel2024 ,
        entity:person-Edwards-castel2024 ,
        <https://orcid.org/0000-0001-9521-2601> ,
        <https://orcid.org/0000-0001-5318-3910> .

entity:person-Castel-castel2024 a schema:Person ;
    schema:name "Nicolas Castel" ;
    schema:givenName "Nicolas" ;
    schema:familyName "Castel" .

entity:person-Andre-castel2024 a schema:Person ;
    schema:name "Dune André" ;
    schema:givenName "Dune" ;
    schema:familyName "André" .

entity:person-Edwards-castel2024 a schema:Person ;
    schema:name "Connor Edwards" ;
    schema:givenName "Connor" ;
    schema:familyName "Edwards" .

<https://orcid.org/0000-0001-9521-2601> a schema:Person ;
    schema:name "Jack D. Evans" ;
    schema:givenName "Jack D." ;
    schema:familyName "Evans" ;
    schema:identifier <https://orcid.org/0000-0001-9521-2601> .

<https://orcid.org/0000-0001-5318-3910> a schema:Person ;
    schema:name "François-Xavier Coudert" ;
    schema:givenName "François-Xavier" ;
    schema:familyName "Coudert" ;
    schema:identifier <https://orcid.org/0000-0001-5318-3910> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ZIF4-castel2024 a mlips:MaterialSystem ;
    rdfs:label "ZIF-4 (zinc imidazolate framework; liquid, glass and crystal)" ;
    mlips:chemicalFormula "Zn(C3H3N2)2" ;
    mlips:materialClass "Metal-organic framework" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-castel2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-castel2024 mlips:hasDFTSettings entity:calc-settings-dft-castel2024 .

entity:calc-settings-dft-castel2024 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-castel2024 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:dftBasisSet entity:basis-DZVP-double-zeta-valence-polarised-castel2024 ;
    rdfs:comment "PBE with DFT-D3 dispersion; Goedecker-Teter-Hutter pseudopotentials. NVT ab initio MD, 0.5 fs time step." .

entity:lib-CP2K-castel2024 a mlips:Library ;
    rdfs:label "CP2K" ;
    rdfs:comment "Quickstep module of CP2K 6.1." ;
    mlips:candidateForVocabulary mlips:Library .

entity:basis-DZVP-double-zeta-valence-polarised-castel2024 a mlips:DftBasisSet ;
    rdfs:label "DZVP (double-zeta valence polarised)" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-rand-castel2024 a mlips:TrainingDataset ;
    rdfs:label "Random-sampling set (1000 training and 100 test frames)" ;
    mlips:coversMaterial entity:mat-ZIF4-castel2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-dft-castel2024 .

entity:ds-flat-small-castel2024 a mlips:TrainingDataset ;
    rdfs:label "Initial flat-histogram set (964 training and 96 test frames)" ;
    mlips:coversMaterial entity:mat-ZIF4-castel2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 964 ;
    mlips:hasDFTCalculation entity:calc-dft-castel2024 .

entity:ds-flat-castel2024 a mlips:TrainingDataset ;
    rdfs:label "Final flat-histogram set (2357 training and 190 test frames)" ;
    mlips:coversMaterial entity:mat-ZIF4-castel2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2357 ;
    mlips:hasDFTCalculation entity:calc-dft-castel2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-rand-castel2024 mlips:samplingStrategy
    entity:sampling-aimd-castel2024 ,
    entity:sampling-random-castel2024 .

entity:ds-flat-small-castel2024 mlips:samplingStrategy
    entity:sampling-aimd-castel2024 ,
    entity:sampling-flathist-castel2024 .

entity:ds-flat-castel2024 mlips:samplingStrategy
    entity:sampling-aimd-castel2024 ,
    entity:sampling-flathist-castel2024 .

entity:sampling-aimd-castel2024 a mlips:SamplingStrategy ;
    rdfs:label "Ab initio MD of ZIF-4 liquids: four trajectories at four volumes, 1500 K or 1750 K, each over 50 ps (1,189,836 frames in total)" .

entity:sampling-random-castel2024 a mlips:SamplingStrategy ;
    rdfs:label "Random selection of frames from the AIMD trajectories" .

entity:sampling-flathist-castel2024 a mlips:SamplingStrategy ;
    rdfs:label "Flat-histogram selection: frames binned by energy, one random frame per bin" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-castel2024 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-castel2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-lmax-castel2024 ,
        entity:hp-parity-castel2024 ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-NequIP-castel2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-castel2024 a mlips:LossFunction ;
    rdfs:label "Weighted average of potential-energy and force errors (stress tested and not used)" .

entity:alg-NequIP-castel2024 a mls:Algorithm ;
    rdfs:label "Adam" .

entity:impl-NequIP-castel2024 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP ;
    mlips:version "0.5.6" .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-castel2024 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-castel2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        entity:hp-lmax-castel2024 ,
        entity:hp-parity-castel2024 ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-Allegro-castel2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-Allegro-castel2024 a mlips:LossFunction ;
    rdfs:label "Weighted average of potential-energy and force errors" .

entity:alg-Allegro-castel2024 a mls:Algorithm ;
    rdfs:label "Adam" .

entity:impl-Allegro-castel2024 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

entity:hp-lmax-castel2024 a mlips:Hyperparameter ;
    rdfs:label "Maximum rotation order l" ;
    mlips:hyperparameterName "lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-parity-castel2024 a mlips:Hyperparameter ;
    rdfs:label "Use of odd-mirror-parity features" ;
    mlips:hyperparameterName "parity" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-l1-r6-cutoffRadius-castel2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-l1-r6-numLayers-castel2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

