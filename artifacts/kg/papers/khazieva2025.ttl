    schema:identifier <https://orcid.org/0000-0003-1746-8200> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-FeCrC-khazieva2025 a mlips:MaterialSystem ;
    rdfs:label "Fe-Cr-C alloys over the whole ternary composition space (liquid and crystalline)" ;
    mlips:chemicalFormula "FeCrC" ;
    mlips:materialClass "Ternary metallic alloy (magnetic)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-nm-khazieva2025 a mlips:DFTCalculation .

entity:calc-sp-khazieva2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-nm-khazieva2025 mlips:hasDFTSettings entity:calc-settings-nm-khazieva2025 .

entity:calc-settings-nm-khazieva2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Generalised Monkhorst-Pack grids (KpLib)" ;
    rdfs:comment "Spin-unpolarised." .

entity:calc-sp-khazieva2025 mlips:hasDFTSettings entity:calc-settings-sp-khazieva2025 .

entity:calc-settings-sp-khazieva2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Generalised Monkhorst-Pack grids (KpLib)" ;
    rdfs:comment "Collinear spin-polarised, initialised ferromagnetic." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-nm-khazieva2025 a mlips:TrainingDataset ;
    rdfs:label "Non-magnetic Fe-Cr-C data set (about 5,000 configurations with energies, forces and virials)" ;
    mlips:coversMaterial entity:mat-FeCrC-khazieva2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-nm-khazieva2025 .

entity:ds-sp-khazieva2025 a mlips:TrainingDataset ;
    rdfs:label "Spin-polarised Fe-Cr-C fine-tuning set (600 configurations, 4 snapshots x 150 frames)" ;
    mlips:coversMaterial entity:mat-FeCrC-khazieva2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 600 ;
    mlips:hasDFTCalculation entity:calc-sp-khazieva2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-nm-khazieva2025 mlips:samplingStrategy
    entity:sampling-aimd-khazieva2025 ,
    entity:sampling-al-khazieva2025 .

entity:ds-sp-khazieva2025 mlips:samplingStrategy
    entity:sampling-spin-relax-khazieva2025 .

entity:sampling-aimd-khazieva2025 a mlips:SamplingStrategy ;
    rdfs:label "Spin-unpolarised NPT AIMD of 20 disordered 128-atom Fe-Cr-C supercells at 3000 K and 0, 10 and 50 GPa (seed set)" .

entity:sampling-al-khazieva2025 a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN active learning: 14 iterations of DP-NM MD at 0-10 GPa with heating-cooling between 500 and 3000 K, 350 new labelled configurations per iteration" .

entity:sampling-spin-relax-khazieva2025 a mlips:SamplingStrategy ;
    rdfs:label "150 frames selected by SOAP sparsification, four spin-polarised ionic relaxation steps each at fixed cell" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-khazieva2025 ;
    mlips:hasImplementation entity:impl-DeePMD-khazieva2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-DeePMD-khazieva2025 a mls:Algorithm ;
    rdfs:label "DP-GEN active learning; transfer learning with all weights except the output layer frozen (DP-M)" .

entity:impl-DeePMD-khazieva2025 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-nm-khazieva2025 a mlips:MLIPRun ;
    rdfs:label "DP-NM, Deep Potential trained on non-magnetic DFT data" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-nm-khazieva2025 ;
    mlips:produces entity:model-dp-nm-khazieva2025 .

entity:model-dp-nm-khazieva2025 a mlips:TrainedModel ;
    rdfs:label "DP-NM Fe-Cr-C potential" .

entity:run-dp-m-khazieva2025 a mlips:MLIPRun ;
    rdfs:label "DP-M, DP-NM fine-tuned on spin-polarised DFT data" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-sp-khazieva2025 ;
    mlips:produces entity:model-dp-m-khazieva2025 .

entity:model-dp-m-khazieva2025 a mlips:TrainedModel ;
    rdfs:label "DP-M Fe-Cr-C potential" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Spin-polarised DFT is stated to be roughly twice as expensive per
# electronic step and to need almost an order of magnitude more computer
# time overall; transfer learning reduces the cost of building the magnetic
# potential by more than an order of magnitude. No times are given.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No energy, force or virial errors of DP-NM or DP-M are reported; the validation is against experimental densities, lattice constants, melting temperatures (Table 1) and viscosities, which are properties rather than error metrics.
# - The size of the non-magnetic data set is stated only as approximately 5,000 configurations (the AL text also mentions a 5000-configuration set), so no count is attached; the DeePMD network sizes and cutoff are given only by reference to Ref. [8].
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/khazieva2025.yaml) until the schema has terms for them.
