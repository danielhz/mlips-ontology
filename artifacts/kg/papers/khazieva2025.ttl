# Canonical Turtle for the protocol-derived encoding of:
#   E. O. Khazieva et al. (2025). Accuracy and limitations of machine-learned interatomic potentials for magnetic systems: A case study on Fe-Cr-C.
#   Physical review. E. doi:10.1103/913y-p6qf  arXiv:2507.18935v1
#
# Version read: arxiv-preprint arXiv:2507.18935v1 (sha256 600a3b292c56b8c7...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 259 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/khazieva2025.yaml.
#
# Encoding scope: two Deep Potentials for the Fe-Cr-C system, DP-NM trained
# on spin-unpolarised DFT data from a DP-GEN active-learning workflow and
# DP-M obtained by fine-tuning DP-NM (all but the last layer frozen) on 600
# spin-polarised configurations, applied in MD to densities, melting
# temperatures (two-phase method) and viscosities. The paper reports no
# energy/force/stress errors; the property comparisons with experiment
# (Table 1, Figs. 2-8) are not error metrics and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-khazieva2025 a mlips:BenchmarkStudy ;
    rdfs:label "Khazieva et al. (2025): non-magnetic vs spin-polarised Deep Potentials for Fe-Cr-C" ;
    mlips:reportedIn entity:article-khazieva2025 .

entity:article-khazieva2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/913y-p6qf> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Accuracy and limitations of machine-learned interatomic potentials for magnetic systems: A case study on Fe-Cr-C" ;
    schema:author entity:person-Khazieva-khazieva2025 ,
        <https://orcid.org/0000-0002-7242-1483> ,
        entity:person-Katkov-khazieva2025 ,
        <https://orcid.org/0000-0003-1746-8200> .

entity:person-Khazieva-khazieva2025 a schema:Person ;
    schema:name "E. O. Khazieva" ;
    schema:givenName "E. O." ;
    schema:familyName "Khazieva" .

<https://orcid.org/0000-0002-7242-1483> a schema:Person ;
    schema:name "N. M. Chtchelkatchev" ;
    schema:givenName "N. M." ;
    schema:familyName "Chtchelkatchev" ;
    schema:identifier <https://orcid.org/0000-0002-7242-1483> .

entity:person-Katkov-khazieva2025 a schema:Person ;
    schema:name "N. N. Katkov" ;
    schema:givenName "N. N." ;
    schema:familyName "Katkov" .

<https://orcid.org/0000-0003-1746-8200> a schema:Person ;
    schema:name "R. E. Ryltsev" ;
    schema:givenName "R. E." ;
