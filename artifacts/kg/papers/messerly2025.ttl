###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-organics-messerly2025 a mlips:MaterialSystem ;
    rdfs:label "Organic molecules of C, H, N, O (ANI-1x subset matching ANI-1ccx)" ;
    mlips:materialClass "Organic molecules (gas phase)" .

entity:mat-gdb1013-messerly2025 a mlips:MaterialSystem ;
    rdfs:label "Larger organic molecules with 10-13 heavy atoms (COMP6 GDB10to13)" ;
    mlips:materialClass "Organic molecules (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dz-messerly2025 a mlips:DFTCalculation .

entity:calc-tz-messerly2025 a mlips:DFTCalculation .

entity:calc-mp2-messerly2025 a mlips:WaveFunctionCalculation .

entity:calc-cc-messerly2025 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dz-messerly2025 mlips:hasDFTSettings entity:calc-settings-dz-messerly2025 .

entity:calc-settings-dz-messerly2025 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "DFT/DZ (lowest fidelity)" .

entity:calc-tz-messerly2025 mlips:hasDFTSettings entity:calc-settings-tz-messerly2025 .

entity:calc-settings-tz-messerly2025 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:wB97X ;
    mlips:basisSet "def2-TZVPP" ;
    rdfs:comment "DFT/TZ" .

entity:calc-mp2-messerly2025 mlips:hasWaveFunctionSettings entity:calc-settings-mp2-messerly2025 .

entity:calc-settings-mp2-messerly2025 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:MP2 ;
    mlips:basisSet "cc-pVTZ" ;
    rdfs:comment "MP2/TZ (energies only in training)" .

entity:calc-cc-messerly2025 mlips:hasWaveFunctionSettings entity:calc-settings-cc-messerly2025 .

entity:calc-settings-cc-messerly2025 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "CBS" ;
    rdfs:comment "CCSD(T)*/CBS of ANI-1ccx (energies only)" .

