###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HIP-NN a mlips:MLIPMethod ;
    rdfs:label "Hierarchically Interacting Particle Neural Network (HIP-NN)" ;
    mlips:hasFunctionalForm entity:ff-HIP-NN ;
    mlips:hasLossFunction entity:loss-HIP-NN-messerly2025 ;
    mlips:hasTrainingAlgorithm entity:alg-HIP-NN-messerly2025 ;
    mlips:hasImplementation entity:impl-HIP-NN-messerly2025 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ff-HIP-NN a mlips:FunctionalForm ;
    rdfs:label "Deep neural network with on-site and interaction layers over inverse-distance sensitivity functions; the molecular energy is a sum of atomic energies decomposed into hierarchical contributions from successive interaction layers" .

entity:loss-HIP-NN-messerly2025 a mlips:LossFunction ;
    rdfs:label "Sum over fidelities of energy, force (where available) and hierarchicality terms, each RMSE + MAE, all weights 1" .

entity:alg-HIP-NN-messerly2025 a mls:Algorithm ;
    rdfs:label "Multi-fidelity: shared interaction blocks, fidelity-specific linear output layers; ensembles of 8 models" .

entity:impl-HIP-NN-messerly2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-hippynn-messerly2025 .

entity:lib-hippynn-messerly2025 a mlips:Library ;
    rdfs:label "hippynn" ;
    mlips:candidateForVocabulary mlips:Library .

