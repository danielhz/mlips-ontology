entity:metric-fastchgnet-fshead-2-zhou2025 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on forces: FastCHGNet 'F/S head', MPtrj test set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "73"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-fastchgnet-fshead-3-zhou2025 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on stress: FastCHGNet 'F/S head', MPtrj test set" ;
