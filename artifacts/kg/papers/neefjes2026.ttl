# Q7 -- MLIP method, components, implementation
###############################################################################

entity:AIMNet2 a mlips:MLIPMethod ;
    rdfs:label "AIMNet2 (atoms-in-molecules neural network potential with learned charges and explicit long-range terms)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:hasImplementation entity:impl-PaiNN-neefjes2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-PaiNN-neefjes2026 a mlips:Implementation ;
    mlips:implementedIn mlips:SchNet .

