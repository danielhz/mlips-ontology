# Canonical Turtle for the protocol-derived encoding of:
#   Connor Edwards et al. (2026). MLIP-MC: A Framework for Adsorption Simulations using Machine-Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2602.13725  arXiv:2602.13725v1
#
# Version read: arxiv-preprint arXiv:2602.13725v1 (sha256 f11b57d4170383b6...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 240 (Software/implementation). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/edwards2026.yaml.
#
# Encoding scope: the MLIP-MC framework (introduced here) and the
# pretrained universal models used for Widom insertion and GCMC of CO2 in
# ZIF-8, ZIF-4 and Mg-MOF-74 (MACE-MP-0a, MACE-MP-0b3, MACE-MPA-0,
# ORB-v3-inf-consv-omat; the two fairchem ODAC models are graph
# transformers not named further). The comparison is on heats of
# adsorption and isotherms against a fine-tuned reference model; no energy
# or force error is reported, so there is no BenchmarkResult.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-edwards2026 a mlips:BenchmarkStudy ;
    rdfs:label "Edwards et al. (2026): MLIP-MC, grand canonical Monte Carlo with universal MLIPs for CO2 adsorption in MOFs" ;
    mlips:reportedIn entity:article-edwards2026 .

entity:article-edwards2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2602.13725> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "MLIP-MC: A Framework for Adsorption Simulations using Machine-Learned Interatomic Potentials" ;
    schema:author entity:person-Edwards-edwards2026 ,
        entity:person-Yang-edwards2026 ,
        entity:person-Stracke-edwards2026 ,
        entity:person-Evans-edwards2026 .

entity:person-Edwards-edwards2026 a schema:Person ;
    schema:name "Connor W. Edwards" ;
    schema:givenName "Connor W." ;
    schema:familyName "Edwards" .

entity:person-Yang-edwards2026 a schema:Person ;
    schema:name "Fengxu Yang" ;
    schema:givenName "Fengxu" ;
    schema:familyName "Yang" .

entity:person-Stracke-edwards2026 a schema:Person ;
    schema:name "Konstantin Stracke" ;
    schema:givenName "Konstantin" ;
    schema:familyName "Stracke" .

entity:person-Evans-edwards2026 a schema:Person ;
    schema:name "Jack D. Evans" ;
    schema:givenName "Jack D." ;
    schema:familyName "Evans" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ZIF-8-edwards2026 a mlips:MaterialSystem ;
    rdfs:label "ZIF-8 with adsorbed CO2" ;
    mlips:materialClass "Zeolitic imidazolate framework" .

entity:mat-ZIF-4-edwards2026 a mlips:MaterialSystem ;
    rdfs:label "ZIF-4 with adsorbed CO2" ;
    mlips:materialClass "Zeolitic imidazolate framework" .

entity:mat-Mg-MOF-74-edwards2026 a mlips:MaterialSystem ;
    rdfs:label "Mg-MOF-74 with adsorbed CO2" ;
    mlips:materialClass "Metal-organic framework with open metal sites" .

