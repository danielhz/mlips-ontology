###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MonteCarlo .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:MonteCarlo .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-mp-0a-edwards2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0a as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp-0a-edwards2026 .

entity:model-mace-mp-0a-edwards2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0a" .

entity:run-mace-mp-0b3-edwards2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0b3 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp-0b3-edwards2026 .

entity:model-mace-mp-0b3-edwards2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b3" .

entity:run-mace-mpa-0-edwards2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa-0-edwards2026 .

entity:model-mace-mpa-0-edwards2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-orb-v3-edwards2026 a mlips:MLIPRun ;
    rdfs:label "ORB-v3-inf-consv-omat as distributed" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb-v3-edwards2026 .

entity:model-orb-v3-edwards2026 a mlips:TrainedModel ;
    rdfs:label "ORB-v3-inf-consv-omat" .

