# Q2 -- Material system
###############################################################################

entity:mat-metals16-song2024 a mlips:MaterialSystem ;
    rdfs:label "16 elemental metals (Ag, Al, Au, Cr, Cu, Mg, Mo, Ni, Pb, Pd, Pt, Ta, Ti, V, W, Zr) and their binary alloys" ;
    mlips:materialClass "Metals and alloys" .

entity:mat-test1-song2024 a mlips:MaterialSystem ;
    rdfs:label "Up to 13-component alloys (Ag, Au, Cr, Cu, Mo, Ni, Pd, Pt, Ta, Ti, V, W, Zr) of Lopanitsyna et al." ;
    mlips:materialClass "High-entropy alloys" .

entity:mat-test2-song2024 a mlips:MaterialSystem ;
    rdfs:label "Mo-Ta-V-W alloys of up to four components (Byggmastar et al.)" ;
    mlips:materialClass "Refractory alloys" .

entity:mat-test3-song2024 a mlips:MaterialSystem ;
    rdfs:label "Pd-Cu-Ni alloys of up to three components (Zhao et al.)" ;
    mlips:materialClass "Ternary alloys" .

entity:mat-mp-ternary-song2024 a mlips:MaterialSystem ;
    rdfs:label "Ternary structures of the 16 metals in the Materials Project" ;
    mlips:materialClass "Ternary intermetallics" .

entity:mat-gnome-song2024 a mlips:MaterialSystem ;
    rdfs:label "2- to 5-component GNoME structures of the 16 metals" ;
    mlips:materialClass "Predicted intermetallics" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-song2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-song2024 mlips:hasDFTSettings entity:calc-settings-pbe-song2024 .

entity:calc-settings-pbe-song2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, spacing 0.2/A" ;
    rdfs:comment "PREC Accurate, Gaussian smearing 0.02 eV, 1e-6 eV SCF; non-magnetic (Methods)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-unep-song2024 a mlips:TrainingDataset ;
    rdfs:label "UNEP-v1 training set (105,464 structures, 6,886,241 atoms; unary and binary only)" ;
    mlips:coversMaterial entity:mat-metals16-song2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 105464 ;
    mlips:hasDFTCalculation entity:calc-pbe-song2024 ;
    rdfs:comment "About six million CPU hours of DFT." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-unep-song2024 mlips:samplingStrategy
    entity:sampling-eam-md-song2024 ,
    entity:sampling-active-song2024 .

entity:sampling-eam-md-song2024 a mlips:SamplingStrategy ;
    rdfs:label "EAM MD at 50-5000 K with box scaling and perturbations, strained MD, MP/OQMD defects and surfaces" ;
    rdfs:comment "Initial set of about 60,000 structures (Methods)." .

entity:sampling-active-song2024 a mlips:SamplingStrategy ;
    rdfs:label "Iterative active learning with MD and MC-MD driven by the NEP model" ;
    rdfs:comment "Structures with large NEP-DFT errors added until none were found." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-song2024 ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-song2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        entity:hp-Nneu-song2024 ,
        entity:hp-Ngen-song2024 ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NEP-song2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:PhononCalculation .

entity:loss-NEP-song2024 a mlips:LossFunction ;
    rdfs:label "Per-element energy, force (weight 1) and virial (0.1) losses with L2 regularisation (multi-loss SNES)" .

entity:alg-NEP-song2024 a mls:Algorithm ;
    rdfs:label "Separable natural evolution strategy with multiple loss functions, population 60" .

entity:impl-NEP-song2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-song2024 ;
    mlips:version "3.9.3" .

entity:lib-GPUMD-song2024 a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Nneu-song2024 a mlips:Hyperparameter ;
    rdfs:label "NEP number of neurons in the single hidden layer N_neu" ;
    mlips:hyperparameterName "N_neu" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-Ngen-song2024 a mlips:Hyperparameter ;
    rdfs:label "NEP maximum number of generations of the natural evolution strategy N_gen" ;
    mlips:hyperparameterName "N_gen" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-unep-v1-cutoffRadius-song2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-unep-v1-angularCutoff-song2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-unep-v1-Nneu-song2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Nneu-song2024 ;
    mlips:settingValue "80"^^xsd:integer .

entity:setting-unep-v1-Ngen-song2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Ngen-song2024 ;
    mlips:settingValue "1000000"^^xsd:integer .

entity:setting-unep-v1-batchSize-song2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "10000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-unep-v1-song2024 a mlips:MLIPRun ;
    rdfs:label "UNEP-v1 (NEP4 with ZBL) trained on the 16-metal unary and binary data" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-unep-song2024 ;
    mlips:hasHyperparameterSetting entity:setting-unep-v1-cutoffRadius-song2024 ,
        entity:setting-unep-v1-angularCutoff-song2024 ,
        entity:setting-unep-v1-Nneu-song2024 ,
        entity:setting-unep-v1-Ngen-song2024 ,
        entity:setting-unep-v1-batchSize-song2024 ;
    mlips:trainingHardware "Four NVIDIA A100 GPUs; about ten days" ;
    mlips:produces entity:model-unep-v1-song2024 .

entity:model-unep-v1-song2024 a mlips:TrainedModel ;
    rdfs:label "UNEP-v1 (70,401 parameters)" .

