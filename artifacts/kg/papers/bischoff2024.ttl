    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-h-bischoff2024 ;
    mlips:produces entity:model-ufp2-bischoff2024 .

entity:model-ufp2-bischoff2024 a mlips:TrainedModel ;
    rdfs:label "h-llpt-24 UFP2" .

entity:run-ufp3-bischoff2024 a mlips:MLIPRun ;
    rdfs:label "UF3 three-body trained on h-llpt-24" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-h-bischoff2024 ;
    mlips:produces entity:model-ufp3-bischoff2024 .

entity:model-ufp3-bischoff2024 a mlips:TrainedModel ;
    rdfs:label "h-llpt-24 UFP3" .

entity:run-pace-bischoff2024 a mlips:MLIPRun ;
    rdfs:label "PACE (semi-linear ACE) trained on h-llpt-24" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-h-bischoff2024 ;
    mlips:produces entity:model-pace-bischoff2024 .

entity:model-pace-bischoff2024 a mlips:TrainedModel ;
    rdfs:label "h-llpt-24 PACE" .

entity:run-mace-bischoff2024 a mlips:MLIPRun ;
    rdfs:label "MACE trained on h-llpt-24" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-h-bischoff2024 ;
    mlips:produces entity:model-mace-bischoff2024 .

entity:model-mace-bischoff2024 a mlips:TrainedModel ;
    rdfs:label "h-llpt-24 MACE" .

