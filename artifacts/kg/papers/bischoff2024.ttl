# Canonical Turtle for the protocol-derived encoding of:
#   Thomas Bischoff et al. (2024). Hydrogen under Pressure as a Benchmark for Machine-Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2409.13390  arXiv:2409.13390v1
#
# Version read: arxiv-preprint arXiv:2409.13390v1 (sha256 85c17ed0d048fae9...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 451 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/bischoff2024.yaml.
#
# Encoding scope: the h-llpt-24 data set (612 PBE NVT AIMD runs of 128
# hydrogen atoms at six temperatures and 17 Wigner-Seitz radii, Quantum
# ESPRESSO; five runs per state point for training, one for testing),
# the MLIPs benchmarked on it (UF3 two- and three-body, PACE, MACE) with
# their test-set energy and force errors (Table 2). Hellinger distances
# of MD-derived properties (Table 1) are property-level scores; the
# Yukawa and Tersoff baselines are not MLIPs.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bischoff2024 a mlips:BenchmarkStudy ;
    rdfs:label "Bischoff et al. (2024): warm dense hydrogen across the liquid-liquid phase transition (h-llpt-24) as a benchmark for MLIPs" ;
    mlips:reportedIn entity:article-bischoff2024 .

entity:article-bischoff2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2409.13390> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Hydrogen under Pressure as a Benchmark for Machine-Learning Interatomic Potentials" ;
    schema:author entity:person-Bischoff-bischoff2024 ,
        entity:person-Jackl-bischoff2024 ,
        entity:person-Rupp-bischoff2024 .

entity:person-Bischoff-bischoff2024 a schema:Person ;
    schema:name "Thomas Bischoff" ;
    schema:givenName "Thomas" ;
    schema:familyName "Bischoff" .

entity:person-Jackl-bischoff2024 a schema:Person ;
    schema:name "Bastian Jäckl" ;
    schema:givenName "Bastian" ;
    schema:familyName "Jäckl" .

entity:person-Rupp-bischoff2024 a schema:Person ;
    schema:name "Matthias Rupp" ;
    schema:givenName "Matthias" ;
    schema:familyName "Rupp" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-h-bischoff2024 a mlips:MaterialSystem ;
    rdfs:label "Warm dense hydrogen (128 atoms) across the liquid-liquid phase transition, 1000-1500 K" ;
    mlips:chemicalFormula "H" ;
    mlips:materialClass "Material-specific benchmark system (solid acid, electrolyte, alloy, layered material or molecular liquid)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-bischoff2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-bischoff2024 mlips:hasDFTSettings entity:calc-settings-pbe-bischoff2024 .

entity:calc-settings-pbe-bischoff2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "NVT ab initio MD, 10k steps per run; 2 equilibration and 12 production snapshots per run used (Sec. 4)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-h-bischoff2024 a mlips:TrainingDataset ;
    rdfs:label "h-llpt-24 training part (five of six AIMD runs per temperature and density)" ;
    mlips:coversMaterial entity:mat-h-bischoff2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-bischoff2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:UF3 a mlips:MLIPMethod ;
    rdfs:label "UF3 (ultra-fast force fields: two- and three-body cubic B-spline potentials fitted by regularised linear regression)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasImplementation entity:impl-ACE-bischoff2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-ACE-bischoff2024 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasImplementation entity:impl-MACE-bischoff2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-bischoff2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

