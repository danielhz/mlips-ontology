entity:sampling-rand-kharwar2026 a mlips:SamplingStrategy ;
    rdfs:label "Random atomic displacements around 15 Materials Project structures" .

entity:sampling-gb-kharwar2026 a mlips:SamplingStrategy ;
    rdfs:label "Five representative grain-boundary structures with random displacements and local bond distortions" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-kharwar2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-kharwar2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-MTP-kharwar2026 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses" .

entity:alg-MTP-kharwar2026 a mls:Algorithm ;
    rdfs:label "Nonlinear coefficient scanning and particle swarm optimization of hyperparameters; model chosen by combined training and test error" .

