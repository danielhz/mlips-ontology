entity:mat-mos2-kharwar2026 a mlips:MaterialSystem ;
    rdfs:label "Monolayer MoS2 with grain boundaries (5|7-22-S), pristine Mo-S phases and elemental Mo and S" ;
    mlips:chemicalFormula "MoS2" ;
    mlips:materialClass "2D material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-atk-kharwar2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-atk-kharwar2026 mlips:hasDFTSettings entity:calc-settings-atk-kharwar2026 .

entity:calc-settings-atk-kharwar2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-QuantumATK-kharwar2026 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    rdfs:comment "LCAO basis, PseudoDojo pseudopotentials, 105 Ha cutoff, about 10 k-points per 1/A" .

entity:lib-QuantumATK-kharwar2026 a mlips:Library ;
    rdfs:label "QuantumATK" ;
    mlips:candidateForVocabulary mlips:Library .

