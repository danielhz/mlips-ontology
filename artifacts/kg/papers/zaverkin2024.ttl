# Q2 -- Material system
###############################################################################

entity:mat-ala-zaverkin2024 a mlips:MaterialSystem ;
    rdfs:label "Alanine dipeptide in vacuum" ;
    mlips:chemicalFormula "C6H12N2O3" ;
    mlips:materialClass "Biomolecule (peptide)" .

entity:mat-mil53-zaverkin2024 a mlips:MaterialSystem ;
    rdfs:label "Flexible metal-organic framework MIL-53(Al) (closed- and large-pore states)" ;
    mlips:materialClass "Metal-organic frameworks" .

