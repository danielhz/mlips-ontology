    rdfs:comment "AMBER ff19SB force field as the reference for alanine dipeptide." .

entity:calc-pbed3-zaverkin2024 mlips:hasDFTSettings entity:calc-settings-pbed3-zaverkin2024 .

entity:calc-settings-pbed3-zaverkin2024 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-zaverkin2024 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType entity:pp-GTH-zaverkin2024 ;
    rdfs:comment "PBE-D3(BJ), TZVP/plane-wave hybrid basis, 1000 Ry cutoff, CP2K 2023.1." .

entity:lib-CP2K-zaverkin2024 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:pp-GTH-zaverkin2024 a mlips:PseudopotentialType ;
    rdfs:label "GTH" ;
    mlips:candidateForVocabulary mlips:PseudopotentialType .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ala-al-zaverkin2024 a mlips:TrainingDataset ;
    rdfs:label "Alanine-dipeptide configurations acquired by active learning (at most 512 per experiment)" ;
    mlips:coversMaterial entity:mat-ala-zaverkin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-amber-zaverkin2024 .

entity:ds-mil-al-zaverkin2024 a mlips:TrainingDataset ;
    rdfs:label "MIL-53(Al) configurations acquired by active learning from 32 perturbed closed-pore structures (at most 512 per experiment)" ;
    mlips:coversMaterial entity:mat-mil53-zaverkin2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbed3-zaverkin2024 .

