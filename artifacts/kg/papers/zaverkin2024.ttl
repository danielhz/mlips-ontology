###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GMNN a mlips:MLIPMethod ;
    rdfs:label "Gaussian Moment Neural Network (GMNN)" ;
    mlips:hasTrainingAlgorithm entity:alg-GMNN-zaverkin2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-GMNN-zaverkin2024 a mls:Algorithm ;
    rdfs:label "Adam with early stopping; batch selection maximising distances in sketched gradient-feature space" .

