# Canonical Turtle for the protocol-derived encoding of:
#   Wojciech G. Stark et al. (2024). Benchmarking of machine learning interatomic potentials for reactive hydrogen dynamics at metal surfaces.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/ad5f11  arXiv:2403.15334v1
#
# Version read: arxiv-preprint arXiv:2403.15334v1 (sha256 fa0e4ed52dd82ad8...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 111 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the four optimised models (PaiNN, REANN, ACE, MACE)
# trained on one database of H2 on four copper facets, with their model
# parameters and the averaged test errors over all structures (last rows
# of Table I; means over five models with different random splits).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-stark2024 a mlips:BenchmarkStudy ;
    rdfs:label "Stark et al. (2024): benchmarking of MLIPs for reactive hydrogen dynamics at metal surfaces (H2 on copper)" ;
    mlips:reportedIn entity:article-stark2024 .

entity:article-stark2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/ad5f11> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Benchmarking of machine learning interatomic potentials for reactive hydrogen dynamics at metal surfaces" ;
    schema:author <https://orcid.org/0000-0001-6279-2638> ,
        <https://orcid.org/0000-0003-1845-0387> ,
        <https://orcid.org/0000-0001-6915-9851> ,
        <https://orcid.org/0000-0002-4601-0461> ,
        <https://orcid.org/0000-0003-2696-5436> ,
        <https://orcid.org/0000-0002-8180-2034> ,
        <https://orcid.org/0000-0002-3004-785X> .

