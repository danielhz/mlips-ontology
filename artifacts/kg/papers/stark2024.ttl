###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-H2Cu-stark2024 a mlips:MaterialSystem ;
    rdfs:label "H2 on Cu(111), Cu(100), Cu(110) and Cu(211): clean surface slabs and H2/Cu structures (3x3, six-layer slabs)" ;
    mlips:chemicalFormula "H2/Cu" ;
    mlips:materialClass "Molecule-metal surface system for reactive scattering" ;
    mlips:microstructuralFeature "Four copper facets; dissociative chemisorption of H2" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-stark2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-stark2024 mlips:hasDFTSettings entity:calc-settings-dft-stark2024 .

entity:calc-settings-dft-stark2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional entity:xc-SRP48-stark2024 ;
    mlips:dftBasisSet entity:basis-FHI-aims-tight-default-basis-stark2024 ;
    mlips:kPointMesh "12x12x1" .

entity:xc-SRP48-stark2024 a mlips:XCFunctional ;
    rdfs:label "SRP48" ;
    rdfs:comment "Specific reaction parameter functional: 52% PBE and 48% RPBE." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-FHI-aims-tight-default-basis-stark2024 a mlips:DftBasisSet ;
    rdfs:label "FHI-aims 'tight' default basis" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-H2Cu-stark2024 a mlips:TrainingDataset ;
    rdfs:label "H2/Cu database (4230 data points; 3381 for training)" ;
    mlips:coversMaterial entity:mat-H2Cu-stark2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 3381 ;
    mlips:hasDFTCalculation entity:calc-dft-stark2024 ;
    rdfs:comment "1685 Cu-only surface structures sampled at 300, 600 and 900 K and 2545 H2/Cu structures. Each model is trained five times on a random 3381 and tested on a random 423 of the 4230 structures; ten non-zero-spin structures are removed from the test sets." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-H2Cu-stark2024 mlips:samplingStrategy
    entity:sampling-adaptive-schnet-stark2024 .

entity:sampling-adaptive-schnet-stark2024 a mlips:SamplingStrategy ;
    rdfs:label "Adaptive sampling with an iteratively refined SchNet MLIP" ;
    rdfs:comment "Dynamics simulations with the current model; structures that are poorly represented are added and the model is retrained (database of an earlier paper of the group). None of the four benchmarked models took part in the sampling." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:hasLossFunction entity:loss-PaiNN-stark2024 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-PaiNN-stark2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-PaiNN-stark2024 a mlips:LossFunction ;
    rdfs:label "Combined loss with energy weight 0.05 and force weight 0.95" .

entity:impl-PaiNN-stark2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SchNetPack-stark2024 .

entity:REANN a mlips:MLIPMethod ;
    rdfs:label "REANN (recursively embedded atom neural network)" ;
    mlips:hasLossFunction entity:loss-REANN-stark2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-REANN-stark2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-REANN-stark2024 a mlips:LossFunction ;
    rdfs:label "Energy weight 0.1 throughout; force weight reduced from 50 to 0.5 during training" .

entity:impl-REANN-stark2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-REANN-stark2024 .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-stark2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:bodyOrder ;
    mlips:hasImplementation entity:impl-ACE-stark2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-ACE-stark2024 a mlips:LossFunction ;
    rdfs:label "Combined loss with energy weight 0.5 and force weight 0.5" .

entity:impl-ACE-stark2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-ACEpotentials_jl-stark2024 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-stark2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:bodyOrder ,
        mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-MACE-stark2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-MACE-stark2024 a mlips:LossFunction ;
    rdfs:label "Energy and force weights 5 and 95 initially, changed to 1000 and 1 after 1200 epochs" .

entity:impl-MACE-stark2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE ;
    mlips:version "0.2.0 (MACE-JAX also tested)" .

entity:lib-SchNetPack-stark2024 a mlips:Library ;
    rdfs:label "SchNetPack" ;
    rdfs:comment "SchNetPack version 2.0.0." ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-REANN-stark2024 a mlips:Library ;
    rdfs:label "REANN" ;
    rdfs:comment "REANN code version 0.1 (https://github.com/zhangylch/REANN); atomic-energy and orbital-coefficient networks of 16x16x16, 9 primitive GTOs." ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-ACEpotentials_jl-stark2024 a mlips:Library ;
    rdfs:label "ACEpotentials.jl" ;
    rdfs:comment "ACEpotentials.jl version 0.6.3; polynomial degrees 18, 12, 10 and 8 for correlation orders 1 to 4." ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-PaiNN-numLayers-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-PaiNN-numFeatures-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-PaiNN-cutoffRadius-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-REANN-cutoffRadius-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-REANN-numLayers-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-ACE-cutoffRadius-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-ACE-bodyOrder-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-MACE-cutoffRadius-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-MACE-bodyOrder-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-MACE-numLayers-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-MACE-numFeatures-stark2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "16"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-PaiNN-stark2024 a mlips:MLIPRun ;
    rdfs:label "Final optimised PaiNN model trained on the H2/Cu database" ;
    mlips:appliesMethod entity:PaiNN ;
    mlips:runsOn entity:ds-H2Cu-stark2024 ;
    mlips:hasHyperparameterSetting entity:setting-PaiNN-numLayers-stark2024 ,
        entity:setting-PaiNN-numFeatures-stark2024 ,
        entity:setting-PaiNN-cutoffRadius-stark2024 ;
    mlips:produces entity:model-PaiNN-stark2024 .

entity:model-PaiNN-stark2024 a mlips:TrainedModel ;
    rdfs:label "PaiNN model for H2 on copper surfaces (mean of five models)" .

entity:run-REANN-stark2024 a mlips:MLIPRun ;
    rdfs:label "Final optimised REANN model trained on the H2/Cu database" ;
    mlips:appliesMethod entity:REANN ;
    mlips:runsOn entity:ds-H2Cu-stark2024 ;
    mlips:hasHyperparameterSetting entity:setting-REANN-cutoffRadius-stark2024 ,
        entity:setting-REANN-numLayers-stark2024 ;
    mlips:produces entity:model-REANN-stark2024 .

entity:model-REANN-stark2024 a mlips:TrainedModel ;
    rdfs:label "REANN model for H2 on copper surfaces (mean of five models)" .

entity:run-ACE-stark2024 a mlips:MLIPRun ;
    rdfs:label "Final optimised ACE model trained on the H2/Cu database" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-H2Cu-stark2024 ;
    mlips:hasHyperparameterSetting entity:setting-ACE-cutoffRadius-stark2024 ,
        entity:setting-ACE-bodyOrder-stark2024 ;
    mlips:produces entity:model-ACE-stark2024 .

entity:model-ACE-stark2024 a mlips:TrainedModel ;
    rdfs:label "ACE model for H2 on copper surfaces (mean of five models)" .

entity:run-MACE-stark2024 a mlips:MLIPRun ;
    rdfs:label "Final optimised MACE model trained on the H2/Cu database" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-H2Cu-stark2024 ;
    mlips:hasHyperparameterSetting entity:setting-MACE-cutoffRadius-stark2024 ,
        entity:setting-MACE-bodyOrder-stark2024 ,
        entity:setting-MACE-numLayers-stark2024 ,
        entity:setting-MACE-numFeatures-stark2024 ;
    mlips:produces entity:model-MACE-stark2024 .

entity:model-MACE-stark2024 a mlips:TrainedModel ;
    rdfs:label "MACE model for H2 on copper surfaces (mean of five models)" .

