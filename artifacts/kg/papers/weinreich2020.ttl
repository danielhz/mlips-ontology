    schema:givenName "Jörg" ;
    schema:familyName "Behler" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cuzn-weinreich2020 a mlips:MaterialSystem ;
    rdfs:label "Cu-Zn (alpha-brass) bulk, surfaces, clusters and melts" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-weinreich2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-weinreich2020 mlips:hasDFTSettings entity:calc-settings-vasp-weinreich2020 .

entity:calc-settings-vasp-weinreich2020 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "12x12x12 for the conventional fcc cell, same density elsewhere; Gamma point for large clusters" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cuzn-weinreich2020 a mlips:TrainingDataset ;
    rdfs:label "Cu-Zn reference set (53,841 structures, 2,967,780 atomic environments)" ;
    mlips:coversMaterial entity:mat-cuzn-weinreich2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 53841 ;
    mlips:hasDFTCalculation entity:calc-vasp-weinreich2020 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cuzn-weinreich2020 mlips:samplingStrategy
    entity:sampling-cl-weinreich2020 .

entity:sampling-cl-weinreich2020 a mlips:SamplingStrategy ;
    rdfs:label "Bulk, slab and cluster structures from NVT/NpT MD with semi-grand-canonical Monte Carlo swaps, clusters cut from 1,103-atom nanoparticles, chosen by disagreement of preliminary HDNNPs; molten structures at 1400 K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-weinreich2020 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-weinreich2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-HDNNP-weinreich2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:GeometryOptimization .

entity:loss-HDNNP-weinreich2020 a mlips:LossFunction ;
    rdfs:label "Energies and forces" .

entity:alg-HDNNP-weinreich2020 a mls:Algorithm ;
    rdfs:label "Global extended Kalman filter, Nguyen-Widrow initialization" .

entity:impl-HDNNP-weinreich2020 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer .

