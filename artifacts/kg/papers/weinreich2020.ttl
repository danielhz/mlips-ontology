@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-weinreich2020 a mlips:BenchmarkStudy ;
    rdfs:label "Weinreich, Romer, Paleico and Behler (2020): properties of alpha-brass nanoparticles I, a high-dimensional neural network potential for Cu-Zn" ;
    mlips:reportedIn entity:article-weinreich2020 .

entity:article-weinreich2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2001.10906> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Properties of $α$-Brass Nanoparticles I: Neural Network Potential Energy Surface" ;
    schema:author entity:person-Weinreich-weinreich2020 ,
        entity:person-Romer-weinreich2020 ,
        entity:person-Paleico-weinreich2020 ,
        entity:person-Behler-weinreich2020 .

entity:person-Weinreich-weinreich2020 a schema:Person ;
    schema:name "Jan Weinreich" ;
    schema:givenName "Jan" ;
    schema:familyName "Weinreich" .

entity:person-Romer-weinreich2020 a schema:Person ;
    schema:name "Anton Römer" ;
    schema:givenName "Anton" ;
    schema:familyName "Römer" .

entity:person-Paleico-weinreich2020 a schema:Person ;
    schema:name "Martín Leandro Paleico" ;
    schema:givenName "Martín Leandro" ;
    schema:familyName "Paleico" .

entity:person-Behler-weinreich2020 a schema:Person ;
