    schema:name "University of Luxembourg" ;
    schema:identifier <https://ror.org/036x5ad56> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .

ex:org-KoreaUniversity-schutt2018 a schema:Organization ;
    rdfs:label "Korea University" ;
    schema:name "Korea University" ;
    schema:identifier <https://ror.org/047dqcg40> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .

ex:org-MaxPlanckInstituteforInformatics-schutt2018 a schema:Organization ;
    rdfs:label "Max Planck Institute for Informatics" ;
    schema:name "Max Planck Institute for Informatics" ;
    schema:identifier <https://ror.org/01w19ak89> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .
