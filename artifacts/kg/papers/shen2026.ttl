# Canonical Turtle for the protocol-derived encoding of:
#   Yulin Shen et al. (2026). Non-covalent Interactions at cm$^{-1}$ Accuracy: Data Efficient Physics-Informed Distillation for Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2606.05127  arXiv:2606.05127v1
#
# Version read: arxiv-preprint arXiv:2606.05127v1 (sha256 e03375bc8e9eb5ea...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 371 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/shen2026.yaml.
#
# Encoding scope: He-benzene student models (SOG-Net-type short-range
# MLP plus sum-of-Gaussians long-range block; fixed cutoff or
# SAPT-informed adaptive cutoff) distilled from 18 universal-MLIP
# teachers on 2,400 teacher-labelled configurations and then fine-tuned
# on CCSD(T)/CBS data (Table S2: distilled MAE, RMSE and maximum error,
# and MAE after fine-tuning); the DFT-labelled student (Table I); the
# DeePMD and fixed-cutoff baselines (Table S1); the data-efficiency means
# stated in Sec. IV A; the He-PAH fixed-cutoff models distilled from Orb
# or MatterSim and fine-tuned on PBE0-D4 (Sec. IV B); and the CPU timing
# of the Orb teacher and the student. Errors are in cm-1 (or cm-1/atom),
# which the schema lacks, so all are recorded with unit null.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-shen2026 a mlips:BenchmarkStudy ;
    rdfs:label "Shen et al. (2026): teacher-guided distillation from universal MLIPs and CCSD(T) fine-tuning of SAPT-informed SOG-Net students for He-benzene and He-PAH interactions" ;
    mlips:reportedIn entity:article-shen2026 .

entity:article-shen2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2606.05127> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Non-covalent Interactions at cm$^{-1}$ Accuracy: Data Efficient Physics-Informed Distillation for Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Shen-shen2026 ,
        entity:person-Akram-shen2026 ,
        entity:person-Primeau-shen2026 ,
        entity:person-Zu-shen2026 ,
        entity:person-Vogiatzis-shen2026 ,
        entity:person-Zhang-shen2026 ,
        entity:person-DelMaestro-shen2026 .

entity:person-Shen-shen2026 a schema:Person ;
    schema:name "Yulin Shen" ;
    schema:givenName "Yulin" ;
    schema:familyName "Shen" .

entity:person-Akram-shen2026 a schema:Person ;
    schema:name "Shahzad Akram" ;
    schema:givenName "Shahzad" ;
    schema:familyName "Akram" .

entity:person-Primeau-shen2026 a schema:Person ;
    schema:name "Louis Primeau" ;
    schema:givenName "Louis" ;
    schema:familyName "Primeau" .

entity:person-Zu-shen2026 a schema:Person ;
    schema:name "Gen Zu" ;
    schema:givenName "Gen" ;
    schema:familyName "Zu" .

entity:person-Vogiatzis-shen2026 a schema:Person ;
    schema:name "Konstantinos D. Vogiatzis" ;
    schema:givenName "Konstantinos D." ;
    schema:familyName "Vogiatzis" .

entity:person-Zhang-shen2026 a schema:Person ;
    schema:name "Yang Zhang" ;
    schema:givenName "Yang" ;
    schema:familyName "Zhang" .

entity:person-DelMaestro-shen2026 a schema:Person ;
    schema:name "Adrian Del Maestro" ;
    schema:givenName "Adrian" ;
    schema:familyName "Del Maestro" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-hebz-shen2026 a mlips:MaterialSystem ;
    rdfs:label "He-benzene van der Waals complex (perturbed configurations)" ;
    mlips:materialClass "Molecular dimers and noncovalent complexes" .

entity:mat-hepah-shen2026 a mlips:MaterialSystem ;
    rdfs:label "He on coronene, circumcoronene, circumcircumcoronene and circumcircumcircumcoronene" ;
    mlips:materialClass "Molecular dimers and noncovalent complexes" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ccsdt-shen2026 a mlips:WaveFunctionCalculation .

entity:calc-pbe0d4-shen2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ccsdt-shen2026 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-shen2026 .

entity:calc-settings-ccsdt-shen2026 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "CBS" ;
    rdfs:comment "CCSD(T)/CBS He-benzene interaction energies and SAPT decompositions from Akram et al. (2026), SI Ref. [1]." .

entity:calc-pbe0d4-shen2026 mlips:hasDFTSettings entity:calc-settings-pbe0d4-shen2026 .

entity:calc-settings-pbe0d4-shen2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE0 ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "PBE0-D4/def2-SVP interaction energies for the He-PAH series (SI Sec. I)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-teach-shen2026 a mlips:TrainingDataset ;
    rdfs:label "2,400 perturbed He-benzene configurations labelled by a teacher MLIP (energies only; one label set per teacher)" ;
    mlips:coversMaterial entity:mat-hebz-shen2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse .

entity:ds-teach-dft-shen2026 a mlips:TrainingDataset ;
    rdfs:label "He-benzene configurations labelled with DFT (the Table I DFT route; level of theory not stated in the main text)" ;
    mlips:coversMaterial entity:mat-hebz-shen2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse .

entity:ds-cc50-shen2026 a mlips:TrainingDataset ;
    rdfs:label "He-benzene CCSD(T)/CBS data (2,400 configurations), 50 % used for fine-tuning" ;
    mlips:coversMaterial entity:mat-hebz-shen2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 2400 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-shen2026 .

entity:ds-cc80-shen2026 a mlips:TrainingDataset ;
    rdfs:label "He-benzene CCSD(T)/CBS training pool (80 %; fractions of it used in Fig. 4)" ;
    mlips:coversMaterial entity:mat-hebz-shen2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-shen2026 .

entity:ds-pah-shen2026 a mlips:TrainingDataset ;
    rdfs:label "He-PAH PBE0-D4/def2-SVP interaction energies for the four PAHs combined" ;
    mlips:coversMaterial entity:mat-hepah-shen2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe0d4-shen2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SOG-Net a mlips:MLIPMethod ;
    rdfs:label "SOG-Net (sum-of-Gaussians neural network for long-range interactions)" ;
    mlips:hasFunctionalForm entity:ff-SOG-Net ;
    mlips:hasLossFunction entity:loss-SOG-Net-shen2026 ;
    mlips:hasTrainingAlgorithm entity:alg-SOG-Net-shen2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs .

entity:ff-SOG-Net a mlips:FunctionalForm ;
    rdfs:label "Short-range descriptor network (core-shell Deep-Potential-type descriptors) plus a long-range energy from latent variables convolved with a learnable sum-of-Gaussians multiplier in Fourier space" .

entity:loss-SOG-Net-shen2026 a mlips:LossFunction ;
    rdfs:label "MSE on binding energies plus a force term (prefactor 0.005) when forces exist; cutoff-variance and centre-alignment regularisers for the adaptive cutoff" .

entity:alg-SOG-Net-shen2026 a mls:Algorithm ;
    rdfs:label "AdamW, weight decay 1e-4, step scheduler (8,000 steps, factor 0.5)" .

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-DeePMD-shen2026 .

entity:impl-DeePMD-shen2026 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dpmd-cutoffRadius-shen2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:double .

entity:setting-fixed-ft-cutoffRadius-shen2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:double .

entity:setting-fixed-ft-learningRate-shen2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-fixed-ft-batchSize-shen2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-fixed-ft-numEpochs-shen2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "10000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dpmd-shen2026 a mlips:MLIPRun ;
    rdfs:label "DeePMD se_e2_a baseline fitted directly to He-benzene CCSD(T) binding energies" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-cc50-shen2026 ;
    mlips:hasHyperparameterSetting entity:setting-dpmd-cutoffRadius-shen2026 ;
    mlips:produces entity:model-dpmd-shen2026 .

entity:model-dpmd-shen2026 a mlips:TrainedModel ;
    rdfs:label "He-benzene DeePMD baseline" .

entity:run-fixed-ft-shen2026 a mlips:MLIPRun ;
    rdfs:label "Fixed-cutoff SR/LR student (SOG-Net; Orb-distilled) fine-tuned on 50 % CCSD(T)" ;
    mlips:appliesMethod entity:SOG-Net ;
    mlips:runsOn entity:ds-cc50-shen2026 ;
    mlips:hasHyperparameterSetting entity:setting-fixed-ft-cutoffRadius-shen2026 ,
        entity:setting-fixed-ft-learningRate-shen2026 ,
        entity:setting-fixed-ft-batchSize-shen2026 ,
        entity:setting-fixed-ft-numEpochs-shen2026 ;
    mlips:produces entity:model-fixed-ft-shen2026 .

entity:model-fixed-ft-shen2026 a mlips:TrainedModel ;
    rdfs:label "He-benzene fixed-cutoff SR/LR (Orb teacher, CCSD(T) fine-tuned)" .

entity:run-dft-student-shen2026 a mlips:MLIPRun ;
    rdfs:label "SAPT-informed SR/LR student trained on DFT labels (Table I 'DFT' route), before CCSD(T) fine-tuning" ;
    mlips:appliesMethod entity:SOG-Net ;
    mlips:runsOn entity:ds-teach-dft-shen2026 ;
    mlips:produces entity:model-dft-student-shen2026 .

entity:model-dft-student-shen2026 a mlips:TrainedModel ;
    rdfs:label "He-benzene SAPT SR/LR student (DFT labels)" .

entity:run-dist-orb-shen2026 a mlips:MLIPRun ;
