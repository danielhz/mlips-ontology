###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-inorganic-barrosoluque2024 a mlips:MaterialSystem ;
    rdfs:label "Inorganic materials across the periodic table (OMat24, from Alexandria structures)" ;
    mlips:materialClass "Inorganic crystalline materials (equilibrium and non-equilibrium)" .

entity:mat-wbm-barrosoluque2024 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals of the WBM test set (Matbench Discovery)" ;
    mlips:materialClass "Inorganic crystalline materials" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-omat-dft-barrosoluque2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-omat-dft-barrosoluque2024 mlips:hasDFTSettings entity:calc-settings-omat-dft-barrosoluque2024 .

entity:calc-settings-omat-dft-barrosoluque2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "Materials Project defaults (MPRelaxSet) with PBE 54 pseudopotentials and ALGO Normal; Hubbard U for oxides and fluorides containing Co, Cr, Fe, Mn, Mo, Ni, V or W (Sec. 4.2)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-omat24-barrosoluque2024 a mlips:TrainingDataset ;
    rdfs:label "OMat24 training split (100,824,585 structures)" ;
    mlips:coversMaterial entity:mat-inorganic-barrosoluque2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 100824585 ;
    mlips:hasDFTCalculation entity:calc-omat-dft-barrosoluque2024 ;
    rdfs:comment "118 million structures in total with validation, WBM, ID, OOD-composition and OOD-element test splits; released under CC-BY 4.0." .

entity:ds-mptrj-barrosoluque2024 a mlips:TrainingDataset ;
    rdfs:label "MPtrj" ;
    mlips:coversMaterial entity:mat-inorganic-barrosoluque2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

entity:ds-mptrj-salex-barrosoluque2024 a mlips:TrainingDataset ;
    rdfs:label "MPtrj combined with sAlex (subsampled Alexandria, 10 million training structures)" ;
    mlips:coversMaterial entity:mat-inorganic-barrosoluque2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    rdfs:comment "sAlex removes Alexandria trajectories matching WBM prototypes and structures with energy > 0 eV, force norm > 50 eV/A or stress > 80 GPa, keeping frames differing by more than 10 meV/atom (Sec. 4.3)." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-omat24-barrosoluque2024 mlips:samplingStrategy
    entity:sampling-rattled-boltzmann-barrosoluque2024 ,
    entity:sampling-rattled-relax-barrosoluque2024 ,
    entity:sampling-aimd-barrosoluque2024 .

entity:sampling-rattled-boltzmann-barrosoluque2024 a mlips:SamplingStrategy ;
    rdfs:label "Rattled Boltzmann sampling of Alexandria structures" .

entity:sampling-rattled-relax-barrosoluque2024 a mlips:SamplingStrategy ;
    rdfs:label "Rattled relaxations of Alexandria structures" .

entity:sampling-aimd-barrosoluque2024 a mlips:SamplingStrategy ;
    rdfs:label "Short AIMD runs (50 steps of 2 fs)" ;
    rdfs:comment "Time step chosen for diversity rather than accurate integration (Sec. 4.2)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:hasLossFunction entity:loss-EquiformerV2-barrosoluque2024 ;
    mlips:hasTrainingAlgorithm entity:alg-EquiformerV2-barrosoluque2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numRadialBasis ,
        entity:hp-Lmax-barrosoluque2024 ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-EquiformerV2-barrosoluque2024 .

entity:loss-EquiformerV2-barrosoluque2024 a mlips:LossFunction ;
    rdfs:label "Weighted energy, force and stress loss (coefficients 20, 20, 5) with optional DeNS denoising objective" .

entity:alg-EquiformerV2-barrosoluque2024 a mls:Algorithm ;
    rdfs:label "AdamW with cosine schedule, EMA 0.999" .

entity:impl-EquiformerV2-barrosoluque2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-barrosoluque2024 .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:hasLossFunction entity:loss-eSEN-barrosoluque2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-eSEN-barrosoluque2024 .

entity:loss-eSEN-barrosoluque2024 a mlips:LossFunction ;
    rdfs:label "Energy, force and stress loss; direct-force pretraining followed by conservative fine-tuning" .

entity:impl-eSEN-barrosoluque2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-barrosoluque2024 .

entity:lib-fairchem-barrosoluque2024 a mlips:Library ;
    rdfs:label "fairchem" ;
    rdfs:comment "https://github.com/FAIR-Chem/fairchem, MIT licence" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Lmax-barrosoluque2024 a mlips:Hyperparameter ;
    rdfs:label "Maximum degree Lmax of the equivariant features" ;
    mlips:hyperparameterName "Lmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

