# Canonical Turtle for the protocol-derived encoding of:
#   Luis Barroso-Luque et al. (2024). Open Materials 2024 (OMat24) Inorganic Materials Dataset and Models.
#   arXiv. doi:10.48550/arxiv.2410.12771  arXiv:2410.12771v2
#
# Version read: arxiv-preprint arXiv:2410.12771v2 (sha256 3bbcd0bb5ced6be0...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 221 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/barrosoluque2024.yaml.
#
# Encoding scope: the OMat24 data set and the sAlex subset of Alexandria
# introduced here, and the eight eSEN and EquiformerV2 models of the
# Matbench Discovery comparison (Table 2): pretrained on OMat24 or OC20
# and fine-tuned on MPtrj or on MPtrj and sAlex. Their energy-above-hull
# MAE, RMSE and R2 are encoded; the classification scores, the thermal-
# conductivity SRME, the softening analysis and the MPtrj-only models of
# the SI are not.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-barrosoluque2024 a mlips:BenchmarkStudy ;
    rdfs:label "Barroso-Luque et al. (2024): Open Materials 2024 (OMat24) data set and models" ;
    mlips:reportedIn entity:article-barrosoluque2024 .

entity:article-barrosoluque2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2410.12771> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Open Materials 2024 (OMat24) Inorganic Materials Dataset and Models" ;
    schema:author entity:person-BarrosoLuque-barrosoluque2024 ,
        entity:person-Shuaibi-barrosoluque2024 ,
        entity:person-Fu-barrosoluque2024 ,
        entity:person-Wood-barrosoluque2024 ,
        entity:person-Dzamba-barrosoluque2024 ,
        entity:person-Gao-barrosoluque2024 ,
        entity:person-Rizvi-barrosoluque2024 ,
        entity:person-Zitnick-barrosoluque2024 ,
        entity:person-Ulissi-barrosoluque2024 .

