entity:run-esen-30m-oam-barrosoluque2024 a mlips:MLIPRun ;
    rdfs:label "eSEN-30M pretrained on OMat24, fine-tuned on MPtrj-sAlex" ;
    mlips:appliesMethod entity:eSEN ;
    mlips:runsOn entity:ds-mptrj-salex-barrosoluque2024 ;
    mlips:hasHyperparameterSetting entity:setting-esen-30m-oam-cutoffRadius-barrosoluque2024 ,
        entity:setting-esen-30m-oam-learningRate-barrosoluque2024 ,
        entity:setting-esen-30m-oam-batchSize-barrosoluque2024 ,
