# Q10 -- Benchmark results
###############################################################################

entity:study-maxson2025 mlips:hasResult
    entity:result-MACE-ZrO-maxson2025 .

entity:result-MACE-ZrO-maxson2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-MACE-ZrO-maxson2025 ;
    mlips:targetMaterial entity:mat-ZrO-maxson2025 ;
    mlips:hasAccuracyMetric entity:metric-MACE-ZrO-1-maxson2025 ,
        entity:metric-MACE-ZrO-2-maxson2025 .

entity:metric-MACE-ZrO-1-maxson2025 a mlips:AccuracyMetric ;
    rdfs:label "MAE on energy: MACE, Zr-O (value printed in the text)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "5.21"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-MACE-ZrO-2-maxson2025 a mlips:AccuracyMetric ;
    rdfs:label "MAE on forces: MACE, Zr-O (value printed in the text)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "55"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Inference speeds of the error-optimised models are compared in LAMMPS on
# a 40 GB A100 GPU and shown as figures; training wall times and hardware
# are in the SI and the Zenodo repository.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Energy, force and stress errors of the 40 models are bar charts; only the MACE Zr-O values quoted in the text are encoded (the text also gives ranges for Zr-O over all architectures: energy MAE 4-13 meV/atom, force MAE 55-190 meV/A). The numbers are in the Zenodo repository of the paper.
# - Table 8 (data training rates: log-log slopes of error against training-set size from 50 to 1000 points) has no MetricProperty.
# - Only part of each hyperparameter table is encoded: L_max / l_max as numAngularBasis, 'Input Features' (NequIP, Allegro) and 'Number of channels' (MACE) as numFeatures, batch size, epochs, MTP lev_max and radial basis size, the ANI architecture and force coefficient. Network depths and widths, polynomial cutoffs, loss phase weights and stress coefficients are left out. NequIP and Allegro tables do not distinguish the two sizes of MgO and water, so both sizes carry the same settings.
# - The radial cutoff of Table 1 is shared by all five architectures of a system. For ANI the mapping of that cutoff to its radial/angular cutoffs was not captured.
# - The software used for ANI and MTP training is not named in the parts read. Property benchmarks (RDFs, diffusion, vibrational spectra, reaction energies, transferability to FAU/LTA/MFI) have no MetricProperty.
# - Data-set sizes: the 1000-point split is the largest training size studied; the full sizes of the six data sets were not captured.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
