entity:setting-Allegro-MgO-2x2-numAngularBasis-maxson2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-Allegro-MgO-2x2-numFeatures-maxson2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-Allegro-MgO-2x2-batchSize-maxson2025 a mlips:HyperparameterSetting ;
