# Canonical Turtle for the protocol-derived encoding of:
#   Tristan Maxson et al. (2025). MS25: Materials Science-Focused Benchmark Data Set for Machine Learning Interatomic Potentials.
#   Journal of Chemical Information and Modeling. doi:10.1021/acs.jcim.5c01262
#
# Version read: publisher (sha256 99296decd0b092f2...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 65 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the MS25 benchmark: six systems (MgO surface, liquid
# water, CHA zeolite, a surface reaction, a high-entropy alloy, Zr-O),
# two of them in two sizes, and the five MLIP architectures trained from
# scratch on each with optimised hyperparameters (Tables 1-5 and 7):
# 40 runs. Errors are shown as figures; the one pair of values printed
# in the text is encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-maxson2025 a mlips:BenchmarkStudy ;
    rdfs:label "Maxson et al. (2025): MS25, a materials-science-focused benchmark data set for MLIPs, with MACE, NequIP, Allegro, ANI and MTP models" ;
    mlips:reportedIn entity:article-maxson2025 .

entity:article-maxson2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jcim.5c01262> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "MS25: Materials Science-Focused Benchmark Data Set for Machine Learning Interatomic Potentials" ;
    schema:author <https://orcid.org/0000-0002-7668-8986> ,
        <https://orcid.org/0000-0002-1914-3306> ,
        <https://orcid.org/0000-0003-1698-692X> ,
        <https://orcid.org/0000-0003-3695-727X> ,
        <https://orcid.org/0000-0002-4218-1570> .

<https://orcid.org/0000-0002-7668-8986> a schema:Person ;
    schema:name "Tristan Maxson" ;
    schema:givenName "Tristan" ;
    schema:familyName "Maxson" ;
    schema:identifier <https://orcid.org/0000-0002-7668-8986> .

<https://orcid.org/0000-0002-1914-3306> a schema:Person ;
    schema:name "Ademola Soyemi" ;
    schema:givenName "Ademola" ;
    schema:familyName "Soyemi" ;
    schema:identifier <https://orcid.org/0000-0002-1914-3306> .

<https://orcid.org/0000-0003-1698-692X> a schema:Person ;
    schema:name "Xinglong Zhang" ;
    schema:givenName "Xinglong" ;
    schema:familyName "Zhang" ;
    schema:identifier <https://orcid.org/0000-0003-1698-692X> .

<https://orcid.org/0000-0003-3695-727X> a schema:Person ;
    schema:name "Benjamin W. J. Chen" ;
    schema:givenName "Benjamin W. J." ;
    schema:familyName "Chen" ;
    schema:identifier <https://orcid.org/0000-0003-3695-727X> .

<https://orcid.org/0000-0002-4218-1570> a schema:Person ;
    schema:name "Tibor Szilvási" ;
    schema:givenName "Tibor" ;
    schema:familyName "Szilvási" ;
    schema:identifier <https://orcid.org/0000-0002-4218-1570> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-MgO-2x2-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "MgO(100) surface, 2x2x4 slab" ;
    mlips:materialClass "MS25 benchmark system" .

entity:mat-MgO-4x4-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "MgO(100) surface, 4x4x4 slab" ;
    mlips:materialClass "MS25 benchmark system" .

entity:mat-Water-64-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk liquid water, 64 molecules" ;
    mlips:materialClass "MS25 benchmark system" .

entity:mat-Water-192-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "Bulk liquid water, 192 molecules" ;
    mlips:materialClass "MS25 benchmark system" .

entity:mat-CHA-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "CHA zeolite framework" ;
    mlips:materialClass "MS25 benchmark system" .

entity:mat-Reaction-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "Methane C-H bond cleavage on Pt(111)" ;
    mlips:materialClass "MS25 benchmark system" .

entity:mat-HEA-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "FeNiCrCoCu high-entropy alloy (EAM reference)" ;
    mlips:materialClass "MS25 benchmark system" .

entity:mat-ZrO-maxson2025 a mlips:MaterialSystem ;
    rdfs:label "Zr-O chemical space (amorphous Zr-containing oxides)" ;
    mlips:materialClass "MS25 benchmark system" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mgo-maxson2025 a mlips:DFTCalculation .

entity:calc-water-maxson2025 a mlips:DFTCalculation .

entity:calc-cha-maxson2025 a mlips:DFTCalculation .

entity:calc-rxn-maxson2025 a mlips:DFTCalculation .

entity:calc-eam-maxson2025 a mlips:ReferenceCalculation .

entity:calc-zro-maxson2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mgo-maxson2025 mlips:hasDFTSettings entity:calc-settings-mgo-maxson2025 .

entity:calc-settings-mgo-maxson2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-D3-maxson2025 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred Monkhorst-Pack (3, 3, 1) for the 2x2 slab and (1, 1, 1) for the 4x4 slab" ;
    rdfs:comment "VASP 6.3.2, PAW potentials version 54, Gaussian smearing 0.1 eV, dipole corrections." .

entity:calc-water-maxson2025 mlips:hasDFTSettings entity:calc-settings-water-maxson2025 .

entity:calc-settings-water-maxson2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-maxson2025 ;
    mlips:xcFunctional entity:xc-RPBE-D3-0-maxson2025 ;
    mlips:dftBasisSet entity:basis-DZVP-MOLOPT-SR-GTH-maxson2025 ;
    mlips:kPointMesh "Gamma point only" ;
    rdfs:comment "CP2K 2024.1 with GTH-PBE pseudopotentials, plane-wave cutoff 1200 Ry, orbital transformation method." .

entity:calc-cha-maxson2025 mlips:hasDFTSettings entity:calc-settings-cha-maxson2025 .

entity:calc-settings-cha-maxson2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-maxson2025 ;
    mlips:xcFunctional entity:xc-RPBE-D3-maxson2025 ;
    mlips:kPointMesh "Gamma point only" ;
    rdfs:comment "CP2K 2024.1 with GTH-PBE pseudopotentials, plane-wave cutoff 1000 Ry, orbital transformation method." .

entity:calc-rxn-maxson2025 mlips:hasDFTSettings entity:calc-settings-rxn-maxson2025 .

entity:calc-settings-rxn-maxson2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-D4-maxson2025 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    rdfs:comment "VASP 6.3.2, PAW potentials version 54, Gaussian smearing 0.2 eV, dipole corrections." .

entity:calc-eam-maxson2025 mlips:hasReferenceSettings entity:calc-settings-eam-maxson2025 .

entity:calc-settings-eam-maxson2025 a mlips:ReferenceSettings ;
    mlips:usedReferenceCode entity:lib-LAMMPS-maxson2025 ;
    rdfs:comment "Embedded-atom-model calculations in LAMMPS with the FeNiCrCoCu-with-ZBL potential; a classical potential is the reference for the HEA set." .

entity:calc-zro-maxson2025 mlips:hasDFTSettings entity:calc-settings-zro-maxson2025 .

entity:calc-settings-zro-maxson2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    rdfs:comment "VASP 5.4.4, PAW potentials version 52 (Zr_sv); data generated in a previously published work." .

entity:xc-PBE-D3-maxson2025 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:lib-CP2K-maxson2025 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-RPBE-D3-0-maxson2025 a mlips:XCFunctional ;
    rdfs:label "RPBE-D3(0)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-DZVP-MOLOPT-SR-GTH-maxson2025 a mlips:DftBasisSet ;
    rdfs:label "DZVP-MOLOPT-SR-GTH" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

entity:lib-CP2K-maxson2025 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-RPBE-D3-maxson2025 a mlips:XCFunctional ;
    rdfs:label "RPBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-PBE-D4-maxson2025 a mlips:XCFunctional ;
    rdfs:label "PBE-D4" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:lib-LAMMPS-maxson2025 a mlips:Library ;
    rdfs:label "LAMMPS" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-MgO-2x2-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 MgO(100) surface, 2x2x4 slab: 1000-point training split" ;
    mlips:coversMaterial entity:mat-MgO-2x2-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-mgo-maxson2025 .

entity:ds-MgO-4x4-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 MgO(100) surface, 4x4x4 slab: 1000-point training split" ;
    mlips:coversMaterial entity:mat-MgO-4x4-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-mgo-maxson2025 .

entity:ds-Water-64-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 Bulk liquid water, 64 molecules: 1000-point training split" ;
    mlips:coversMaterial entity:mat-Water-64-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-water-maxson2025 .

entity:ds-Water-192-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 Bulk liquid water, 192 molecules: 1000-point training split" ;
    mlips:coversMaterial entity:mat-Water-192-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-water-maxson2025 .

entity:ds-CHA-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 CHA zeolite framework: 1000-point training split" ;
    mlips:coversMaterial entity:mat-CHA-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-cha-maxson2025 .

entity:ds-Reaction-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 Methane C-H bond cleavage on Pt(111): 1000-point training split" ;
    mlips:coversMaterial entity:mat-Reaction-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-rxn-maxson2025 .

entity:ds-HEA-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 FeNiCrCoCu high-entropy alloy (EAM reference): 1000-point training split" ;
    mlips:coversMaterial entity:mat-HEA-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasReferenceCalculation entity:calc-eam-maxson2025 .

entity:ds-ZrO-maxson2025 a mlips:TrainingDataset ;
    rdfs:label "MS25 Zr-O chemical space (amorphous Zr-containing oxides): 1000-point training split" ;
    mlips:coversMaterial entity:mat-ZrO-maxson2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-zro-maxson2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-MgO-2x2-maxson2025 mlips:samplingStrategy
    entity:sampling-aimd-maxson2025 .

entity:ds-MgO-4x4-maxson2025 mlips:samplingStrategy
    entity:sampling-aimd-maxson2025 .

entity:ds-Water-64-maxson2025 mlips:samplingStrategy
    entity:sampling-mlip-md-maxson2025 .

entity:ds-Water-192-maxson2025 mlips:samplingStrategy
    entity:sampling-mlip-md-maxson2025 .

entity:ds-CHA-maxson2025 mlips:samplingStrategy
    entity:sampling-mlip-md-maxson2025 .

entity:ds-Reaction-maxson2025 mlips:samplingStrategy
    entity:sampling-aimd-maxson2025 .

entity:ds-HEA-maxson2025 mlips:samplingStrategy
    entity:sampling-eam-md-maxson2025 .

entity:ds-ZrO-maxson2025 mlips:samplingStrategy
    entity:sampling-zro-mixed-maxson2025 .

entity:sampling-aimd-maxson2025 a mlips:SamplingStrategy ;
    rdfs:label "Ab initio MD (NVT) with decorrelated sampling" ;
    rdfs:comment "MgO: Nose-Hoover NVT, frames at least 25 fs apart; Reaction: Blue Moon constrained MD along the C-H bond length (SHAKE), frames at least 10 fs apart." .

entity:sampling-mlip-md-maxson2025 a mlips:SamplingStrategy ;
    rdfs:label "MD with an intermediate Allegro MLIP, relabelled with DFT" ;
    rdfs:comment "Water and CHA: an Allegro model trained on initial DFT structures samples configurations (at 300 K over a distribution of volumes) at least 30 ps (water) or 50 ps (CHA) apart; DFT single points form the data set." .

entity:sampling-eam-md-maxson2025 a mlips:SamplingStrategy ;
    rdfs:label "EAM MD over random compositions and temperatures" ;
    rdfs:comment "HEA: configurations at least 5 ps apart across an even distribution of temperatures, compositions chosen at random." .

entity:sampling-zro-mixed-maxson2025 a mlips:SamplingStrategy ;
    rdfs:label "Random structure generation, MD, rattling, dimer search and contour exploration" ;
    rdfs:comment "Zr-O data of a previously published work." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numAngularBasis ,
        mlips:numFeatures ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-maxson2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-maxson2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numAngularBasis ,
        mlips:numFeatures ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NequIP-maxson2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-NequIP-maxson2025 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP ;
    mlips:version "MD in LAMMPS with pair_nequip" .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numAngularBasis ,
        mlips:numFeatures ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-Allegro-maxson2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-Allegro-maxson2025 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro ;
    mlips:version "run in LAMMPS (12 December 2023 development version, CUDA 12.0, PyTorch 2.0.1)" .

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-nn-architecture-maxson2025 ,
        mlips:batchSize ,
        entity:hp-force-coefficient-maxson2025 ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ,
        mlips:numRadialBasis ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:hp-nn-architecture-maxson2025 a mlips:Hyperparameter ;
    rdfs:label "ANI atomic network architecture (hidden-layer widths)" ;
    mlips:hyperparameterName "nn_architecture" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-force-coefficient-maxson2025 a mlips:Hyperparameter ;
    rdfs:label "Force coefficient in the loss" ;
    mlips:hyperparameterName "force_coefficient" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-NequIP-MgO-2x2-cutoffRadius-maxson2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-NequIP-MgO-2x2-numAngularBasis-maxson2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-NequIP-MgO-2x2-numFeatures-maxson2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
