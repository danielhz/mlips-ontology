entity:setting-ANI-MgO-2x2-batchSize-maxson2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-ANI-MgO-2x2-force-coefficient-maxson2025 a mlips:HyperparameterSetting ;
