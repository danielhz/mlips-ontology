# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-r-n-gan-dai2026 a mlips:MLIPRun ;
    rdfs:label "Allegro for neutral V_N in GaN (training set IV)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-n-gan-dai2026 ;
    mlips:hasHyperparameterSetting entity:setting-r-n-gan-cutoffRadius-dai2026 ,
        entity:setting-r-n-gan-numLayers-dai2026 ,
        entity:setting-r-n-gan-learningRate-dai2026 ,
        entity:setting-r-n-gan-lmax-dai2026 ;
    mlips:produces entity:model-r-n-gan-dai2026 .

entity:model-r-n-gan-dai2026 a mlips:TrainedModel ;
    rdfs:label "Allegro neutral V_N in GaN" .

entity:run-r-n-sio2-dai2026 a mlips:MLIPRun ;
    rdfs:label "Allegro for neutral V_O in SiO2 (training set III)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-n-sio2-dai2026 ;
    mlips:hasHyperparameterSetting entity:setting-r-n-sio2-cutoffRadius-dai2026 ,
