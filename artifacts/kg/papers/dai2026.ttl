###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-gan-dai2026 a mlips:MaterialSystem ;
    rdfs:label "GaN with nitrogen vacancies" ;
    mlips:chemicalFormula "GaN" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-sio2-dai2026 a mlips:MaterialSystem ;
    rdfs:label "SiO2 with oxygen vacancies" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-czts-dai2026 a mlips:MaterialSystem ;
    rdfs:label "Cu2ZnSnS4 with Cu_Zn antisites" ;
    mlips:chemicalFormula "Cu2ZnSnS4" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-dai2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-dai2026 mlips:hasDFTSettings entity:calc-settings-vasp-dai2026 .

entity:calc-settings-vasp-dai2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "Spin-polarized; cutoff 400 eV for GaN and SiO2, 295 eV for Cu2ZnSnS4; Gamma-centred k-meshes scaled with supercell size (Table I)." .

