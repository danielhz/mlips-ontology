###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-dai2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-dai2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ,
        entity:hp-lmax-dai2026 ;
    mlips:hasImplementation entity:impl-Allegro-dai2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-Allegro-dai2026 a mlips:LossFunction ;
    rdfs:label "Sum of MSEs of forces and per-atom energies, both weights 1.0" .

entity:alg-Allegro-dai2026 a mls:Algorithm ;
    rdfs:label "Adam, ReduceLROnPlateau (factor 0.5, patience 20), early stopping (patience 50)" .

entity:impl-Allegro-dai2026 a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

entity:hp-lmax-dai2026 a mlips:Hyperparameter ;
    rdfs:label "Allegro maximum spherical-harmonic order l_max" ;
    mlips:hyperparameterName "l_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

