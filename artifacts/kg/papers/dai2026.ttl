    schema:sameAs <https://doi.org/10.48550/arxiv.2609.24293> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Small-supercell and Small-dataset Training Strategy of Machine Learning Interatomic Potentials for Point Defects" ;
    schema:author entity:person-Dai-dai2026 ,
        entity:person-Ni-dai2026 ,
        entity:person-Li-dai2026 ,
        entity:person-Huang-dai2026 ,
