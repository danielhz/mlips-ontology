###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:AlphaNet a mlips:MLIPMethod ;
    rdfs:label "AlphaNet (local-frame equivariant graph neural network potential)" ;
    mlips:hasLossFunction entity:loss-AlphaNet-yin2025 ;
    mlips:hasTrainingAlgorithm entity:alg-AlphaNet-yin2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-AlphaNet-yin2025 a mlips:LossFunction ;
    rdfs:label "Energy and force (and stress for MPtrj) losses; OC20: lambda_F = 100, lambda_E = 4 or 20" .

entity:alg-AlphaNet-yin2025 a mls:Algorithm ;
    rdfs:label "Local frames with rotary position embedding" .

