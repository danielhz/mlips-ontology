    mlips:produces entity:model-lih-ml-dft-schonbauer2026 .

entity:model-lih-ml-dft-schonbauer2026 a mlips:TrainedModel ;
    rdfs:label "LiH ML(DFT_E,F)" .

entity:run-lih-ml-delta-schonbauer2026 a mlips:MLIPRun ;
    rdfs:label "ML(CCSD(T)-DFT) MACE Delta model for LiH" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-lih-delta-schonbauer2026 ;
    mlips:hasHyperparameterSetting entity:setting-lih-ml-delta-cutoffRadius-schonbauer2026 ,
