###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-c-schonbauer2026 a mlips:MaterialSystem ;
    rdfs:label "Diamond (32-atom supercells, 0-500 K MD)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental covalent solid" .

entity:mat-lih-schonbauer2026 a mlips:MaterialSystem ;
    rdfs:label "Rock-salt LiH (64-atom supercells)" ;
    mlips:chemicalFormula "LiH" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-schonbauer2026 a mlips:DFTCalculation .

entity:calc-lda-schonbauer2026 a mlips:DFTCalculation .

entity:calc-ccsdt-schonbauer2026 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-schonbauer2026 mlips:hasDFTSettings entity:calc-settings-pbe-schonbauer2026 .

entity:calc-settings-pbe-schonbauer2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Diamond MD (2x2x1 conventional supercell, 32 atoms, 2,000 steps, 0-500 K sweep)." .

entity:calc-lda-schonbauer2026 mlips:hasDFTSettings entity:calc-settings-lda-schonbauer2026 .

entity:calc-settings-lda-schonbauer2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:LDA ;
    rdfs:comment "LiH MD (2x2x2 supercell, 64 atoms, 2,000 steps)." .

entity:calc-ccsdt-schonbauer2026 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-schonbauer2026 .

entity:calc-settings-ccsdt-schonbauer2026 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    rdfs:comment "Periodic CCSD(T) energies with Cc4s interfaced to VASP (Gamma point, 10 frozen natural orbitals per occupied state, basis-set and finite-size corrections) on 200 MD structures; HF with 3x3x3 k-points and 400 eV (Sec. 4.3.3)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-c-dft-schonbauer2026 a mlips:TrainingDataset ;
    rdfs:label "Diamond DFT MD structures used for ML(DFT_E,F) (the same 200 as the Delta data)" ;
    mlips:coversMaterial entity:mat-c-schonbauer2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 200 ;
    mlips:hasDFTCalculation entity:calc-pbe-schonbauer2026 .

entity:ds-c-delta-schonbauer2026 a mlips:TrainingDataset ;
    rdfs:label "Diamond CCSD(T) - PBE energy differences (200 structures)" ;
    mlips:coversMaterial entity:mat-c-schonbauer2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 200 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-schonbauer2026 .

entity:ds-lih-dft-schonbauer2026 a mlips:TrainingDataset ;
    rdfs:label "LiH LDA MD structures (2,000)" ;
    mlips:coversMaterial entity:mat-lih-schonbauer2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2000 ;
    mlips:hasDFTCalculation entity:calc-lda-schonbauer2026 .

entity:ds-lih-delta-schonbauer2026 a mlips:TrainingDataset ;
    rdfs:label "LiH CCSD(T) - LDA energy differences (200 structures)" ;
    mlips:coversMaterial entity:mat-lih-schonbauer2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 200 ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-schonbauer2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-schonbauer2026 ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:MolecularDynamics .

entity:impl-MACE-schonbauer2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:QNEP a mlips:MLIPMethod ;
    rdfs:label "QNEP (charge-aware neuroevolution potential with partial charges and long-range electrostatics)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-QNEP-schonbauer2026 ;
    mlips:supportsSimulation mlips:PhononCalculation .

entity:impl-QNEP-schonbauer2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-schonbauer2026 .

entity:lib-GPUMD-schonbauer2026 a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-c-ml-dft-cutoffRadius-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3"^^xsd:double .

entity:setting-c-ml-dft-numEpochs-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-c-ml-delta-cutoffRadius-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3"^^xsd:double .

entity:setting-c-ml-delta-numEpochs-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-lih-ml-dft-cutoffRadius-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "9"^^xsd:double .

entity:setting-lih-ml-dft-numEpochs-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-lih-ml-delta-cutoffRadius-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "9"^^xsd:double .

entity:setting-lih-ml-delta-numEpochs-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-lih-qnep-cutoffRadius-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:double .

entity:setting-lih-qnep-angularCutoff-schonbauer2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-c-ml-dft-schonbauer2026 a mlips:MLIPRun ;
    rdfs:label "ML(DFT_E,F) MACE for diamond (five seeds)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-c-dft-schonbauer2026 ;
    mlips:hasHyperparameterSetting entity:setting-c-ml-dft-cutoffRadius-schonbauer2026 ,
        entity:setting-c-ml-dft-numEpochs-schonbauer2026 ;
    mlips:produces entity:model-c-ml-dft-schonbauer2026 .

entity:model-c-ml-dft-schonbauer2026 a mlips:TrainedModel ;
    rdfs:label "diamond ML(DFT_E,F)" .

entity:run-c-ml-delta-schonbauer2026 a mlips:MLIPRun ;
    rdfs:label "ML(CCSD(T)-DFT) MACE Delta model for diamond (added to ML(DFT_E,F))" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-c-delta-schonbauer2026 ;
    mlips:hasHyperparameterSetting entity:setting-c-ml-delta-cutoffRadius-schonbauer2026 ,
        entity:setting-c-ml-delta-numEpochs-schonbauer2026 ;
    mlips:produces entity:model-c-ml-delta-schonbauer2026 .

entity:model-c-ml-delta-schonbauer2026 a mlips:TrainedModel ;
    rdfs:label "diamond Delta-ML(CCSD(T))" .

entity:run-lih-ml-dft-schonbauer2026 a mlips:MLIPRun ;
    rdfs:label "ML(DFT_E,F) MACE for LiH (five seeds)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-lih-dft-schonbauer2026 ;
    mlips:hasHyperparameterSetting entity:setting-lih-ml-dft-cutoffRadius-schonbauer2026 ,
