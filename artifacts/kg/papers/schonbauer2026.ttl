# Canonical Turtle for the protocol-derived encoding of:
#   Sita Schönbauer et al. (2026). Machine-Learned Force Fields for Lattice Dynamics at Coupled-Cluster Level Accuracy.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.6c00854  arXiv:2507.06929v2
#
# Version read: arxiv-preprint arXiv:2507.06929v2 (sha256 a5bee3da0c8e4c1f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 425 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/schonbauer2026.yaml.
#
# Encoding scope: MACE models trained on DFT energies and forces
# (ML(DFT_E,F); PBE for diamond, LDA for LiH, VASP MD) and MACE Delta
# models trained on WFT - DFT energy differences for 200 configurations
# (HF, MP2, CCSD, CCSD(T) with Cc4s), whose sum gives Delta-ML(WFT), plus
# QNEP models for LiH. RMSEs are given only in the SI ('meV/atom range');
# phonon dispersions and densities of states are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-schonbauer2026 a mlips:BenchmarkStudy ;
    rdfs:label "Schönbauer et al. (2026): Delta-learned MLFFs for lattice dynamics of diamond and LiH at HF, MP2, CCSD and CCSD(T) level" ;
    mlips:reportedIn entity:article-schonbauer2026 .

entity:article-schonbauer2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.6c00854> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Machine-Learned Force Fields for Lattice Dynamics at Coupled-Cluster Level Accuracy" ;
