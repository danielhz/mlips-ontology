entity:run-lih-qnep-schonbauer2026 a mlips:MLIPRun ;
    rdfs:label "QNEP ML(DFT_E,F) for LiH (charge mode 2, default settings)" ;
    mlips:appliesMethod entity:QNEP ;
    mlips:runsOn entity:ds-lih-dft-schonbauer2026 ;
    mlips:hasHyperparameterSetting entity:setting-lih-qnep-cutoffRadius-schonbauer2026 ,
