# Canonical Turtle for the protocol-derived encoding of:
#   Bowen Deng et al. (2024). Overcoming systematic softening in universal machine learning interatomic potentials by fine-tuning.
#   arXiv (Cornell University). doi:10.48550/arxiv.2405.07105  arXiv:2405.07105v1
#
# Version read: arxiv-preprint arXiv:2405.07105v1 (sha256 6bd7a27432581553...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 227 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/deng2024.yaml.
#
# Encoding scope: the three pretrained universal MLIPs (registry models
# M3GNet 2021.2.8, CHGNet v0.3.0, MACE-MP-0 2023.12.03) evaluated on out-of-
# distribution tasks, with the errors stated as numbers in the text: Mg-ion
# migration barriers, the MACE surface-energy MAE, and force MAEs on
# high-energy states of Li2B3PO8; and two CHGNet models fine-tuned on
# Li2B3PO8 (a one-label scalar correction and a 10-structure fine-tune).
# Errors shown only in figures (defects, solid solutions, phonons, the 1000
# WBM compounds) are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-deng2024 a mlips:BenchmarkStudy ;
    rdfs:label "Deng et al. (2024): systematic softening of universal MLIPs (M3GNet, CHGNet, MACE-MP-0) and its correction by fine-tuning" ;
    mlips:reportedIn entity:article-deng2024 .

entity:article-deng2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2405.07105> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Overcoming systematic softening in universal machine learning interatomic potentials by fine-tuning" ;
    schema:author entity:person-Deng-deng2024 ,
        entity:person-Choi-deng2024 ,
        entity:person-Zhong-deng2024 ,
        entity:person-Riebesell-deng2024 ,
        entity:person-Anand-deng2024 ,
        entity:person-Li-deng2024 ,
        entity:person-Jun-deng2024 ,
        entity:person-Persson-deng2024 ,
        entity:person-Ceder-deng2024 .

entity:person-Deng-deng2024 a schema:Person ;
    schema:name "Bowen Deng" ;
    schema:givenName "Bowen" ;
    schema:familyName "Deng" .

entity:person-Choi-deng2024 a schema:Person ;
    schema:name "Yunyeong Choi" ;
    schema:givenName "Yunyeong" ;
    schema:familyName "Choi" .

entity:person-Zhong-deng2024 a schema:Person ;
    schema:name "Peichen Zhong" ;
    schema:givenName "Peichen" ;
    schema:familyName "Zhong" .

entity:person-Riebesell-deng2024 a schema:Person ;
    schema:name "Janosh Riebesell" ;
    schema:givenName "Janosh" ;
    schema:familyName "Riebesell" .

entity:person-Anand-deng2024 a schema:Person ;
    schema:name "Shashwat Anand" ;
    schema:givenName "Shashwat" ;
    schema:familyName "Anand" .

entity:person-Li-deng2024 a schema:Person ;
    schema:name "Zhuohan Li" ;
    schema:givenName "Zhuohan" ;
    schema:familyName "Li" .

entity:person-Jun-deng2024 a schema:Person ;
    schema:name "KyuJung Jun" ;
    schema:givenName "KyuJung" ;
    schema:familyName "Jun" .

entity:person-Persson-deng2024 a schema:Person ;
    schema:name "Kristin A. Persson" ;
    schema:givenName "Kristin A." ;
    schema:familyName "Persson" .

entity:person-Ceder-deng2024 a schema:Person ;
    schema:name "Gerbrand Ceder" ;
    schema:givenName "Gerbrand" ;
    schema:familyName "Ceder" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-surfaces-deng2024 a mlips:MaterialSystem ;
    rdfs:label "Surfaces (Miller index up to 2) of 29 elements and binary compounds (147 surfaces)" ;
    mlips:materialClass "Inorganic surfaces" .

entity:mat-mg-hosts-deng2024 a mlips:MaterialSystem ;
    rdfs:label "Host structures for Mg2+ ion migration (ApproxNEB data of Rutt et al.)" ;
    mlips:materialClass "Inorganic ionic conductors" .

entity:mat-Li2B3PO8-deng2024 a mlips:MaterialSystem ;
    rdfs:label "Li2B3PO8 (mp-1020015), high-energy MD states" ;
    mlips:chemicalFormula "Li2B3PO8" ;
    mlips:materialClass "Lithium borophosphate" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mp-dft-deng2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mp-dft-deng2024 mlips:hasDFTSettings entity:calc-settings-mp-dft-deng2024 .

entity:calc-settings-mp-dft-deng2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "pymatgen MPRelaxSet settings for compatibility with Materials Project; 1e-5 eV electronic and 0.02 eV/A ionic convergence (Methods D)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Li2B3PO8-deng2024 a mlips:TrainingDataset ;
    rdfs:label "Li2B3PO8 ab initio MD structures for fine-tuning (up to 10 training structures; 100 test structures)" ;
    mlips:coversMaterial entity:mat-Li2B3PO8-deng2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:hasDFTCalculation entity:calc-mp-dft-deng2024 ;
    rdfs:comment "Train/validation ratio 9:1; 100 structures reserved for testing (Methods C)." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasLossFunction entity:loss-CHGNet-deng2024 ;
    mlips:hasTrainingAlgorithm entity:alg-CHGNet-deng2024 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs .

entity:loss-CHGNet-deng2024 a mlips:LossFunction ;
    rdfs:label "MSE on energy, force and stress with 0.1-100-0.1 weights" .

entity:alg-CHGNet-deng2024 a mls:Algorithm ;
    rdfs:label "Adam, learning rate 1e-3 cosine-decayed to 1e-5 over 100 epochs" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-chgnet-linear-learningRate-deng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-chgnet-linear-numEpochs-deng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

entity:setting-chgnet-ft10-learningRate-deng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-chgnet-ft10-numEpochs-deng2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chgnet-linear-deng2024 a mlips:MLIPRun ;
    rdfs:label "CHGNet v0.3.0 with a scalar linear correction fitted to one high-energy Li2B3PO8 configuration" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-Li2B3PO8-deng2024 ;
    mlips:hasHyperparameterSetting entity:setting-chgnet-linear-learningRate-deng2024 ,
        entity:setting-chgnet-linear-numEpochs-deng2024 ;
    mlips:produces entity:model-chgnet-linear-deng2024 .

entity:model-chgnet-linear-deng2024 a mlips:TrainedModel ;
    rdfs:label "CHGNet with one-label linear correction (Li2B3PO8)" .

entity:run-chgnet-ft10-deng2024 a mlips:MLIPRun ;
    rdfs:label "CHGNet v0.3.0 fine-tuned (all parameters) on 10 Li2B3PO8 structures" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-Li2B3PO8-deng2024 ;
    mlips:hasHyperparameterSetting entity:setting-chgnet-ft10-learningRate-deng2024 ,
        entity:setting-chgnet-ft10-numEpochs-deng2024 ;
    mlips:produces entity:model-chgnet-ft10-deng2024 .

entity:model-chgnet-ft10-deng2024 a mlips:TrainedModel ;
    rdfs:label "CHGNet fine-tuned on 10 Li2B3PO8 structures" .

# entity:model-m3gnet-chen2022 (M3GNet-MPF-2021.2.8) is evaluated here; its run and model are declared in papers/chen2022.ttl.

# Registry stub for the externally trained model CHGNet-0.3.0 (not trained in this paper).
entity:run-CHGNet-0_3_0 a mlips:MLIPRun ;
    rdfs:label "Training run of CHGNet v0.3.0 pretrained universal MLIP (412.5K parameters, trained on MPtrj)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-CHGNet-0_3_0 .

entity:model-CHGNet-0_3_0 a mlips:TrainedModel ;
    rdfs:label "CHGNet v0.3.0 pretrained universal MLIP (412.5K parameters, trained on MPtrj)" .

# Registry stub for the externally trained model MACE-MP-0-2023.12.03 (not trained in this paper).
entity:run-MACE-MP-0-2023_12_03 a mlips:MLIPRun ;
    rdfs:label "Training run of MACE-MP-0 release 2023.12.03 (4.69M parameters, trained on MPtrj)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-MACE-MP-0-2023_12_03 .

entity:model-MACE-MP-0-2023_12_03 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0 release 2023.12.03 (4.69M parameters, trained on MPtrj)" .

