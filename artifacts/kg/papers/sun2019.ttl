# Canonical Turtle for the protocol-derived encoding of:
#   Geng Sun et al. (2019). Toward Fast and Reliable Potential Energy Surfaces for Metallic Pt Clusters by Hierarchical Delta Neural Networks.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.9b00465
#
# Version read: submittedVersion (sha256 451fefc58239477f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 495 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/sun2019.yaml.
#
# Encoding scope: aenet HDNNPs (46 symmetry functions, 46-(2x30)-1,
# 6.5 A cutoff) for Pt6-Pt20 clusters, trained directly on PBE(VASP-PW)
# energies or as Delta-HDNNPs on the difference to a cheap baseline
# (PBE single-zeta in GPAW or CP2K, or PBE plane waves for functional
# corrections); the RMSEs stated in the text. Delta-learning is a run
# setting. Chebyshev-descriptor variants, architecture scans and the
# Delta2 hierarchical scheme are figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-sun2019 a mlips:BenchmarkStudy ;
    rdfs:label "Sun and Sautet (2019): hierarchical delta neural network potentials (Delta-HDNNP) for Pt clusters, from single-zeta DFT baselines to plane-wave PBE, optPBE-vdW and TPSSh" ;
    mlips:reportedIn entity:article-sun2019 .

entity:article-sun2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.9b00465> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "Toward Fast and Reliable Potential Energy Surfaces for Metallic Pt Clusters by Hierarchical Delta Neural Networks" ;
    schema:author entity:person-Sun-sun2019 ,
        <https://orcid.org/0000-0002-8444-3348> .

entity:person-Sun-sun2019 a schema:Person ;
    schema:name "Geng Sun" ;
    schema:givenName "Geng" ;
    schema:familyName "Sun" .

<https://orcid.org/0000-0002-8444-3348> a schema:Person ;
    schema:name "Philippe Sautet" ;
    schema:givenName "Philippe" ;
    schema:familyName "Sautet" ;
    schema:identifier <https://orcid.org/0000-0002-8444-3348> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-pt-sun2019 a mlips:MaterialSystem ;
    rdfs:label "Compact Pt clusters with 6-20 atoms (Pt25 and Pt55 for transfer tests)" ;
    mlips:chemicalFormula "Pt" ;
    mlips:materialClass "Metal cluster" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbepw-sun2019 a mlips:DFTCalculation .

entity:calc-optpbe-sun2019 a mlips:DFTCalculation .

entity:calc-tpssh-sun2019 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbepw-sun2019 mlips:hasDFTSettings entity:calc-settings-pbepw-sun2019 .

entity:calc-settings-pbepw-sun2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "250"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "Non-spin-polarized PBE(VASP-PW)" .

entity:calc-optpbe-sun2019 mlips:hasDFTSettings entity:calc-settings-optpbe-sun2019 .

entity:calc-settings-optpbe-sun2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-optPBE-vdW-sun2019 ;
    rdfs:comment "optPBE-vdW(VASP-PW)" .

entity:calc-tpssh-sun2019 mlips:hasDFTSettings entity:calc-settings-tpssh-sun2019 .

entity:calc-settings-tpssh-sun2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-TPSSh-sun2019 ;
    rdfs:comment "TPSSh(VASP-PW)" .

entity:xc-optPBE-vdW-sun2019 a mlips:XCFunctional ;
    rdfs:label "optPBE-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-TPSSh-sun2019 a mlips:XCFunctional ;
    rdfs:label "TPSSh" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-pbe-sun2019 a mlips:TrainingDataset ;
    rdfs:label "PBE(VASP-PW) Pt-cluster database (6,402 structures; 90% train, 10% control)" ;
    mlips:coversMaterial entity:mat-pt-sun2019 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 6402 ;
    mlips:hasDFTCalculation entity:calc-pbepw-sun2019 .

entity:ds-optpbe-sun2019 a mlips:TrainingDataset ;
    rdfs:label "optPBE-vdW(VASP-PW) database (2,362 structures drawn from the PBE database)" ;
    mlips:coversMaterial entity:mat-pt-sun2019 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2362 ;
    mlips:hasDFTCalculation entity:calc-optpbe-sun2019 .

entity:ds-tpssh-sun2019 a mlips:TrainingDataset ;
    rdfs:label "TPSSh(VASP-PW) database (2,362 structures drawn from the PBE database)" ;
    mlips:coversMaterial entity:mat-pt-sun2019 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2362 ;
    mlips:hasDFTCalculation entity:calc-tpssh-sun2019 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-pbe-sun2019 mlips:samplingStrategy
    entity:sampling-rand-sun2019 .

entity:ds-optpbe-sun2019 mlips:samplingStrategy
    entity:sampling-rand-sun2019 .

entity:ds-tpssh-sun2019 mlips:samplingStrategy
    entity:sampling-rand-sun2019 .

entity:sampling-rand-sun2019 a mlips:SamplingStrategy ;
    rdfs:label "Random cluster geometries extended by local optimization or short MD; compact clusters kept" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-sun2019 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-sun2019 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-HDNNP-sun2019 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-sun2019 a mlips:LossFunction ;
    rdfs:label "Energies (aenet)" .

entity:alg-HDNNP-sun2019 a mls:Algorithm ;
    rdfs:label "Three independent trainings per case; early stopping or 5000th iteration" .

entity:impl-HDNNP-sun2019 a mlips:Implementation ;
    mlips:implementedIn entity:lib-aenet-sun2019 .

entity:lib-aenet-sun2019 a mlips:Library ;
    rdfs:label "aenet" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-direct-cutoffRadius-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-direct-numLayers-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-direct-numFeatures-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "46"^^xsd:integer .

entity:setting-d1-cutoffRadius-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

