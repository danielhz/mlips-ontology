    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-d1-numFeatures-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "46"^^xsd:integer .

entity:setting-d1-optpbe-cutoffRadius-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-d1-optpbe-numLayers-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-d1-optpbe-numFeatures-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "46"^^xsd:integer .

entity:setting-d1-tpssh-cutoffRadius-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-d1-tpssh-numLayers-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-d1-tpssh-numFeatures-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "46"^^xsd:integer .

entity:setting-d2-optpbe-cutoffRadius-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-d2-optpbe-numLayers-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-d2-optpbe-numFeatures-sun2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "46"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-direct-sun2019 a mlips:MLIPRun ;
    rdfs:label "Direct HDNNP 46-(2x30)-1 on PBE(VASP-PW)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-pbe-sun2019 ;
    mlips:hasHyperparameterSetting entity:setting-direct-cutoffRadius-sun2019 ,
        entity:setting-direct-numLayers-sun2019 ,
        entity:setting-direct-numFeatures-sun2019 ;
    mlips:produces entity:model-direct-sun2019 .

entity:model-direct-sun2019 a mlips:TrainedModel ;
    rdfs:label "HDNNP Pt clusters PBE(VASP-PW)" .

entity:run-d1-sun2019 a mlips:MLIPRun ;
    rdfs:label "Delta1-HDNNP 46-(2x30)-1: PBE(VASP-PW) minus PBE(GPAW-SZ)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-pbe-sun2019 ;
    mlips:hasHyperparameterSetting entity:setting-d1-cutoffRadius-sun2019 ,
        entity:setting-d1-numLayers-sun2019 ,
        entity:setting-d1-numFeatures-sun2019 ;
    mlips:produces entity:model-d1-sun2019 .

entity:model-d1-sun2019 a mlips:TrainedModel ;
    rdfs:label "Delta1-HDNNP Pt clusters (GPAW-SZ baseline)" .

entity:run-d1-optpbe-sun2019 a mlips:MLIPRun ;
    rdfs:label "Delta-HDNNP: optPBE-vdW(VASP-PW) minus PBE(CP2K-SZ)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-optpbe-sun2019 ;
    mlips:hasHyperparameterSetting entity:setting-d1-optpbe-cutoffRadius-sun2019 ,
        entity:setting-d1-optpbe-numLayers-sun2019 ,
        entity:setting-d1-optpbe-numFeatures-sun2019 ;
    mlips:produces entity:model-d1-optpbe-sun2019 .

entity:model-d1-optpbe-sun2019 a mlips:TrainedModel ;
    rdfs:label "Delta-HDNNP Pt optPBE-vdW (CP2K-SZ baseline)" .

entity:run-d1-tpssh-sun2019 a mlips:MLIPRun ;
    rdfs:label "Delta-HDNNP: TPSSh(VASP-PW) minus PBE(CP2K-SZ)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-tpssh-sun2019 ;
    mlips:hasHyperparameterSetting entity:setting-d1-tpssh-cutoffRadius-sun2019 ,
        entity:setting-d1-tpssh-numLayers-sun2019 ,
        entity:setting-d1-tpssh-numFeatures-sun2019 ;
    mlips:produces entity:model-d1-tpssh-sun2019 .

entity:model-d1-tpssh-sun2019 a mlips:TrainedModel ;
    rdfs:label "Delta-HDNNP Pt TPSSh (CP2K-SZ baseline)" .

entity:run-d2-optpbe-sun2019 a mlips:MLIPRun ;
    rdfs:label "Delta-HDNNP: optPBE-vdW(VASP-PW) minus PBE(VASP-PW), 10% training" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-optpbe-sun2019 ;
    mlips:hasHyperparameterSetting entity:setting-d2-optpbe-cutoffRadius-sun2019 ,
        entity:setting-d2-optpbe-numLayers-sun2019 ,
        entity:setting-d2-optpbe-numFeatures-sun2019 ;
    mlips:produces entity:model-d2-optpbe-sun2019 .

entity:model-d2-optpbe-sun2019 a mlips:TrainedModel ;
    rdfs:label "Delta-HDNNP Pt optPBE-vdW (PBE plane-wave baseline)" .

