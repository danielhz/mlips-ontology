# Canonical Turtle for the protocol-derived encoding of:
#   Behler, Parrinello. Generalized Neural-Network Representation of
#   High-Dimensional Potential-Energy Surfaces.
#   Phys. Rev. Lett. 98, 146401 (2007).
#   doi:10.1103/PhysRevLett.98.146401
#
# Encoding scope: the original Behler-Parrinello high-dimensional NN
# potential (HDNNP), demonstrated on bulk silicon.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-behler2007 a mlips:BenchmarkStudy ;
    rdfs:label "Behler & Parrinello (2007): high-dimensional NN potential for bulk silicon" ;
    mlips:reportedIn entity:article-behler2007 .

entity:article-behler2007 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/PhysRevLett.98.146401> ;
    schema:datePublished "2007"^^xsd:gYear ;
    schema:name "Generalized Neural-Network Representation of High-Dimensional Potential-Energy Surfaces" ;
    schema:author
        <https://orcid.org/0000-0002-1220-1542> ,
        <https://orcid.org/0000-0001-6550-3272> .

<https://orcid.org/0000-0002-1220-1542> a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" ;
    schema:identifier <https://orcid.org/0000-0002-1220-1542> .
<https://orcid.org/0000-0001-6550-3272> a schema:Person ;
    schema:name "Michele Parrinello" ;
    schema:givenName "Michele" ;
    schema:familyName "Parrinello" ;
    schema:identifier <https://orcid.org/0000-0001-6550-3272> .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Si-behler2007 a mlips:MaterialSystem ;
    rdfs:label "Bulk silicon (across solid and liquid phases)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental crystalline solid; covers diamond cubic, high-pressure phases (e.g. beta-tin), and the liquid metallic phase" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q670> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-behler2007 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-behler2007 mlips:hasDFTSettings entity:dft-settings-behler2007 .

entity:dft-settings-behler2007 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:LDA ;
    mlips:pseudopotentialType mlips:Ultrasoft ;
    rdfs:comment "Vanderbilt-style ultrasoft pseudopotential." ;
    mlips:energyCutoff "272"^^xsd:double ;
    mlips:kPointMesh "3x3x3 k-point mesh, Fermi smearing 0.1 eV" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Si-behler2007 a mlips:TrainingDataset ;
    rdfs:label "Bulk-Si HDNNP DFT-LDA dataset (~9000 total: 8200 train + 800 test)" ;
    mlips:coversMaterial entity:mat-Si-behler2007 ;
    mlips:coversProperty mlips:Energy , mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 9000 ;
    mlips:hasDFTCalculation entity:dft-behler2007 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Si-behler2007 mlips:samplingStrategy
    entity:crystal-sampling-behler2007 ,
    entity:md-sampling-behler2007 ,
    entity:self-consistent-sampling-behler2007 .

entity:crystal-sampling-behler2007 a mlips:SamplingStrategy ;
    rdfs:label "Crystal-structure enumeration" ;
    rdfs:comment "Initial training structures taken from known crystalline silicon structures including high-pressure phases." .

entity:md-sampling-behler2007 a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling (DFT MD)" ;
    rdfs:comment "MD snapshots at different pressures and temperatures used to populate the training set." .

entity:self-consistent-sampling-behler2007 a mlips:SamplingStrategy ;
    rdfs:label "Self-consistent iterative refinement" ;
    rdfs:comment "Best fits used to drive MD, hybrid Monte Carlo, and metadynamics; representative structures are recalculated with DFT and added to the training set if RMSE exceeds the fit error -- a precursor to active learning." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP-behler2007 a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasFunctionalForm entity:hdnnp-functional-form-behler2007 ;
    mlips:hasLossFunction entity:hdnnp-loss-behler2007 ;
    mlips:hasHyperparameter mlips:cutoffRadius , entity:hp-numhidden-behler2007 , entity:hp-numsf-behler2007 ;
    mlips:hasImplementation entity:impl-hdnnp-behler2007 .

entity:hdnnp-functional-form-behler2007 a mlips:FunctionalForm ;
    rdfs:label "Sum of per-atom subnet energies E = sum_i E_i with shared-weight feed-forward NN subnets and Behler-Parrinello atom-centred symmetry-function inputs (radial Gaussian and angular triplet sums)" .

entity:hdnnp-loss-behler2007 a mlips:LossFunction ;
    rdfs:label "Mean squared error on per-configuration total DFT energy" .

entity:impl-hdnnp-behler2007 a mlips:Implementation ;
    mlips:implementedIn entity:lib-hdnnp-behler2007 .

entity:lib-hdnnp-behler2007 a mlips:Library ;
    rdfs:label "In-house extension of the Lorenz-Gross-Scheffler neural-network code" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-behler2007 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-numsf-behler2007 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-numsf-behler2007 ;
    mlips:settingValue "48"^^xsd:integer .

entity:setting-numhidden-behler2007 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-numhidden-behler2007 ;
    mlips:settingValue "2 hidden layers, ~40 nodes each" .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-hdnnp-Si-behler2007 a mlips:MLIPRun ;
    rdfs:label "HDNNP training run, bulk silicon" ;
    mlips:appliesMethod entity:HDNNP-behler2007 ;
    mlips:runsOn entity:ds-Si-behler2007 ;
    mlips:hasHyperparameterSetting entity:setting-rcut-behler2007 , entity:setting-numsf-behler2007 , entity:setting-numhidden-behler2007 ;
    mlips:produces entity:model-hdnnp-Si-behler2007 .

entity:model-hdnnp-Si-behler2007 a mlips:TrainedModel ;
    rdfs:label "Behler-Parrinello HDNNP for bulk silicon" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-behler2007 mlips:hasResult
    entity:result-hdnnp-Si-energy-behler2007 ,
    entity:result-hdnnp-Si-forces-behler2007 .

entity:result-hdnnp-Si-energy-behler2007 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-hdnnp-Si-behler2007 ;
    mlips:targetMaterial entity:mat-Si-behler2007 ;
    mlips:hasAccuracyMetric entity:metric-rmse-energy-behler2007 .

entity:metric-rmse-energy-behler2007 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE on the held-out test set (vs. DFT-LDA)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "5.5"^^xsd:double ;
    mlips:hasUnit unit:MeV-PER-ATOM .

entity:result-hdnnp-Si-forces-behler2007 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-hdnnp-Si-behler2007 ;
    mlips:targetMaterial entity:mat-Si-behler2007 ;
    mlips:hasAccuracyMetric entity:metric-rmse-forces-behler2007 .

entity:metric-rmse-forces-behler2007 a mlips:AccuracyMetric ;
    rdfs:label "Atomic-force RMSE (vs. DFT-LDA)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.2"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Behler & Parrinello (2007) reports no explicit training-cost metadata
# (no GPU hours, training duration, hardware spec, peak memory). They
# do quote a relative inference speed of ~5 orders of magnitude faster
# than DFT for a 64-atom cell -- a relative figure rather than an
# inferenceTimePerAtom value, so it is not encoded.

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-numhidden-behler2007 a mlips:Hyperparameter ;
    rdfs:label "HDNNP per-element hidden-unit count" ;
    mlips:hyperparameterName "num_hidden" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-numsf-behler2007 a mlips:Hyperparameter ;
    rdfs:label "HDNNP per-element symmetry-function count" ;
    mlips:hyperparameterName "num_symmetry_functions" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

# schema:affiliation links added by issue-0005 sweep.
<https://orcid.org/0000-0002-1220-1542> schema:affiliation entity:org-ETHZurich-behler2007 .
<https://orcid.org/0000-0001-6550-3272> schema:affiliation entity:org-ETHZurich-behler2007 .

entity:org-ETHZurich-behler2007 a schema:Organization ;
    rdfs:label "ETH Zurich" ;
    schema:name "ETH Zurich" ;
    schema:identifier <https://ror.org/05a28rw58> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .
