###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-solid-busk2026 a mlips:MaterialSystem ;
    rdfs:label "Solid-liquid interfaces (aqueous coinage-metal and electrode-electrolyte systems) and bulk references; H, Li, C, N, O, F, Na, Al, Cl, K, Ca, Cu, Cs, Pt, Au" ;
    mlips:materialClass "Solid-liquid interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbed3-busk2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbed3-busk2026 mlips:hasDFTSettings entity:calc-settings-pbed3-busk2026 .

entity:calc-settings-pbed3-busk2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "D3 dispersion correction; plane-wave cutoffs of 350, 400 or 450 eV kept, others excluded" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-solid-train-busk2026 a mlips:TrainingDataset ;
    rdfs:label "SoLiD26 training split (15,006,934 structures of at most 200 atoms)" ;
    mlips:coversMaterial entity:mat-solid-busk2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 15006934 ;
    mlips:hasDFTCalculation entity:calc-pbed3-busk2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-solid-train-busk2026 mlips:samplingStrategy
    entity:sampling-aimd-busk2026 .

entity:sampling-aimd-busk2026 a mlips:SamplingStrategy ;
    rdfs:label "Consolidated DTU Energy calculations, mostly AIMD, filtered (max force 10 eV/A, duplicates, rare elements, PaiNN 5-fold outliers)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-busk2026 ;
    mlips:hasHyperparameter mlips:learningRate ;
    mlips:hasImplementation entity:impl-MACE-busk2026 .

entity:loss-MACE-busk2026 a mlips:LossFunction ;
    rdfs:label "Two stages: energy/force weights 1:10, then 10:1" .

entity:impl-MACE-busk2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ft-learningRate-busk2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0005"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mpes-busk2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MATPES-PBE-0 with D3 dispersion (as distributed)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mpes-busk2026 .

entity:model-mpes-busk2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MATPES-PBE-0" .

entity:run-ft-busk2026 a mlips:MLIPRun ;
    rdfs:label "MACE-SoLiD26-ft (MACE-MATPES-PBE-0 naively fine-tuned on SoLiD26)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-solid-train-busk2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-learningRate-busk2026 ;
    mlips:produces entity:model-ft-busk2026 .

entity:model-ft-busk2026 a mlips:TrainedModel ;
    rdfs:label "MACE-SoLiD26-ft" .

entity:run-scratch-busk2026 a mlips:MLIPRun ;
    rdfs:label "MACE-SoLiD26 (trained from scratch, hyperparameters similar to MACE-MATPES-PBE-0)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-solid-train-busk2026 ;
    mlips:produces entity:model-scratch-busk2026 .

entity:model-scratch-busk2026 a mlips:TrainedModel ;
    rdfs:label "MACE-SoLiD26" .

