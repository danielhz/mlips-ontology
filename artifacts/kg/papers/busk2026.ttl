# Canonical Turtle for the protocol-derived encoding of:
#   Jonas Busk et al. (2026). SoLiD26: A First Principles Solid-Liquid Interface Dataset for Machine-learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2609.28013  arXiv:2609.28013v2
#
# Version read: arxiv-preprint arXiv:2609.28013v2 (sha256 fa2c5e46f08ecacb...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 484 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/busk2026.yaml.
#
# Encoding scope: the SoLiD26 dataset (15,379,823 VASP PBE-D3
# structures, up to 576 atoms, 15 elements; mostly AIMD of aqueous metal
# and electrode-electrolyte interfaces) and its technical validation:
# MACE-MATPES-PBE-0 with D3 as distributed, the same model naively
# fine-tuned on SoLiD26, and a MACE trained from scratch, evaluated on
# the test split of all structures with more than 200 atoms (Table 1).
# The PaiNN models used for outlier filtering are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-busk2026 a mlips:BenchmarkStudy ;
    rdfs:label "Busk et al. (2026): SoLiD26, a 15.4-million-structure PBE-D3 dataset of solid-liquid interfaces, validated with pretrained, fine-tuned and from-scratch MACE models" ;
    mlips:reportedIn entity:article-busk2026 .

entity:article-busk2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2609.28013> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "SoLiD26: A First Principles Solid-Liquid Interface Dataset for Machine-learned Interatomic Potentials" ;
    schema:author entity:person-Busk-busk2026 ,
        entity:person-Frost-busk2026 ,
