    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-water-I-zhang2021 a mlips:DFTCalculation .

entity:calc-water-II-zhang2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-water-I-zhang2021 mlips:hasDFTSettings entity:calc-settings-water-I-zhang2021 .

entity:calc-settings-water-I-zhang2021 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-revPBE0-D3-zhang2021 ;
