# Q7 -- MLIP method, components, implementation
###############################################################################

entity:REANN a mlips:MLIPMethod ;
    rdfs:label "REANN (recursively embedded atom neural network)" ;
    mlips:hasLossFunction entity:loss-REANN-zhang2021 ;
    mlips:hasTrainingAlgorithm entity:alg-REANN-zhang2021 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-REANN-zhang2021 .

entity:loss-REANN-zhang2021 a mlips:LossFunction ;
    rdfs:label "Energies and forces with a dynamic force weight decreasing from 5 to 1" .

entity:alg-REANN-zhang2021 a mls:Algorithm ;
    rdfs:label "AdamW with ReduceLROnPlateau from 1e-3 to 1e-5 (factor 0.6)" .

entity:impl-REANN-zhang2021 a mlips:Implementation ;
    mlips:implementedIn entity:lib-REANN-zhang2021 .

entity:lib-REANN-zhang2021 a mlips:Library ;
    rdfs:label "REANN" ;
    rdfs:comment "PyTorch package; descriptor parameters (alpha, rs, orbital coefficients) optimised with the network weights" ;
    mlips:candidateForVocabulary mlips:Library .

