# Canonical Turtle for the protocol-derived encoding of:
#   Rami Gherib et al. (2024). Thawed Gaussian Wavepacket Dynamics with Δ-Machine-Learned Potentials.
#   The Journal of Physical Chemistry A. doi:10.1021/acs.jpca.4c02979  arXiv:2405.00193v1
#
# Version read: arxiv-preprint arXiv:2405.00193v1 (sha256 e4758be2a81a1bc7...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 610 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/gherib2024.yaml.
#
# Encoding scope: the study record and the NH3+ B3LYP training data. The
# paper fits a kernel-ridge-regression (KRR) anharmonic correction to a
# global harmonic potential (Delta-KRR) and a direct KRR potential for
# the NH3+ cation and uses them for Gaussian-wavepacket photoelectron
# spectra. Kernel ridge regression on normal-mode coordinates has no
# registry method, so no run or result is encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gherib2024 a mlips:BenchmarkStudy ;
    rdfs:label "Gherib, Ryabinkin and Genin (2024): thawed Gaussian wavepacket dynamics with Delta-machine-learned potentials" ;
    mlips:reportedIn entity:article-gherib2024 .

entity:article-gherib2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpca.4c02979> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Thawed Gaussian Wavepacket Dynamics with Δ-Machine-Learned Potentials" ;
    schema:author entity:person-Gherib-gherib2024 ,
        <https://orcid.org/0000-0002-7679-632X> ,
        entity:person-Genin-gherib2024 .

entity:person-Gherib-gherib2024 a schema:Person ;
    schema:name "Rami Gherib" ;
    schema:givenName "Rami" ;
    schema:familyName "Gherib" .

<https://orcid.org/0000-0002-7679-632X> a schema:Person ;
    schema:name "Ilya G. Ryabinkin" ;
    schema:givenName "Ilya G." ;
    schema:familyName "Ryabinkin" ;
    schema:identifier <https://orcid.org/0000-0002-7679-632X> .

entity:person-Genin-gherib2024 a schema:Person ;
    schema:name "Scott N. Genin" ;
    schema:givenName "Scott N." ;
    schema:familyName "Genin" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-nh3p-gherib2024 a mlips:MaterialSystem ;
    rdfs:label "Ammonia cation NH3+ (final state of NH3 photoionisation)" ;
    mlips:chemicalFormula "NH3+" ;
    mlips:materialClass "small molecule (cation)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-b3lyp-gherib2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-b3lyp-gherib2024 mlips:hasDFTSettings entity:calc-settings-b3lyp-gherib2024 .

entity:calc-settings-b3lyp-gherib2024 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Firefly-gherib2024 ;
    mlips:xcFunctional entity:xc-B3LYP-gherib2024 ;
    mlips:basisSet "6-311G(d)" ;
    rdfs:comment "Restricted open-shell formalism for NH3+; numerical Hessians from analytic gradients." .

entity:lib-Firefly-gherib2024 a mlips:Library ;
    rdfs:label "Firefly" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-B3LYP-gherib2024 a mlips:XCFunctional ;
    rdfs:label "B3LYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-nh3p-gherib2024 a mlips:TrainingDataset ;
    rdfs:label "NH3+ single-point energies (2224 geometries; 10-fold CV with 2025 train / 199 validation)" ;
    mlips:coversMaterial entity:mat-nh3p-gherib2024 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2224 ;
    mlips:hasDFTCalculation entity:calc-b3lyp-gherib2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-nh3p-gherib2024 mlips:samplingStrategy
    entity:sampling-cvm-scan-gherib2024 .

entity:sampling-cvm-scan-gherib2024 a mlips:SamplingStrategy ;
    rdfs:label "1D scans along Cartesian vibrational modes (rigid-rotor dynamics) plus 2000 geometries displaced along scaled modes by Latin hypercube sampling (atom distances 0.5-2.0 A)" .

