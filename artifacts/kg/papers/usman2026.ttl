# Canonical Turtle for the protocol-derived encoding of:
#   M. Usman et al. (2026). Benchmarking Machine-Learning Interatomic Potentials for Dynamical Stability in Inorganic Semiconductor Nanocrystals: A CdSe Case Study.
#   arXiv (Cornell University). doi:10.48550/arxiv.2609.15299  arXiv:2609.15299v1
#
# Version read: arxiv-preprint arXiv:2609.15299v1 (sha256 33349db435dee377...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 249 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/usman2026.yaml.
#
# Encoding scope: SchNet, PaiNN, NequIP, Allegro and MACE trained on the
# same 1,000 DFT configurations of a chloride-passivated Cd68Se55Cl26
# nanocluster for twelve combinations of hidden dimension and number of
# layers, with their validation force MAEs and training times (Table 1),
# and the MD time per step of each architecture (Table 2). The
# active-learning refinement of MACE (34 added configurations) and the
# stability classifications are not encoded as results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-usman2026 a mlips:BenchmarkStudy ;
    rdfs:label "Usman et al. (2026): benchmarking five GNN potentials for dynamical stability of a CdSe nanocrystal" ;
    mlips:reportedIn entity:article-usman2026 .

entity:article-usman2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2609.15299> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Benchmarking Machine-Learning Interatomic Potentials for Dynamical Stability in Inorganic Semiconductor Nanocrystals: A CdSe Case Study" ;
    schema:author entity:person-Usman-usman2026 ,
        entity:person-Suleymanova-usman2026 ,
        entity:person-Abideen-usman2026 ,
        entity:person-FernandezPendas-usman2026 ,
        entity:person-Infante-usman2026 .

entity:person-Usman-usman2026 a schema:Person ;
    schema:name "M. Usman" ;
    schema:givenName "M." ;
    schema:familyName "Usman" .

entity:person-Suleymanova-usman2026 a schema:Person ;
    schema:name "M. Suleymanova" ;
    schema:givenName "M." ;
    schema:familyName "Suleymanova" .

entity:person-Abideen-usman2026 a schema:Person ;
    schema:name "Z. U. Abideen" ;
    schema:givenName "Z. U." ;
    schema:familyName "Abideen" .

entity:person-FernandezPendas-usman2026 a schema:Person ;
    schema:name "M. Fernández-Pendás" ;
    schema:givenName "M." ;
    schema:familyName "Fernández-Pendás" .

entity:person-Infante-usman2026 a schema:Person ;
    schema:name "I. Infante" ;
    schema:givenName "I." ;
    schema:familyName "Infante" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cdse-usman2026 a mlips:MaterialSystem ;
    rdfs:label "Chloride-passivated CdSe quantum dot Cd68Se55Cl26 (149 atoms, about 2 nm)" ;
    mlips:chemicalFormula "Cd68Se55Cl26" ;
    mlips:materialClass "Semiconductor nanocrystal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-hle17-usman2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-hle17-usman2026 mlips:hasDFTSettings entity:calc-settings-hle17-usman2026 .

entity:calc-settings-hle17-usman2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-2024_1-usman2026 ;
    mlips:xcFunctional entity:xc-HLE17-usman2026 ;
    mlips:basisSet "DZVP-MOLOPT" ;
    rdfs:comment "GPW with GTH pseudopotentials, 400 Ry density cutoff, non-periodic 32 A cell with a multipole Poisson solver." .

entity:lib-CP2K-2024_1-usman2026 a mlips:Library ;
    rdfs:label "CP2K 2024.1" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-HLE17-usman2026 a mlips:XCFunctional ;
    rdfs:label "HLE17" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cdse-usman2026 a mlips:TrainingDataset ;
    rdfs:label "Cd68Se55Cl26 training set (1,000 of 3,000 AIMD frames)" ;
    mlips:coversMaterial entity:mat-cdse-usman2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1000 ;
    mlips:hasDFTCalculation entity:calc-hle17-usman2026 ;
    rdfs:comment "The other 2,000 frames are held out for validation." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cdse-usman2026 mlips:samplingStrategy
    entity:sampling-aimd-cluster-usman2026 .

entity:sampling-aimd-cluster-usman2026 a mlips:SamplingStrategy ;
    rdfs:label "Born-Oppenheimer AIMD at 300 K (CSVR thermostat, 2.5 fs), 3,000 frames; isolation-forest screening and PCA/k-means selection of 1,000 training frames" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:hasLossFunction entity:loss-SchNet-usman2026 ;
    mlips:hasTrainingAlgorithm entity:alg-SchNet-usman2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-SchNet-usman2026 a mlips:LossFunction ;
    rdfs:label "Force-dominated energy and force loss (0.95:0.05)" .

entity:alg-SchNet-usman2026 a mls:Algorithm ;
    rdfs:label "AdamW" .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:hasLossFunction entity:loss-PaiNN-usman2026 ;
    mlips:hasTrainingAlgorithm entity:alg-PaiNN-usman2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-PaiNN-usman2026 a mlips:LossFunction ;
    rdfs:label "Force-dominated energy and force loss (0.95:0.05)" .

entity:alg-PaiNN-usman2026 a mls:Algorithm ;
    rdfs:label "AdamW" .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-usman2026 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-usman2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-usman2026 a mlips:LossFunction ;
    rdfs:label "Force-dominated energy and force loss (0.95:0.05)" .

entity:alg-NequIP-usman2026 a mls:Algorithm ;
    rdfs:label "Adam" .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-usman2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-usman2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-Allegro-usman2026 a mlips:LossFunction ;
    rdfs:label "Force-dominated energy and force loss (0.95:0.05)" .

entity:alg-Allegro-usman2026 a mls:Algorithm ;
    rdfs:label "Adam" .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-usman2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-usman2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
