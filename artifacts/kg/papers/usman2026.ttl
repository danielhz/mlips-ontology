        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-usman2026 a mlips:LossFunction ;
    rdfs:label "Force-dominated energy and force loss (0.95:0.05)" .

entity:alg-MACE-usman2026 a mls:Algorithm ;
    rdfs:label "Adam" .

