###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cumo2-yu2024 a mlips:MaterialSystem ;
    rdfs:label "CuMO2 spin lattice (96 magnetic sites, fixed CuAlO2-type structure)" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-abo3-yu2024 a mlips:MaterialSystem ;
    rdfs:label "50-atom ABO3 perovskite spin-lattice model with magnetic B sites" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-bfo-yu2024 a mlips:MaterialSystem ;
    rdfs:label "Multiferroic BiFeO3 (R3c, R3m, Pnma, Pm-3m supercells with random spins)" ;
    mlips:chemicalFormula "BiFeO3" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pasp-yu2024 a mlips:ReferenceCalculation .

entity:calc-pbeu-yu2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pasp-yu2024 mlips:hasReferenceSettings entity:calc-settings-pasp-yu2024 .

entity:calc-settings-pasp-yu2024 a mlips:ReferenceSettings ;
    rdfs:comment "Effective spin and spin-lattice Hamiltonians (Eqs. 10-12) evaluated with PASP; coefficients set to 0.1 eV (spin terms) and 1 eV (position terms)." .

entity:calc-pbeu-yu2024 mlips:hasDFTSettings entity:calc-settings-pbeu-yu2024 .

entity:calc-settings-pbeu-yu2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "2x4x4" ;
    rdfs:comment "PBE+U, U = 3.8 eV on Fe 3d, collinear spins without SOC, EDIFF 1e-6 eV per supercell (Methods)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-spinh-yu2024 a mlips:TrainingDataset ;
    rdfs:label "CuMO2 spin-Hamiltonian data (random spin configurations, 80/10/10)" ;
    mlips:coversMaterial entity:mat-cumo2-yu2024 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10000 ;
    mlips:hasReferenceCalculation entity:calc-pasp-yu2024 .

entity:ds-heis-yu2024 a mlips:TrainingDataset ;
    rdfs:label "Heisenberg-type spin-lattice model data (distorted ABO3, random spins, 80/10/10)" ;
    mlips:coversMaterial entity:mat-abo3-yu2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2416 ;
    mlips:hasReferenceCalculation entity:calc-pasp-yu2024 .

entity:ds-high-yu2024 a mlips:TrainingDataset ;
    rdfs:label "Fourth-order spin-lattice model data (distorted ABO3, random spins, 80/10/10)" ;
    mlips:coversMaterial entity:mat-abo3-yu2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 3611 ;
    mlips:hasReferenceCalculation entity:calc-pasp-yu2024 .

entity:ds-bfo-yu2024 a mlips:TrainingDataset ;
    rdfs:label "BiFeO3 DFT+U data (4,200 training / 357 validation / 300 test)" ;
    mlips:coversMaterial entity:mat-bfo-yu2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4857 ;
    mlips:hasDFTCalculation entity:calc-pbeu-yu2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Spin-DimeNet a mlips:MLIPMethod ;
    rdfs:label "Spin-DimeNet++ (SpinGNN: DimeNet++ with Heisenberg-edge (HEGNN) and spin-distance-edge (SEGNN) spin message passing)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:batchSize .

entity:Spin-Allegro a mlips:MLIPMethod ;
    rdfs:label "Spin-Allegro (SpinGNN: Allegro with Heisenberg-edge (HEGNN) and spin-distance-edge (SEGNN) layers for spin-lattice potentials)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:learningRate ,
        mlips:batchSize .

