# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-sd-spinh-yu2024 a mlips:MLIPRun ;
    rdfs:label "Spin-DimeNet++ (HEGNN + SEGNN) on the CuMO2 spin Hamiltonian" ;
    mlips:appliesMethod entity:Spin-DimeNet ;
    mlips:runsOn entity:ds-spinh-yu2024 ;
    mlips:hasHyperparameterSetting entity:setting-sd-spinh-numLayers-yu2024 ,
        entity:setting-sd-spinh-cutoffRadius-yu2024 ,
        entity:setting-sd-spinh-learningRate-yu2024 ,
        entity:setting-sd-spinh-batchSize-yu2024 ;
    mlips:produces entity:model-sd-spinh-yu2024 .

entity:model-sd-spinh-yu2024 a mlips:TrainedModel ;
    rdfs:label "Spin-DimeNet++ CuMO2" .

entity:run-hegnn-heis-yu2024 a mlips:MLIPRun ;
    rdfs:label "HEGNN-DimeNet++ on the Heisenberg-type spin-lattice model" ;
    mlips:appliesMethod entity:Spin-DimeNet ;
    mlips:runsOn entity:ds-heis-yu2024 ;
    mlips:hasHyperparameterSetting entity:setting-hegnn-heis-numLayers-yu2024 ,
        entity:setting-hegnn-heis-cutoffRadius-yu2024 ,
        entity:setting-hegnn-heis-learningRate-yu2024 ,
