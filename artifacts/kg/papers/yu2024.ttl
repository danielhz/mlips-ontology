    mlips:produces entity:model-hegnn-heis-yu2024 .

entity:model-hegnn-heis-yu2024 a mlips:TrainedModel ;
    rdfs:label "HEGNN-DimeNet++ Heisenberg model" .

entity:run-ens-heis-yu2024 a mlips:MLIPRun ;
    rdfs:label "HEGNN-DimeNet++ and SEGNN-DimeNet++ together on the Heisenberg-type model" ;
    mlips:appliesMethod entity:Spin-DimeNet ;
    mlips:runsOn entity:ds-heis-yu2024 ;
    mlips:hasHyperparameterSetting entity:setting-ens-heis-numLayers-yu2024 ,
