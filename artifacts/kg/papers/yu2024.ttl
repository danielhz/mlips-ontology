        entity:setting-hegnn-high-learningRate-yu2024 ,
        entity:setting-hegnn-high-batchSize-yu2024 ;
    mlips:produces entity:model-hegnn-high-yu2024 .

entity:model-hegnn-high-yu2024 a mlips:TrainedModel ;
    rdfs:label "HEGNN-DimeNet++ fourth-order model" .

entity:run-segnn-high-yu2024 a mlips:MLIPRun ;
    rdfs:label "SEGNN-DimeNet++ on the fourth-order spin-lattice model" ;
    mlips:appliesMethod entity:Spin-DimeNet ;
    mlips:runsOn entity:ds-high-yu2024 ;
    mlips:hasHyperparameterSetting entity:setting-segnn-high-numLayers-yu2024 ,
