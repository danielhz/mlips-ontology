        entity:setting-ens-heis-learningRate-yu2024 ,
        entity:setting-ens-heis-batchSize-yu2024 ;
    mlips:produces entity:model-ens-heis-yu2024 .

entity:model-ens-heis-yu2024 a mlips:TrainedModel ;
    rdfs:label "HEGNN+SEGNN-DimeNet++ Heisenberg model" .

entity:run-hegnn-high-yu2024 a mlips:MLIPRun ;
    rdfs:label "HEGNN-DimeNet++ on the fourth-order spin-lattice model" ;
    mlips:appliesMethod entity:Spin-DimeNet ;
    mlips:runsOn entity:ds-high-yu2024 ;
    mlips:hasHyperparameterSetting entity:setting-hegnn-high-numLayers-yu2024 ,
