@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ito2024 a mlips:BenchmarkStudy ;
    rdfs:label "Ito et al. (2024): MTP with DFT accuracy for general grain boundaries in alpha-Fe" ;
    mlips:reportedIn entity:article-ito2024 .

entity:article-ito2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-024-01451-y> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Machine learning interatomic potential with DFT accuracy for general grain boundaries in α-Fe" ;
    schema:author <https://orcid.org/0000-0002-3456-1055> ,
        <https://orcid.org/0000-0002-5178-3952> ,
        entity:person-Hyodo-ito2024 ,
        <https://orcid.org/0000-0001-5608-4053> .

