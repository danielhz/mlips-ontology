###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Fe-ito2024 a mlips:MaterialSystem ;
    rdfs:label "alpha-iron (ferromagnetic bcc Fe; bulk, point defects, mechanically generated structures)" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "Elemental metal" .

entity:mat-GGB-ito2024 a mlips:MaterialSystem ;
    rdfs:label "General grain boundaries in alpha-Fe nano-polycrystals (cut-out cells)" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "Grain boundaries" .

entity:mat-TJ-ito2024 a mlips:MaterialSystem ;
    rdfs:label "Grain-boundary triple junctions in alpha-Fe nano-polycrystals (cut-out cells)" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "Grain boundaries" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-ito2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-ito2024 mlips:hasDFTSettings entity:calc-settings-dft-ito2024 .

entity:calc-settings-dft-ito2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack mesh equivalent to 18x18x18 for the alpha-Fe conventional cell" ;
    rdfs:comment "Spin-polarised; 4s and 3d electrons as valence; Methfessel-Paxton smearing of 0.1 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Fe-ito2024 a mlips:TrainingDataset ;
    rdfs:label "alpha-Fe training set (19,950 structures, 267,188 atomic environments: DE 2,490 and RANDSPG 17,460 structures)" ;
    mlips:coversMaterial entity:mat-Fe-ito2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 19950 ;
    mlips:hasDFTCalculation entity:calc-dft-ito2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Fe-ito2024 mlips:samplingStrategy
    entity:sampling-de-ito2024 ,
    entity:sampling-randspg-ito2024 .

entity:sampling-de-ito2024 a mlips:SamplingStrategy ;
    rdfs:label "Domain-expertise (DE) set built by hand: perfect crystal, vacancy and self-interstitial structures, including ab initio MD (NVT and NPT, 2 fs step)" .

entity:sampling-randspg-ito2024 a mlips:SamplingStrategy ;
    rdfs:label "RANDSPG structures: 2482 basic structures of at most 10 atoms over all space groups, relaxed stepwise (VOLMIN, CELLMIN, INTMIN) and perturbed (TRIAX, SHEAR, RATTLE); only ferromagnetic structures with moments above 1.5 Bohr magnetons kept" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:momentLevel ,
        mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-MTP-ito2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:impl-MTP-ito2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP ;
    mlips:version "MLIP-3" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-Fe-momentLevel-ito2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "22"^^xsd:integer .

entity:setting-Fe-cutoffRadius-ito2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-Fe-ito2024 a mlips:MLIPRun ;
    rdfs:label "MTP training for alpha-Fe (level 22)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-Fe-ito2024 ;
    mlips:hasHyperparameterSetting entity:setting-Fe-momentLevel-ito2024 ,
        entity:setting-Fe-cutoffRadius-ito2024 ;
    mlips:produces entity:model-Fe-ito2024 .

entity:model-Fe-ito2024 a mlips:TrainedModel ;
    rdfs:label "MTP for alpha-Fe (level 22)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-ito2024 mlips:hasResult
    entity:result-train-ito2024 ,
    entity:result-validation-ito2024 ,
    entity:result-ggb-300K-ito2024 ,
    entity:result-tj-300K-ito2024 ,
    entity:result-ggb-relaxed-ito2024 ,
    entity:result-tj-relaxed-ito2024 .

entity:result-train-ito2024 a mlips:BenchmarkResult ;
    rdfs:comment "Per part (Table 1): DE 2.03 meV/atom and 63.60 meV/A; RANDSPG 15.14 meV/atom and 81.94 meV/A." ;
    mlips:evaluatesModel entity:model-Fe-ito2024 ;
    mlips:targetMaterial entity:mat-Fe-ito2024 ;
