# Canonical Turtle for the protocol-derived encoding of:
#   Kyeongpung Lee et al. (2022). $\textit{Ab initio}$ construction of full phase diagram of MgO-CaO eutectic system using neural network interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2208.11863  arXiv:2208.11863v1
#
# Version read: arxiv-preprint arXiv:2208.11863v1 (sha256 5cf0bb984067cd6a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 558 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/lee2022.yaml.
#
# Encoding scope: two SIMPLE-NN Behler-Parrinello NNPs (PBE-NNP and
# SCAN-NNP) for MgO-CaO trained on 5,670 structures (strained crystals,
# random rocksalt alloys and their heating/melting MD), with training and
# validation RMSEs (Table I). Elastic, defect, melting and phase-diagram
# results are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-lee2022 a mlips:BenchmarkStudy ;
    rdfs:label "Lee, Park and Han (2022): ab initio MgO-CaO eutectic phase diagram from PBE and SCAN neural network potentials with free-energy and semigrand simulations" ;
    mlips:reportedIn entity:article-lee2022 .

entity:article-lee2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2208.11863> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "$\\textit{Ab initio}$ construction of full phase diagram of MgO-CaO eutectic system using neural network interatomic potentials" ;
    schema:author entity:person-Lee-lee2022 ,
        entity:person-Park-lee2022 ,
        entity:person-Han-lee2022 .

entity:person-Lee-lee2022 a schema:Person ;
    schema:name "Kyeongpung Lee" ;
    schema:givenName "Kyeongpung" ;
    schema:familyName "Lee" .

entity:person-Park-lee2022 a schema:Person ;
    schema:name "Yutack Park" ;
    schema:givenName "Yutack" ;
    schema:familyName "Park" .

entity:person-Han-lee2022 a schema:Person ;
    schema:name "Seungwu Han" ;
    schema:givenName "Seungwu" ;
    schema:familyName "Han" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mgocao-lee2022 a mlips:MaterialSystem ;
    rdfs:label "MgO-CaO rocksalt crystals, random alloys Mg_xCa_(1-x)O and melts" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-lee2022 a mlips:DFTCalculation .

entity:calc-scan-lee2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-lee2022 mlips:hasDFTSettings entity:calc-settings-pbe-lee2022 .

entity:calc-settings-pbe-lee2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "3x3x3 for the conventional cell, scaled for supercells" .

entity:calc-scan-lee2022 mlips:hasDFTSettings entity:calc-settings-scan-lee2022 .

entity:calc-settings-scan-lee2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:SCAN ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "3x3x3 for the conventional cell, scaled for supercells" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-pbe-lee2022 a mlips:TrainingDataset ;
    rdfs:label "PBE MgO-CaO data set (5,670 structures, 552,096 atoms; 10% validation)" ;
    mlips:coversMaterial entity:mat-mgocao-lee2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 5670 ;
    mlips:hasDFTCalculation entity:calc-pbe-lee2022 .

entity:ds-scan-lee2022 a mlips:TrainingDataset ;
    rdfs:label "SCAN MgO-CaO data set (5,670 structures, 552,096 atoms; 10% validation)" ;
    mlips:coversMaterial entity:mat-mgocao-lee2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 5670 ;
    mlips:hasDFTCalculation entity:calc-scan-lee2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-pbe-lee2022 mlips:samplingStrategy
    entity:sampling-md-lee2022 .

entity:ds-scan-lee2022 mlips:samplingStrategy
    entity:sampling-md-lee2022 .

entity:sampling-md-lee2022 a mlips:SamplingStrategy ;
    rdfs:label "Strained pure crystals, 100-atom random alloys (x = 0.08, 0.2, 0.8, 0.92), NPT and NVT heating MD of solids and melts (300-8000 K), sampled every 40 or 10 fs and relabelled" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-lee2022 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-lee2022 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-HDNNP-lee2022 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:ThermodynamicIntegration .

entity:loss-HDNNP-lee2022 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses" .

entity:alg-HDNNP-lee2022 a mls:Algorithm ;
    rdfs:label "PCA whitening of 24 radial and 108 angular ACSFs; learning rate decaying exponentially from 0.01 to 0.0005" .

entity:impl-HDNNP-lee2022 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SIMPLE-NN-lee2022 .

entity:lib-SIMPLE-NN-lee2022 a mlips:Library ;
    rdfs:label "SIMPLE-NN" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-pbe-nnp-cutoffRadius-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:double .

entity:setting-pbe-nnp-angularCutoff-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-pbe-nnp-numLayers-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-pbe-nnp-learningRate-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-pbe-nnp-numEpochs-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "190"^^xsd:integer .

entity:setting-scan-nnp-cutoffRadius-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:double .

entity:setting-scan-nnp-angularCutoff-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-scan-nnp-numLayers-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-scan-nnp-learningRate-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-scan-nnp-numEpochs-lee2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "190"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-pbe-nnp-lee2022 a mlips:MLIPRun ;
    rdfs:label "PBE-NNP for MgO-CaO" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-pbe-lee2022 ;
    mlips:hasHyperparameterSetting entity:setting-pbe-nnp-cutoffRadius-lee2022 ,
        entity:setting-pbe-nnp-angularCutoff-lee2022 ,
        entity:setting-pbe-nnp-numLayers-lee2022 ,
        entity:setting-pbe-nnp-learningRate-lee2022 ,
        entity:setting-pbe-nnp-numEpochs-lee2022 ;
    mlips:produces entity:model-pbe-nnp-lee2022 .

entity:model-pbe-nnp-lee2022 a mlips:TrainedModel ;
    rdfs:label "PBE-NNP MgO-CaO" .

entity:run-scan-nnp-lee2022 a mlips:MLIPRun ;
    rdfs:label "SCAN-NNP for MgO-CaO" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-scan-lee2022 ;
    mlips:hasHyperparameterSetting entity:setting-scan-nnp-cutoffRadius-lee2022 ,
        entity:setting-scan-nnp-angularCutoff-lee2022 ,
        entity:setting-scan-nnp-numLayers-lee2022 ,
        entity:setting-scan-nnp-learningRate-lee2022 ,
        entity:setting-scan-nnp-numEpochs-lee2022 ;
    mlips:produces entity:model-scan-nnp-lee2022 .

entity:model-scan-nnp-lee2022 a mlips:TrainedModel ;
    rdfs:label "SCAN-NNP MgO-CaO" .

