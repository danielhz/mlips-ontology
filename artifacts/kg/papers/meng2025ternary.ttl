###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-fech-meng2025ternary a mlips:MaterialSystem ;
    rdfs:label "alpha-Fe, Fe3C cementite and C/H in pristine and defective iron (vacancies, surfaces, grain boundaries, screw dislocations, ferrite-cementite interfaces), plus C, H2 and CH4" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-meng2025ternary a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-meng2025ternary mlips:hasDFTSettings entity:calc-settings-vasp-meng2025ternary .

entity:calc-settings-vasp-meng2025ternary a mlips:DFTSettings ;
