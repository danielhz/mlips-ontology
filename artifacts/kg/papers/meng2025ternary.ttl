    rdfs:comment "Spin-polarized; settings as in the authors' earlier work (Ref. 28)" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fech-meng2025ternary a mlips:TrainingDataset ;
    rdfs:label "alpha-Fe-C-H database (62,743 configurations, 6.05 million atomic environments; 90% training)" ;
    mlips:coversMaterial entity:mat-fech-meng2025ternary ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 62743 ;
    mlips:hasDFTCalculation entity:calc-vasp-meng2025ternary .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-fech-meng2025ternary mlips:samplingStrategy
    entity:sampling-db-meng2025ternary .

entity:sampling-db-meng2025ternary a mlips:SamplingStrategy ;
    rdfs:label "Unary (alpha-Fe, C, H2), binary (Fe-H, Fe-C) and ternary (Fe-C-H) configurations by the rules of Supplementary Note 1" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-meng2025ternary ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-HDNNP-meng2025ternary ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation .

entity:loss-HDNNP-meng2025ternary a mlips:LossFunction ;
    rdfs:label "Energies and forces" .

entity:impl-HDNNP-meng2025ternary a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-meng2025ternary .

entity:lib-n2p2-meng2025ternary a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nnip-cutoffRadius-meng2025ternary a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-nnip-angularCutoff-meng2025ternary a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "6"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nnip-meng2025ternary a mlips:MLIPRun ;
    rdfs:label "NNIP for alpha-Fe-C-H" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-fech-meng2025ternary ;
    mlips:hasHyperparameterSetting entity:setting-nnip-cutoffRadius-meng2025ternary ,
        entity:setting-nnip-angularCutoff-meng2025ternary ;
    mlips:produces entity:model-nnip-meng2025ternary .

entity:model-nnip-meng2025ternary a mlips:TrainedModel ;
    rdfs:label "NNIP alpha-Fe-C-H (2025)" .

###############################################################################
