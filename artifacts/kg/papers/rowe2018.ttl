# Canonical Turtle for the protocol-derived encoding of:
#   Patrick Rowe et al. (2018). Development of a machine learning potential for graphene.
#   Physical review. B./Physical review. B. doi:10.1103/physrevb.97.054303  arXiv:1710.04187v3
#
# Version read: arxiv-preprint arXiv:1710.04187v3 (sha256 d48cd247cac47ddc...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 687 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/rowe2018.yaml.
#
# Encoding scope: the graphene GAP (2b + 3b + SOAP, QUIP) trained on
# optB88-vdW data from iterative MD sampling, and the amorphous-carbon GAP
# of Ref. 24 evaluated as distributed, with in-plane and out-of-plane
# force RMSEs on an independent reference set (Table II). Empirical
# potentials and DFTB in the same table are not MLIPs. Lattice parameters,
# thermal expansion and phonons are property results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-rowe2018 a mlips:BenchmarkStudy ;
    rdfs:label "Rowe, Csányi, Alfè and Michaelides (2018): development of a machine-learning potential for graphene" ;
    mlips:reportedIn entity:article-rowe2018 .

entity:article-rowe2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevb.97.054303> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Development of a machine learning potential for graphene" ;
    schema:author entity:person-Rowe-rowe2018 ,
        entity:person-Csanyi-rowe2018 ,
        entity:person-Alfe-rowe2018 ,
        entity:person-Michaelides-rowe2018 .

entity:person-Rowe-rowe2018 a schema:Person ;
    schema:name "Patrick Rowe" ;
    schema:givenName "Patrick" ;
    schema:familyName "Rowe" .

entity:person-Csanyi-rowe2018 a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" .

entity:person-Alfe-rowe2018 a schema:Person ;
    schema:name "Dario Alfè" ;
    schema:givenName "Dario" ;
    schema:familyName "Alfè" .

entity:person-Michaelides-rowe2018 a schema:Person ;
    schema:name "Angelos Michaelides" ;
    schema:givenName "Angelos" ;
    schema:familyName "Michaelides" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-graphene-rowe2018 a mlips:MaterialSystem ;
    rdfs:label "Free-standing graphene (200-atom cells, 300-4000 K, a = 2.460-2.480 A)" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "2D carbon" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-optb88-rowe2018 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-optb88-rowe2018 mlips:hasDFTSettings entity:calc-settings-optb88-rowe2018 .

entity:calc-settings-optb88-rowe2018 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-optB88-vdW-rowe2018 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "650"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack, maximum spacing 0.012 1/A" ;
    rdfs:comment "Gaussian smearing 0.05 eV; SCF 1e-8 eV." .

entity:xc-optB88-vdW-rowe2018 a mlips:XCFunctional ;
    rdfs:label "optB88-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-graphene-rowe2018 a mlips:TrainingDataset ;
    rdfs:label "Graphene training data (1083 configurations of 200 atoms; 5% validation)" ;
    mlips:coversMaterial entity:mat-graphene-rowe2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1083 ;
    mlips:hasDFTCalculation entity:calc-optb88-rowe2018 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-graphene-rowe2018 mlips:samplingStrategy
    entity:sampling-md-iter-rowe2018 .

entity:sampling-md-iter-rowe2018 a mlips:SamplingStrategy ;
    rdfs:label "LCBOP NVT MD at 1000-3000 K, then iterative GAP-driven MD at 300-4000 K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-rowe2018 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-rowe2018 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:alg-GAP-rowe2018 a mls:Algorithm ;
    rdfs:label "2b (50 sparse points), 3b (200) and SOAP (650, CUR) descriptors with delta 10, 3.7 and 0.07 eV; sigma_E 1e-3 eV, sigma_f 5e-4, sigma_v 5e-3" .

entity:impl-GAP-rowe2018 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-graphene-cutoffRadius-rowe2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4"^^xsd:double .

entity:setting-gap-graphene-numSparseConfigs-rowe2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "650"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-graphene-rowe2018 a mlips:MLIPRun ;
    rdfs:label "Graphene GAP" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-graphene-rowe2018 ;
    mlips:hasHyperparameterSetting entity:setting-gap-graphene-cutoffRadius-rowe2018 ,
        entity:setting-gap-graphene-numSparseConfigs-rowe2018 ;
    mlips:produces entity:model-gap-graphene-rowe2018 .

entity:model-gap-graphene-rowe2018 a mlips:TrainedModel ;
    rdfs:label "Graphene GAP (2018)" .

entity:run-gap-ac-rowe2018 a mlips:MLIPRun ;
    rdfs:label "Amorphous-carbon GAP (Ref. 24) as distributed" ;
    mlips:appliesMethod entity:GAP ;
    mlips:produces entity:model-gap-ac-rowe2018 .

entity:model-gap-ac-rowe2018 a mlips:TrainedModel ;
    rdfs:label "GAP-17 amorphous carbon" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-rowe2018 mlips:hasResult
    entity:result-gap-graphene-test-rowe2018 ,
    entity:result-gap-ac-graphene-rowe2018 .

entity:result-gap-graphene-test-rowe2018 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-graphene-rowe2018 ;
    mlips:targetMaterial entity:mat-graphene-rowe2018 ;
    mlips:hasAccuracyMetric entity:metric-gap-graphene-test-1-rowe2018 ,
        entity:metric-gap-graphene-test-2-rowe2018 .

entity:metric-gap-graphene-test-1-rowe2018 a mlips:AccuracyMetric ;
    rdfs:label "in-plane force RMSE on graphene: graphene GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "28"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-gap-graphene-test-2-rowe2018 a mlips:AccuracyMetric ;
    rdfs:label "out-of-plane force RMSE on graphene: graphene GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "19"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-gap-ac-graphene-rowe2018 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-ac-rowe2018 ;
    mlips:targetMaterial entity:mat-graphene-rowe2018 ;
    mlips:hasAccuracyMetric entity:metric-gap-ac-graphene-1-rowe2018 ,
        entity:metric-gap-ac-graphene-2-rowe2018 .

entity:metric-gap-ac-graphene-1-rowe2018 a mlips:AccuracyMetric ;
    rdfs:label "in-plane force RMSE on graphene: amorphous-carbon GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "270"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-gap-ac-graphene-2-rowe2018 a mlips:AccuracyMetric ;
    rdfs:label "out-of-plane force RMSE on graphene: amorphous-carbon GAP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "258"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

