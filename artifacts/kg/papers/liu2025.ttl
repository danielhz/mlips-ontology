entity:setting-ft-0b-hea-numEpochs-liu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

entity:setting-ft-0b-si-learningRate-liu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0005"^^xsd:double .

entity:setting-ft-0b-si-numEpochs-liu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

