# Canonical Turtle for the protocol-derived encoding of:
#   Xiaoqing Liu et al. (2025). A Study on the Fine-Tuning Performance of Universal Machine-Learned Interatomic Potentials (U-MLIPs).
#   arXiv (Cornell University). doi:10.48550/arxiv.2506.07401  arXiv:2506.07401v1
#
# Version read: arxiv-preprint arXiv:2506.07401v1 (sha256 c4bde4fa4e881177...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 229 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/liu2025.yaml.
#
# Encoding scope: the medium MACE-MP-0 and MACE-MP-0b foundation models,
# their fine-tuned versions, and MACE and ACE models trained from scratch,
# with the tabulated test errors for the NbAlMoTiZr high-entropy alloy
# (Table 5) and the stated final errors of MACE-MP-0b fine-tuned on a
# filtered silicon subset (Sec. 3.2). Property comparisons for elemental
# metals, silicon defects, dislocations and molten LiCl (Tables 2-4, 6,
# figures) are not accuracy metrics of the schema and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liu2025 a mlips:BenchmarkStudy ;
    rdfs:label "Liu et al. (2025): fine-tuning performance of the MACE-MP-0 and MACE-MP-0b foundation models" ;
    mlips:reportedIn entity:article-liu2025 .

entity:article-liu2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2506.07401> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "A Study on the Fine-Tuning Performance of Universal Machine-Learned Interatomic Potentials (U-MLIPs)" ;
    schema:author entity:person-Liu-liu2025 ,
        entity:person-Zeng-liu2025 ,
        entity:person-Wang-liu2025 ,
        entity:person-Zhao-liu2025 .

entity:person-Liu-liu2025 a schema:Person ;
    schema:name "Xiaoqing Liu" ;
    schema:givenName "Xiaoqing" ;
    schema:familyName "Liu" .

entity:person-Zeng-liu2025 a schema:Person ;
    schema:name "Kehan Zeng" ;
    schema:givenName "Kehan" ;
    schema:familyName "Zeng" .

entity:person-Wang-liu2025 a schema:Person ;
    schema:name "Yangshuai Wang" ;
    schema:givenName "Yangshuai" ;
    schema:familyName "Wang" .

entity:person-Zhao-liu2025 a schema:Person ;
    schema:name "Teng Zhao" ;
    schema:givenName "Teng" ;
    schema:familyName "Zhao" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-HEA-liu2025 a mlips:MaterialSystem ;
    rdfs:label "NbAlMoTiZr high-entropy alloy (configurations of 1-6 atoms)" ;
    mlips:materialClass "Refractory high-entropy alloy" .

entity:mat-Si-liu2025 a mlips:MaterialSystem ;
    rdfs:label "Silicon (defects and low-temperature states)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental semiconductor" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q670> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-hea-liu2025 a mlips:TrainingDataset ;
    rdfs:label "NbAlMoTiZr data set selected by uncertainty filtering (FT-3)" ;
    mlips:coversMaterial entity:mat-HEA-liu2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    rdfs:comment "Candidate configurations of 1-5 atoms filtered with an auxiliary ACE model's Bayesian uncertainties; 6-atom configurations used for testing (Sec. 3.4)." .

entity:ds-si-subset-liu2025 a mlips:TrainingDataset ;
    rdfs:label "Silicon subset of the Si database of Ref. [66] focused on defects and low-temperature states (FT-2)" ;
    mlips:coversMaterial entity:mat-Si-liu2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "The full database has 531,710 electronic-structure data points; the subset is manually filtered (Sec. 3.2)." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-liu2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-liu2025 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-liu2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-MACE-liu2025 a mlips:LossFunction ;
    rdfs:label "MSE on energy, force and stress with a 1-10-100 ratio; multi-head fine-tuning with 400 MPtrj samples" .

entity:alg-MACE-liu2025 a mls:Algorithm ;
    rdfs:label "Adam with EMA (0.99), gradient clipping at 10" .

entity:impl-MACE-liu2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor .

