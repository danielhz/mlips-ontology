# Canonical Turtle for the protocol-derived encoding of:
#   Xiaoyu Wang et al. (2026). Distilling latent electrostatics from foundation machine learning interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2606.15001  arXiv:2606.15001v1
#
# Version read: arxiv-preprint arXiv:2606.15001v1 (sha256 17cd69fc180e618c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 548 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wang2026distilling.yaml.
#
# Encoding scope: student MACE-LES models distilled from 11 foundation
# models for liquid water (500 UMA-M(OMol) MD snapshots relabelled by
# each teacher), MACE-LES students for 2 M HCl, CACE-LES students
# distilled from eight foundation models for the anatase TiO2(101)-water
# interface (3,346 configurations), and two CACE-LES models fitted
# directly to the SCAN TiO2-water data, whose test force RMSEs are
# stated. Student errors are given only as bounds; BECs and IR spectra
# are properties. Teachers are named checkpoints, not registry models.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wang2026distilling a mlips:BenchmarkStudy ;
    rdfs:label "Wang and Cheng (2026): distilling latent electrostatics (LES) from foundation MLIPs into MACE-LES and CACE-LES students for Born effective charges and IR spectra" ;
    mlips:reportedIn entity:article-wang2026distilling .

entity:article-wang2026distilling a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2606.15001> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Distilling latent electrostatics from foundation machine learning interatomic potentials" ;
    schema:author entity:person-Wang-wang2026distilling ,
        entity:person-Cheng-wang2026distilling .

entity:person-Wang-wang2026distilling a schema:Person ;
    schema:name "Xiaoyu Wang" ;
    schema:givenName "Xiaoyu" ;
    schema:familyName "Wang" .

entity:person-Cheng-wang2026distilling a schema:Person ;
    schema:name "Bingqing Cheng" ;
    schema:givenName "Bingqing" ;
    schema:familyName "Cheng" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-wang2026distilling a mlips:MaterialSystem ;
    rdfs:label "Liquid water (64 molecules)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

entity:mat-hcl-wang2026distilling a mlips:MaterialSystem ;
    rdfs:label "2 M HCl solution (96 H2O, 4 HCl)" ;
    mlips:materialClass "Molecular liquid" .

entity:mat-tio2w-wang2026distilling a mlips:MaterialSystem ;
    rdfs:label "Anatase TiO2(101)-water interface" ;
    mlips:materialClass "Solid-liquid interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-teacher-wang2026distilling a mlips:ReferenceCalculation .

entity:calc-scan-wang2026distilling a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-teacher-wang2026distilling mlips:hasReferenceSettings entity:calc-settings-teacher-wang2026distilling .

entity:calc-settings-teacher-wang2026distilling a mlips:ReferenceSettings ;
    mlips:usedReferenceCode mlips:MLIP ;
    rdfs:comment "Energies and forces from the foundation-model teacher of each student" .

entity:calc-scan-wang2026distilling mlips:hasDFTSettings entity:calc-settings-scan-wang2026distilling .

entity:calc-settings-scan-wang2026distilling a mlips:DFTSettings ;
    mlips:xcFunctional mlips:SCAN ;
    rdfs:comment "SCAN TiO2-water interface dataset of Ref. 87" .

