# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE-LES a mlips:MLIPMethod ;
    rdfs:label "MACE with latent Ewald summation (MACE-LES)" ;
    mlips:hasLossFunction entity:loss-MACE-LES-wang2026distilling ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-MACE-LES-wang2026distilling ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-LES-wang2026distilling a mlips:LossFunction ;
    rdfs:label "Energies and forces of the teacher" .

entity:impl-MACE-LES-wang2026distilling a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:CACE-LES a mlips:MLIPMethod ;
    rdfs:label "CACE with latent Ewald summation (CACE-LES)" ;
    mlips:hasLossFunction entity:loss-CACE-LES-wang2026distilling ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-CACE-LES-wang2026distilling ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-CACE-LES-wang2026distilling a mlips:LossFunction ;
    rdfs:label "Energies and forces" .

entity:impl-CACE-LES-wang2026distilling a mlips:Implementation ;
    mlips:implementedIn entity:lib-CACE-wang2026distilling .

entity:lib-CACE-wang2026distilling a mlips:Library ;
    rdfs:label "CACE" ;
