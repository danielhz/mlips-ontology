# Canonical Turtle for the protocol-derived encoding of:
#   G. P. Purja Pun et al. (2020). Development of a general-purpose machine-learning interatomic potential for aluminum by the physically informed neural network method.
#   Physical Review Materials. doi:10.1103/physrevmaterials.4.113807  arXiv:2009.06533v3
#
# Version read: arxiv-preprint arXiv:2009.06533v3 (sha256 24842d913c2dded1...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 167 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the second-generation PINN potential for Al (a neural
# network that locally adjusts the parameters of a bond-order potential),
# trained on energies from the DFT database of the original PINN paper:
# training subset, settings and the energy and force RMSEs stated in the
# text. Property tests and applications are not encoded. Read from the
# arXiv preprint (v3).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-purjapun2020 a mlips:BenchmarkStudy ;
    rdfs:label "Purja Pun et al. (2020): general-purpose PINN potential for aluminium" ;
    mlips:reportedIn entity:article-purjapun2020 .

entity:article-purjapun2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.4.113807> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Development of a general-purpose machine-learning interatomic potential for aluminum by the physically informed neural network method" ;
    schema:author entity:person-Pun-purjapun2020 ,
        <https://orcid.org/0000-0001-5528-9030> ,
        <https://orcid.org/0000-0003-2206-9132> ,
        entity:person-Glaessgen-purjapun2020 ,
        <https://orcid.org/0000-0001-7299-433X> .

entity:person-Pun-purjapun2020 a schema:Person ;
    schema:name "G. P. Purja Pun" ;
    schema:givenName "G. P. Purja" ;
    schema:familyName "Pun" .

<https://orcid.org/0000-0001-5528-9030> a schema:Person ;
    schema:name "V. Yamakov" ;
    schema:givenName "V." ;
    schema:familyName "Yamakov" ;
    schema:identifier <https://orcid.org/0000-0001-5528-9030> .

<https://orcid.org/0000-0003-2206-9132> a schema:Person ;
    schema:name "J. Hickman" ;
    schema:givenName "J." ;
    schema:familyName "Hickman" ;
