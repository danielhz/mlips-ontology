###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-gst-kheir2024 a mlips:MaterialSystem ;
    rdfs:label "Ge2Sb2Te5 (GST225): liquid, supercooled liquid, amorphous, cubic and hexagonal phases" ;
    mlips:chemicalFormula "Ge2Sb2Te5" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-kheir2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-kheir2024 mlips:hasDFTSettings entity:calc-settings-pbe-kheir2024 .

entity:calc-settings-pbe-kheir2024 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-kheir2024 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:kPointMesh "3x3x3 (108-atom cells) or 4x4x4 (smaller cells)" ;
    rdfs:comment "GTH pseudopotentials (s and p valence), TZVP Gaussian basis, 400 Ry density cutoff for the training single points; Gamma-point DFT-MD for sampling (Methods)." .

entity:lib-CP2K-kheir2024 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-gst-kheir2024 a mlips:TrainingDataset ;
    rdfs:label "GST225 PBE database (Table I: liquid 4,489; supercooled liquid 64,440; quenching 70,463; amorphous 3,620; cubic 8,764; hexagonal 7,935; metadynamics 18,524)" ;
    mlips:coversMaterial entity:mat-gst-kheir2024 ;
    mlips:coversProperty mlips:Energy ,
