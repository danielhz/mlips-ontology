###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gst-kheir2024 mlips:samplingStrategy
    entity:sampling-md-kheir2024 .

entity:sampling-md-kheir2024 a mlips:SamplingStrategy ;
    rdfs:label "Born-Oppenheimer DFT-MD of liquid, supercooled liquid, quenched, amorphous, cubic and hexagonal GST225 and metadynamics runs (Table I)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-DeePMD-kheir2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-DeePMD-kheir2024 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-gst-cutoffRadius-kheir2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-dp-gst-angularCutoff-kheir2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "3.8"^^xsd:double .

entity:setting-dp-gst-learningRate-kheir2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-dp-gst-numEpochs-kheir2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-gst-kheir2024 a mlips:MLIPRun ;
    rdfs:label "DeePMD potential for GST225 (se_e2 two-body cutoff 7 A, three-body 3.8 A; fitting net 120-60-30-15 with residual connections)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-gst-kheir2024 ;
    mlips:hasHyperparameterSetting entity:setting-dp-gst-cutoffRadius-kheir2024 ,
