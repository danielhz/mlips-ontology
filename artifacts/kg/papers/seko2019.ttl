# Canonical Turtle for the protocol-derived encoding of:
#   Atsuto Seko et al. (2019). Group-theoretical high-order rotational invariants for structural representations: Application to linearized machine learning interatomic potential.
#   Physical review. B./Physical review. B. doi:10.1103/physrevb.99.214108  arXiv:1901.02118v1
#
# Version read: arxiv-preprint arXiv:1901.02118v1 (sha256 4b2ed3ecf0070309...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 527 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/seko2019.yaml.
#
# Encoding scope: linearized polynomial MLIPs (PolyMLP) for Al built
# from pairwise, angular-Fourier-series (second-order) and higher-order
# (up to sixth-order) polynomial invariants, trained on 9,000 and tested
# on 1,000 structures generated from 86 ICSD prototypes; the energy RMS
# errors stated in the text. Phonon, vacancy and grain-boundary results
# (Table IV) are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-seko2019 a mlips:BenchmarkStudy ;
    rdfs:label "Seko, Togo and Tanaka (2019): group-theoretical high-order SO(3) polynomial invariants for linearized MLIPs, applied to elemental Al" ;
    mlips:reportedIn entity:article-seko2019 .

entity:article-seko2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevb.99.214108> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "Group-theoretical high-order rotational invariants for structural representations: Application to linearized machine learning interatomic potential" ;
    schema:author <https://orcid.org/0000-0002-2473-3837> ,
        entity:person-Togo-seko2019 ,
        entity:person-Tanaka-seko2019 .

<https://orcid.org/0000-0002-2473-3837> a schema:Person ;
    schema:name "Atsuto Seko" ;
    schema:givenName "Atsuto" ;
    schema:familyName "Seko" ;
    schema:identifier <https://orcid.org/0000-0002-2473-3837> .

entity:person-Togo-seko2019 a schema:Person ;
    schema:name "Atsushi Togo" ;
    schema:givenName "Atsushi" ;
    schema:familyName "Togo" .

entity:person-Tanaka-seko2019 a schema:Person ;
    schema:name "Isao Tanaka" ;
    schema:givenName "Isao" ;
    schema:familyName "Tanaka" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-al-seko2019 a mlips:MaterialSystem ;
    rdfs:label "Elemental Al in structures derived from 86 prototype structure generators (isotropic expansion, random distortion)" ;
    mlips:chemicalFormula "Al" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-seko2019 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-seko2019 mlips:hasDFTSettings entity:calc-settings-vasp-seko2019 .

entity:calc-settings-vasp-seko2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-al-seko2019 a mlips:TrainingDataset ;
    rdfs:label "Al training set (9,000 structures)" ;
    mlips:coversMaterial entity:mat-al-seko2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 9000 ;
    mlips:hasDFTCalculation entity:calc-vasp-seko2019 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-al-seko2019 mlips:samplingStrategy
    entity:sampling-proto-seko2019 .

entity:sampling-proto-seko2019 a mlips:SamplingStrategy ;
    rdfs:label "Structures derived from ICSD prototype structure generators by expansions, distortions and displacements; random 9,000/1,000 split" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PolyMLP a mlips:MLIPMethod ;
    rdfs:label "Linearized polynomial machine-learning potential (Seko, Takahashi and Tanaka)" ;
    mlips:hasLossFunction entity:loss-PolyMLP-seko2019 ;
    mlips:hasTrainingAlgorithm entity:alg-PolyMLP-seko2019 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-ninv-seko2019 ,
        entity:hp-pmax-seko2019 ;
    mlips:supportsSimulation mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:loss-PolyMLP-seko2019 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses" .

entity:alg-PolyMLP-seko2019 a mls:Algorithm ;
    rdfs:label "Linear ridge regression" .

entity:hp-ninv-seko2019 a mlips:Hyperparameter ;
    rdfs:label "Number of polynomial invariants" ;
    mlips:hyperparameterName "number of invariants" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-pmax-seko2019 a mlips:Hyperparameter ;
    rdfs:label "Maximum order of polynomial invariants p_max" ;
    mlips:hyperparameterName "p_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

