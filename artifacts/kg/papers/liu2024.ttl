    entity:result-s12-liu2024 .

entity:result-s1-liu2024 a mlips:BenchmarkResult ;
    rdfs:comment "Total-energy RMSE 5.345 meV." ;
    mlips:evaluatesModel entity:model-CuSn-liu2024 ;
    mlips:targetMaterial entity:mat-s1-liu2024 ;
    mlips:hasAccuracyMetric entity:metric-s1-1-liu2024 ,
        entity:metric-s1-2-liu2024 .

