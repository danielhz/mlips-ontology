# Canonical Turtle for the protocol-derived encoding of:
#   Jinyan Liu et al. (2024). Research on Cu-Sn machine learning interatomic potential with active learning strategy.
#   Computational Materials Science. doi:10.1016/j.commatsci.2024.113450
#
# Version read: publisher (sha256 b9c4124c54b7a877...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 183 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the Deep Potential model for the Cu-Sn system built
# with DP-GEN: VASP reference settings, initial data and exploration
# strategy, model and training settings, and the per-structure energy and
# force RMSEs of Table 2 for the twelve Cu-Sn structures. Mechanical and
# phase-transition simulations are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liu2024 a mlips:BenchmarkStudy ;
    rdfs:label "Liu et al. (2024): Cu-Sn machine learning interatomic potential with an active learning strategy" ;
    mlips:reportedIn entity:article-liu2024 .

entity:article-liu2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.commatsci.2024.113450> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Research on Cu-Sn machine learning interatomic potential with active learning strategy" ;
    schema:author entity:person-Liu-liu2024 ,
        entity:person-Zhang-liu2024 ,
        entity:person-Wang-liu2024 ,
        entity:person-ZhangHong-liu2024 ,
        entity:person-Han-liu2024 .

entity:person-Liu-liu2024 a schema:Person ;
    schema:name "Jinyan Liu" ;
    schema:givenName "Jinyan" ;
    schema:familyName "Liu" .

entity:person-Zhang-liu2024 a schema:Person ;
    schema:name "Guanghao Zhang" ;
    schema:givenName "Guanghao" ;
    schema:familyName "Zhang" .

entity:person-Wang-liu2024 a schema:Person ;
    schema:name "Jianyong Wang" ;
    schema:givenName "Jianyong" ;
    schema:familyName "Wang" .

entity:person-ZhangHong-liu2024 a schema:Person ;
    schema:name "Hong Zhang" ;
    schema:givenName "Hong" ;
    schema:familyName "Zhang" .

entity:person-Han-liu2024 a schema:Person ;
    schema:name "Ye Han" ;
    schema:givenName "Ye" ;
    schema:familyName "Han" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-CuSn-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu-Sn system (twelve intermetallic structures from the Materials Project and their perturbed and molten states)" ;
    mlips:chemicalFormula "Cu-Sn" ;
    mlips:materialClass "Binary intermetallic system" .

entity:mat-s1-liu2024 a mlips:MaterialSystem ;
    rdfs:label "CuSn, hexagonal P63/mmc (mp-10598)" ;
    mlips:chemicalFormula "CuSn" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s2-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu6Sn5, monoclinic C2/c (mp-1233)" ;
    mlips:chemicalFormula "Cu6Sn5" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s3-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu5Sn4, monoclinic P21/c (mp-845)" ;
    mlips:chemicalFormula "Cu5Sn4" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s4-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu10Sn3, hexagonal P63 (mp-568495)" ;
    mlips:chemicalFormula "Cu10Sn3" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s5-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu10Sn3, hexagonal P63/m (mp-30597)" ;
    mlips:chemicalFormula "Cu10Sn3" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s6-liu2024 a mlips:MaterialSystem ;
    rdfs:label "CuSn3, hexagonal P63/mmc (mp-1184173)" ;
    mlips:chemicalFormula "CuSn3" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s7-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu3Sn, cubic Fm-3m (mp-838)" ;
    mlips:chemicalFormula "Cu3Sn" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s8-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu3Sn, hexagonal P63/mmc (mp-13138)" ;
    mlips:chemicalFormula "Cu3Sn" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s9-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu5Sn4, monoclinic C2 (mp-568524)" ;
    mlips:chemicalFormula "Cu5Sn4" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s10-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu10Sn3, trigonal P-31m (mp-569339)" ;
    mlips:chemicalFormula "Cu10Sn3" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s11-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu3Sn, orthorhombic Pmmn (mp-581786)" ;
    mlips:chemicalFormula "Cu3Sn" ;
    mlips:materialClass "Binary intermetallic compound" .

entity:mat-s12-liu2024 a mlips:MaterialSystem ;
    rdfs:label "Cu19Sn16, triclinic P1 (mp-1225980)" ;
    mlips:chemicalFormula "Cu19Sn16" ;
    mlips:materialClass "Binary intermetallic compound" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-liu2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-liu2024 mlips:hasDFTSettings entity:calc-settings-dft-liu2024 .

entity:calc-settings-dft-liu2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack mesh with spacing 0.12 per Angstrom" ;
    rdfs:comment "SCF converged to 1e-5 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-CuSn-liu2024 a mlips:TrainingDataset ;
    rdfs:label "DP-GEN data set for Cu-Sn (initial AIMD data plus actively selected configurations)" ;
    mlips:coversMaterial entity:mat-CuSn-liu2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-liu2024 ;
    rdfs:comment "The number of configurations is not stated in the main text." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-CuSn-liu2024 mlips:samplingStrategy
    entity:sampling-initial-liu2024 ,
    entity:sampling-dpgen-liu2024 .

entity:sampling-initial-liu2024 a mlips:SamplingStrategy ;
    rdfs:label "Initial data: twelve Materials Project structures deformed (3% cell deformation, 0.01 A atomic perturbation) and run with ab initio MD" .

entity:sampling-dpgen-liu2024 a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN exploration: NPT Deep Potential MD (LAMMPS) from 300 to 2000 K and 1 to 50,000 bar; configurations with force model deviation between 0.05 and 0.15 eV/A over four models are labelled with DFT" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-liu2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-embedding-net-liu2024 ,
        entity:hp-fitting-net-liu2024 ,
        mlips:learningRate ,
        entity:hp-training-steps-liu2024 ;
    mlips:hasImplementation entity:impl-DeePMD-liu2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:alg-DeePMD-liu2024 a mls:Algorithm ;
    rdfs:label "Learning rate decaying exponentially from 1e-4 to 3.5e-8; four models differing only in the random seed for the model deviation" .

entity:impl-DeePMD-liu2024 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit ;
    mlips:version "DeepPot-SE" .

entity:hp-embedding-net-liu2024 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential embedding network sizes" ;
    mlips:hyperparameterName "embedding_net" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-fitting-net-liu2024 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential fitting network sizes" ;
    mlips:hyperparameterName "fitting_net" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-training-steps-liu2024 a mlips:Hyperparameter ;
    rdfs:label "Number of training steps" ;
    mlips:hyperparameterName "training_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-CuSn-cutoffRadius-liu2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-CuSn-embedding-net-liu2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-embedding-net-liu2024 ;
    mlips:settingValue "25-50-100" .

entity:setting-CuSn-fitting-net-liu2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-fitting-net-liu2024 ;
    mlips:settingValue "240-240-240" .

entity:setting-CuSn-learningRate-liu2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-CuSn-training-steps-liu2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-training-steps-liu2024 ;
    mlips:settingValue "8000000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-CuSn-liu2024 a mlips:MLIPRun ;
    rdfs:label "Deep Potential training for the Cu-Sn system (DP-GEN)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-CuSn-liu2024 ;
    mlips:hasHyperparameterSetting entity:setting-CuSn-cutoffRadius-liu2024 ,
        entity:setting-CuSn-embedding-net-liu2024 ,
        entity:setting-CuSn-fitting-net-liu2024 ,
        entity:setting-CuSn-learningRate-liu2024 ,
        entity:setting-CuSn-training-steps-liu2024 ;
    mlips:produces entity:model-CuSn-liu2024 .

entity:model-CuSn-liu2024 a mlips:TrainedModel ;
    rdfs:label "DP model for the Cu-Sn system" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-liu2024 mlips:hasResult
    entity:result-s1-liu2024 ,
