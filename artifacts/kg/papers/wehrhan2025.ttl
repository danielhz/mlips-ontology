    mlips:appliesMethod entity:ViSNet ;
    mlips:runsOn entity:ds-spice2-wehrhan2025 ;
    mlips:produces entity:model-visnet-spice2-wehrhan2025 .

entity:model-visnet-spice2-wehrhan2025 a mlips:TrainedModel ;
    rdfs:label "ViSNet-SPICE2 (MLIPAudit)" .

entity:run-mace-spice2-wehrhan2025 a mlips:MLIPRun ;
