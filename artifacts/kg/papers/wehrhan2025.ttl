# Canonical Turtle for the protocol-derived encoding of:
#   Leon Wehrhan et al. (2025). MLIPAudit: A benchmarking tool for Machine Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2511.20487  arXiv:2511.20487v1
#
# Version read: arxiv-preprint arXiv:2511.20487v1 (sha256 3845574f2becc6e8...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 428 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wehrhan2025.yaml.
#
# Encoding scope: the models benchmarked with MLIPAudit v0.1.0: eight
# internal models trained with the InstaDeep mlip library (ViSNet, MACE
# and NequIP on curated SPICE2 or Transition-1x; two ViSNet models on
# SPICE2 + T1x recomputed in OMol25) and three external pretrained models
# (UMA-Small, MACE-OFF, MACE-MP). Results are normalised benchmark scores
# (Tables 2-3, 7-10) and figure-only errors, so no error metrics are
# encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wehrhan2025 a mlips:BenchmarkStudy ;
    rdfs:label "Wehrhan et al. (2025): MLIPAudit, a benchmarking suite for MLIPs on molecular, liquid, biomolecular and reactivity tasks" ;
    mlips:reportedIn entity:article-wehrhan2025 .

entity:article-wehrhan2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2511.20487> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "MLIPAudit: A benchmarking tool for Machine Learned Interatomic Potentials" ;
    schema:author entity:person-Wehrhan-wehrhan2025 ,
        entity:person-Walewski-wehrhan2025 ,
        entity:person-Bluntzer-wehrhan2025 ,
        entity:person-Chomet-wehrhan2025 ,
        entity:person-Tilly-wehrhan2025 ,
        entity:person-Brunken-wehrhan2025 ,
        entity:person-AcostaGutierrez-wehrhan2025 .

entity:person-Wehrhan-wehrhan2025 a schema:Person ;
    schema:name "Leon Wehrhan" ;
    schema:givenName "Leon" ;
    schema:familyName "Wehrhan" .

entity:person-Walewski-wehrhan2025 a schema:Person ;
    schema:name "Lucien Walewski" ;
    schema:givenName "Lucien" ;
    schema:familyName "Walewski" .

entity:person-Bluntzer-wehrhan2025 a schema:Person ;
    schema:name "Marie Bluntzer" ;
    schema:givenName "Marie" ;
    schema:familyName "Bluntzer" .

entity:person-Chomet-wehrhan2025 a schema:Person ;
    schema:name "Heloise Chomet" ;
    schema:givenName "Heloise" ;
    schema:familyName "Chomet" .

entity:person-Tilly-wehrhan2025 a schema:Person ;
    schema:name "Jules Tilly" ;
    schema:givenName "Jules" ;
    schema:familyName "Tilly" .

entity:person-Brunken-wehrhan2025 a schema:Person ;
    schema:name "Christoph Brunken" ;
    schema:givenName "Christoph" ;
    schema:familyName "Brunken" .

entity:person-AcostaGutierrez-wehrhan2025 a schema:Person ;
    schema:name "Silvia Acosta-Gutiérrez" ;
    schema:givenName "Silvia" ;
    schema:familyName "Acosta-Gutiérrez" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mol-wehrhan2025 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules, molecular liquids, biomolecules and reactions (MLIPAudit benchmark sets)" ;
    mlips:materialClass "Organic and biochemical molecules (C, N, O, H)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-spice2-wehrhan2025 a mlips:TrainingDataset ;
    rdfs:label "Curated SPICE2 (neutral systems; as in Brunken et al.)" ;
    mlips:coversMaterial entity:mat-mol-wehrhan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-t1x-wehrhan2025 a mlips:TrainingDataset ;
    rdfs:label "Transition-1x (1M samples; 95/5 train/validation)" ;
    mlips:coversMaterial entity:mat-mol-wehrhan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-omol-c-wehrhan2025 a mlips:TrainingDataset ;
    rdfs:label "SPICE2 + Transition-1x as recomputed in OMol25 (charged; 50k T1x samples)" ;
    mlips:coversMaterial entity:mat-mol-wehrhan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-omol-n-wehrhan2025 a mlips:TrainingDataset ;
    rdfs:label "SPICE2 + Transition-1x as recomputed in OMol25 (neutral; 1M T1x samples)" ;
    mlips:coversMaterial entity:mat-mol-wehrhan2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ViSNet a mlips:MLIPMethod ;
    rdfs:label "ViSNet (vector-scalar interactive equivariant graph neural network)" ;
    mlips:hasImplementation entity:impl-ViSNet-wehrhan2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-ViSNet-wehrhan2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-InstaDeep-JAX-wehrhan2025 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasImplementation entity:impl-NequIP-wehrhan2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-NequIP-wehrhan2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-InstaDeep-JAX-wehrhan2025 .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:lib-mlip-InstaDeep-JAX-wehrhan2025 a mlips:Library ;
    rdfs:label "mlip (InstaDeep, JAX)" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

