# Canonical Turtle for the protocol-derived encoding of:
#   Wang, Zhang, Han, E. DeePMD-kit: A deep learning package for
#   many-body potential energy representation and molecular dynamics.
#   Comput. Phys. Commun. 228, 178-184 (2018).
#   doi:10.1016/j.cpc.2018.03.016
#   arXiv:1712.03641
#
# Encoding scope: this is a software paper documenting the DeePMD-kit
# package; as such the protocol is exercised on the single liquid-water
# demonstration example reported in Section IV. The encoded run is the
# DeePMD model trained on a 64-molecule water AIMD trajectory at
# PBE0+TS. The full software's multi-system, multi-method capabilities
# are not captured by the encoding -- this is recorded as the central
# Q12 gap.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wang2018dpkit a mlips:BenchmarkStudy ;
    rdfs:label "Wang et al. (2018): DeePMD-kit software, water demonstration" ;
    mlips:reportedIn entity:article-wang2018dpkit .

entity:article-wang2018dpkit a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.cpc.2018.03.016> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "DeePMD-kit: A deep learning package for many-body potential energy representation and molecular dynamics" ;
    schema:author
        <https://orcid.org/0000-0002-4302-1886> ,
        <https://orcid.org/0000-0002-8470-5846> ,
        <https://orcid.org/0000-0002-3553-7313> ,
        entity:person-E-wang2018dpkit .

<https://orcid.org/0000-0002-4302-1886> a schema:Person ;
    schema:name "Han Wang" ;
    schema:givenName "Han" ;
    schema:familyName "Wang" ;
    schema:identifier <https://orcid.org/0000-0002-4302-1886> .
<https://orcid.org/0000-0002-8470-5846> a schema:Person ;
    schema:name "Linfeng Zhang" ;
    schema:givenName "Linfeng" ;
    schema:familyName "Zhang" ;
    schema:identifier <https://orcid.org/0000-0002-8470-5846> .

<https://orcid.org/0000-0002-3553-7313> a schema:Person ;
    schema:name "Jiequn Han" ;
    schema:givenName "Jiequn" ;
    schema:familyName "Han" ;
    schema:identifier <https://orcid.org/0000-0002-3553-7313> .
entity:person-E-wang2018dpkit a schema:Person ;
    schema:name "Weinan E" ;
    schema:givenName "Weinan" ;
    schema:familyName "E" ;
    rdfs:comment "No ORCID found via Crossref / arXiv API as of 2026-05-04." .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-wang2018 a mlips:MaterialSystem ;
    rdfs:label "Liquid water (64 H2O molecules, PBC, ~330 K)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid (bulk water under periodic boundary conditions)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-wang2018dpkit a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-wang2018dpkit mlips:hasDFTSettings entity:dft-settings-wang2018dpkit .

entity:dft-settings-wang2018dpkit a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE0 ;
    rdfs:comment "Tkatchenko-Scheffler dispersion correction (PBE0+TS)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-water-wang2018 a mlips:TrainingDataset ;
    rdfs:label "Liquid-water reference set: 40000 frames from a 20 ps NVT AIMD trajectory at 330 K of 64 H2O molecules (38000 train + 2000 test)" ;
    mlips:coversMaterial entity:mat-water-wang2018 ;
    mlips:coversProperty mlips:Energy , mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 40000 ;
    mlips:hasDFTCalculation entity:dft-wang2018dpkit .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-water-wang2018 mlips:samplingStrategy entity:aimd-sampling-wang2018 .

entity:aimd-sampling-wang2018 a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling (NVT AIMD)" ;
    rdfs:comment "Configurations are recorded every 0.0005 ps along a 20 ps NVT AIMD trajectory of 64 water molecules at 330 K." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    mlips:supportsSimulation mlips:MolecularDynamics ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasFunctionalForm entity:deepmd-functional-form;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:deepmd-loss-wang2018 ;
    mlips:hasTrainingAlgorithm entity:adam-deepmd ;
    mlips:hasHyperparameter mlips:cutoffRadius , entity:hp-hidden-deepmd , mlips:learningRate , entity:hp-decay-rate-deepmd , entity:hp-decay-steps-deepmd ;
    mlips:hasImplementation entity:deepmd-kit-impl .

entity:deepmd-functional-form a mlips:FunctionalForm ;
    rdfs:label "Per-atom DNN over local-frame radial+angular descriptors (1/R, x/R, y/R, z/R) sorted by chemical species, 5 hidden layers (240, 120, 60, 30, 10) with tanh activations" .

entity:deepmd-loss-wang2018 a mlips:LossFunction ;
    rdfs:label "Weighted MSE on energy and force (no virial), with annealed prefactors (p_e: 0.02 -> 8; p_f: 1000 -> 1; p_v: 0)" .

entity:adam-deepmd a mls:Algorithm ;
    rdfs:label "Adam stochastic gradient descent with exponentially decaying learning rate (start 1e-3, decay rate 0.95 every 5000 steps)" .

entity:deepmd-kit-impl a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit ;
    mlips:version "0.1" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-60-wang2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-hidden-deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-hidden-deepmd ;
    mlips:settingValue "(240, 120, 60, 30, 10)" .

entity:setting-lr0-deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-decay-rate-deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-decay-rate-deepmd ;
    mlips:settingValue "0.95"^^xsd:double .

entity:setting-decay-steps-deepmd a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-decay-steps-deepmd ;
    mlips:settingValue "5000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-deepmd-water a mlips:MLIPRun ;
    rdfs:label "DeePMD-kit demonstration training run on the liquid-water dataset (10^6 batches, batch size 4)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-water-wang2018 ;
    mlips:hasHyperparameterSetting entity:setting-rcut-60-wang2018 , entity:setting-hidden-deepmd , entity:setting-lr0-deepmd , entity:setting-decay-rate-deepmd , entity:setting-decay-steps-deepmd ;
    mlips:produces entity:model-deepmd-water .

entity:model-deepmd-water a mlips:TrainedModel ;
    rdfs:label "DeePMD water model (PBE0+TS reference, demonstration of DeePMD-kit)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-wang2018dpkit mlips:hasResult entity:result-deepmd-water-energy , entity:result-deepmd-water-forces .

entity:result-deepmd-water-energy a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-deepmd-water ;
    mlips:targetMaterial entity:mat-water-wang2018 ;
    mlips:hasAccuracyMetric entity:metric-rmse-water-energy .

entity:metric-rmse-water-energy a mlips:AccuracyMetric ;
    rdfs:label "Test-set RMSE on total energy of the 64-water cell (DeePMD vs PBE0+TS DFT)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.028"^^xsd:double ;
    mlips:hasUnit unit:EV .

entity:result-deepmd-water-forces a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-deepmd-water ;
    mlips:targetMaterial entity:mat-water-wang2018 ;
    mlips:hasAccuracyMetric entity:metric-rmse-water-forces .

entity:metric-rmse-water-forces a mlips:AccuracyMetric ;
    rdfs:label "Test-set RMSE on atomic force components (DeePMD vs PBE0+TS DFT)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.024"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

entity:run-deepmd-water mlips:trainingDuration "16 hours" ;
    mlips:trainingHardware "Intel Core i7-3770 CPU with 32 GB RAM, 4 OpenMP threads" .

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-decay-rate-deepmd a mlips:Hyperparameter ;
    rdfs:label "DeePMD learning-rate decay rate" ;
    mlips:hyperparameterName "decay_rate" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-decay-steps-deepmd a mlips:Hyperparameter ;
    rdfs:label "DeePMD learning-rate decay steps" ;
    mlips:hyperparameterName "decay_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-hidden-deepmd a mlips:Hyperparameter ;
    rdfs:label "DeePMD per-atom hidden layer architecture" ;
    mlips:hyperparameterName "hidden_layers" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

# schema:affiliation links added by issue-0005 sweep.
<https://orcid.org/0000-0002-4302-1886> schema:affiliation entity:org-NumericalMethodChina-wang2018dpkit .
<https://orcid.org/0000-0002-4302-1886> schema:affiliation entity:org-InstituteofAppliedPhysicsandComputationalMathematics-wang2018dpkit .
<https://orcid.org/0000-0002-8470-5846> schema:affiliation mlips:PrincetonUniversity .
<https://orcid.org/0000-0002-3553-7313> schema:affiliation mlips:PrincetonUniversity .

entity:org-NumericalMethodChina-wang2018dpkit a schema:Organization ;
    rdfs:label "Numerical Method (China)" ;
    schema:name "Numerical Method (China)" ;
    schema:identifier <https://ror.org/02ns8zp42> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .

entity:org-InstituteofAppliedPhysicsandComputationalMathematics-wang2018dpkit a schema:Organization ;
    rdfs:label "Institute of Applied Physics and Computational Mathematics" ;
    schema:name "Institute of Applied Physics and Computational Mathematics" ;
    schema:identifier <https://ror.org/03sxpbt26> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .
