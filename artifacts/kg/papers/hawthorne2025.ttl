    schema:identifier <https://orcid.org/0000-0002-0022-1319> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-graphene-hawthorne2025 a mlips:MaterialSystem ;
    rdfs:label "Graphene sheets (4-, 8-, 16- and 32-atom AIMD cells; 9,072-atom MD sheet), pristine and strained up to tearing" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "2D material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-lda-hawthorne2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-lda-hawthorne2025 mlips:hasDFTSettings entity:calc-settings-lda-hawthorne2025 .

entity:calc-settings-lda-hawthorne2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-GPAW-hawthorne2025 ;
    mlips:xcFunctional mlips:LDA ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "k-point density of at least 0.05 1/A" ;
    rdfs:comment "Born-Oppenheimer AIMD in GPAW/ASE with 0.5 fs steps (Sec. 2)." .

entity:lib-GPAW-hawthorne2025 a mlips:Library ;
    rdfs:label "GPAW" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aimd-hawthorne2025 a mlips:TrainingDataset ;
    rdfs:label "Graphene AIMD frames (4-32 atoms; NVE, NVT at 300 K, NPT with strain rates 1e-6 to 1e-3 1/fs) plus randomly displaced geometries; 80/20 train/validation split" ;
    mlips:coversMaterial entity:mat-graphene-hawthorne2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1120000 ;
    mlips:hasDFTCalculation entity:calc-lda-hawthorne2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-hawthorne2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-DeePMD-hawthorne2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-DeePMD-hawthorne2025 a mlips:LossFunction ;
    rdfs:label "Energy, force and virial with prefactors ramped from (1e-2, 1, 1e3) to (1, 1e4, 10)" .

entity:impl-DeePMD-hawthorne2025 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-cutoffRadius-hawthorne2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-dp-learningRate-hawthorne2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-hawthorne2025 a mlips:MLIPRun ;
    rdfs:label "Deep Potential (two-body embedding descriptor, rc = 8 A, rs = 0.5 A) for graphene, 1e8 training steps" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-aimd-hawthorne2025 ;
    mlips:hasHyperparameterSetting entity:setting-dp-cutoffRadius-hawthorne2025 ,
        entity:setting-dp-learningRate-hawthorne2025 ;
    mlips:produces entity:model-dp-hawthorne2025 .

entity:model-dp-hawthorne2025 a mlips:TrainedModel ;
    rdfs:label "Graphene Deep Potential (Hawthorne 2025)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

