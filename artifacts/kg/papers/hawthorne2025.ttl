@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-hawthorne2025 a mlips:BenchmarkStudy ;
    rdfs:label "Hawthorne et al. (2025): a Deep Potential MLIP for graphene trained on LDA AIMD, stress-strain and vibrational properties" ;
    mlips:reportedIn entity:article-hawthorne2025 .

entity:article-hawthorne2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpcc.5c03470> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Efficient and Accurate Machine Learning Interatomic Potential for Graphene: Capturing Stress–Strain and Vibrational Properties" ;
    schema:author <https://orcid.org/0000-0002-5578-4987> ,
        <https://orcid.org/0009-0000-8949-1683> ,
        entity:person-Pela-hawthorne2025 ,
        <https://orcid.org/0000-0002-0022-1319> .

<https://orcid.org/0000-0002-5578-4987> a schema:Person ;
    schema:name "Felipe Hawthorne" ;
    schema:givenName "Felipe" ;
    schema:familyName "Hawthorne" ;
    schema:identifier <https://orcid.org/0000-0002-5578-4987> .

<https://orcid.org/0009-0000-8949-1683> a schema:Person ;
    schema:name "Paulo R. E. Raulino" ;
    schema:givenName "Paulo R. E." ;
    schema:familyName "Raulino" ;
    schema:identifier <https://orcid.org/0009-0000-8949-1683> .

entity:person-Pela-hawthorne2025 a schema:Person ;
    schema:name "Ronaldo Rodrigues Pelá" ;
