###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-kovacs2023 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-kovacs2023 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:bodyOrder ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-MACE-kovacs2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-MACE-kovacs2023 a mlips:LossFunction ;
    rdfs:label "Weighted energy/force (and stress) loss with a two-phase scheduler switching to large energy weights; Huber loss for the M3GNet data set" .

entity:alg-MACE-kovacs2023 a mls:Algorithm ;
    rdfs:label "lmax = 3, 8 Bessel radial features, radial MLP [64,64,64], correlation order 3 (4-body messages), AMSGrad, EMA 0.99" .

entity:impl-MACE-kovacs2023 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

