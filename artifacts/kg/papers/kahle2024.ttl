###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-organics-kahle2024 a mlips:MaterialSystem ;
    rdfs:label "Linear alkanes, alkanols (C4-C12) and an adipate (dap), as single molecules and condensed liquids" ;
    mlips:materialClass "Condensed organic liquids" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-revpbe-vdw-kahle2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-revpbe-vdw-kahle2024 mlips:hasDFTSettings entity:calc-settings-revpbe-vdw-kahle2024 .

entity:calc-settings-revpbe-vdw-kahle2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-revPBE-vdW-kahle2024 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "Precision Accurate; functional selected against experimental organic crystal data (SI S.1)." .

entity:xc-revPBE-vdW-kahle2024 a mlips:XCFunctional ;
    rdfs:label "revPBE-vdW" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-final-kahle2024 a mlips:TrainingDataset ;
    rdfs:label "Final training set after 18 active-learning steps and cleaning (2,641 configurations; 2% held out for testing)" ;
    mlips:coversMaterial entity:mat-organics-kahle2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2641 ;
    mlips:hasDFTCalculation entity:calc-revpbe-vdw-kahle2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-final-kahle2024 mlips:samplingStrategy
    entity:sampling-pcff-kahle2024 ,
    entity:sampling-al-kahle2024 .

entity:sampling-pcff-kahle2024 a mlips:SamplingStrategy ;
    rdfs:label "PCFF+ force-field MD of molecular liquids and isolated molecules with random displacements (initial set)" .

entity:sampling-al-kahle2024 a mlips:SamplingStrategy ;
    rdfs:label "Uncertainty-guided exploration with intermediate ACE-MLPs (extrapolation grade gamma), unphysical-bond detection and stretched-bond fragments" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-kahle2024 ;
    mlips:hasTrainingAlgorithm entity:alg-ACE-kahle2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-ACE-kahle2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-ACE-kahle2024 a mlips:LossFunction ;
    rdfs:label "Energy and force loss with kappa = 0.001 and L2 regularisation 1e-8" .

entity:alg-ACE-kahle2024 a mls:Algorithm ;
    rdfs:label "BFGS (maxiter 500); dual descriptor: second C-C pair basis with a long-range cutoff" .

entity:impl-ACE-kahle2024 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ace-dual-cutoffRadius-kahle2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3"^^xsd:double .

entity:setting-ace-dual-batchSize-kahle2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "140"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ace-dual-kahle2024 a mlips:MLIPRun ;
    rdfs:label "Final dual-cutoff ACE-MLP (rc short 3 A, rc long 7 A for C-C, 1,500 functions per element)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-final-kahle2024 ;
    mlips:hasHyperparameterSetting entity:setting-ace-dual-cutoffRadius-kahle2024 ,
        entity:setting-ace-dual-batchSize-kahle2024 ;
    mlips:produces entity:model-ace-dual-kahle2024 .

entity:model-ace-dual-kahle2024 a mlips:TrainedModel ;
    rdfs:label "Dual-cutoff ACE-MLP for organic liquids" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-kahle2024 mlips:hasResult
    entity:result-ace-dual-kahle2024 .

entity:result-ace-dual-kahle2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ace-dual-kahle2024 ;
    mlips:targetMaterial entity:mat-organics-kahle2024 ;
    mlips:hasAccuracyMetric entity:metric-ace-dual-1-kahle2024 ,
        entity:metric-ace-dual-2-kahle2024 .

entity:metric-ace-dual-1-kahle2024 a mlips:AccuracyMetric ;
    rdfs:label "Test potential-energy RMSE: dual-cutoff ACE-MLP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.22"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-ace-dual-2-kahle2024 a mlips:AccuracyMetric ;
    rdfs:label "Test force RMSE: dual-cutoff ACE-MLP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "95.65"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

