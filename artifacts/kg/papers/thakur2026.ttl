# Canonical Turtle for the protocol-derived encoding of:
#   Atul C. Thakur et al. (2026). Dielectric Response of Short and Long Range Models of Nonuniform Liquids and Implications for Machine Learned Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2610.04224  arXiv:2610.04224v1
#
# Version read: arxiv-preprint arXiv:2610.04224v1 (sha256 92f588012f4ee49f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 654 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/thakur2026.yaml.
#
# Encoding scope: the three DeePMD models trained on flexible SPC/E water
# as the reference: DP-Bulk (bulk Ewald configurations), DP-GT-Bulk (bulk
# Gaussian-truncated electrostatics) and DP-Int (confined/interfacial
# Ewald configurations). They are compared through dielectric profiles
# and polarisation of water between walls, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-thakur2026 a mlips:BenchmarkStudy ;
    rdfs:label "Thakur, Dhattarwal and Remsing (2026): dielectric response of short- and long-range models of nonuniform liquids and implications for MLIPs" ;
    mlips:reportedIn entity:article-thakur2026 .

entity:article-thakur2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.04224> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Dielectric Response of Short and Long Range Models of Nonuniform Liquids and Implications for Machine Learned Interatomic Potentials" ;
    schema:author entity:person-Thakur-thakur2026 ,
        entity:person-Dhattarwal-thakur2026 ,
        entity:person-Remsing-thakur2026 .

entity:person-Thakur-thakur2026 a schema:Person ;
    schema:name "Atul C. Thakur" ;
    schema:givenName "Atul C." ;
    schema:familyName "Thakur" .

entity:person-Dhattarwal-thakur2026 a schema:Person ;
    schema:name "Harender S. Dhattarwal" ;
    schema:givenName "Harender S." ;
    schema:familyName "Dhattarwal" .

entity:person-Remsing-thakur2026 a schema:Person ;
    schema:name "Richard C. Remsing" ;
    schema:givenName "Richard C." ;
    schema:familyName "Remsing" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-thakur2026 a mlips:MaterialSystem ;
    rdfs:label "Flexible SPC/E water, bulk and confined between Lennard-Jones walls" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-spce-ewald-thakur2026 a mlips:ReferenceCalculation .

entity:calc-spce-gt-thakur2026 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-spce-ewald-thakur2026 mlips:hasReferenceSettings entity:calc-settings-spce-ewald-thakur2026 .

entity:calc-settings-spce-ewald-thakur2026 a mlips:ReferenceSettings ;
    rdfs:comment "Flexible SPC/E water with Ewald (long-range) electrostatics (LAMMPS)." .

entity:calc-spce-gt-thakur2026 mlips:hasReferenceSettings entity:calc-settings-spce-gt-thakur2026 .

entity:calc-settings-spce-gt-thakur2026 a mlips:ReferenceSettings ;
    rdfs:comment "Flexible SPC/E water with Gaussian-truncated electrostatics (sigma = 4.5 A)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-bulk-ewald-thakur2026 a mlips:TrainingDataset ;
    rdfs:label "Bulk SPC/E Ewald configurations (3200)" ;
    mlips:coversMaterial entity:mat-water-thakur2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 3200 ;
    mlips:hasReferenceCalculation entity:calc-spce-ewald-thakur2026 .

entity:ds-bulk-gt-thakur2026 a mlips:TrainingDataset ;
    rdfs:label "Bulk SPC/E Gaussian-truncated configurations (3200)" ;
    mlips:coversMaterial entity:mat-water-thakur2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 3200 ;
    mlips:hasReferenceCalculation entity:calc-spce-gt-thakur2026 .

entity:ds-conf-ewald-thakur2026 a mlips:TrainingDataset ;
    rdfs:label "Confined SPC/E Ewald configurations (4800)" ;
    mlips:coversMaterial entity:mat-water-thakur2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 4800 ;
    mlips:hasReferenceCalculation entity:calc-spce-ewald-thakur2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-bulk-ewald-thakur2026 mlips:samplingStrategy
    entity:sampling-md-thakur2026 .

entity:ds-bulk-gt-thakur2026 mlips:samplingStrategy
    entity:sampling-md-thakur2026 .

entity:ds-conf-ewald-thakur2026 mlips:samplingStrategy
    entity:sampling-md-thakur2026 .

entity:sampling-md-thakur2026 a mlips:SamplingStrategy ;
    rdfs:label "Configurations from SPC/E MD at 300 K and 2000 K (half each)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-thakur2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-DeePMD-thakur2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-DeePMD-thakur2026 a mls:Algorithm ;
    rdfs:label "se_e2_a descriptor; embedding (25, 50, 100) with axis neurons 16; fitting (240, 240, 240); learning rate 1e-3 to 1e-8 over 1e6 steps" .

entity:impl-DeePMD-thakur2026 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-bulk-cutoffRadius-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dp-bulk-batchSize-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-dp-bulk-learningRate-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-dp-gt-bulk-cutoffRadius-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dp-gt-bulk-batchSize-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-dp-gt-bulk-learningRate-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-dp-int-cutoffRadius-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dp-int-batchSize-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-dp-int-learningRate-thakur2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-bulk-thakur2026 a mlips:MLIPRun ;
    rdfs:label "DP-Bulk (trained on bulk Ewald SPC/E)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-bulk-ewald-thakur2026 ;
    mlips:hasHyperparameterSetting entity:setting-dp-bulk-cutoffRadius-thakur2026 ,
        entity:setting-dp-bulk-batchSize-thakur2026 ,
        entity:setting-dp-bulk-learningRate-thakur2026 ;
    mlips:produces entity:model-dp-bulk-thakur2026 .

entity:model-dp-bulk-thakur2026 a mlips:TrainedModel ;
    rdfs:label "DP-Bulk SPC/E" .

entity:run-dp-gt-bulk-thakur2026 a mlips:MLIPRun ;
    rdfs:label "DP-GT-Bulk (trained on bulk Gaussian-truncated SPC/E)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-bulk-gt-thakur2026 ;
    mlips:hasHyperparameterSetting entity:setting-dp-gt-bulk-cutoffRadius-thakur2026 ,
        entity:setting-dp-gt-bulk-batchSize-thakur2026 ,
        entity:setting-dp-gt-bulk-learningRate-thakur2026 ;
    mlips:produces entity:model-dp-gt-bulk-thakur2026 .

entity:model-dp-gt-bulk-thakur2026 a mlips:TrainedModel ;
    rdfs:label "DP-GT-Bulk SPC/E" .

entity:run-dp-int-thakur2026 a mlips:MLIPRun ;
    rdfs:label "DP-Int (trained on confined Ewald SPC/E)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-conf-ewald-thakur2026 ;
    mlips:hasHyperparameterSetting entity:setting-dp-int-cutoffRadius-thakur2026 ,
        entity:setting-dp-int-batchSize-thakur2026 ,
        entity:setting-dp-int-learningRate-thakur2026 ;
    mlips:produces entity:model-dp-int-thakur2026 .

entity:model-dp-int-thakur2026 a mlips:TrainedModel ;
    rdfs:label "DP-Int SPC/E" .

