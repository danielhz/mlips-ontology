entity:mat-nacl-pellegrini2023 a mlips:MaterialSystem ;
    rdfs:label "Charged sodium chloride clusters Na9Cl8+ and Na8Cl8+" ;
    mlips:materialClass "Metal cluster" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-rmd17ref-pellegrini2023 a mlips:DFTCalculation .

entity:calc-carbonref-pellegrini2023 a mlips:DFTCalculation .

entity:calc-naclref-pellegrini2023 a mlips:DFTCalculation .

entity:calc-macelabels-pellegrini2023 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-rmd17ref-pellegrini2023 mlips:hasDFTSettings entity:calc-settings-rmd17ref-pellegrini2023 .

entity:calc-settings-rmd17ref-pellegrini2023 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    mlips:basisSet "def2-SVP" ;
    rdfs:comment "rMD17 labels (Ref. 47)" .

entity:calc-carbonref-pellegrini2023 mlips:hasDFTSettings entity:calc-settings-carbonref-pellegrini2023 .

entity:calc-settings-carbonref-pellegrini2023 a mlips:DFTSettings ;
    rdfs:comment "Carbon dataset of Ref. 9 (evolutionary search with an earlier PANNA version); level of theory not restated here" .

entity:calc-naclref-pellegrini2023 mlips:hasDFTSettings entity:calc-settings-naclref-pellegrini2023 .

entity:calc-settings-naclref-pellegrini2023 a mlips:DFTSettings ;
    rdfs:comment "NaCl cluster data of Ref. 44" .

entity:calc-macelabels-pellegrini2023 mlips:hasReferenceSettings entity:calc-settings-macelabels-pellegrini2023 .

entity:calc-settings-macelabels-pellegrini2023 a mlips:ReferenceSettings ;
    mlips:usedReferenceCode mlips:MLIP ;
    rdfs:comment "Energies and forces from the best MACE model on 10 Gaussian-perturbed copies (sigma 0.075 A) of each training configuration" .

