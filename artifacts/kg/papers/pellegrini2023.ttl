# Canonical Turtle for the protocol-derived encoding of:
#   Franco Pellegrini et al. (2023). PANNA 2.0: Efficient neural network interatomic potentials and new architectures.
#   The Journal of Chemical Physics. doi:10.1063/5.0158075  arXiv:2305.11805v1
#
# Version read: arxiv-preprint arXiv:2305.11805v1 (sha256 f83ec49bac0b03d1...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 466 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/pellegrini2023.yaml.
#
# Encoding scope: PANNA modified Behler-Parrinello (mBP) networks on
# rMD17 (1,000 configurations per molecule; Table I validation MAEs), on
# a 60,000-configuration carbon dataset (three PANNA sizes against
# NequIP and MACE, errors figure-only; MD timings of Table II; a PANNA
# model distilled from MACE labels) and on charged Na9Cl8+/Na8Cl8+
# clusters (short-range PANNA and the long-range PANNA model with and
# without charge targets; Table III). ANI, SOTA and 2G/4G-HDNNP values
# are quoted from the literature and not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-pellegrini2023 a mlips:BenchmarkStudy ;
    rdfs:label "Pellegrini et al. (2023): PANNA 2.0, Behler-Parrinello-type networks with modified descriptors, long-range electrostatics, and benchmarks on rMD17, carbon and charged NaCl clusters" ;
    mlips:reportedIn entity:article-pellegrini2023 .

entity:article-pellegrini2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0158075> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "PANNA 2.0: Efficient neural network interatomic potentials and new architectures" ;
    schema:author <https://orcid.org/0000-0002-9084-8480> ,
        <https://orcid.org/0000-0001-5950-1270> ,
        <https://orcid.org/0000-0001-9378-3910> ,
        <https://orcid.org/0000-0002-0588-7750> .

<https://orcid.org/0000-0002-9084-8480> a schema:Person ;
    schema:name "Franco Pellegrini" ;
    schema:givenName "Franco" ;
    schema:familyName "Pellegrini" ;
    schema:identifier <https://orcid.org/0000-0002-9084-8480> .

<https://orcid.org/0000-0001-5950-1270> a schema:Person ;
    schema:name "Ruggero Lot" ;
    schema:givenName "Ruggero" ;
    schema:familyName "Lot" ;
    schema:identifier <https://orcid.org/0000-0001-5950-1270> .

<https://orcid.org/0000-0001-9378-3910> a schema:Person ;
    schema:name "Yusuf Shaidu" ;
    schema:givenName "Yusuf" ;
    schema:familyName "Shaidu" ;
    schema:identifier <https://orcid.org/0000-0001-9378-3910> .

<https://orcid.org/0000-0002-0588-7750> a schema:Person ;
    schema:name "Emine Küçükbenli" ;
    schema:givenName "Emine" ;
    schema:familyName "Küçükbenli" ;
    schema:identifier <https://orcid.org/0000-0002-0588-7750> .

