###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-r-aspirin-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-azobenzene-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-benzene-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-ethanol-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-malonaldehyde-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-naphthalene-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-paracetamol-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-salicylic-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-toluene-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-r-uracil-pellegrini2023 mlips:samplingStrategy
    entity:sampling-rand-pellegrini2023 .

entity:ds-carbon-pellegrini2023 mlips:samplingStrategy
    entity:sampling-fps-pellegrini2023 .

entity:ds-carbon-kd-pellegrini2023 mlips:samplingStrategy
    entity:sampling-perturb-pellegrini2023 .

entity:ds-nacl-pellegrini2023 mlips:samplingStrategy
    entity:sampling-pub-pellegrini2023 .

entity:sampling-rand-pellegrini2023 a mlips:SamplingStrategy ;
    rdfs:label "1,000 random configurations per molecule (rMD17 budget)" .

entity:sampling-fps-pellegrini2023 a mlips:SamplingStrategy ;
    rdfs:label "Farthest-point selection by cosine fingerprint distance from the 50,000-configuration training split" .

entity:sampling-perturb-pellegrini2023 a mlips:SamplingStrategy ;
    rdfs:label "Gaussian perturbation of atomic positions (sigma 0.075 A), 10 copies per configuration" .

entity:sampling-pub-pellegrini2023 a mlips:SamplingStrategy ;
    rdfs:label "Published cluster data of Ref. 44" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-pellegrini2023 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-pellegrini2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-HDNNP-pellegrini2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-pellegrini2023 a mlips:LossFunction ;
    rdfs:label "Quadratic energy and force loss (force cost 1 on rMD17), L1 regularization 1e-5 on rMD17" .

entity:alg-HDNNP-pellegrini2023 a mls:Algorithm ;
    rdfs:label "Adam; learning rate 1e-4, then quenched to 1e-6" .

entity:impl-HDNNP-pellegrini2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PANNA-pellegrini2023 .

entity:PANNA-LR a mlips:MLIPMethod ;
    rdfs:label "Long-range neural-network potential with variational charge equilibration from short-range ingredients (PANNA long-range model)" ;
    mlips:hasLossFunction entity:loss-PANNA-LR-pellegrini2023 ;
    mlips:hasHyperparameter mlips:numLayers ;
    mlips:hasImplementation entity:impl-PANNA-LR-pellegrini2023 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-PANNA-LR-pellegrini2023 a mlips:LossFunction ;
    rdfs:label "Energy and force loss, optionally charge loss (gamma_q)" .

entity:impl-PANNA-LR-pellegrini2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PANNA-pellegrini2023 .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-NequIP-pellegrini2023 .

entity:impl-NequIP-pellegrini2023 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-pellegrini2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-MACE-pellegrini2023 .

entity:loss-MACE-pellegrini2023 a mlips:LossFunction ;
    rdfs:label "MACE default schedule with SWA and energy re-weighting in the last 20%" .

entity:impl-MACE-pellegrini2023 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:lib-PANNA-pellegrini2023 a mlips:Library ;
    rdfs:label "PANNA" ;
    mlips:candidateForVocabulary mlips:Library .

