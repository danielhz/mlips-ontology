<https://orcid.org/0000-0002-0638-539X> schema:affiliation mlips:RobertBoschUnitedStates .
<https://orcid.org/0000-0002-0638-539X> schema:affiliation entity:org-RobertBoschSlovenia-musaelian2023allegro .

entity:org-RobertBoschSlovenia-musaelian2023allegro a schema:Organization ;
    rdfs:label "Robert Bosch (Slovenia)" ;
    schema:name "Robert Bosch (Slovenia)" ;
    schema:identifier <https://ror.org/03248dr08> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .
