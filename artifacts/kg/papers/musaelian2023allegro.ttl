# Canonical Turtle for the protocol-derived encoding of:
#   Musaelian, Batzner, Johansson, Sun, Owen, Kornbluth, Kozinsky.
#   Learning Local Equivariant Representations for Large-Scale
#   Atomistic Dynamics. Nature Communications 14, 579 (2023).
#   doi:10.1038/s41467-023-36329-y  arXiv:2204.05249
#
# Encoding scope: Allegro applied to the Li_3PO_4 amorphous phosphate
# electrolyte (the headline materials/MD application) is taken as the
# canonical pass. The paper also reports Allegro runs on revised MD17
# small organic molecules, the QM9 quantum-chemical-properties set,
# the 3BPA temperature-transferability benchmark, and Ag bulk crystal
# scaling experiments; these auxiliary applications are documented
# as gaps in Q12.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-musaelian2023allegro a mlips:BenchmarkStudy ;
    rdfs:label "Musaelian et al. (2023): Allegro strictly local equivariant MLIP on Li3PO4" ;
    mlips:reportedIn entity:article-musaelian2023allegro .

entity:article-musaelian2023allegro a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41467-023-36329-y> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Learning Local Equivariant Representations for Large-Scale Atomistic Dynamics" ;
    schema:author
        <https://orcid.org/0000-0003-0475-9236> ,
        <https://orcid.org/0000-0002-8826-2712> ,
        <https://orcid.org/0000-0002-0544-7202> ,
        <https://orcid.org/0000-0002-7971-5222> ,
        <https://orcid.org/0000-0002-2543-7415> ,
        <https://orcid.org/0000-0001-6705-8133> ,
        <https://orcid.org/0000-0002-0638-539X> .

<https://orcid.org/0000-0002-8826-2712> a schema:Person ;
    schema:name "Simon Batzner" ;
    schema:givenName "Simon" ;
    schema:familyName "Batzner" ;
    schema:identifier <https://orcid.org/0000-0002-8826-2712> .

<https://orcid.org/0000-0002-0544-7202> a schema:Person ;
    schema:name "Anders Johansson" ;
    schema:givenName "Anders" ;
    schema:familyName "Johansson" ;
    schema:identifier <https://orcid.org/0000-0002-0544-7202> .

<https://orcid.org/0000-0002-2543-7415> a schema:Person ;
    schema:name "Cameron J. Owen" ;
    schema:givenName "Cameron J." ;
    schema:familyName "Owen" ;
    schema:identifier <https://orcid.org/0000-0002-2543-7415> .

<https://orcid.org/0000-0001-6705-8133> a schema:Person ;
    schema:name "Mordechai Kornbluth" ;
    schema:givenName "Mordechai" ;
    schema:familyName "Kornbluth" ;
    schema:identifier <https://orcid.org/0000-0001-6705-8133> .

<https://orcid.org/0000-0002-0638-539X> a schema:Person ;
    schema:name "Boris Kozinsky" ;
    schema:givenName "Boris" ;
    schema:familyName "Kozinsky" ;
    schema:identifier <https://orcid.org/0000-0002-0638-539X> .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Li3PO4 a mlips:MaterialSystem ;
    rdfs:label "Li3PO4 amorphous phosphate solid electrolyte (192-atom cell)" ;
    mlips:chemicalFormula "Li3PO4" ;
    mlips:materialClass "Amorphous Li-ion solid electrolyte (melt-quench, 50 ps melt at 3000 K then quench to 600 K)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q426354> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-musaelian2023allegro a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-musaelian2023allegro mlips:hasDFTSettings entity:dft-settings-musaelian2023allegro .

entity:dft-settings-musaelian2023allegro a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "Gamma-point only" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Li3PO4 a mlips:TrainingDataset ;
    rdfs:label "Li3PO4 melt + quench AIMD training set (10000 train + 1000 validation, sampled from a 50000-frame combined melt+quench AIMD trajectory)" ;
    mlips:coversMaterial entity:mat-Li3PO4 ;
    mlips:coversProperty mlips:Energy , mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10000 ;
    mlips:hasDFTCalculation entity:dft-musaelian2023allegro .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Li3PO4 mlips:samplingStrategy entity:meltquench-sampling-musaelian2023allegro .

entity:meltquench-sampling-musaelian2023allegro a mlips:SamplingStrategy ;
    rdfs:label "AIMD melt-quench sampling (NVT, 2 fs time step, Nose-Hoover thermostat)" ;
    rdfs:comment "50 ps AIMD at T=3000 K in the melted state, instantly quenched to T=600 K, then 50 ps at T=600 K. Train+validation sampled randomly from the combined 50000-frame trajectory." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasFunctionalForm entity:allegro-functional-form ;
    mlips:hasLossFunction entity:allegro-loss ;
    mlips:hasTrainingAlgorithm entity:adam-allegro ;
    mlips:hasHyperparameter mlips:cutoffRadius , mlips:numLayers , mlips:numAngularBasis , mlips:numFeatures , entity:hp-numbasis ;
    mlips:hasImplementation entity:allegro-impl .

entity:allegro-functional-form a mlips:FunctionalForm ;
    rdfs:label "Strictly local equivariant tensor-product network on per-pair latent spaces (scalar + equivariant), no inter-atom message passing; pairwise energies E_ij summed over neighbours to give per-atom energies" .

entity:allegro-loss a mlips:LossFunction ;
    rdfs:label "Weighted MSE on energies (per-atom) and force components (lambda_E = 1, lambda_F = 1 after per-atom normalisation; lambda_E = 1, lambda_F = 1000 raw for revMD17)" .

entity:adam-allegro a mls:Algorithm ;
    rdfs:label "Adam, beta1=0.9, beta2=0.999, eps=1e-8, no weight decay" .

entity:allegro-impl a mlips:Implementation ;
    mlips:implementedIn mlips:Allegro .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-allegro a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-numlayers-allegro a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-lmax-allegro a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-features-allegro a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-numbasis-allegro a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-numbasis ;
    mlips:settingValue "8"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-allegro-Li3PO4 a mlips:MLIPRun ;
    rdfs:label "Allegro training run on Li3PO4 melt+quench (3 layers, lmax=3, 128 features)" ;
    mlips:appliesMethod entity:Allegro ;
    mlips:runsOn entity:ds-Li3PO4 ;
    mlips:hasHyperparameterSetting entity:setting-rcut-allegro , entity:setting-numlayers-allegro , entity:setting-lmax-allegro , entity:setting-features-allegro , entity:setting-numbasis-allegro ;
    mlips:produces entity:model-allegro-Li3PO4 .

entity:model-allegro-Li3PO4 a mlips:TrainedModel ;
    rdfs:label "Allegro Li3PO4 model (3 layers, lmax=3, 128 features)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-musaelian2023allegro mlips:hasResult entity:result-allegro-Li3PO4-energy , entity:result-allegro-Li3PO4-forces .

entity:result-allegro-Li3PO4-energy a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-allegro-Li3PO4 ;
    mlips:targetMaterial entity:mat-Li3PO4 ;
    mlips:hasAccuracyMetric entity:metric-mae-Li3PO4-energy .

entity:metric-mae-Li3PO4-energy a mlips:AccuracyMetric ;
    rdfs:label "MAE on Li3PO4 quenched-state energies" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.7"^^xsd:double ;
    mlips:hasUnit unit:MeV-PER-ATOM .

entity:result-allegro-Li3PO4-forces a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-allegro-Li3PO4 ;
    mlips:targetMaterial entity:mat-Li3PO4 ;
    mlips:hasAccuracyMetric entity:metric-mae-Li3PO4-forces .

entity:metric-mae-Li3PO4-forces a mlips:AccuracyMetric ;
    rdfs:label "MAE on Li3PO4 quenched-state force components" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "75.7"^^xsd:double ;
    mlips:hasUnit unit:MilliEV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

entity:run-allegro-Li3PO4 mlips:trainingHardware "NVIDIA V100 GPU (single-GPU training)" .

entity:model-allegro-Li3PO4 mlips:inferenceTimePerAtom "0.013 microseconds per atom per MD step on 128 NVIDIA A100 GPUs (50.3M-atom Li3PO4 system, LAMMPS pair_allegro at float32)" ;
    mlips:inferenceHardware "NVIDIA DGX A100 cluster (Theta-GPU, ALCF), 128 A100 GPUs across 16 nodes" .

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-numbasis a mlips:Hyperparameter ;
    rdfs:label "Allegro tensor-product basis count" ;
    mlips:hyperparameterName "num_basis_functions" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

