entity:ds-md17-uracil-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "MD17 uracil training set (950 structures)" ;
    mlips:coversMaterial entity:mat-uracil-schutt2021 ;
    mlips:coversProperty mlips:Energy ,
