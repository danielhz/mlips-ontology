###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-painn-qm9-U0-schutt2021 a mlips:MLIPRun ;
    rdfs:label "PaiNN trained on the QM9 U0 target" ;
    mlips:appliesMethod entity:PaiNN ;
    mlips:runsOn entity:ds-qm9-schutt2021 ;
    mlips:hasHyperparameterSetting entity:setting-painn-qm9-U0-cutoffRadius-schutt2021 ,
        entity:setting-painn-qm9-U0-numFeatures-schutt2021 ,
