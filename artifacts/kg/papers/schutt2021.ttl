    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 950 ;
    rdfs:comment "1k known structures: 950 training, 50 validation; three random splits." .

entity:ds-spectra-aspirin-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "Aspirin configurations from MD17 recomputed at PBE0/def2-TZVP (20,000)" ;
    mlips:coversMaterial entity:mat-aspirin-schutt2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 20000 ;
    mlips:hasDFTCalculation entity:calc-aspirin-pbe0-schutt2021 ;
    rdfs:comment "Also dipole moments and polarisabilities for IR and Raman spectra." .

entity:ds-spectra-ethanol-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "Ethanol reference data with dipoles and polarisabilities (Ref. [38])" ;
    mlips:coversMaterial entity:mat-ethanol-schutt2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-ethanol-pbe0-schutt2021 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:hasLossFunction entity:loss-PaiNN-schutt2021 ;
    mlips:hasTrainingAlgorithm entity:alg-PaiNN-schutt2021 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-PaiNN-schutt2021 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-PaiNN-schutt2021 a mlips:LossFunction ;
    rdfs:label "Squared loss on energies and/or forces (force weight rho = 0.95 for the combined MD17 models); MAE loss for the QM9 polarisability" .

entity:alg-PaiNN-schutt2021 a mls:Algorithm ;
    rdfs:label "Adam with weight decay, learning rate halved on validation plateau (smoothed validation loss), early stopping" .

entity:impl-PaiNN-schutt2021 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SchNetPack-schutt2021 .

entity:lib-SchNetPack-schutt2021 a mlips:Library ;
    rdfs:label "SchNetPack" ;
    rdfs:comment "PaiNN implemented in PyTorch and SchNetPack; MD and RPMD with the SchNetPack MD module" ;
    mlips:candidateForVocabulary mlips:Library .

