# Canonical Turtle for the protocol-derived encoding of:
#   Kristof T. Schütt et al. (2021). Equivariant message passing for the prediction of tensorial properties and molecular spectra.
#   arXiv (Cornell University). doi:10.48550/arxiv.2102.03150  arXiv:2102.03150v4
#
# Version read: arxiv-preprint arXiv:2102.03150v4 (sha256 6dfa7b5add4dc8c5...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 212 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/schutt2021.yaml.
#
# Encoding scope: PaiNN (introduced here) with its QM9 U0 error (Table II)
# and MD17 energy and force MAEs for models trained on forces only and on
# energies and forces (Table III); the spectra models for ethanol and
# aspirin (errors only in the Fig. 5 inset). Other QM9 targets, the
# ablation (Table IV), the ferrocene study and values quoted from other
# papers are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-schutt2021 a mlips:BenchmarkStudy ;
    rdfs:label "Schütt, Unke and Gastegger (2021): polarizable atom interaction neural network (PaiNN)" ;
    mlips:reportedIn entity:article-schutt2021 .

entity:article-schutt2021 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2102.03150> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "Equivariant message passing for the prediction of tensorial properties and molecular spectra" ;
    schema:author entity:person-Schutt-schutt2021 ,
        entity:person-Unke-schutt2021 ,
        entity:person-Gastegger-schutt2021 .

entity:person-Schutt-schutt2021 a schema:Person ;
    schema:name "Kristof T. Schütt" ;
    schema:givenName "Kristof T." ;
    schema:familyName "Schütt" .

entity:person-Unke-schutt2021 a schema:Person ;
    schema:name "Oliver T. Unke" ;
    schema:givenName "Oliver T." ;
    schema:familyName "Unke" .

entity:person-Gastegger-schutt2021 a schema:Person ;
    schema:name "Michael Gastegger" ;
    schema:givenName "Michael" ;
    schema:familyName "Gastegger" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-qm9-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules with up to nine heavy atoms (QM9)" ;
    mlips:materialClass "Small organic molecules (equilibrium geometries)" .

entity:mat-aspirin-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-ethanol-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-malondialdehyde-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Malondialdehyde molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-naphthalene-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Naphthalene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-salicylic-acid-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-toluene-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-uracil-schutt2021 a mlips:MaterialSystem ;
    rdfs:label "Uracil molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-aspirin-pbe0-schutt2021 a mlips:DFTCalculation .

entity:calc-ethanol-pbe0-schutt2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-aspirin-pbe0-schutt2021 mlips:hasDFTSettings entity:calc-settings-aspirin-pbe0-schutt2021 .

entity:calc-settings-aspirin-pbe0-schutt2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional mlips:PBE0 ;
    mlips:basisSet "def2-TZVP" ;
    rdfs:comment "Tight SCF, grid levels 4 and 5, RIJK approximation; 20,000 MD17 aspirin configurations recomputed (App. A 2)." .

entity:calc-ethanol-pbe0-schutt2021 mlips:hasDFTSettings entity:calc-settings-ethanol-pbe0-schutt2021 .

entity:calc-settings-ethanol-pbe0-schutt2021 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE0 ;
    mlips:basisSet "def2-TZVP" ;
    rdfs:comment "Ethanol reference data of Ref. [38], same level without RIJK." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-qm9-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "QM9 training set (110k molecules)" ;
    mlips:coversMaterial entity:mat-qm9-schutt2021 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 110000 ;
    rdfs:comment "10k validation; three random splits." .

entity:ds-md17-aspirin-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "MD17 aspirin training set (950 structures)" ;
    mlips:coversMaterial entity:mat-aspirin-schutt2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 950 ;
    rdfs:comment "1k known structures: 950 training, 50 validation; three random splits." .

entity:ds-md17-ethanol-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "MD17 ethanol training set (950 structures)" ;
    mlips:coversMaterial entity:mat-ethanol-schutt2021 ;
    mlips:coversProperty mlips:Energy ,
