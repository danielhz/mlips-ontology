    rdfs:comment "1k known structures: 950 training, 50 validation; three random splits." .

entity:ds-md17-salicylic-acid-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "MD17 salicylic acid training set (950 structures)" ;
    mlips:coversMaterial entity:mat-salicylic-acid-schutt2021 ;
    mlips:coversProperty mlips:Energy ,
