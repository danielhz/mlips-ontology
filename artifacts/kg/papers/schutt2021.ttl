    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 950 ;
    rdfs:comment "1k known structures: 950 training, 50 validation; three random splits." .

entity:ds-md17-toluene-schutt2021 a mlips:TrainingDataset ;
    rdfs:label "MD17 toluene training set (950 structures)" ;
    mlips:coversMaterial entity:mat-toluene-schutt2021 ;
    mlips:coversProperty mlips:Energy ,
