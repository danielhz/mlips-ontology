# Canonical Turtle for the protocol-derived encoding of:
#   Hui Xu et al. (2023). High-Accuracy Neural Network Interatomic Potential for Silicon Nitride.
#   Nanomaterials. doi:10.3390/nano13081352
#
# Version read: publisher (sha256 0d15d621b48a84e2...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 667 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/xu2023.yaml.
#
# Encoding scope: the DeePMD (DeepPot-SE) model for Si3N4 trained on AIMD
# data at 2000 K and 3000 K and used for SiNx melt-quench simulations.
# Energy and force RMSE and R2 values appear only in the parity plots, so
# there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-xu2023 a mlips:BenchmarkStudy ;
    rdfs:label "Xu et al. (2023): a Deep Potential for silicon nitride" ;
    mlips:reportedIn entity:article-xu2023 .

entity:article-xu2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.3390/nano13081352> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "High-Accuracy Neural Network Interatomic Potential for Silicon Nitride" ;
    schema:author <https://orcid.org/0000-0001-5326-5094> ,
        entity:person-Li-xu2023 ,
        entity:person-Zhang-xu2023 ,
        entity:person-Liu-xu2023 ,
        entity:person-Shen-xu2023 ,
        entity:person-Guo-xu2023 .

<https://orcid.org/0000-0001-5326-5094> a schema:Person ;
    schema:name "Hui Xu" ;
    schema:givenName "Hui" ;
    schema:familyName "Xu" ;
    schema:identifier <https://orcid.org/0000-0001-5326-5094> .

entity:person-Li-xu2023 a schema:Person ;
    schema:name "Zeyuan Li" ;
    schema:givenName "Zeyuan" ;
    schema:familyName "Li" .

entity:person-Zhang-xu2023 a schema:Person ;
    schema:name "Zhaofu Zhang" ;
    schema:givenName "Zhaofu" ;
    schema:familyName "Zhang" .

entity:person-Liu-xu2023 a schema:Person ;
    schema:name "Sheng Liu" ;
    schema:givenName "Sheng" ;
    schema:familyName "Liu" .

entity:person-Shen-xu2023 a schema:Person ;
    schema:name "Shengnan Shen" ;
    schema:givenName "Shengnan" ;
    schema:familyName "Shen" .

entity:person-Guo-xu2023 a schema:Person ;
    schema:name "Yuzheng Guo" ;
    schema:givenName "Yuzheng" ;
    schema:familyName "Guo" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sin-xu2023 a mlips:MaterialSystem ;
    rdfs:label "Amorphous and liquid Si3N4 (112-atom cells) and SiNx compositions" ;
    mlips:materialClass "nitride ceramic" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-xu2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-xu2023 mlips:hasDFTSettings entity:calc-settings-pbe-xu2023 .

entity:calc-settings-pbe-xu2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred, k-spacing 0.4 1/A" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-sin-xu2023 a mlips:TrainingDataset ;
    rdfs:label "Si3N4 AIMD frames at 2000 K and 3000 K (10,000 per temperature; four of five sets for training)" ;
    mlips:coversMaterial entity:mat-sin-xu2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-xu2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-sin-xu2023 mlips:samplingStrategy
    entity:sampling-aimd-xu2023 .

entity:sampling-aimd-xu2023 a mlips:SamplingStrategy ;
    rdfs:label "NVT AIMD of randomly packed 112-atom Si3N4 at 2000 K and 3000 K (10,000 steps of 1 fs each)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-xu2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-DeePMD-xu2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-DeePMD-xu2023 a mls:Algorithm ;
    rdfs:label "DeepPot-SE (se_a) with smoothing from 5.8 A; embedding layers 25, 50, 100; learning rate 1e-3 decaying by 0.95 every 5000 steps; 2000 K and 3000 K data combined" .

entity:impl-DeePMD-xu2023 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-cutoffRadius-xu2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-dp-learningRate-xu2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-dp-xu2023 a mlips:MLIPRun ;
    rdfs:label "DP model for silicon nitride (2000 K + 3000 K data)" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-sin-xu2023 ;
    mlips:hasHyperparameterSetting entity:setting-dp-cutoffRadius-xu2023 ,
        entity:setting-dp-learningRate-xu2023 ;
    mlips:produces entity:model-dp-xu2023 .

entity:model-dp-xu2023 a mlips:TrainedModel ;
    rdfs:label "DP Si3N4" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

