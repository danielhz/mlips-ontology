# Canonical Turtle for the protocol-derived encoding of:
#   Tobias Kreiman et al. (2025). Understanding and mitigating distribution shifts for universal machine learning interatomic potentials.
#   Digital Discovery. doi:10.1039/d5dd00260e  arXiv:2503.08674v2
#
# Version read: arxiv-preprint arXiv:2503.08674v2 (sha256 3c590ab8cdd44506...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 139 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the models the paper trains for its two largest
# benchmarks and their baseline errors: a GemNet-T model trained on SPICE
# and tested on new SPICEv2 molecules, and GemNet-OC models (plain and
# jointly trained with an EMT prior) on the OC20 out-of-distribution
# split. The paper's contribution, test-time radius refinement (RR) and
# test-time training (TTT), changes a model at inference; those results
# are given in comments. Read from the arXiv preprint (v2).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kreiman2025 a mlips:BenchmarkStudy ;
    rdfs:label "Kreiman and Krishnapriyan (2025): distribution shifts for machine learning force fields and test-time refinement" ;
    mlips:reportedIn entity:article-kreiman2025 .

entity:article-kreiman2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/d5dd00260e> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Understanding and mitigating distribution shifts for universal machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0009-0002-1142-5744> ,
        entity:person-Krishnapriyan-kreiman2025 .

<https://orcid.org/0009-0002-1142-5744> a schema:Person ;
    schema:name "Tobias Kreiman" ;
    schema:givenName "Tobias" ;
    schema:familyName "Kreiman" ;
    schema:identifier <https://orcid.org/0009-0002-1142-5744> .

entity:person-Krishnapriyan-kreiman2025 a schema:Person ;
    schema:name "Aditi S. Krishnapriyan" ;
    schema:givenName "Aditi S." ;
    schema:familyName "Krishnapriyan" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-spicev2-kreiman2025 a mlips:MaterialSystem ;
    rdfs:label "10k new organic molecules from SPICEv2 (not in SPICE)" ;
    mlips:materialClass "Organic molecules" .

entity:mat-spice-kreiman2025 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules of SPICE (the MACE-OFF training subset)" ;
    mlips:materialClass "Organic molecules" .

entity:mat-oc20-kreiman2025 a mlips:MaterialSystem ;
    rdfs:label "Adsorbate-catalyst structures of Open Catalyst 2020" ;
    mlips:materialClass "Adsorbate-surface systems" .

###############################################################################
