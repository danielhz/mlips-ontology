# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-spice-kreiman2025 a mlips:TrainingDataset ;
    rdfs:label "SPICE, the 951k samples used to train MACE-OFF" ;
    mlips:coversMaterial entity:mat-spice-kreiman2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 951000 ;
    rdfs:comment "Size as stated ('951k samples')." .

entity:ds-oc20-600k-kreiman2025 a mlips:TrainingDataset ;
    rdfs:label "600 thousand examples of the OC20 20M split with elements supported by the EMT prior" ;
    mlips:coversMaterial entity:mat-oc20-kreiman2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 600000 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-spice-kreiman2025 mlips:samplingStrategy
    entity:sampling-published-kreiman2025 .

entity:ds-oc20-600k-kreiman2025 mlips:samplingStrategy
    entity:sampling-published-kreiman2025 .

entity:sampling-published-kreiman2025 a mlips:SamplingStrategy ;
    rdfs:label "Published data set used as provided" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GemNet a mlips:MLIPMethod ;
    rdfs:label "GemNet (geometric message passing neural network)" ;
    mlips:hasFunctionalForm entity:ff-GemNet ;
    mlips:hasTrainingAlgorithm entity:alg-GemNet-kreiman2025 ;
    mlips:hasHyperparameter mlips:numEpochs ,
        entity:hp-atom-embedding-kreiman2025 ,
        entity:hp-rbf-embedding-kreiman2025 .

entity:ff-GemNet a mlips:FunctionalForm ;
    rdfs:label "Directional graph neural network with geometric message passing over atom triplets and, in the two-hop form, quadruplets, built on spherical representations; energies are sums of atomic contributions and forces are obtained by backpropagation or, in the direct variants, predicted directly" .

entity:alg-GemNet-kreiman2025 a mls:Algorithm ;
    rdfs:label "Pre-training with a cheap prior (sGDML, GFN2-xTB or EMT labels), freezing and fine-tuning; at test time the representation is updated on the prior's labels (SGD, learning rate 1e-4, momentum 0.9, weight decay 0.001, 250 steps on the SPICEv2 benchmark)" .

entity:hp-atom-embedding-kreiman2025 a mlips:Hyperparameter ;
    rdfs:label "Atom embedding size" ;
    mlips:hyperparameterName "atom_embedding_size" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-rbf-embedding-kreiman2025 a mlips:Hyperparameter ;
    rdfs:label "RBF embedding size" ;
    mlips:hyperparameterName "rbf_embedding_size" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gemnet-t-spice-numEpochs-kreiman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "250"^^xsd:integer .

entity:setting-gemnet-t-spice-atom-embedding-kreiman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-atom-embedding-kreiman2025 ;
    mlips:settingValue "256"^^xsd:integer .

entity:setting-gemnet-t-spice-rbf-embedding-kreiman2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-rbf-embedding-kreiman2025 ;
    mlips:settingValue "32"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-gemnet-t-spice-kreiman2025 a mlips:MLIPRun ;
    rdfs:label "GemNet-T trained on SPICE (about 4M parameters)" ;
    mlips:appliesMethod entity:GemNet ;
    mlips:runsOn entity:ds-spice-kreiman2025 ;
    mlips:hasHyperparameterSetting entity:setting-gemnet-t-spice-numEpochs-kreiman2025 ,
        entity:setting-gemnet-t-spice-atom-embedding-kreiman2025 ,
        entity:setting-gemnet-t-spice-rbf-embedding-kreiman2025 ;
    mlips:produces entity:model-gemnet-t-spice-kreiman2025 .

entity:model-gemnet-t-spice-kreiman2025 a mlips:TrainedModel ;
    rdfs:label "GemNet-T trained on SPICE" .

entity:run-gemnet-oc-kreiman2025 a mlips:MLIPRun ;
    rdfs:label "GemNet-OC trained on 600k OC20 examples" ;
    mlips:appliesMethod entity:GemNet ;
    mlips:runsOn entity:ds-oc20-600k-kreiman2025 ;
    mlips:produces entity:model-gemnet-oc-kreiman2025 .

entity:model-gemnet-oc-kreiman2025 a mlips:TrainedModel ;
    rdfs:label "GemNet-OC (baseline)" .

entity:run-gemnet-oc-joint-kreiman2025 a mlips:MLIPRun ;
    rdfs:label "GemNet-OC jointly trained with the EMT prior on 600k OC20 examples" ;
    mlips:appliesMethod entity:GemNet ;
    mlips:runsOn entity:ds-oc20-600k-kreiman2025 ;
    mlips:produces entity:model-gemnet-oc-joint-kreiman2025 .

entity:model-gemnet-oc-joint-kreiman2025 a mlips:TrainedModel ;
    rdfs:label "GemNet-OC (joint training)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-kreiman2025 mlips:hasResult
    entity:result-gemnet-t-spicev2-kreiman2025 ,
    entity:result-gemnet-oc-ood-kreiman2025 ,
    entity:result-gemnet-oc-joint-ood-kreiman2025 .

entity:result-gemnet-t-spicev2-kreiman2025 a mlips:BenchmarkResult ;
    rdfs:comment "With test-time training (sGDML prior) the same benchmark gives 19.9 +/- 1.0 meV/A. For comparison the paper evaluates MACE-OFF at 26.75 +/- 0.65 meV/A (26.0 +/- 0.64 with radius refinement)." ;
    mlips:evaluatesModel entity:model-gemnet-t-spice-kreiman2025 ;
    mlips:targetMaterial entity:mat-spicev2-kreiman2025 ;
    mlips:hasAccuracyMetric entity:metric-gemnet-t-spicev2-1-kreiman2025 .

entity:metric-gemnet-t-spicev2-1-kreiman2025 a mlips:AccuracyMetric ;
    rdfs:label "Force MAE on 10k new SPICEv2 molecules (95% confidence interval +/- 1.4)" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "22.9"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-gemnet-oc-ood-kreiman2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gemnet-oc-kreiman2025 ;
    mlips:targetMaterial entity:mat-oc20-kreiman2025 ;
    mlips:hasAccuracyMetric entity:metric-gemnet-oc-ood-1-kreiman2025 ,
        entity:metric-gemnet-oc-ood-2-kreiman2025 .

entity:metric-gemnet-oc-ood-1-kreiman2025 a mlips:AccuracyMetric ;
    rdfs:label "Force MAE, OC20 out-of-distribution validation split" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "77.8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-gemnet-oc-ood-2-kreiman2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy MAE, OC20 out-of-distribution validation split" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1787.4"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV .

entity:result-gemnet-oc-joint-ood-kreiman2025 a mlips:BenchmarkResult ;
    rdfs:comment "With test-time training on top: 61.42 meV/A and 1143 meV." ;
    mlips:evaluatesModel entity:model-gemnet-oc-joint-kreiman2025 ;
    mlips:targetMaterial entity:mat-oc20-kreiman2025 ;
    mlips:hasAccuracyMetric entity:metric-gemnet-oc-joint-ood-1-kreiman2025 ,
        entity:metric-gemnet-oc-joint-ood-2-kreiman2025 .

entity:metric-gemnet-oc-joint-ood-1-kreiman2025 a mlips:AccuracyMetric ;
    rdfs:label "Force MAE, OC20 out-of-distribution validation split" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "63.67"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-gemnet-oc-joint-ood-2-kreiman2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy MAE, OC20 out-of-distribution validation split" ;
    mlips:metricType mlips:MAE ;
