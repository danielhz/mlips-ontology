# Canonical Turtle for the protocol-derived encoding of:
#   B. O. Mukhamedov et al. (2025). Machine learning interatomic potential for the low-modulus Ti-Nb-Zr alloys in the vicinity of dynamical instability.
#   Materials & Design. doi:10.1016/j.matdes.2025.113865  arXiv:2412.06270v2
#
# Version read: arxiv-preprint arXiv:2412.06270v2 (sha256 f48487ac453a83a0...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 430 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/mukhamedov2025.yaml.
#
# Encoding scope: the VASP GGA data for Ti94-xNbxZr6 SQS (128 atoms;
# 1-30 at.% Nb), the MTP (level 16g, 380 basis functions, 5 A cutoff)
# initialised by active selection from Gamma-point AIMD and then actively
# learned with LAMMPS MD at 300-1300 K, ending with 880 configurations,
# and its use for elastic constants and moduli. Errors are in the SI
# only; elastic properties are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mukhamedov2025 a mlips:BenchmarkStudy ;
    rdfs:label "Mukhamedov et al. (2025): an actively learned moment tensor potential for low-modulus Ti-Nb-Zr alloys near dynamical instability" ;
    mlips:reportedIn entity:article-mukhamedov2025 .

entity:article-mukhamedov2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.matdes.2025.113865> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Machine learning interatomic potential for the low-modulus Ti-Nb-Zr alloys in the vicinity of dynamical instability" ;
    schema:author entity:person-Mukhamedov-mukhamedov2025 ,
        entity:person-Tasnadi-mukhamedov2025 ,
        entity:person-Abrikosov-mukhamedov2025 .

entity:person-Mukhamedov-mukhamedov2025 a schema:Person ;
    schema:name "Boburjon Mukhamedov" ;
    schema:givenName "Boburjon" ;
    schema:familyName "Mukhamedov" .

entity:person-Tasnadi-mukhamedov2025 a schema:Person ;
    schema:name "Ferenc Tasnádi" ;
    schema:givenName "Ferenc" ;
    schema:familyName "Tasnádi" .

entity:person-Abrikosov-mukhamedov2025 a schema:Person ;
    schema:name "Igor A. Abrikosov" ;
    schema:givenName "Igor A." ;
    schema:familyName "Abrikosov" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tinbzr-mukhamedov2025 a mlips:MaterialSystem ;
    rdfs:label "Bcc Ti94-xNbxZr6 alloys (x = 1, 6, 15, 22, 30) as 128-atom SQS" ;
    mlips:materialClass "High-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-gga-mukhamedov2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-gga-mukhamedov2025 mlips:hasDFTSettings entity:calc-settings-gga-mukhamedov2025 .

entity:calc-settings-gga-mukhamedov2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "700"^^xsd:double ;
    mlips:kPointMesh "4x4x4 (Gamma point only for the initial AIMD)" ;
    rdfs:comment "GGA (functional cited, not named); SQS supercells (Sec. 2.1)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-final-mukhamedov2025 a mlips:TrainingDataset ;
    rdfs:label "Final Ti-Nb-Zr training set (high-accuracy single points)" ;
    mlips:coversMaterial entity:mat-tinbzr-mukhamedov2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 880 ;
    mlips:hasDFTCalculation entity:calc-gga-mukhamedov2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-final-mukhamedov2025 mlips:samplingStrategy
    entity:sampling-al-mukhamedov2025 .

entity:sampling-al-mukhamedov2025 a mlips:SamplingStrategy ;
    rdfs:label "Active selection from Gamma-point AIMD (10 iterations, 420 configurations), then 30 + 25 + 5 MLIP-2/LAMMPS active-learning iterations with extrapolation-grade selection at 300-1300 K; low-accuracy data removed" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ;
    mlips:hasImplementation entity:impl-MTP-mukhamedov2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MTP-mukhamedov2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-cutoffRadius-mukhamedov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-mtp-momentLevel-mukhamedov2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "16"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-mukhamedov2025 a mlips:MLIPRun ;
    rdfs:label "MTP 16g (380 basis functions) for Ti-Nb-Zr" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-final-mukhamedov2025 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-cutoffRadius-mukhamedov2025 ,
        entity:setting-mtp-momentLevel-mukhamedov2025 ;
    mlips:produces entity:model-mtp-mukhamedov2025 .

entity:model-mtp-mukhamedov2025 a mlips:TrainedModel ;
    rdfs:label "Ti-Nb-Zr MTP 16g (Mukhamedov 2025)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# No timings are given.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

