###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-electrodes-kang2025 a mlips:MaterialSystem ;
    rdfs:label "Twelve electrode and solid-electrolyte materials (LiCoO2, LiMnO2, LiFePO4, Li10GeP2S12, Li3YCl6, Li3PO4, Na3PS4, NaV2O4, MgMn2O4, MgTi2S4, MgSc2Se4, MgMo6S8)" ;
