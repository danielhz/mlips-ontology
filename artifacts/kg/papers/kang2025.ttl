###############################################################################

entity:run-gptff-kang2025 a mlips:MLIPRun ;
    rdfs:label "GPTFF as distributed" ;
    mlips:appliesMethod entity:GPTFF ;
    mlips:produces entity:model-gptff-kang2025 .

entity:model-gptff-kang2025 a mlips:TrainedModel ;
    rdfs:label "GPTFF (pretrained universal force field)" .

entity:run-chgnet-kang2025 a mlips:MLIPRun ;
    rdfs:label "CHGNet as distributed" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-kang2025 .

entity:model-chgnet-kang2025 a mlips:TrainedModel ;
    rdfs:label "CHGNet (pretrained universal potential)" .

entity:run-mace-kang2025 a mlips:MLIPRun ;
    rdfs:label "MACE universal potential as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-kang2025 .

entity:model-mace-kang2025 a mlips:TrainedModel ;
    rdfs:label "MACE universal potential (pretrained)" .

entity:run-gptff-ft-pbe-kang2025 a mlips:MLIPRun ;
    rdfs:label "GPTFF fine-tuned on PBE LiCoO2 data" ;
    mlips:appliesMethod entity:GPTFF ;
    mlips:runsOn entity:ds-LiCoO2-pbe-kang2025 ;
    mlips:produces entity:model-gptff-ft-pbe-kang2025 .

entity:model-gptff-ft-pbe-kang2025 a mlips:TrainedModel ;
    rdfs:label "GPTFF fine-tuned on LiCoO2 (PBE)" .

entity:run-gptff-ft-pbeu-kang2025 a mlips:MLIPRun ;
    rdfs:label "GPTFF fine-tuned on PBE+U LiCoO2 data" ;
    mlips:appliesMethod entity:GPTFF ;
    mlips:runsOn entity:ds-LiCoO2-pbeu-kang2025 ;
    mlips:produces entity:model-gptff-ft-pbeu-kang2025 .

entity:model-gptff-ft-pbeu-kang2025 a mlips:TrainedModel ;
    rdfs:label "GPTFF fine-tuned on LiCoO2 (PBE+U)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# A single migration-barrier estimate takes about 20 minutes on one NVIDIA
# Tesla A100 GPU with GPTFF, against hours or days for DFT-NEB (about 1e2
# times faster). No training cost is given for the fine-tuned models.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Migration barriers (Fig. 3) and the test-set MAEs of the fine-tuned GPTFF models (Fig. 4c, d) are given only as plots; no number is read from them. The literature barriers quoted in the text are reference values, not model errors.
# - The MACE and CHGNet checkpoints are not identified (MACE is cited to Refs. [15, 16]), so all three universal models are paper-local runs. GPTFF is a new registry method; its method paper is not in the corpus.
# - The size, sampling and DFT settings of the LiCoO2 fine-tuning data are not given; the PBE+U U values are not stated.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/kang2025.yaml) until the schema has terms for them.
