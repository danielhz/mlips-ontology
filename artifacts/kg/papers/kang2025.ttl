    rdfs:label "Layered LiCoO2" ;
    mlips:chemicalFormula "LiCoO2" ;
    mlips:materialClass "Layered oxide cathode material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-kang2025 a mlips:DFTCalculation .

entity:calc-pbeu-kang2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-kang2025 mlips:hasDFTSettings entity:calc-settings-pbe-kang2025 .

entity:calc-settings-pbe-kang2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "LiCoO2 fine-tuning data computed with PBE; settings not given." .

entity:calc-pbeu-kang2025 mlips:hasDFTSettings entity:calc-settings-pbeu-kang2025 .

entity:calc-settings-pbeu-kang2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "LiCoO2 fine-tuning data computed with PBE+U (Hubbard U correction); U values and settings not given." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-LiCoO2-pbe-kang2025 a mlips:TrainingDataset ;
    rdfs:label "LiCoO2 fine-tuning data set (PBE)" ;
    mlips:coversMaterial entity:mat-LiCoO2-kang2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-kang2025 .

entity:ds-LiCoO2-pbeu-kang2025 a mlips:TrainingDataset ;
    rdfs:label "LiCoO2 fine-tuning data set (PBE+U)" ;
    mlips:coversMaterial entity:mat-LiCoO2-kang2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbeu-kang2025 .

