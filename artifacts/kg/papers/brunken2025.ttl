entity:run-mace-large-brunken2025 a mlips:MLIPRun ;
    rdfs:label "MACE-large pre-trained on curated SPICE2 (2 layers, 128 channels, correlation 2, node symmetry 3; 2,139,152 parameters)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-spice2-brunken2025 ;
    mlips:hasHyperparameterSetting entity:setting-mace-large-numLayers-brunken2025 ,
        entity:setting-mace-large-numFeatures-brunken2025 ,
        entity:setting-mace-large-numRadialBasis-brunken2025 ,
        entity:setting-mace-large-cutoffRadius-brunken2025 ,
        entity:setting-mace-large-batchSize-brunken2025 ,
        entity:setting-mace-large-learningRate-brunken2025 ,
        entity:setting-mace-large-numEpochs-brunken2025 ;
    mlips:trainingHardware "NVIDIA H100 GPUs" ;
    mlips:produces entity:model-mace-large-brunken2025 .

entity:model-mace-large-brunken2025 a mlips:TrainedModel ;
    rdfs:label "mlip MACE-large SPICE2" .

