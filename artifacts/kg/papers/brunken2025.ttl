###############################################################################

entity:calc-spice-brunken2025 mlips:hasDFTSettings entity:calc-settings-spice-brunken2025 .

entity:calc-settings-spice-brunken2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-wB97M-D3-BJ-brunken2025 ;
    mlips:basisSet "def2-TZVPPD" ;
    rdfs:comment "SPICE2 level of theory." .

entity:xc-wB97M-D3-BJ-brunken2025 a mlips:XCFunctional ;
    rdfs:label "wB97M-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

