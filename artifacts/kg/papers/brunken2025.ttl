entity:model-nequip-brunken2025 a mlips:TrainedModel ;
    rdfs:label "mlip NequIP SPICE2" .

entity:run-visnet-brunken2025 a mlips:MLIPRun ;
    rdfs:label "ViSNet pre-trained on curated SPICE2 (4 layers, 128 channels, 8 heads, 32 RBF, lmax 2; 1,137,922 parameters)" ;
    mlips:appliesMethod entity:ViSNet ;
