entity:mat-mol-brunken2025 a mlips:MaterialSystem ;
    rdfs:label "Drug-like molecules, dimers, amino acids, dipeptides and solvated systems of SPICE2; chignolin (1UAO) and alpha-bungarotoxin complex (1ABT) for speed tests" ;
    mlips:materialClass "Organic and biochemical molecules (C, N, O, H)" .

