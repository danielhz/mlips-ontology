# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-spice2-brunken2025 a mlips:TrainingDataset ;
    rdfs:label "Curated SPICE2 (H-bond, neutral-charge and force filters; 95:5 split at SMILES level)" ;
    mlips:coversMaterial entity:mat-mol-brunken2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 1737896 ;
    mlips:hasDFTCalculation entity:calc-spice-brunken2025 .

entity:ds-spice1-brunken2025 a mlips:TrainingDataset ;
    rdfs:label "Curated SPICE1" ;
    mlips:coversMaterial entity:mat-mol-brunken2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-spice-brunken2025 .

