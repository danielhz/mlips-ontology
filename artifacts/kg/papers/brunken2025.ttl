###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-brunken2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-brunken2025 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-brunken2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-brunken2025 a mlips:LossFunction ;
    rdfs:label "MSE on energy and forces, weights 40 and 1000 flipped at epoch 115" .

entity:alg-MACE-brunken2025 a mls:Algorithm ;
    rdfs:label "AMSGrad Adam, EMA 0.99, 4000 warm-up steps" .

entity:impl-MACE-brunken2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-InstaDeep-JAX-brunken2025 .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-brunken2025 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numRadialBasis ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-brunken2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-brunken2025 a mlips:LossFunction ;
    rdfs:label "Huber loss on energy and forces" .

entity:impl-NequIP-brunken2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-InstaDeep-JAX-brunken2025 .

entity:ViSNet a mlips:MLIPMethod ;
    rdfs:label "ViSNet (vector-scalar interactive equivariant graph neural network)" ;
    mlips:hasLossFunction entity:loss-ViSNet-brunken2025 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-ViSNet-brunken2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-ViSNet-brunken2025 a mlips:LossFunction ;
    rdfs:label "Huber loss on energy and forces" .

entity:impl-ViSNet-brunken2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-mlip-InstaDeep-JAX-brunken2025 .

entity:lib-mlip-InstaDeep-JAX-brunken2025 a mlips:Library ;
    rdfs:label "mlip (InstaDeep, JAX)" ;
    mlips:candidateForVocabulary mlips:Library .

