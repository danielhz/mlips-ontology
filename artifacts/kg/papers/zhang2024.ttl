# Canonical Turtle for the protocol-derived encoding of:
#   Lei Zhang et al. (2024). Efficiency, accuracy, and transferability of machine learning potentials: Application to dislocations and cracks in iron.
#   Acta Materialia. doi:10.1016/j.actamat.2024.119788  arXiv:2307.10072v2
#
# Version read: arxiv-preprint arXiv:2307.10072v2 (sha256 e5dd184f74ce8b92...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 407 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/zhang2024.yaml.
#
# Encoding scope: two iron DFT databases (DB-I, 14,476 configurations
# for thermomechanics, defects and fracture; DB-II, 9,622 pure-Fe
# configurations from an Fe-H database), the five ML-IAP families trained
# on DB-I with 9:1 splits (GAP with 2-body and two TurboSOAP descriptors,
# linear ACE PACE-L, nonlinear ACE PACE-FS, MTP, Behler-Parrinello NNP),
# and GAP trained on DB-II. Test RMSEs are figure-only or stated only
# approximately; dislocation, Peierls-barrier and fracture results are
# properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhang2024 a mlips:BenchmarkStudy ;
    rdfs:label "Zhang et al. (2024): efficiency, accuracy and transferability of GAP, linear and nonlinear ACE, MTP and NNP potentials for dislocations and cracks in iron" ;
    mlips:reportedIn entity:article-zhang2024 .

entity:article-zhang2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.actamat.2024.119788> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Efficiency, accuracy, and transferability of machine learning potentials: Application to dislocations and cracks in iron" ;
    schema:author <https://orcid.org/0000-0003-4414-7111> ,
        entity:person-Csanyi-zhang2024 ,
        entity:person-vanderGiessen-zhang2024 ,
        <https://orcid.org/0000-0002-3858-2267> .

<https://orcid.org/0000-0003-4414-7111> a schema:Person ;
    schema:name "Lei Zhang" ;
    schema:givenName "Lei" ;
    schema:familyName "Zhang" ;
    schema:identifier <https://orcid.org/0000-0003-4414-7111> .

entity:person-Csanyi-zhang2024 a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" .

entity:person-vanderGiessen-zhang2024 a schema:Person ;
    schema:name "Erik van der Giessen" ;
    schema:givenName "Erik" ;
    schema:familyName "van der Giessen" .

<https://orcid.org/0000-0002-3858-2267> a schema:Person ;
    schema:name "Francesco Maresca" ;
    schema:givenName "Francesco" ;
    schema:familyName "Maresca" ;
    schema:identifier <https://orcid.org/0000-0002-3858-2267> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-fe-zhang2024 a mlips:MaterialSystem ;
    rdfs:label "Bcc iron (with fcc and hcp cells, point defects, surfaces, gamma surfaces, dislocations, crack tips, grain boundaries and liquid)" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-zhang2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-zhang2024 mlips:hasDFTSettings entity:calc-settings-dft-zhang2024 .

entity:calc-settings-dft-zhang2024 a mlips:DFTSettings ;
    rdfs:comment "DFT settings of the source databases (Refs. 11, 14 for DB-I; Ref. 30 for DB-II); not repeated in this paper." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-db1-zhang2024 a mlips:TrainingDataset ;
    rdfs:label "DB-I iron database (160,280 local atomic environments)" ;
    mlips:coversMaterial entity:mat-fe-zhang2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 14476 ;
    mlips:hasDFTCalculation entity:calc-dft-zhang2024 .

entity:ds-db2-zhang2024 a mlips:TrainingDataset ;
    rdfs:label "DB-II pure-iron subset of an Fe-H database (768,986 local atomic environments)" ;
    mlips:coversMaterial entity:mat-fe-zhang2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 9622 ;
    mlips:hasDFTCalculation entity:calc-dft-zhang2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-zhang2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-GAP-zhang2024 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-ACE-zhang2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-ACE-zhang2024 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-MTP-zhang2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MTP-zhang2024 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-HDNNP-zhang2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-HDNNP-zhang2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-zhang2024 .

entity:lib-n2p2-zhang2024 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-db1-cutoffRadius-zhang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-gap-db1-numSparseConfigs-zhang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "4800"^^xsd:integer .

entity:setting-gap-db2-cutoffRadius-zhang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-pace-l-cutoffRadius-zhang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-pace-fs-cutoffRadius-zhang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-mtp-cutoffRadius-zhang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-nnp-cutoffRadius-zhang2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-db1-zhang2024 a mlips:MLIPRun ;
    rdfs:label "GAP-DB-I: 2-body + inner (3 A) and outer (6.5 A) TurboSOAP, M = 4800 sparse points" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-db1-zhang2024 ;
    mlips:hasHyperparameterSetting entity:setting-gap-db1-cutoffRadius-zhang2024 ,
        entity:setting-gap-db1-numSparseConfigs-zhang2024 ;
    mlips:produces entity:model-gap-db1-zhang2024 .

entity:model-gap-db1-zhang2024 a mlips:TrainedModel ;
    rdfs:label "Fe GAP-DB-I (Zhang 2024)" .

entity:run-gap-db2-zhang2024 a mlips:MLIPRun ;
    rdfs:label "GAP-DB-II trained on the DB-II database" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-db2-zhang2024 ;
    mlips:hasHyperparameterSetting entity:setting-gap-db2-cutoffRadius-zhang2024 ;
    mlips:produces entity:model-gap-db2-zhang2024 .

entity:model-gap-db2-zhang2024 a mlips:TrainedModel ;
    rdfs:label "Fe GAP-DB-II (Zhang 2024)" .

entity:run-pace-l-zhang2024 a mlips:MLIPRun ;
    rdfs:label "Linear ACE (PACE-L) trained on DB-I" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-db1-zhang2024 ;
    mlips:hasHyperparameterSetting entity:setting-pace-l-cutoffRadius-zhang2024 ;
    mlips:produces entity:model-pace-l-zhang2024 .

entity:model-pace-l-zhang2024 a mlips:TrainedModel ;
    rdfs:label "Fe PACE-L (Zhang 2024)" .

entity:run-pace-fs-zhang2024 a mlips:MLIPRun ;
    rdfs:label "Nonlinear ACE with Finnis-Sinclair embedding (PACE-FS) trained on DB-I" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-db1-zhang2024 ;
    mlips:hasHyperparameterSetting entity:setting-pace-fs-cutoffRadius-zhang2024 ;
    mlips:produces entity:model-pace-fs-zhang2024 .

entity:model-pace-fs-zhang2024 a mlips:TrainedModel ;
    rdfs:label "Fe PACE-FS (Zhang 2024)" .

entity:run-mtp-zhang2024 a mlips:MLIPRun ;
    rdfs:label "MTP trained on DB-I" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-db1-zhang2024 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-cutoffRadius-zhang2024 ;
    mlips:produces entity:model-mtp-zhang2024 .

entity:model-mtp-zhang2024 a mlips:TrainedModel ;
    rdfs:label "Fe MTP (Zhang 2024)" .

entity:run-nnp-zhang2024 a mlips:MLIPRun ;
    rdfs:label "Behler-Parrinello NNP (two hidden layers, logistic activation) trained on DB-I" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-db1-zhang2024 ;
    mlips:hasHyperparameterSetting entity:setting-nnp-cutoffRadius-zhang2024 ;
    mlips:produces entity:model-nnp-zhang2024 .

entity:model-nnp-zhang2024 a mlips:TrainedModel ;
    rdfs:label "Fe NNP (Zhang 2024)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

