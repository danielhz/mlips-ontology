@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-tholke2022 a mlips:BenchmarkStudy ;
    rdfs:label "Thölke and De Fabritiis (2022): TorchMD-NET equivariant Transformer (ET)" ;
    mlips:reportedIn entity:article-tholke2022 .

entity:article-tholke2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2202.02541> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "TorchMD-NET: Equivariant Transformers for Neural Network based Molecular Potentials" ;
    schema:author entity:person-Tholke-tholke2022 ,
        entity:person-DeFabritiis-tholke2022 .

entity:person-Tholke-tholke2022 a schema:Person ;
    schema:name "Philipp Thölke" ;
    schema:givenName "Philipp" ;
    schema:familyName "Thölke" .

entity:person-DeFabritiis-tholke2022 a schema:Person ;
    schema:name "Gianni De Fabritiis" ;
    schema:givenName "Gianni" ;
    schema:familyName "De Fabritiis" .

