###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:TorchMD-ET a mlips:MLIPMethod ;
    rdfs:label "Equivariant Transformer (TorchMD-NET)" ;
    mlips:hasLossFunction entity:loss-TorchMD-ET-tholke2022 ;
    mlips:hasTrainingAlgorithm entity:alg-TorchMD-ET-tholke2022 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numRadialBasis ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-TorchMD-ET-tholke2022 .

entity:loss-TorchMD-ET-tholke2022 a mlips:LossFunction ;
    rdfs:label "Mean squared error; for MD17 a combined energy and force loss weighted 0.2 and 0.8" .

entity:alg-TorchMD-ET-tholke2022 a mls:Algorithm ;
    rdfs:label "Adam with linear warm-up and reduce-on-plateau learning-rate decay" .

entity:impl-TorchMD-ET-tholke2022 a mlips:Implementation ;
    mlips:implementedIn entity:lib-TorchMD-NET-tholke2022 .

entity:lib-TorchMD-NET-tholke2022 a mlips:Library ;
    rdfs:label "TorchMD-NET" ;
    rdfs:comment "PyTorch; distributed training across two NVIDIA RTX 2080 Ti GPUs" ;
    mlips:candidateForVocabulary mlips:Library .

