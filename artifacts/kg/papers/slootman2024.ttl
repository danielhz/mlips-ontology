entity:ds-a-cc-tz-slootman2024 mlips:samplingStrategy
    entity:sampling-cluster-slootman2024 .

entity:ds-a-cc-qz-slootman2024 mlips:samplingStrategy
    entity:sampling-cluster-slootman2024 .

entity:sampling-cluster-slootman2024 a mlips:SamplingStrategy ;
    rdfs:label "Set A: 200 configurations clustered (agglomerative by geometry, k-means by energy) from 2000 energy-histogram samples (set B) of a PBE-TS MD trajectory" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:sGDML a mlips:MLIPMethod ;
    rdfs:label "Symmetric Gradient-Domain Machine Learning (sGDML)" ;
    mlips:hasTrainingAlgorithm entity:alg-sGDML-slootman2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-sGDML-slootman2024 a mls:Algorithm ;
    rdfs:label "sGDML trained on 100 configurations with 100 for validation" .

###############################################################################
