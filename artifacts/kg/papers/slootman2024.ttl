###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ethanol-slootman2024 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule at room temperature" ;
    mlips:chemicalFormula "C2H5OH" ;
    mlips:materialClass "small organic molecule" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vmc-slootman2024 a mlips:WaveFunctionCalculation .

entity:calc-dmc-re-slootman2024 a mlips:WaveFunctionCalculation .

entity:calc-dmc-hyb-slootman2024 a mlips:WaveFunctionCalculation .

entity:calc-dmc-vd-slootman2024 a mlips:WaveFunctionCalculation .

entity:calc-pbe-ts-slootman2024 a mlips:DFTCalculation .

entity:calc-pbe0-mbd-slootman2024 a mlips:DFTCalculation .

entity:calc-cc-tz-slootman2024 a mlips:WaveFunctionCalculation .

entity:calc-cc-qz-slootman2024 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vmc-slootman2024 mlips:hasWaveFunctionSettings entity:calc-settings-vmc-slootman2024 .

entity:calc-settings-vmc-slootman2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-VMC-slootman2024 ;
    mlips:basisSet "cc-pVTZ (pseudopotential)" ;
    rdfs:comment "One-determinant fully optimised Jastrow-Slater wave function; CHAMP; GAMESS(US) HF orbitals." .

entity:calc-dmc-re-slootman2024 mlips:hasWaveFunctionSettings entity:calc-settings-dmc-re-slootman2024 .

entity:calc-settings-dmc-re-slootman2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-DMC-reweighting-estimator-slootman2024 ;
    mlips:basisSet "cc-pVTZ (pseudopotential)" ;
    rdfs:comment "One determinant; T-moves, time step 0.005 a.u." .

entity:calc-dmc-hyb-slootman2024 mlips:hasWaveFunctionSettings entity:calc-settings-dmc-hyb-slootman2024 .

entity:calc-settings-dmc-hyb-slootman2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-DMC-RE-hybrid-estimator-slootman2024 ;
    mlips:basisSet "cc-pVTZ (pseudopotential)" ;
    rdfs:comment "One determinant." .

entity:calc-dmc-vd-slootman2024 mlips:hasWaveFunctionSettings entity:calc-settings-dmc-vd-slootman2024 .

entity:calc-settings-dmc-vd-slootman2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-DMC-variational-drift-estimator-slootman2024 ;
    mlips:basisSet "cc-pVTZ (pseudopotential)" ;
    rdfs:comment "One determinant; node cutoff 0.05 a.u., khist 900." .

entity:calc-pbe-ts-slootman2024 mlips:hasDFTSettings entity:calc-settings-pbe-ts-slootman2024 .

entity:calc-settings-pbe-ts-slootman2024 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE-TS-slootman2024 ;
    rdfs:comment "Also used for the MD trajectory from which sets B and C were drawn." .

entity:calc-pbe0-mbd-slootman2024 mlips:hasDFTSettings entity:calc-settings-pbe0-mbd-slootman2024 .

entity:calc-settings-pbe0-mbd-slootman2024 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE0-MBD-slootman2024 .

entity:calc-cc-tz-slootman2024 mlips:hasWaveFunctionSettings entity:calc-settings-cc-tz-slootman2024 .

entity:calc-settings-cc-tz-slootman2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "cc-pVTZ" ;
    rdfs:comment "All-electron CCSD(T), Psi4." .

entity:calc-cc-qz-slootman2024 mlips:hasWaveFunctionSettings entity:calc-settings-cc-qz-slootman2024 .

entity:calc-settings-cc-qz-slootman2024 a mlips:WaveFunctionSettings ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "cc-pVQZ" ;
    rdfs:comment "All-electron CCSD(T), Psi4." .

entity:wf-VMC-slootman2024 a mlips:WfMethod ;
    rdfs:label "VMC" ;
    mlips:candidateForVocabulary mlips:WfMethod .

entity:wf-DMC-reweighting-estimator-slootman2024 a mlips:WfMethod ;
    rdfs:label "DMC (reweighting estimator)" ;
    mlips:candidateForVocabulary mlips:WfMethod .

entity:wf-DMC-RE-hybrid-estimator-slootman2024 a mlips:WfMethod ;
    rdfs:label "DMC (RE-hybrid estimator)" ;
    mlips:candidateForVocabulary mlips:WfMethod .

entity:wf-DMC-variational-drift-estimator-slootman2024 a mlips:WfMethod ;
    rdfs:label "DMC (variational-drift estimator)" ;
    mlips:candidateForVocabulary mlips:WfMethod .

entity:xc-PBE-TS-slootman2024 a mlips:XCFunctional ;
    rdfs:label "PBE-TS" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-PBE0-MBD-slootman2024 a mlips:XCFunctional ;
    rdfs:label "PBE0-MBD" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

