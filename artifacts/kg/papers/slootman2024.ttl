###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-a-vmc-slootman2024 mlips:samplingStrategy
    entity:sampling-cluster-slootman2024 .

entity:ds-a-dmc-re-slootman2024 mlips:samplingStrategy
    entity:sampling-cluster-slootman2024 .

entity:ds-a-dmc-hyb-slootman2024 mlips:samplingStrategy
    entity:sampling-cluster-slootman2024 .

entity:ds-a-dmc-vd-slootman2024 mlips:samplingStrategy
