    rdfs:label "MACE-OFF23(L)" .

entity:run-off24-M-kovacs2025 a mlips:MLIPRun ;
    rdfs:label "MACE-OFF24(M) training run" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-off24-kovacs2025 ;
    mlips:hasHyperparameterSetting entity:setting-off24-M-cutoffRadius-kovacs2025 ,
        entity:setting-off24-M-numFeatures-kovacs2025 ,
        entity:setting-off24-M-max-L-kovacs2025 ,
        entity:setting-off24-M-bodyOrder-kovacs2025 ,
        entity:setting-off24-M-numLayers-kovacs2025 ,
        entity:setting-off24-M-learningRate-kovacs2025 ;
    mlips:trainingHardware "Single Nvidia A100 GPU" ;
