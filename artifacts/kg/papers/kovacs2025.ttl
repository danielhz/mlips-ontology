###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-pubchem-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "PubChem molecules (SPICE subset)" ;
    mlips:materialClass "Organic molecular systems; elements H, C, N, O, F, P, S, Cl, Br, I; 3-50 atoms" .

entity:mat-des370k-monomers-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "DES370K monomers (SPICE subset)" ;
    mlips:materialClass "Organic molecular systems; elements H, C, N, O, F, P, S, Cl, Br, I; 3-22 atoms" .

entity:mat-des370k-dimers-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "DES370K dimers (SPICE subset)" ;
    mlips:materialClass "Organic molecular systems; elements H, C, N, O, F, P, S, Cl, Br, I; 4-34 atoms" .

entity:mat-dipeptides-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "Dipeptides (SPICE subset)" ;
    mlips:materialClass "Organic molecular systems; elements H, C, N, O, S; 26-60 atoms" .

entity:mat-solvated-amino-acids-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "Solvated amino acids (SPICE subset)" ;
    mlips:materialClass "Organic molecular systems; elements H, C, N, O, S; 79-96 atoms" .

entity:mat-water-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "Water clusters" ;
    mlips:materialClass "Organic molecular systems; elements H, O; 3-150 atoms" .

entity:mat-qmugs-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "QMugs molecules (51-90 atoms)" ;
    mlips:materialClass "Organic molecular systems; elements H, C, N, O, F, P, S, Cl, Br, I; 51-90 atoms" .

entity:mat-tripeptides-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "Tripeptides (COMP6, recomputed at the SPICE level of theory)" ;
    mlips:materialClass "Organic molecular systems; elements H, C, N, O; 30-69 atoms" .

entity:mat-amino-acid-ligand-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "Amino acid-ligand pairs (SPICE version 2 subset)" ;
    mlips:materialClass "Organic molecular systems" .

entity:mat-solvated-pubchem-kovacs2025 a mlips:MaterialSystem ;
    rdfs:label "Solvated PubChem molecules (SPICE version 2 subset)" ;
    mlips:materialClass "Organic molecular systems" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-kovacs2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-kovacs2025 mlips:hasDFTSettings entity:calc-settings-dft-kovacs2025 .

entity:calc-settings-dft-kovacs2025 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-PSI4-kovacs2025 ;
    mlips:xcFunctional entity:xc-omegaB97M-D3-BJ-kovacs2025 ;
    mlips:dftBasisSet entity:basis-def2-TZVPPD-kovacs2025 ;
    rdfs:comment "omegaB97M-D3(BJ)/def2-TZVPPD as implemented in PSI4 (the SPICE level of theory); QMugs and water-cluster geometries and the COMP6 tripeptides were re-evaluated at this level." .

entity:lib-PSI4-kovacs2025 a mlips:Library ;
    rdfs:label "PSI4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-omegaB97M-D3-BJ-kovacs2025 a mlips:XCFunctional ;
    rdfs:label "omegaB97M-D3(BJ)" ;
    rdfs:comment "Range-separated hybrid meta-GGA with D3(BJ) dispersion correction; the SPICE level of theory." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-def2-TZVPPD-kovacs2025 a mlips:DftBasisSet ;
    rdfs:label "def2-TZVPPD" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-off23-kovacs2025 a mlips:TrainingDataset ;
    rdfs:label "MACE-OFF23 training set (SPICE version 1 subset + QMugs + water clusters)" ;
    mlips:coversMaterial entity:mat-pubchem-kovacs2025 ,
        entity:mat-des370k-monomers-kovacs2025 ,
        entity:mat-des370k-dimers-kovacs2025 ,
        entity:mat-dipeptides-kovacs2025 ,
        entity:mat-solvated-amino-acids-kovacs2025 ,
        entity:mat-water-kovacs2025 ,
        entity:mat-qmugs-kovacs2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 951813 ;
    mlips:hasDFTCalculation entity:calc-dft-kovacs2025 ;
    rdfs:comment "Neutral-formal-charge SPICE v1 subset with the ten elements H, C, N, O, F, P, S, Cl, Br, I and without the ion pairs (about 85% of SPICE), augmented with QMugs molecules and water clusters. numConfigurations is the sum of the '# Train' row of Table 1 (646821 + 16861 + 263065 + 19773 + 948 + 1597 + 2748); 95% train/validation and 5% test, split at the molecule level. 808 configurations with a maximum force error above 2 eV/A were removed from the training set after a first fit." .

entity:ds-off24-kovacs2025 a mlips:TrainingDataset ;
    rdfs:label "MACE-OFF24 training set (MACE-OFF23 set + SPICE version 2 additions)" ;
    mlips:coversMaterial entity:mat-pubchem-kovacs2025 ,
        entity:mat-des370k-monomers-kovacs2025 ,
        entity:mat-des370k-dimers-kovacs2025 ,
        entity:mat-dipeptides-kovacs2025 ,
        entity:mat-solvated-amino-acids-kovacs2025 ,
        entity:mat-water-kovacs2025 ,
        entity:mat-qmugs-kovacs2025 ,
        entity:mat-amino-acid-ligand-kovacs2025 ,
        entity:mat-solvated-pubchem-kovacs2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-dft-kovacs2025 ;
    rdfs:comment "Adds about 208,000 SPICE version 2 configurations and 1000 water clusters; a maximum force filter of 15 eV/A and a total force filter of 0.1 eV/A removed 10,372 configurations from the SPICE version 2 subsets. The total size is not stated." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-off23-kovacs2025 mlips:samplingStrategy
    entity:sampling-spice-md-kovacs2025 ,
    entity:sampling-qmugs-xtb-md-kovacs2025 ,
    entity:sampling-water-clusters-kovacs2025 .

entity:ds-off24-kovacs2025 mlips:samplingStrategy
    entity:sampling-spice-md-kovacs2025 ,
    entity:sampling-qmugs-xtb-md-kovacs2025 ,
    entity:sampling-water-clusters-kovacs2025 ,
    entity:sampling-spice2-kovacs2025 .

entity:sampling-spice-md-kovacs2025 a mlips:SamplingStrategy ;
    rdfs:label "Classical force-field MD conformer sampling (SPICE)" ;
    rdfs:comment "SPICE geometries from molecular dynamics with classical force fields at 300 K and 500 K, sampling maximally different conformations from the trajectories." .

entity:sampling-qmugs-xtb-md-kovacs2025 a mlips:SamplingStrategy ;
    rdfs:label "GFN2-xTB MD of larger molecules (QMugs)" ;
    rdfs:comment "50-90 atom molecules randomly selected from QMugs; geometries from GFN2-xTB molecular dynamics." .

entity:sampling-water-clusters-kovacs2025 a mlips:SamplingStrategy ;
    rdfs:label "Water clusters carved from liquid-water MD" ;
    rdfs:comment "Clusters of up to 50 water molecules carved out of molecular dynamics simulations of liquid water." .

entity:sampling-spice2-kovacs2025 a mlips:SamplingStrategy ;
    rdfs:label "SPICE version 2 additions" ;
    rdfs:comment "About 208,000 additional configurations of solvated PubChem molecules (MD, same protocol as SPICE 1) and amino acid-ligand pairs extracted from PDB structures, plus 1000 water clusters of up to 90 atoms." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-kovacs2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-kovacs2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        entity:hp-max-L-kovacs2025 ,
        mlips:bodyOrder ,
        mlips:numLayers ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-MACE-kovacs2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-MACE-kovacs2025 a mlips:LossFunction ;
    rdfs:label "Weighted energy and force loss in two phases: force weight 1000 and energy weight 40, then force weight 10 and energy weight 1000 once the force error has converged" .

entity:alg-MACE-kovacs2025 a mls:Algorithm ;
    rdfs:label "Adam with AMSGrad and an exponential moving average of the weights; learning rate 0.01, reduced to 0.00025 in the second phase; stopped when the energy error no longer decreases" .

entity:impl-MACE-kovacs2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE ;
    mlips:version "PyTorch implementation, https://github.com/ACEsuit/mace" .

entity:hp-max-L-kovacs2025 a mlips:Hyperparameter ;
    rdfs:label "MACE maximum equivariance order L of the messages" ;
    mlips:hyperparameterName "max_L" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-off23-S-cutoffRadius-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-off23-S-numFeatures-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "96"^^xsd:integer .

entity:setting-off23-S-max-L-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-max-L-kovacs2025 ;
    mlips:settingValue "0"^^xsd:integer .

entity:setting-off23-S-bodyOrder-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-off23-S-numLayers-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-off23-S-learningRate-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-off23-M-cutoffRadius-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-off23-M-numFeatures-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-off23-M-max-L-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-max-L-kovacs2025 ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-off23-M-bodyOrder-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-off23-M-numLayers-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-off23-M-learningRate-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-off23-L-cutoffRadius-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-off23-L-numFeatures-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "192"^^xsd:integer .

entity:setting-off23-L-max-L-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-max-L-kovacs2025 ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-off23-L-bodyOrder-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-off23-L-numLayers-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-off23-L-learningRate-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-off24-M-cutoffRadius-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-off24-M-numFeatures-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-off24-M-max-L-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-max-L-kovacs2025 ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-off24-M-bodyOrder-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-off24-M-numLayers-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-off24-M-learningRate-kovacs2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-off23-S-kovacs2025 a mlips:MLIPRun ;
    rdfs:label "MACE-OFF23(S) training run" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-off23-kovacs2025 ;
    mlips:hasHyperparameterSetting entity:setting-off23-S-cutoffRadius-kovacs2025 ,
        entity:setting-off23-S-numFeatures-kovacs2025 ,
        entity:setting-off23-S-max-L-kovacs2025 ,
        entity:setting-off23-S-bodyOrder-kovacs2025 ,
        entity:setting-off23-S-numLayers-kovacs2025 ,
        entity:setting-off23-S-learningRate-kovacs2025 ;
    mlips:trainingHardware "Single Nvidia A100 GPU; training took about 6 days" ;
    mlips:produces entity:model-off23-S-kovacs2025 .

entity:model-off23-S-kovacs2025 a mlips:TrainedModel ;
    rdfs:label "MACE-OFF23(S)" .

entity:run-off23-M-kovacs2025 a mlips:MLIPRun ;
    rdfs:label "MACE-OFF23(M) training run" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-off23-kovacs2025 ;
    mlips:hasHyperparameterSetting entity:setting-off23-M-cutoffRadius-kovacs2025 ,
        entity:setting-off23-M-numFeatures-kovacs2025 ,
        entity:setting-off23-M-max-L-kovacs2025 ,
        entity:setting-off23-M-bodyOrder-kovacs2025 ,
        entity:setting-off23-M-numLayers-kovacs2025 ,
        entity:setting-off23-M-learningRate-kovacs2025 ;
    mlips:trainingHardware "Single Nvidia A100 GPU; training took about 10 days" ;
    mlips:produces entity:model-off23-M-kovacs2025 .

entity:model-off23-M-kovacs2025 a mlips:TrainedModel ;
    rdfs:label "MACE-OFF23(M)" .

entity:run-off23-L-kovacs2025 a mlips:MLIPRun ;
    rdfs:label "MACE-OFF23(L) training run" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-off23-kovacs2025 ;
    mlips:hasHyperparameterSetting entity:setting-off23-L-cutoffRadius-kovacs2025 ,
        entity:setting-off23-L-numFeatures-kovacs2025 ,
        entity:setting-off23-L-max-L-kovacs2025 ,
        entity:setting-off23-L-bodyOrder-kovacs2025 ,
        entity:setting-off23-L-numLayers-kovacs2025 ,
