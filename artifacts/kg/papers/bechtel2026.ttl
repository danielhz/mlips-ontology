    rdfs:label "Orb-v3-conservative-inf-OMAT as distributed" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb-v3-bechtel2026 .

entity:model-orb-v3-bechtel2026 a mlips:TrainedModel ;
    rdfs:label "Orb-v3-conservative-inf-OMAT" .

entity:run-eqv2-oc20-bechtel2026 a mlips:MLIPRun ;
    rdfs:label "EquiformerV2-153M-S2EF-OC20-All+MD as distributed" ;
    mlips:appliesMethod entity:EquiformerV2 ;
    mlips:produces entity:model-eqv2-oc20-bechtel2026 .

entity:model-eqv2-oc20-bechtel2026 a mlips:TrainedModel ;
    rdfs:label "EquiformerV2-153M-S2EF-OC20-All+MD" .

entity:run-escn-oc20-bechtel2026 a mlips:MLIPRun ;
    rdfs:label "eSCN-L6-M3-Lay20-S2EF-OC20-All+MD as distributed" ;
    mlips:appliesMethod entity:eSCN ;
    mlips:produces entity:model-escn-oc20-bechtel2026 .

entity:model-escn-oc20-bechtel2026 a mlips:TrainedModel ;
    rdfs:label "eSCN-L6-M3-Lay20-S2EF-OC20-All+MD" .

entity:run-schnet-oc20-bechtel2026 a mlips:MLIPRun ;
    rdfs:label "SchNet-S2EF-OC20-All as distributed" ;
    mlips:appliesMethod entity:SchNet ;
    mlips:produces entity:model-schnet-oc20-bechtel2026 .

entity:model-schnet-oc20-bechtel2026 a mlips:TrainedModel ;
