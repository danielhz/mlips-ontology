# Canonical Turtle for the protocol-derived encoding of:
#   Maximilian A. Bechtel et al. (2026). Vibrational power spectra as a tool to benchmark universal machine-learning interatomic potentials for molecular systems: the OMOL-1k-MD data set.
#   npj Computational Materials. doi:10.1038/s41524-026-02286-5
#
# Version read: publisher (sha256 becb6500dda30e10...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 247 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/bechtel2026.yaml.
#
# Encoding scope: the OMOL-1k-MD data set introduced here (PBE-D3 AIMD of
# 1,000 OMOL25 molecules) and the ten pretrained universal MLIPs whose
# vibrational free energies from MD power spectra are compared with it
# (Table 1: MAE per atom, and the MD time for molecule No. 1). GFN2-xTB and
# GFN-FF are not MLIPs and are not encoded; peak-position errors, stability
# analyses and the larger-system tests are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bechtel2026 a mlips:BenchmarkStudy ;
    rdfs:label "Bechtel and Steffen (2026): OMOL-1k-MD, vibrational power spectra as a benchmark of universal MLIPs for molecules" ;
    mlips:reportedIn entity:article-bechtel2026 .

entity:article-bechtel2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-02286-5> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Vibrational power spectra as a tool to benchmark universal machine-learning interatomic potentials for molecular systems: the OMOL-1k-MD data set" ;
    schema:author entity:person-Bechtel-bechtel2026 ,
        entity:person-Steffen-bechtel2026 .

entity:person-Bechtel-bechtel2026 a schema:Person ;
    schema:name "Maximilian A. Bechtel" ;
    schema:givenName "Maximilian A." ;
    schema:familyName "Bechtel" .

entity:person-Steffen-bechtel2026 a schema:Person ;
    schema:name "Julien Steffen" ;
    schema:givenName "Julien" ;
    schema:familyName "Steffen" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-omol1k-bechtel2026 a mlips:MaterialSystem ;
    rdfs:label "1,000 neutral closed-shell molecules of up to 50 atoms randomly drawn from OMOL25" ;
    mlips:materialClass "Organic and main-group molecules (gas phase)" .

entity:mat-c4h9n3o-bechtel2026 a mlips:MaterialSystem ;
    rdfs:label "C4H9N3O molecule (No. 1 of OMOL-1k-MD)" ;
    mlips:chemicalFormula "C4H9N3O" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-bechtel2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-bechtel2026 mlips:hasDFTSettings entity:calc-settings-pbe-d3-bechtel2026 .

entity:calc-settings-pbe-d3-bechtel2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "450"^^xsd:double ;
    rdfs:comment "VASP 6.5.0, Grimme D3(BJ), 20 A cubic box, Fermi smearing at 300 K; NVT AIMD at 300 K with a Nose-Hoover thermostat." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-omol1k-bechtel2026 a mlips:TrainingDataset ;
    rdfs:label "OMOL-1k-MD (30 million AIMD structures of 1,000 molecules)" ;
    mlips:coversMaterial entity:mat-omol1k-bechtel2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-bechtel2026 ;
    rdfs:comment "Benchmark and training resource; molecules selected from OMOL25-train4M." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-omol1k-bechtel2026 mlips:samplingStrategy
    entity:sampling-aimd-bechtel2026 .

entity:sampling-aimd-bechtel2026 a mlips:SamplingStrategy ;
    rdfs:label "Three independent 11 ps AIMD trajectories (1 fs steps, first 1 ps equilibration) per molecule at 300 K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:PaiNN a mlips:MLIPMethod ;
    rdfs:label "PaiNN (polarizable atom interaction neural network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:SchNet a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:eSCN a mlips:MLIPMethod ;
    rdfs:label "eSCN (equivariant spherical channel network with SO(2) convolutions)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-mp-0b-bechtel2026 a mlips:MLIPRun ;
    rdfs:label "MACE MP-0 (mp-0b agnesi-medium) as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mp-0b-bechtel2026 .

entity:model-mace-mp-0b-bechtel2026 a mlips:TrainedModel ;
    rdfs:label "MACE MP-0 (mp-0b agnesi-medium)" .

entity:run-mace-mh-1-bechtel2026 a mlips:MLIPRun ;
    rdfs:label "MACE MH-1 (OMat head) as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mh-1-bechtel2026 .

entity:model-mace-mh-1-bechtel2026 a mlips:TrainedModel ;
    rdfs:label "MACE MH-1 (OMat head)" .

entity:run-uma-omat-bechtel2026 a mlips:MLIPRun ;
    rdfs:label "UMA (OMat head) as distributed" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-omat-bechtel2026 .

entity:model-uma-omat-bechtel2026 a mlips:TrainedModel ;
