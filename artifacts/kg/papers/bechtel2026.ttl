entity:run-painn-oc20-bechtel2026 a mlips:MLIPRun ;
    rdfs:label "PaiNN-S2EF-OC20-All as distributed" ;
    mlips:appliesMethod entity:PaiNN ;
    mlips:produces entity:model-painn-oc20-bechtel2026 .

entity:model-painn-oc20-bechtel2026 a mlips:TrainedModel ;
