    entity:sampling-published-hu2025 .

entity:sampling-published-hu2025 a mlips:SamplingStrategy ;
    rdfs:label "Published data set used as provided (or a stated subset of it)" .

entity:sampling-inhouse-hu2025 a mlips:SamplingStrategy ;
