###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-hu2025 mlips:hasResult
    entity:result-mpf-hu2025 ,
    entity:result-hh130-hu2025 ,
    entity:result-cu2se-hu2025 ,
    entity:result-sse-hu2025 .

entity:result-mpf-hu2025 a mlips:BenchmarkResult ;
    rdfs:comment "The paper quotes M3GNet on the same data at 35 meV/atom, 72 meV/A and 0.41 GPa with 227,549 parameters (values of the M3GNet paper, chen2022)." ;
    mlips:evaluatesModel entity:model-mpf-hu2025 ;
    mlips:targetMaterial entity:mat-mpf-hu2025 ;
    mlips:hasAccuracyMetric entity:metric-mpf-1-hu2025 ,
        entity:metric-mpf-2-hu2025 ,
        entity:metric-mpf-3-hu2025 .

entity:metric-mpf-1-hu2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy MAE" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "63"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

