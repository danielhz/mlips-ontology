        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 6966 .

entity:ds-semiconductor-hu2025 a mlips:TrainingDataset ;
    rdfs:label "Semiconductor data set, subset with maximum force below 5 eV/A" ;
