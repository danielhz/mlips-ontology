# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-alloy-hu2025 a mlips:TrainingDataset ;
    rdfs:label "Alloy data set (about 150,000 structures, 53 metallic elements)" ;
    mlips:coversMaterial entity:mat-alloy-hu2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published .

entity:ds-cathode-hu2025 a mlips:TrainingDataset ;
    rdfs:label "Cathode data set, one third of 88,692 structures" ;
    mlips:coversMaterial entity:mat-cathode-hu2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 29564 .

entity:ds-perovskite-hu2025 a mlips:TrainingDataset ;
