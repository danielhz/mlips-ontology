###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SUS2-MLIP a mlips:MLIPMethod ;
    rdfs:label "SUS2-MLIP (super-linear MLIP with universal scaling and ultra-small parameterisation)" ;
    mlips:hasHyperparameter entity:hp-basis-label-hu2025 ,
        mlips:cutoffRadius ,
        entity:hp-num-parameters-hu2025 ;
    mlips:hasImplementation entity:impl-SUS2-MLIP-hu2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:impl-SUS2-MLIP-hu2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SUS2-MLIP-hu2025 .

entity:lib-SUS2-MLIP-hu2025 a mlips:Library ;
    rdfs:label "SUS2-MLIP" ;
    rdfs:comment "Open-source implementation announced in the paper's code-availability statement." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-basis-label-hu2025 a mlips:Hyperparameter ;
    rdfs:label "SUS2-MLIP basis label" ;
    mlips:hyperparameterName "basis" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-num-parameters-hu2025 a mlips:Hyperparameter ;
    rdfs:label "Number of model parameters" ;
    mlips:hyperparameterName "num_parameters" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

