    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 20394 .

entity:ds-mpf-hu2025 a mlips:TrainingDataset ;
    rdfs:label "MPF.2021.2.8 (the M3GNet data set; 187,687 structures, 89 elements, noble gases excluded)" ;
    mlips:coversMaterial entity:mat-mpf-hu2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 187687 .

entity:ds-hh130-hu2025 a mlips:TrainingDataset ;
