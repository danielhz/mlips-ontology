###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:FieldSchNet a mlips:MLIPMethod ;
    rdfs:label "FieldSchNet (SchNet-type message passing with external electric-field dependent interactions)" ;
    mlips:hasLossFunction entity:loss-FieldSchNet-tiefenbacher2025 ;
    mlips:hasTrainingAlgorithm entity:alg-FieldSchNet-tiefenbacher2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-FieldSchNet-tiefenbacher2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-FieldSchNet-tiefenbacher2025 a mlips:LossFunction ;
    rdfs:label "Augmented MSE with energy weight 1 and force weight 10" .

entity:alg-FieldSchNet-tiefenbacher2025 a mls:Algorithm ;
    rdfs:label "Adam with plateau scheduler (factor 0.8 after 20 epochs), at most 5,000 epochs" .

entity:impl-FieldSchNet-tiefenbacher2025 a mlips:Implementation ;
    mlips:implementedIn mlips:SchNet .

