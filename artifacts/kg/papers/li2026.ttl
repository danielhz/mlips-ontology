@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-li2026 a mlips:BenchmarkStudy ;
    rdfs:label "Li et al. (2026): melt-quench failures of universal MLIPs for amorphous IrO2 and practical remedies" ;
    mlips:reportedIn entity:article-li2026 .

entity:article-li2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2606.16385> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Melt-Quench Failures and Practical Solutions for Universal Machine-Learning Interatomic Potentials in Amorphous Structure Generation" ;
    schema:author entity:person-Li-li2026 ,
        entity:person-An-li2026 ,
        entity:person-Guo-li2026 ,
        entity:person-Yang-li2026 ,
        entity:person-Wang-li2026 .

entity:person-Li-li2026 a schema:Person ;
    schema:name "Shuwei Li" ;
    schema:givenName "Shuwei" ;
    schema:familyName "Li" .

entity:person-An-li2026 a schema:Person ;
    schema:name "Yuqi An" ;
    schema:givenName "Yuqi" ;
    schema:familyName "An" .

entity:person-Guo-li2026 a schema:Person ;
    schema:name "Xingyu Guo" ;
    schema:givenName "Xingyu" ;
    schema:familyName "Guo" .

entity:person-Yang-li2026 a schema:Person ;
    schema:name "Wenqiang Yang" ;
    schema:givenName "Wenqiang" ;
    schema:familyName "Yang" .

entity:person-Wang-li2026 a schema:Person ;
    schema:name "Zhenbin Wang" ;
