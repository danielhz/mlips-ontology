    schema:familyName "Wang" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-a-iro2-li2026 a mlips:MaterialSystem ;
    rdfs:label "Amorphous IrO2 (96-atom AIMD cells and melt-quench models)" ;
    mlips:chemicalFormula "IrO2" ;
    mlips:materialClass "Amorphous oxide electrocatalyst" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-aimd-li2026 a mlips:DFTCalculation .

entity:calc-static-li2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-aimd-li2026 mlips:hasDFTSettings entity:calc-settings-aimd-li2026 .

entity:calc-settings-aimd-li2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "NPT melt-quench AIMD (Parrinello-Rahman, Langevin): 3000 K melt, quench to 100 K over 5 ps, 300 K equilibration; EDIFF 1e-5." .

entity:calc-static-li2026 mlips:hasDFTSettings entity:calc-settings-static-li2026 .

entity:calc-settings-static-li2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack with k_i |a_i| >= 20 A" ;
    rdfs:comment "Static references for configurations from MLIP trajectories." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-aimd-ft-li2026 a mlips:TrainingDataset ;
    rdfs:label "IrO2 AIMD configurations for UPET fine-tuning (0.8/0.1/0.1 split)" ;
    mlips:coversMaterial entity:mat-a-iro2-li2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-aimd-li2026 .

entity:ds-mtp-train-li2026 a mlips:TrainingDataset ;
    rdfs:label "IrO2 MTP training set (1,800 initial DFT snapshots plus active-learning additions)" ;
    mlips:coversMaterial entity:mat-a-iro2-li2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-static-li2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-aimd-ft-li2026 mlips:samplingStrategy
    entity:sampling-aimd-traj-li2026 .

entity:ds-mtp-train-li2026 mlips:samplingStrategy
    entity:sampling-mtp-al-li2026 .

entity:sampling-aimd-traj-li2026 a mlips:SamplingStrategy ;
    rdfs:label "Configurations from the IrO2 AIMD melt-quench trajectory" .

entity:sampling-mtp-al-li2026 a mlips:SamplingStrategy ;
    rdfs:label "AIMD snapshots of rutile (120 atoms) and disordered (96 atoms) IrO2 at 300-2500 K with +-5% strain, then learning-on-the-fly active learning in NVT and NPT melt-quench" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:PET a mlips:MLIPMethod ;
    rdfs:label "Point Edge Transformer (PET)" ;
    mlips:hasLossFunction entity:loss-PET-li2026 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-PET-li2026 a mlips:LossFunction ;
    rdfs:label "0.1 energy + 0.1 force + 10.0 stress (pressure-targeted fine-tuning)" .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ;
    mlips:hasImplementation entity:impl-MTP-li2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MTP-li2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-upet-ft-learningRate-li2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.00001"^^xsd:double .

entity:setting-upet-ft-numEpochs-li2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

entity:setting-mtp-cutoffRadius-li2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-mtp-momentLevel-li2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "16"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-grace-2l-li2026 a mlips:MLIPRun ;
    rdfs:label "GRACE-2L-OMAT as distributed" ;
    mlips:appliesMethod entity:GRACE ;
    mlips:produces entity:model-grace-2l-li2026 .

entity:model-grace-2l-li2026 a mlips:TrainedModel ;
    rdfs:label "GRACE-2L-OMAT" .

entity:run-orb-v3-li2026 a mlips:MLIPRun ;
    rdfs:label "ORB-v3 as distributed (MPtrj + Alex + OMat24)" ;
