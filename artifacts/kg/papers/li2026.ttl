    mlips:produces entity:model-orb-v3-li2026 .

entity:model-orb-v3-li2026 a mlips:TrainedModel ;
    rdfs:label "ORB-v3" .

entity:run-7net-omni-li2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Omni-i12 as distributed" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-7net-omni-li2026 .

entity:model-7net-omni-li2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Omni-i12" .

entity:run-mace-mpa-0-li2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa-0-li2026 .

entity:model-mace-mpa-0-li2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-uma-s-li2026 a mlips:MLIPRun ;
    rdfs:label "UMA-S as distributed" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-s-li2026 .

entity:model-uma-s-li2026 a mlips:TrainedModel ;
    rdfs:label "UMA-S" .

entity:run-upet-li2026 a mlips:MLIPRun ;
    rdfs:label "UPET PET-OAM-XL as distributed (pet-oam-xl-v1.0.0)" ;
    mlips:appliesMethod entity:PET ;
    mlips:produces entity:model-upet-li2026 .

entity:model-upet-li2026 a mlips:TrainedModel ;
    rdfs:label "PET-OAM-XL v1.0.0" .

entity:run-nequip-oam-xl-li2026 a mlips:MLIPRun ;
    rdfs:label "NequIP-OAM-XL as distributed" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-nequip-oam-xl-li2026 .

entity:model-nequip-oam-xl-li2026 a mlips:TrainedModel ;
    rdfs:label "NequIP-OAM-XL" .

entity:run-upet-ft-li2026 a mlips:MLIPRun ;
    rdfs:label "UPET fine-tuned on IrO2 AIMD configurations with stress-weighted loss (UPET-FT)" ;
    mlips:appliesMethod entity:PET ;
    mlips:runsOn entity:ds-aimd-ft-li2026 ;
    mlips:hasHyperparameterSetting entity:setting-upet-ft-learningRate-li2026 ,
        entity:setting-upet-ft-numEpochs-li2026 ;
    mlips:produces entity:model-upet-ft-li2026 .

entity:model-upet-ft-li2026 a mlips:TrainedModel ;
    rdfs:label "UPET-FT (IrO2)" .

entity:run-mtp-li2026 a mlips:MLIPRun ;
    rdfs:label "MTP for IrO2 trained with active learning" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-mtp-train-li2026 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-cutoffRadius-li2026 ,
        entity:setting-mtp-momentLevel-li2026 ;
    mlips:produces entity:model-mtp-li2026 .

entity:model-mtp-li2026 a mlips:TrainedModel ;
    rdfs:label "IrO2 MTP" .

# Registry stub for the externally trained model MatterSim-v1 (not trained in this paper).
entity:run-MatterSim-v1 a mlips:MLIPRun ;
