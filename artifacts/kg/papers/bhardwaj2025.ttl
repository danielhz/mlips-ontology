# Canonical Turtle for the protocol-derived encoding of:
#   Utkarsh Bhardwaj et al. (2025). A robust machine learned interatomic potential for Nb: collision cascade simulations with accurate non-equilibrium properties.
#   Modelling and Simulation in Materials Science and Engineering. doi:10.1088/1361-651x/ae0505  arXiv:2502.03126v1
#
# Version read: arxiv-preprint arXiv:2502.03126v1 (sha256 dba8255fa8863161...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 328 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/bhardwaj2025.yaml.
#
# Encoding scope: the SNAP potential (with ZBL) for niobium trained on 550
# PBE configurations selected by Vendi diversity scores and D-optimal
# design, with its validation/test MAEs. Elastic, thermal, defect and
# collision-cascade results are properties, not error metrics; the EAM and
# Finnis-Sinclair comparison potentials are not MLIPs.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-bhardwaj2025 a mlips:BenchmarkStudy ;
    rdfs:label "Bhardwaj et al. (2025): a SNAP potential for Nb with correct self-interstitial configurations for collision cascades" ;
    mlips:reportedIn entity:article-bhardwaj2025 .

entity:article-bhardwaj2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1361-651x/ae0505> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "A robust machine learned interatomic potential for Nb: collision cascade simulations with accurate non-equilibrium properties" ;
    schema:author <https://orcid.org/0000-0002-1100-6059> ,
        entity:person-Mishra-bhardwaj2025 ,
        entity:person-Mondal-bhardwaj2025 ,
        <https://orcid.org/0000-0002-0824-6086> .

<https://orcid.org/0000-0002-1100-6059> a schema:Person ;
    schema:name "Utkarsh Bhardwaj" ;
    schema:givenName "Utkarsh" ;
    schema:familyName "Bhardwaj" ;
    schema:identifier <https://orcid.org/0000-0002-1100-6059> .

entity:person-Mishra-bhardwaj2025 a schema:Person ;
    schema:name "Vinayak Mishra" ;
    schema:givenName "Vinayak" ;
    schema:familyName "Mishra" .

entity:person-Mondal-bhardwaj2025 a schema:Person ;
    schema:name "Suman Mondal" ;
    schema:givenName "Suman" ;
    schema:familyName "Mondal" .

<https://orcid.org/0000-0002-0824-6086> a schema:Person ;
    schema:name "Manoj Warrier" ;
    schema:givenName "Manoj" ;
    schema:familyName "Warrier" ;
    schema:identifier <https://orcid.org/0000-0002-0824-6086> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-nb-bhardwaj2025 a mlips:MaterialSystem ;
    rdfs:label "Niobium: strained bcc crystals, vacancies (up to four), self-interstitial configurations and liquid" ;
    mlips:chemicalFormula "Nb" ;
    mlips:materialClass "Refractory bcc metal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-bhardwaj2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-bhardwaj2025 mlips:hasDFTSettings entity:calc-settings-pbe-bhardwaj2025 .

entity:calc-settings-pbe-bhardwaj2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "Energies, forces and stresses; AIMD of defect and liquid configurations (settings not stated in the main text)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-nb-bhardwaj2025 a mlips:TrainingDataset ;
    rdfs:label "Nb training data (550 configurations; 90% training, 10% testing/validation)" ;
    mlips:coversMaterial entity:mat-nb-bhardwaj2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 550 ;
    mlips:hasDFTCalculation entity:calc-pbe-bhardwaj2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-nb-bhardwaj2025 mlips:samplingStrategy
    entity:sampling-vendi-bhardwaj2025 .

entity:sampling-vendi-bhardwaj2025 a mlips:SamplingStrategy ;
    rdfs:label "Strained, defect and liquid configurations (AIMD frames) selected per category by Vendi-score saturation and D-optimal design" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP ;
    mlips:hasTrainingAlgorithm entity:alg-SNAP-bhardwaj2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-twoJmax-bhardwaj2025 ;
    mlips:hasImplementation entity:impl-SNAP-bhardwaj2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

entity:alg-SNAP-bhardwaj2025 a mls:Algorithm ;
    rdfs:label "Linear regression on bispectrum components with ZBL short-range repulsion; hyperparameters by Bayesian optimisation" .

entity:impl-SNAP-bhardwaj2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-FitSNAP-LAMMPS-bhardwaj2025 .

entity:lib-FitSNAP-LAMMPS-bhardwaj2025 a mlips:Library ;
    rdfs:label "FitSNAP / LAMMPS" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-twoJmax-bhardwaj2025 a mlips:Hyperparameter ;
    rdfs:label "SNAP angular order 2Jmax of the bispectrum expansion" ;
    mlips:hyperparameterName "2Jmax" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-snap-nb-cutoffRadius-bhardwaj2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.11"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-snap-nb-bhardwaj2025 a mlips:MLIPRun ;
    rdfs:label "SNAP potential for Nb (jmax = 6, rcut = 5.11 A)" ;
    mlips:appliesMethod entity:SNAP ;
    mlips:runsOn entity:ds-nb-bhardwaj2025 ;
    mlips:hasHyperparameterSetting entity:setting-snap-nb-cutoffRadius-bhardwaj2025 ;
    mlips:produces entity:model-snap-nb-bhardwaj2025 .

entity:model-snap-nb-bhardwaj2025 a mlips:TrainedModel ;
    rdfs:label "Nb SNAP potential" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-bhardwaj2025 mlips:hasResult
    entity:result-snap-nb-bhardwaj2025 .

entity:result-snap-nb-bhardwaj2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-snap-nb-bhardwaj2025 ;
    mlips:targetMaterial entity:mat-nb-bhardwaj2025 ;
    mlips:hasAccuracyMetric entity:metric-snap-nb-1-bhardwaj2025 ,
        entity:metric-snap-nb-2-bhardwaj2025 ,
        entity:metric-snap-nb-3-bhardwaj2025 .

entity:metric-snap-nb-1-bhardwaj2025 a mlips:AccuracyMetric ;
    rdfs:label "Validation/test energy MAE (1.21e-5 eV/atom): Nb SNAP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.0121"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-snap-nb-2-bhardwaj2025 a mlips:AccuracyMetric ;
    rdfs:label "Validation/test force MAE (6.19e-5 eV/A): Nb SNAP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.0619"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-snap-nb-3-bhardwaj2025 a mlips:AccuracyMetric ;
    rdfs:label "Validation/test stress MAE in eV/A3: Nb SNAP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.0000000746"^^xsd:double .

