###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-LGPS-liu2026 a mlips:MaterialSystem ;
    rdfs:label "Li10GeP2S12 solid-state electrolyte (LGPS)" ;
    mlips:chemicalFormula "Li10GeP2S12" ;
    mlips:materialClass "Lithium thiophosphate solid electrolyte" .

entity:mat-LiCl-GaF3-liu2026 a mlips:MaterialSystem ;
    rdfs:label "LiCl(001)/GaF3(001) heterointerface" ;
    mlips:materialClass "Solid-solid ionic interface" .

entity:mat-graphene-water-liu2026 a mlips:MaterialSystem ;
    rdfs:label "Graphene-water interface (over 372 atoms)" ;
    mlips:materialClass "Solid-liquid interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-gw-dft-liu2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-gw-dft-liu2026 mlips:hasDFTSettings entity:calc-settings-gw-dft-liu2026 .

entity:calc-settings-gw-dft-liu2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    rdfs:comment "D3 dispersion; 1e-6 eV SCF and 0.02 eV/A force convergence; snapshots from classical MD (Tersoff graphene, rigid three-site water)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-lgps-liu2026 a mlips:TrainingDataset ;
    rdfs:label "LGPS data set published on DPAISquare" ;
    mlips:coversMaterial entity:mat-LGPS-liu2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-licl-gaf3-liu2026 a mlips:TrainingDataset ;
    rdfs:label "LiCl(001)/GaF3(001) interface data set of Ref. [123]" ;
    mlips:coversMaterial entity:mat-LiCl-GaF3-liu2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-graphene-water-liu2026 a mlips:TrainingDataset ;
    rdfs:label "Graphene-water interface DFT snapshots" ;
    mlips:coversMaterial entity:mat-graphene-water-liu2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-gw-dft-liu2026 .

