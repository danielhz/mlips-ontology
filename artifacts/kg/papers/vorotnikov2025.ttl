# Canonical Turtle for the protocol-derived encoding of:
#   Igor Leonidovich Vorotnikov et al. (2025). Low-rank matrix and tensor approximations for compression of machine-learning interatomic potentials.
#   The Journal of Chemical Physics. doi:10.1063/5.0300163  arXiv:2509.04440v2
#
# Version read: arxiv-preprint arXiv:2509.04440v2 (sha256 1157e1441a8368b3...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 346 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/vorotnikov2025.yaml.
#
# Encoding scope: the 20th-level MTPs fitted on the glycine
# molecular-crystal training set (base and compressed by matrix
# factorisation MF, Riemannian R-MF, rank-augmented MFRA and tensor-train
# TF, each at the optimal rank and at ~50 % compression; ensembles of 10)
# with the energy, force and stress RMSEs of Table III. The compressed
# potentials keep the MTP functional form with a factorised tensor of
# radial parameters, so they stay under the registry method MTP. The
# Mo-Nb-Ta-W and FLiNaK MTPs, the ETN comparison and the compressed ACE are
# reported in figures only (gaps).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-vorotnikov2025 a mlips:BenchmarkStudy ;
    rdfs:label "Vorotnikov et al. (2025): low-rank matrix and tensor compression of the radial parameters of moment tensor potentials (and ACE)" ;
    mlips:reportedIn entity:article-vorotnikov2025 .

entity:article-vorotnikov2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0300163> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Low-rank matrix and tensor approximations for compression of machine-learning interatomic potentials" ;
    schema:author entity:person-Vorotnikov-vorotnikov2025 ,
        <https://orcid.org/0009-0002-4389-4254> ,
        <https://orcid.org/0000-0001-7053-5295> ,
        <https://orcid.org/0000-0001-7606-7322> ,
        <https://orcid.org/0000-0003-3146-6455> .

entity:person-Vorotnikov-vorotnikov2025 a schema:Person ;
    schema:name "Igor Vorotnikov" ;
    schema:givenName "Igor" ;
    schema:familyName "Vorotnikov" .

<https://orcid.org/0009-0002-4389-4254> a schema:Person ;
    schema:name "Fedor Romashov" ;
    schema:givenName "Fedor" ;
    schema:familyName "Romashov" ;
    schema:identifier <https://orcid.org/0009-0002-4389-4254> .

<https://orcid.org/0000-0001-7053-5295> a schema:Person ;
    schema:name "Nikita Rybin" ;
    schema:givenName "Nikita" ;
    schema:familyName "Rybin" ;
    schema:identifier <https://orcid.org/0000-0001-7053-5295> .

<https://orcid.org/0000-0001-7606-7322> a schema:Person ;
    schema:name "Maxim Rakhuba" ;
    schema:givenName "Maxim" ;
    schema:familyName "Rakhuba" ;
    schema:identifier <https://orcid.org/0000-0001-7606-7322> .

<https://orcid.org/0000-0003-3146-6455> a schema:Person ;
    schema:name "Ivan S. Novikov" ;
    schema:givenName "Ivan S." ;
    schema:familyName "Novikov" ;
    schema:identifier <https://orcid.org/0000-0003-3146-6455> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-glycine-vorotnikov2025 a mlips:MaterialSystem ;
    rdfs:label "Glycine molecular crystals (alpha, beta, gamma polymorphs)" ;
    mlips:chemicalFormula "C2H5NO2" ;
    mlips:materialClass "Molecular crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbed3-vorotnikov2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbed3-vorotnikov2025 mlips:hasDFTSettings entity:calc-settings-pbed3-vorotnikov2025 .

entity:calc-settings-pbed3-vorotnikov2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "PBE+D3; data set taken from Ref. 27 (Table I)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-gly-vorotnikov2025 a mlips:TrainingDataset ;
    rdfs:label "Glycine training set of Ref. 27" ;
    mlips:coversMaterial entity:mat-glycine-vorotnikov2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 3127 ;
    mlips:hasDFTCalculation entity:calc-pbed3-vorotnikov2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-vorotnikov2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-vorotnikov2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-MTP-vorotnikov2025 a mlips:LossFunction ;
    rdfs:label "Weighted energy, force and stress squared errors (w_e = 1 eV^-2, w_f = 0.01 (eV/A)^-2, w_s = 0.001 eV^-2 for glycine)" .

entity:alg-MTP-vorotnikov2025 a mls:Algorithm ;
    rdfs:label "BFGS, 2,000 steps; Riemannian BFGS for R-MF; rank augmentation for MFRA" .

