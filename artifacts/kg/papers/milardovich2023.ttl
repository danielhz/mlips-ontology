@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-milardovich2023 a mlips:BenchmarkStudy ;
    rdfs:label "Milardovich et al. (2023): machine learning interatomic potential (GAP) for silicon nitride (Si3N4) by active learning" ;
    mlips:reportedIn entity:article-milardovich2023 .

