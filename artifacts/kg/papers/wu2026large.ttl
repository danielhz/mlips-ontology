@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wu2026large a mlips:BenchmarkStudy ;
    rdfs:label "Wu, Mäkinen, Alava and Esfandiarpour (2026): NEP for large-scale simulations of CrCoNi medium-entropy alloys" ;
    mlips:reportedIn entity:article-wu2026large .

