###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-crconi-wu2026large a mlips:MaterialSystem ;
    rdfs:label "Cr-Co-Ni system: FCC Ni, BCC Cr, HCP Co, binary and ternary (equiatomic and non-equiatomic) CrCoNi alloys" ;
    mlips:materialClass "medium-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-wu2026large a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-wu2026large mlips:hasDFTSettings entity:calc-settings-pbe-wu2026large .

entity:calc-settings-pbe-wu2026large a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "450"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack, minimum spacing 0.25 1/A" ;
    rdfs:comment "VASP 6.4.2, potpaw.PBE.64; collinear spin-polarised (initial 3 muB); 0.1 eV Methfessel-Paxton smearing." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-nep-wu2026large a mlips:TrainingDataset ;
    rdfs:label "Final NEP training set (3030 structures)" ;
    mlips:coversMaterial entity:mat-crconi-wu2026large ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 3030 ;
    mlips:hasDFTCalculation entity:calc-pbe-wu2026large .

entity:ds-val-wu2026large a mlips:TrainingDataset ;
    rdfs:label "Independent validation set (84 structures)" ;
    mlips:coversMaterial entity:mat-crconi-wu2026large ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 84 ;
    mlips:hasDFTCalculation entity:calc-pbe-wu2026large .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-nep-wu2026large mlips:samplingStrategy
    entity:sampling-init-wu2026large ,
    entity:sampling-al-wu2026large .

entity:ds-val-wu2026large mlips:samplingStrategy
    entity:sampling-val-md-wu2026large .

entity:sampling-init-wu2026large a mlips:SamplingStrategy ;
    rdfs:label "Existing MTP data (Cao et al. TS-0, TS-3, TS-f; CrCoNi subset of a CrCoFeNi set) plus FCC/BCC composition grid with random displacements, reduced by SOAP-PCA farthest-point sampling to 2000 structures" .

entity:sampling-al-wu2026large a mlips:SamplingStrategy ;
    rdfs:label "Active learning with NEP MD: elemental systems at 1-3000 K, point defects, stacking faults, compression and tension" .

entity:sampling-val-md-wu2026large a mlips:SamplingStrategy ;
    rdfs:label "2 ns NPT MD at 5-3000 K from seven initial structures, 12 frames each" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-wu2026large ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:GeometryOptimization .

entity:alg-NEP-wu2026large a mls:Algorithm ;
    rdfs:label "Trained for about 400,000 generations" .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nep-wu2026large a mlips:MLIPRun ;
    rdfs:label "NEP model for CrCoNi alloys" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-nep-wu2026large ;
    mlips:trainingHardware "8 Tesla V100 GPUs, 57 h" ;
    mlips:produces entity:model-nep-wu2026large .

entity:model-nep-wu2026large a mlips:TrainedModel ;
    rdfs:label "NEP CrCoNi (Wu et al. 2026)" .

entity:run-mtp-cao-wu2026large a mlips:MLIPRun ;
    rdfs:label "CrCoNi MTP of Cao et al. (Ref. 24) as distributed" ;
    mlips:appliesMethod entity:MTP ;
    mlips:produces entity:model-mtp-cao-wu2026large .

entity:model-mtp-cao-wu2026large a mlips:TrainedModel ;
    rdfs:label "MTP CrCoNi (Cao et al.)" .

