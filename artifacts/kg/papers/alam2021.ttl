# Canonical Turtle for the protocol-derived encoding of:
#   Masud Alam et al. (2021). Artificial neural network interatomic potential for dislocation and fracture properties of Molybdenum.
#   arXiv (Cornell University). doi:10.48550/arxiv.2112.04636  arXiv:2112.04636v1
#
# Version read: arxiv-preprint arXiv:2112.04636v1 (sha256 054a83c23159d15a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 575 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/alam2021.yaml.
#
# Encoding scope: the aenet Behler-Parrinello ANN for Mo (15 radial and
# 18 angular symmetry functions, 6.5 A cutoff, four layers) trained with
# BFGS on a DFT database of strained bcc/fcc/hcp/sc phases, surfaces,
# generalized stacking faults and traction-separation curves. Errors
# are given only as an upper bound (below 5 meV/atom). Dislocation-core,
# elastic, surface and fracture results are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-alam2021 a mlips:BenchmarkStudy ;
    rdfs:label "Alam and Lymperakis (2021): artificial neural network potential for dislocation and fracture properties of molybdenum" ;
    mlips:reportedIn entity:article-alam2021 .

entity:article-alam2021 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2112.04636> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "Artificial neural network interatomic potential for dislocation and fracture properties of Molybdenum" ;
    schema:author entity:person-Alam-alam2021 ,
        entity:person-Lymperakis-alam2021 .

entity:person-Alam-alam2021 a schema:Person ;
    schema:name "Masud Alam" ;
    schema:givenName "Masud" ;
    schema:familyName "Alam" .

entity:person-Lymperakis-alam2021 a schema:Person ;
    schema:name "Liverios Lymperakis" ;
    schema:givenName "Liverios" ;
    schema:familyName "Lymperakis" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mo-alam2021 a mlips:MaterialSystem ;
    rdfs:label "Molybdenum (bcc, fcc, hcp, sc under strain; surfaces, stacking faults, decohesion)" ;
    mlips:chemicalFormula "Mo" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-alam2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-alam2021 mlips:hasDFTSettings entity:calc-settings-vasp-alam2021 .

entity:calc-settings-vasp-alam2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Spin-polarized GGA, 400 eV, 6x6x6 k-mesh equivalent" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mo-alam2021 a mlips:TrainingDataset ;
    rdfs:label "Mo structure-energy database" ;
    mlips:coversMaterial entity:mat-mo-alam2021 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-alam2021 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mo-alam2021 mlips:samplingStrategy
    entity:sampling-db-alam2021 .

entity:sampling-db-alam2021 a mlips:SamplingStrategy ;
    rdfs:label "Material-property database: strained bulk phases, {100}/{110}/{111} surfaces, {112} and {100} generalized stacking faults along <111>, {110} traction-separation" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-alam2021 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-alam2021 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-HDNNP-alam2021 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-HDNNP-alam2021 a mlips:LossFunction ;
    rdfs:label "Energies" .

entity:alg-HDNNP-alam2021 a mls:Algorithm ;
    rdfs:label "BFGS, 200 iterations" .

entity:impl-HDNNP-alam2021 a mlips:Implementation ;
    mlips:implementedIn entity:lib-aenet-alam2021 .

entity:lib-aenet-alam2021 a mlips:Library ;
    rdfs:label "aenet" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ann-cutoffRadius-alam2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ann-alam2021 a mlips:MLIPRun ;
    rdfs:label "ANN potential for Mo" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-mo-alam2021 ;
    mlips:hasHyperparameterSetting entity:setting-ann-cutoffRadius-alam2021 ;
    mlips:produces entity:model-ann-alam2021 .

entity:model-ann-alam2021 a mlips:TrainedModel ;
    rdfs:label "ANN Mo (Alam 2021)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

