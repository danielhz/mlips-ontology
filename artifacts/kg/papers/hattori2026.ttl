# Q7 -- MLIP method, components, implementation
###############################################################################

entity:Allegro a mlips:MLIPMethod ;
    rdfs:label "Allegro (strictly local equivariant interatomic potential)" ;
    mlips:hasLossFunction entity:loss-Allegro-hattori2026 ;
    mlips:hasTrainingAlgorithm entity:alg-Allegro-hattori2026 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-Allegro-hattori2026 .

entity:loss-Allegro-hattori2026 a mlips:LossFunction ;
    rdfs:label "RMSE-type loss on per-atom cohesive energy and forces (1:1), plus stress (1:1:1) for MatPES and hybrid" .

entity:alg-Allegro-hattori2026 a mls:Algorithm ;
    rdfs:label "Adam; shift parameters set to zero and scales to one so that the cohesive energy is a sum of edge energies" .

entity:impl-Allegro-hattori2026 a mlips:Implementation ;
    mlips:implementedIn mlips:NequIP .

