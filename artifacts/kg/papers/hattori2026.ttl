###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-wb97md3-hattori2026 a mlips:DFTCalculation .

entity:calc-r2scan-hattori2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97md3-hattori2026 mlips:hasDFTSettings entity:calc-settings-wb97md3-hattori2026 .

entity:calc-settings-wb97md3-hattori2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-Psi4-hattori2026 ;
    mlips:xcFunctional entity:xc-wB97M-D3-BJ-hattori2026 ;
    mlips:basisSet "def2-TZVPPD" ;
    rdfs:comment "SPICE2 level of theory; Transition1x reactants, transition states and products recomputed at this level." .

entity:calc-r2scan-hattori2026 mlips:hasDFTSettings entity:calc-settings-r2scan-hattori2026 .

entity:calc-settings-r2scan-hattori2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-r2SCAN-hattori2026 ;
    rdfs:comment "MatPES r2SCAN subset." .

entity:lib-Psi4-hattori2026 a mlips:Library ;
    rdfs:label "Psi4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-wB97M-D3-BJ-hattori2026 a mlips:XCFunctional ;
    rdfs:label "wB97M-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-r2SCAN-hattori2026 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-spice2-hattori2026 a mlips:TrainingDataset ;
    rdfs:label "SPICE2" ;
    mlips:coversMaterial entity:mat-molecules-hattori2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-wb97md3-hattori2026 .

entity:ds-matpes-hattori2026 a mlips:TrainingDataset ;
    rdfs:label "MatPES r2SCAN subset" ;
    mlips:coversMaterial entity:mat-inorganic-hattori2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-r2scan-hattori2026 .

entity:ds-hybrid-hattori2026 a mlips:TrainingDataset ;
    rdfs:label "Hybrid SPICE2 + MatPES (molecules in 500 A boxes with zero stress)" ;
    mlips:coversMaterial entity:mat-molecules-hattori2026 ,
        entity:mat-inorganic-hattori2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented .

