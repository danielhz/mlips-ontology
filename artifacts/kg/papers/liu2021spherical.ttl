entity:SphereNet a mlips:MLIPMethod ;
    rdfs:label "SphereNet (spherical message passing neural network)" ;
    mlips:hasLossFunction entity:loss-SphereNet-liu2021spherical ;
    mlips:hasTrainingAlgorithm entity:alg-SphereNet-liu2021spherical ;
    mlips:hasImplementation entity:impl-SphereNet-liu2021spherical .

entity:loss-SphereNet-liu2021spherical a mlips:LossFunction ;
    rdfs:label "Joint energy and force loss with force-over-energy weight (WoFE) 100 or 1000 for MD17" .

entity:alg-SphereNet-liu2021spherical a mls:Algorithm ;
    rdfs:label "Adam; hyperparameters by grid search" .

entity:impl-SphereNet-liu2021spherical a mlips:Implementation ;
    mlips:implementedIn entity:lib-DIG-liu2021spherical .

entity:lib-DIG-liu2021spherical a mlips:Library ;
    rdfs:label "DIG" ;
    rdfs:comment "Dive into Graphs library, https://github.com/divelab/DIG" ;
    mlips:candidateForVocabulary mlips:Library .

