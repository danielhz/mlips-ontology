# Canonical Turtle for the protocol-derived encoding of:
#   Jesper Byggmästar et al. (2022). Simple machine-learned interatomic potentials for complex alloys.
#   Physical Review Materials. doi:10.1103/physrevmaterials.6.083801  arXiv:2203.08458v2
#
# Version read: arxiv-preprint arXiv:2203.08458v2 (sha256 c43dc09333330914...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 357 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/byggmastar2022.yaml.
#
# Encoding scope: GAPs (QUIP, screened-Coulomb repulsion) with descriptor
# combinations 2b, 2b+EAM, 2b+N EAM, 2b+3b, 2b+3b+EAM, 2b+SOAP and
# 2b+cSOAP trained on the Mo-Nb-Ta-V-W data of Ref. 9 (2,859 structures),
# with the one test error stated in the text (liquid energy RMSE of the
# 2b+3b+EAM GAP on the full data), and the final 2b+3b+EAM tabGAP.
# Learning curves (Figs. 1, 3, 4), speed-accuracy curves (Fig. 5) and the
# per-class test errors of the final potentials (Fig. 6) are figure-only;
# Table I material properties are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-byggmastar2022 a mlips:BenchmarkStudy ;
    rdfs:label "Byggmästar et al. (2022): learning curves of low-dimensional (2b, 3b, EAM) versus SOAP descriptors in GAPs for Mo-Nb-Ta-V-W, and the 2b+3b+EAM tabGAP" ;
    mlips:reportedIn entity:article-byggmastar2022 .

entity:article-byggmastar2022 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.6.083801> ;
    schema:datePublished "2022"^^xsd:gYear ;
    schema:name "Simple machine-learned interatomic potentials for complex alloys" ;
    schema:author <https://orcid.org/0000-0002-4898-6150> ,
        entity:person-Nordlund-byggmastar2022 ,
        entity:person-Djurabekova-byggmastar2022 .

<https://orcid.org/0000-0002-4898-6150> a schema:Person ;
    schema:name "J. Byggmästar" ;
    schema:givenName "J." ;
    schema:familyName "Byggmästar" ;
    schema:identifier <https://orcid.org/0000-0002-4898-6150> .

entity:person-Nordlund-byggmastar2022 a schema:Person ;
    schema:name "K. Nordlund" ;
    schema:givenName "K." ;
    schema:familyName "Nordlund" .

entity:person-Djurabekova-byggmastar2022 a schema:Person ;
    schema:name "F. Djurabekova" ;
    schema:givenName "F." ;
    schema:familyName "Djurabekova" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-hea-byggmastar2022 a mlips:MaterialSystem ;
    rdfs:label "Mo-Nb-Ta-V-W alloys over the full composition range: random and ordered bcc crystals, vacancies and interstitials in equiatomic MoNbTaVW, liquids, surfaces, dimers, short-distance structures and pure-element data" ;
    mlips:materialClass "High-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-byggmastar2022 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-byggmastar2022 mlips:hasDFTSettings entity:calc-settings-pbe-byggmastar2022 .

entity:calc-settings-pbe-byggmastar2022 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Settings as in Ref. 9 (not repeated here)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-full-byggmastar2022 a mlips:TrainingDataset ;
    rdfs:label "Mo-Nb-Ta-V-W training data of Ref. 9 (1,614 alloy and 1,245 pure-element structures, 146,101 atoms)" ;
    mlips:coversMaterial entity:mat-hea-byggmastar2022 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 2859 ;
    mlips:hasDFTCalculation entity:calc-pbe-byggmastar2022 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-byggmastar2022 .

entity:impl-GAP-byggmastar2022 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-2b3beam-cutoffRadius-byggmastar2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-gap-2b3beam-angularCutoff-byggmastar2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4.1"^^xsd:double .

entity:setting-gap-2b3beam-numSparseConfigs-byggmastar2022 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "300"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-2b3beam-byggmastar2022 a mlips:MLIPRun ;
    rdfs:label "GAP 2b+3b+EAM trained on the full Mo-Nb-Ta-V-W data (mean of three potentials)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-full-byggmastar2022 ;
    mlips:hasHyperparameterSetting entity:setting-gap-2b3beam-cutoffRadius-byggmastar2022 ,
        entity:setting-gap-2b3beam-angularCutoff-byggmastar2022 ,
        entity:setting-gap-2b3beam-numSparseConfigs-byggmastar2022 ;
    mlips:produces entity:model-gap-2b3beam-byggmastar2022 .

entity:model-gap-2b3beam-byggmastar2022 a mlips:TrainedModel ;
    rdfs:label "MoNbTaVW GAP 2b+3b+EAM" .

entity:run-tabgap-2b3beam-byggmastar2022 a mlips:MLIPRun ;
    rdfs:label "tabGAP 2b+3b+EAM for Mo-Nb-Ta-V-W (tabulated cubic-spline version of the 2b+3b+EAM GAP)" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-full-byggmastar2022 ;
    mlips:produces entity:model-tabgap-2b3beam-byggmastar2022 .

entity:model-tabgap-2b3beam-byggmastar2022 a mlips:TrainedModel ;
    rdfs:label "MoNbTaVW tabGAP 2b+3b+EAM (2022)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-byggmastar2022 mlips:hasResult
    entity:result-gap-2b3beam-liq-byggmastar2022 .

entity:result-gap-2b3beam-liq-byggmastar2022 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-gap-2b3beam-byggmastar2022 ;
    mlips:targetMaterial entity:mat-hea-byggmastar2022 ;
    mlips:hasAccuracyMetric entity:metric-gap-2b3beam-liq-1-byggmastar2022 .

entity:metric-gap-2b3beam-liq-1-byggmastar2022 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on liquid hea: MoNbTaVW GAP 2b+3b+EAM" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "12.4"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

