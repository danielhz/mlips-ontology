# Canonical Turtle for the protocol-derived encoding of:
#   Jesper Byggmästar et al. (2026). Nine-element machine-learned interatomic potentials for multiphase refractory alloys.
#   arXiv (Cornell University). doi:10.48550/arxiv.2603.04147  arXiv:2603.04147v1
#
# Version read: arxiv-preprint arXiv:2603.04147v1 (sha256 d56f0a7d73d6219c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 684 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/byggmastar2026.yaml.
#
# Encoding scope: the tabGAP and the NEP for Ti-Zr-Hf-V-Nb-Ta-Cr-Mo-W
# trained on the RHEA database (22,477 structures, 694,078 atoms) built
# with a cross-sampling strategy between the two architectures. Training
# and test errors appear only as RMSEs inside Fig. 2 parity plots and
# speeds only in SI Fig. S2, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-byggmastar2026 a mlips:BenchmarkStudy ;
    rdfs:label "Byggmästar, Lopes, Fan and Ala-Nissila (2026): nine-element tabGAP and NEP potentials for multiphase refractory alloys" ;
    mlips:reportedIn entity:article-byggmastar2026 .

entity:article-byggmastar2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2603.04147> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Nine-element machine-learned interatomic potentials for multiphase refractory alloys" ;
    schema:author entity:person-Byggmastar-byggmastar2026 ,
        entity:person-Lopes-byggmastar2026 ,
        entity:person-Fan-byggmastar2026 ,
        entity:person-AlaNissila-byggmastar2026 .

entity:person-Byggmastar-byggmastar2026 a schema:Person ;
    schema:name "Jesper Byggmästar" ;
    schema:givenName "Jesper" ;
    schema:familyName "Byggmästar" .

entity:person-Lopes-byggmastar2026 a schema:Person ;
    schema:name "Tiago Lopes" ;
    schema:givenName "Tiago" ;
    schema:familyName "Lopes" .

entity:person-Fan-byggmastar2026 a schema:Person ;
    schema:name "Zheyong Fan" ;
    schema:givenName "Zheyong" ;
    schema:familyName "Fan" .

entity:person-AlaNissila-byggmastar2026 a schema:Person ;
    schema:name "Tapio Ala-Nissila" ;
    schema:givenName "Tapio" ;
    schema:familyName "Ala-Nissila" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-rhea-byggmastar2026 a mlips:MaterialSystem ;
    rdfs:label "Refractory alloys of Ti, Zr, Hf, V, Nb, Ta, Cr, Mo and W: pure metals, solid solutions, Laves and other intermetallics, liquids and glasses" ;
    mlips:materialClass "refractory high-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-byggmastar2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-byggmastar2026 mlips:hasDFTSettings entity:calc-settings-pbe-byggmastar2026 .

entity:calc-settings-pbe-byggmastar2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    rdfs:comment "PAW 5.4 (pv for Cr and Ta, sv for the others); consistent inputs for all structures." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-rhea-byggmastar2026 a mlips:TrainingDataset ;
    rdfs:label "RHEA database (22,477 structures, 694,078 atoms)" ;
    mlips:coversMaterial entity:mat-rhea-byggmastar2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 22477 ;
    mlips:hasDFTCalculation entity:calc-pbe-byggmastar2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-rhea-byggmastar2026 mlips:samplingStrategy
    entity:sampling-cross-byggmastar2026 .

entity:sampling-cross-byggmastar2026 a mlips:SamplingStrategy ;
    rdfs:label "Iterative cross-sampling: MD/relaxations half with tabGAP and half with NEP, adding structures where the two MLIPs disagree; plus targeted alloy, defect, liquid and crystal-phase structures" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-tabGAP-byggmastar2026 ;
    mlips:hasImplementation entity:impl-tabGAP-byggmastar2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:GeometryOptimization .

entity:alg-tabGAP-byggmastar2026 a mls:Algorithm ;
    rdfs:label "Low-dimensional GAP (2b, 3b, EAM-like descriptors) trained with QUIP and tabulated" .

entity:impl-tabGAP-byggmastar2026 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-byggmastar2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-NEP-byggmastar2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:GeometryOptimization .

entity:alg-NEP-byggmastar2026 a mls:Algorithm ;
    rdfs:label "Single-hidden-layer NN with radial and angular (3-, 4-, 5-body) descriptors; small (nmax 4 4) and large (nmax 8 8) models with lmax 4 2 1 and 80 neurons" .

entity:impl-NEP-byggmastar2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-byggmastar2026 .

entity:lib-GPUMD-byggmastar2026 a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nep-cutoffRadius-byggmastar2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-tabgap-byggmastar2026 a mlips:MLIPRun ;
    rdfs:label "Nine-element RHEA tabGAP (final version)" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-rhea-byggmastar2026 ;
    mlips:produces entity:model-tabgap-byggmastar2026 .

entity:model-tabgap-byggmastar2026 a mlips:TrainedModel ;
    rdfs:label "RHEA tabGAP (9 elements)" .

entity:run-nep-byggmastar2026 a mlips:MLIPRun ;
    rdfs:label "Nine-element RHEA NEP (final version)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-rhea-byggmastar2026 ;
    mlips:hasHyperparameterSetting entity:setting-nep-cutoffRadius-byggmastar2026 ;
    mlips:produces entity:model-nep-byggmastar2026 .

entity:model-nep-byggmastar2026 a mlips:TrainedModel ;
    rdfs:label "RHEA NEP (9 elements)" .

