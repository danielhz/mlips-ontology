# Canonical Turtle for the protocol-derived encoding of:
#   Bohayra Mortazavi et al. (2021). First‐Principles Multiscale Modeling of Mechanical Properties in Graphene/Borophene Heterostructures Empowered by Machine‐Learning Interatomic Potentials.
#   Advanced Materials. doi:10.1002/adma.202102807
#
# Version read: submittedVersion (sha256 9b9b11aa50910d03...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 524 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/mortazavi2021.yaml.
#
# Encoding scope: MTPs (MLIP package) for pristine graphene and chi3
# borophene (329 parameters) and one MTP per coplanar
# graphene/borophene heterostructure model (449 parameters), each fitted
# to subsampled AIMD trajectories of stress-free and strained cells
# (200-1000 K) with a preliminary-MTP refinement step. No energy/force
# error metrics are reported; stress-strain, elastic, strength and
# phonon comparisons and the finite-element upscaling are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mortazavi2021 a mlips:BenchmarkStudy ;
    rdfs:label "Mortazavi et al. (2021): first-principles multiscale modelling of graphene/borophene heterostructures with passively fitted MTPs" ;
    mlips:reportedIn entity:article-mortazavi2021 .

entity:article-mortazavi2021 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1002/adma.202102807> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "First‐Principles Multiscale Modeling of Mechanical Properties in Graphene/Borophene Heterostructures Empowered by Machine‐Learning Interatomic Potentials" ;
    schema:author <https://orcid.org/0000-0003-3031-5057> ,
        entity:person-Silani-mortazavi2021 ,
        entity:person-Podryabinkin-mortazavi2021 ,
        entity:person-Rabczuk-mortazavi2021 ,
        entity:person-Zhuang-mortazavi2021 ,
        entity:person-Shapeev-mortazavi2021 .

<https://orcid.org/0000-0003-3031-5057> a schema:Person ;
    schema:name "Bohayra Mortazavi" ;
    schema:givenName "Bohayra" ;
    schema:familyName "Mortazavi" ;
    schema:identifier <https://orcid.org/0000-0003-3031-5057> .

entity:person-Silani-mortazavi2021 a schema:Person ;
    schema:name "Mohammad Silani" ;
    schema:givenName "Mohammad" ;
    schema:familyName "Silani" .

entity:person-Podryabinkin-mortazavi2021 a schema:Person ;
    schema:name "Evgeny V. Podryabinkin" ;
    schema:givenName "Evgeny V." ;
    schema:familyName "Podryabinkin" .

entity:person-Rabczuk-mortazavi2021 a schema:Person ;
