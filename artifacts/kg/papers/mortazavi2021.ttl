    schema:givenName "Alexander V." ;
    schema:familyName "Shapeev" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-gr-mortazavi2021 a mlips:MaterialSystem ;
    rdfs:label "Graphene" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "2D material" .

entity:mat-b-mortazavi2021 a mlips:MaterialSystem ;
    rdfs:label "chi3 borophene" ;
    mlips:chemicalFormula "B" ;
    mlips:materialClass "2D material" .

entity:mat-grb-mortazavi2021 a mlips:MaterialSystem ;
    rdfs:label "Coplanar graphene/borophene heterostructures" ;
    mlips:materialClass "2D material" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-mortazavi2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-mortazavi2021 mlips:hasDFTSettings entity:calc-settings-vasp-mortazavi2021 .

entity:calc-settings-vasp-mortazavi2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "2x2x1 for AIMD datasets" ;
    rdfs:comment "Nose NVT AIMD with 1 fs steps" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-gr-mortazavi2021 a mlips:TrainingDataset ;
    rdfs:label "Graphene AIMD training set" ;
    mlips:coversMaterial entity:mat-gr-mortazavi2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-mortazavi2021 .

entity:ds-b-mortazavi2021 a mlips:TrainingDataset ;
    rdfs:label "Borophene AIMD training set" ;
    mlips:coversMaterial entity:mat-b-mortazavi2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-mortazavi2021 .

entity:ds-grb-mortazavi2021 a mlips:TrainingDataset ;
    rdfs:label "Graphene/borophene heterostructure AIMD training sets (one per model)" ;
    mlips:coversMaterial entity:mat-grb-mortazavi2021 ,
        entity:mat-gr-mortazavi2021 ,
        entity:mat-b-mortazavi2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-mortazavi2021 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gr-mortazavi2021 mlips:samplingStrategy
    entity:sampling-aimd-mortazavi2021 .

entity:ds-b-mortazavi2021 mlips:samplingStrategy
    entity:sampling-aimd-mortazavi2021 .

entity:ds-grb-mortazavi2021 mlips:samplingStrategy
    entity:sampling-aimd-het-mortazavi2021 .

entity:sampling-aimd-mortazavi2021 a mlips:SamplingStrategy ;
    rdfs:label "AIMD of stress-free and six strained cells with temperature ramped from 200 to 1000 K (under 4,500 steps), every 4th step kept, then configurations selected by a preliminary MTP" .

entity:sampling-aimd-het-mortazavi2021 a mlips:SamplingStrategy ;
    rdfs:label "Heterostructure AIMD with the same procedure, plus pristine trajectories subsampled every 20th step" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-mortazavi2021 ;
    mlips:hasImplementation entity:impl-MTP-mortazavi2021 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-MTP-mortazavi2021 a mlips:LossFunction ;
    rdfs:label "Energies, forces and stresses (passive fitting)" .

entity:impl-MTP-mortazavi2021 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

