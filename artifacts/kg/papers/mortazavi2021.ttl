entity:run-mtp-grb-mortazavi2021 a mlips:MLIPRun ;
    rdfs:label "MTPs for graphene/borophene heterostructure models (449 parameters each)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-grb-mortazavi2021 ;
    mlips:produces entity:model-mtp-grb-mortazavi2021 .

entity:model-mtp-grb-mortazavi2021 a mlips:TrainedModel ;
