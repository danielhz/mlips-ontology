    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-gr-mortazavi2021 ;
    mlips:produces entity:model-mtp-gr-mortazavi2021 .

entity:model-mtp-gr-mortazavi2021 a mlips:TrainedModel ;
    rdfs:label "MTP graphene (Mortazavi 2021)" .

entity:run-mtp-b-mortazavi2021 a mlips:MLIPRun ;
    rdfs:label "MTP for chi3 borophene (329 parameters)" ;
