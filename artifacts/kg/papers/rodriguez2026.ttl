###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasLossFunction entity:loss-ANI-rodriguez2026 ;
    mlips:hasTrainingAlgorithm entity:alg-ANI-rodriguez2026 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-ANI-rodriguez2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-ANI-rodriguez2026 a mlips:LossFunction ;
    rdfs:label "Energy + 0.30 force + 0.09 Hessian (or HVP) terms" .

entity:alg-ANI-rodriguez2026 a mls:Algorithm ;
    rdfs:label "AdamW for weights, SGD for biases (lr 1e-4, weight decay 1e-2); ensembles of 5 seeds" .

entity:impl-ANI-rodriguez2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PyTorch-PHL-code-rodriguez2026 .

entity:lib-PyTorch-PHL-code-rodriguez2026 a mlips:Library ;
    rdfs:label "PyTorch (PHL code)" ;
    mlips:candidateForVocabulary mlips:Library .

