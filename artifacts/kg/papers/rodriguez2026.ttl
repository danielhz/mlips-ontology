###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-wb97xd-rodriguez2026 mlips:hasDFTSettings entity:calc-settings-wb97xd-rodriguez2026 .

entity:calc-settings-wb97xd-rodriguez2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:Gaussian ;
    mlips:xcFunctional entity:xc-wB97XD-rodriguez2026 ;
    mlips:basisSet "6-31G(d)" ;
    rdfs:comment "Gaussian16; analytic Hessians from frequency calculations" .

