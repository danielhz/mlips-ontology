###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tic-seal2025 a mlips:MaterialSystem ;
    rdfs:label "TiC+ cation with methane: reactant, transition state and product basins of the C-H activation (doublet)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mcpdft-seal2025 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mcpdft-seal2025 mlips:hasWaveFunctionSettings entity:calc-settings-mcpdft-seal2025 .

entity:calc-settings-mcpdft-seal2025 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-MC-PDFT-tPBE-on-SA-CASSCF-7e-9o-seal2025 ;
    mlips:basisSet "def2-TZVP" .

entity:wf-MC-PDFT-tPBE-on-SA-CASSCF-7e-9o-seal2025 a mlips:WfMethod ;
    rdfs:label "MC-PDFT (tPBE) on SA-CASSCF(7e,9o)" ;
    rdfs:comment "State average over the two lowest doublets, def2-TZVP, density fitting, grid 6; PySCF 2.4.0 with PySCF-forge (Materials and Methods)." ;
    mlips:candidateForVocabulary mlips:WfMethod .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-final-seal2025 a mlips:TrainingDataset ;
    rdfs:label "Final MC-PDFT training set after four active-learning rounds" ;
    mlips:coversMaterial entity:mat-tic-seal2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 831 ;
    mlips:hasReferenceCalculation entity:calc-mcpdft-seal2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-final-seal2025 mlips:samplingStrategy
    entity:sampling-deal-seal2025 .

entity:sampling-deal-seal2025 a mlips:SamplingStrategy ;
    rdfs:label "DEAL active learning: query-by-committee pre-filtering, then sparse-GP (FLARE ACE-B2 descriptors) selection from equilibrium and biased MD; WASP orbital-guess interpolation and an MLP-consistency check before labelling" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-seal2025 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-seal2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numEpochs ,
        mlips:learningRate ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-MACE-seal2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MACE-seal2025 a mlips:LossFunction ;
    rdfs:label "Weighted RMSE of energies and forces (1:100, then 1000:100 in a second stage)" .

entity:alg-MACE-seal2025 a mls:Algorithm ;
    rdfs:label "AMSGrad" .

entity:impl-MACE-seal2025 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mace-final-cutoffRadius-seal2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-mace-final-numFeatures-seal2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-mace-final-numEpochs-seal2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "400"^^xsd:integer .

entity:setting-mace-final-learningRate-seal2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-mace-final-batchSize-seal2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "8"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-final-seal2025 a mlips:MLIPRun ;
    rdfs:label "MACE (L = 1, 128 channels) trained on the final MC-PDFT data set" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-final-seal2025 ;
    mlips:hasHyperparameterSetting entity:setting-mace-final-cutoffRadius-seal2025 ,
        entity:setting-mace-final-numFeatures-seal2025 ,
        entity:setting-mace-final-numEpochs-seal2025 ,
        entity:setting-mace-final-learningRate-seal2025 ,
        entity:setting-mace-final-batchSize-seal2025 ;
    mlips:produces entity:model-mace-final-seal2025 .

entity:model-mace-final-seal2025 a mlips:TrainedModel ;
    rdfs:label "TiC+/CH4 MC-PDFT MACE (final round)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-seal2025 mlips:hasResult
    entity:result-mace-final-test-seal2025 .

entity:result-mace-final-test-seal2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-final-seal2025 ;
    mlips:targetMaterial entity:mat-tic-seal2025 ;
    mlips:hasAccuracyMetric entity:metric-mace-final-test-1-seal2025 ,
        entity:metric-mace-final-test-2-seal2025 .

entity:metric-mace-final-test-1-seal2025 a mlips:AccuracyMetric ;
    rdfs:label "test force MAE in kJ/(mol A) on tic: MC-PDFT MACE final" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.7"^^xsd:double .

entity:metric-mace-final-test-2-seal2025 a mlips:AccuracyMetric ;
    rdfs:label "test energy MAE in kJ/mol on tic: MC-PDFT MACE final" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.35"^^xsd:double .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The MACE model takes about 15 ms per time step on an NVIDIA A100, against about four minutes for one analytical MC-PDFT gradient on two AMD EPYC cores (Fig. 4, Results); the MLP figure is approximate.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Errors are in kJ/mol and kJ/(mol A), which the schema lacks; recorded with unit null. Errors of the earlier rounds are figure-only (Fig. 4).
# - The energy MAE is not stated as per atom or per configuration. Free-energy profiles and barriers are properties.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/seal2025.yaml) until the schema has terms for them.

