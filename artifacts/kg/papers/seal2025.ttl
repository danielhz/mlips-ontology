# Canonical Turtle for the protocol-derived encoding of:
#   Aniruddha Seal et al. (2025). Weighted active space protocol for multireference machine-learned potentials.
#   Proceedings of the National Academy of Sciences. doi:10.1073/pnas.2513693122  arXiv:2505.10505v1
#
# Version read: arxiv-preprint arXiv:2505.10505v1 (sha256 bb683c7d37e51050...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 391 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/seal2025.yaml.
#
# Encoding scope: the multireference reference (SA-CASSCF(7e,9o) /
# MC-PDFT with the tPBE on-top functional, def2-TZVP, PySCF), the
# DEAL/WASP active-learning data set (229 initial configurations from
# MC-PDFT AIMD, about 150 added per round over four rounds, 831 in the
# final set), the final MACE model (L = 1, 128 channels, 6 A, 400
# epochs) and its test MAEs after the last round. Reaction free energies
# and barriers are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-seal2025 a mlips:BenchmarkStudy ;
    rdfs:label "Seal et al. (2025): weighted active-space protocol (WASP) for a MACE potential trained on MC-PDFT data for TiC+-catalysed methane C-H activation" ;
    mlips:reportedIn entity:article-seal2025 .

entity:article-seal2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1073/pnas.2513693122> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Weighted active space protocol for multireference machine-learned potentials" ;
    schema:author entity:person-Seal-seal2025 ,
        entity:person-Perego-seal2025 ,
        entity:person-Hennefarth-seal2025 ,
        entity:person-Raucci-seal2025 ,
        <https://orcid.org/0000-0002-9118-6239> ,
        <https://orcid.org/0000-0002-8829-9726> ,
        <https://orcid.org/0000-0001-6550-3272> ,
        entity:person-Gagliardi-seal2025 .

