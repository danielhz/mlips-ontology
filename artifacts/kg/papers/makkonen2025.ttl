# Canonical Turtle for the protocol-derived encoding of:
#   Eetu Makkonen et al. (2025). Fast machine learned interatomic potential for hydrogen-induced embrittlement in α-Fe.
#   arXiv (Cornell University). doi:10.48550/arxiv.2511.21464  arXiv:2511.21464v2
#
# Version read: arxiv-preprint arXiv:2511.21464v2 (sha256 83bbcc1b2dbaa515...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 683 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/makkonen2025.yaml.
#
# Encoding scope: the Fe-H GAP (2b + 3b + EAM descriptors) and its
# tabulated version (tabGAP), trained on the alpha-Fe data of Byggmästar
# et al. extended with Fe-H structures, with training and test RMSEs
# (Table II) and single-core MD cost (Table III); the literature Meng NNIP
# is timed as distributed. EAM potentials are classical. H solution,
# trapping, migration and dislocation properties are property results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-makkonen2025 a mlips:BenchmarkStudy ;
    rdfs:label "Makkonen, Lopez-Cazalilla and Djurabekova (2025): a fast tabGAP for hydrogen embrittlement in alpha-Fe" ;
    mlips:reportedIn entity:article-makkonen2025 .

entity:article-makkonen2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2511.21464> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Fast machine learned interatomic potential for hydrogen-induced embrittlement in α-Fe" ;
    schema:author entity:person-Makkonen-makkonen2025 ,
        entity:person-LopezCazalilla-makkonen2025 ,
        entity:person-Djurabekova-makkonen2025 .

entity:person-Makkonen-makkonen2025 a schema:Person ;
    schema:name "Eetu Makkonen" ;
    schema:givenName "Eetu" ;
    schema:familyName "Makkonen" .

entity:person-LopezCazalilla-makkonen2025 a schema:Person ;
    schema:name "Alvaro Lopez-Cazalilla" ;
    schema:givenName "Alvaro" ;
    schema:familyName "Lopez-Cazalilla" .

entity:person-Djurabekova-makkonen2025 a schema:Person ;
    schema:name "Flyura Djurabekova" ;
    schema:givenName "Flyura" ;
    schema:familyName "Djurabekova" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-feh-makkonen2025 a mlips:MaterialSystem ;
    rdfs:label "alpha-Fe with interstitial H, vacancies, self-interstitials, dislocations, surfaces and short-range H-H configurations" ;
    mlips:materialClass "bcc metal with hydrogen" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-makkonen2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-makkonen2025 mlips:hasDFTSettings entity:calc-settings-pbe-makkonen2025 .

entity:calc-settings-pbe-makkonen2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "k-point spacing 0.15 1/A" ;
    rdfs:comment "Fe_sv (16 electrons) and standard H PAW; aspherical PAW contributions; collinear ferromagnetic; Methfessel-Paxton 0.1 eV; settings as in Byggmästar et al." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-feh-makkonen2025 a mlips:TrainingDataset ;
    rdfs:label "Fe-H data set (2686 structures; 90% training, 10% per-category test)" ;
    mlips:coversMaterial entity:mat-feh-makkonen2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 2686 ;
    mlips:hasDFTCalculation entity:calc-pbe-makkonen2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-feh-makkonen2025 mlips:samplingStrategy
    entity:sampling-feh-makkonen2025 .

entity:sampling-feh-makkonen2025 a mlips:SamplingStrategy ;
    rdfs:label "Byggmästar et al. alpha-Fe data plus 1609 new Fe-H structures (random displacements, MD snapshots, vacancy-H, short-range H-H and H-H-H, SIA-H, O-site H, dislocation-H)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-makkonen2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-makkonen2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:alg-GAP-makkonen2025 a mls:Algorithm ;
    rdfs:label "2b (Fe-Fe, Fe-H, H-H), 3b (cutoff 3.7 A, 800 sparse points) and species-resolved EAM descriptors with species-dependent energy scales" .

entity:impl-GAP-makkonen2025 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:hasTrainingAlgorithm entity:alg-tabGAP-makkonen2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:alg-tabGAP-makkonen2025 a mls:Algorithm ;
    rdfs:label "Fe-H GAP tabulated on 5000-point 2b and 120^3 3b grids" .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:supportsSimulation mlips:MolecularDynamics .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-cutoffRadius-makkonen2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-gap-numSparseConfigs-makkonen2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "800"^^xsd:integer .

entity:setting-tabgap-cutoffRadius-makkonen2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-makkonen2025 a mlips:MLIPRun ;
    rdfs:label "Fe-H GAP (2b + 3b + EAM)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-feh-makkonen2025 ;
    mlips:hasHyperparameterSetting entity:setting-gap-cutoffRadius-makkonen2025 ,
        entity:setting-gap-numSparseConfigs-makkonen2025 ;
    mlips:produces entity:model-gap-makkonen2025 .

entity:model-gap-makkonen2025 a mlips:TrainedModel ;
    rdfs:label "Fe-H GAP (Makkonen 2025)" .

entity:run-tabgap-makkonen2025 a mlips:MLIPRun ;
    rdfs:label "Fe-H tabGAP (tabulated GAP)" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-feh-makkonen2025 ;
    mlips:hasHyperparameterSetting entity:setting-tabgap-cutoffRadius-makkonen2025 ;
    mlips:produces entity:model-tabgap-makkonen2025 .

entity:model-tabgap-makkonen2025 a mlips:TrainedModel ;
    rdfs:label "Fe-H tabGAP (Makkonen 2025)" .

entity:run-meng-nnip-makkonen2025 a mlips:MLIPRun ;
    rdfs:label "Meng et al. Fe-H NNIP (Ref. 48) as distributed" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:produces entity:model-meng-nnip-makkonen2025 .

entity:model-meng-nnip-makkonen2025 a mlips:TrainedModel ;
    rdfs:label "alpha-Fe-H NNIP (Meng et al. 2021)" .

