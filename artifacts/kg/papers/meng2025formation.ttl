###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-fe-meng2025formation a mlips:MaterialSystem ;
    rdfs:label "Body-centred cubic alpha-iron, including (001), (110) and (111) twist grain boundaries" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "bcc transition metal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-meng2025formation a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-meng2025formation mlips:hasDFTSettings entity:calc-settings-pbe-meng2025formation .

entity:calc-settings-pbe-meng2025formation a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "360"^^xsd:double ;
    mlips:kPointMesh "Minimum k-point spacing 0.03 1/A" ;
    rdfs:comment "Spin-polarised; Gaussian smearing 0.1 eV; used for the validation calculations. The NNIP database is that of Ref. 27." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-feh-db-meng2025formation a mlips:TrainingDataset ;
    rdfs:label "alpha-Fe-H NNIP training database of Ref. 27" ;
    mlips:coversMaterial entity:mat-fe-meng2025formation ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbe-meng2025formation .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-meng2025formation ;
    mlips:hasHyperparameter mlips:numFeatures ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:alg-HDNNP-meng2025formation a mls:Algorithm ;
    rdfs:label "Atom-centred symmetry functions as in Ref. 27; run in LAMMPS through the library-based interface of Singraber et al. (Ref. 31)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nnip0-numFeatures-meng2025formation a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "24"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nnip0-meng2025formation a mlips:MLIPRun ;
    rdfs:label "NNIP-0: alpha-Fe-H NNIP of Ref. 27 as distributed" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-feh-db-meng2025formation ;
    mlips:hasHyperparameterSetting entity:setting-nnip0-numFeatures-meng2025formation ;
    mlips:produces entity:model-nnip0-meng2025formation .

entity:model-nnip0-meng2025formation a mlips:TrainedModel ;
    rdfs:label "alpha-Fe-H NNIP (Meng et al. 2021)" .

entity:run-ensemble-meng2025formation a mlips:MLIPRun ;
    rdfs:label "Ensemble of 12 NNIPs (NNIP-1 to NNIP-12) retrained with the same architecture and database, differing in random train/test split, 160 iterations each" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-feh-db-meng2025formation ;
    mlips:produces entity:model-ensemble-meng2025formation .

entity:model-ensemble-meng2025formation a mlips:TrainedModel ;
    rdfs:label "NNIP ensemble (NNIP-1..12)" .

