# Canonical Turtle for the protocol-derived encoding of:
#   Tuan Minh Do et al. (2026). From sparse quantum-computing data to atomistic simulation with universal machine-learning interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2609.21536  arXiv:2609.21536v1
#
# Version read: arxiv-preprint arXiv:2609.21536v1 (sha256 b045a0940c71f682...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 333 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/do2026.yaml.
#
# Encoding scope: one MACE model fine-tuned from MACE-Osaka24 Large with
# multihead replay on 26 quantum-computing reference energies (3
# Menshutkin, 14 HKUST-1 water, 9 HEA CO-hopping configurations; Sec. II B)
# and the downstream Widom-insertion (Monte Carlo) and umbrella-sampling MD
# simulations. No energy/force errors are reported: all reference
# configurations were used for fine-tuning and the model is assessed only
# through downstream observables (barriers, adsorption enthalpies, Henry
# coefficients, free-energy profiles), which are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-do2026 a mlips:BenchmarkStudy ;
    rdfs:label "Do et al. (2026): fine-tuning MACE-Osaka24 on sparse quantum-computing (QSCI-TCCSD(T)) reference energies" ;
    mlips:reportedIn entity:article-do2026 .

entity:article-do2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2609.21536> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "From sparse quantum-computing data to atomistic simulation with universal machine-learning interatomic potentials" ;
    schema:author entity:person-Do-do2026 ,
        entity:person-Yoshida-do2026 ,
        entity:person-Ishihara-do2026 ,
        entity:person-Mizukami-do2026 .

entity:person-Do-do2026 a schema:Person ;
    schema:name "Tuan Minh Do" ;
    schema:givenName "Tuan Minh" ;
    schema:familyName "Do" .

entity:person-Yoshida-do2026 a schema:Person ;
    schema:name "Yuichiro Yoshida" ;
    schema:givenName "Yuichiro" ;
    schema:familyName "Yoshida" .

entity:person-Ishihara-do2026 a schema:Person ;
    schema:name "Kenji Ishihara" ;
    schema:givenName "Kenji" ;
    schema:familyName "Ishihara" .

entity:person-Mizukami-do2026 a schema:Person ;
    schema:name "Wataru Mizukami" ;
    schema:givenName "Wataru" ;
    schema:familyName "Mizukami" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-menshutkin-do2026 a mlips:MaterialSystem ;
    rdfs:label "Menshutkin SN2 reaction (gas phase; CNT-confined structures for evaluation)" ;
    mlips:materialClass "Organic molecules (gas phase)" .

entity:mat-hkust1-do2026 a mlips:MaterialSystem ;
    rdfs:label "Water adsorption in the Cu MOF HKUST-1" ;
    mlips:materialClass "Metal-organic frameworks" .

entity:mat-hea-do2026 a mlips:MaterialSystem ;
    rdfs:label "CO on an IrPdPtRhRu high-entropy-alloy nanoparticle" ;
    mlips:materialClass "High-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qsci-do2026 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qsci-do2026 mlips:hasWaveFunctionSettings entity:calc-settings-qsci-do2026 .

entity:calc-settings-qsci-do2026 a mlips:WaveFunctionSettings ;
    mlips:wfMethod entity:wf-QSCI-TCCSD-T-do2026 .

entity:wf-QSCI-TCCSD-T-do2026 a mlips:WfMethod ;
    rdfs:label "QSCI-TCCSD(T)" ;
    rdfs:comment "Quantum-selected configuration interaction on the 144-qubit superconducting quantum computer at the University of Osaka (10,000 shots), with tailored CCSD(T) post-processing; projection-based WF-in-DFT embedding for HKUST-1 and HEA, none for Menshutkin; active spaces (4e,4o), (2e,2o), (4e,4o) (Sec. II B; data from Ref. [31])." ;
    mlips:candidateForVocabulary mlips:WfMethod .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-qc-do2026 a mlips:TrainingDataset ;
    rdfs:label "Quantum-computing reference energies (3 Menshutkin + 14 HKUST-1 + 9 HEA configurations; energies only)" ;
    mlips:coversMaterial entity:mat-menshutkin-do2026 ,
        entity:mat-hkust1-do2026 ,
        entity:mat-hea-do2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 26 ;
    mlips:hasReferenceCalculation entity:calc-qsci-do2026 ;
    rdfs:comment "Taken from the authors' previous study (Ref. [31]); combined with a 0.1 % random replay subset of the MACE-Osaka24 pretraining data (energies and forces) on a separate head." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-do2026 ;
    mlips:supportsSimulation mlips:MonteCarlo ,
        mlips:MolecularDynamics .

entity:impl-MACE-do2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ft-learningRate-do2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-ft-batchSize-do2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "16"^^xsd:integer .

entity:setting-ft-numEpochs-do2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "301"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-osaka24-do2026 a mlips:MLIPRun ;
    rdfs:label "MACE-Osaka24 Large as published (pretrained)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-osaka24-do2026 .

entity:model-osaka24-do2026 a mlips:TrainedModel ;
    rdfs:label "MACE-Osaka24" .

entity:run-ft-do2026 a mlips:MLIPRun ;
    rdfs:label "MACE-Osaka24 Large fine-tuned on the quantum-computing reference energies (multihead replay, target head)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-qc-do2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-learningRate-do2026 ,
        entity:setting-ft-batchSize-do2026 ,
        entity:setting-ft-numEpochs-do2026 ;
    mlips:produces entity:model-ft-do2026 .

entity:model-ft-do2026 a mlips:TrainedModel ;
    rdfs:label "MACE-Osaka24 fine-tuned on QSCI-TCCSD(T) data" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# No training or inference times are given.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No energy or force errors: all reference configurations were used for training and validation of the target head (Sec. II C). Downstream results (CNT-confined Menshutkin barrier 40.37 kcal/mol with the pretrained model vs THC-CASPT2; HKUST-1 site free-energy difference -8.4 -> -22.7 kJ/mol; Henry coefficient; CO-hopping barriers 0.34/0.15 eV -> 0.16/0.43 eV) are properties.
# - Fine-tuning used mace-torch 0.3.15, Adam with AMSGrad, energy/force loss weights 10/1, configuration energy weights 10/100/100 and replay-head weight 1.0 (Sec. II C).
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: datacite).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/do2026.yaml) until the schema has terms for them.
