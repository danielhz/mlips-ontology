###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Ni-zuo2020 a mlips:MaterialSystem ;
    rdfs:label "Elemental Ni (fcc ground state)" ;
    mlips:chemicalFormula "Ni" ;
    mlips:materialClass "fcc transition metal" .

entity:mat-Cu-zuo2020 a mlips:MaterialSystem ;
    rdfs:label "Elemental Cu (fcc ground state)" ;
    mlips:chemicalFormula "Cu" ;
    mlips:materialClass "fcc transition metal" .

entity:mat-Li-zuo2020 a mlips:MaterialSystem ;
    rdfs:label "Elemental Li (bcc ground state)" ;
    mlips:chemicalFormula "Li" ;
    mlips:materialClass "bcc main-group metal" .

entity:mat-Mo-zuo2020 a mlips:MaterialSystem ;
    rdfs:label "Elemental Mo (bcc ground state)" ;
    mlips:chemicalFormula "Mo" ;
    mlips:materialClass "bcc transition metal" .

entity:mat-Si-zuo2020 a mlips:MaterialSystem ;
    rdfs:label "Elemental Si (diamond cubic ground state)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "diamond cubic group-IV semiconductor" .

entity:mat-Ge-zuo2020 a mlips:MaterialSystem ;
    rdfs:label "Elemental Ge (diamond cubic ground state)" ;
    mlips:chemicalFormula "Ge" ;
    mlips:materialClass "diamond cubic group-IV semiconductor" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-zuo2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-zuo2020 mlips:hasDFTSettings entity:calc-settings-dft-zuo2020 .

entity:calc-settings-dft-zuo2020 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "4x4x4 for the Mo, Ni, Cu, Si and Ge supercells, 3x3x3 for the Li supercells; AIMD with a single Gamma point, snapshots recomputed statically with the same parameters as the rest of the data" ;
    rdfs:comment "VASP 5.4.1; electronic energy converged to 1e-5 eV and force components to 0.02 eV/A. AIMD runs were non-spin-polarized." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-Ni-zuo2020 a mlips:TrainingDataset ;
    rdfs:label "Ni DFT data set of Zuo et al. (ground state, strained cells, slabs, AIMD and vacancy-AIMD snapshots)" ;
    mlips:coversMaterial entity:mat-Ni-zuo2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-zuo2020 ;
    rdfs:comment "Apportioned into training and test sets with a 90:10 split. Published with the code and the optimised models at https://github.com/materialsvirtuallab/mlearn." .

entity:ds-Cu-zuo2020 a mlips:TrainingDataset ;
    rdfs:label "Cu DFT data set of Zuo et al. (ground state, strained cells, slabs, AIMD and vacancy-AIMD snapshots)" ;
    mlips:coversMaterial entity:mat-Cu-zuo2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-zuo2020 ;
    rdfs:comment "Apportioned into training and test sets with a 90:10 split. Published with the code and the optimised models at https://github.com/materialsvirtuallab/mlearn." .

entity:ds-Li-zuo2020 a mlips:TrainingDataset ;
    rdfs:label "Li DFT data set of Zuo et al. (ground state, strained cells, slabs, AIMD and vacancy-AIMD snapshots)" ;
    mlips:coversMaterial entity:mat-Li-zuo2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-zuo2020 ;
    rdfs:comment "Apportioned into training and test sets with a 90:10 split. Published with the code and the optimised models at https://github.com/materialsvirtuallab/mlearn." .

entity:ds-Mo-zuo2020 a mlips:TrainingDataset ;
    rdfs:label "Mo DFT data set of Zuo et al. (ground state, strained cells, slabs, AIMD and vacancy-AIMD snapshots)" ;
    mlips:coversMaterial entity:mat-Mo-zuo2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-zuo2020 ;
    rdfs:comment "Apportioned into training and test sets with a 90:10 split. Published with the code and the optimised models at https://github.com/materialsvirtuallab/mlearn." .

entity:ds-Si-zuo2020 a mlips:TrainingDataset ;
    rdfs:label "Si DFT data set of Zuo et al. (ground state, strained cells, slabs, AIMD and vacancy-AIMD snapshots)" ;
    mlips:coversMaterial entity:mat-Si-zuo2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-zuo2020 ;
    rdfs:comment "Apportioned into training and test sets with a 90:10 split. Published with the code and the optimised models at https://github.com/materialsvirtuallab/mlearn." .

entity:ds-Ge-zuo2020 a mlips:TrainingDataset ;
    rdfs:label "Ge DFT data set of Zuo et al. (ground state, strained cells, slabs, AIMD and vacancy-AIMD snapshots)" ;
    mlips:coversMaterial entity:mat-Ge-zuo2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-dft-zuo2020 ;
    rdfs:comment "Apportioned into training and test sets with a 90:10 split. Published with the code and the optimised models at https://github.com/materialsvirtuallab/mlearn." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-Ni-zuo2020 mlips:samplingStrategy
    entity:sampling-ground-state-zuo2020 ,
    entity:sampling-strain-zuo2020 ,
    entity:sampling-slab-zuo2020 ,
    entity:sampling-aimd-zuo2020 ,
    entity:sampling-aimd-vacancy-zuo2020 .

entity:ds-Cu-zuo2020 mlips:samplingStrategy
    entity:sampling-ground-state-zuo2020 ,
    entity:sampling-strain-zuo2020 ,
    entity:sampling-slab-zuo2020 ,
    entity:sampling-aimd-zuo2020 ,
    entity:sampling-aimd-vacancy-zuo2020 .

entity:ds-Li-zuo2020 mlips:samplingStrategy
    entity:sampling-ground-state-zuo2020 ,
    entity:sampling-strain-zuo2020 ,
    entity:sampling-slab-zuo2020 ,
    entity:sampling-aimd-zuo2020 ,
    entity:sampling-aimd-vacancy-zuo2020 .

entity:ds-Mo-zuo2020 mlips:samplingStrategy
    entity:sampling-ground-state-zuo2020 ,
    entity:sampling-strain-zuo2020 ,
    entity:sampling-slab-zuo2020 ,
    entity:sampling-aimd-zuo2020 ,
    entity:sampling-aimd-vacancy-zuo2020 .

entity:ds-Si-zuo2020 mlips:samplingStrategy
    entity:sampling-ground-state-zuo2020 ,
    entity:sampling-strain-zuo2020 ,
    entity:sampling-slab-zuo2020 ,
    entity:sampling-aimd-zuo2020 ,
    entity:sampling-aimd-vacancy-zuo2020 .

entity:ds-Ge-zuo2020 mlips:samplingStrategy
    entity:sampling-ground-state-zuo2020 ,
    entity:sampling-strain-zuo2020 ,
    entity:sampling-slab-zuo2020 ,
    entity:sampling-aimd-zuo2020 ,
    entity:sampling-aimd-vacancy-zuo2020 .

entity:sampling-ground-state-zuo2020 a mlips:SamplingStrategy ;
    rdfs:label "Ground-state crystal" ;
    rdfs:comment "The ground-state crystal of each element." .

entity:sampling-strain-zuo2020 a mlips:SamplingStrategy ;
    rdfs:label "Homogeneous strain sampling" ;
    rdfs:comment "Strains of -10% to 10% at 2% intervals applied to the bulk supercell in six different modes (3x3x3, 3x3x3 and 2x2x2 supercells of the conventional bcc, fcc and diamond cells)." .

entity:sampling-slab-zuo2020 a mlips:SamplingStrategy ;
    rdfs:label "Surface (slab) enumeration" ;
    rdfs:comment "Slab structures up to a maximum Miller index of three, as obtained from the Crystalium database." .

entity:sampling-aimd-zuo2020 a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling (NVT AIMD of bulk supercells)" ;
    rdfs:comment "NVT AIMD at 300 K and at 0.5x, 0.9x, 1.5x and 2.0x the melting point of each element; 20 snapshots per simulation at 0.1 ps intervals, unless otherwise stated." .

entity:sampling-aimd-vacancy-zuo2020 a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling of a single-vacancy supercell (NVT AIMD)" ;
    rdfs:comment "NVT AIMD of the bulk supercell with a single vacancy at 300 K and 2.0x the melting point; 40 snapshots per simulation at 0.1 ps intervals, unless otherwise stated." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-zuo2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:numAngularBasis ,
        entity:hp-sigma-energy-zuo2020 ,
        entity:hp-sigma-force-zuo2020 ,
        entity:hp-zeta-zuo2020 ;
    mlips:hasImplementation entity:impl-GAP-zuo2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation ;
    mlips:inferenceComplexity "Linear in the number of atoms; cost linear in the number of kernels (Table S11)" .

entity:alg-GAP-zuo2020 a mls:Algorithm ;
    rdfs:label "Gaussian process regression on a set of representative atomic environments; hyperparameters by grid search" .

entity:impl-GAP-zuo2020 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-zuo2020 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-zuo2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ,
        entity:hp-num-free-parameters-zuo2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation ;
    mlips:inferenceComplexity "Linear in the number of atoms (Table S11)" .

entity:loss-MTP-zuo2020 a mlips:LossFunction ;
    rdfs:label "Weighted fit to energies and forces (energy weight 1.00, force weight 0.01)" .

entity:alg-MTP-zuo2020 a mls:Algorithm ;
    rdfs:label "Fit with a maximum of 500 / 1000 / 2000 iterations for <=16 / 20 / 24 polynomial powers; hyperparameters chosen by reproducing elastic constants and the phonon spectrum" .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-zuo2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation ;
    mlips:inferenceComplexity "Linear in the number of atoms (Table S11)" .

entity:alg-HDNNP-zuo2020 a mls:Algorithm ;
    rdfs:label "Kalman filter for the network weights; grid search over the symmetry-function hyperparameters" .

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP ;
    mlips:hasTrainingAlgorithm entity:alg-SNAP-zuo2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation ;
    mlips:inferenceComplexity "Linear in the number of atoms (Table S11)" .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

entity:alg-SNAP-zuo2020 a mls:Algorithm ;
    rdfs:label "Alternating two-step fit: linear model fit (inner loop), hyperparameters by differential evolution against material properties such as elastic tensors (outer loop)" .

entity:qSNAP a mlips:MLIPMethod ;
    rdfs:label "Quadratic Spectral Neighbor Analysis Potential (qSNAP)" ;
    mlips:hasFunctionalForm entity:ff-qSNAP ;
    mlips:hasTrainingAlgorithm entity:alg-qSNAP-zuo2020 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-jmax-zuo2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation ;
    mlips:inferenceComplexity "Linear in the number of atoms (Table S11)" .

entity:ff-qSNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components plus all their distinct pairwise products" .

entity:alg-qSNAP-zuo2020 a mls:Algorithm ;
    rdfs:label "Same alternating two-step fit as for linear SNAP (linear fit inside, differential evolution outside)" .

entity:hp-sigma-energy-zuo2020 a mlips:Hyperparameter ;
    rdfs:label "GAP regularisation: expected energy error sigma_energy (eV/atom)" ;
    mlips:hyperparameterName "sigma_energy" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-sigma-force-zuo2020 a mlips:Hyperparameter ;
    rdfs:label "GAP regularisation: expected force error sigma_force (eV/A)" ;
    mlips:hyperparameterName "sigma_force" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-zeta-zuo2020 a mlips:Hyperparameter ;
    rdfs:label "SOAP kernel exponent zeta" ;
    mlips:hyperparameterName "zeta" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-jmax-zuo2020 a mlips:Hyperparameter ;
    rdfs:label "Bispectrum band limit Jmax, as tabulated" ;
    mlips:hyperparameterName "J_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-num-free-parameters-zuo2020 a mlips:Hyperparameter ;
    rdfs:label "MTP number of free parameters" ;
    mlips:hyperparameterName "num_free_parameters" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-Ni-cutoffRadius-zuo2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "3.9"^^xsd:double .

entity:setting-gap-Ni-numRadialBasis-zuo2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-gap-Ni-numAngularBasis-zuo2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-gap-Ni-sigma-energy-zuo2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-sigma-energy-zuo2020 ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-gap-Ni-sigma-force-zuo2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-sigma-force-zuo2020 ;
    mlips:settingValue "0.05"^^xsd:double .

entity:setting-gap-Ni-zeta-zuo2020 a mlips:HyperparameterSetting ;
