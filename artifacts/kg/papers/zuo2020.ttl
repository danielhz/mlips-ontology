# Canonical Turtle for the protocol-derived encoding of:
#   Yunxing Zuo et al. (2020). Performance and Cost Assessment of Machine Learning Interatomic Potentials.
#   The Journal of Physical Chemistry A. doi:10.1021/acs.jpca.9b08723  arXiv:1906.08888v4
#
# Version read: arxiv-preprint arXiv:1906.08888v4 (sha256 f7b77cf829cff17e...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 8 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: a benchmark that trains five ML-IAPs (GAP, MTP, the
# Behler-Parrinello NNP, linear SNAP and quadratic SNAP) on one
# consistently generated DFT data set per element (Ni, Cu, Li, Mo, Si,
# Ge): 30 runs / models, each with its optimised cutoff radius (Table I)
# and the per-method parameters of Tables S7, S9 and S10.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zuo2020 a mlips:BenchmarkStudy ;
    rdfs:label "Zuo et al. (2020): performance and cost assessment of GAP, MTP, NNP, SNAP and qSNAP on Li, Mo, Ni, Cu, Si and Ge" ;
    mlips:reportedIn entity:article-zuo2020 .

entity:article-zuo2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpca.9b08723> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Performance and Cost Assessment of Machine Learning Interatomic Potentials" ;
    schema:author <https://orcid.org/0000-0002-2734-7720> ,
        <https://orcid.org/0000-0001-8008-7043> ,
        entity:person-Li-zuo2020 ,
        entity:person-Deng-zuo2020 ,
        <https://orcid.org/0000-0002-1501-5550> ,
        <https://orcid.org/0000-0002-1220-1542> ,
        entity:person-Csanyi-zuo2020 ,
        entity:person-Shapeev-zuo2020 ,
        entity:person-Thompson-zuo2020 ,
        entity:person-Wood-zuo2020 ,
        <https://orcid.org/0000-0001-5726-2587> .

