###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mp-r2scan-huang2025 a mlips:MaterialSystem ;
    rdfs:label "Materials Project crystals computed with r2SCAN (MP-r2SCAN)" ;
    mlips:materialClass "Universal inorganic crystals; structure-optimisation and static trajectories" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-huang2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-huang2025 mlips:hasDFTSettings entity:calc-settings-dft-huang2025 .

entity:calc-settings-dft-huang2025 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-r2SCAN-huang2025 ;
    rdfs:comment "Materials Project r2SCAN structure-optimisation and static calculations (retrieved March 2024); code and settings are those of the Materials Project and are not restated." .

entity:xc-r2SCAN-huang2025 a mlips:XCFunctional ;
    rdfs:label "r2SCAN" ;
    rdfs:comment "Regularised-restored SCAN meta-GGA." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mp-r2scan-huang2025 a mlips:TrainingDataset ;
    rdfs:label "MP-r2SCAN training split (190,560 structures of 27,943 materials)" ;
    mlips:coversMaterial entity:mat-mp-r2scan-huang2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 190560 ;
    mlips:hasDFTCalculation entity:calc-dft-huang2025 ;
    rdfs:comment "Validation: 23,888 structures of 3,492 materials; test: 23,799 structures of 3,492 materials. Magnetic moments are also trained." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mp-r2scan-huang2025 mlips:samplingStrategy
    entity:sampling-mp-r2scan-trajectories-huang2025 .

entity:sampling-mp-r2scan-trajectories-huang2025 a mlips:SamplingStrategy ;
    rdfs:label "Filtered Materials Project r2SCAN trajectories" ;
    rdfs:comment "All r2SCAN optimisation and static trajectories per material ID, filtered as for MPtrj: final-frame energies within 20 meV/atom of the primary task, unconverged or incomplete structures removed, structures more than 1 eV/atom above or 10 meV/atom below the ThermoDoc relaxed structures removed, duplicates removed. Split about 8:1:1 by material ID." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasLossFunction entity:loss-CHGNet-huang2025 ;
    mlips:hasTrainingAlgorithm entity:alg-CHGNet-huang2025 ;
    mlips:hasHyperparameter entity:hp-atomref-strategy-huang2025 ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs .

entity:loss-CHGNet-huang2025 a mlips:LossFunction ;
    rdfs:label "Huber loss with energy : force : stress : magmom ratio of 3 : 1 : 0.1 : 1" .

entity:alg-CHGNet-huang2025 a mls:Algorithm ;
    rdfs:label "Learning rate 1e-3 with cosine decay to 1e-5 in 50 epochs; batch size 64; other settings as for the pretrained CHGNet" .

entity:hp-atomref-strategy-huang2025 a mlips:Hyperparameter ;
    rdfs:label "Treatment of the atomic reference energies (AtomRef) and of the initial weights" ;
    mlips:hyperparameterName "atomref_strategy" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
