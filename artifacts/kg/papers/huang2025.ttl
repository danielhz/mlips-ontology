    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-method-2-learningRate-huang2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-method-2-numEpochs-huang2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-method-3-atomref-strategy-huang2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-atomref-strategy-huang2025 ;
    mlips:settingValue "start from GGA/GGA+U-pretrained CHGNet; AtomRef frozen at the GGA/GGA+U values" .

