entity:setting-method-4-atomref-strategy-huang2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-atomref-strategy-huang2025 ;
    mlips:settingValue "start from GGA/GGA+U-pretrained CHGNet; AtomRef replaced by the fitted r2SCAN AtomRef" .

