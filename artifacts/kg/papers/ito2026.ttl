# Canonical Turtle for the protocol-derived encoding of:
#   Shusuke Ito et al. (2026). Benchmarking Universal Interatomic Potentials on Zeolite.
#   The Journal of Physical Chemistry C. doi:10.1021/acs.jpcc.5c06812  arXiv:2509.07417v1
#
# Version read: arxiv-preprint arXiv:2509.07417v1 (sha256 c248b42ee48e1cf1...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 316 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ito2026.yaml.
#
# Encoding scope: six pretrained universal MLIPs (CHGNet, ORB-v3,
# MatterSim, eSEN-30M-OAM, PFP v7, EquiformerV2-lE4-lF100-S2EFS-OC22) with
# D3 correction, and their RMSEs of zeolite relative energies against
# experiment (Table 2) and PBE+D3 (Tables 3, 4). Analytic and tailor-made
# force fields (GFN-FF, UFF, Dreiding, SLC, ClayFF, BSFF) are not MLIPs and
# are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ito2026 a mlips:BenchmarkStudy ;
    rdfs:label "Ito, Muraoka and Nakayama (2026): benchmarking universal interatomic potentials on zeolite structures" ;
    mlips:reportedIn entity:article-ito2026 .

entity:article-ito2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpcc.5c06812> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Benchmarking Universal Interatomic Potentials on Zeolite" ;
    schema:author entity:person-Ito-ito2026 ,
        <https://orcid.org/0000-0003-1830-7978> ,
        <https://orcid.org/0000-0002-7330-0317> .

entity:person-Ito-ito2026 a schema:Person ;
    schema:name "Shusuke Ito" ;
    schema:givenName "Shusuke" ;
    schema:familyName "Ito" .

<https://orcid.org/0000-0003-1830-7978> a schema:Person ;
    schema:name "Koki Muraoka" ;
    schema:givenName "Koki" ;
    schema:familyName "Muraoka" ;
    schema:identifier <https://orcid.org/0000-0003-1830-7978> .

<https://orcid.org/0000-0002-7330-0317> a schema:Person ;
    schema:name "Akira Nakayama" ;
    schema:givenName "Akira" ;
    schema:familyName "Nakayama" ;
    schema:identifier <https://orcid.org/0000-0002-7330-0317> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-silica-ito2026 a mlips:MaterialSystem ;
    rdfs:label "Pure-silica zeolite frameworks (IZA topologies) relative to alpha-quartz" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "Zeolite (pure silica)" .

entity:mat-cu-cha-ito2026 a mlips:MaterialSystem ;
    rdfs:label "347 Cu2+/[Cu(OH)]+ exchanged aluminosilicate CHA zeolites" ;
    mlips:materialClass "Metal-exchanged zeolite" .

entity:mat-k-eri-ito2026 a mlips:MaterialSystem ;
    rdfs:label "1,190 ERI zeolites with potassium and hexane-1,6-bis(trimethylazanium) OSDA" ;
    mlips:materialClass "As-synthesised zeolite with organic template" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-ito2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-ito2026 mlips:hasDFTSettings entity:calc-settings-pbe-d3-ito2026 .

entity:calc-settings-pbe-d3-ito2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBE-D3-ito2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    rdfs:comment "VASP 6.2.1, MPRelax settings (pymatgen 2025.5.2, custodian), energy convergence 5e-5 eV/atom." .

entity:xc-PBE-D3-ito2026 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:eSEN a mlips:MLIPMethod ;
    rdfs:label "eSEN (equivariant smooth energy network)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:TeaNet a mlips:MLIPMethod ;
    rdfs:label "TeaNet (tensor embedded atom network)" ;
    mlips:hasFunctionalForm entity:ff-TeaNet ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ff-TeaNet a mlips:FunctionalForm ;
    rdfs:label "Graph convolutional network whose message passing carries scalar, vector and rank-2 tensor values on atoms and bonds, motivated by rewriting the embedded-atom and bond-order (Tersoff-type) potentials as graph convolutions and by iterative electronic relaxation; energies are sums of atomic contributions and forces come from backpropagation" .

entity:EquiformerV2 a mlips:MLIPMethod ;
    rdfs:label "EquiformerV2 (equivariant transformer)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chgnet-ito2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet as distributed" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-ito2026 .

entity:model-chgnet-ito2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet" .

entity:run-orb-v3-ito2026 a mlips:MLIPRun ;
    rdfs:label "ORB-v3 as distributed" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb-v3-ito2026 .

entity:model-orb-v3-ito2026 a mlips:TrainedModel ;
    rdfs:label "ORB-v3" .

entity:run-mattersim-ito2026 a mlips:MLIPRun ;
    rdfs:label "MatterSim as distributed (version not stated)" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-mattersim-ito2026 .

entity:model-mattersim-ito2026 a mlips:TrainedModel ;
    rdfs:label "MatterSim" .

entity:run-esen-ito2026 a mlips:MLIPRun ;
    rdfs:label "eSEN-30M-OAM as distributed" ;
    mlips:appliesMethod entity:eSEN ;
    mlips:produces entity:model-esen-ito2026 .

entity:model-esen-ito2026 a mlips:TrainedModel ;
    rdfs:label "eSEN-30M-OAM" .

entity:run-pfp-v7-ito2026 a mlips:MLIPRun ;
    rdfs:label "PFP v7 as distributed" ;
    mlips:appliesMethod entity:TeaNet ;
    mlips:produces entity:model-pfp-v7-ito2026 .

entity:model-pfp-v7-ito2026 a mlips:TrainedModel ;
    rdfs:label "PFP v7" .

entity:run-eqv2-oc22-ito2026 a mlips:MLIPRun ;
    rdfs:label "EquiformerV2-lE4-lF100-S2EFS-OC22 as distributed" ;
    mlips:appliesMethod entity:EquiformerV2 ;
    mlips:produces entity:model-eqv2-oc22-ito2026 .

entity:model-eqv2-oc22-ito2026 a mlips:TrainedModel ;
