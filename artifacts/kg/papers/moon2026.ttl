# Canonical Turtle for the protocol-derived encoding of:
#   Minseok Moon et al. (2026). Defect-limited thermal transport in AlN using pretrained machine-learning interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2610.08013  arXiv:2610.08013v1
#
# Version read: arxiv-preprint arXiv:2610.08013v1 (sha256 89d34d0ca376342c...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 426 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/moon2026.yaml.
#
# Encoding scope: five MLIPs used for AlN phonons and spectral-energy-
# density MD (SevenNet-Omni mpa channel, SevenNet-Nano 5 A, ft-nano
# fine-tuned from nano on omni-mpa labels, MACE-MH-1 omat_pbe head,
# MACE-MPA-0), the ft-nano training data (omni-mpa single points of AlN
# bulk, oxygen-defect, amorphous Y-Al-O and interface configurations;
# 2,992 training frames, stratified 12 % validation) and the held-out
# errors of nano and ft-nano against the teacher labels (SI Table S3,
# Fig. S2). Lattice parameters, phonons and thermal conductivities are
# properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-moon2026 a mlips:BenchmarkStudy ;
    rdfs:label "Moon et al. (2026): defect-limited thermal transport in AlN with pretrained SevenNet and MACE potentials and a fine-tuned SevenNet-Nano" ;
    mlips:reportedIn entity:article-moon2026 .

entity:article-moon2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2610.08013> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Defect-limited thermal transport in AlN using pretrained machine-learning interatomic potentials" ;
    schema:author entity:person-Moon-moon2026 ,
        entity:person-Choi-moon2026 ,
        entity:person-Han-moon2026 ,
        entity:person-Kang-moon2026 .

entity:person-Moon-moon2026 a schema:Person ;
    schema:name "Minseok Moon" ;
    schema:givenName "Minseok" ;
    schema:familyName "Moon" .

entity:person-Choi-moon2026 a schema:Person ;
    schema:name "Wonjun Choi" ;
    schema:givenName "Wonjun" ;
    schema:familyName "Choi" .

entity:person-Han-moon2026 a schema:Person ;
    schema:name "Seungwu Han" ;
    schema:givenName "Seungwu" ;
    schema:familyName "Han" .

entity:person-Kang-moon2026 a schema:Person ;
    schema:name "Youngho Kang" ;
    schema:givenName "Youngho" ;
    schema:familyName "Kang" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-aln-moon2026 a mlips:MaterialSystem ;
    rdfs:label "Wurtzite AlN: pristine, with V_Al(O_N)3 complexes, amorphous, grain boundaries and Y-O intergranular films" ;
    mlips:chemicalFormula "AlN" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-teacher-moon2026 a mlips:ReferenceCalculation .

entity:calc-pbe-moon2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-teacher-moon2026 mlips:hasReferenceSettings entity:calc-settings-teacher-moon2026 .

entity:calc-settings-teacher-moon2026 a mlips:ReferenceSettings ;
    rdfs:comment "Energies, forces and stresses from single-point SevenNet-Omni (mpa channel) evaluations used as fine-tuning labels (SI Table S2)." .

entity:calc-pbe-moon2026 mlips:hasDFTSettings entity:calc-settings-pbe-moon2026 .

entity:calc-settings-pbe-moon2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "9x9x6 (four-atom cell)" ;
    rdfs:comment "Reference lattice parameters and force constants (Sec. 2.4)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ftdata-moon2026 a mlips:TrainingDataset ;
    rdfs:label "ft-nano training data labelled by omni-mpa (2,992 frames; stratified 12 % validation; family weights 1-4)" ;
    mlips:coversMaterial entity:mat-aln-moon2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2992 ;
    mlips:hasReferenceCalculation entity:calc-teacher-moon2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-moon2026 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-moon2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-moon2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:loss-NequIP-moon2026 a mlips:LossFunction ;
    rdfs:label "Huber (delta 0.01) with force coefficient 1.0 and stress 0.01" .

entity:alg-NequIP-moon2026 a mls:Algorithm ;
    rdfs:label "Adam, learning rate 2e-4 decayed by 0.985 per epoch" .

entity:impl-NequIP-moon2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-FlashTP-kernels-moon2026 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:lib-SevenNet-FlashTP-kernels-moon2026 a mlips:Library ;
    rdfs:label "SevenNet (FlashTP kernels)" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ft-nano-cutoffRadius-moon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-ft-nano-numLayers-moon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-ft-nano-numFeatures-moon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "32"^^xsd:integer .

entity:setting-ft-nano-learningRate-moon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0002"^^xsd:double .

entity:setting-ft-nano-batchSize-moon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-ft-nano-numEpochs-moon2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "300"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-omni-mpa-moon2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Omni, mpa channel, as distributed" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-omni-mpa-moon2026 .

entity:model-omni-mpa-moon2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Omni (mpa channel)" .

entity:run-nano-moon2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-Nano (5.0 A cutoff variant), as distributed; distilled from the mpa channel of SevenNet-Omni" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-nano-moon2026 .

entity:model-nano-moon2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-Nano (5 A)" .

entity:run-ft-nano-moon2026 a mlips:MLIPRun ;
    rdfs:label "ft-nano: SevenNet-Nano fine-tuned on omni-mpa-labelled AlN configurations (3 layers, 32 channels, lmax 2)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-ftdata-moon2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-nano-cutoffRadius-moon2026 ,
        entity:setting-ft-nano-numLayers-moon2026 ,
        entity:setting-ft-nano-numFeatures-moon2026 ,
        entity:setting-ft-nano-learningRate-moon2026 ,
        entity:setting-ft-nano-batchSize-moon2026 ,
        entity:setting-ft-nano-numEpochs-moon2026 ;
    mlips:produces entity:model-ft-nano-moon2026 .

entity:model-ft-nano-moon2026 a mlips:TrainedModel ;
    rdfs:label "ft-nano (AlN)" .

entity:run-mace-mh1-moon2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MH-1, omat_pbe head, as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mh1-moon2026 .

entity:model-mace-mh1-moon2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MH-1 (omat_pbe head)" .

entity:run-mace-mpa0-moon2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa0-moon2026 .

entity:model-mace-mpa0-moon2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

