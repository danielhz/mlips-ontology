###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-molecules-liu2026mixture a mlips:MaterialSystem ;
    rdfs:label "OMol25 molecular systems (83 elements, solvation, charge and spin states)" ;
    mlips:materialClass "molecules" .

entity:mat-catalysts-liu2026mixture a mlips:MaterialSystem ;
    rdfs:label "OC20 adsorbate-catalyst surfaces" ;
    mlips:materialClass "heterogeneous catalysts" .

entity:mat-inorganic-liu2026mixture a mlips:MaterialSystem ;
