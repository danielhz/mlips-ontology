###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DPA3-MoE a mlips:MLIPMethod ;
    rdfs:label "DPA3-MoE (mixture-of-experts DPA3: element-wise routed MoE-E or linear MoLE-E expert modules replacing dense feed-forward blocks)" ;
    mlips:hasTrainingAlgorithm entity:alg-DPA3-MoE-liu2026mixture .

entity:alg-DPA3-MoE-liu2026mixture a mls:Algorithm ;
    rdfs:label "6-layer DPA3 with dense feed-forward blocks replaced by MoE-E (64 experts, K = 6 activated, 3 shared; element-wise routing) or MoLE-E (linear aggregation, all experts active)" .

entity:DPA3 a mlips:MLIPMethod ;
    rdfs:label "DPA-3 (Deep Potential attention model, version 3)" ;
    mlips:hasTrainingAlgorithm entity:alg-DPA3-liu2026mixture .

entity:alg-DPA3-liu2026mixture a mls:Algorithm ;
    rdfs:label "6-layer (about 1.3M parameters) and 12-layer dense baselines and a widened 6x-parameter variant" .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasTrainingAlgorithm entity:alg-CHGNet-liu2026mixture ;
    mlips:hasHyperparameter mlips:numEpochs .

entity:alg-CHGNet-liu2026mixture a mls:Algorithm ;
    rdfs:label "Halved feature and hidden dimensions; MoE-E variant with 32 experts, K = 2/4/6 activated (1/2/3 shared)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-chgnet-half-numEpochs-liu2026mixture a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "20"^^xsd:integer .

entity:setting-chgnet-moe-k6-numEpochs-liu2026mixture a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "20"^^xsd:integer .

