###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-neumann2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-neumann2024 mlips:hasDFTSettings entity:calc-settings-pbe-neumann2024 .

entity:calc-settings-pbe-neumann2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "MPtrj and Alexandria: PBE with Hubbard U corrections for transition-metal oxides, no dispersion correction, VASP (Sec. 2.3.3); D3 added for the Orb-D3 training data (Sec. 2.4)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mptrj-alex-neumann2024 a mlips:TrainingDataset ;
    rdfs:label "MPtrj combined with Alexandria (PBE geometry-optimisation trajectories)" ;
    mlips:coversMaterial entity:mat-inorganic-neumann2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbe-neumann2024 ;
    rdfs:comment "Fine-tuning data of the universal Orb models; sizes not stated in the paper. Pretraining used a curated set of ground-state structures from several sources regardless of functional (Sec. 2.3.3)." .

entity:ds-mptrj-neumann2024 a mlips:TrainingDataset ;
    rdfs:label "MPtrj (Materials Project trajectory data set)" ;
    mlips:coversMaterial entity:mat-inorganic-neumann2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbe-neumann2024 .

entity:ds-mptrj-alex-d3-neumann2024 a mlips:TrainingDataset ;
    rdfs:label "MPtrj and Alexandria with D3 dispersion corrections added" ;
    mlips:coversMaterial entity:mat-inorganic-neumann2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:hasDFTCalculation entity:calc-pbe-neumann2024 .

entity:ds-md17-aspirin-neumann2024 a mlips:TrainingDataset ;
    rdfs:label "MD17-10k aspirin training data" ;
    mlips:coversMaterial entity:mat-aspirin-neumann2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "MD17-10k protocol of Fu et al. (Ref. [33])." .

entity:ds-md17-ethanol-neumann2024 a mlips:TrainingDataset ;
    rdfs:label "MD17-10k ethanol training data" ;
    mlips:coversMaterial entity:mat-ethanol-neumann2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-md17-naphthalene-neumann2024 a mlips:TrainingDataset ;
    rdfs:label "MD17-10k naphthalene training data" ;
