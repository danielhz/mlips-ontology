###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ORB a mlips:MLIPMethod ;
    rdfs:label "Orb (graph network simulator universal interatomic potential)" ;
    mlips:hasLossFunction entity:loss-ORB-neumann2024 ;
    mlips:hasTrainingAlgorithm entity:alg-ORB-neumann2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ,
        mlips:numEpochs ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-ORB-neumann2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:MonteCarlo .

entity:loss-ORB-neumann2024 a mlips:LossFunction ;
    rdfs:label "Weighted sum of the energy error (per atom, relative to a linear stoichiometric reference), force MAE and stress MAE; preceded by a denoising-diffusion (epsilon prediction) pretraining objective" .

entity:alg-ORB-neumann2024 a mls:Algorithm ;
    rdfs:label "Adam (beta1 0.9, beta2 0.999) with cosine-annealing schedule and exponential moving average of weights" .

entity:impl-ORB-neumann2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-orb-models-neumann2024 .

entity:lib-orb-models-neumann2024 a mlips:Library ;
    rdfs:label "orb-models" ;
    rdfs:comment "PyTorch, Apache 2.0, https://github.com/orbital-materials/orb-models" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-orb-v2-cutoffRadius-neumann2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-orb-v2-learningRate-neumann2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0003"^^xsd:double .

entity:setting-orb-v2-numEpochs-neumann2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

entity:setting-orb-v2-batchSize-neumann2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "240"^^xsd:integer .

