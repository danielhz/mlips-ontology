# Canonical Turtle for the protocol-derived encoding of:
#   Evgeny V. Podryabinkin et al. (2023). MLIP-3: Active learning on atomic environments with moment tensor potentials.
#   The Journal of Chemical Physics. doi:10.1063/5.0155887  arXiv:2304.13144v3
#
# Version read: arxiv-preprint arXiv:2304.13144v3 (sha256 3728bb26a31a3360...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 344 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/podryabinkin2023.yaml.
#
# Encoding scope: the MLIP-3 example (Sec. IV): MTPs of levels 8, 12
# and 16 (26, 54 and 125 parameters; cutoff 5 A) actively trained on
# spherical atomic neighbourhoods (radius 8 A, 9 A vacuum) cut from an MD
# simulation of Cu deposition on a 1,620-atom Cu<111> substrate, with VASP
# PBE energies and forces, and the training-set RMSEs of Table I. The
# package description (Sec. III) is software, not a result.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-podryabinkin2023 a mlips:BenchmarkStudy ;
    rdfs:label "Podryabinkin et al. (2023): MLIP-3, active learning of moment tensor potentials on atomic neighbourhoods (Cu deposition on Cu<111>)" ;
    mlips:reportedIn entity:article-podryabinkin2023 .

entity:article-podryabinkin2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0155887> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "MLIP-3: Active learning on atomic environments with moment tensor potentials" ;
    schema:author <https://orcid.org/0000-0001-9057-7249> ,
        <https://orcid.org/0009-0006-1429-0821> ,
        <https://orcid.org/0000-0002-7497-5594> ,
        <https://orcid.org/0000-0003-3146-6455> .

<https://orcid.org/0000-0001-9057-7249> a schema:Person ;
    schema:name "Evgeny Podryabinkin" ;
    schema:givenName "Evgeny" ;
    schema:familyName "Podryabinkin" ;
    schema:identifier <https://orcid.org/0000-0001-9057-7249> .

<https://orcid.org/0009-0006-1429-0821> a schema:Person ;
    schema:name "Kamil Garifullin" ;
    schema:givenName "Kamil" ;
    schema:familyName "Garifullin" ;
    schema:identifier <https://orcid.org/0009-0006-1429-0821> .

<https://orcid.org/0000-0002-7497-5594> a schema:Person ;
