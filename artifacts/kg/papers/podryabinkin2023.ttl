###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cu-podryabinkin2023 a mlips:MaterialSystem ;
    rdfs:label "Copper atoms deposited on a six-layer Cu<111> substrate (1,620 atoms)" ;
    mlips:chemicalFormula "Cu" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-podryabinkin2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-podryabinkin2023 mlips:hasDFTSettings entity:calc-settings-pbe-podryabinkin2023 .

entity:calc-settings-pbe-podryabinkin2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "300"^^xsd:double ;
    mlips:kPointMesh "1x1x1" ;
    rdfs:comment "Non-periodic spherical neighbourhoods placed in a box with 9 A of vacuum along each direction (Sec. IV B)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-al8-podryabinkin2023 a mlips:TrainingDataset ;
    rdfs:label "Actively selected neighbourhoods for the level-8 MTP" ;
    mlips:coversMaterial entity:mat-cu-podryabinkin2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 48 ;
    mlips:hasDFTCalculation entity:calc-pbe-podryabinkin2023 .

entity:ds-al12-podryabinkin2023 a mlips:TrainingDataset ;
    rdfs:label "Actively selected neighbourhoods for the level-12 MTP" ;
    mlips:coversMaterial entity:mat-cu-podryabinkin2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 65 ;
    mlips:hasDFTCalculation entity:calc-pbe-podryabinkin2023 .

entity:ds-al16-podryabinkin2023 a mlips:TrainingDataset ;
    rdfs:label "Actively selected neighbourhoods for the level-16 MTP" ;
    mlips:coversMaterial entity:mat-cu-podryabinkin2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 117 ;
    mlips:hasDFTCalculation entity:calc-pbe-podryabinkin2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-al8-podryabinkin2023 mlips:samplingStrategy
    entity:sampling-al-nbh-podryabinkin2023 .

entity:ds-al12-podryabinkin2023 mlips:samplingStrategy
    entity:sampling-al-nbh-podryabinkin2023 .

entity:ds-al16-podryabinkin2023 mlips:samplingStrategy
    entity:sampling-al-nbh-podryabinkin2023 .

entity:sampling-al-nbh-podryabinkin2023 a mlips:SamplingStrategy ;
    rdfs:label "Active learning on atomic neighbourhoods during Cu deposition MD (extrapolation-grade thresholds gamma_save = 2, gamma_break = 10; spherical neighbourhoods of radius 8 A)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-podryabinkin2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:momentLevel ;
    mlips:hasImplementation entity:impl-MTP-podryabinkin2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MTP-podryabinkin2023 a mlips:LossFunction ;
    rdfs:label "Energies and forces of the non-periodic neighbourhoods (no stresses)" .

entity:impl-MTP-podryabinkin2023 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp8-cutoffRadius-podryabinkin2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-mtp8-momentLevel-podryabinkin2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-mtp12-cutoffRadius-podryabinkin2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-mtp12-momentLevel-podryabinkin2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "12"^^xsd:integer .

entity:setting-mtp16-cutoffRadius-podryabinkin2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-mtp16-momentLevel-podryabinkin2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "16"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp8-podryabinkin2023 a mlips:MLIPRun ;
    rdfs:label "MTP level 8 (26 parameters) actively trained on Cu neighbourhoods" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-al8-podryabinkin2023 ;
    mlips:hasHyperparameterSetting entity:setting-mtp8-cutoffRadius-podryabinkin2023 ,
        entity:setting-mtp8-momentLevel-podryabinkin2023 ;
    mlips:produces entity:model-mtp8-podryabinkin2023 .

entity:model-mtp8-podryabinkin2023 a mlips:TrainedModel ;
    rdfs:label "MLIP-3 Cu MTP level 8" .

entity:run-mtp12-podryabinkin2023 a mlips:MLIPRun ;
    rdfs:label "MTP level 12 (54 parameters) actively trained on Cu neighbourhoods" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-al12-podryabinkin2023 ;
    mlips:hasHyperparameterSetting entity:setting-mtp12-cutoffRadius-podryabinkin2023 ,
        entity:setting-mtp12-momentLevel-podryabinkin2023 ;
    mlips:produces entity:model-mtp12-podryabinkin2023 .

entity:model-mtp12-podryabinkin2023 a mlips:TrainedModel ;
    rdfs:label "MLIP-3 Cu MTP level 12" .

entity:run-mtp16-podryabinkin2023 a mlips:MLIPRun ;
    rdfs:label "MTP level 16 (125 parameters) actively trained on Cu neighbourhoods" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-al16-podryabinkin2023 ;
    mlips:hasHyperparameterSetting entity:setting-mtp16-cutoffRadius-podryabinkin2023 ,
        entity:setting-mtp16-momentLevel-podryabinkin2023 ;
    mlips:produces entity:model-mtp16-podryabinkin2023 .

entity:model-mtp16-podryabinkin2023 a mlips:TrainedModel ;
    rdfs:label "MLIP-3 Cu MTP level 16" .

