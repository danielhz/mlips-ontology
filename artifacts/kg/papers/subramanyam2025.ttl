# Canonical Turtle for the protocol-derived encoding of:
#   Aparna P. A. Subramanyam et al. (2025). Information-entropy-driven generation of material-agnostic datasets for machine-learning interatomic potentials.
#   npj Computational Materials. doi:10.1038/s41524-025-01602-9  arXiv:2407.10361v2
#
# Version read: arxiv-preprint arXiv:2407.10361v2 (sha256 f9f10bd4498e56c2...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 398 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/subramanyam2025.yaml.
#
# Encoding scope: the Rev-EM data sets (entropy-maximised bispectrum
# distributions, rescaled per element; VASP GGA single points for Be, C,
# Al, W, Re and Os; Table 8 train/test splits), the pacemaker ACE models
# (ACE-2 for all eight elements; ACE-1, ACE-2 and ACE-3 reweighting
# variants for W) with their train and test RMSEs (Tables 3 and 4), the
# ACE-2 tests on literature data sets (Tables 1 and 4, Owen-W MAEs), and
# the cross-validation of literature MLIPs for Al, W and C on each
# other's data sets and on Rev-EM (Tables 6 and 7). Elastic constants,
# defect and surface energies are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-subramanyam2025 a mlips:BenchmarkStudy ;
    rdfs:label "Subramanyam and Perez (2025): information-entropy-maximised, material-agnostic Rev-EM data sets and ACE potentials for eight elements" ;
    mlips:reportedIn entity:article-subramanyam2025 .

entity:article-subramanyam2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01602-9> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Information-entropy-driven generation of material-agnostic datasets for machine-learning interatomic potentials" ;
    schema:author <https://orcid.org/0000-0003-4619-1263> ,
        <https://orcid.org/0000-0003-3028-5249> .

<https://orcid.org/0000-0003-4619-1263> a schema:Person ;
    schema:name "Aparna P. A. Subramanyam" ;
    schema:givenName "Aparna" ;
    schema:familyName "P. A. Subramanyam" ;
    schema:identifier <https://orcid.org/0000-0003-4619-1263> .

<https://orcid.org/0000-0003-3028-5249> a schema:Person ;
    schema:name "Danny Perez" ;
    schema:givenName "Danny" ;
    schema:familyName "Perez" ;
    schema:identifier <https://orcid.org/0000-0003-3028-5249> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-be-subramanyam2025 a mlips:MaterialSystem ;
    rdfs:label "Elemental Be: Rev-EM entropy-maximised configurations and literature data sets" ;
    mlips:chemicalFormula "Be" ;
    mlips:materialClass "Metals" .

entity:mat-c-subramanyam2025 a mlips:MaterialSystem ;
    rdfs:label "Elemental C: Rev-EM entropy-maximised configurations and literature data sets" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental solid and liquid carbon" .

entity:mat-al-subramanyam2025 a mlips:MaterialSystem ;
    rdfs:label "Elemental Al: Rev-EM entropy-maximised configurations and literature data sets" ;
    mlips:chemicalFormula "Al" ;
