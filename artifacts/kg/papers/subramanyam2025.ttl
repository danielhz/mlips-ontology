###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-gga-subramanyam2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-gga-subramanyam2025 mlips:hasDFTSettings entity:calc-settings-gga-subramanyam2025 .

entity:calc-settings-gga-subramanyam2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "700"^^xsd:double ;
    mlips:kPointMesh "0.125 1/A spacing" ;
    rdfs:comment "Non-spin-polarised GGA (functional cited, not named), VASP 6.3.2, Methfessel-Paxton 0.1 eV (Gaussian 0.05 eV for C), EDIFF 1e-6 eV (Sec. 5.4)." .

