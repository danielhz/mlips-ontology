###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-rev-be-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:ds-rev-c-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:ds-rev-al-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:ds-rev-sb-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:ds-rev-te-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:ds-rev-w-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:ds-rev-re-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:ds-rev-os-subramanyam2025 mlips:samplingStrategy
    entity:sampling-revem-subramanyam2025 .

entity:sampling-revem-subramanyam2025 a mlips:SamplingStrategy ;
    rdfs:label "Rev-EM: greedy maximisation of the information entropy of bispectrum-component distributions (2Jmax = 8, 55 components) with a core repulsion, uniformly rescaled to each element's equilibrium density (C enriched with low-density configurations)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-subramanyam2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:bodyOrder ;
    mlips:hasImplementation entity:impl-ACE-subramanyam2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-ACE-subramanyam2025 a mlips:LossFunction ;
    rdfs:label "90 % energy and 10 % force weight; 75 % of the weight on configurations within Delta E of the minimum (2 eV/atom; 3 eV/atom for C; varied for W ACE-1/ACE-3)" .

entity:impl-ACE-subramanyam2025 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor .

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" .

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor .

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

