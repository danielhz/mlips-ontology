###############################################################################

entity:mat-water-zeng2023 a mlips:MaterialSystem ;
    rdfs:label "Liquid water (published Deep Potential water data)" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-Cu-zeng2023 a mlips:MaterialSystem ;
    rdfs:label "Copper over a wide range of temperatures and pressures (published DP-GEN data)" ;
    mlips:materialClass "Elemental metal" .

entity:mat-HEA-zeng2023 a mlips:MaterialSystem ;
    rdfs:label "High-entropy alloys (published data set)" ;
    mlips:materialClass "Multicomponent alloys" .

entity:mat-OC2M-zeng2023 a mlips:MaterialSystem ;
    rdfs:label "OC2M subset of Open Catalyst 2020" ;
    mlips:materialClass "Adsorbate-surface systems" .

entity:mat-dipeptides-zeng2023 a mlips:MaterialSystem ;
    rdfs:label "Dipeptides subset of SPICE" ;
    mlips:materialClass "Organic molecules" .

entity:mat-SPICE-zeng2023 a mlips:MaterialSystem ;
    rdfs:label "SPICE small-molecule and protein-interaction data set" ;
    mlips:materialClass "Organic molecules" .

