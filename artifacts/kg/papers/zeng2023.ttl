    rdfs:label "Published data set used as provided, split 95% training / 5% validation" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter entity:hp-descriptor-type-zeng2023 ,
        entity:hp-precision-zeng2023 ,
        mlips:cutoffRadius ,
        entity:hp-rcut-smooth-zeng2023 ,
        entity:hp-embedding-net-zeng2023 ,
        entity:hp-fitting-net-zeng2023 ,
        entity:hp-training-steps-zeng2023 ;
    mlips:hasImplementation entity:impl-DeePMD-zeng2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-DeePMD-zeng2023 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit ;
    mlips:version "v2" .

entity:hp-descriptor-type-zeng2023 a mlips:Hyperparameter ;
    rdfs:label "DeePMD-kit descriptor type" ;
    mlips:hyperparameterName "descriptor" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-precision-zeng2023 a mlips:Hyperparameter ;
    rdfs:label "Floating-point precision" ;
    mlips:hyperparameterName "precision" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-rcut-smooth-zeng2023 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential smoothing onset radius (Angstrom)" ;
    mlips:hyperparameterName "rcut_smth" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-embedding-net-zeng2023 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential embedding network sizes" ;
    mlips:hyperparameterName "embedding_net" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-fitting-net-zeng2023 a mlips:Hyperparameter ;
    rdfs:label "Deep Potential fitting network sizes" ;
    mlips:hyperparameterName "fitting_net" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-training-steps-zeng2023 a mlips:Hyperparameter ;
    rdfs:label "Number of training steps" ;
    mlips:hyperparameterName "training_steps" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-water-locframe-FP64-descriptor-type-zeng2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-descriptor-type-zeng2023 ;
    mlips:settingValue "loc_frame" .

entity:setting-water-locframe-FP64-precision-zeng2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-precision-zeng2023 ;
    mlips:settingValue "FP64" .

entity:setting-water-locframe-FP64-cutoffRadius-zeng2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-water-locframe-FP64-rcut-smooth-zeng2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-rcut-smooth-zeng2023 ;
