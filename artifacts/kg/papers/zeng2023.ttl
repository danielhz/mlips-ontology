entity:ds-water-zeng2023 a mlips:TrainingDataset ;
    rdfs:label "water benchmark data set (95% for training)" ;
    mlips:coversMaterial entity:mat-water-zeng2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

