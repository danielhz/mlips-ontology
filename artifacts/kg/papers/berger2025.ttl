# Canonical Turtle for the protocol-derived encoding of:
#   Ethan Berger et al. (2025). Screening of material defects using universal machine-learning interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2504.06993  arXiv:2504.06993v2
#
# Version read: arxiv-preprint arXiv:2504.06993v2 (sha256 80ae6f11fb93b254...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 385 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/berger2025.yaml.
#
# Encoding scope: four pretrained universal MLIPs (MACE-MP-0 small
# without dispersion, the CHGNet package default, M3GNet-MP-2021.2.8-PES
# and ALIGNN-FF mptraj) benchmarked on vacancy and defect formation
# energies of three DFT (PBE) databases (Angsten et al., Huang et al.,
# Bjork et al.), with the MACE RMSEs stated in the text; MACE is then
# used for 130,321 vacancy formation energies and 8,017 etched layers.
# The RMSEs of the other three models and all correlation plots are
# figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-berger2025 a mlips:BenchmarkStudy ;
    rdfs:label "Berger et al. (2025): screening of vacancy defects in Materials Project materials with universal MLIPs, and 2D layers from simulated etching" ;
    mlips:reportedIn entity:article-berger2025 .

entity:article-berger2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2504.06993> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Screening of material defects using universal machine-learning interatomic potentials" ;
    schema:author entity:person-Berger-berger2025 ,
        entity:person-Bagheri-berger2025 ,
        entity:person-Komsa-berger2025 .

entity:person-Berger-berger2025 a schema:Person ;
    schema:name "Ethan Berger" ;
    schema:givenName "Ethan" ;
    schema:familyName "Berger" .

entity:person-Bagheri-berger2025 a schema:Person ;
    schema:name "Mohammad Bagheri" ;
    schema:givenName "Mohammad" ;
    schema:familyName "Bagheri" .

entity:person-Komsa-berger2025 a schema:Person ;
    schema:name "Hannu-Pekka Komsa" ;
    schema:givenName "Hannu-Pekka" ;
    schema:familyName "Komsa" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-fcchcp-berger2025 a mlips:MaterialSystem ;
    rdfs:label "Elemental fcc and hcp metals with a vacancy (Angsten et al. database)" ;
    mlips:materialClass "Metals" .

entity:mat-twod-berger2025 a mlips:MaterialSystem ;
    rdfs:label "2D materials with vacancies and substitutions (h-BN, MoS2, GaSe, BP and others; Huang et al. database)" ;
    mlips:materialClass "2D material" .

entity:mat-layered-berger2025 a mlips:MaterialSystem ;
    rdfs:label "Layered TMDC, MAX and YRu2Si2-type phases with vacancies (Bjork et al. database)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

# No training dataset is characterised by the paper (see Q12).

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ALIGNN-FF a mlips:MLIPMethod ;
    rdfs:label "ALIGNN-FF (atomistic line graph neural network force field)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-s-berger2025 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0 small (no dispersion, float32) as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-s-berger2025 .

entity:model-mace-s-berger2025 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0 small" .

entity:run-chgnet-berger2025 a mlips:MLIPRun ;
    rdfs:label "CHGNet default model of the chgnet package (version not stated)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-berger2025 .

entity:model-chgnet-berger2025 a mlips:TrainedModel ;
    rdfs:label "CHGNet (package default)" .

entity:run-alignn-berger2025 a mlips:MLIPRun ;
    rdfs:label "ALIGNN-FF mptraj model as distributed (alignn package)" ;
    mlips:appliesMethod entity:ALIGNN-FF ;
    mlips:produces entity:model-alignn-berger2025 .

entity:model-alignn-berger2025 a mlips:TrainedModel ;
    rdfs:label "ALIGNN-FF mptraj" .

# entity:model-m3gnet-chen2022 (M3GNet-MPF-2021.2.8) is evaluated here; its run and model are declared in papers/chen2022.ttl.

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-berger2025 mlips:hasResult
    entity:result-mace-angsten-berger2025 ,
    entity:result-mace-huang-berger2025 ,
    entity:result-mace-bjork-berger2025 .

entity:result-mace-angsten-berger2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-s-berger2025 ;
    mlips:targetMaterial entity:mat-fcchcp-berger2025 ;
    mlips:hasAccuracyMetric entity:metric-mace-angsten-1-berger2025 .

entity:metric-mace-angsten-1-berger2025 a mlips:AccuracyMetric ;
    rdfs:label "Vacancy formation energy RMSE against DFT: MACE-MP-0 small, Angsten et al." ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.8"^^xsd:double ;
    mlips:hasUnit unit:EV .

entity:result-mace-huang-berger2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-s-berger2025 ;
    mlips:targetMaterial entity:mat-twod-berger2025 ;
    mlips:hasAccuracyMetric entity:metric-mace-huang-1-berger2025 .

entity:metric-mace-huang-1-berger2025 a mlips:AccuracyMetric ;
    rdfs:label "Defect formation energy RMSE against DFT: MACE-MP-0 small, Huang et al." ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.46"^^xsd:double ;
    mlips:hasUnit unit:EV .

entity:result-mace-bjork-berger2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mace-s-berger2025 ;
    mlips:targetMaterial entity:mat-layered-berger2025 ;
    mlips:hasAccuracyMetric entity:metric-mace-bjork-1-berger2025 .

entity:metric-mace-bjork-1-berger2025 a mlips:AccuracyMetric ;
    rdfs:label "Vacancy formation energy RMSE against DFT: MACE-MP-0 small, Bjork et al." ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.67"^^xsd:double ;
    mlips:hasUnit unit:EV .

