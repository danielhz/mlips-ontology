# Canonical Turtle for the protocol-derived encoding of:
#   Pascal Plettenberg et al. (2023). Neural network interatomic potential for laser-excited materials.
#   Communications Materials. doi:10.1038/s43246-023-00389-w
#
# Version read: publisher (sha256 782bf0af12250ccf...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 632 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/plettenberg2023.yaml.
#
# Encoding scope: the Te-dependent neural network interatomic potential
# (Te-NNP, a Behler-Parrinello-type high-dimensional NNP with electronic
# temperature as an extra input) for laser-excited Si, trained on the
# published CHIVES thin-film data set of ref. 18. Its accuracy is given
# only as relative error ranges and figures, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-plettenberg2023 a mlips:BenchmarkStudy ;
    rdfs:label "Plettenberg, Bauerhenne and Garcia (2023): electronic-temperature-dependent neural network potential for laser-excited silicon" ;
    mlips:reportedIn entity:article-plettenberg2023 .

entity:article-plettenberg2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s43246-023-00389-w> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Neural network interatomic potential for laser-excited materials" ;
    schema:author <https://orcid.org/0000-0003-4934-7382> ,
        <https://orcid.org/0000-0002-3397-2290> ,
        <https://orcid.org/0000-0003-2418-1902> .

<https://orcid.org/0000-0003-4934-7382> a schema:Person ;
    schema:name "Pascal Plettenberg" ;
    schema:givenName "Pascal" ;
    schema:familyName "Plettenberg" ;
    schema:identifier <https://orcid.org/0000-0003-4934-7382> .

<https://orcid.org/0000-0002-3397-2290> a schema:Person ;
    schema:name "Bernd Bauerhenne" ;
    schema:givenName "Bernd" ;
    schema:familyName "Bauerhenne" ;
    schema:identifier <https://orcid.org/0000-0002-3397-2290> .

<https://orcid.org/0000-0003-2418-1902> a schema:Person ;
    schema:name "Martin E. Garcia" ;
    schema:givenName "Martin E." ;
    schema:familyName "Garcia" ;
    schema:identifier <https://orcid.org/0000-0003-2418-1902> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-si-plettenberg2023 a mlips:MaterialSystem ;
    rdfs:label "Laser-excited silicon thin films and bulk at electronic temperatures 316-31,578 K" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "covalent semiconductor (laser-excited)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-chives-plettenberg2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-chives-plettenberg2023 mlips:hasDFTSettings entity:calc-settings-chives-plettenberg2023 .

entity:calc-settings-chives-plettenberg2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CHIVES-plettenberg2023 ;
    rdfs:comment "In-house Te-dependent DFT code CHIVES; the functional is not named, though the reference melting temperature is compared with LDA DFT (ref. 60)." .

entity:lib-CHIVES-plettenberg2023 a mlips:Library ;
    rdfs:label "CHIVES" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-si-te-plettenberg2023 a mlips:TrainingDataset ;
    rdfs:label "Si thin-film ab initio MD data at 316 K and ten electronic temperatures 3158-31,578 K (from ref. 18)" ;
    mlips:coversMaterial entity:mat-si-plettenberg2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-chives-plettenberg2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-plettenberg2023 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:alg-HDNNP-plettenberg2023 a mls:Algorithm ;
    rdfs:label "Te-dependent atomic NNs with two hidden layers of 50 tanh neurons and no hidden-layer biases (cohesive energy vanishes at large distances); modified radial and angular symmetry functions (Tables 1-2); Adam" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-te-nnp-numLayers-plettenberg2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-te-nnp-learningRate-plettenberg2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-te-nnp-batchSize-plettenberg2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "20"^^xsd:integer .

entity:setting-te-nnp-numEpochs-plettenberg2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-te-nnp-plettenberg2023 a mlips:MLIPRun ;
    rdfs:label "Te-NNP for laser-excited Si" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-si-te-plettenberg2023 ;
    mlips:hasHyperparameterSetting entity:setting-te-nnp-numLayers-plettenberg2023 ,
        entity:setting-te-nnp-learningRate-plettenberg2023 ,
        entity:setting-te-nnp-batchSize-plettenberg2023 ,
        entity:setting-te-nnp-numEpochs-plettenberg2023 ;
    mlips:produces entity:model-te-nnp-plettenberg2023 .

entity:model-te-nnp-plettenberg2023 a mlips:TrainedModel ;
    rdfs:label "Te-NNP Si" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Relative RMS errors are given only as bounds or ranges (energy 'below 2%' for Te < 25,000 K, forces 'between 8 and 12%'; Fig. 2b), so no metric is encoded.
# - Cohesive-energy curves, phonons, electronic heat capacity, RMSD after excitation, melting temperature and large-scale ablation MD are property results.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/plettenberg2023.yaml) until the schema has terms for them.
