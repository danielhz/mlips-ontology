    mlips:evaluatesModel entity:model-SevenNet-0-MPF ;
    mlips:targetMaterial entity:mat-mpf-park2024 ;
    mlips:hasAccuracyMetric entity:metric-sevennet-0-test-1-park2024 ,
        entity:metric-sevennet-0-test-2-park2024 ,
        entity:metric-sevennet-0-test-3-park2024 .

entity:metric-sevennet-0-test-1-park2024 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on energy: SevenNet-0, M3GNet data set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "24"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-sevennet-0-test-2-park2024 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on forces: SevenNet-0, M3GNet data set" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.067"^^xsd:double ;
