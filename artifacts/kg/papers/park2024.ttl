# Canonical Turtle for the protocol-derived encoding of:
#   Yutack Park et al. (2024). Scalable Parallel Algorithm for Graph Neural Network Interatomic Potentials in Molecular Dynamics Simulations.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.4c00190  arXiv:2402.03789v1
#
# Version read: arxiv-preprint arXiv:2402.03789v1 (sha256 4e67f95911c39de6...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 44 (Software/implementation). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the SevenNet package (a parallel LAMMPS implementation
# of the NequIP architecture), the general-purpose pretrained model
# SevenNet-0 trained on the M3GNet (MPF) data set, with its settings and
# test errors, and the 20 NequIP models of varying width and depth
# trained on SiO2 for the parallel-scaling benchmarks.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-park2024 a mlips:BenchmarkStudy ;
    rdfs:label "Park et al. (2024): SevenNet, a scalable parallel algorithm for GNN interatomic potentials in MD, and the pretrained SevenNet-0" ;
    mlips:reportedIn entity:article-park2024 .

entity:article-park2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.4c00190> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Scalable Parallel Algorithm for Graph Neural Network Interatomic Potentials in Molecular Dynamics Simulations" ;
    schema:author <https://orcid.org/0009-0008-8690-935X> ,
        <https://orcid.org/0009-0000-6646-1318> ,
        <https://orcid.org/0000-0002-1523-8340> ,
        <https://orcid.org/0000-0003-3958-0922> .

<https://orcid.org/0009-0008-8690-935X> a schema:Person ;
    schema:name "Yutack Park" ;
    schema:givenName "Yutack" ;
    schema:familyName "Park" ;
    schema:identifier <https://orcid.org/0009-0008-8690-935X> .

<https://orcid.org/0009-0000-6646-1318> a schema:Person ;
    schema:name "Jaesun Kim" ;
    schema:givenName "Jaesun" ;
    schema:familyName "Kim" ;
    schema:identifier <https://orcid.org/0009-0000-6646-1318> .

<https://orcid.org/0000-0002-1523-8340> a schema:Person ;
    schema:name "Seungwoo Hwang" ;
    schema:givenName "Seungwoo" ;
    schema:familyName "Hwang" ;
    schema:identifier <https://orcid.org/0000-0002-1523-8340> .

<https://orcid.org/0000-0003-3958-0922> a schema:Person ;
    schema:name "Seungwu Han" ;
    schema:givenName "Seungwu" ;
    schema:familyName "Han" ;
    schema:identifier <https://orcid.org/0000-0003-3958-0922> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mpf-park2024 a mlips:MaterialSystem ;
    rdfs:label "Materials Project crystal structures over 89 elements (M3GNet MPF data set)" ;
    mlips:materialClass "Universal inorganic crystals; relaxation steps" .

entity:mat-SiO2-park2024 a mlips:MaterialSystem ;
    rdfs:label "SiO2: alpha-quartz at 300 K and melt-quench-anneal configurations (72 formula units)" ;
    mlips:chemicalFormula "SiO2" ;
    mlips:materialClass "Oxide; crystalline, liquid and amorphous" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-sio2-dft-park2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-sio2-dft-park2024 mlips:hasDFTSettings entity:calc-settings-sio2-dft-park2024 .

entity:calc-settings-sio2-dft-park2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "450"^^xsd:double ;
    mlips:kPointMesh "Gamma point only" ;
    rdfs:comment "DFT MD run with the default plane-wave cutoff; sampled snapshots recalculated at 450 eV." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mpf-park2024 a mlips:TrainingDataset ;
    rdfs:label "M3GNet (MPF) data set, 90% training split" ;
    mlips:coversMaterial entity:mat-mpf-park2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "The number of structures is not restated in this paper; the reference settings are those of the Materials Project." .

entity:ds-SiO2-park2024 a mlips:TrainingDataset ;
    rdfs:label "SiO2 DFT MD snapshots (1600 structures)" ;
    mlips:coversMaterial entity:mat-SiO2-park2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1600 ;
    mlips:hasDFTCalculation entity:calc-sio2-dft-park2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-mpf-park2024 mlips:samplingStrategy
    entity:sampling-mpf-relaxation-park2024 .

entity:ds-SiO2-park2024 mlips:samplingStrategy
    entity:sampling-sio2-md-park2024 .

entity:sampling-mpf-relaxation-park2024 a mlips:SamplingStrategy ;
    rdfs:label "Three relaxation steps per Materials Project crystal (M3GNet data set)" ;
    rdfs:comment "Split into training, validation and test sets in proportions 90% / 5% / 5% by material, following the original paper." .

entity:sampling-sio2-md-park2024 a mlips:SamplingStrategy ;
    rdfs:label "DFT MD of SiO2: melt-quench-anneal and alpha-quartz vibrations at 300 K" ;
    rdfs:comment "Snapshots every 40 fs, 1600 structures, shuffled and split 9:1 into training and validation." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-park2024 ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-park2024 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numAngularBasis ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        entity:hp-irreps-park2024 ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-park2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-park2024 a mlips:LossFunction ;
    rdfs:label "Huber loss (delta = 0.01) on energy per atom, force components and stress components, with force weight 0.1 and stress weight 0.01 (SevenNet-0)" .

entity:alg-NequIP-park2024 a mls:Algorithm ;
    rdfs:label "Adam, initial learning rate 0.004, halved when the validation loss does not improve for 50 epochs; multi-GPU training with batch size 16 (SevenNet-0)" .

entity:impl-NequIP-park2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-park2024 .

entity:lib-SevenNet-park2024 a mlips:Library ;
    rdfs:label "SevenNet" ;
    rdfs:comment "PyTorch / e3nn implementation of the NequIP architecture with spatial-decomposition parallelism in LAMMPS through TorchScript; the self-connection tensor product is replaced by a linear layer in SevenNet-0." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-irreps-park2024 a mlips:Hyperparameter ;
    rdfs:label "NequIP node-feature irreducible representations" ;
    mlips:hyperparameterName "irreps" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-sevennet-0-numLayers-park2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "5"^^xsd:integer .

entity:setting-sevennet-0-numFeatures-park2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-sevennet-0-irreps-park2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-irreps-park2024 ;
