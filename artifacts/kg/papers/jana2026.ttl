###############################################################################

entity:run-uma-oc20-jana2026 a mlips:MLIPRun ;
    rdfs:label "UMA small uma-s-1p1 as distributed, OC20 task" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-oc20-jana2026 .

entity:model-uma-oc20-jana2026 a mlips:TrainedModel ;
    rdfs:label "uma-s-1p1 (oc20 task)" .

entity:run-uma-omat-jana2026 a mlips:MLIPRun ;
    rdfs:label "UMA small uma-s-1p1 as distributed, OMat24 task" ;
    mlips:appliesMethod entity:UMA ;
    mlips:produces entity:model-uma-omat-jana2026 .

entity:model-uma-omat-jana2026 a mlips:TrainedModel ;
    rdfs:label "uma-s-1p1 (omat task)" .

