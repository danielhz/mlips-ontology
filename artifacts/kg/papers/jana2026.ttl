# Q7 -- MLIP method, components, implementation
###############################################################################

entity:UMA a mlips:MLIPMethod ;
    rdfs:label "UMA (Universal Models for Atoms, mixture-of-linear-experts equivariant network)" ;
    mlips:hasImplementation entity:impl-UMA-jana2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:impl-UMA-jana2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-fairchem-jana2026 .

entity:lib-fairchem-jana2026 a mlips:Library ;
    rdfs:label "fairchem" ;
    mlips:candidateForVocabulary mlips:Library .

