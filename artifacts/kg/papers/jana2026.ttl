###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-pt-jana2026 a mlips:MaterialSystem ;
    rdfs:label "CO, NO, O and H adsorbed on Pt(111), Pt(110) and Pt(231) slabs" ;
    mlips:chemicalFormula "Pt" ;
    mlips:materialClass "Heterogeneous catalysis: adsorbates on inorganic surfaces" .

entity:mat-iro2-jana2026 a mlips:MaterialSystem ;
    rdfs:label "H, O and OH adsorbed on O-terminated rutile IrO2(110) (1x2 supercell)" ;
    mlips:chemicalFormula "IrO2" ;
    mlips:materialClass "Heterogeneous catalysis: adsorbates on inorganic surfaces" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-rpbe-jana2026 a mlips:DFTCalculation .

entity:calc-pbed3-jana2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-rpbe-jana2026 mlips:hasDFTSettings entity:calc-settings-rpbe-jana2026 .

entity:calc-settings-rpbe-jana2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-RPBE-jana2026 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "550"^^xsd:double ;
    rdfs:comment "Pt systems, spin-polarised and non-spin-polarised, dipole corrections (Sec. 2)." .

entity:calc-pbed3-jana2026 mlips:hasDFTSettings entity:calc-settings-pbed3-jana2026 .

entity:calc-settings-pbed3-jana2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "550"^^xsd:double ;
    rdfs:comment "IrO2 systems, PBE+D3, spin-polarised, dipole corrections (Sec. 2)." .

entity:xc-RPBE-jana2026 a mlips:XCFunctional ;
    rdfs:label "RPBE" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

