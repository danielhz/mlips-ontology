        entity:setting-tensornet-ani2x-2L-batchSize-pelaez2024 ,
        entity:setting-tensornet-ani2x-2L-learningRate-pelaez2024 ,
        entity:setting-tensornet-ani2x-2L-loss-weight-energy-pelaez2024 ,
        entity:setting-tensornet-ani2x-2L-loss-weight-force-pelaez2024 ;
    mlips:produces entity:model-tensornet-ani2x-2L-pelaez2024 .

entity:model-tensornet-ani2x-2L-pelaez2024 a mlips:TrainedModel ;
    rdfs:label "TensorNet 2L, ANI-2x (used for 200 ns MD of four PubChem molecules)" .

entity:run-tensornet-ani2x-0L-pelaez2024 a mlips:MLIPRun ;
    rdfs:label "TensorNet with 0 interaction layers trained on ANI-2x" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:runsOn entity:ds-ani2x-pelaez2024 ;
    mlips:hasHyperparameterSetting entity:setting-tensornet-ani2x-0L-numLayers-pelaez2024 ,
