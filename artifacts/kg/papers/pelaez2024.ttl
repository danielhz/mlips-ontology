###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-pelaez2024 mlips:hasResult
    entity:result-tensornet-qm9-0L-pelaez2024 ,
    entity:result-tensornet-qm9-1L-pelaez2024 ,
    entity:result-tensornet-qm9-2L-pelaez2024 ,
    entity:result-tensornet-qm9-3L-pelaez2024 ,
    entity:result-et-qm9-pelaez2024 .

entity:result-tensornet-qm9-0L-pelaez2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-tensornet-qm9-0L-pelaez2024 ;
    mlips:targetMaterial entity:mat-QM9-pelaez2024 ;
    mlips:hasAccuracyMetric entity:metric-tensornet-qm9-0L-1-pelaez2024 .

entity:metric-tensornet-qm9-0L-1-pelaez2024 a mlips:AccuracyMetric ;
    rdfs:label "MAE on QM9 U0: TensorNet 0L" ;
