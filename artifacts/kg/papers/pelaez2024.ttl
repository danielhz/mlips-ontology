###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-QM9-pelaez2024 a mlips:MaterialSystem ;
    rdfs:label "QM9 small organic molecules (internal energy U0)" ;
    mlips:materialClass "Small organic molecules, equilibrium geometries" .

entity:mat-ani2x-pelaez2024 a mlips:MaterialSystem ;
    rdfs:label "Organic molecules with H, C, N, O, S, F, Cl (ANI-2x data set)" ;
    mlips:materialClass "Small organic molecules, non-equilibrium conformations" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-QM9-pelaez2024 a mlips:TrainingDataset ;
    rdfs:label "QM9 (U0 target)" ;
    mlips:coversMaterial entity:mat-QM9-pelaez2024 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Split sizes are in the hyperparameter tables S3/S5, which were not read." .

entity:ds-ani2x-pelaez2024 a mlips:TrainingDataset ;
    rdfs:label "ANI-2x data set (90% training split)" ;
    mlips:coversMaterial entity:mat-ani2x-pelaez2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-QM9-pelaez2024 mlips:samplingStrategy
    entity:sampling-qm9-pelaez2024 .

entity:ds-ani2x-pelaez2024 mlips:samplingStrategy
    entity:sampling-ani2x-pelaez2024 .

entity:sampling-qm9-pelaez2024 a mlips:SamplingStrategy ;
    rdfs:label "QM9 equilibrium geometries" .

entity:sampling-ani2x-pelaez2024 a mlips:SamplingStrategy ;
    rdfs:label "ANI-2x conformations" ;
    rdfs:comment "Training fraction 0.9, validation fraction 0.1 (Table 6)." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:TensorNet a mlips:MLIPMethod ;
    rdfs:label "TensorNet (Cartesian tensor message-passing neural network)" ;
    mlips:hasTrainingAlgorithm entity:alg-TensorNet-pelaez2024 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:batchSize ,
        mlips:learningRate ,
        entity:hp-loss-weight-energy-pelaez2024 ,
        entity:hp-loss-weight-force-pelaez2024 ;
    mlips:hasImplementation entity:impl-TensorNet-pelaez2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-TensorNet-pelaez2024 a mls:Algorithm ;
    rdfs:label "Learning rate 1e-3 with 1000 warm-up steps, reduced by a factor 0.5 after 4 epochs without improvement down to 1e-7; early stopping with patience 50; gradient clipping at 100 (ANI-2x models)" .

entity:impl-TensorNet-pelaez2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-TorchMD-Net-2_0-pelaez2024 .

entity:TorchMD-ET a mlips:MLIPMethod ;
    rdfs:label "Equivariant Transformer (TorchMD-NET)" ;
    mlips:hasImplementation entity:impl-TorchMD-ET-pelaez2024 .

entity:impl-TorchMD-ET-pelaez2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-TorchMD-Net-2_0-pelaez2024 .

entity:lib-TorchMD-Net-2_0-pelaez2024 a mlips:Library ;
    rdfs:label "TorchMD-Net 2.0" ;
    rdfs:comment "PyTorch-based package with OpenMM integration (openmm-torch); provides TensorNet, the Equivariant Transformer and a graph network." ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-loss-weight-energy-pelaez2024 a mlips:Hyperparameter ;
    rdfs:label "Loss weight of the energy term (y_weight)" ;
    mlips:hyperparameterName "y_weight" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-loss-weight-force-pelaez2024 a mlips:Hyperparameter ;
    rdfs:label "Loss weight of the force term (neg_dy_weight)" ;
    mlips:hyperparameterName "neg_dy_weight" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-tensornet-qm9-0L-numLayers-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "0"^^xsd:integer .

entity:setting-tensornet-qm9-0L-numFeatures-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-tensornet-qm9-1L-numLayers-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-tensornet-qm9-1L-numFeatures-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-tensornet-qm9-2L-numLayers-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-tensornet-qm9-2L-numFeatures-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-tensornet-qm9-3L-numLayers-pelaez2024 a mlips:HyperparameterSetting ;
