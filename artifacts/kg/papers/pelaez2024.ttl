    mlips:settingValue "1"^^xsd:double .

entity:setting-tensornet-ani2x-2L-loss-weight-force-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-loss-weight-force-pelaez2024 ;
    mlips:settingValue "100"^^xsd:integer .

entity:setting-tensornet-ani2x-0L-numLayers-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "0"^^xsd:integer .

entity:setting-tensornet-ani2x-0L-numFeatures-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
