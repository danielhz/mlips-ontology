    rdfs:label "TensorNet 1L, QM9 U0" .

entity:run-tensornet-qm9-2L-pelaez2024 a mlips:MLIPRun ;
    rdfs:label "TensorNet with 2 interaction layers on QM9 U0" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:runsOn entity:ds-QM9-pelaez2024 ;
    mlips:hasHyperparameterSetting entity:setting-tensornet-qm9-2L-numLayers-pelaez2024 ,
        entity:setting-tensornet-qm9-2L-numFeatures-pelaez2024 ;
    mlips:produces entity:model-tensornet-qm9-2L-pelaez2024 .

entity:model-tensornet-qm9-2L-pelaez2024 a mlips:TrainedModel ;
    rdfs:label "TensorNet 2L, QM9 U0" .

entity:run-tensornet-qm9-3L-pelaez2024 a mlips:MLIPRun ;
    rdfs:label "TensorNet with 3 interaction layers and embedding dimension 256 on QM9 U0" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:runsOn entity:ds-QM9-pelaez2024 ;
    mlips:hasHyperparameterSetting entity:setting-tensornet-qm9-3L-numLayers-pelaez2024 ,
        entity:setting-tensornet-qm9-3L-numFeatures-pelaez2024 ;
    mlips:produces entity:model-tensornet-qm9-3L-pelaez2024 .

entity:model-tensornet-qm9-3L-pelaez2024 a mlips:TrainedModel ;
    rdfs:label "TensorNet 3L*, QM9 U0" .

entity:run-et-qm9-pelaez2024 a mlips:MLIPRun ;
    rdfs:label "Equivariant Transformer, new implementation (vector_cutoff = True), on QM9 U0" ;
    mlips:appliesMethod entity:TorchMD-ET ;
    mlips:runsOn entity:ds-QM9-pelaez2024 ;
    mlips:produces entity:model-et-qm9-pelaez2024 .

entity:model-et-qm9-pelaez2024 a mlips:TrainedModel ;
    rdfs:label "Equivariant Transformer (new implementation), QM9 U0" .

entity:run-tensornet-ani2x-2L-pelaez2024 a mlips:MLIPRun ;
    rdfs:label "TensorNet with 2 interaction layers trained on ANI-2x" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:runsOn entity:ds-ani2x-pelaez2024 ;
    mlips:hasHyperparameterSetting entity:setting-tensornet-ani2x-2L-numLayers-pelaez2024 ,
        entity:setting-tensornet-ani2x-2L-numFeatures-pelaez2024 ,
        entity:setting-tensornet-ani2x-2L-cutoffRadius-pelaez2024 ,
