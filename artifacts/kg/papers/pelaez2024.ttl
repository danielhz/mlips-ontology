        entity:setting-tensornet-ani2x-0L-batchSize-pelaez2024 ,
        entity:setting-tensornet-ani2x-0L-learningRate-pelaez2024 ,
        entity:setting-tensornet-ani2x-0L-loss-weight-energy-pelaez2024 ,
        entity:setting-tensornet-ani2x-0L-loss-weight-force-pelaez2024 ;
    mlips:produces entity:model-tensornet-ani2x-0L-pelaez2024 .

