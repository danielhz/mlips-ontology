# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-tensornet-qm9-0L-pelaez2024 a mlips:MLIPRun ;
    rdfs:label "TensorNet with 0 interaction layers on QM9 U0" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:runsOn entity:ds-QM9-pelaez2024 ;
    mlips:hasHyperparameterSetting entity:setting-tensornet-qm9-0L-numLayers-pelaez2024 ,
        entity:setting-tensornet-qm9-0L-numFeatures-pelaez2024 ;
    mlips:produces entity:model-tensornet-qm9-0L-pelaez2024 .

entity:model-tensornet-qm9-0L-pelaez2024 a mlips:TrainedModel ;
    rdfs:label "TensorNet 0L, QM9 U0" .

entity:run-tensornet-qm9-1L-pelaez2024 a mlips:MLIPRun ;
    rdfs:label "TensorNet with 1 interaction layer on QM9 U0" ;
    mlips:appliesMethod entity:TensorNet ;
    mlips:runsOn entity:ds-QM9-pelaez2024 ;
    mlips:hasHyperparameterSetting entity:setting-tensornet-qm9-1L-numLayers-pelaez2024 ,
        entity:setting-tensornet-qm9-1L-numFeatures-pelaez2024 ;
    mlips:produces entity:model-tensornet-qm9-1L-pelaez2024 .

