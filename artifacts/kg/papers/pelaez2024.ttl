entity:result-tensornet-qm9-3L-pelaez2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-tensornet-qm9-3L-pelaez2024 ;
    mlips:targetMaterial entity:mat-QM9-pelaez2024 ;
    mlips:hasAccuracyMetric entity:metric-tensornet-qm9-3L-1-pelaez2024 .

entity:metric-tensornet-qm9-3L-1-pelaez2024 a mlips:AccuracyMetric ;
