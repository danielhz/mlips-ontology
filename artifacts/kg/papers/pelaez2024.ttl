    mlips:targetMaterial entity:mat-QM9-pelaez2024 ;
    mlips:hasAccuracyMetric entity:metric-tensornet-qm9-2L-1-pelaez2024 .

entity:metric-tensornet-qm9-2L-1-pelaez2024 a mlips:AccuracyMetric ;
    rdfs:label "MAE on QM9 U0: TensorNet 2L" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "4.4"^^xsd:double ;
