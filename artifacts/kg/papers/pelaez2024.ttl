# Canonical Turtle for the protocol-derived encoding of:
#   Raúl P. Peláez et al. (2024). TorchMD-Net 2.0: Fast Neural Network Potentials for Molecular Simulations.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.4c00253  arXiv:2402.17660v3
#
# Version read: arxiv-preprint arXiv:2402.17660v3 (sha256 94ff0d18741ff87f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 98 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the TorchMD-Net 2.0 software paper. Encoded are the
# validation fits it reports: TensorNet with 0 to 3 interaction layers
# and the re-implemented Equivariant Transformer on the QM9 U0 target
# (Table 1), and the TensorNet models trained on ANI-2x for stable MD
# (hyperparameters of Table 6).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-pelaez2024 a mlips:BenchmarkStudy ;
    rdfs:label "Pelaez et al. (2024): TorchMD-Net 2.0, fast neural network potentials for molecular simulations" ;
    mlips:reportedIn entity:article-pelaez2024 .

entity:article-pelaez2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.4c00253> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "TorchMD-Net 2.0: Fast Neural Network Potentials for Molecular Simulations" ;
    schema:author <https://orcid.org/0000-0003-3393-7329> ,
