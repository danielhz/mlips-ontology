    mlips:settingValue "256"^^xsd:integer .

entity:setting-tensornet-ani2x-2L-numLayers-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-tensornet-ani2x-2L-numFeatures-pelaez2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-tensornet-ani2x-2L-cutoffRadius-pelaez2024 a mlips:HyperparameterSetting ;
