# Canonical Turtle for the protocol-derived encoding of:
#   Amir Omranpour et al. (2024). A high-dimensional neural network potential for Co3O4.
#   Journal of Physics Condensed Matter. doi:10.1088/1361-648x/ad9f09  arXiv:2409.11037v1
#
# Version read: arxiv-preprint arXiv:2409.11037v1 (sha256 d0c92c9fd1c6f9ec...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 662 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/omranpour2024.yaml.
#
# Encoding scope: the HDNNP for bulk Co3O4 spinel (RuNNer training, n2p2
# in LAMMPS) trained on optPBE-vdW+U data, with its training and test
# RMSEs. Structural, elastic, vibrational and thermodynamic properties are
# property comparisons.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-omranpour2024 a mlips:BenchmarkStudy ;
    rdfs:label "Omranpour and Behler (2024): a high-dimensional neural network potential for Co3O4" ;
    mlips:reportedIn entity:article-omranpour2024 .

entity:article-omranpour2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1361-648x/ad9f09> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "A high-dimensional neural network potential for Co3O4" ;
    schema:author <https://orcid.org/0009-0008-1500-3067> ,
        <https://orcid.org/0000-0002-1220-1542> .

<https://orcid.org/0009-0008-1500-3067> a schema:Person ;
    schema:name "Amir Omranpour" ;
    schema:givenName "Amir" ;
    schema:familyName "Omranpour" ;
    schema:identifier <https://orcid.org/0009-0008-1500-3067> .

<https://orcid.org/0000-0002-1220-1542> a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" ;
    schema:identifier <https://orcid.org/0000-0002-1220-1542> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-co3o4-omranpour2024 a mlips:MaterialSystem ;
    rdfs:label "Bulk Co3O4 spinel (56-atom cells, 0-700 K)" ;
    mlips:chemicalFormula "Co3O4" ;
    mlips:materialClass "transition-metal oxide spinel" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-optpbe-u-omranpour2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-optpbe-u-omranpour2024 mlips:hasDFTSettings entity:calc-settings-optpbe-u-omranpour2024 .

entity:calc-settings-optpbe-u-omranpour2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-optPBE-vdW-U-omranpour2024 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "5x5x5" ;
    rdfs:comment "Spin-polarised; Dudarev U = 2.43 eV on Co; Gaussian smearing." .

entity:xc-optPBE-vdW-U-omranpour2024 a mlips:XCFunctional ;
    rdfs:label "optPBE-vdW+U" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-co3o4-omranpour2024 a mlips:TrainingDataset ;
    rdfs:label "Co3O4 DFT data set (9,692 training and 1,074 test structures)" ;
    mlips:coversMaterial entity:mat-co3o4-omranpour2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10766 ;
    mlips:hasDFTCalculation entity:calc-optpbe-u-omranpour2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-co3o4-omranpour2024 mlips:samplingStrategy
    entity:sampling-aimd-al-omranpour2024 .

entity:sampling-aimd-al-omranpour2024 a mlips:SamplingStrategy ;
    rdfs:label "NPT AIMD snapshots plus HDNNP-ensemble active learning (high committee disagreement) over 0-700 K" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-omranpour2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-HDNNP-omranpour2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation ,
        mlips:GeometryOptimization .

entity:alg-HDNNP-omranpour2024 a mls:Algorithm ;
    rdfs:label "Atomic NNs with three hidden layers of 25, 20 and 15 neurons; radial and angular ACSFs (SI Tables I-II)" .

entity:impl-HDNNP-omranpour2024 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-hdnnp-cutoffRadius-omranpour2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.35"^^xsd:double .

entity:setting-hdnnp-numLayers-omranpour2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-hdnnp-omranpour2024 a mlips:MLIPRun ;
    rdfs:label "HDNNP for Co3O4" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-co3o4-omranpour2024 ;
    mlips:hasHyperparameterSetting entity:setting-hdnnp-cutoffRadius-omranpour2024 ,
        entity:setting-hdnnp-numLayers-omranpour2024 ;
    mlips:produces entity:model-hdnnp-omranpour2024 .

entity:model-hdnnp-omranpour2024 a mlips:TrainedModel ;
    rdfs:label "HDNNP Co3O4" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-omranpour2024 mlips:hasResult
    entity:result-hdnnp-train-omranpour2024 ,
    entity:result-hdnnp-test-omranpour2024 .

entity:result-hdnnp-train-omranpour2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-hdnnp-omranpour2024 ;
    mlips:targetMaterial entity:mat-co3o4-omranpour2024 ;
    mlips:hasAccuracyMetric entity:metric-hdnnp-train-1-omranpour2024 ,
        entity:metric-hdnnp-train-2-omranpour2024 .

entity:metric-hdnnp-train-1-omranpour2024 a mlips:AccuracyMetric ;
    rdfs:label "train energy RMSE on Co3O4: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.409"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-hdnnp-train-2-omranpour2024 a mlips:AccuracyMetric ;
    rdfs:label "train force RMSE on Co3O4: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "55"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-hdnnp-test-omranpour2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-hdnnp-omranpour2024 ;
    mlips:targetMaterial entity:mat-co3o4-omranpour2024 ;
    mlips:hasAccuracyMetric entity:metric-hdnnp-test-1-omranpour2024 ,
        entity:metric-hdnnp-test-2-omranpour2024 .

entity:metric-hdnnp-test-1-omranpour2024 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on Co3O4: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.434"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-hdnnp-test-2-omranpour2024 a mlips:AccuracyMetric ;
    rdfs:label "test force RMSE on Co3O4: HDNNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "56"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

