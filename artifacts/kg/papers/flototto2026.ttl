    rdfs:label "Equidistant snapshots of a 10 ns MACE-MP-0 MD run of MoS2 with two adjacent sulfur vacancies, relabelled with DFT" .

entity:sampling-otf-flototto2026 a mlips:SamplingStrategy ;
    rdfs:label "On-the-fly learning MD (1 ns, 1000 K) with refits when the Bayesian force-error estimate exceeds an adaptive threshold" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-flototto2026 ;
    mlips:hasImplementation entity:impl-MACE-flototto2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-MACE-flototto2026 a mlips:LossFunction ;
    rdfs:label "Energy and forces, force weight 100 times the energy weight" .

entity:impl-MACE-flototto2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-flototto2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:alg-GAP-flototto2026 a mls:Algorithm ;
    rdfs:label "On-the-fly learning during MD with VASP DFT; refits triggered by the Bayesian force-error estimate (threshold initialised at 2 meV/A)" .

