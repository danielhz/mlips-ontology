###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-cp2k-flototto2026 mlips:hasDFTSettings entity:calc-settings-cp2k-flototto2026 .

entity:calc-settings-cp2k-flototto2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-flototto2026 ;
    mlips:xcFunctional mlips:PBE ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "Quickstep with Gaussian basis sets and pseudopotentials, orbital transformation, kinetic-energy cutoff 500 eV; used for the MACE fine-tuning data." .

entity:calc-vasp-flototto2026 mlips:hasDFTSettings entity:calc-settings-vasp-flototto2026 .

entity:calc-settings-vasp-flototto2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "430"^^xsd:double ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "VASP 6.4; used for the GAP on-the-fly training data." .

entity:lib-CP2K-flototto2026 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

