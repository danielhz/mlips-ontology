# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SUS2-MLIP a mlips:MLIPMethod ;
    rdfs:label "SUS2-MLIP (super-linear MLIP with universal scaling and ultra-small parameterisation)" ;
    mlips:hasLossFunction entity:loss-SUS2-MLIP-hu2025global ;
    mlips:hasTrainingAlgorithm entity:alg-SUS2-MLIP-hu2025global ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-SUS2-MLIP-hu2025global ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:PhononCalculation .

entity:loss-SUS2-MLIP-hu2025global a mlips:LossFunction ;
    rdfs:label "Energy, force and stress (initial weights 1, 0.01, 0.001)" .

entity:alg-SUS2-MLIP-hu2025global a mls:Algorithm ;
    rdfs:label "Line-search BFGS" .

entity:impl-SUS2-MLIP-hu2025global a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

