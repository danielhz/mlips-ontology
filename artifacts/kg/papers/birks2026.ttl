###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-si-exp-birks2026 a mlips:MLIPRun ;
    rdfs:label "Expensive Si ACE (nu 4, p 20)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-si-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-si-exp-cutoffRadius-birks2026 ,
        entity:setting-si-exp-corrOrder-birks2026 ,
        entity:setting-si-exp-polyDegree-birks2026 ;
    mlips:produces entity:model-si-exp-birks2026 .

entity:model-si-exp-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX Si ACE (4,20)" .

entity:run-fe-exp-birks2026 a mlips:MLIPRun ;
    rdfs:label "Expensive Fe ACE (nu 3, p 20)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-fe-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-fe-exp-cutoffRadius-birks2026 ,
        entity:setting-fe-exp-corrOrder-birks2026 ,
        entity:setting-fe-exp-polyDegree-birks2026 ;
    mlips:produces entity:model-fe-exp-birks2026 .

entity:model-fe-exp-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX Fe ACE (3,20)" .

entity:run-whe-exp-birks2026 a mlips:MLIPRun ;
    rdfs:label "Expensive W-He ACE (nu 3, p 20)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-whe-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-whe-exp-cutoffRadius-birks2026 ,
        entity:setting-whe-exp-corrOrder-birks2026 ,
        entity:setting-whe-exp-polyDegree-birks2026 ;
    mlips:produces entity:model-whe-exp-birks2026 .

entity:model-whe-exp-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX W-He ACE (3,20)" .

entity:run-w-exp-birks2026 a mlips:MLIPRun ;
    rdfs:label "Expensive W ACE (nu 3, p 21)" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-w-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-w-exp-cutoffRadius-birks2026 ,
        entity:setting-w-exp-corrOrder-birks2026 ,
        entity:setting-w-exp-polyDegree-birks2026 ;
    mlips:produces entity:model-w-exp-birks2026 .

entity:model-w-exp-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX W ACE (3,21)" .

entity:run-whe-mace-birks2026 a mlips:MLIPRun ;
    rdfs:label "Expensive W-He MACE: mace-mpa-0-medium fine-tuned on W-He data (multihead replay; 128 L=1 / 128 L=0 channels, 2 layers)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-whe-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-whe-mace-cutoffRadius-birks2026 ,
        entity:setting-whe-mace-numLayers-birks2026 ,
        entity:setting-whe-mace-numFeatures-birks2026 ;
    mlips:produces entity:model-whe-mace-birks2026 .

entity:model-whe-mace-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX W-He MACE" .

entity:run-si-cheap-dft-birks2026 a mlips:MLIPRun ;
    rdfs:label "Cheap Si linear ACE (nu 2, p 10) fitted directly to the Si DFT data" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-si-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-si-cheap-dft-cutoffRadius-birks2026 ,
        entity:setting-si-cheap-dft-corrOrder-birks2026 ,
        entity:setting-si-cheap-dft-polyDegree-birks2026 ;
    mlips:produces entity:model-si-cheap-dft-birks2026 .

entity:model-si-cheap-dft-birks2026 a mlips:TrainedModel ;
    rdfs:label "Si ACE (2,10) on DFT" .

entity:run-fe-cheap-dft-birks2026 a mlips:MLIPRun ;
    rdfs:label "Cheap Fe linear ACE (nu 2, p 10) fitted directly to the Fe DFT data" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-fe-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-fe-cheap-dft-cutoffRadius-birks2026 ,
