entity:run-w-uf3-syn-birks2026 a mlips:MLIPRun ;
    rdfs:label "Cheap W UF3 (2-body cutoff 6.0 A, 3-body 3.5 A) fitted to synthetic data from the W-He ACE (lambda fixed at 4.3e5)" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-w-syn-birks2026 ;
    mlips:produces entity:model-w-uf3-syn-birks2026 .

entity:model-w-uf3-syn-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX W UF3" .

entity:run-w-snap-birks2026 a mlips:MLIPRun ;
    rdfs:label "Pure W SNAP of Wood and Thompson as distributed" ;
    mlips:appliesMethod entity:SNAP ;
    mlips:produces entity:model-w-snap-birks2026 .

entity:model-w-snap-birks2026 a mlips:TrainedModel ;
    rdfs:label "W SNAP (Wood and Thompson)" .

