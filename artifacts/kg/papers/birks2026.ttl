        entity:setting-fe-cheap-dft-polyDegree-birks2026 ;
    mlips:produces entity:model-fe-cheap-dft-birks2026 .

entity:model-fe-cheap-dft-birks2026 a mlips:TrainedModel ;
    rdfs:label "Fe ACE (2,10) on DFT" .

entity:run-w-uf3-dft-birks2026 a mlips:MLIPRun ;
    rdfs:label "Cheap W UF3 (2-body cutoff 6.0 A, 3-body 3.5 A) fitted directly to the W-He DFT data (W-only configurations)" ;
    mlips:appliesMethod entity:UF3 ;
    mlips:runsOn entity:ds-whe-dft-birks2026 ;
    mlips:produces entity:model-w-uf3-dft-birks2026 .

entity:model-w-uf3-dft-birks2026 a mlips:TrainedModel ;
    rdfs:label "W UF3 on DFT" .

entity:run-w-cheap-birks2026 a mlips:MLIPRun ;
    rdfs:label "Cheap W ACE (nu 3, p 14) fitted to the W DFT data" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-w-dft-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-w-cheap-cutoffRadius-birks2026 ,
        entity:setting-w-cheap-corrOrder-birks2026 ,
        entity:setting-w-cheap-polyDegree-birks2026 ;
    mlips:produces entity:model-w-cheap-birks2026 .

entity:model-w-cheap-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX W ACE (3,14)" .

entity:run-si-cheap-syn-birks2026 a mlips:MLIPRun ;
    rdfs:label "Constrained cheap Si linear ACE (nu 2, p 10) fitted to synthetic data" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-si-syn-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-si-cheap-syn-cutoffRadius-birks2026 ,
        entity:setting-si-cheap-syn-corrOrder-birks2026 ,
        entity:setting-si-cheap-syn-polyDegree-birks2026 ;
    mlips:produces entity:model-si-cheap-syn-birks2026 .

entity:model-si-cheap-syn-birks2026 a mlips:TrainedModel ;
    rdfs:label "ML-MIX Si ACE (2,10) constrained" .

entity:run-fe-cheap-syn-birks2026 a mlips:MLIPRun ;
    rdfs:label "Constrained cheap Fe linear ACE (nu 2, p 10) fitted to synthetic data" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-fe-syn-birks2026 ;
    mlips:hasHyperparameterSetting entity:setting-fe-cheap-syn-cutoffRadius-birks2026 ,
        entity:setting-fe-cheap-syn-corrOrder-birks2026 ,
        entity:setting-fe-cheap-syn-polyDegree-birks2026 ;
    mlips:produces entity:model-fe-cheap-syn-birks2026 .

entity:model-fe-cheap-syn-birks2026 a mlips:TrainedModel ;
