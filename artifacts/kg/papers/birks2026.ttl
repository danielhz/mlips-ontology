# Canonical Turtle for the protocol-derived encoding of:
#   Fraser Birks et al. (2026). Efficient and accurate spatial mixing of machine learned interatomic potentials for materials science.
#   npj Computational Materials. doi:10.1038/s41524-026-01982-6
#
# Version read: publisher (sha256 a7d56949872295c4...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 372 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/birks2026.yaml.
#
# Encoding scope: the expensive potentials (Si, Fe, W-He and W ACE from
# ACEpotentials.jl; W-He MACE fine-tuned from mace-mpa-0-medium with
# multihead replay) and the cheap potentials (Si and Fe linear ACE (2,10),
# W UF3, W ACE (3,14), W SNAP of Wood and Thompson), with the training
# energy and force RMSEs of Table 2 on the full DFT data sets and, for
# the constrained cheap potentials, on synthetic MD data generated by the
# expensive potentials. Elastic constants (Table 3), NEB barriers,
# diffusion coefficients and speedups (Tables 4-5) are properties or
# relative timings.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-birks2026 a mlips:BenchmarkStudy ;
    rdfs:label "Birks et al. (2026): ML-MIX, spatial mixing of expensive and cheap MLIPs with constrained linear fitting (Si, Fe, W, W-He)" ;
    mlips:reportedIn entity:article-birks2026 .

entity:article-birks2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-026-01982-6> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Efficient and accurate spatial mixing of machine learned interatomic potentials for materials science" ;
    schema:author entity:person-Birks-birks2026 ,
        entity:person-Nutter-birks2026 ,
        entity:person-Swinburne-birks2026 ,
        entity:person-Kermode-birks2026 .

entity:person-Birks-birks2026 a schema:Person ;
    schema:name "Fraser Birks" ;
    schema:givenName "Fraser" ;
    schema:familyName "Birks" .

entity:person-Nutter-birks2026 a schema:Person ;
    schema:name "Matthew Nutter" ;
    schema:givenName "Matthew" ;
    schema:familyName "Nutter" .

entity:person-Swinburne-birks2026 a schema:Person ;
    schema:name "Thomas D. Swinburne" ;
    schema:givenName "Thomas D." ;
    schema:familyName "Swinburne" .

entity:person-Kermode-birks2026 a schema:Person ;
    schema:name "James R. Kermode" ;
    schema:givenName "James R." ;
    schema:familyName "Kermode" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-si-birks2026 a mlips:MaterialSystem ;
    rdfs:label "Silicon (diamond; vacancy migration, stretched bond)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "Elemental semiconductor" .

entity:mat-fe-birks2026 a mlips:MaterialSystem ;
    rdfs:label "Bcc iron (self-interstitial dumbbell diffusion)" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "Metals" .

entity:mat-w-birks2026 a mlips:MaterialSystem ;
    rdfs:label "Bcc tungsten (screw dislocations, surfaces, kinks)" ;
    mlips:chemicalFormula "W" ;
    mlips:materialClass "Metals" .

entity:mat-whe-birks2026 a mlips:MaterialSystem ;
    rdfs:label "Tungsten with helium (interstitial He diffusion, He implantation)" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-si-dft-birks2026 a mlips:TrainingDataset ;
    rdfs:label "Si DFT data of Ref. 16" ;
    mlips:coversMaterial entity:mat-si-birks2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-fe-dft-birks2026 a mlips:TrainingDataset ;
    rdfs:label "Fe DFT data of Ref. 49" ;
    mlips:coversMaterial entity:mat-fe-birks2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-whe-dft-birks2026 a mlips:TrainingDataset ;
    rdfs:label "W-He DFT data of Refs. 50-52 (extended with He implantation snapshots, Sec. 4.3)" ;
    mlips:coversMaterial entity:mat-whe-birks2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented .

entity:ds-w-dft-birks2026 a mlips:TrainingDataset ;
    rdfs:label "W DFT data of Ref. 52 (extended with surface and kink configurations, Sec. 4.3)" ;
    mlips:coversMaterial entity:mat-w-birks2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Augmented .

entity:ds-si-syn-birks2026 a mlips:TrainingDataset ;
    rdfs:label "Synthetic Si data from the expensive Si ACE: 500 K bulk MD snapshots (soft) and homogeneous strains (hard constraints)" ;
    mlips:coversMaterial entity:mat-si-birks2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse .

entity:ds-fe-syn-birks2026 a mlips:TrainingDataset ;
    rdfs:label "Synthetic Fe data from the expensive Fe ACE: 1200 K bulk MD snapshots and strains" ;
    mlips:coversMaterial entity:mat-fe-birks2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse .

entity:ds-w-syn-birks2026 a mlips:TrainingDataset ;
    rdfs:label "Synthetic W data from the expensive W-He ACE: 1200 K bulk MD snapshots and strains" ;
    mlips:coversMaterial entity:mat-w-birks2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-corrOrder-birks2026 ,
        entity:hp-polyDegree-birks2026 ;
    mlips:hasImplementation entity:impl-ACE-birks2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:impl-ACE-birks2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-ACEpotentials_jl-birks2026 .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-MACE-birks2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-birks2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:UF3 a mlips:MLIPMethod ;
    rdfs:label "UF3 (ultra-fast force fields: two- and three-body cubic B-spline potentials fitted by regularised linear regression)" ;
    mlips:hasLossFunction entity:loss-UF3-birks2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-UF3-birks2026 a mlips:LossFunction ;
    rdfs:label "Constrained linear least squares (soft MD constraints, hard elastic constraints via an augmented Lagrangian)" .

entity:SNAP a mlips:MLIPMethod ;
    rdfs:label "Spectral Neighbor Analysis Potential (SNAP)" ;
    mlips:hasFunctionalForm entity:ff-SNAP ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-SNAP a mlips:FunctionalForm ;
    rdfs:label "Atomic energy as a linear function of the bispectrum components of the atomic neighbour density" .

entity:lib-ACEpotentials_jl-birks2026 a mlips:Library ;
    rdfs:label "ACEpotentials.jl" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-corrOrder-birks2026 a mlips:Hyperparameter ;
    rdfs:label "ACE correlation order nu" ;
    mlips:hyperparameterName "corrOrder" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-polyDegree-birks2026 a mlips:Hyperparameter ;
    rdfs:label "ACE maximum total polynomial degree p" ;
    mlips:hyperparameterName "polyDegree" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-si-exp-cutoffRadius-birks2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-si-exp-corrOrder-birks2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-corrOrder-birks2026 ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-si-exp-polyDegree-birks2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-polyDegree-birks2026 ;
    mlips:settingValue "20"^^xsd:integer .

