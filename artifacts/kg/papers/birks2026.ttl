entity:study-birks2026 mlips:hasResult
    entity:result-si-exp-train-birks2026 ,
    entity:result-fe-exp-train-birks2026 ,
    entity:result-whe-exp-train-birks2026 ,
    entity:result-w-exp-train-birks2026 ,
    entity:result-whe-mace-train-birks2026 ,
    entity:result-si-cheap-dft-train-birks2026 ,
    entity:result-fe-cheap-dft-train-birks2026 ,
    entity:result-w-uf3-dft-train-birks2026 ,
    entity:result-w-cheap-train-birks2026 ,
    entity:result-si-cheap-syn-train-birks2026 ,
