# Canonical Turtle for the protocol-derived encoding of:
#   Akram Ibrahim et al. (2024). Modeling Chemical Exfoliation of Non-van der Waals Chromium Sulfides by Machine Learning Interatomic Potentials and Monte Carlo Simulations.
#   The Journal of Physical Chemistry C. doi:10.1021/acs.jpcc.3c06168  arXiv:2308.05163v2
#
# Version read: arxiv-preprint arXiv:2308.05163v2 (sha256 c2d3cf6776937b3e...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 532 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/ibrahim2024.yaml.
#
# Encoding scope: the n2p2 Behler-Parrinello NNP for Cr_xS (120-24-24-1,
# radial and angular cutoffs 6.5 and 5.8 A) trained on SQS relaxation
# trajectories and strained/MD ground-state bulk and slab structures
# (VASP PBE), with the train/test energy RMSEs and CPU time of Table S3.
# The cluster expansion is not an MLIP. Configurational optimization,
# exfoliation energetics and Monte Carlo results are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ibrahim2024 a mlips:BenchmarkStudy ;
    rdfs:label "Ibrahim, Wines and Ataca (2024): Behler-Parrinello NNP and cluster expansion with Monte Carlo for chemical exfoliation of non-van der Waals chromium sulfides" ;
    mlips:reportedIn entity:article-ibrahim2024 .

entity:article-ibrahim2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpcc.3c06168> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Modeling Chemical Exfoliation of Non-van der Waals Chromium Sulfides by Machine Learning Interatomic Potentials and Monte Carlo Simulations" ;
    schema:author <https://orcid.org/0009-0008-7311-7062> ,
        <https://orcid.org/0000-0003-3855-3754> ,
        <https://orcid.org/0000-0003-4959-1334> .

<https://orcid.org/0009-0008-7311-7062> a schema:Person ;
    schema:name "Akram Ibrahim" ;
    schema:givenName "Akram" ;
    schema:familyName "Ibrahim" ;
    schema:identifier <https://orcid.org/0009-0008-7311-7062> .

<https://orcid.org/0000-0003-3855-3754> a schema:Person ;
    schema:name "Daniel Wines" ;
    schema:givenName "Daniel" ;
    schema:familyName "Wines" ;
    schema:identifier <https://orcid.org/0000-0003-3855-3754> .

<https://orcid.org/0000-0003-4959-1334> a schema:Person ;
    schema:name "Can Ataca" ;
    schema:givenName "Can" ;
    schema:familyName "Ataca" ;
    schema:identifier <https://orcid.org/0000-0003-4959-1334> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-crs-ibrahim2024 a mlips:MaterialSystem ;
    rdfs:label "Cr_xS bulk and slabs across Cr/vacancy compositions (x = 0 to 1)" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-ibrahim2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-ibrahim2024 mlips:hasDFTSettings entity:calc-settings-vasp-ibrahim2024 .

entity:calc-settings-vasp-ibrahim2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "350"^^xsd:double ;
    mlips:kPointMesh "4000 k-points per reciprocal atom" ;
    rdfs:comment "Collinear spin-polarized" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-crs-ibrahim2024 a mlips:TrainingDataset ;
    rdfs:label "Cr_xS dataset (Table S1; 80/20 train/test split)" ;
    mlips:coversMaterial entity:mat-crs-ibrahim2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-ibrahim2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-crs-ibrahim2024 mlips:samplingStrategy
    entity:sampling-sqs-ibrahim2024 .

entity:sampling-sqs-ibrahim2024 a mlips:SamplingStrategy ;
    rdfs:label "Relaxation trajectories of SQS cells across compositions, plus strained and MD ground-state bulk structures and two-unit-cell slabs selected by NNP query by committee" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-ibrahim2024 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-ibrahim2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-HDNNP-ibrahim2024 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics ,
        mlips:MonteCarlo .

entity:loss-HDNNP-ibrahim2024 a mlips:LossFunction ;
    rdfs:label "Energies and a random fraction of force components per epoch" .

entity:alg-HDNNP-ibrahim2024 a mls:Algorithm ;
    rdfs:label "Adaptive Kalman filter (n2p2)" .

entity:impl-HDNNP-ibrahim2024 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-ibrahim2024 .

entity:lib-n2p2-ibrahim2024 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nnp-cutoffRadius-ibrahim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-nnp-angularCutoff-ibrahim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "5.8"^^xsd:double .

entity:setting-nnp-numLayers-ibrahim2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nnp-ibrahim2024 a mlips:MLIPRun ;
    rdfs:label "Behler-Parrinello NNP for Cr_xS (120-24-24-1)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-crs-ibrahim2024 ;
    mlips:hasHyperparameterSetting entity:setting-nnp-cutoffRadius-ibrahim2024 ,
        entity:setting-nnp-angularCutoff-ibrahim2024 ,
        entity:setting-nnp-numLayers-ibrahim2024 ;
    mlips:produces entity:model-nnp-ibrahim2024 .

entity:model-nnp-ibrahim2024 a mlips:TrainedModel ;
    rdfs:label "NNP Cr_xS" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-ibrahim2024 mlips:hasResult
    entity:result-nnp-test-ibrahim2024 ,
    entity:result-nnp-train-ibrahim2024 .

entity:result-nnp-test-ibrahim2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nnp-ibrahim2024 ;
    mlips:targetMaterial entity:mat-crs-ibrahim2024 ;
    mlips:hasAccuracyMetric entity:metric-nnp-test-1-ibrahim2024 ;
    mlips:inferenceTimePerAtom "3950"^^xsd:double ;
    mlips:inferenceHardware "Single core of an Intel Xeon Gold 6230 at 2.10 GHz" .

entity:metric-nnp-test-1-ibrahim2024 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on Cr_xS: NNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "7.5"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:result-nnp-train-ibrahim2024 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nnp-ibrahim2024 ;
    mlips:targetMaterial entity:mat-crs-ibrahim2024 ;
    mlips:hasAccuracyMetric entity:metric-nnp-train-1-ibrahim2024 .

entity:metric-nnp-train-1-ibrahim2024 a mlips:AccuracyMetric ;
    rdfs:label "training energy RMSE on Cr_xS: NNP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "8.7"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

