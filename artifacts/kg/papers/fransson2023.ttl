# Canonical Turtle for the protocol-derived encoding of:
#   Erik Fransson et al. (2023). Phase Transitions in Inorganic Halide Perovskites from Machine-Learned Potentials.
#   The Journal of Physical Chemistry C. doi:10.1021/acs.jpcc.3c01542  arXiv:2301.03497v1
#
# Version read: arxiv-preprint arXiv:2301.03497v1 (sha256 adb0b5d6379331cc...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 395 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/fransson2023.yaml.
#
# Encoding scope: NEP3 models (gpumd) for CsPbCl3, CsPbBr3 and CsPbI3
# trained on iteratively generated VASP data (rattled prototype
# supercells plus NEP-MD snapshots over four generations) with vdW-DF-cx
# and SCAN (all three halides) and PBEsol and PBE (CsPbI3), and the
# training RMSEs of the final full-data models (Table II). Transition
# temperatures, lattice parameters and free energies are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-fransson2023 a mlips:BenchmarkStudy ;
    rdfs:label "Fransson et al. (2023): phase transitions in inorganic halide perovskites CsPbX3 from neuroevolution potentials trained on four exchange-correlation functionals" ;
    mlips:reportedIn entity:article-fransson2023 .

entity:article-fransson2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jpcc.3c01542> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Phase Transitions in Inorganic Halide Perovskites from Machine-Learned Potentials" ;
    schema:author <https://orcid.org/0000-0001-5262-3339> ,
        <https://orcid.org/0000-0003-3395-1104> ,
        <https://orcid.org/0000-0002-2516-6061> .

<https://orcid.org/0000-0001-5262-3339> a schema:Person ;
    schema:name "Erik Fransson" ;
    schema:givenName "Erik" ;
    schema:familyName "Fransson" ;
    schema:identifier <https://orcid.org/0000-0001-5262-3339> .

<https://orcid.org/0000-0003-3395-1104> a schema:Person ;
    schema:name "Julia Wiktor" ;
    schema:givenName "Julia" ;
    schema:familyName "Wiktor" ;
    schema:identifier <https://orcid.org/0000-0003-3395-1104> .

<https://orcid.org/0000-0002-2516-6061> a schema:Person ;
    schema:name "Paul Erhart" ;
    schema:givenName "Paul" ;
    schema:familyName "Erhart" ;
    schema:identifier <https://orcid.org/0000-0002-2516-6061> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cl-fransson2023 a mlips:MaterialSystem ;
    rdfs:label "CsPbCl3 perovskite and related prototype structures" ;
    mlips:chemicalFormula "CsPbCl3" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-br-fransson2023 a mlips:MaterialSystem ;
    rdfs:label "CsPbBr3 perovskite and related prototype structures" ;
    mlips:chemicalFormula "CsPbBr3" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-i-fransson2023 a mlips:MaterialSystem ;
    rdfs:label "CsPbI3 perovskite, delta phase and related prototype structures" ;
    mlips:chemicalFormula "CsPbI3" ;
    mlips:materialClass "Inorganic crystals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-cx-fransson2023 a mlips:DFTCalculation .

entity:calc-scan-fransson2023 a mlips:DFTCalculation .

entity:calc-pbesol-fransson2023 a mlips:DFTCalculation .

entity:calc-pbe-fransson2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-cx-fransson2023 mlips:hasDFTSettings entity:calc-settings-cx-fransson2023 .

entity:calc-settings-cx-fransson2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-vdW-DF-cx-fransson2023 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "Gamma-centred, 0.18 1/A" ;
    rdfs:comment "Gaussian smearing 0.1 eV (Reference calculations)." .

entity:calc-scan-fransson2023 mlips:hasDFTSettings entity:calc-settings-scan-fransson2023 .

entity:calc-settings-scan-fransson2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:SCAN ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "Gamma-centred, 0.18 1/A" .

entity:calc-pbesol-fransson2023 mlips:hasDFTSettings entity:calc-settings-pbesol-fransson2023 .

entity:calc-settings-pbesol-fransson2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBEsol-fransson2023 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "Gamma-centred, 0.18 1/A" .

entity:calc-pbe-fransson2023 mlips:hasDFTSettings entity:calc-settings-pbe-fransson2023 .

entity:calc-settings-pbe-fransson2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:kPointMesh "Gamma-centred, 0.18 1/A" .

entity:xc-vdW-DF-cx-fransson2023 a mlips:XCFunctional ;
    rdfs:label "vdW-DF-cx" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-PBEsol-fransson2023 a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cl-cx-fransson2023 a mlips:TrainingDataset ;
    rdfs:label "CsPbCl3 training data computed with vdW-DF-cx" ;
    mlips:coversMaterial entity:mat-cl-fransson2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-cx-fransson2023 .

entity:ds-cl-scan-fransson2023 a mlips:TrainingDataset ;
    rdfs:label "CsPbCl3 training data computed with SCAN" ;
    mlips:coversMaterial entity:mat-cl-fransson2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-scan-fransson2023 .

