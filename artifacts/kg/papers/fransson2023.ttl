###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cl-cx-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:ds-cl-scan-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:ds-br-cx-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:ds-br-scan-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:ds-i-cx-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:ds-i-scan-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:ds-i-pbesol-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:ds-i-pbe-fransson2023 mlips:samplingStrategy
    entity:sampling-iter-fransson2023 .

entity:sampling-iter-fransson2023 a mlips:SamplingStrategy ;
    rdfs:label "Monte Carlo rattled prototype supercells (0.04 A, 85-110 % volumes), then NEP-MD at -1 to 10 GPa with 20-620 K ramps, 12 configurations per trajectory, over about four generations; ensemble of five 90/10 models for uncertainty" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-fransson2023 ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-fransson2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        entity:hp-Nneu-fransson2023 ,
        entity:hp-Ngen-fransson2023 ;
    mlips:hasImplementation entity:impl-NEP-fransson2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:ThermodynamicIntegration .

entity:loss-NEP-fransson2023 a mlips:LossFunction ;
    rdfs:label "Energy, force and virial weights 1, 5 and 0.2 with l1 and l2 regularisation (0.1)" .

entity:alg-NEP-fransson2023 a mls:Algorithm ;
    rdfs:label "Separable natural evolution strategy, population 50" .

entity:impl-NEP-fransson2023 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-fransson2023 .

entity:lib-GPUMD-fransson2023 a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-Nneu-fransson2023 a mlips:Hyperparameter ;
    rdfs:label "Number of neurons in the hidden layer of the NEP network" ;
    mlips:hyperparameterName "N_neu" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-Ngen-fransson2023 a mlips:Hyperparameter ;
    rdfs:label "Number of SNES training generations" ;
    mlips:hyperparameterName "N_gen" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

