entity:mat-Na-clusters-nagare2024 a mlips:MaterialSystem ;
    rdfs:label "Free sodium clusters of 40 to 200 atoms" ;
    mlips:chemicalFormula "Na" ;
    mlips:materialClass "Metal clusters" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-nagare2024 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-nagare2024 mlips:hasDFTSettings entity:calc-settings-pbe-nagare2024 .

entity:calc-settings-pbe-nagare2024 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "102"^^xsd:double ;
    rdfs:comment "Force-consistent energies with entropy; SCF tolerance 1e-5 eV; Born-Oppenheimer MD at 50-400 K for data generation." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-m1-nagare2024 a mlips:TrainingDataset ;
    rdfs:label "Na55 training set of model M1 (1,945 configurations)" ;
    mlips:coversMaterial entity:mat-Na55-nagare2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1945 ;
    mlips:hasDFTCalculation entity:calc-pbe-nagare2024 .

entity:ds-m2-nagare2024 a mlips:TrainingDataset ;
    rdfs:label "Multi-size training set of model M2 (1,213 configurations of Na40-Na200)" ;
    mlips:coversMaterial entity:mat-Na-clusters-nagare2024 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1213 ;
    mlips:hasDFTCalculation entity:calc-pbe-nagare2024 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-m1-nagare2024 mlips:samplingStrategy
    entity:sampling-bomd-nagare2024 .

entity:ds-m2-nagare2024 mlips:samplingStrategy
    entity:sampling-bomd-nagare2024 .

entity:sampling-bomd-nagare2024 a mlips:SamplingStrategy ;
    rdfs:label "Born-Oppenheimer MD from solid-like to liquid-like temperatures; configurations selected uniformly over the energy range and refined iteratively at large force errors" ;
    rdfs:comment "About 100,000 Na55 configurations, deduplicated to about 22,000; 20-50 configurations per larger size for M2." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:loss-GAP-nagare2024 ;
    mlips:hasTrainingAlgorithm entity:alg-GAP-nagare2024 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numSparseConfigs ;
    mlips:hasImplementation entity:impl-GAP-nagare2024 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:loss-GAP-nagare2024 a mlips:LossFunction ;
    rdfs:label "Energies and forces (no virials for free clusters)" .

entity:alg-GAP-nagare2024 a mls:Algorithm ;
    rdfs:label "Sparse Gaussian process regression with 2-body, 3-body and SOAP kernels" .

entity:impl-GAP-nagare2024 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-m1-cutoffRadius-nagare2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "12.9"^^xsd:double .

entity:setting-m1-numSparseConfigs-nagare2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "6000"^^xsd:integer .

entity:setting-m2-cutoffRadius-nagare2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "12.9"^^xsd:double .

entity:setting-m2-numSparseConfigs-nagare2024 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numSparseConfigs ;
    mlips:settingValue "6000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-m1-nagare2024 a mlips:MLIPRun ;
    rdfs:label "GAP model M1 (Na55 data only; M1-3)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-m1-nagare2024 ;
    mlips:hasHyperparameterSetting entity:setting-m1-cutoffRadius-nagare2024 ,
        entity:setting-m1-numSparseConfigs-nagare2024 ;
    mlips:trainingHardware "About 180 GB of memory across nodes" ;
    mlips:produces entity:model-m1-nagare2024 .

entity:model-m1-nagare2024 a mlips:TrainedModel ;
    rdfs:label "GAP sodium-cluster model M1" .

entity:run-m2-nagare2024 a mlips:MLIPRun ;
    rdfs:label "GAP model M2 (Na55 plus 40- to 200-atom clusters)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-m2-nagare2024 ;
    mlips:hasHyperparameterSetting entity:setting-m2-cutoffRadius-nagare2024 ,
        entity:setting-m2-numSparseConfigs-nagare2024 ;
    mlips:trainingHardware "More than 650 GB of memory" ;
    mlips:produces entity:model-m2-nagare2024 .

entity:model-m2-nagare2024 a mlips:TrainedModel ;
    rdfs:label "GAP sodium-cluster model M2" .

