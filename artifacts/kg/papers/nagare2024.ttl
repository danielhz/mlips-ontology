# Canonical Turtle for the protocol-derived encoding of:
#   Balasaheb J. Nagare et al. (2024). Machine-Learned Potential Energy Surfaces for Free Sodium Clusters with Density Functional Accuracy: Applications to Melting.
#   Physica Scripta. doi:10.1088/1402-4896/ad37ab  arXiv:2309.08937v1
#
# Version read: arxiv-preprint arXiv:2309.08937v1 (sha256 f3f88ce7f42a2847...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 244 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/nagare2024.yaml.
#
# Encoding scope: the two GAP models (M1 trained on Na55 only, M2 adding
# configurations of 40- to 200-atom clusters) with their validation errors
# (Sec. 2.3, Table 3). Heat capacities, melting temperatures and isomer
# energies/bond lengths (Table 4) are not encoded; the Table 2 maximum
# percentage errors are not accuracy metrics of the schema.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-nagare2024 a mlips:BenchmarkStudy ;
    rdfs:label "Nagare, Chacko and Kanhere (2024): GAP potentials for free sodium clusters and their melting" ;
    mlips:reportedIn entity:article-nagare2024 .

entity:article-nagare2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/1402-4896/ad37ab> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Machine-Learned Potential Energy Surfaces for Free Sodium Clusters with Density Functional Accuracy: Applications to Melting" ;
    schema:author entity:person-Nagare-nagare2024 ,
        <https://orcid.org/0000-0003-1857-7003> ,
        entity:person-Kanhere-nagare2024 .

entity:person-Nagare-nagare2024 a schema:Person ;
    schema:name "Balasaheb J Nagare" ;
    schema:givenName "Balasaheb J" ;
    schema:familyName "Nagare" .

<https://orcid.org/0000-0003-1857-7003> a schema:Person ;
    schema:name "Sajeev Chacko" ;
    schema:givenName "Sajeev" ;
    schema:familyName "Chacko" ;
    schema:identifier <https://orcid.org/0000-0003-1857-7003> .

entity:person-Kanhere-nagare2024 a schema:Person ;
    schema:name "Dilip G Kanhere" ;
    schema:givenName "Dilip G" ;
    schema:familyName "Kanhere" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-Na55-nagare2024 a mlips:MaterialSystem ;
    rdfs:label "Free Na55 cluster" ;
    mlips:chemicalFormula "Na55" ;
    mlips:materialClass "Metal cluster" .

