# Canonical Turtle for the protocol-derived encoding of:
#   Naveen Karuthodi Mohandas et al. (2026). Fine-Tuning Universal Machine-Learned Interatomic Potentials for Applications in the Science of Steels.
#   Journal of Phase Equilibria and Diffusion. doi:10.1007/s11669-025-01225-z
#
# Version read: publisher (sha256 55a497e66148a814...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 271 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/mohandas2026.yaml.
#
# Encoding scope: three MPtrj-trained universal MLIPs (CHGNet 0.2.0,
# MACE-MP-0b3 medium, SevenNet-0) fine-tuned on a PBE bcc-Fe data set by
# naive fine-tuning, layer freezing and (MACE) multi-head replay at
# learning rate 0.0001, with energy and force RMSEs on a random 10% subset
# of MPtrj before and after fine-tuning (forgetting) and RMSEs of
# solute-solute and vacancy-solute binding energies against DFT. Fe
# property tables (Tables 1, 2, 4) are properties, not error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mohandas2026 a mlips:BenchmarkStudy ;
    rdfs:label "Mohandas, Echeverri Restrepo and Sluiter (2026): catastrophic forgetting when fine-tuning CHGNet, MACE and SevenNet on bcc Fe" ;
    mlips:reportedIn entity:article-mohandas2026 .

entity:article-mohandas2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1007/s11669-025-01225-z> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Fine-Tuning Universal Machine-Learned Interatomic Potentials for Applications in the Science of Steels" ;
    schema:author entity:person-Mohandas-mohandas2026 ,
        entity:person-EcheverriRestrepo-mohandas2026 ,
        entity:person-Sluiter-mohandas2026 .

entity:person-Mohandas-mohandas2026 a schema:Person ;
    schema:name "Naveen K. Mohandas" ;
    schema:givenName "Naveen K." ;
    schema:familyName "Mohandas" .

entity:person-EcheverriRestrepo-mohandas2026 a schema:Person ;
    schema:name "Sebastián Echeverri Restrepo" ;
    schema:givenName "Sebastián" ;
    schema:familyName "Echeverri Restrepo" .

entity:person-Sluiter-mohandas2026 a schema:Person ;
    schema:name "Marcel H. F. Sluiter" ;
    schema:givenName "Marcel H. F." ;
    schema:familyName "Sluiter" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mptrj-mohandas2026 a mlips:MaterialSystem ;
    rdfs:label "Materials Project relaxation trajectories (inorganic crystals, 89 elements)" ;
    mlips:materialClass "Inorganic crystals" .

entity:mat-fe-mohandas2026 a mlips:MaterialSystem ;
    rdfs:label "bcc iron with vacancies, grain boundaries, free surfaces and deformed cells" ;
    mlips:chemicalFormula "Fe" ;
    mlips:materialClass "Elemental metal (bcc)" .

entity:mat-fe-solutes-mohandas2026 a mlips:MaterialSystem ;
    rdfs:label "Substitutional solute pairs (Al, Cu, Ni, Nb, Sn, Ti, Zn, Mo, V) and vacancy-solute pairs in bcc Fe, first five neighbour shells" ;
    mlips:materialClass "Dilute iron alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-mohandas2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-mohandas2026 mlips:hasDFTSettings entity:calc-settings-pbe-mohandas2026 .

entity:calc-settings-pbe-mohandas2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    rdfs:comment "MPMetalRelaxSet (pymatgen) inputs consistent with MPtrj; Fe pseudopotential with 8 valence electrons." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-fe-mohandas2026 a mlips:TrainingDataset ;
    rdfs:label "Pure Fe data set (bcc-based structures; 10,400 training structures)" ;
    mlips:coversMaterial entity:mat-fe-mohandas2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 10400 ;
    mlips:hasDFTCalculation entity:calc-pbe-mohandas2026 ;
    rdfs:comment "Defect configurations (vacancies, GBs, surfaces, deformed cells) included in large numbers to weight them." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-CHGNet-mohandas2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:impl-CHGNet-mohandas2026 a mlips:Implementation ;
    mlips:implementedIn mlips:CHGNet .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-mohandas2026 ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-mohandas2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:NudgedElasticBand .

entity:alg-MACE-mohandas2026 a mls:Algorithm ;
    rdfs:label "Naive fine-tuning, freezing of the first four layers, or multi-head replay (MACE 0.3.12)" .

entity:impl-MACE-mohandas2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasHyperparameter mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-mohandas2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization .

entity:impl-NequIP-mohandas2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-mohandas2026 .

entity:lib-SevenNet-mohandas2026 a mlips:Library ;
    rdfs:label "SevenNet" ;
    rdfs:comment "SevenNet implementation of NequIP" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-chg2-naive-learningRate-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-chg2-naive-numEpochs-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-chg2-ft-learningRate-mohandas2026 a mlips:HyperparameterSetting ;
