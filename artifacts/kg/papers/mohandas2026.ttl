    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-sevennet-naive-learningRate-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-sevennet-naive-numEpochs-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-mace-naive-learningRate-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-mace-naive-numEpochs-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

entity:setting-mace-ft-learningRate-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

entity:setting-mace-ft-numEpochs-mohandas2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "50"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-chg2-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet 0.2.0 as distributed (MPtrj)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chg2-mohandas2026 .

entity:model-chg2-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "CHGNet 0.2.0 (CHG2)" .

entity:run-sevennet-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 as distributed (MPtrj; version not stated)" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-sevennet-mohandas2026 .

entity:model-sevennet-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-O" .

entity:run-chg2-naive-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet 0.2.0 naive fine-tuning on the Fe data set" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-fe-mohandas2026 ;
    mlips:hasHyperparameterSetting entity:setting-chg2-naive-learningRate-mohandas2026 ,
        entity:setting-chg2-naive-numEpochs-mohandas2026 ;
    mlips:produces entity:model-chg2-naive-mohandas2026 .

entity:model-chg2-naive-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "CHG2-naive Fe model" .

entity:run-chg2-ft-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "CHGNet 0.2.0 fine-tuned on Fe with only the convolution layers trainable (CHG2-FT)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:runsOn entity:ds-fe-mohandas2026 ;
    mlips:hasHyperparameterSetting entity:setting-chg2-ft-learningRate-mohandas2026 ,
        entity:setting-chg2-ft-numEpochs-mohandas2026 ;
    mlips:produces entity:model-chg2-ft-mohandas2026 .

entity:model-chg2-ft-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "CHG2-FT Fe model" .

entity:run-sevennet-naive-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "SevenNet-0 naive fine-tuning on the Fe data set" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:runsOn entity:ds-fe-mohandas2026 ;
    mlips:hasHyperparameterSetting entity:setting-sevennet-naive-learningRate-mohandas2026 ,
        entity:setting-sevennet-naive-numEpochs-mohandas2026 ;
    mlips:produces entity:model-sevennet-naive-mohandas2026 .

entity:model-sevennet-naive-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "SevenNet-O naive Fe model" .

entity:run-mace-naive-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0b3 medium naive fine-tuning on the Fe data set" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-fe-mohandas2026 ;
    mlips:hasHyperparameterSetting entity:setting-mace-naive-learningRate-mohandas2026 ,
        entity:setting-mace-naive-numEpochs-mohandas2026 ;
    mlips:produces entity:model-mace-naive-mohandas2026 .

entity:model-mace-naive-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "MACE-naive Fe model" .

entity:run-mace-ft-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0b3 medium multi-head replay fine-tuning on the Fe data set (MACE-FT)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-fe-mohandas2026 ;
    mlips:hasHyperparameterSetting entity:setting-mace-ft-learningRate-mohandas2026 ,
        entity:setting-mace-ft-numEpochs-mohandas2026 ;
    mlips:produces entity:model-mace-ft-mohandas2026 .

entity:model-mace-ft-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "MACE-FT (replay) Fe model" .

entity:run-mace-freeze-mohandas2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0b3 medium fine-tuned on Fe with the first four layers frozen" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-fe-mohandas2026 ;
    mlips:produces entity:model-mace-freeze-mohandas2026 .

entity:model-mace-freeze-mohandas2026 a mlips:TrainedModel ;
    rdfs:label "MACE-freeze Fe model" .

