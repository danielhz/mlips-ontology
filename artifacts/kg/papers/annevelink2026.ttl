# Canonical Turtle for the protocol-derived encoding of:
#   Emil Jonathan Annevelink et al. (2026). Triplet Envelope Functions for increasing machine learning interatomic potential efficiency and stability.
#   arXiv (Cornell University). doi:10.48550/arxiv.2602.02228  arXiv:2602.02228v1
#
# Version read: arxiv-preprint arXiv:2602.02228v1 (sha256 3ce951edcaeb61d5...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 688 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/annevelink2026.yaml.
#
# Encoding scope: the study record and its silicon and water active-
# learning data sets. The paper introduces a MEAM-inspired triplet
# envelope function that sparsifies atomic graphs and tests it in an MLIP
# within PHIN's active-learning framework, but it does not name the MLIP
# architecture, and accuracy, speed and memory changes are shown only in
# figures, so no run or result is encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-annevelink2026 a mlips:BenchmarkStudy ;
    rdfs:label "Annevelink and Shankar (2026): triplet envelope functions for MLIP efficiency and stability" ;
    mlips:reportedIn entity:article-annevelink2026 .

entity:article-annevelink2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2602.02228> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Triplet Envelope Functions for increasing machine learning interatomic potential efficiency and stability" ;
    schema:author entity:person-Annevelink-annevelink2026 ,
        entity:person-Shankar-annevelink2026 .

entity:person-Annevelink-annevelink2026 a schema:Person ;
    schema:name "Emil Annevelink" ;
    schema:givenName "Emil" ;
    schema:familyName "Annevelink" .

entity:person-Shankar-annevelink2026 a schema:Person ;
    schema:name "Varun Shankar" ;
    schema:givenName "Varun" ;
    schema:familyName "Shankar" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-si-annevelink2026 a mlips:MaterialSystem ;
    rdfs:label "Crystalline and melted silicon (64 atoms, 3000 K)" ;
    mlips:chemicalFormula "Si" ;
    mlips:materialClass "covalent semiconductor" .

entity:mat-water-annevelink2026 a mlips:MaterialSystem ;
    rdfs:label "Liquid water (20 molecules, 300 K)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-annevelink2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-annevelink2026 mlips:hasDFTSettings entity:calc-settings-dft-annevelink2026 .

entity:calc-settings-dft-annevelink2026 a mlips:DFTSettings ;
    rdfs:comment "Reference method of the PHIN active-learning labels not stated in the text read." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-si-annevelink2026 a mlips:TrainingDataset ;
    rdfs:label "Silicon active-learning set (21 structures, 1344 atomic environments)" ;
    mlips:coversMaterial entity:mat-si-annevelink2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 21 ;
    mlips:hasDFTCalculation entity:calc-dft-annevelink2026 .

entity:ds-water-annevelink2026 a mlips:TrainingDataset ;
    rdfs:label "Water active-learning set (75 structures, 4500 atomic environments)" ;
    mlips:coversMaterial entity:mat-water-annevelink2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 75 ;
    mlips:hasDFTCalculation entity:calc-dft-annevelink2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-si-annevelink2026 mlips:samplingStrategy
    entity:sampling-al-annevelink2026 .

entity:ds-water-annevelink2026 mlips:samplingStrategy
    entity:sampling-al-annevelink2026 .

entity:sampling-al-annevelink2026 a mlips:SamplingStrategy ;
    rdfs:label "PHIN active learning until a 50 ps (Si, 3000 K) or 10 ps (water, 300 K) NVT simulation converges" .

