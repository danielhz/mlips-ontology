# Canonical Turtle for the protocol-derived encoding of:
#   Minwoo Kim et al. (2026). Density diversity in training data governs thermodynamic transferability of machine learning interatomic potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2605.05733  arXiv:2605.05733v1
#
# Version read: arxiv-preprint arXiv:2605.05733v1 (sha256 54f6db0117312b56...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 648 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/kim2026density.yaml.
#
# Encoding scope: the foundation MLIPs evaluated as distributed on Ar,
# H2O and CO2 fluids (7net-0, 7net-OMAT, 7net-MF-OMPA, SO3LR), the
# from-scratch SevenNet models for CO2 trained on MB-pol data with three
# sampling strategies (NoVar, TempVar, DenVar), and the SevenNet students
# distilled from 7net-omni for H2O with the same strategies. Models are
# compared through pair energies, RDF similarity scores and coordination
# numbers, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-kim2026density a mlips:BenchmarkStudy ;
    rdfs:label "Kim et al. (2026): density diversity in training data governs the thermodynamic transferability of MLIPs" ;
    mlips:reportedIn entity:article-kim2026density .

entity:article-kim2026density a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2605.05733> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Density diversity in training data governs thermodynamic transferability of machine learning interatomic potentials" ;
    schema:author entity:person-Kim-kim2026density ,
        entity:person-KimSeungtae-kim2026density ,
        entity:person-Jung-kim2026density ,
        entity:person-Ha-kim2026density ,
        entity:person-Lee-kim2026density .

entity:person-Kim-kim2026density a schema:Person ;
    schema:name "Minwoo Kim" ;
    schema:givenName "Minwoo" ;
    schema:familyName "Kim" .

entity:person-KimSeungtae-kim2026density a schema:Person ;
    schema:name "Seungtae Kim" ;
    schema:givenName "Seungtae" ;
    schema:familyName "Kim" .

entity:person-Jung-kim2026density a schema:Person ;
    schema:name "Je-Yeon Jung" ;
    schema:givenName "Je-Yeon" ;
    schema:familyName "Jung" .

entity:person-Ha-kim2026density a schema:Person ;
    schema:name "Min Young Ha" ;
    schema:givenName "Min Young" ;
    schema:familyName "Ha" .

entity:person-Lee-kim2026density a schema:Person ;
    schema:name "Won Bo Lee" ;
    schema:givenName "Won Bo" ;
    schema:familyName "Lee" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-co2-kim2026density a mlips:MaterialSystem ;
    rdfs:label "Fluid CO2 (64 molecules)" ;
    mlips:chemicalFormula "CO2" ;
    mlips:materialClass "molecular fluid" .

entity:mat-h2o-kim2026density a mlips:MaterialSystem ;
    rdfs:label "Fluid water (64 molecules)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular fluid" .

entity:mat-ar-kim2026density a mlips:MaterialSystem ;
    rdfs:label "Fluid argon" ;
    mlips:chemicalFormula "Ar" ;
    mlips:materialClass "noble-gas fluid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-mbpol-kim2026density a mlips:ReferenceCalculation .

entity:calc-teacher-kim2026density a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-mbpol-kim2026density mlips:hasReferenceSettings entity:calc-settings-mbpol-kim2026density .

entity:calc-settings-mbpol-kim2026density a mlips:ReferenceSettings ;
    rdfs:comment "MB-pol many-body potential (MBX with i-PI; two-body cutoff 9.0, three-body cutoff 4.6)." .

entity:calc-teacher-kim2026density mlips:hasReferenceSettings entity:calc-settings-teacher-kim2026density .

entity:calc-settings-teacher-kim2026density a mlips:ReferenceSettings ;
    rdfs:comment "Labels from the 7net-omni foundation model (teacher), without DFT." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-co2-novar-kim2026density a mlips:TrainingDataset ;
    rdfs:label "CO2 MB-pol training set, NoVar strategy (10% validation)" ;
    mlips:coversMaterial entity:mat-co2-kim2026density ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-mbpol-kim2026density .

entity:ds-co2-tempvar-kim2026density a mlips:TrainingDataset ;
    rdfs:label "CO2 MB-pol training set, TempVar strategy (10% validation)" ;
    mlips:coversMaterial entity:mat-co2-kim2026density ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-mbpol-kim2026density .

entity:ds-co2-denvar-kim2026density a mlips:TrainingDataset ;
    rdfs:label "CO2 MB-pol training set, DenVar strategy (10% validation)" ;
    mlips:coversMaterial entity:mat-co2-kim2026density ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-mbpol-kim2026density .

entity:ds-h2o-novar-kim2026density a mlips:TrainingDataset ;
    rdfs:label "H2O distillation set labelled by 7net-omni, NoVar strategy" ;
    mlips:coversMaterial entity:mat-h2o-kim2026density ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 512 ;
    mlips:hasReferenceCalculation entity:calc-teacher-kim2026density .

entity:ds-h2o-tempvar-kim2026density a mlips:TrainingDataset ;
    rdfs:label "H2O distillation set labelled by 7net-omni, TempVar strategy" ;
    mlips:coversMaterial entity:mat-h2o-kim2026density ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 512 ;
    mlips:hasReferenceCalculation entity:calc-teacher-kim2026density .

entity:ds-h2o-denvar-kim2026density a mlips:TrainingDataset ;
    rdfs:label "H2O distillation set labelled by 7net-omni, DenVar strategy" ;
    mlips:coversMaterial entity:mat-h2o-kim2026density ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 512 ;
    mlips:hasReferenceCalculation entity:calc-teacher-kim2026density .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-co2-novar-kim2026density mlips:samplingStrategy
    entity:sampling-mbpol-md-kim2026density .

entity:ds-co2-tempvar-kim2026density mlips:samplingStrategy
    entity:sampling-mbpol-md-kim2026density .

entity:ds-co2-denvar-kim2026density mlips:samplingStrategy
    entity:sampling-mbpol-md-kim2026density .

entity:ds-h2o-novar-kim2026density mlips:samplingStrategy
    entity:sampling-teacher-md-kim2026density .

entity:ds-h2o-tempvar-kim2026density mlips:samplingStrategy
    entity:sampling-teacher-md-kim2026density .

entity:ds-h2o-denvar-kim2026density mlips:samplingStrategy
    entity:sampling-teacher-md-kim2026density .

entity:sampling-mbpol-md-kim2026density a mlips:SamplingStrategy ;
    rdfs:label "MB-pol NVT MD of 64 CO2 molecules, frames every 0.1 ps; NoVar (baseline density and 500 K), TempVar (temperature variation) or DenVar (density variation) additions of 1024 frames" .

entity:sampling-teacher-md-kim2026density a mlips:SamplingStrategy ;
    rdfs:label "1 ns NVT MD of 64 H2O with 7net-omni, 512 frames per strategy (NoVar 700 K/1.0 g/cm3; TempVar adds 900 K; DenVar adds 0.6 g/cm3)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NequIP a mlips:MLIPMethod ;
    rdfs:label "NequIP (Neural Equivariant Interatomic Potential)" ;
    mlips:hasLossFunction entity:loss-NequIP-kim2026density ;
    mlips:hasTrainingAlgorithm entity:alg-NequIP-kim2026density ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-NequIP-kim2026density ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NequIP-kim2026density a mlips:LossFunction ;
    rdfs:label "Energy, force (weight 0.1) and stress (1e-6) terms" .

entity:alg-NequIP-kim2026density a mls:Algorithm ;
    rdfs:label "SevenNet (NequIP-based) with lmax = 2 (from scratch) or 1 (distilled); Adam with exponential decay 0.99" .

entity:impl-NequIP-kim2026density a mlips:Implementation ;
    mlips:implementedIn entity:lib-SevenNet-kim2026density .

entity:SO3LR a mlips:MLIPMethod ;
    rdfs:label "SO3LR (So3krates-based molecular force field with long-range terms)" ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:lib-SevenNet-kim2026density a mlips:Library ;
    rdfs:label "SevenNet" ;
    mlips:candidateForVocabulary mlips:Library .

