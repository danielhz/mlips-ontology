# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasTrainingAlgorithm entity:alg-ANI-numata2026 ;
    mlips:hasHyperparameter mlips:numFeatures ,
        mlips:learningRate ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-ANI-numata2026 .

entity:alg-ANI-numata2026 a mls:Algorithm ;
    rdfs:label "ANI atomic networks split into L_in and L_out with an inserted quantum circuit layer (Ry/Rz rotations, nq qubits) or a classical layer; pre-training with AdamW/SGD then transfer learning of the inserted layer (simulated quantum circuits)" .

entity:impl-ANI-numata2026 a mlips:Implementation ;
    mlips:implementedIn mlips:TorchANI .

