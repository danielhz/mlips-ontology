@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-numata2026 a mlips:BenchmarkStudy ;
    rdfs:label "Numata et al. (2026): quantum machine-learning interatomic potential with a variational quantum circuit inserted into ANI" ;
    mlips:reportedIn entity:article-numata2026 .

