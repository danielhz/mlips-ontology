@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-parker2026 a mlips:BenchmarkStudy ;
    rdfs:label "Parker et al. (2026): false metallization in short-ranged machine-learned interatomic potentials" ;
