###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cuwater-parker2026 a mlips:MaterialSystem ;
    rdfs:label "Cu(111) slab with liquid water (4-layer 5x6 slab)" ;
    mlips:materialClass "metal-water interface" .

entity:mat-water-parker2026 a mlips:MaterialSystem ;
    rdfs:label "Bulk water, water slabs and ice" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "molecular liquid and ice" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-d3-parker2026 a mlips:DFTCalculation .

entity:calc-revpbe0-parker2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-d3-parker2026 mlips:hasDFTSettings entity:calc-settings-pbe-d3-parker2026 .

entity:calc-settings-pbe-d3-parker2026 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-parker2026 ;
    mlips:xcFunctional entity:xc-PBE-D3-parker2026 ;
    mlips:pseudopotentialType entity:pp-GTH-parker2026 ;
    mlips:basisSet "DZVP-MOLOPT-SR-GTH" ;
    mlips:kPointMesh "Gamma point" ;
    rdfs:comment "500 Ry cutoff; AIMD with deuterium masses, bottom two Cu layers fixed." .

entity:calc-revpbe0-parker2026 mlips:hasDFTSettings entity:calc-settings-revpbe0-parker2026 .

entity:calc-settings-revpbe0-parker2026 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-revPBE0-D3-parker2026 ;
    rdfs:comment "Published water data set of Ref. 63." .

entity:lib-CP2K-parker2026 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE-D3-parker2026 a mlips:XCFunctional ;
    rdfs:label "PBE-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:pp-GTH-parker2026 a mlips:PseudopotentialType ;
    rdfs:label "GTH" ;
    mlips:candidateForVocabulary mlips:PseudopotentialType .

entity:xc-revPBE0-D3-parker2026 a mlips:XCFunctional ;
    rdfs:label "revPBE0-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cu-aimd-parker2026 a mlips:TrainingDataset ;
    rdfs:label "Cu-water AIMD subset (500 configurations; 125 for validation)" ;
    mlips:coversMaterial entity:mat-cuwater-parker2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 500 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-parker2026 .

entity:ds-cu-iter-parker2026 a mlips:TrainingDataset ;
    rdfs:label "Cu-water ITERATIVE data set (Gen3)" ;
    mlips:coversMaterial entity:mat-cuwater-parker2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1322 ;
    mlips:hasDFTCalculation entity:calc-pbe-d3-parker2026 .

entity:ds-water-parker2026 a mlips:TrainingDataset ;
    rdfs:label "revPBE0-D3 bulk water, water slab and ice data of Ref. 63" ;
    mlips:coversMaterial entity:mat-water-parker2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-revpbe0-parker2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cu-aimd-parker2026 mlips:samplingStrategy
    entity:sampling-aimd-parker2026 .

entity:ds-cu-iter-parker2026 mlips:samplingStrategy
    entity:sampling-aimd-parker2026 ,
    entity:sampling-iterative-parker2026 .

entity:sampling-aimd-parker2026 a mlips:SamplingStrategy ;
    rdfs:label "Configurations with a range of net dipoles sampled from Cu-water AIMD" .

entity:sampling-iterative-parker2026 a mlips:SamplingStrategy ;
    rdfs:label "Three generations of SR-MACE MD sampling targeting new dipoles and water dissociation, plus LR-MACE MD configurations (1322 configurations in total)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-parker2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-MACE-parker2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-MACE-parker2026 a mls:Algorithm ;
    rdfs:label "SR-MACE: standard MACE. LR-MACE: local split-charge MACE adding a long-range energy from predicted atomic multipoles on Gaussian basis functions" .

entity:impl-MACE-parker2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-cu-sr-cutoffRadius-parker2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-cu-sr-numLayers-parker2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

