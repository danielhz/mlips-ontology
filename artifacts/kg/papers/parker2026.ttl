entity:run-cu-sr-parker2026 a mlips:MLIPRun ;
    rdfs:label "SR-MACE for Cu-water trained on AIMD data" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-cu-aimd-parker2026 ;
