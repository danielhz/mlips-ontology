# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mpa0-parker2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed (with D3)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mpa0-parker2026 .

entity:model-mpa0-parker2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-matpes-parker2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MATPES-PBE as distributed (with D3)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-matpes-parker2026 .

entity:model-matpes-parker2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MATPES-PBE" .

entity:run-mh1-parker2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MH-1 as distributed (omatpbe, oc20 and omol heads)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mh1-parker2026 .

