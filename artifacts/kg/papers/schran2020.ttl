# Canonical Turtle for the protocol-derived encoding of:
#   Christoph Schran et al. (2020). Committee neural network potentials control generalization errors and enable active learning.
#   The Journal of Chemical Physics. doi:10.1063/5.0016004  arXiv:2006.01541v2
#
# Version read: arxiv-preprint arXiv:2006.01541v2 (sha256 03b100453d8a6ea3...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 462 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/schran2020.yaml.
#
# Encoding scope: eight-member committees of Behler-Parrinello NNPs
# (n2p2), built over four query-by-committee active-learning generations
# for liquid water (300-400 K, 2 and 4 kbar), ice Ih, ice VIII and the
# air-water interface, with classical and quantum (PIMD) nuclei; the
# revPBE0-D3 reference; force RMSEs per generation (Fig. 5 labels),
# the overall generation 4 errors (Fig. 7 "All" row and text) and the
# generation 1 committee-vs-member comparison. Energy-disagreement
# biasing is a method feature, not a separate model.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-schran2020 a mlips:BenchmarkStudy ;
    rdfs:label "Schran et al. (2020): committee neural network potentials (C-NNP) with query-by-committee active learning for water with classical and quantum nuclei" ;
    mlips:reportedIn entity:article-schran2020 .

entity:article-schran2020 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1063/5.0016004> ;
    schema:datePublished "2020"^^xsd:gYear ;
    schema:name "Committee neural network potentials control generalization errors and enable active learning" ;
    schema:author <https://orcid.org/0000-0003-4595-5073> ,
        <https://orcid.org/0000-0003-0285-1282> ,
        <https://orcid.org/0000-0002-8624-8837> .

<https://orcid.org/0000-0003-4595-5073> a schema:Person ;
    schema:name "Christoph Schran" ;
    schema:givenName "Christoph" ;
    schema:familyName "Schran" ;
    schema:identifier <https://orcid.org/0000-0003-4595-5073> .

<https://orcid.org/0000-0003-0285-1282> a schema:Person ;
    schema:name "Krystof Brezina" ;
    schema:givenName "Krystof" ;
    schema:familyName "Brezina" ;
    schema:identifier <https://orcid.org/0000-0003-0285-1282> .

<https://orcid.org/0000-0002-8624-8837> a schema:Person ;
    schema:name "Ondrej Marsalek" ;
    schema:givenName "Ondrej" ;
    schema:familyName "Marsalek" ;
    schema:identifier <https://orcid.org/0000-0002-8624-8837> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-water-schran2020 a mlips:MaterialSystem ;
    rdfs:label "Water (liquid, ice Ih, ice VIII, air-water interface)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-rpbe0-schran2020 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-rpbe0-schran2020 mlips:hasDFTSettings entity:calc-settings-rpbe0-schran2020 .

entity:calc-settings-rpbe0-schran2020 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-schran2020 ;
    mlips:xcFunctional entity:xc-revPBE0-D3-schran2020 ;
    rdfs:comment "CP2K/Quickstep with the electronic-structure setup of Ref. 66" .

entity:lib-CP2K-schran2020 a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-revPBE0-D3-schran2020 a mlips:XCFunctional ;
    rdfs:label "revPBE0-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-gen1-schran2020 a mlips:TrainingDataset ;
    rdfs:label "Generation 1 training set (QbC on classical AIMD of liquid water at 300 K)" ;
    mlips:coversMaterial entity:mat-water-schran2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 111 ;
    mlips:hasDFTCalculation entity:calc-rpbe0-schran2020 .

entity:ds-gen4-schran2020 a mlips:TrainingDataset ;
    rdfs:label "Generation 4 (final) training set" ;
    mlips:coversMaterial entity:mat-water-schran2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 814 ;
    mlips:hasDFTCalculation entity:calc-rpbe0-schran2020 .

entity:ds-gen2-schran2020 a mlips:TrainingDataset ;
    rdfs:label "Generation 2 training set (adds about 250 configurations for ice Ih, liquid water up to 400 K and quantum nuclei)" ;
    mlips:coversMaterial entity:mat-water-schran2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-rpbe0-schran2020 .

entity:ds-gen3-schran2020 a mlips:TrainingDataset ;
    rdfs:label "Generation 3 training set (adds 240 configurations)" ;
    mlips:coversMaterial entity:mat-water-schran2020 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-rpbe0-schran2020 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-gen1-schran2020 mlips:samplingStrategy
    entity:sampling-qbc-schran2020 .

entity:ds-gen4-schran2020 mlips:samplingStrategy
    entity:sampling-qbc-schran2020 .

entity:ds-gen2-schran2020 mlips:samplingStrategy
    entity:sampling-qbc-schran2020 .

entity:ds-gen3-schran2020 mlips:samplingStrategy
    entity:sampling-qbc-schran2020 .

entity:sampling-qbc-schran2020 a mlips:SamplingStrategy ;
    rdfs:label "Query by committee: configurations with the highest mean force disagreement among 8 NNPs, from classical MD and (partially converged) PIMD with C-NNPs of the previous generation, mild energy-disagreement bias" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-schran2020 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-schran2020 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-HDNNP-schran2020 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-schran2020 a mlips:LossFunction ;
    rdfs:label "Energies and forces; each committee member trained on a random 90% subsample" .

entity:alg-HDNNP-schran2020 a mls:Algorithm ;
    rdfs:label "Parallel multistream adaptive global extended Kalman filter (32 streams for final models)" .

entity:impl-HDNNP-schran2020 a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-schran2020 .

entity:lib-n2p2-schran2020 a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-g1-numLayers-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-g1-numEpochs-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

entity:setting-g2-numLayers-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-g2-numEpochs-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

entity:setting-g3-numLayers-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-g3-numEpochs-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

entity:setting-g4-numLayers-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-g4-numEpochs-schran2020 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "100"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-g1-schran2020 a mlips:MLIPRun ;
    rdfs:label "Generation 1 C-NNP (8 members)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-gen1-schran2020 ;
    mlips:hasHyperparameterSetting entity:setting-g1-numLayers-schran2020 ,
        entity:setting-g1-numEpochs-schran2020 ;
    mlips:produces entity:model-g1-schran2020 .

entity:model-g1-schran2020 a mlips:TrainedModel ;
    rdfs:label "C-NNP water generation 1" .

entity:run-g2-schran2020 a mlips:MLIPRun ;
    rdfs:label "Generation 2 C-NNP (8 members)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-gen2-schran2020 ;
    mlips:hasHyperparameterSetting entity:setting-g2-numLayers-schran2020 ,
        entity:setting-g2-numEpochs-schran2020 ;
    mlips:produces entity:model-g2-schran2020 .

entity:model-g2-schran2020 a mlips:TrainedModel ;
    rdfs:label "C-NNP water generation 2" .

entity:run-g3-schran2020 a mlips:MLIPRun ;
    rdfs:label "Generation 3 C-NNP (8 members)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-gen3-schran2020 ;
    mlips:hasHyperparameterSetting entity:setting-g3-numLayers-schran2020 ,
        entity:setting-g3-numEpochs-schran2020 ;
    mlips:produces entity:model-g3-schran2020 .

entity:model-g3-schran2020 a mlips:TrainedModel ;
    rdfs:label "C-NNP water generation 3" .

entity:run-g4-schran2020 a mlips:MLIPRun ;
    rdfs:label "Generation 4 (final) C-NNP (8 members)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-gen4-schran2020 ;
    mlips:hasHyperparameterSetting entity:setting-g4-numLayers-schran2020 ,
        entity:setting-g4-numEpochs-schran2020 ;
    mlips:produces entity:model-g4-schran2020 .

entity:model-g4-schran2020 a mlips:TrainedModel ;
    rdfs:label "C-NNP water generation 4" .

