# Canonical Turtle for the protocol-derived encoding of:
#   Johannes Gasteiger et al. (2021). GemNet: Universal Directional Graph Neural Networks for Molecules.
#   arXiv (Cornell University). doi:10.48550/arxiv.2106.08903  arXiv:2106.08903v10
#
# Version read: arxiv-preprint arXiv:2106.08903v10 (sha256 0a3eeb97afcdaa05...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 58 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the GemNet method (introduced here) in its variants
# GemNet-Q, -T, -dQ and -dT, and its benchmark fits: COLL (Table 1),
# MD17 with 1000 training and validation configurations (Table 3),
# MD17@CCSD (Table 2) and OC20 S2EF for GemNet-dT (Table 4). Values of
# other models in the tables are literature values and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gasteiger2021 a mlips:BenchmarkStudy ;
    rdfs:label "Gasteiger, Becker and Guennemann (2021): GemNet, universal directional graph neural networks for molecules" ;
    mlips:reportedIn entity:article-gasteiger2021 .

entity:article-gasteiger2021 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2106.08903> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "GemNet: Universal Directional Graph Neural Networks for Molecules" ;
    schema:author entity:person-Gasteiger-gasteiger2021 ,
        entity:person-Becker-gasteiger2021 ,
        entity:person-Gunnemann-gasteiger2021 .

entity:person-Gasteiger-gasteiger2021 a schema:Person ;
    schema:name "Johannes Gasteiger" ;
    schema:givenName "Johannes" ;
    schema:familyName "Gasteiger" .

entity:person-Becker-gasteiger2021 a schema:Person ;
    schema:name "Florian Becker" ;
    schema:givenName "Florian" ;
    schema:familyName "Becker" .

entity:person-Gunnemann-gasteiger2021 a schema:Person ;
    schema:name "Stephan Günnemann" ;
    schema:givenName "Stephan" ;
    schema:familyName "Günnemann" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-COLL-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "COLL: configurations from collisions of small organic molecules" ;
    mlips:materialClass "Small organic molecules in collision geometries (gas phase)" .

entity:mat-oc20-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "OC20 adsorbate-catalyst systems (average over the four test sets)" ;
    mlips:materialClass "Heterogeneous-catalysis slab + adsorbate systems" .

entity:mat-aspirin-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-benzene-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-benzene-chmiela2017-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule (MD17, benzene data of Chmiela et al. 2017)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-benzene-chmiela2018-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule (MD17, benzene data of Chmiela et al. 2018)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-ethanol-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-malonaldehyde-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-naphthalene-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Naphthalene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-salicylic-acid-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-toluene-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

entity:mat-uracil-gasteiger2021 a mlips:MaterialSystem ;
    rdfs:label "Uracil molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase), thermalised MD conformations" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ccsd-gasteiger2021 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ccsd-gasteiger2021 mlips:hasWaveFunctionSettings entity:calc-settings-ccsd-gasteiger2021 .

entity:calc-settings-ccsd-gasteiger2021 a mlips:WaveFunctionSettings ;
    rdfs:comment "MD17@CCSD: forces computed with CCSD or CCSD(T) (the paper does not say which applies to which molecule)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-COLL-gasteiger2021 a mlips:TrainingDataset ;
    rdfs:label "COLL training set" ;
    mlips:coversMaterial entity:mat-COLL-gasteiger2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Size and level of theory are not restated in this paper." .

entity:ds-oc20-gasteiger2021 a mlips:TrainingDataset ;
    rdfs:label "OC20 S2EF training data" ;
    mlips:coversMaterial entity:mat-oc20-gasteiger2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "All presented OC20 models are trained on the S2EF data; the subset size is in the appendix and was not captured." .

entity:ds-md17-aspirin-gasteiger2021 a mlips:TrainingDataset ;
    rdfs:label "MD17 aspirin: 1000 training and validation configurations" ;
    mlips:coversMaterial entity:mat-aspirin-gasteiger2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1000 .

