entity:sampling-coll-gasteiger2021 a mlips:SamplingStrategy ;
    rdfs:label "Molecular-collision configurations (COLL)" .

entity:sampling-md17-gasteiger2021 a mlips:SamplingStrategy ;
    rdfs:label "Thermalised MD configurations of single molecules (MD17)" ;
    rdfs:comment "1000 training and validation configurations per molecule, following Batzner et al." .

entity:sampling-md17-ccsd-gasteiger2021 a mlips:SamplingStrategy ;
    rdfs:label "MD17@CCSD configurations" ;
    rdfs:comment "950 training and 50 validation configurations per molecule." .

entity:sampling-oc20-s2ef-gasteiger2021 a mlips:SamplingStrategy ;
    rdfs:label "OC20 S2EF relaxation-trajectory structures" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GemNet a mlips:MLIPMethod ;
    rdfs:label "GemNet (geometric message passing neural network)" ;
    mlips:hasFunctionalForm entity:ff-GemNet ;
    mlips:hasLossFunction entity:loss-GemNet-gasteiger2021 ;
    mlips:hasHyperparameter entity:hp-variant-gasteiger2021 ;
    mlips:inferenceComplexity "O(n k_int^2 k_emb) for GemNet-Q and O(n k_emb^2) for GemNet-T, with k_int interacting neighbours and k_emb embedded directions" .

entity:ff-GemNet a mlips:FunctionalForm ;
    rdfs:label "Directional graph neural network with geometric message passing over atom triplets and, in the two-hop form, quadruplets, built on spherical representations; energies are sums of atomic contributions and forces are obtained by backpropagation or, in the direct variants, predicted directly" .

entity:loss-GemNet-gasteiger2021 a mlips:LossFunction ;
    rdfs:label "Combined energy and force loss with a high force weight (stated without the value)" .

entity:hp-variant-gasteiger2021 a mlips:Hyperparameter ;
    rdfs:label "GemNet variant (two-hop Q or one-hop T message passing; d = direct force prediction)" ;
    mlips:hyperparameterName "variant" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

