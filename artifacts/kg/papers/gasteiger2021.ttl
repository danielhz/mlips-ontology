###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-coll-Q-gasteiger2021 a mlips:MLIPRun ;
    rdfs:label "GemNet-Q trained on COLL (two-hop geometric message passing, forces by backpropagation)" ;
    mlips:appliesMethod entity:GemNet ;
    mlips:runsOn entity:ds-COLL-gasteiger2021 ;
    mlips:hasHyperparameterSetting entity:setting-coll-Q-variant-gasteiger2021 ;
    mlips:produces entity:model-coll-Q-gasteiger2021 .

entity:model-coll-Q-gasteiger2021 a mlips:TrainedModel ;
    rdfs:label "GemNet-Q COLL model" .

entity:run-coll-T-gasteiger2021 a mlips:MLIPRun ;
    rdfs:label "GemNet-T trained on COLL (one-hop (triplet) message passing only, forces by backpropagation)" ;
    mlips:appliesMethod entity:GemNet ;
    mlips:runsOn entity:ds-COLL-gasteiger2021 ;
    mlips:hasHyperparameterSetting entity:setting-coll-T-variant-gasteiger2021 ;
    mlips:produces entity:model-coll-T-gasteiger2021 .

entity:model-coll-T-gasteiger2021 a mlips:TrainedModel ;
    rdfs:label "GemNet-T COLL model" .

entity:run-coll-dQ-gasteiger2021 a mlips:MLIPRun ;
    rdfs:label "GemNet-dQ trained on COLL (two-hop message passing, direct force prediction)" ;
    mlips:appliesMethod entity:GemNet ;
    mlips:runsOn entity:ds-COLL-gasteiger2021 ;
    mlips:hasHyperparameterSetting entity:setting-coll-dQ-variant-gasteiger2021 ;
    mlips:produces entity:model-coll-dQ-gasteiger2021 .

entity:model-coll-dQ-gasteiger2021 a mlips:TrainedModel ;
    rdfs:label "GemNet-dQ COLL model" .

entity:run-coll-dT-gasteiger2021 a mlips:MLIPRun ;
    rdfs:label "GemNet-dT trained on COLL (one-hop message passing, direct force prediction)" ;
    mlips:appliesMethod entity:GemNet ;
