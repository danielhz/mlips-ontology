# Canonical Turtle for the protocol-derived encoding of:
#   Davide Gambino et al. (2026). The diffusion-driven orthorhombic to tetragonal transition in YBa2Cu3O7 derived with a machine learning interatomic potential.
#   npj Quantum Materials. doi:10.1038/s41535-026-00891-7  arXiv:2509.26095v1
#
# Version read: arxiv-preprint arXiv:2509.26095v1 (sha256 2273887c04886e38...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 511 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/gambino2026.yaml.
#
# Encoding scope: the pacemaker ACE potential for YBCO (1,000 functions
# per element, 7 A cutoff, ZBL core repulsion) trained on 1,368 VASP PBE
# configurations (MD of defect-free and defected cells, volume scans,
# amorphous-like cells, oxygen Frenkel pairs and approximate transition
# states); overall and per-subset training/test RMSEs (Sec. II A,
# Table I). Elastic, phonon, defect and transition properties are not
# metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-gambino2026 a mlips:BenchmarkStudy ;
    rdfs:label "Gambino et al. (2026): ACE potential for YBa2Cu3O7 and the diffusion-driven orthorhombic-to-tetragonal transition" ;
    mlips:reportedIn entity:article-gambino2026 .

entity:article-gambino2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41535-026-00891-7> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "The diffusion-driven orthorhombic to tetragonal transition in YBa2Cu3O7 derived with a machine learning interatomic potential" ;
    schema:author entity:person-Gambino-gambino2026 ,
        entity:person-DiEugenio-gambino2026 ,
        entity:person-Byggmastar-gambino2026 ,
        entity:person-Klarbring-gambino2026 ,
        entity:person-Torsello-gambino2026 ,
        entity:person-Djurabekova-gambino2026 ,
        entity:person-Laviano-gambino2026 .

entity:person-Gambino-gambino2026 a schema:Person ;
    schema:name "Davide Gambino" ;
    schema:givenName "Davide" ;
    schema:familyName "Gambino" .

entity:person-DiEugenio-gambino2026 a schema:Person ;
    schema:name "Niccolò Di Eugenio" ;
    schema:givenName "Niccolò" ;
    schema:familyName "Di Eugenio" .

entity:person-Byggmastar-gambino2026 a schema:Person ;
    schema:name "Jesper Byggmästar" ;
    schema:givenName "Jesper" ;
    schema:familyName "Byggmästar" .

entity:person-Klarbring-gambino2026 a schema:Person ;
    schema:name "Johan Klarbring" ;
    schema:givenName "Johan" ;
    schema:familyName "Klarbring" .

entity:person-Torsello-gambino2026 a schema:Person ;
    schema:name "Daniele Torsello" ;
    schema:givenName "Daniele" ;
    schema:familyName "Torsello" .

entity:person-Djurabekova-gambino2026 a schema:Person ;
    schema:name "Flyura Djurabekova" ;
    schema:givenName "Flyura" ;
    schema:familyName "Djurabekova" .

entity:person-Laviano-gambino2026 a schema:Person ;
    schema:name "Francesco Laviano" ;
    schema:givenName "Francesco" ;
    schema:familyName "Laviano" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ybco-gambino2026 a mlips:MaterialSystem ;
    rdfs:label "YBa2Cu3O7 with vacancies, interstitials, oxygen Frenkel pairs and amorphous-like configurations" ;
    mlips:chemicalFormula "YBa2Cu3O7" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-gambino2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-gambino2026 mlips:hasDFTSettings entity:calc-settings-vasp-gambino2026 .

entity:calc-settings-vasp-gambino2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "600"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred 2x2x1 (k-spacing below 0.09 1/A)" ;
    rdfs:comment "Non-spin-polarized; Gaussian smearing 0.05 eV" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ybco-gambino2026 a mlips:TrainingDataset ;
    rdfs:label "YBCO dataset (1,368 configurations, 545,267 atoms; 95% training, 5% test)" ;
    mlips:coversMaterial entity:mat-ybco-gambino2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1368 ;
    mlips:hasDFTCalculation entity:calc-vasp-gambino2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ybco-gambino2026 mlips:samplingStrategy
    entity:sampling-mixed-gambino2026 .

entity:sampling-mixed-gambino2026 a mlips:SamplingStrategy ;
    rdfs:label "MD snapshots (416-atom cells, 20-1250 K) with a preliminary ACE, volume scans, randomized amorphous-like 52-atom cells, perturbed oxygen Frenkel pairs and midpoint transition states" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ACE a mlips:MLIPMethod ;
    rdfs:label "Atomic Cluster Expansion (ACE)" ;
    mlips:hasDescriptor mlips:AtomicClusterExpansionDescriptor ;
    mlips:hasLossFunction entity:loss-ACE-gambino2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-nfunc-gambino2026 ;
    mlips:hasImplementation entity:impl-ACE-gambino2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:PhononCalculation .

entity:loss-ACE-gambino2026 a mlips:LossFunction ;
    rdfs:label "pacemaker energy-based weighting; configurations with forces above 25 eV/A excluded" .

entity:impl-ACE-gambino2026 a mlips:Implementation ;
    mlips:implementedIn mlips:PACE .

entity:hp-nfunc-gambino2026 a mlips:Hyperparameter ;
    rdfs:label "Number of ACE basis functions per element" ;
    mlips:hyperparameterName "functions per element" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-ace-cutoffRadius-gambino2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:integer .

entity:setting-ace-nfunc-gambino2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-nfunc-gambino2026 ;
    mlips:settingValue "1000"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-ace-gambino2026 a mlips:MLIPRun ;
    rdfs:label "ACE potential for YBa2Cu3O7" ;
    mlips:appliesMethod entity:ACE ;
    mlips:runsOn entity:ds-ybco-gambino2026 ;
    mlips:hasHyperparameterSetting entity:setting-ace-cutoffRadius-gambino2026 ,
        entity:setting-ace-nfunc-gambino2026 ;
    mlips:produces entity:model-ace-gambino2026 .

entity:model-ace-gambino2026 a mlips:TrainedModel ;
    rdfs:label "ACE YBCO" .

