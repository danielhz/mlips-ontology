# Canonical Turtle for the protocol-derived encoding of:
#   Eckhoff, Behler. High-Dimensional Neural Network Potentials for
#   Magnetic Systems Using Spin-Dependent Atom-Centered Symmetry
#   Functions. npj Computational Materials 7, 170 (2021).
#   doi:10.1038/s41524-021-00636-z
#   arXiv:2104.14439
#
# Encoding scope: the magnetic HDNNP (mHDNNP) trained for MnO/Mn_xO
# using spin-dependent ACSFs. The headline material is rocksalt MnO
# (and its rhombohedrally distorted AFM-II ground state). The
# spin-augmentation feature itself is not first-class in the MLIPs
# ontology; this is documented as a Q12 gap.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix entity:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-eckhoff2021spin a mlips:BenchmarkStudy ;
    rdfs:label "Eckhoff & Behler (2021): spin-dependent HDNNP for MnO" ;
    mlips:reportedIn entity:article-eckhoff2021spin .

entity:article-eckhoff2021spin a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-021-00636-z> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "High-Dimensional Neural Network Potentials for Magnetic Systems Using Spin-Dependent Atom-Centered Symmetry Functions" ;
    schema:author
        <https://orcid.org/0000-0002-5581-789X> ,
        <https://orcid.org/0000-0002-1220-1542> .

<https://orcid.org/0000-0002-5581-789X> a schema:Person ;
    schema:name "Marco Eckhoff" ;
    schema:givenName "Marco" ;
    schema:familyName "Eckhoff" ;
    schema:identifier <https://orcid.org/0000-0002-5581-789X> .

<https://orcid.org/0000-0002-1220-1542> a schema:Person ;
    schema:name "Jörg Behler" ;
    schema:givenName "Jörg" ;
    schema:familyName "Behler" ;
    schema:identifier <https://orcid.org/0000-0002-1220-1542> .
###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-MnO-eckhoff2021 a mlips:MaterialSystem ;
    rdfs:label "Manganese oxide (MnO and Mn_{0.969}O), rocksalt structure with AFM-II / FM / AFM-I magnetic orders" ;
    mlips:chemicalFormula "MnO" ;
    mlips:materialClass "Antiferromagnetic transition-metal oxide; rhombohedrally distorted rock-salt (AFM-II) magnetic ground state with Neel temperature ~116 K (experiment)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q412356> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:dft-eckhoff2021spin a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:dft-eckhoff2021spin mlips:hasDFTSettings entity:dft-settings-eckhoff2021spin .

entity:dft-settings-eckhoff2021spin a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:HSE06 ;
    mlips:dftBasisSet mlips:NAOIntermediate ;
    mlips:kPointMesh "Gamma-centred 2x2x2 (for 2x2x2 MnO supercells, 64 atoms without vacancies)" ;
    rdfs:comment "HSE06 screened-hybrid functional with screening parameter omega = 0.11 a0^-1; collinear spin-polarised. All-electron numerical-atom-centred-orbital (NAO) basis (FHI-aims intermediate basis, excluding auxiliary 5g hydrogenic functions); no pseudopotential." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-MnO-eckhoff2021 a mlips:TrainingDataset ;
    rdfs:label "mHDNNP MnO/Mn_{0.969}O reference set: 3101 2x2x2 bulk supercells across magnetic states (1387 MnO + 1421 Mn_{0.969}O training; 156 MnO + 137 Mn_{0.969}O test)" ;
    mlips:coversMaterial entity:mat-MnO-eckhoff2021 ;
    mlips:coversProperty mlips:Energy , mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 3101 ;
    mlips:hasDFTCalculation entity:dft-eckhoff2021spin .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-MnO-eckhoff2021 mlips:samplingStrategy
    entity:magnetic-state-sampling-eckhoff2021 ,
    entity:displacement-sampling-eckhoff2021 ,
    entity:lattice-distortion-sampling-eckhoff2021 ,
    entity:vacancy-sampling-eckhoff2021 .

entity:magnetic-state-sampling-eckhoff2021 a mlips:SamplingStrategy ;
    rdfs:label "Magnetic-state enumeration" ;
    rdfs:comment "Various collinear spin orderings of the rocksalt MnO supercell are computed (FM, AFM-I, AFM-II, and excited orders) so the mHDNNP can resolve their energy differences." .

entity:displacement-sampling-eckhoff2021 a mlips:SamplingStrategy ;
    rdfs:label "Atomic-displacement perturbations" ;
    rdfs:comment "Different atomic displacements from the ideal rock-salt lattice positions are generated to span the local PES around each magnetic order." .

entity:lattice-distortion-sampling-eckhoff2021 a mlips:SamplingStrategy ;
    rdfs:label "Lattice-parameter perturbations" ;
    rdfs:comment "Distortions of the lattice parameters (volume / shape) are sampled to describe the rhombohedral distortion of the AFM-II order." .

entity:vacancy-sampling-eckhoff2021 a mlips:SamplingStrategy ;
    rdfs:label "Vacancy-defect sampling" ;
    rdfs:comment "Mn-vacancy supercells (Mn_{0.969}O) are included to extend the mHDNNP to off-stoichiometric configurations." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:mHDNNP a mlips:MLIPMethod ;
    rdfs:label "Magnetic high-dimensional neural network potential (mHDNNP) with spin-dependent atom-centered symmetry functions" ;
    mlips:hasFunctionalForm entity:mhdnnp-functional-form ;
    mlips:hasLossFunction entity:mhdnnp-loss-eckhoff2021 ;
    mlips:hasTrainingAlgorithm entity:mhdnnp-training-eckhoff2021 ;
    mlips:hasHyperparameter mlips:cutoffRadius , entity:hp-Mthresh , entity:hp-hidden-eckhoff2021 ;
    mlips:hasImplementation entity:runner-impl-eckhoff2021 .

entity:mhdnnp-functional-form a mlips:FunctionalForm ;
    rdfs:label "Behler-Parrinello HDNNP with per-element feed-forward atomic networks (3 hidden layers of 20/15/10 neurons), inputs are spin-augmented ACSFs (sACSF) using radial M^0/M^+/M^- and angular M^00/M^++/M^--/M^+- spin-augmentation functions" .

entity:mhdnnp-loss-eckhoff2021 a mlips:LossFunction ;
    rdfs:label "Energy + atomic-force RMSE loss on cohesive energies and force components (90% train / 10% test split)" .

entity:mhdnnp-training-eckhoff2021 a mls:Algorithm ;
    rdfs:label "Standard HDNNP training (gradient-based weight optimisation in RuNNer)" .

entity:runner-impl-eckhoff2021 a mlips:Implementation ;
    mlips:implementedIn mlips:RuNNer ;
    mlips:version "1.00 (modified to support sACSFs)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-rcut-105-eckhoff2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "10.5 a0 (Bohr radii)" .

entity:setting-Mthresh-025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-Mthresh ;
    mlips:settingValue "0.25"^^xsd:double .

entity:setting-hidden-20-15-10 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-hidden-eckhoff2021 ;
    mlips:settingValue "3 hidden layers x (20, 15, 10) neurons per element" .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

entity:run-mhdnnp-MnO a mlips:MLIPRun ;
    rdfs:label "mHDNNP training run on MnO/Mn_{0.969}O dataset" ;
    mlips:appliesMethod entity:mHDNNP ;
    mlips:runsOn entity:ds-MnO-eckhoff2021 ;
    mlips:hasHyperparameterSetting entity:setting-rcut-105-eckhoff2021 , entity:setting-Mthresh-025 , entity:setting-hidden-20-15-10 ;
    mlips:produces entity:model-mhdnnp-MnO .

entity:model-mhdnnp-MnO a mlips:TrainedModel ;
    rdfs:label "Magnetic HDNNP for MnO (sACSF + 3-layer feed-forward NN)" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-eckhoff2021spin mlips:hasResult entity:result-mhdnnp-energy , entity:result-mhdnnp-forces .

entity:result-mhdnnp-energy a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mhdnnp-MnO ;
    mlips:targetMaterial entity:mat-MnO-eckhoff2021 ;
    mlips:hasAccuracyMetric entity:metric-rmse-energy-mhdnnp .

entity:metric-rmse-energy-mhdnnp a mlips:AccuracyMetric ;
    rdfs:label "Test-set RMSE on cohesive energies (sACSF mHDNNP)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.11"^^xsd:double ;
    mlips:hasUnit unit:MilliEV-PER-ATOM .

entity:result-mhdnnp-forces a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-mhdnnp-MnO ;
    mlips:targetMaterial entity:mat-MnO-eckhoff2021 ;
    mlips:hasAccuracyMetric entity:metric-rmse-forces-mhdnnp .

entity:metric-rmse-forces-mhdnnp a mlips:AccuracyMetric ;
    rdfs:label "Test-set RMSE on atomic force components (sACSF mHDNNP)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.066"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Eckhoff & Behler (2021) does not report training duration, GPU
# hours, training hardware, peak memory, or per-atom inference time
# for the mHDNNP. Recorded as a Q12 gap.

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

entity:hp-Mthresh a mlips:Hyperparameter ;
    rdfs:label "HDNNP ACSF amplitude threshold" ;
    mlips:hyperparameterName "M_thresh" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-hidden-eckhoff2021 a mlips:Hyperparameter ;
    rdfs:label "HDNNP per-element hidden layer architecture" ;
    mlips:hyperparameterName "hidden_layers" ;
    mlips:hyperparameterDatatype xsd:string ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

# schema:affiliation links added by issue-0005 sweep.
<https://orcid.org/0000-0002-5581-789X> schema:affiliation entity:org-UniversityofGottingen-eckhoff2021spin .
<https://orcid.org/0000-0002-1220-1542> schema:affiliation entity:org-UniversityofGottingen-eckhoff2021spin .

entity:org-UniversityofGottingen-eckhoff2021spin a schema:Organization ;
    rdfs:label "University of Göttingen" ;
    schema:name "University of Göttingen" ;
    schema:identifier <https://ror.org/01y9bpm73> ;
    rdfs:comment "Paper-local Organization IRI; not promoted to mlips-vocab.ttl (occurs in fewer than 3 papers)." .
