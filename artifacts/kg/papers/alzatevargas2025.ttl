###############################################################################

entity:calc-pbe-alzatevargas2025 mlips:hasDFTSettings entity:calc-settings-pbe-alzatevargas2025 .

entity:calc-settings-pbe-alzatevargas2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
