entity:run-hipnn-alzatevargas2025 a mlips:MLIPRun ;
    rdfs:label "HIP-NN potential for UN (one interaction layer, 60 features, 20 sensitivity functions, tensor order 1)" ;
    mlips:appliesMethod entity:HIP-NN ;
    mlips:runsOn entity:ds-un-alzatevargas2025 ;
    mlips:hasHyperparameterSetting entity:setting-hipnn-numLayers-alzatevargas2025 ,
