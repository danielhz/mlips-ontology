###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-un-alzatevargas2025 mlips:samplingStrategy
    entity:sampling-qbc-alzatevargas2025 .

entity:sampling-qbc-alzatevargas2025 a mlips:SamplingStrategy ;
    rdfs:label "Query-by-committee active learning with an ensemble of eight ANI models; ASE MD with ramped and sinusoidally modulated temperature and density; defect configurations added manually early on" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ANI a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME) neural network potential" ;
    mlips:hasDescriptor mlips:ANIDescriptor ;
    mlips:hasLossFunction entity:loss-ANI-alzatevargas2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:numRadialBasis ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:loss-ANI-alzatevargas2025 a mlips:LossFunction ;
    rdfs:label "Energy and force weights 1.0 and 0.1" .

entity:HIP-NN a mlips:MLIPMethod ;
    rdfs:label "Hierarchically Interacting Particle Neural Network (HIP-NN)" ;
    mlips:hasFunctionalForm entity:ff-HIP-NN ;
    mlips:hasLossFunction entity:loss-HIP-NN-alzatevargas2025 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-HIP-NN-alzatevargas2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand .

entity:ff-HIP-NN a mlips:FunctionalForm ;
    rdfs:label "Deep neural network with on-site and interaction layers over inverse-distance sensitivity functions; the molecular energy is a sum of atomic energies decomposed into hierarchical contributions from successive interaction layers" .

entity:loss-HIP-NN-alzatevargas2025 a mlips:LossFunction ;
    rdfs:label "Energy and force weights 1.0 and 1.0" .

entity:impl-HIP-NN-alzatevargas2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-hippynn-alzatevargas2025 .

entity:lib-hippynn-alzatevargas2025 a mlips:Library ;
    rdfs:label "hippynn" ;
    mlips:candidateForVocabulary mlips:Library .

