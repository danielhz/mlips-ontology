# Canonical Turtle for the protocol-derived encoding of:
#   Ivan  Sergeyevich Novikov et al. (2018). Automated calculation of thermal rate coefficients using ring polymer molecular dynamics and machine-learning interatomic potentials with active learning.
#   Physical Chemistry Chemical Physics. doi:10.1039/c8cp06037a  arXiv:1805.11924v3
#
# Version read: arxiv-preprint arXiv:1805.11924v3 (sha256 ed65bb6a4c1bb2f2...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 621 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/novikov2018.yaml.
#
# Encoding scope: the moment tensor potentials fitted on the fly (active
# learning with extrapolation grades) to two existing reference PESs, for
# OH + H2 -> H + H2O (NN1 PES) and CH4 + CN -> CH3 + HCN (PES2017), and
# used in RPMDrate simulations. Accuracy is reported only as PMF and rate
# coefficient agreement, so there are no results.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-novikov2018 a mlips:BenchmarkStudy ;
    rdfs:label "Novikov, Suleimanov and Shapeev (2018): active-learning MTPs for RPMD thermal rate coefficients" ;
    mlips:reportedIn entity:article-novikov2018 .

entity:article-novikov2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/c8cp06037a> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Automated calculation of thermal rate coefficients using ring polymer molecular dynamics and machine-learning interatomic potentials with active learning" ;
    schema:author entity:person-Novikov-novikov2018 ,
        <https://orcid.org/0000-0001-9978-2791> ,
        entity:person-Shapeev-novikov2018 .

entity:person-Novikov-novikov2018 a schema:Person ;
    schema:name "I. S. Novikov" ;
    schema:givenName "I. S." ;
    schema:familyName "Novikov" .

<https://orcid.org/0000-0001-9978-2791> a schema:Person ;
    schema:name "Y. V. Suleimanov" ;
    schema:givenName "Y. V." ;
    schema:familyName "Suleimanov" ;
    schema:identifier <https://orcid.org/0000-0001-9978-2791> .

entity:person-Shapeev-novikov2018 a schema:Person ;
    schema:name "A. V. Shapeev" ;
    schema:givenName "A. V." ;
    schema:familyName "Shapeev" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ohh2-novikov2018 a mlips:MaterialSystem ;
    rdfs:label "OH + H2 -> H + H2O reacting system" ;
    mlips:materialClass "gas-phase bimolecular reaction" .

entity:mat-ch4cn-novikov2018 a mlips:MaterialSystem ;
    rdfs:label "CH4 + CN -> CH3 + HCN reacting system" ;
    mlips:materialClass "gas-phase bimolecular reaction" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-nn1-novikov2018 a mlips:ReferenceCalculation .

entity:calc-pes2017-novikov2018 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-nn1-novikov2018 mlips:hasReferenceSettings entity:calc-settings-nn1-novikov2018 .

entity:calc-settings-nn1-novikov2018 a mlips:ReferenceSettings ;
    rdfs:comment "NN1 neural-network PES of Ref. 55 used as the 'ab initio' reference model." .

entity:calc-pes2017-novikov2018 mlips:hasReferenceSettings entity:calc-settings-pes2017-novikov2018 .

entity:calc-settings-pes2017-novikov2018 a mlips:ReferenceSettings ;
    rdfs:comment "PES2017 semi-empirical analytical PES (34 fitted parameters) of Ref. 54 used as the reference model." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ohh2-novikov2018 a mlips:TrainingDataset ;
    rdfs:label "Actively selected OH + H2 configurations labelled with NN1 PES" ;
    mlips:coversMaterial entity:mat-ohh2-novikov2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-nn1-novikov2018 .

entity:ds-ch4cn-novikov2018 a mlips:TrainingDataset ;
    rdfs:label "Actively selected CH4 + CN configurations labelled with PES2017" ;
    mlips:coversMaterial entity:mat-ch4cn-novikov2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-pes2017-novikov2018 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-ohh2-novikov2018 mlips:samplingStrategy
    entity:sampling-al-rpmd-novikov2018 .

entity:ds-ch4cn-novikov2018 mlips:samplingStrategy
    entity:sampling-al-rpmd-novikov2018 .

entity:sampling-al-rpmd-novikov2018 a mlips:SamplingStrategy ;
    rdfs:label "On-the-fly active learning during RPMDrate umbrella sampling and recrossing trajectories (extrapolation-grade thresholds 2 and 10)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasLossFunction entity:loss-MTP-novikov2018 ;
    mlips:hasTrainingAlgorithm entity:alg-MTP-novikov2018 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-MTP-novikov2018 a mlips:LossFunction ;
    rdfs:label "Squared energy and force errors with force weight wf" .

entity:alg-MTP-novikov2018 a mls:Algorithm ;
    rdfs:label "92 basis functions, 4 radial functions, 12 Chebyshev radial basis functions; D-optimality extrapolation grade for active learning; used in ring-polymer MD (RPMDrate)" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-ohh2-cutoffRadius-novikov2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-mtp-ch4cn-cutoffRadius-novikov2018 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-ohh2-novikov2018 a mlips:MLIPRun ;
    rdfs:label "Actively learned MTP for OH + H2 (about 300 parameters)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-ohh2-novikov2018 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-ohh2-cutoffRadius-novikov2018 ;
    mlips:produces entity:model-mtp-ohh2-novikov2018 .

entity:model-mtp-ohh2-novikov2018 a mlips:TrainedModel ;
    rdfs:label "AL-MTP OH+H2" .

entity:run-mtp-ch4cn-novikov2018 a mlips:MLIPRun ;
    rdfs:label "Actively learned MTP for CH4 + CN (about 500 parameters)" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-ch4cn-novikov2018 ;
    mlips:hasHyperparameterSetting entity:setting-mtp-ch4cn-cutoffRadius-novikov2018 ;
    mlips:produces entity:model-mtp-ch4cn-novikov2018 .

entity:model-mtp-ch4cn-novikov2018 a mlips:TrainedModel ;
    rdfs:label "AL-MTP CH4+CN" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

# No energy/force/stress accuracy metric is reported in a form the schema captures (see Q12).

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - No energy or force errors are stated; agreement is given as PMF differences 'less than 0.3 kcal/mol' and rate-coefficient RMS deviations of 'about 20% or less' (Tables 1-2), which are bounds on properties.
# - Training-set sizes depend on temperature and bead number (Table 3, at most 5000); separate kQTST and kappa MTPs per condition are summarised as one run per reaction.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/novikov2018.yaml) until the schema has terms for them.
