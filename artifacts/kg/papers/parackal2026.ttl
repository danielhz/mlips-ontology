# Canonical Turtle for the protocol-derived encoding of:
#   Abhijith S. Parackal et al. (2026). Symmetry‐Restricted Energy Landscapes as a Benchmark for Machine Learned Interatomic Potentials.
#   Advanced Theory and Simulations. doi:10.1002/adts.70506  arXiv:2602.02237v1
#
# Version read: arxiv-preprint arXiv:2602.02237v1 (sha256 2692bdb346ba7497...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 276 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/parackal2026.yaml.
#
# Encoding scope: nine pretrained universal MLIPs (Table I: six MACE
# checkpoints, SevenNet-0 11Jul2024, ORB v2, CHGNet 0.3.0) evaluated on
# two-dimensional slices of the PES along Wyckoff degrees of freedom
# (W2N3, AlTiN3 and further structures) and in symmetry-constrained
# relaxations, compared visually with DFT. No error metric is reported.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-parackal2026 a mlips:BenchmarkStudy ;
    rdfs:label "Parackal, Armiento and Trybel (2026): symmetry-restricted two-dimensional energy landscapes as a benchmark for universal MLIPs" ;
    mlips:reportedIn entity:article-parackal2026 .

entity:article-parackal2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1002/adts.70506> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Symmetry‐Restricted Energy Landscapes as a Benchmark for Machine Learned Interatomic Potentials" ;
    schema:author <https://orcid.org/0000-0003-0747-1289> ,
        <https://orcid.org/0000-0002-5571-0814> ,
        <https://orcid.org/0000-0003-0514-5084> .

<https://orcid.org/0000-0003-0747-1289> a schema:Person ;
    schema:name "Abhijith S. Parackal" ;
    schema:givenName "Abhijith S." ;
    schema:familyName "Parackal" ;
    schema:identifier <https://orcid.org/0000-0003-0747-1289> .

<https://orcid.org/0000-0002-5571-0814> a schema:Person ;
    schema:name "Rickard Armiento" ;
    schema:givenName "Rickard" ;
    schema:familyName "Armiento" ;
    schema:identifier <https://orcid.org/0000-0002-5571-0814> .

<https://orcid.org/0000-0003-0514-5084> a schema:Person ;
    schema:name "Florian Trybel" ;
    schema:givenName "Florian" ;
    schema:familyName "Trybel" ;
    schema:identifier <https://orcid.org/0000-0003-0514-5084> .

