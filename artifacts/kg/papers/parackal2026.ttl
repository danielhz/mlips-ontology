entity:run-orb-v2-parackal2026 a mlips:MLIPRun ;
    rdfs:label "ORB v2 (orb-v2) as distributed" ;
    mlips:appliesMethod entity:ORB ;
    mlips:produces entity:model-orb-v2-parackal2026 .

entity:model-orb-v2-parackal2026 a mlips:TrainedModel ;
