entity:run-mace-medium-parackal2026 a mlips:MLIPRun ;
    rdfs:label "MACE_medium as distributed (weights listed as MACE-MP-0 small)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-medium-parackal2026 .

entity:model-mace-medium-parackal2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0 (labelled MACE_medium; weights MACE-MP-0 small)" .

