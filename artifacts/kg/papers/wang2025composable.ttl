    schema:familyName "Samanta" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-nb-wang2025composable a mlips:MaterialSystem ;
    rdfs:label "Niobium (bcc, fcc, hcp under compression and shear, point defects, stacking faults, grain boundaries, liquid)" ;
    mlips:chemicalFormula "Nb" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-wang2025composable a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-wang2025composable mlips:hasDFTSettings entity:calc-settings-vasp-wang2025composable .

entity:calc-settings-vasp-wang2025composable a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    rdfs:comment "Nb ground-truth dataset of the GEAM potential (Ref. 6)" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-nb-wang2025composable a mlips:TrainingDataset ;
    rdfs:label "Nb ground-truth dataset (112,613 total energies, 37,496 force vectors)" ;
    mlips:coversMaterial entity:mat-nb-wang2025composable ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 112613 ;
    mlips:hasDFTCalculation entity:calc-vasp-wang2025composable .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-nb-wang2025composable mlips:samplingStrategy
    entity:sampling-geam-wang2025composable .

entity:sampling-geam-wang2025composable a mlips:SamplingStrategy ;
    rdfs:label "Published Nb dataset of Ref. 6 (112,613 total energies; Table II)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:ComposableMLIP a mlips:MLIPMethod ;
    rdfs:label "Composable single- and dual-term cluster-basis MLIPs (linear, exponentiated and product pair-cluster models) designed by Fisher-information analysis" ;
    mlips:hasLossFunction entity:loss-ComposableMLIP-wang2025composable ;
    mlips:hasTrainingAlgorithm entity:alg-ComposableMLIP-wang2025composable ;
    mlips:hasHyperparameter entity:hp-nlin-wang2025composable ,
        entity:hp-nnonlin-wang2025composable .

entity:loss-ComposableMLIP-wang2025composable a mlips:LossFunction ;
    rdfs:label "Equal-weight least squares on total energies and forces" .

entity:alg-ComposableMLIP-wang2025composable a mls:Algorithm ;
    rdfs:label "Dual-bipartite training: linear regression for linear coefficients, Bayesian optimization for nonlinear coefficients" .

entity:hp-nlin-wang2025composable a mlips:Hyperparameter ;
    rdfs:label "Number of linear coefficients c" ;
    mlips:hyperparameterName "c" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-nnonlin-wang2025composable a mlips:Hyperparameter ;
    rdfs:label "Number of nonlinear coefficients d" ;
    mlips:hyperparameterName "d" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

