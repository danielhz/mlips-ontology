# Canonical Turtle for the protocol-derived encoding of:
#   Weishi Wang et al. (2025). Composable and adaptive design of machine learning interatomic potentials guided by Fisher-information analysis.
#   arXiv (Cornell University). doi:10.48550/arxiv.2504.19372  arXiv:2504.19372v2
#
# Version read: arxiv-preprint arXiv:2504.19372v2 (sha256 84beb0d51a24fe02...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 551 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wang2025composable.yaml.
#
# Encoding scope: the single-term (linear Gaussian or Chebyshev
# pair-cluster, exponentiated and nested-exponentiated) and dual-term
# (product and sum) cluster-basis models fitted to the GEAM niobium
# dataset; training energy and force RMSEs of Tables V and VI. Force
# amplitude and angle RMSEs and Fisher-information condition numbers are
# not schema metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wang2025composable a mlips:BenchmarkStudy ;
    rdfs:label "Wang et al. (2025): composable and adaptive design of MLIPs guided by Fisher-information analysis, demonstrated on niobium" ;
    mlips:reportedIn entity:article-wang2025composable .

entity:article-wang2025composable a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2504.19372> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Composable and adaptive design of machine learning interatomic potentials guided by Fisher-information analysis" ;
    schema:author entity:person-Wang-wang2025composable ,
        entity:person-Transtrum-wang2025composable ,
        entity:person-Lordi-wang2025composable ,
        entity:person-Bulatov-wang2025composable ,
        entity:person-Samanta-wang2025composable .

entity:person-Wang-wang2025composable a schema:Person ;
