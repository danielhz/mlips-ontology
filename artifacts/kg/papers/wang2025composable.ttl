entity:person-Bulatov-wang2025composable a schema:Person ;
    schema:name "Vasily V. Bulatov" ;
    schema:givenName "Vasily V." ;
    schema:familyName "Bulatov" .

entity:person-Samanta-wang2025composable a schema:Person ;
