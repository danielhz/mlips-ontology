    schema:name "Mark K. Transtrum" ;
    schema:givenName "Mark K." ;
    schema:familyName "Transtrum" .

entity:person-Lordi-wang2025composable a schema:Person ;
    schema:name "Vincenzo Lordi" ;
    schema:givenName "Vincenzo" ;
