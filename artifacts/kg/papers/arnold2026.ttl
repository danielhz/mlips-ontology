###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-hea-arnold2026 a mlips:MaterialSystem ;
    rdfs:label "Equiatomic AlTiCrMoW bcc high-entropy alloy supercells (2x2x2 to 6x6x6), plus fcc Al, Ti and AlTi alpha/gamma intermetallics" ;
    mlips:materialClass "High-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-arnold2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-arnold2026 mlips:hasDFTSettings entity:calc-settings-pbe-arnold2026 .

entity:calc-settings-pbe-arnold2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack, maximum spacing 0.10 1/A" ;
    rdfs:comment "500 eV for cells of up to 128 atoms and 400 eV above; EDIFF 5e-6 (1e-7 for single points); relaxation then single point (Sec. II C)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ft-arnold2026 a mlips:TrainingDataset ;
    rdfs:label "AlTiCrMoW fine-tuning data: relaxed, sheared (0.5 % and 2 %), rattled (0.1 A) and species-shuffled supercells (Table I) plus Al, Ti and AlTi structures (Table III); 10 % held out for validation" ;
    mlips:coversMaterial entity:mat-hea-arnold2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-arnold2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-arnold2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-arnold2026 ;
    mlips:supportsSimulation mlips:MonteCarlo ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-MACE-arnold2026 a mlips:LossFunction ;
    rdfs:label "Two stages: energy weight 1 and force weight 100 for 75 % of the epochs, then energy weight 1000 and force weight 100" .

entity:impl-MACE-arnold2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-omat-ft-cutoffRadius-arnold2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-omat-ft-numLayers-arnold2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-omat-ft-numFeatures-arnold2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-omat-ft-numRadialBasis-arnold2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-omat-ft-numEpochs-arnold2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "75"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-omat-base-arnold2026 a mlips:MLIPRun ;
    rdfs:label "MACE-OMAT small (small-omat-0) as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-omat-base-arnold2026 .

entity:model-omat-base-arnold2026 a mlips:TrainedModel ;
    rdfs:label "mace-omat-0-small" .

entity:run-omat-ft-arnold2026 a mlips:MLIPRun ;
    rdfs:label "MACE small-omat-0 fine-tuned on AlTiCrMoW (max_L = 0, l up to 3, correlation order 3; 8,222,254 parameters)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-ft-arnold2026 ;
    mlips:hasHyperparameterSetting entity:setting-omat-ft-cutoffRadius-arnold2026 ,
        entity:setting-omat-ft-numLayers-arnold2026 ,
        entity:setting-omat-ft-numFeatures-arnold2026 ,
        entity:setting-omat-ft-numRadialBasis-arnold2026 ,
        entity:setting-omat-ft-numEpochs-arnold2026 ;
    mlips:produces entity:model-omat-ft-arnold2026 .

entity:model-omat-ft-arnold2026 a mlips:TrainedModel ;
    rdfs:label "AlTiCrMoW-MACE-OMAT fine-tuned" .

