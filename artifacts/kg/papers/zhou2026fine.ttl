    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-small-zhou2026fine .

entity:model-mace-small-zhou2026fine a mlips:TrainedModel ;
    rdfs:label "MACE-MP small" .

entity:run-mace-small-0b2-zhou2026fine a mlips:MLIPRun ;
    rdfs:label "MACE-small-0b2 foundation model as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-small-0b2-zhou2026fine .

entity:model-mace-small-0b2-zhou2026fine a mlips:TrainedModel ;
    rdfs:label "MACE-MP small 0b2" .

entity:run-mattersim-1m-zhou2026fine a mlips:MLIPRun ;
    rdfs:label "MatterSim-1M as distributed" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-mattersim-1m-zhou2026fine .

entity:model-mattersim-1m-zhou2026fine a mlips:TrainedModel ;
    rdfs:label "MatterSim-v1.0.0-1M" .

entity:run-chgnet-zhou2026fine a mlips:MLIPRun ;
    rdfs:label "CHGNet as distributed (version not stated)" ;
    mlips:appliesMethod entity:CHGNet ;
    mlips:produces entity:model-chgnet-zhou2026fine .

entity:model-chgnet-zhou2026fine a mlips:TrainedModel ;
    rdfs:label "CHGNet pretrained" .

entity:run-ft-model16-zhou2026fine a mlips:MLIPRun ;
    rdfs:label "MACE-small-0b2 fine-tuned on enumerated (Mo,Ta,Nb,W,V)S2 structures (Model 16, the largest training set)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-enum-zhou2026fine ;
    mlips:produces entity:model-ft-model16-zhou2026fine .

entity:model-ft-model16-zhou2026fine a mlips:TrainedModel ;
    rdfs:label "Fine-tuned MACE (Mo,Ta,Nb,W,V)S2 Model 16" .

# Registry stub for the externally trained model MatterSim-v1 (not trained in this paper).
entity:run-MatterSim-v1 a mlips:MLIPRun ;
    rdfs:label "Training run of MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-MatterSim-v1 .

entity:model-MatterSim-v1 a mlips:TrainedModel ;
    rdfs:label "MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" .

