# Canonical Turtle for the protocol-derived encoding of:
#   Chun Zhou et al. (2026). Fine-tuning of universal machine-learning interatomic potentials for high-entropy alloys with application to 2D (Mo,Ta,Nb,W,V)S2.
#   Computational Materials Today. doi:10.1016/j.commt.2026.100062  arXiv:2603.23029v2
#
# Version read: arxiv-preprint arXiv:2603.23029v2 (sha256 b91eaa3e2fcfd5ba...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 245 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/zhou2026fine.yaml.
#
# Encoding scope: the pretrained universal models benchmarked on mixing
# energies of 2D (Mo,Ta,Nb,W,V)S2 alloys (MACE-small, MACE-small-0b2,
# MatterSim 1M and 5M, CHGNet) and the MACE-small-0b2 models fine-tuned on
# enumerated or random alloy structures. Only the mixing-energy MAEs of the
# two MACE foundation models on Database 2 are stated as numbers in the
# text; the fine-tuned models' errors are in figures or given only
# approximately, so they have no result.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhou2026fine a mlips:BenchmarkStudy ;
    rdfs:label "Zhou and Komsa (2026): fine-tuning universal MLIPs for 2D high-entropy (Mo,Ta,Nb,W,V)S2 alloys" ;
    mlips:reportedIn entity:article-zhou2026fine .

entity:article-zhou2026fine a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.commt.2026.100062> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Fine-tuning of universal machine-learning interatomic potentials for high-entropy alloys with application to 2D (Mo,Ta,Nb,W,V)S2" ;
    schema:author entity:person-Zhou-zhou2026fine ,
        <https://orcid.org/0000-0002-0970-0957> .

entity:person-Zhou-zhou2026fine a schema:Person ;
    schema:name "Chun Zhou" ;
    schema:givenName "Chun" ;
    schema:familyName "Zhou" .

<https://orcid.org/0000-0002-0970-0957> a schema:Person ;
    schema:name "Hannu-Pekka Komsa" ;
    schema:givenName "Hannu-Pekka" ;
    schema:familyName "Komsa" ;
    schema:identifier <https://orcid.org/0000-0002-0970-0957> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tmdc-hea-zhou2026fine a mlips:MaterialSystem ;
    rdfs:label "2H-phase (Mo,Ta,Nb,W,V)S2 alloys with 2 to 5 metal components (Database 2: random compositions and configurations)" ;
    mlips:materialClass "2D transition-metal dichalcogenide high-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-zhou2026fine a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-zhou2026fine mlips:hasDFTSettings entity:calc-settings-pbe-zhou2026fine .

entity:calc-settings-pbe-zhou2026fine a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Gamma-centred 12x12x1 for primitive cells" ;
    rdfs:comment "Materials Project compatible parameters; pv pseudopotentials for metals." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-enum-zhou2026fine a mlips:TrainingDataset ;
    rdfs:label "Relaxation trajectories of enumerated (Mo,Ta,Nb,W,V)S2 structures (training sets of 16 fine-tuned models; 80/15/5 split)" ;
    mlips:coversMaterial entity:mat-tmdc-hea-zhou2026fine ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-zhou2026fine .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-enum-zhou2026fine mlips:samplingStrategy
    entity:sampling-enum-zhou2026fine .

entity:sampling-enum-zhou2026fine a mlips:SamplingStrategy ;
    rdfs:label "Enumerated (ICET, Hart-Forcade) and Monte Carlo annealed alloy supercells with their relaxation trajectories" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-zhou2026fine ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-zhou2026fine ;
    mlips:hasImplementation entity:impl-MACE-zhou2026fine ;
    mlips:supportsSimulation mlips:MonteCarlo ,
        mlips:GeometryOptimization .

entity:loss-MACE-zhou2026fine a mlips:LossFunction ;
    rdfs:label "Energy, force and stress weighted 100:10:1" .

entity:alg-MACE-zhou2026fine a mls:Algorithm ;
    rdfs:label "AMSGrad variant of Adam" .

entity:impl-MACE-zhou2026fine a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" .

entity:CHGNet a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

