# Canonical Turtle for the protocol-derived encoding of:
#   Yifan Li et al. (2025). Training Dataset Matters for Machine Learning Interatomic Potentials: Water Simulation as an Example.
#   arXiv (Cornell University). doi:10.48550/arxiv.2512.23939  arXiv:2512.23939v2
#
# Version read: arxiv-preprint arXiv:2512.23939v2 (sha256 ae52e8b48defa090...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 538 (Dataset/benchmark). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/li2025training.yaml.
#
# Encoding scope: revPBE0-D3 water/ice models trained on three
# datasets (SET1 of the original BPNN, SET2 from DP-GEN, SET3 from
# further BPNN active learning): the published BPNN1 and NEP of Ref. 4
# (as distributed), DP, BPNN2, BPNN3 and a NEP trained on SET3; their
# liquid and ice test RMSEs on independent AIMD sets (Figs. S6-S8, SI
# S4, S6). Melting temperatures, densities and Tdm are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-li2025training a mlips:BenchmarkStudy ;
    rdfs:label "Li et al. (2025): training-set convergence for revPBE0-D3 water and ice MLIPs (DP, BPNN, NEP) and its effect on melting, density maximum and nuclear quantum effects" ;
    mlips:reportedIn entity:article-li2025training .

entity:article-li2025training a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2512.23939> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Training Dataset Matters for Machine Learning Interatomic Potentials: Water Simulation as an Example" ;
    schema:author entity:person-Li-li2025training ,
        entity:person-Yang-li2025training ,
        entity:person-Zhang-li2025training ,
        entity:person-Gomez-li2025training ,
        entity:person-Xie-li2025training ,
        entity:person-Chen-li2025training ,
        entity:person-Piaggi-li2025training ,
        entity:person-Car-li2025training .

entity:person-Li-li2025training a schema:Person ;
    schema:name "Yifan Li" ;
    schema:givenName "Yifan" ;
    schema:familyName "Li" .

entity:person-Yang-li2025training a schema:Person ;
    schema:name "Bingjia Yang" ;
    schema:givenName "Bingjia" ;
    schema:familyName "Yang" .

entity:person-Zhang-li2025training a schema:Person ;
    schema:name "Chunyi Zhang" ;
    schema:givenName "Chunyi" ;
    schema:familyName "Zhang" .

entity:person-Gomez-li2025training a schema:Person ;
    schema:name "Axel Gomez" ;
    schema:givenName "Axel" ;
    schema:familyName "Gomez" .

