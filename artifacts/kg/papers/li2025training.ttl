    schema:name "Pinchen Xie" ;
    schema:givenName "Pinchen" ;
    schema:familyName "Xie" .

entity:person-Chen-li2025training a schema:Person ;
    schema:name "Yixiao Chen" ;
    schema:givenName "Yixiao" ;
    schema:familyName "Chen" .

entity:person-Piaggi-li2025training a schema:Person ;
    schema:name "Pablo M. Piaggi" ;
    schema:givenName "Pablo M." ;
    schema:familyName "Piaggi" .

entity:person-Car-li2025training a schema:Person ;
    schema:name "Roberto Car" ;
    schema:givenName "Roberto" ;
    schema:familyName "Car" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-liq-li2025training a mlips:MaterialSystem ;
    rdfs:label "Liquid water (classical and quantum nuclei)" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" .

entity:mat-ice-li2025training a mlips:MaterialSystem ;
    rdfs:label "Ice Ih" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular crystal" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-rpbe0-li2025training a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-rpbe0-li2025training mlips:hasDFTSettings entity:calc-settings-rpbe0-li2025training .

entity:calc-settings-rpbe0-li2025training a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-CP2K-li2025training ;
    mlips:xcFunctional entity:xc-revPBE0-D3-li2025training ;
    rdfs:comment "Settings of Cheng et al. (Ref. 1) with 800 Ry plane-wave cutoff (400 Ry for SET1 and the Ref. 4 data)" .

entity:lib-CP2K-li2025training a mlips:Library ;
    rdfs:label "CP2K" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-revPBE0-D3-li2025training a mlips:XCFunctional ;
    rdfs:label "revPBE0-D3" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-set1-li2025training a mlips:TrainingDataset ;
    rdfs:label "SET1 (1,593 configurations)" ;
    mlips:coversMaterial entity:mat-liq-li2025training ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1593 ;
    mlips:hasDFTCalculation entity:calc-rpbe0-li2025training .

entity:ds-set2-li2025training a mlips:TrainingDataset ;
    rdfs:label "SET2 (1,778 configurations)" ;
    mlips:coversMaterial entity:mat-liq-li2025training ,
        entity:mat-ice-li2025training ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 1778 ;
    mlips:hasDFTCalculation entity:calc-rpbe0-li2025training .

entity:ds-set3-li2025training a mlips:TrainingDataset ;
    rdfs:label "SET3 (2,556 configurations)" ;
    mlips:coversMaterial entity:mat-liq-li2025training ,
        entity:mat-ice-li2025training ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2556 ;
    mlips:hasDFTCalculation entity:calc-rpbe0-li2025training .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-set1-li2025training mlips:samplingStrategy
    entity:sampling-set1-li2025training .

entity:ds-set2-li2025training mlips:samplingStrategy
    entity:sampling-dpgen-li2025training .

entity:ds-set3-li2025training mlips:samplingStrategy
    entity:sampling-dpgen-li2025training ,
    entity:sampling-bpal-li2025training .

entity:sampling-set1-li2025training a mlips:SamplingStrategy ;
    rdfs:label "SET1: training configurations of the original BPNN (Ref. 1)" .

entity:sampling-dpgen-li2025training a mlips:SamplingStrategy ;
    rdfs:label "DP-GEN active learning from 100 liquid configurations: classical MD and 32-bead PIMD of liquid (270-350 K) and ice Ih (150-300 K) in 64-molecule cells, candidates with force deviation 0.2-0.35 eV/A" .

entity:sampling-bpal-li2025training a mlips:SamplingStrategy ;
    rdfs:label "Further BPNN committee active learning from SET2 with the same criteria" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasLossFunction entity:loss-DeePMD-li2025training ;
    mlips:hasTrainingAlgorithm entity:alg-DeePMD-li2025training ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-DeePMD-li2025training ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:ThermodynamicIntegration .

entity:loss-DeePMD-li2025training a mlips:LossFunction ;
    rdfs:label "Energy and force prefactors 0.02 to 2 and 1000 to 1; no virials" .

entity:alg-DeePMD-li2025training a mls:Algorithm ;
    rdfs:label "400,000 steps, learning rate 1e-3 to 1e-8" .

entity:impl-DeePMD-li2025training a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-li2025training ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-li2025training ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-HDNNP-li2025training ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-HDNNP-li2025training a mlips:LossFunction ;
    rdfs:label "Energies and forces (force weight 1)" .

entity:alg-HDNNP-li2025training a mls:Algorithm ;
    rdfs:label "Kalman filter; 20% internal test" .

entity:impl-HDNNP-li2025training a mlips:Implementation ;
    mlips:implementedIn entity:lib-n2p2-li2025training .

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-li2025training ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-li2025training ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:batchSize ;
    mlips:hasImplementation entity:impl-NEP-li2025training ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NEP-li2025training a mlips:LossFunction ;
    rdfs:label "Energy and force weights 1, no virials, L1 and L2 0.05" .

entity:alg-NEP-li2025training a mls:Algorithm ;
    rdfs:label "Separable natural evolution strategy, 400,000 generations, population 52" .

entity:impl-NEP-li2025training a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-li2025training .

entity:lib-n2p2-li2025training a mlips:Library ;
    rdfs:label "n2p2" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-GPUMD-li2025training a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-dp-cutoffRadius-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-dp-learningRate-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

entity:setting-bpnn2-numLayers-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-bpnn2-numEpochs-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

entity:setting-bpnn3-numLayers-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-bpnn3-numEpochs-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "200"^^xsd:integer .

entity:setting-nep3-cutoffRadius-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-nep3-angularCutoff-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-nep3-batchSize-li2025training a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "25"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-bpnn1-li2025training a mlips:MLIPRun ;
    rdfs:label "BPNN1: revPBE0-D3 water BPNN of Ref. 1 (as distributed)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-set1-li2025training ;
    mlips:produces entity:model-bpnn1-li2025training .

entity:model-bpnn1-li2025training a mlips:TrainedModel ;
    rdfs:label "BPNN1 revPBE0-D3 water (Ref. 1)" .

entity:run-nep4-li2025training a mlips:MLIPRun ;
    rdfs:label "NEP of Ref. 4 (as distributed)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:produces entity:model-nep4-li2025training .

entity:model-nep4-li2025training a mlips:TrainedModel ;
    rdfs:label "NEP revPBE0-D3 water (Ref. 4)" .

entity:run-dp-li2025training a mlips:MLIPRun ;
    rdfs:label "DP model trained on SET2" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-set2-li2025training ;
    mlips:hasHyperparameterSetting entity:setting-dp-cutoffRadius-li2025training ,
        entity:setting-dp-learningRate-li2025training ;
    mlips:produces entity:model-dp-li2025training .

entity:model-dp-li2025training a mlips:TrainedModel ;
    rdfs:label "DP revPBE0-D3 water/ice (SET2)" .

entity:run-bpnn2-li2025training a mlips:MLIPRun ;
    rdfs:label "BPNN2 trained on SET2" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-set2-li2025training ;
    mlips:hasHyperparameterSetting entity:setting-bpnn2-numLayers-li2025training ,
        entity:setting-bpnn2-numEpochs-li2025training ;
    mlips:produces entity:model-bpnn2-li2025training .

entity:model-bpnn2-li2025training a mlips:TrainedModel ;
    rdfs:label "BPNN2 revPBE0-D3 water (SET2)" .

entity:run-bpnn3-li2025training a mlips:MLIPRun ;
    rdfs:label "BPNN3 trained on SET3" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-set3-li2025training ;
    mlips:hasHyperparameterSetting entity:setting-bpnn3-numLayers-li2025training ,
        entity:setting-bpnn3-numEpochs-li2025training ;
    mlips:produces entity:model-bpnn3-li2025training .

entity:model-bpnn3-li2025training a mlips:TrainedModel ;
    rdfs:label "BPNN3 revPBE0-D3 water (SET3)" .

entity:run-nep3-li2025training a mlips:MLIPRun ;
    rdfs:label "NEP trained on SET3" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-set3-li2025training ;
    mlips:hasHyperparameterSetting entity:setting-nep3-cutoffRadius-li2025training ,
        entity:setting-nep3-angularCutoff-li2025training ,
        entity:setting-nep3-batchSize-li2025training ;
    mlips:produces entity:model-nep3-li2025training .

entity:model-nep3-li2025training a mlips:TrainedModel ;
    rdfs:label "NEP revPBE0-D3 water/ice (SET3)" .

