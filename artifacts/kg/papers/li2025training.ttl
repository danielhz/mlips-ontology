    entity:result-nep3-ice-li2025training ,
    entity:result-nep3-train-li2025training .

entity:result-bpnn1-liq-li2025training a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-bpnn1-li2025training ;
    mlips:targetMaterial entity:mat-liq-li2025training ;
    mlips:hasAccuracyMetric entity:metric-bpnn1-liq-1-li2025training ,
        entity:metric-bpnn1-liq-2-li2025training .

entity:metric-bpnn1-liq-1-li2025training a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on liquid water: BPNN1 (Ref. 1, trained on SET1)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.41"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-bpnn1-liq-2-li2025training a mlips:AccuracyMetric ;
    rdfs:label "test force-component RMSE on liquid water: BPNN1 (Ref. 1, trained on SET1)" ;
