entity:study-li2025training mlips:hasResult
    entity:result-bpnn1-liq-li2025training ,
    entity:result-bpnn1-ice-li2025training ,
    entity:result-bpnn3-liq-li2025training ,
    entity:result-bpnn3-ice-li2025training ,
