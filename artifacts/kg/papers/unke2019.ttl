entity:study-unke2019 mlips:hasResult
    entity:result-QM9-unke2019 ,
    entity:result-aspirin-unke2019 ,
    entity:result-benzene-unke2019 ,
    entity:result-ethanol-unke2019 ,
    entity:result-malonaldehyde-unke2019 ,
    entity:result-naphthalene-unke2019 ,
    entity:result-salicylic-acid-unke2019 ,
    entity:result-toluene-unke2019 ,
    entity:result-uracil-unke2019 ,
    entity:result-ISO17-known-unke2019 ,
    entity:result-ISO17-unknown-unke2019 ,
    entity:result-SN2-noLR-unke2019 ,
    entity:result-SN2-LR-unke2019 ,
    entity:result-SPF-unke2019 .

entity:result-QM9-unke2019 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-QM9-unke2019 ;
    mlips:targetMaterial entity:mat-QM9-unke2019 ;
    mlips:hasAccuracyMetric entity:metric-QM9-1-unke2019 .

entity:metric-QM9-1-unke2019 a mlips:AccuracyMetric ;
    rdfs:label "MAE on energy: PhysNet, QM9, 110,426 training and validation structures" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.19"^^xsd:double ;
    mlips:hasUnit unit:KiloCAL-PER-MOL .

