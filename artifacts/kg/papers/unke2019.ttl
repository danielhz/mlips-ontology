entity:run-QM9-unke2019 a mlips:MLIPRun ;
    rdfs:label "PhysNet training on QM9 (energies)" ;
    mlips:appliesMethod entity:PhysNet ;
    mlips:runsOn entity:ds-QM9-unke2019 ;
    mlips:hasHyperparameterSetting entity:setting-QM9-cutoffRadius-unke2019 ,
        entity:setting-QM9-numFeatures-unke2019 ,
        entity:setting-QM9-numRadialBasis-unke2019 ,
        entity:setting-QM9-numLayers-unke2019 ,
        entity:setting-QM9-learningRate-unke2019 ,
        entity:setting-QM9-batchSize-unke2019 ;
