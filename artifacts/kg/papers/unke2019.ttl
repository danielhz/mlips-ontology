# Canonical Turtle for the protocol-derived encoding of:
#   Oliver T. Unke et al. (2019). PhysNet: A Neural Network for Predicting Energies, Forces, Dipole Moments, and Partial Charges.
#   Journal of Chemical Theory and Computation. doi:10.1021/acs.jctc.9b00181  arXiv:1902.08408v2
#
# Version read: arxiv-preprint arXiv:1902.08408v2 (sha256 6f2450dc4c264a4b...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 42 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the PhysNet architecture and its benchmark fits: QM9
# (energies), the eight MD17 molecules, ISO17, and the two data sets
# introduced by the paper (SN2 reactions, solvated protein fragments).
# Errors are those of single PhysNet models averaged over five
# independent runs (Tables 3-7).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-unke2019 a mlips:BenchmarkStudy ;
    rdfs:label "Unke and Meuwly (2019): PhysNet" ;
    mlips:reportedIn entity:article-unke2019 .

entity:article-unke2019 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jctc.9b00181> ;
    schema:datePublished "2019"^^xsd:gYear ;
    schema:name "PhysNet: A Neural Network for Predicting Energies, Forces, Dipole Moments, and Partial Charges" ;
    schema:author <https://orcid.org/0000-0001-7503-406X> ,
        <https://orcid.org/0000-0001-7930-8806> .

<https://orcid.org/0000-0001-7503-406X> a schema:Person ;
    schema:name "Oliver T. Unke" ;
    schema:givenName "Oliver T." ;
    schema:familyName "Unke" ;
    schema:identifier <https://orcid.org/0000-0001-7503-406X> .

<https://orcid.org/0000-0001-7930-8806> a schema:Person ;
    schema:name "Markus Meuwly" ;
    schema:givenName "Markus" ;
    schema:familyName "Meuwly" ;
    schema:identifier <https://orcid.org/0000-0001-7930-8806> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-QM9-unke2019 a mlips:MaterialSystem ;
    rdfs:label "QM9 small organic molecules (equilibrium geometries)" ;
    mlips:materialClass "Small organic molecules (gas phase)" .

entity:mat-ISO17-unke2019 a mlips:MaterialSystem ;
    rdfs:label "ISO17: 127 isomers of C7O2H10" ;
    mlips:chemicalFormula "C7O2H10" ;
    mlips:materialClass "Small organic molecules (gas phase), MD conformations" .

entity:mat-SN2-unke2019 a mlips:MaterialSystem ;
    rdfs:label "SN2 reaction systems X- + H3C-Y with X, Y in {F, Cl, Br, I} and their fragments" ;
    mlips:materialClass "Gas-phase reactive ion-molecule systems" .

entity:mat-SPF-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Solvated protein fragments (amons up to eight heavy atoms, dimers, water clusters)" ;
    mlips:materialClass "Organic molecules and molecular clusters in gas phase and with explicit water; elements H, C, N, O, S" .

entity:mat-aspirin-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-benzene-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-ethanol-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-malonaldehyde-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-naphthalene-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Naphthalene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-salicylic-acid-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Salicylic acid molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-toluene-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-uracil-unke2019 a mlips:MaterialSystem ;
    rdfs:label "Uracil molecule (MD17)" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qm9-dft-unke2019 a mlips:DFTCalculation .

entity:calc-md17-dft-unke2019 a mlips:DFTCalculation .

entity:calc-sn2-dft-unke2019 a mlips:DFTCalculation .

entity:calc-spf-dft-unke2019 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qm9-dft-unke2019 mlips:hasDFTSettings entity:calc-settings-qm9-dft-unke2019 .

entity:calc-settings-qm9-dft-unke2019 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-B3LYP-unke2019 ;
    mlips:dftBasisSet entity:basis-6-31G-2df-p-unke2019 ;
    rdfs:comment "B3LYP/6-31G(2df,p), the QM9 level of theory." .

entity:calc-md17-dft-unke2019 mlips:hasDFTSettings entity:calc-settings-md17-dft-unke2019 .

entity:calc-settings-md17-dft-unke2019 a mlips:DFTSettings ;
    mlips:xcFunctional entity:xc-PBE-vdW-TS-unke2019 ;
    rdfs:comment "Level of theory of the MD17 and ISO17 trajectories; code and basis are not restated in this paper." .

entity:calc-sn2-dft-unke2019 mlips:hasDFTSettings entity:calc-settings-sn2-dft-unke2019 .

entity:calc-settings-sn2-dft-unke2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-DSD-BLYP-D3-BJ-unke2019 ;
    mlips:dftBasisSet entity:basis-def2-TZVP-unke2019 ;
    rdfs:comment "ORCA 4.0.1." .

entity:calc-spf-dft-unke2019 mlips:hasDFTSettings entity:calc-settings-spf-dft-unke2019 .

entity:calc-settings-spf-dft-unke2019 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:ORCA ;
    mlips:xcFunctional entity:xc-revPBE-D3-BJ-unke2019 ;
    mlips:dftBasisSet entity:basis-def2-TZVP-unke2019 ;
    rdfs:comment "ORCA 4.0.1." .

entity:xc-B3LYP-unke2019 a mlips:XCFunctional ;
    rdfs:label "B3LYP" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-6-31G-2df-p-unke2019 a mlips:DftBasisSet ;
    rdfs:label "6-31G(2df,p)" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

entity:xc-PBE-vdW-TS-unke2019 a mlips:XCFunctional ;
    rdfs:label "PBE+vdW-TS" ;
    rdfs:comment "PBE with Tkatchenko-Scheffler van der Waals correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:xc-DSD-BLYP-D3-BJ-unke2019 a mlips:XCFunctional ;
    rdfs:label "DSD-BLYP-D3(BJ)" ;
    rdfs:comment "Double-hybrid functional with D3(BJ) dispersion correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-def2-TZVP-unke2019 a mlips:DftBasisSet ;
    rdfs:label "def2-TZVP" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

entity:xc-revPBE-D3-BJ-unke2019 a mlips:XCFunctional ;
    rdfs:label "revPBE-D3(BJ)" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

entity:basis-def2-TZVP-unke2019 a mlips:DftBasisSet ;
    rdfs:label "def2-TZVP" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-QM9-unke2019 a mlips:TrainingDataset ;
    rdfs:label "QM9 training and validation split (110,426 structures)" ;
    mlips:coversMaterial entity:mat-QM9-unke2019 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 110426 ;
    mlips:hasDFTCalculation entity:calc-qm9-dft-unke2019 .

entity:ds-ISO17-unke2019 a mlips:TrainingDataset ;
    rdfs:label "ISO17 training and validation split (400k + 4k structures)" ;
    mlips:coversMaterial entity:mat-ISO17-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 404000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 ;
    rdfs:comment "The full data set has 635k structures." .

entity:ds-SN2-unke2019 a mlips:TrainingDataset ;
    rdfs:label "SN2 reactions data set: training and validation split (400k + 5k structures)" ;
    mlips:coversMaterial entity:mat-SN2-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 405000 ;
    mlips:hasDFTCalculation entity:calc-sn2-dft-unke2019 ;
    rdfs:comment "Introduced by this paper; 452,709 structures in total with energies, forces and dipole moments." .

entity:ds-SPF-unke2019 a mlips:TrainingDataset ;
    rdfs:label "Solvated protein fragments data set: training and validation split (2560k + 100k structures)" ;
    mlips:coversMaterial entity:mat-SPF-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2660000 ;
    mlips:hasDFTCalculation entity:calc-spf-dft-unke2019 ;
    rdfs:comment "Introduced by this paper; 2,731,180 structures in total with energies, forces and dipole moments; on average 21 atoms, at most 120." .

entity:ds-aspirin-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 aspirin: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-aspirin-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

entity:ds-benzene-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 benzene: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-benzene-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

entity:ds-ethanol-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 ethanol: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-ethanol-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

entity:ds-malonaldehyde-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 malonaldehyde: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-malonaldehyde-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

entity:ds-naphthalene-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 naphthalene: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-naphthalene-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

entity:ds-salicylic-acid-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 salicylic acid: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-salicylic-acid-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

entity:ds-toluene-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 toluene: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-toluene-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

entity:ds-uracil-unke2019 a mlips:TrainingDataset ;
    rdfs:label "MD17 uracil: 50k structures for training and validation" ;
    mlips:coversMaterial entity:mat-uracil-unke2019 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 50000 ;
    mlips:hasDFTCalculation entity:calc-md17-dft-unke2019 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-QM9-unke2019 mlips:samplingStrategy
    entity:sampling-qm9-equilibrium-unke2019 .

entity:ds-ISO17-unke2019 mlips:samplingStrategy
    entity:sampling-iso17-aimd-unke2019 .

entity:ds-SN2-unke2019 mlips:samplingStrategy
    entity:sampling-pm7-md-5000K-unke2019 ,
    entity:sampling-ion-placement-unke2019 .

entity:ds-SPF-unke2019 mlips:samplingStrategy
    entity:sampling-pm7-md-1000K-unke2019 ,
    entity:sampling-adaptive-unke2019 .

entity:ds-aspirin-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:ds-benzene-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:ds-ethanol-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:ds-malonaldehyde-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:ds-naphthalene-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:ds-salicylic-acid-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:ds-toluene-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:ds-uracil-unke2019 mlips:samplingStrategy
    entity:sampling-md17-aimd-unke2019 .

entity:sampling-qm9-equilibrium-unke2019 a mlips:SamplingStrategy ;
    rdfs:label "Equilibrium geometries (QM9)" ;
    rdfs:comment "Pruned QM9 (about 131k structures after removing about 3k molecules that fail a consistency check or are hard to converge)." .

entity:sampling-md17-aimd-unke2019 a mlips:SamplingStrategy ;
    rdfs:label "Ab initio MD at 500 K (MD17)" ;
    rdfs:comment "Trajectories at 500 K with 0.5 fs resolution; 50k structures per molecule for training and validation." .

entity:sampling-iso17-aimd-unke2019 a mlips:SamplingStrategy ;
    rdfs:label "Short MD trajectories of isomers (ISO17)" ;
    rdfs:comment "5k conformations per molecule at 1 fs resolution; about 80% of molecules and conformations used for training." .

entity:sampling-pm7-md-5000K-unke2019 a mlips:SamplingStrategy ;
    rdfs:label "Semi-empirical PM7 MD at 5000 K" ;
    rdfs:comment "MD with PM7 (MOPAC2016) through ASE, time step 0.1 fs, structures saved every 10 steps, started from PM7-optimised geometries, van der Waals complexes or transition states." .

entity:sampling-ion-placement-unke2019 a mlips:SamplingStrategy ;
    rdfs:label "Random placement of a halide ion near CH3X" ;
    rdfs:comment "Long-range interactions sampled by placing an ion Y- at most 16 A from a random CH3X conformation." .

entity:sampling-pm7-md-1000K-unke2019 a mlips:SamplingStrategy ;
    rdfs:label "Semi-empirical PM7 MD at 1000 K" ;
    rdfs:comment "100 conformations per structure from PM7 MD at 1000 K, time step 0.1 fs, saved every 10 steps." .

entity:sampling-adaptive-unke2019 a mlips:SamplingStrategy ;
    rdfs:label "Adaptive sampling with an ensemble of three PhysNet models" ;
    rdfs:comment "Structures from MD on which the ensemble predictions deviate by more than 1 kcal/mol are recomputed with the reference method and added; four rounds." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PhysNet a mlips:MLIPMethod ;
    rdfs:label "PhysNet (message-passing neural network for energies, forces, dipole moments and partial charges)" ;
    mlips:hasFunctionalForm entity:ff-PhysNet ;
    mlips:hasLossFunction entity:loss-PhysNet-unke2019 ;
    mlips:hasTrainingAlgorithm entity:alg-PhysNet-unke2019 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        mlips:numRadialBasis ,
        mlips:numLayers ,
        mlips:learningRate ,
        mlips:batchSize .

entity:ff-PhysNet a mlips:FunctionalForm ;
    rdfs:label "Message-passing neural network of stacked modular blocks with residual refinements over radial-basis-expanded interatomic distances; atomic energy and partial-charge outputs, optionally augmented with explicit long-range electrostatics and dispersion" .

entity:loss-PhysNet-unke2019 a mlips:LossFunction ;
    rdfs:label "Weighted sum of absolute errors in energy and forces (plus total charge and dipole moment when charges are predicted) and a non-hierarchicality penalty" .

entity:alg-PhysNet-unke2019 a mls:Algorithm ;
    rdfs:label "AMSGrad with learning rate 1e-3 and batches of 32 randomly chosen structures" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-QM9-cutoffRadius-unke2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-QM9-numFeatures-unke2019 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

