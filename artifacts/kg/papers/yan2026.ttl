# Canonical Turtle for the protocol-derived encoding of:
#   Zihan Yan et al. (2026). Improving Robustness and Training Efficiency of Machine-Learned Potentials by Incorporating Short-Range Empirical Potentials.
#   Journal of Chemical Information and Modeling. doi:10.1021/acs.jcim.5c02335  arXiv:2504.15925v1
#
# Version read: arxiv-preprint arXiv:2504.15925v1 (sha256 cb9b966c68ba5899...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 303 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/yan2026.yaml.
#
# Encoding scope: NEP4 models for Li7La3Zr2O12 (LLZO): the reference
# NEPstd trained on DFT data of earlier work, NEP802 trained by active
# learning on NEPstd-labelled structures, and the hybrid NEP-ZBL models
# NEP802-ZBL, NEP25-ZBL and NEP207-ZBL; the stated training RMSEs of
# NEPstd and NEP802. Phase-transition, RDF, MSD and dimer analyses are
# properties, not error metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-yan2026 a mlips:BenchmarkStudy ;
    rdfs:label "Yan, Fan and Zhu (2026): NEP with an empirical ZBL short-range repulsion for robust LLZO force fields" ;
    mlips:reportedIn entity:article-yan2026 .

entity:article-yan2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acs.jcim.5c02335> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Improving Robustness and Training Efficiency of Machine-Learned Potentials by Incorporating Short-Range Empirical Potentials" ;
    schema:author <https://orcid.org/0000-0002-8911-6549> ,
        <https://orcid.org/0000-0002-2253-8210> ,
        <https://orcid.org/0000-0002-5819-7657> .

<https://orcid.org/0000-0002-8911-6549> a schema:Person ;
    schema:name "Zihan Yan" ;
    schema:givenName "Zihan" ;
    schema:familyName "Yan" ;
    schema:identifier <https://orcid.org/0000-0002-8911-6549> .

<https://orcid.org/0000-0002-2253-8210> a schema:Person ;
    schema:name "Zheyong Fan" ;
    schema:givenName "Zheyong" ;
    schema:familyName "Fan" ;
    schema:identifier <https://orcid.org/0000-0002-2253-8210> .

<https://orcid.org/0000-0002-5819-7657> a schema:Person ;
    schema:name "Yizhou Zhu" ;
    schema:givenName "Yizhou" ;
    schema:familyName "Zhu" ;
    schema:identifier <https://orcid.org/0000-0002-5819-7657> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-llzo-yan2026 a mlips:MaterialSystem ;
    rdfs:label "Li7La3Zr2O12 (tetragonal and cubic, with Li-O Schottky defects in the reference set)" ;
    mlips:chemicalFormula "Li7La3Zr2O12" ;
    mlips:materialClass "Garnet Li solid electrolyte" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-prev-yan2026 a mlips:DFTCalculation .

entity:calc-nepstd-labels-yan2026 a mlips:ReferenceCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-prev-yan2026 mlips:hasDFTSettings entity:calc-settings-dft-prev-yan2026 .

entity:calc-settings-dft-prev-yan2026 a mlips:DFTSettings ;
    rdfs:comment "DFT training data of the earlier LLZO work (Ref. [22]); settings not restated." .

entity:calc-nepstd-labels-yan2026 mlips:hasReferenceSettings entity:calc-settings-nepstd-labels-yan2026 .

entity:calc-settings-nepstd-labels-yan2026 a mlips:ReferenceSettings ;
    rdfs:comment "Energies, forces and stresses predicted by the NEPstd model (calorine) instead of DFT." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-std-yan2026 a mlips:TrainingDataset ;
    rdfs:label "NEPstd training set of Ref. [22] (2,024 structures: 1,978 stoichiometric cubic and tetragonal, 46 with Li-O Schottky defects)" ;
    mlips:coversMaterial entity:mat-llzo-yan2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 2024 ;
    mlips:hasDFTCalculation entity:calc-dft-prev-yan2026 .

entity:ds-s802-yan2026 a mlips:TrainingDataset ;
    rdfs:label "802 actively learned LLZO structures labelled with NEPstd" ;
    mlips:coversMaterial entity:mat-llzo-yan2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 802 ;
    mlips:hasReferenceCalculation entity:calc-nepstd-labels-yan2026 .

entity:ds-s25-yan2026 a mlips:TrainingDataset ;
    rdfs:label "25-structure farthest-point subset of the 802-structure set" ;
    mlips:coversMaterial entity:mat-llzo-yan2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 25 ;
    mlips:hasReferenceCalculation entity:calc-nepstd-labels-yan2026 .

entity:ds-s207-yan2026 a mlips:TrainingDataset ;
    rdfs:label "207 structures from three aggressive active-learning iterations with NEP-ZBL" ;
    mlips:coversMaterial entity:mat-llzo-yan2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:Augmented ;
    mlips:numConfigurations 207 ;
    mlips:hasReferenceCalculation entity:calc-nepstd-labels-yan2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-s802-yan2026 mlips:samplingStrategy
    entity:sampling-al-yan2026 .

entity:ds-s25-yan2026 mlips:samplingStrategy
    entity:sampling-fps25-yan2026 .

entity:ds-s207-yan2026 mlips:samplingStrategy
    entity:sampling-al-yan2026 .

entity:sampling-al-yan2026 a mlips:SamplingStrategy ;
    rdfs:label "Active learning from 100 randomly perturbed tetragonal LLZO cells (dpdata): MD at 100-1200 K for 20-500 ps with descriptor-based farthest-point sampling (GPUMDkit)" .

entity:sampling-fps25-yan2026 a mlips:SamplingStrategy ;
    rdfs:label "Farthest-point sampling of 25 structures from the 802-structure set (PyNEP)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasTrainingAlgorithm entity:alg-NEP-yan2026 ;
    mlips:hasImplementation entity:impl-NEP-yan2026 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:alg-NEP-yan2026 a mls:Algorithm ;
    rdfs:label "NEP4 in GPUMD; NEP-ZBL hybrid with the universal ZBL screening potential inside 0.9 A, smoothly switched to NEP up to 1.8 A" .

entity:impl-NEP-yan2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-yan2026 .

entity:lib-GPUMD-yan2026 a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nepstd-yan2026 a mlips:MLIPRun ;
    rdfs:label "NEPstd (reference NEP for LLZO, retrained with adjusted hyperparameters)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-std-yan2026 ;
    mlips:produces entity:model-nepstd-yan2026 .

entity:model-nepstd-yan2026 a mlips:TrainedModel ;
    rdfs:label "NEPstd LLZO potential" .

entity:run-nep802-yan2026 a mlips:MLIPRun ;
    rdfs:label "NEP802 (purely data-driven NEP on 802 structures)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-s802-yan2026 ;
    mlips:produces entity:model-nep802-yan2026 .

entity:model-nep802-yan2026 a mlips:TrainedModel ;
    rdfs:label "NEP802 LLZO potential" .

entity:run-nep802-zbl-yan2026 a mlips:MLIPRun ;
    rdfs:label "NEP802-ZBL (NEP with ZBL repulsion on 802 structures)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-s802-yan2026 ;
    mlips:produces entity:model-nep802-zbl-yan2026 .

entity:model-nep802-zbl-yan2026 a mlips:TrainedModel ;
    rdfs:label "NEP802-ZBL LLZO potential" .

entity:run-nep25-zbl-yan2026 a mlips:MLIPRun ;
    rdfs:label "NEP25-ZBL (NEP with ZBL repulsion on 25 structures)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-s25-yan2026 ;
    mlips:produces entity:model-nep25-zbl-yan2026 .

entity:model-nep25-zbl-yan2026 a mlips:TrainedModel ;
    rdfs:label "NEP25-ZBL LLZO potential" .

entity:run-nep207-zbl-yan2026 a mlips:MLIPRun ;
    rdfs:label "NEP207-ZBL (NEP with ZBL repulsion from three aggressive active-learning iterations)" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-s207-yan2026 ;
    mlips:produces entity:model-nep207-zbl-yan2026 .

entity:model-nep207-zbl-yan2026 a mlips:TrainedModel ;
    rdfs:label "NEP207-ZBL LLZO potential" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-yan2026 mlips:hasResult
    entity:result-nepstd-yan2026 ,
    entity:result-nep802-yan2026 .

entity:result-nepstd-yan2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nepstd-yan2026 ;
    mlips:targetMaterial entity:mat-llzo-yan2026 ;
    mlips:hasAccuracyMetric entity:metric-nepstd-1-yan2026 ,
        entity:metric-nepstd-2-yan2026 ,
        entity:metric-nepstd-3-yan2026 .

entity:metric-nepstd-1-yan2026 a mlips:AccuracyMetric ;
    rdfs:label "Training energy RMSE: NEPstd" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.74"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nepstd-2-yan2026 a mlips:AccuracyMetric ;
    rdfs:label "Training force RMSE: NEPstd" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "80.31"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-nepstd-3-yan2026 a mlips:AccuracyMetric ;
    rdfs:label "Training stress RMSE: NEPstd" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.089"^^xsd:double ;
    mlips:hasUnit unit:GigaPA .

entity:result-nep802-yan2026 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nep802-yan2026 ;
    mlips:targetMaterial entity:mat-llzo-yan2026 ;
    mlips:hasAccuracyMetric entity:metric-nep802-1-yan2026 ,
        entity:metric-nep802-2-yan2026 ,
        entity:metric-nep802-3-yan2026 .

entity:metric-nep802-1-yan2026 a mlips:AccuracyMetric ;
    rdfs:label "Training energy RMSE vs NEPstd labels: NEP802" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.22"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nep802-2-yan2026 a mlips:AccuracyMetric ;
    rdfs:label "Training force RMSE vs NEPstd labels: NEP802" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "24.96"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:metric-nep802-3-yan2026 a mlips:AccuracyMetric ;
    rdfs:label "Training stress RMSE vs NEPstd labels: NEP802" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:StressProperty ;
    mlips:metricValue "0.037"^^xsd:double ;
    mlips:hasUnit unit:GigaPA .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# MD in GPUMD on 4x4x4 supercells of 12,288 atoms; no timings are given.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - The NEP802 errors are against NEPstd-predicted labels, not DFT. Training errors of the ZBL models are only in the SI (figures) and are not encoded.
# - Failure ratios of the active-learning iterations (Table I: up to 57.9% without ZBL) and Li-Li breakdown distances are robustness indicators, not error metrics. The NEP-ZBL hybrid is recorded as the registry method NEP.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
# - Evaluation roles and data, base models, inference timings with their system sizes, and the source location of each value are recorded in the encoding input (artifacts/kg/encoding/specs/yan2026.yaml) until the schema has terms for them.

