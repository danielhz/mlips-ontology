# Canonical Turtle for the protocol-derived encoding of:
#   Manuel González Lastre et al. (2026). MAD-SURF: a machine learning interatomic potential for molecular adsorption on coinage metal surfaces.
#   arXiv (Cornell University). doi:10.48550/arxiv.2601.18852  arXiv:2601.18852v2
#
# Version read: arxiv-preprint arXiv:2601.18852v2 (sha256 3494f75e901ef1b1...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 584 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/lastre2026.yaml.
#
# Encoding scope: the MAD-SURF dataset (38 molecules on Cu, Ag and Au
# from BOSS adsorption minima, AIMD, normal-mode sampling and AISS
# dimers; PBE+vdWsurf in FHI-aims) and MACE models trained from scratch
# (force/energy weight 1 or 10, full, subset or descriptor-filtered
# data), the MACE-MPA-0 foundation model as distributed, and MACE-MPA-0
# fine-tuned (multi-head replay) or few-shot adapted. Relaxation-based
# energy/force MAEs and RMSDs are figure-only (Fig. 2); adsorption-height
# R2 values are property metrics.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-lastre2026 a mlips:BenchmarkStudy ;
    rdfs:label "Gonzalez Lastre et al. (2026): MAD-SURF, a MACE potential and dataset for molecular adsorption on coinage-metal surfaces" ;
    mlips:reportedIn entity:article-lastre2026 .

entity:article-lastre2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2601.18852> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "MAD-SURF: a machine learning interatomic potential for molecular adsorption on coinage metal surfaces" ;
    schema:author entity:person-Lastre-lastre2026 ,
        entity:person-Jestila-lastre2026 ,
        entity:person-Perez-lastre2026 ,
        entity:person-Foster-lastre2026 .

entity:person-Lastre-lastre2026 a schema:Person ;
    schema:name "Manuel González Lastre" ;
    schema:givenName "Manuel González" ;
    schema:familyName "Lastre" .

entity:person-Jestila-lastre2026 a schema:Person ;
    schema:name "Joakim S. Jestilä" ;
    schema:givenName "Joakim S." ;
    schema:familyName "Jestilä" .

entity:person-Perez-lastre2026 a schema:Person ;
    schema:name "Rubén Pérez" ;
    schema:givenName "Rubén" ;
    schema:familyName "Pérez" .

entity:person-Foster-lastre2026 a schema:Person ;
    schema:name "Adam S. Foster" ;
    schema:givenName "Adam S." ;
    schema:familyName "Foster" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-surf-lastre2026 a mlips:MaterialSystem ;
    rdfs:label "Organic molecules (H, C, N, O, S, Cl, Br) in gas phase and adsorbed on Cu, Ag and Au surfaces; bulk and slab metals" ;
    mlips:materialClass "Solid-liquid interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-aims-lastre2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-aims-lastre2026 mlips:hasDFTSettings entity:calc-settings-aims-lastre2026 .

entity:calc-settings-aims-lastre2026 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "Tkatchenko-Scheffler vdWsurf, tight basis, atomic ZORA" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-madsurf-lastre2026 a mlips:TrainingDataset ;
    rdfs:label "MAD-SURF dataset (tens of thousands of configurations; Table 1)" ;
    mlips:coversMaterial entity:mat-surf-lastre2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-aims-lastre2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-madsurf-lastre2026 mlips:samplingStrategy
    entity:sampling-mix-lastre2026 .

entity:sampling-mix-lastre2026 a mlips:SamplingStrategy ;
    rdfs:label "BOSS adsorption minima on Cu(111) re-relaxed on Ag/Au, AIMD of metals and adsorbates (every tenth frame), normal-mode sampling with SOAP farthest-point selection, GFN2-xTB AISS dimers recomputed with DFT" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-lastre2026 ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-lastre2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ,
        mlips:numFeatures ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-MACE-lastre2026 ;
    mlips:supportsSimulation mlips:GeometryOptimization ,
        mlips:MolecularDynamics .

entity:loss-MACE-lastre2026 a mlips:LossFunction ;
    rdfs:label "Weighted energy and force loss (force/energy ratio 1 or 10)" .

entity:alg-MACE-lastre2026 a mls:Algorithm ;
    rdfs:label "Adam, weight decay 5e-7; training from scratch, multi-head replay fine-tuning, or few-shot adaptation" .

entity:impl-MACE-lastre2026 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-scratch-cutoffRadius-lastre2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-scratch-numLayers-lastre2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-scratch-numFeatures-lastre2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-scratch-learningRate-lastre2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-ft-cutoffRadius-lastre2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

entity:setting-ft-learningRate-lastre2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.0001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-scratch-lastre2026 a mlips:MLIPRun ;
    rdfs:label "MACE trained from scratch on MAD-SURF (full, subset and filtered variants)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-madsurf-lastre2026 ;
    mlips:hasHyperparameterSetting entity:setting-scratch-cutoffRadius-lastre2026 ,
        entity:setting-scratch-numLayers-lastre2026 ,
        entity:setting-scratch-numFeatures-lastre2026 ,
        entity:setting-scratch-learningRate-lastre2026 ;
    mlips:produces entity:model-scratch-lastre2026 .

entity:model-scratch-lastre2026 a mlips:TrainedModel ;
    rdfs:label "MACE MAD-SURF from scratch" .

entity:run-mpa0-lastre2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 (pretrained, as distributed)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mpa0-lastre2026 .

entity:model-mpa0-lastre2026 a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-ft-lastre2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 fine-tuned on MAD-SURF (multi-head replay)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-madsurf-lastre2026 ;
    mlips:hasHyperparameterSetting entity:setting-ft-cutoffRadius-lastre2026 ,
        entity:setting-ft-learningRate-lastre2026 ;
    mlips:produces entity:model-ft-lastre2026 .

entity:model-ft-lastre2026 a mlips:TrainedModel ;
    rdfs:label "MAD-SURF (MACE-MPA-0 fine-tuned)" .

entity:run-fewshot-lastre2026 a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 few-shot adaptation" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-madsurf-lastre2026 ;
    mlips:produces entity:model-fewshot-lastre2026 .

entity:model-fewshot-lastre2026 a mlips:TrainedModel ;
    rdfs:label "MAD-SURF (MACE-MPA-0 few-shot)" .

