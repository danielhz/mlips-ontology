@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-cao2025 a mlips:BenchmarkStudy ;
    rdfs:label "Cao, Sheriff and Freitas (2025): capturing short-range order in the CrCoNi high-entropy alloy with ensembles of moment tensor potentials" ;
    mlips:reportedIn entity:article-cao2025 .

entity:article-cao2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01722-2> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Capturing short-range order in high-entropy alloys with machine learning potentials" ;
    schema:author entity:person-Cao-cao2025 ,
