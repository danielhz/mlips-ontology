# Canonical Turtle for the protocol-derived encoding of:
#   Yaolong Zhang et al. (2025). Node-equivariant message passing for efficient and accurate machine learning interatomic potentials.
#   Chemical Science. doi:10.1039/d5sc07248d  arXiv:2508.16086v2
#
# Version read: arxiv-preprint arXiv:2508.16086v2 (sha256 72339c250a7efe27...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 90 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the NEMP method (introduced here) and its benchmark
# fits with the settings of the Methods section: 3BPA (Table I), liquid
# water (Table II), ANI-1x evaluated on COMP6 (Table III) and HME21
# (Table IV). Values of other models in the tables are quoted from the
# literature and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-zhang2025node a mlips:BenchmarkStudy ;
    rdfs:label "Zhang and Guo (2025): node-equivariant message passing (NEMP) for efficient and accurate MLIPs" ;
    mlips:reportedIn entity:article-zhang2025node .

entity:article-zhang2025node a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1039/d5sc07248d> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Node-equivariant message passing for efficient and accurate machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-4601-0461> ,
        <https://orcid.org/0000-0001-9901-053X> .

<https://orcid.org/0000-0002-4601-0461> a schema:Person ;
    schema:name "Yaolong Zhang" ;
    schema:givenName "Yaolong" ;
    schema:familyName "Zhang" ;
    schema:identifier <https://orcid.org/0000-0002-4601-0461> .

<https://orcid.org/0000-0001-9901-053X> a schema:Person ;
    schema:name "Hua Guo" ;
    schema:givenName "Hua" ;
    schema:familyName "Guo" ;
    schema:identifier <https://orcid.org/0000-0001-9901-053X> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-3BPA-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "3-(benzyloxy)pyridin-2-amine (3BPA) molecule" ;
    mlips:materialClass "Flexible drug-like organic molecule (gas phase)" .

entity:mat-water-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "Bulk liquid water" ;
    mlips:chemicalFormula "H2O" ;
    mlips:materialClass "Molecular liquid" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q283> .

entity:mat-organic-CHNO-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "Organic molecules with C, H, N, O (ANI-1x training domain)" ;
    mlips:materialClass "Small organic molecules" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q174211> .

entity:mat-HME21-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "HME21 multi-element structures" ;
    mlips:materialClass "High-temperature multi-element inorganic structures (HME21 data set)" .

entity:mat-ANI-MD-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark: ANI-MD" ;
    mlips:materialClass "Organic and biochemical molecules (COMP6)" .

entity:mat-DrugBank-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark: DrugBank" ;
    mlips:materialClass "Organic and biochemical molecules (COMP6)" .

entity:mat-GDB7-9-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark: GDB7-9" ;
    mlips:materialClass "Organic and biochemical molecules (COMP6)" .

entity:mat-GDB10-13-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark: GDB10-13" ;
    mlips:materialClass "Organic and biochemical molecules (COMP6)" .

entity:mat-S66x8-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark: S66x8" ;
    mlips:materialClass "Organic and biochemical molecules (COMP6)" .

entity:mat-Tripeptides-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark: Tripeptides" ;
    mlips:materialClass "Organic and biochemical molecules (COMP6)" .

entity:mat-COMP6-total-zhang2025node a mlips:MaterialSystem ;
    rdfs:label "COMP6 benchmark: all subsets together" ;
    mlips:materialClass "Organic and biochemical molecules (COMP6)" .

