entity:result-nemp-3BPA-300K-zhang2025node a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nemp-3BPA-zhang2025node ;
    mlips:targetMaterial entity:mat-3BPA-zhang2025node ;
    mlips:hasAccuracyMetric entity:metric-nemp-3BPA-300K-1-zhang2025node ,
        entity:metric-nemp-3BPA-300K-2-zhang2025node .

entity:metric-nemp-3BPA-300K-1-zhang2025node a mlips:AccuracyMetric ;
    rdfs:label "RMSE on energy: NEMP, 3BPA test set at 300 K" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.3"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV .

