###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-nemp-3BPA-zhang2025node a mlips:MLIPRun ;
    rdfs:label "NEMP trained on 3BPA (300 K)" ;
    mlips:appliesMethod entity:NEMP ;
    mlips:runsOn entity:ds-3BPA-zhang2025node ;
    mlips:hasHyperparameterSetting entity:setting-nemp-3BPA-numLayers-zhang2025node ,
        entity:setting-nemp-3BPA-numFeatures-zhang2025node ,
        entity:setting-nemp-3BPA-L-max-sph-zhang2025node ,
        entity:setting-nemp-3BPA-numAngularBasis-zhang2025node ,
        entity:setting-nemp-3BPA-cutoffRadius-zhang2025node ,
        entity:setting-nemp-3BPA-batchSize-zhang2025node ,
        entity:setting-nemp-3BPA-learningRate-zhang2025node ;
    mlips:produces entity:model-nemp-3BPA-zhang2025node .

entity:model-nemp-3BPA-zhang2025node a mlips:TrainedModel ;
    rdfs:label "NEMP 3BPA model" .

entity:run-nemp-water-zhang2025node a mlips:MLIPRun ;
    rdfs:label "NEMP trained on liquid water" ;
    mlips:appliesMethod entity:NEMP ;
    mlips:runsOn entity:ds-water-zhang2025node ;
    mlips:hasHyperparameterSetting entity:setting-nemp-water-numLayers-zhang2025node ,
        entity:setting-nemp-water-numFeatures-zhang2025node ,
        entity:setting-nemp-water-L-max-sph-zhang2025node ,
        entity:setting-nemp-water-numAngularBasis-zhang2025node ,
        entity:setting-nemp-water-cutoffRadius-zhang2025node ,
        entity:setting-nemp-water-batchSize-zhang2025node ,
        entity:setting-nemp-water-learningRate-zhang2025node ;
    mlips:produces entity:model-nemp-water-zhang2025node .

entity:model-nemp-water-zhang2025node a mlips:TrainedModel ;
    rdfs:label "NEMP liquid water model" .

entity:run-nemp-ANI-1x-zhang2025node a mlips:MLIPRun ;
    rdfs:label "NEMP trained on ANI-1x" ;
    mlips:appliesMethod entity:NEMP ;
    mlips:runsOn entity:ds-ANI-1x-zhang2025node ;
    mlips:hasHyperparameterSetting entity:setting-nemp-ANI-1x-numLayers-zhang2025node ,
        entity:setting-nemp-ANI-1x-numFeatures-zhang2025node ,
        entity:setting-nemp-ANI-1x-L-max-sph-zhang2025node ,
        entity:setting-nemp-ANI-1x-numAngularBasis-zhang2025node ,
        entity:setting-nemp-ANI-1x-cutoffRadius-zhang2025node ,
        entity:setting-nemp-ANI-1x-batchSize-zhang2025node ,
        entity:setting-nemp-ANI-1x-learningRate-zhang2025node ;
    mlips:produces entity:model-nemp-ANI-1x-zhang2025node .

entity:model-nemp-ANI-1x-zhang2025node a mlips:TrainedModel ;
    rdfs:label "NEMP ANI-1x model" .

entity:run-nemp-HME21-zhang2025node a mlips:MLIPRun ;
    rdfs:label "NEMP trained on HME21" ;
    mlips:appliesMethod entity:NEMP ;
    mlips:runsOn entity:ds-HME21-zhang2025node ;
    mlips:hasHyperparameterSetting entity:setting-nemp-HME21-numLayers-zhang2025node ,
        entity:setting-nemp-HME21-numFeatures-zhang2025node ,
        entity:setting-nemp-HME21-L-max-sph-zhang2025node ,
        entity:setting-nemp-HME21-numAngularBasis-zhang2025node ,
