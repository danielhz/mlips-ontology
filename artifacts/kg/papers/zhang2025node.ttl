entity:setting-nemp-ANI-1x-numAngularBasis-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-nemp-ANI-1x-cutoffRadius-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-nemp-ANI-1x-batchSize-zhang2025node a mlips:HyperparameterSetting ;
