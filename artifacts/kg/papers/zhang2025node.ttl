###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-3BPA-zhang2025node a mlips:TrainingDataset ;
    rdfs:label "3BPA training set (300 K configurations)" ;
    mlips:coversMaterial entity:mat-3BPA-zhang2025node ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-water-zhang2025node a mlips:TrainingDataset ;
    rdfs:label "Liquid water data set" ;
    mlips:coversMaterial entity:mat-water-zhang2025node ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

entity:ds-ANI-1x-zhang2025node a mlips:TrainingDataset ;
    rdfs:label "ANI-1x data set (subset used for training)" ;
    mlips:coversMaterial entity:mat-organic-CHNO-zhang2025node ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    rdfs:comment "Table III notes that the ANI-1x model used ten times more training data than the other models, i.e. NEMP was trained on a subset; its size was not captured." .

entity:ds-HME21-zhang2025node a mlips:TrainingDataset ;
    rdfs:label "HME21 data set" ;
    mlips:coversMaterial entity:mat-HME21-zhang2025node ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-3BPA-zhang2025node mlips:samplingStrategy
    entity:sampling-published-benchmark-zhang2025node .

entity:ds-water-zhang2025node mlips:samplingStrategy
    entity:sampling-published-benchmark-zhang2025node .

entity:ds-ANI-1x-zhang2025node mlips:samplingStrategy
    entity:sampling-published-benchmark-zhang2025node .

entity:ds-HME21-zhang2025node mlips:samplingStrategy
    entity:sampling-published-benchmark-zhang2025node .

entity:sampling-published-benchmark-zhang2025node a mlips:SamplingStrategy ;
    rdfs:label "Published benchmark data set with its standard split" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:NEMP a mlips:MLIPMethod ;
    rdfs:label "Node-Equivariant Message Passing (NEMP)" ;
    mlips:hasTrainingAlgorithm entity:alg-NEMP-zhang2025node ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        entity:hp-L-max-sph-zhang2025node ,
        mlips:numAngularBasis ,
        mlips:cutoffRadius ,
        mlips:batchSize ,
        mlips:learningRate .

entity:alg-NEMP-zhang2025node a mls:Algorithm ;
    rdfs:label "Learning-rate warm-up followed by reduction on plateau of the validation loss down to 1e-5 (factors and patience per data set)" .

entity:hp-L-max-sph-zhang2025node a mlips:Hyperparameter ;
    rdfs:label "NEMP maximal angular momentum L_max of the spherical harmonics" ;
    mlips:hyperparameterName "L_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nemp-3BPA-numLayers-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-nemp-3BPA-numFeatures-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "64"^^xsd:integer .

entity:setting-nemp-3BPA-L-max-sph-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-L-max-sph-zhang2025node ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-nemp-3BPA-numAngularBasis-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-nemp-3BPA-cutoffRadius-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:double .

entity:setting-nemp-3BPA-batchSize-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-nemp-3BPA-learningRate-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.2"^^xsd:double .

entity:setting-nemp-water-numLayers-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-nemp-water-numFeatures-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-nemp-water-L-max-sph-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-L-max-sph-zhang2025node ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-nemp-water-numAngularBasis-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numAngularBasis ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-nemp-water-cutoffRadius-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-nemp-water-batchSize-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-nemp-water-learningRate-zhang2025node a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.01"^^xsd:double .

entity:setting-nemp-ANI-1x-numLayers-zhang2025node a mlips:HyperparameterSetting ;
