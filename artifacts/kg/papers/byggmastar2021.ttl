# Canonical Turtle for the protocol-derived encoding of:
#   Jesper Byggmästar et al. (2021). Modeling refractory high-entropy alloys with efficient machine-learned interatomic potentials: Defects and segregation.
#   arXiv (Cornell University). doi:10.1103/physrevb.104.104101  arXiv:2106.03369v2
#
# Version read: arxiv-preprint arXiv:2106.03369v2 (sha256 8bdce5533565ae35...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 477 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/byggmastar2021.yaml.
#
# Encoding scope: the Mo-Nb-Ta-V-W GAP with a screened-Coulomb
# repulsive pair term, GAP pair and three-body terms (5 A cutoffs,
# squared-exponential kernels), trained with QUIP on VASP PBE data and
# tabulated into cubic splines (tabGAP, a LAMMPS pair style); the test
# RMSEs by structure class (Table I). Bulk, elastic, defect, ordering and
# annealing results are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-byggmastar2021 a mlips:BenchmarkStudy ;
    rdfs:label "Byggmastar, Nordlund and Djurabekova (2021): tabGAP, a tabulated two- and three-body GAP for Mo-Nb-Ta-V-W, applied to defects and segregation in the MoNbTaVW high-entropy alloy" ;
    mlips:reportedIn entity:article-byggmastar2021 .

entity:article-byggmastar2021 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevb.104.104101> ;
    schema:datePublished "2021"^^xsd:gYear ;
    schema:name "Modeling refractory high-entropy alloys with efficient machine-learned interatomic potentials: Defects and segregation" ;
    schema:author <https://orcid.org/0000-0002-4898-6150> ,
        <https://orcid.org/0000-0001-6244-1942> ,
        entity:person-Djurabekova-byggmastar2021 .

<https://orcid.org/0000-0002-4898-6150> a schema:Person ;
    schema:name "J. Byggmästar" ;
    schema:givenName "J." ;
    schema:familyName "Byggmästar" ;
    schema:identifier <https://orcid.org/0000-0002-4898-6150> .

<https://orcid.org/0000-0001-6244-1942> a schema:Person ;
    schema:name "K. Nordlund" ;
    schema:givenName "K." ;
    schema:familyName "Nordlund" ;
    schema:identifier <https://orcid.org/0000-0001-6244-1942> .

entity:person-Djurabekova-byggmastar2021 a schema:Person ;
    schema:name "F. Djurabekova" ;
    schema:givenName "F." ;
    schema:familyName "Djurabekova" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mnbtvw-byggmastar2021 a mlips:MaterialSystem ;
    rdfs:label "Mo-Nb-Ta-V-W bcc crystals and alloys at all compositions, defects, surfaces and liquids" ;
    mlips:materialClass "High-entropy alloys" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-byggmastar2021 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-byggmastar2021 mlips:hasDFTSettings entity:calc-settings-vasp-byggmastar2021 .

entity:calc-settings-vasp-byggmastar2021 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "0.15 1/A maximum spacing, Gamma-centred Monkhorst-Pack" ;
    rdfs:comment "0.1 eV Methfessel-Paxton smearing" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-train-byggmastar2021 a mlips:TrainingDataset ;
    rdfs:label "Mo-Nb-Ta-V-W training set (energies, forces, virials)" ;
    mlips:coversMaterial entity:mat-mnbtvw-byggmastar2021 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Virials ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-vasp-byggmastar2021 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-train-byggmastar2021 mlips:samplingStrategy
    entity:sampling-mixed-byggmastar2021 .

entity:sampling-mixed-byggmastar2021 a mlips:SamplingStrategy ;
    rdfs:label "Bulk bcc crystals (random and ordered alloys), vacancies and interstitials in pure elements and the equiatomic HEA, liquids, HEA crystals with an added interstitial, surfaces (details in the Supplemental Material)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:tabGAP a mlips:MLIPMethod ;
    rdfs:label "tabGAP (tabulated low-dimensional Gaussian approximation potential)" ;
    mlips:hasLossFunction entity:loss-tabGAP-byggmastar2021 ;
    mlips:hasTrainingAlgorithm entity:alg-tabGAP-byggmastar2021 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-tabGAP-byggmastar2021 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:MonteCarlo ,
        mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:loss-tabGAP-byggmastar2021 a mlips:LossFunction ;
    rdfs:label "GAP regression to total energies, forces and virials; 2b and 3b squared-exponential kernels (length scale 1 A), delta_2b^2 = 10 eV, delta_3b^2 = 1 eV, M_2b = 20 and M_3b = 300 sparse points per element combination" .

entity:alg-tabGAP-byggmastar2021 a mls:Algorithm ;
    rdfs:label "GAP fit with QUIP, then cubic-spline tabulation (1D pair, 3D triplet grids)" .

entity:impl-tabGAP-byggmastar2021 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-tabgap-cutoffRadius-byggmastar2021 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-tabgap-byggmastar2021 a mlips:MLIPRun ;
    rdfs:label "tabGAP for Mo-Nb-Ta-V-W" ;
    mlips:appliesMethod entity:tabGAP ;
    mlips:runsOn entity:ds-train-byggmastar2021 ;
    mlips:hasHyperparameterSetting entity:setting-tabgap-cutoffRadius-byggmastar2021 ;
    mlips:produces entity:model-tabgap-byggmastar2021 .

entity:model-tabgap-byggmastar2021 a mlips:TrainedModel ;
    rdfs:label "tabGAP Mo-Nb-Ta-V-W (2021)" .

