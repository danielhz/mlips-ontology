    mlips:runsOn entity:ds-inc4-zhang2020hbn ;
    mlips:hasHyperparameterSetting entity:setting-inc4-descriptors-zhang2020hbn ,
        entity:setting-inc4-cutoffRadius-zhang2020hbn ,
        entity:setting-inc4-three-body-cutoff-zhang2020hbn ;
    mlips:produces entity:model-inc4-zhang2020hbn .

entity:model-inc4-zhang2020hbn a mlips:TrainedModel ;
    rdfs:label "GAP for monolayer h-BN (Incremental-4)" .

entity:run-inc6-zhang2020hbn a mlips:MLIPRun ;
    rdfs:label "GAP trained on the Incremental-6 set" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-inc6-zhang2020hbn ;
    mlips:hasHyperparameterSetting entity:setting-inc6-descriptors-zhang2020hbn ,
        entity:setting-inc6-cutoffRadius-zhang2020hbn ,
