# Canonical Turtle for the protocol-derived encoding of:
#   Akira Takahashi et al. (2017). Conceptual and practical bases for the high accuracy of machine learning interatomic potentials: Application to elemental titanium.
#   Physical Review Materials. doi:10.1103/physrevmaterials.1.063801  arXiv:1708.02741v1
#
# Version read: arxiv-preprint arXiv:1708.02741v1 (sha256 b39a6274f03e5db1...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 479 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/takahashi2017.yaml.
#
# Encoding scope: two linearized polynomial MLIPs for Ti fitted by
# linear ridge regression to energies and forces (a cubic polynomial in
# pairwise Gaussian descriptors and a quadratic polynomial in angular
# Fourier series descriptors with l_max = 10), with their test energy
# RMSEs. EAM and MEAM comparisons are classical potentials; elastic
# constants and phonons are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-takahashi2017 a mlips:BenchmarkStudy ;
    rdfs:label "Takahashi, Seko and Tanaka (2017): MLIPs as embedding-energy models beyond the uniform density approximation, with pairwise and angular-dependent polynomial MLIPs for elemental Ti" ;
    mlips:reportedIn entity:article-takahashi2017 .

entity:article-takahashi2017 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevmaterials.1.063801> ;
    schema:datePublished "2017"^^xsd:gYear ;
    schema:name "Conceptual and practical bases for the high accuracy of machine learning interatomic potentials: Application to elemental titanium" ;
    schema:author entity:person-Takahashi-takahashi2017 ,
        entity:person-Seko-takahashi2017 ,
        entity:person-Tanaka-takahashi2017 .

entity:person-Takahashi-takahashi2017 a schema:Person ;
    schema:name "Akira Takahashi" ;
    schema:givenName "Akira" ;
    schema:familyName "Takahashi" .

entity:person-Seko-takahashi2017 a schema:Person ;
    schema:name "Atsuto Seko" ;
    schema:givenName "Atsuto" ;
    schema:familyName "Seko" .

entity:person-Tanaka-takahashi2017 a schema:Person ;
    schema:name "Isao Tanaka" ;
    schema:givenName "Isao" ;
    schema:familyName "Tanaka" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-ti-takahashi2017 a mlips:MaterialSystem ;
    rdfs:label "Elemental Ti (fcc, bcc, hcp, sc, omega and beta-Sn based supercells)" ;
    mlips:chemicalFormula "Ti" ;
    mlips:materialClass "Metals" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-vasp-takahashi2017 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-vasp-takahashi2017 mlips:hasDFTSettings entity:calc-settings-vasp-takahashi2017 .

entity:calc-settings-vasp-takahashi2017 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-train-takahashi2017 a mlips:TrainingDataset ;
    rdfs:label "Ti training set (2,700 configurations; 430,650 energy and force data)" ;
    mlips:coversMaterial entity:mat-ti-takahashi2017 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 2700 ;
    mlips:hasDFTCalculation entity:calc-vasp-takahashi2017 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-train-takahashi2017 mlips:samplingStrategy
    entity:sampling-distort-takahashi2017 .

entity:sampling-distort-takahashi2017 a mlips:SamplingStrategy ;
    rdfs:label "Isotropic and random expansions, random distortions and random displacements of optimized fcc, bcc, hcp, sc, omega and beta-Sn supercells" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PolyMLP a mlips:MLIPMethod ;
    rdfs:label "Linearized polynomial machine-learning potential (Seko, Takahashi and Tanaka)" ;
    mlips:hasLossFunction entity:loss-PolyMLP-takahashi2017 ;
    mlips:hasTrainingAlgorithm entity:alg-PolyMLP-takahashi2017 ;
    mlips:hasHyperparameter entity:hp-ncoef-takahashi2017 ,
        entity:hp-lmax-takahashi2017 ;
    mlips:supportsSimulation mlips:PhononCalculation .

entity:loss-PolyMLP-takahashi2017 a mlips:LossFunction ;
    rdfs:label "Energies and forces" .

entity:alg-PolyMLP-takahashi2017 a mls:Algorithm ;
    rdfs:label "Linear ridge regression" .

entity:hp-ncoef-takahashi2017 a mlips:Hyperparameter ;
    rdfs:label "Number of regression coefficients" ;
    mlips:hyperparameterName "number of coefficients" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-lmax-takahashi2017 a mlips:Hyperparameter ;
    rdfs:label "Maximum angular order l_max of the angular Fourier series" ;
    mlips:hyperparameterName "l_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-pair-ncoef-takahashi2017 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-ncoef-takahashi2017 ;
    mlips:settingValue "2925"^^xsd:integer .

entity:setting-ang-ncoef-takahashi2017 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-ncoef-takahashi2017 ;
    mlips:settingValue "35245"^^xsd:integer .

entity:setting-ang-lmax-takahashi2017 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-lmax-takahashi2017 ;
    mlips:settingValue "10"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-pair-takahashi2017 a mlips:MLIPRun ;
    rdfs:label "Pairwise MLIP (cubic polynomial) for Ti" ;
    mlips:appliesMethod entity:PolyMLP ;
    mlips:runsOn entity:ds-train-takahashi2017 ;
    mlips:hasHyperparameterSetting entity:setting-pair-ncoef-takahashi2017 ;
    mlips:produces entity:model-pair-takahashi2017 .

entity:model-pair-takahashi2017 a mlips:TrainedModel ;
    rdfs:label "Pairwise polynomial MLIP Ti" .

entity:run-ang-takahashi2017 a mlips:MLIPRun ;
    rdfs:label "Angular-dependent MLIP (quadratic polynomial, l_max = 10) for Ti" ;
    mlips:appliesMethod entity:PolyMLP ;
    mlips:runsOn entity:ds-train-takahashi2017 ;
    mlips:hasHyperparameterSetting entity:setting-ang-ncoef-takahashi2017 ,
        entity:setting-ang-lmax-takahashi2017 ;
    mlips:produces entity:model-ang-takahashi2017 .

entity:model-ang-takahashi2017 a mlips:TrainedModel ;
    rdfs:label "Angular-dependent polynomial MLIP Ti" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-takahashi2017 mlips:hasResult
    entity:result-pair-test-takahashi2017 ,
    entity:result-ang-test-takahashi2017 .

entity:result-pair-test-takahashi2017 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-pair-takahashi2017 ;
    mlips:targetMaterial entity:mat-ti-takahashi2017 ;
    mlips:hasAccuracyMetric entity:metric-pair-test-1-takahashi2017 .

entity:metric-pair-test-1-takahashi2017 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on Ti: pairwise polynomial MLIP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:result-ang-test-takahashi2017 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-ang-takahashi2017 ;
    mlips:targetMaterial entity:mat-ti-takahashi2017 ;
    mlips:hasAccuracyMetric entity:metric-ang-test-1-takahashi2017 .

entity:metric-ang-test-1-takahashi2017 a mlips:AccuracyMetric ;
    rdfs:label "test energy RMSE on Ti: angular-dependent polynomial MLIP" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.5"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

###############################################################################
# Q11 -- Computational resources
###############################################################################

# The paper reports no training-cost or inference-cost figures.

###############################################################################
# Q12 -- Gaps and ambiguities (prose; not triples)
###############################################################################

# - Maximum absolute errors (23.0 and 2.8 meV/atom) are not RMSE/MAE and are not encoded; the RMSE-versus-number-of-terms curve is figure-only (Fig. 2a). The method's introducing papers (Seko et al. 2014, 2015) are not in the corpus, so the new PolyMLP registry method has no origin.
# - Author affiliations are not encoded (ORCIDs are those deposited with the DOI metadata, source: crossref).
