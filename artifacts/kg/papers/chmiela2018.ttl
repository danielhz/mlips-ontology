    mlips:coversMaterial entity:mat-toluene-chmiela2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-pvdz-chmiela2018 .

entity:ds-ethanol-chmiela2018 a mlips:TrainingDataset ;
    rdfs:label "Ethanol CCSD(T)/cc-pVTZ force data set" ;
    mlips:coversMaterial entity:mat-ethanol-chmiela2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-pvtz-chmiela2018 .

entity:ds-malonaldehyde-chmiela2018 a mlips:TrainingDataset ;
    rdfs:label "Malonaldehyde CCSD(T)/cc-pVDZ force data set" ;
    mlips:coversMaterial entity:mat-malonaldehyde-chmiela2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-pvdz-chmiela2018 .

entity:ds-aspirin-chmiela2018 a mlips:TrainingDataset ;
    rdfs:label "Aspirin CCSD/cc-pVDZ force data set" ;
    mlips:coversMaterial entity:mat-aspirin-chmiela2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-ccsd-pvdz-chmiela2018 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-benzene-chmiela2018 mlips:samplingStrategy
    entity:sampling-dft-md-boltzmann-chmiela2018 .

entity:ds-toluene-chmiela2018 mlips:samplingStrategy
    entity:sampling-dft-md-boltzmann-chmiela2018 .

entity:ds-ethanol-chmiela2018 mlips:samplingStrategy
    entity:sampling-dft-md-boltzmann-chmiela2018 .

entity:ds-malonaldehyde-chmiela2018 mlips:samplingStrategy
    entity:sampling-dft-md-boltzmann-chmiela2018 .

entity:ds-aspirin-chmiela2018 mlips:samplingStrategy
    entity:sampling-dft-md-boltzmann-chmiela2018 .

entity:sampling-dft-md-boltzmann-chmiela2018 a mlips:SamplingStrategy ;
    rdfs:label "Subsampling of a DFT MD trajectory under preservation of the Maxwell-Boltzmann energy distribution" ;
    rdfs:comment "NVT ab initio MD (Nose-Hoover) at 500 K for 200 ps with 0.5 fs resolution; a few hundred geometries are subsampled and, for the coupled-cluster data sets, recomputed at the CCSD(T) or CCSD level." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:sGDML a mlips:MLIPMethod ;
    rdfs:label "Symmetric Gradient-Domain Machine Learning (sGDML)" ;
    mlips:hasLossFunction entity:loss-sGDML-chmiela2018 ;
    mlips:hasTrainingAlgorithm entity:alg-sGDML-chmiela2018 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-sGDML-chmiela2018 a mlips:LossFunction ;
    rdfs:label "Kernel ridge regression on forces only; an energy penalty is intentionally omitted from the cost function" .

entity:alg-sGDML-chmiela2018 a mls:Algorithm ;
    rdfs:label "Symmetric kernel built as a sum over the permutations found by bipartite matching of molecular graphs (Hungarian algorithm) across the training set" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
