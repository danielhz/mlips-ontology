    mlips:appliesMethod entity:sGDML ;
    mlips:runsOn entity:ds-toluene-chmiela2018 ;
    mlips:produces entity:model-sgdml-toluene-chmiela2018 .

entity:model-sgdml-toluene-chmiela2018 a mlips:TrainedModel ;
    rdfs:label "sGDML@CCSD(T) model for toluene" .

entity:run-sgdml-ethanol-chmiela2018 a mlips:MLIPRun ;
    rdfs:label "sGDML@CCSD(T) force field for ethanol" ;
    mlips:appliesMethod entity:sGDML ;
    mlips:runsOn entity:ds-ethanol-chmiela2018 ;
    mlips:produces entity:model-sgdml-ethanol-chmiela2018 .

entity:model-sgdml-ethanol-chmiela2018 a mlips:TrainedModel ;
    rdfs:label "sGDML@CCSD(T) model for ethanol" .

entity:run-sgdml-malonaldehyde-chmiela2018 a mlips:MLIPRun ;
    rdfs:label "sGDML@CCSD(T) force field for malonaldehyde" ;
    mlips:appliesMethod entity:sGDML ;
    mlips:runsOn entity:ds-malonaldehyde-chmiela2018 ;
    mlips:produces entity:model-sgdml-malonaldehyde-chmiela2018 .

entity:model-sgdml-malonaldehyde-chmiela2018 a mlips:TrainedModel ;
    rdfs:label "sGDML@CCSD(T) model for malonaldehyde" .

entity:run-sgdml-aspirin-chmiela2018 a mlips:MLIPRun ;
    rdfs:label "sGDML@CCSD force field for aspirin" ;
    mlips:appliesMethod entity:sGDML ;
    mlips:runsOn entity:ds-aspirin-chmiela2018 ;
    mlips:produces entity:model-sgdml-aspirin-chmiela2018 .

