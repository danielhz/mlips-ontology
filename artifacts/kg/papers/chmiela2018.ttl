# Canonical Turtle for the protocol-derived encoding of:
#   Stefan Chmiela et al. (2018). Towards exact molecular dynamics simulations with machine-learned force fields.
#   Nature Communications. doi:10.1038/s41467-018-06169-2  arXiv:1802.09238v3
#
# Version read: arxiv-preprint arXiv:1802.09238v3 (sha256 ffde67eba00609eb...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 82 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the sGDML method (introduced here: GDML with
# permutational symmetries recovered from the data) and the
# coupled-cluster force fields the paper builds with it for benzene,
# toluene, ethanol, malonaldehyde (CCSD(T)) and aspirin (CCSD). The
# DFT-trained sGDML and GDML models for ten molecules are compared in a
# figure; errors are in the supplementary tables.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-chmiela2018 a mlips:BenchmarkStudy ;
    rdfs:label "Chmiela et al. (2018): towards exact molecular dynamics simulations with machine-learned force fields (sGDML at CCSD(T) accuracy)" ;
    mlips:reportedIn entity:article-chmiela2018 .

entity:article-chmiela2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41467-018-06169-2> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Towards exact molecular dynamics simulations with machine-learned force fields" ;
    schema:author entity:person-Chmiela-chmiela2018 ,
        <https://orcid.org/0000-0001-6091-3408> ,
        entity:person-Muller-chmiela2018 ,
        entity:person-Tkatchenko-chmiela2018 .

entity:person-Chmiela-chmiela2018 a schema:Person ;
    schema:name "Stefan Chmiela" ;
    schema:givenName "Stefan" ;
    schema:familyName "Chmiela" .

<https://orcid.org/0000-0001-6091-3408> a schema:Person ;
    schema:name "Huziel E. Sauceda" ;
    schema:givenName "Huziel E." ;
    schema:familyName "Sauceda" ;
    schema:identifier <https://orcid.org/0000-0001-6091-3408> .

entity:person-Muller-chmiela2018 a schema:Person ;
    schema:name "Klaus-Robert Müller" ;
    schema:givenName "Klaus-Robert" ;
    schema:familyName "Müller" .

entity:person-Tkatchenko-chmiela2018 a schema:Person ;
    schema:name "Alexandre Tkatchenko" ;
    schema:givenName "Alexandre" ;
    schema:familyName "Tkatchenko" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-benzene-chmiela2018 a mlips:MaterialSystem ;
    rdfs:label "Benzene molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-toluene-chmiela2018 a mlips:MaterialSystem ;
    rdfs:label "Toluene molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-ethanol-chmiela2018 a mlips:MaterialSystem ;
    rdfs:label "Ethanol molecule" ;
    mlips:materialClass "Small fluxional organic molecule (gas phase)" .

entity:mat-malonaldehyde-chmiela2018 a mlips:MaterialSystem ;
    rdfs:label "Malonaldehyde molecule" ;
    mlips:materialClass "Small organic molecule (gas phase)" .

entity:mat-aspirin-chmiela2018 a mlips:MaterialSystem ;
    rdfs:label "Aspirin molecule" ;
    mlips:materialClass "Organic molecule of 21 atoms (gas phase)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ccsdt-pvtz-chmiela2018 a mlips:WaveFunctionCalculation .

entity:calc-ccsdt-pvdz-chmiela2018 a mlips:WaveFunctionCalculation .

entity:calc-ccsdt-benzene-chmiela2018 a mlips:WaveFunctionCalculation .

entity:calc-ccsd-pvdz-chmiela2018 a mlips:WaveFunctionCalculation .

entity:calc-dft-chmiela2018 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ccsdt-pvtz-chmiela2018 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-pvtz-chmiela2018 .

entity:calc-settings-ccsdt-pvtz-chmiela2018 a mlips:WaveFunctionSettings ;
    mlips:usedReferenceCode entity:lib-Psi4-chmiela2018 ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "cc-pVTZ" ;
    rdfs:comment "All-electron CCSD(T)/cc-pVTZ, used for ethanol." .

entity:calc-ccsdt-pvdz-chmiela2018 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-pvdz-chmiela2018 .

entity:calc-settings-ccsdt-pvdz-chmiela2018 a mlips:WaveFunctionSettings ;
    mlips:usedReferenceCode entity:lib-Psi4-chmiela2018 ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "cc-pVDZ" ;
    rdfs:comment "All-electron CCSD(T)/cc-pVDZ, used for toluene and malonaldehyde." .

entity:calc-ccsdt-benzene-chmiela2018 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-benzene-chmiela2018 .

entity:calc-settings-ccsdt-benzene-chmiela2018 a mlips:WaveFunctionSettings ;
    mlips:usedReferenceCode entity:lib-Psi4-chmiela2018 ;
    mlips:wfMethod mlips:CCSDT ;
    rdfs:comment "All-electron CCSD(T) for benzene; the basis set is not named in the sentence that lists the others." .

entity:calc-ccsd-pvdz-chmiela2018 mlips:hasWaveFunctionSettings entity:calc-settings-ccsd-pvdz-chmiela2018 .

entity:calc-settings-ccsd-pvdz-chmiela2018 a mlips:WaveFunctionSettings ;
    mlips:usedReferenceCode entity:lib-Psi4-chmiela2018 ;
    mlips:wfMethod mlips:CCSD ;
    mlips:basisSet "cc-pVDZ" ;
    rdfs:comment "CCSD/cc-pVDZ, used for the larger aspirin molecule." .

entity:calc-dft-chmiela2018 mlips:hasDFTSettings entity:calc-settings-dft-chmiela2018 .

entity:calc-settings-dft-chmiela2018 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:FHIaims ;
    mlips:xcFunctional entity:xc-PBE-TS-chmiela2018 ;
    rdfs:comment "All-electron calculations with FHI-aims; level of the sampling MD and of the DFT-trained models." .

entity:lib-Psi4-chmiela2018 a mlips:Library ;
    rdfs:label "Psi4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-Psi4-chmiela2018 a mlips:Library ;
    rdfs:label "Psi4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-Psi4-chmiela2018 a mlips:Library ;
    rdfs:label "Psi4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:lib-Psi4-chmiela2018 a mlips:Library ;
    rdfs:label "Psi4" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBE-TS-chmiela2018 a mlips:XCFunctional ;
    rdfs:label "PBE+TS" ;
    rdfs:comment "PBE with Tkatchenko-Scheffler van der Waals correction." ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-benzene-chmiela2018 a mlips:TrainingDataset ;
