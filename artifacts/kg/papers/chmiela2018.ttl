###############################################################################

entity:run-sgdml-benzene-chmiela2018 a mlips:MLIPRun ;
    rdfs:label "sGDML@CCSD(T) force field for benzene" ;
    mlips:appliesMethod entity:sGDML ;
    mlips:runsOn entity:ds-benzene-chmiela2018 ;
    mlips:produces entity:model-sgdml-benzene-chmiela2018 .

entity:model-sgdml-benzene-chmiela2018 a mlips:TrainedModel ;
    rdfs:label "sGDML@CCSD(T) model for benzene" .

entity:run-sgdml-toluene-chmiela2018 a mlips:MLIPRun ;
