    mlips:coversMaterial entity:mat-benzene-chmiela2018 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-benzene-chmiela2018 .

entity:ds-toluene-chmiela2018 a mlips:TrainingDataset ;
