# Canonical Turtle for the protocol-derived encoding of:
#   Fei Shuang et al. (2025). Universal machine learning interatomic potentials poised to supplant DFT in modeling general defects in metals and random alloys.
#   Machine Learning Science and Technology. doi:10.1088/2632-2153/adea2d  arXiv:2502.03578v2
#
# Version read: arxiv-preprint arXiv:2502.03578v2 (sha256 7ccfb652ab41cf24...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 127 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: a benchmark of 26 pretrained universal MLIPs (no model
# is trained here) on 14 DFT data sets of defects in metals and alloys.
# The per-model energy and force RMSEs are shown as figures; the text
# prints ranges and a few extreme values only. Encoded: the reference
# settings of the new DFT data sets. The models and data sets are listed
# in the gaps for a later pass with the paper's data repository.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-shuang2025 a mlips:BenchmarkStudy ;
    rdfs:label "Shuang et al. (2025): universal MLIPs poised to supplant DFT in modeling general defects in metals and random alloys" ;
    mlips:reportedIn entity:article-shuang2025 .

entity:article-shuang2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1088/2632-2153/adea2d> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Universal machine learning interatomic potentials poised to supplant DFT in modeling general defects in metals and random alloys" ;
    schema:author <https://orcid.org/0000-0001-6333-9237> ,
        <https://orcid.org/0009-0000-3900-3995> ,
        entity:person-Liu-shuang2025 ,
        entity:person-Gao-shuang2025 ,
        entity:person-Dey-shuang2025 .

<https://orcid.org/0000-0001-6333-9237> a schema:Person ;
    schema:name "Fei Shuang" ;
    schema:givenName "Fei" ;
    schema:familyName "Shuang" ;
