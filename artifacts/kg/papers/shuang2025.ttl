###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-shuang2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-shuang2025 mlips:hasDFTSettings entity:calc-settings-dft-shuang2025 .

entity:calc-settings-dft-shuang2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "520"^^xsd:double ;
    mlips:kPointMesh "Monkhorst-Pack meshes generated with VASPKIT at a density of 2 pi x 0.03 A^-1" ;
    rdfs:comment "Electronic convergence 1e-6 eV; collinear spin polarisation for magnetic species; applied to every data set produced in this work. This is the benchmark reference, not training data; uMLIP evaluations are one-shot calculations through ASE." .

