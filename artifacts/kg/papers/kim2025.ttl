###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE-LES a mlips:MLIPMethod ;
    rdfs:label "MACE with latent Ewald summation (MACE-LES)" ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numFeatures ,
        entity:hp-ell-kim2025 ,
        entity:hp-les-sigma-kim2025 ;
    mlips:hasImplementation entity:impl-MACE-LES-kim2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MACE-LES-kim2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-LES-kim2025 .

entity:lib-LES-kim2025 a mlips:Library ;
    rdfs:label "LES" ;
    rdfs:comment "Standalone LES library compatible with MACE, NequIP, CACE and MatGL (CHGNet)" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-ell-kim2025 a mlips:Hyperparameter ;
    rdfs:label "MACE irrep (rotation) order l of the messages" ;
    mlips:hyperparameterName "l" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-les-sigma-kim2025 a mlips:Hyperparameter ;
    rdfs:label "LES Ewald smearing factor sigma (A)" ;
    mlips:hyperparameterName "sigma" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-maceles-off-cutoffRadius-kim2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "4.5"^^xsd:double .

entity:setting-maceles-off-numFeatures-kim2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "192"^^xsd:integer .

entity:setting-maceles-off-ell-kim2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-ell-kim2025 ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-maceles-off-les-sigma-kim2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-les-sigma-kim2025 ;
    mlips:settingValue "1"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-maceles-off-kim2025 a mlips:MLIPRun ;
    rdfs:label "MACELES-OFF trained on SPICE version 1" ;
    mlips:appliesMethod entity:MACE-LES ;
    mlips:runsOn entity:ds-spice-kim2025 ;
    mlips:hasHyperparameterSetting entity:setting-maceles-off-cutoffRadius-kim2025 ,
        entity:setting-maceles-off-numFeatures-kim2025 ,
        entity:setting-maceles-off-ell-kim2025 ,
        entity:setting-maceles-off-les-sigma-kim2025 ;
    mlips:produces entity:model-maceles-off-kim2025 .

entity:model-maceles-off-kim2025 a mlips:TrainedModel ;
    rdfs:label "MACELES-OFF (float32)" .

