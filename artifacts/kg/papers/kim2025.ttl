entity:ds-spice-kim2025 a mlips:TrainingDataset ;
    rdfs:label "SPICE version 1 (MACE-OFF training split)" ;
    mlips:coversMaterial entity:mat-pubchem-kim2025 ,
        entity:mat-des-mono-kim2025 ,
        entity:mat-des-dimers-kim2025 ,
        entity:mat-dipeptides-kim2025 ,
        entity:mat-aa-kim2025 ,
        entity:mat-water-kim2025 ,
        entity:mat-qmugs-kim2025 ;
    mlips:coversProperty mlips:Energy ,
