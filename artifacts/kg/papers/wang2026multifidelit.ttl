# Canonical Turtle for the protocol-derived encoding of:
#   Xinwei Wang et al. (2026). Multifidelity Machine Learning Interatomic Potentials for Charged Point Defects.
#   PRX Energy. doi:10.1103/tzwd-cl3y  arXiv:2603.05238v3
#
# Version read: arxiv-preprint arXiv:2603.05238v3 (sha256 0bdd4482024197a5...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 627 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/wang2026multifidelit.yaml.
#
# Encoding scope: four foundation MLIPs evaluated as distributed on
# antimony vacancies (structure RMSDs only); the bespoke MACE model with a
# global charge embedding trained on HSE06 data for VSe(1) in five charge
# states (Table S1); the multi-fidelity two-head (PBE/HSE06) MACE model for
# neutral VSe(1) (Table S5); and the MACE-LES and MACE-POLAR comparison
# models trained on the same split (only MACE-LES without embedding has
# errors in the text). QET models have no registry method and are not
# encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-wang2026multifidelit a mlips:BenchmarkStudy ;
    rdfs:label "Wang, Mosquera-Lois and Walsh (2026): charge-embedded and multi-fidelity MACE potentials for charged point defects in Sb2Se3" ;
    mlips:reportedIn entity:article-wang2026multifidelit .

entity:article-wang2026multifidelit a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/tzwd-cl3y> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Multifidelity Machine Learning Interatomic Potentials for Charged Point Defects" ;
    schema:author <https://orcid.org/0000-0001-5393-1931> ,
        <https://orcid.org/0000-0001-7651-0814> ,
        <https://orcid.org/0000-0001-5460-7033> .

<https://orcid.org/0000-0001-5393-1931> a schema:Person ;
    schema:name "Xinwei Wang" ;
    schema:givenName "Xinwei" ;
    schema:familyName "Wang" ;
    schema:identifier <https://orcid.org/0000-0001-5393-1931> .

<https://orcid.org/0000-0001-7651-0814> a schema:Person ;
    schema:name "Irea Mosquera-Lois" ;
    schema:givenName "Irea" ;
    schema:familyName "Mosquera-Lois" ;
    schema:identifier <https://orcid.org/0000-0001-7651-0814> .

<https://orcid.org/0000-0001-5460-7033> a schema:Person ;
    schema:name "Aron Walsh" ;
    schema:givenName "Aron" ;
    schema:familyName "Walsh" ;
    schema:identifier <https://orcid.org/0000-0001-5460-7033> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-sb2se3-wang2026multifidelit a mlips:MaterialSystem ;
    rdfs:label "Sb2Se3 3x1x1 supercell (59-60 atoms) with Sb and Se vacancies in charge states -3 to +2" ;
    mlips:chemicalFormula "Sb2Se3" ;
    mlips:materialClass "chalcogenide semiconductor (point defects)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-hse06-wang2026multifidelit a mlips:DFTCalculation .

entity:calc-pbe-wang2026multifidelit a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-hse06-wang2026multifidelit mlips:hasDFTSettings entity:calc-settings-hse06-wang2026multifidelit .

entity:calc-settings-hse06-wang2026multifidelit a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:HSE06 ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "350"^^xsd:double ;
    mlips:kPointMesh "Gamma point (joint model); 2x2x2 for the multi-fidelity HF data" ;
    rdfs:comment "D3 dispersion corrections." .

entity:calc-pbe-wang2026multifidelit mlips:hasDFTSettings entity:calc-settings-pbe-wang2026multifidelit .

entity:calc-settings-pbe-wang2026multifidelit a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "350"^^xsd:double ;
    mlips:kPointMesh "2x2x2" ;
    rdfs:comment "D3 dispersion corrections; on the HSE06-relaxed lattice." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-vse-hse-wang2026multifidelit a mlips:TrainingDataset ;
    rdfs:label "HSE06 relaxation trajectories of VSe(1) in charge states -2 to +2 plus 97 pristine bulk structures (80/20 split; short-bond structures training-only)" ;
    mlips:coversMaterial entity:mat-sb2se3-wang2026multifidelit ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-hse06-wang2026multifidelit .

entity:ds-vse0-pbe-wang2026multifidelit a mlips:TrainingDataset ;
    rdfs:label "Low-fidelity PBE data for neutral VSe(1)" ;
    mlips:coversMaterial entity:mat-sb2se3-wang2026multifidelit ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-pbe-wang2026multifidelit .

entity:ds-vse0-hse-wang2026multifidelit a mlips:TrainingDataset ;
    rdfs:label "High-fidelity HSE06 single points for neutral VSe(1)" ;
    mlips:coversMaterial entity:mat-sb2se3-wang2026multifidelit ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-hse06-wang2026multifidelit .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-vse-hse-wang2026multifidelit mlips:samplingStrategy
    entity:sampling-snb-wang2026multifidelit .

entity:ds-vse0-pbe-wang2026multifidelit mlips:samplingStrategy
    entity:sampling-snb-wang2026multifidelit .

entity:ds-vse0-hse-wang2026multifidelit mlips:samplingStrategy
    entity:sampling-hf-sub-wang2026multifidelit .

entity:sampling-snb-wang2026multifidelit a mlips:SamplingStrategy ;
    rdfs:label "ShakeNBreak/doped bond-distorted (0-60%) initial structures with 0.20 A random displacements; full DFT relaxation trajectories, filtered by shortest bond length" .

entity:sampling-hf-sub-wang2026multifidelit a mlips:SamplingStrategy ;
    rdfs:label "About 10% of PBE relaxation frames (always including initial and final) recomputed with HSE06" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasLossFunction entity:loss-MACE-wang2026multifidelit ;
    mlips:hasTrainingAlgorithm entity:alg-MACE-wang2026multifidelit ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:cutoffRadius ,
        mlips:bodyOrder ,
        mlips:learningRate ,
        mlips:batchSize ,
        mlips:numEpochs ;
    mlips:hasImplementation entity:impl-MACE-wang2026multifidelit ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:loss-MACE-wang2026multifidelit a mlips:LossFunction ;
    rdfs:label "Huber loss; energy:force:stress weights 1:100:10, then 1000:10:10 after SWA" .

entity:alg-MACE-wang2026multifidelit a mls:Algorithm ;
    rdfs:label "ScaleShiftMACE with ZBL repulsion, L=3; global charge state as a learnable 64-dimensional embedding added to species embeddings and read out directly; multi-fidelity model uses two output heads (PBE, HSE06)" .

entity:impl-MACE-wang2026multifidelit a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

entity:GRACE a mlips:MLIPMethod ;
    rdfs:label "Graph Atomic Cluster Expansion (GRACE)" ;
    mlips:hasFunctionalForm entity:ff-GRACE ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:ff-GRACE a mlips:FunctionalForm ;
    rdfs:label "Graph extension of the atomic cluster expansion with star- and tree-like many-body basis functions; one-layer models use star-graph ACE basis functions, two-layer models add semi-local interactions through equivariant message passing; atomic energies are summed to the total energy" .

entity:M3GNet a mlips:MLIPMethod ;
    rdfs:label "M3GNet: materials graph network with three-body interactions" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:MACE-LES a mlips:MLIPMethod ;
    rdfs:label "MACE with latent Ewald summation (MACE-LES)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

entity:MACE-POLAR a mlips:MLIPMethod ;
    rdfs:label "MACE-POLAR (polarizable MACE with an explicit long-range electrostatic term conditioned on total charge and spin multiplicity)" ;
    mlips:supportsSimulation mlips:GeometryOptimization .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-joint-numLayers-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-joint-numFeatures-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-joint-cutoffRadius-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-joint-bodyOrder-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-joint-learningRate-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.005"^^xsd:double .

entity:setting-joint-batchSize-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-joint-numEpochs-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "150"^^xsd:integer .

entity:setting-mf-numLayers-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-mf-numFeatures-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "128"^^xsd:integer .

entity:setting-mf-cutoffRadius-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.5"^^xsd:double .

entity:setting-mf-bodyOrder-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:bodyOrder ;
    mlips:settingValue "3"^^xsd:integer .

entity:setting-mf-learningRate-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.005"^^xsd:double .

entity:setting-mf-batchSize-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-mf-numEpochs-wang2026multifidelit a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numEpochs ;
    mlips:settingValue "120"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mace-mh-1-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "MACE-MH-1 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mh-1-wang2026multifidelit .

entity:model-mace-mh-1-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "MACE-MH-1" .

entity:run-mace-mpa-0-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "MACE-MPA-0 as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mace-mpa-0-wang2026multifidelit .

entity:model-mace-mpa-0-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "MACE-MPA-0" .

entity:run-grace-2l-omat-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "GRACE-2L-OMAT as distributed" ;
    mlips:appliesMethod entity:GRACE ;
    mlips:produces entity:model-grace-2l-omat-wang2026multifidelit .

entity:model-grace-2l-omat-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "GRACE-2L-OMAT" .

entity:run-joint-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "Bespoke MACE with global charge embedding (VSe(1), five charge states, HSE06)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-vse-hse-wang2026multifidelit ;
    mlips:hasHyperparameterSetting entity:setting-joint-numLayers-wang2026multifidelit ,
        entity:setting-joint-numFeatures-wang2026multifidelit ,
        entity:setting-joint-cutoffRadius-wang2026multifidelit ,
        entity:setting-joint-bodyOrder-wang2026multifidelit ,
        entity:setting-joint-learningRate-wang2026multifidelit ,
        entity:setting-joint-batchSize-wang2026multifidelit ,
        entity:setting-joint-numEpochs-wang2026multifidelit ;
    mlips:produces entity:model-joint-wang2026multifidelit .

entity:model-joint-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "Charge-embedded MACE VSe(1)" .

entity:run-mf-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "Multi-fidelity two-head MACE (PBE and HSE06 heads) for neutral VSe(1)" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-vse0-hse-wang2026multifidelit ;
    mlips:hasHyperparameterSetting entity:setting-mf-numLayers-wang2026multifidelit ,
        entity:setting-mf-numFeatures-wang2026multifidelit ,
        entity:setting-mf-cutoffRadius-wang2026multifidelit ,
        entity:setting-mf-bodyOrder-wang2026multifidelit ,
        entity:setting-mf-learningRate-wang2026multifidelit ,
        entity:setting-mf-batchSize-wang2026multifidelit ,
        entity:setting-mf-numEpochs-wang2026multifidelit ;
    mlips:produces entity:model-mf-wang2026multifidelit .

entity:model-mf-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "Multi-fidelity MACE VSe(1) q=0" .

entity:run-les-noemb-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "MACE-LES without global charge embedding, same data and settings as the joint model" ;
    mlips:appliesMethod entity:MACE-LES ;
    mlips:runsOn entity:ds-vse-hse-wang2026multifidelit ;
    mlips:produces entity:model-les-noemb-wang2026multifidelit .

entity:model-les-noemb-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "MACE-LES (no charge embedding) VSe(1)" .

entity:run-les-emb-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "MACE-LES with global charge embedding" ;
    mlips:appliesMethod entity:MACE-LES ;
    mlips:runsOn entity:ds-vse-hse-wang2026multifidelit ;
    mlips:produces entity:model-les-emb-wang2026multifidelit .

entity:model-les-emb-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "MACE-LES (charge embedding) VSe(1)" .

entity:run-polar-noemb-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "MACE-POLAR without global charge embedding" ;
    mlips:appliesMethod entity:MACE-POLAR ;
    mlips:runsOn entity:ds-vse-hse-wang2026multifidelit ;
    mlips:produces entity:model-polar-noemb-wang2026multifidelit .

entity:model-polar-noemb-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "MACE-POLAR (no charge embedding) VSe(1)" .

entity:run-polar-emb-wang2026multifidelit a mlips:MLIPRun ;
    rdfs:label "MACE-POLAR with global charge embedding" ;
    mlips:appliesMethod entity:MACE-POLAR ;
    mlips:runsOn entity:ds-vse-hse-wang2026multifidelit ;
    mlips:produces entity:model-polar-emb-wang2026multifidelit .

entity:model-polar-emb-wang2026multifidelit a mlips:TrainedModel ;
    rdfs:label "MACE-POLAR (charge embedding) VSe(1)" .

# Registry stub for the externally trained model MatterSim-v1 (not trained in this paper).
entity:run-MatterSim-v1 a mlips:MLIPRun ;
    rdfs:label "Training run of MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" ;
    mlips:appliesMethod entity:M3GNet ;
    mlips:produces entity:model-MatterSim-v1 .

entity:model-MatterSim-v1 a mlips:TrainedModel ;
    rdfs:label "MatterSim-v1 (4.5M parameters, M3GNet architecture, about 6M training structures)" .

