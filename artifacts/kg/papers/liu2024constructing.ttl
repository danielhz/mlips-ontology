# Canonical Turtle for the protocol-derived encoding of:
#   Junlan Liu et al. (2024). Constructing accurate machine-learned potentials and performing highly efficient atomistic simulations to predict structural and thermal properties.
#   arXiv (Cornell University). doi:10.48550/arxiv.2411.10911  arXiv:2411.10911v1
#
# Version read: arxiv-preprint arXiv:2411.10911v1 (sha256 0ea1ebe01f632683...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 488 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/liu2024constructing.yaml.
#
# Encoding scope: an MTP trained on 354 actively learned Cu7PS6
# configurations (PBEsol) and a NEP for the same system, with their
# training and validation RMSEs (Figs. 1-2, text). RDFs and phonon DOS
# are properties; the speed comparison (Fig. 5) is figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liu2024constructing a mlips:BenchmarkStudy ;
    rdfs:label "Liu et al. (2024): MTP and NEP potentials for the argyrodite superionic conductor Cu7PS6, with RDF, phonon DOS and speed comparisons" ;
    mlips:reportedIn entity:article-liu2024constructing .

entity:article-liu2024constructing a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2411.10911> ;
    schema:datePublished "2024"^^xsd:gYear ;
    schema:name "Constructing accurate machine-learned potentials and performing highly efficient atomistic simulations to predict structural and thermal properties" ;
    schema:author entity:person-Liu-liu2024constructing ,
        entity:person-Yin-liu2024constructing ,
        entity:person-He-liu2024constructing ,
        entity:person-Zhou-liu2024constructing .

entity:person-Liu-liu2024constructing a schema:Person ;
    schema:name "Junlan Liu" ;
    schema:givenName "Junlan" ;
    schema:familyName "Liu" .

entity:person-Yin-liu2024constructing a schema:Person ;
    schema:name "Qian Yin" ;
    schema:givenName "Qian" ;
    schema:familyName "Yin" .

entity:person-He-liu2024constructing a schema:Person ;
    schema:name "Mengshu He" ;
    schema:givenName "Mengshu" ;
    schema:familyName "He" .

entity:person-Zhou-liu2024constructing a schema:Person ;
    schema:name "Jun Zhou" ;
    schema:givenName "Jun" ;
    schema:familyName "Zhou" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-cu7ps6-liu2024constructing a mlips:MaterialSystem ;
    rdfs:label "Cu7PS6 argyrodite superionic conductor (cubic phase)" ;
    mlips:chemicalFormula "Cu7PS6" ;
    mlips:materialClass "Inorganic ionic conductors" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbesol-liu2024constructing a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbesol-liu2024constructing mlips:hasDFTSettings entity:calc-settings-pbesol-liu2024constructing .

entity:calc-settings-pbesol-liu2024constructing a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional entity:xc-PBEsol-liu2024constructing ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "500"^^xsd:double ;
    mlips:kPointMesh "3x3x3 for the training labels" .

entity:xc-PBEsol-liu2024constructing a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-cu7ps6-liu2024constructing a mlips:TrainingDataset ;
    rdfs:label "Cu7PS6 training configurations (354 after active learning; 10% held out for validation)" ;
    mlips:coversMaterial entity:mat-cu7ps6-liu2024constructing ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ,
        mlips:Stresses ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 354 ;
    mlips:hasDFTCalculation entity:calc-pbesol-liu2024constructing .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-cu7ps6-liu2024constructing mlips:samplingStrategy
    entity:sampling-al-liu2024constructing .

entity:sampling-al-liu2024constructing a mlips:SamplingStrategy ;
    rdfs:label "300 AIMD snapshots of a 448-atom supercell up to 700 K, extended by MTP active learning in LAMMPS at 300, 500 and 700 K (gamma_select 3, gamma_break 10)" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasDescriptor mlips:MomentTensorDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-MTP-liu2024constructing ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-MTP-liu2024constructing a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP .

entity:NEP a mlips:MLIPMethod ;
    rdfs:label "Neuroevolution Potential (NEP)" ;
    mlips:hasLossFunction entity:loss-NEP-liu2024constructing ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ;
    mlips:hasImplementation entity:impl-NEP-liu2024constructing ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:loss-NEP-liu2024constructing a mlips:LossFunction ;
    rdfs:label "Energy, force and stress weights 1, 0.01, 0.001" .

entity:impl-NEP-liu2024constructing a mlips:Implementation ;
    mlips:implementedIn entity:lib-GPUMD-liu2024constructing .

entity:lib-GPUMD-liu2024constructing a mlips:Library ;
    rdfs:label "GPUMD" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-mtp-cutoffRadius-liu2024constructing a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-nep-cutoffRadius-liu2024constructing a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "7"^^xsd:double .

entity:setting-nep-angularCutoff-liu2024constructing a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "5"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-mtp-liu2024constructing a mlips:MLIPRun ;
    rdfs:label "MTP for Cu7PS6" ;
    mlips:appliesMethod entity:MTP ;
    mlips:runsOn entity:ds-cu7ps6-liu2024constructing ;
    mlips:hasHyperparameterSetting entity:setting-mtp-cutoffRadius-liu2024constructing ;
    mlips:produces entity:model-mtp-liu2024constructing .

entity:model-mtp-liu2024constructing a mlips:TrainedModel ;
    rdfs:label "MTP Cu7PS6" .

entity:run-nep-liu2024constructing a mlips:MLIPRun ;
    rdfs:label "NEP for Cu7PS6" ;
    mlips:appliesMethod entity:NEP ;
    mlips:runsOn entity:ds-cu7ps6-liu2024constructing ;
    mlips:hasHyperparameterSetting entity:setting-nep-cutoffRadius-liu2024constructing ,
        entity:setting-nep-angularCutoff-liu2024constructing ;
    mlips:produces entity:model-nep-liu2024constructing .

entity:model-nep-liu2024constructing a mlips:TrainedModel ;
    rdfs:label "NEP Cu7PS6" .

