@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-mccandler2024 a mlips:BenchmarkStudy ;
    rdfs:label "McCandler et al. (2024): gold-thiolate nanocluster dynamics enabled by an ACE potential" ;
    mlips:reportedIn entity:article-mccandler2024 .

entity:article-mccandler2024 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1021/acsnano.4c03094> ;
