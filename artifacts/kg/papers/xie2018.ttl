    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.039"^^xsd:double .

entity:result-cgcnn-ef-eq4-xie2018 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-cgcnn-ef-eq4-xie2018 ;
    mlips:targetMaterial entity:mat-mp-xie2018 ;
    mlips:hasAccuracyMetric entity:metric-cgcnn-ef-eq4-1-xie2018 .

entity:metric-cgcnn-ef-eq4-1-xie2018 a mlips:AccuracyMetric ;
    rdfs:label "Best test MAE of formation energy per atom (eV/atom): CGCNN, Eq. 4 convolution" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.136"^^xsd:double .

entity:result-cgcnn-eabs-xie2018 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-cgcnn-eabs-xie2018 ;
    mlips:targetMaterial entity:mat-mp-xie2018 ;
    mlips:hasAccuracyMetric entity:metric-cgcnn-eabs-1-xie2018 .

entity:metric-cgcnn-eabs-1-xie2018 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE of absolute energy per atom (eV/atom): CGCNN" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.072"^^xsd:double .

entity:result-cgcnn-pv-xie2018 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-cgcnn-pv-xie2018 ;
    mlips:targetMaterial entity:mat-perovskites-xie2018 ;
    mlips:hasAccuracyMetric entity:metric-cgcnn-pv-1-xie2018 .

entity:metric-cgcnn-pv-1-xie2018 a mlips:AccuracyMetric ;
    rdfs:label "Test MAE of energy above hull per atom (eV/atom): CGCNN with linear pooling" ;
