# Canonical Turtle for the protocol-derived encoding of:
#   Tian Xie et al. (2018). Crystal Graph Convolutional Neural Networks for an Accurate and Interpretable Prediction of Material Properties.
#   Physical Review Letters. doi:10.1103/physrevlett.120.145301  arXiv:1710.10324v3
#
# Version read: arxiv-preprint arXiv:1710.10324v3 (sha256 e9b5693d1a5b4daa...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 207 (Method/model). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/xie2018.yaml.
#
# Encoding scope: CGCNN (introduced here) trained on Materials Project
# data, with the energy-valued test errors only: formation energy per atom
# with the two convolution functions (Eqs. 4, 5), absolute energy per atom
# (Table I) and the perovskite energy above hull (Fig. 3). Band gap, Fermi
# energy, elastic moduli, Poisson ratio and the metal/semiconductor
# classification are not energies or forces and are not encoded.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-xie2018 a mlips:BenchmarkStudy ;
    rdfs:label "Xie and Grossman (2018): crystal graph convolutional neural networks (CGCNN) for material properties" ;
    mlips:reportedIn entity:article-xie2018 .

entity:article-xie2018 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/physrevlett.120.145301> ;
    schema:datePublished "2018"^^xsd:gYear ;
    schema:name "Crystal Graph Convolutional Neural Networks for an Accurate and Interpretable Prediction of Material Properties" ;
    schema:author entity:person-Xie-xie2018 ,
        entity:person-Grossman-xie2018 .

entity:person-Xie-xie2018 a schema:Person ;
    schema:name "Tian Xie" ;
    schema:givenName "Tian" ;
    schema:familyName "Xie" .

entity:person-Grossman-xie2018 a schema:Person ;
    schema:name "Jeffrey C. Grossman" ;
    schema:givenName "Jeffrey C." ;
    schema:familyName "Grossman" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-mp-xie2018 a mlips:MaterialSystem ;
    rdfs:label "Inorganic crystals of the Materials Project (87 elements, 7 lattice systems, 216 space groups)" ;
    mlips:materialClass "Inorganic crystalline materials" .

entity:mat-perovskites-xie2018 a mlips:MaterialSystem ;
    rdfs:label "ABX3 perovskite crystals (X = O, N, S, F)" ;
    mlips:materialClass "Perovskite oxides, nitrides, sulfides and fluorides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

# No reference calculation is described by the paper (see Q12).

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-mp-xie2018 a mlips:TrainingDataset ;
    rdfs:label "Materials Project crystals with DFT properties (46,744 materials; 60% for training)" ;
    mlips:coversMaterial entity:mat-mp-xie2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 28046 ;
    rdfs:comment "46,744 materials after removing ill-converged crystals; 60% training, 20% validation, 20% test (9,350 crystals)." .

entity:ds-perovskites-xie2018 a mlips:TrainingDataset ;
    rdfs:label "Perovskite energy-above-hull data set (18,928 crystals)" ;
    mlips:coversMaterial entity:mat-perovskites-xie2018 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 18928 ;
    rdfs:comment "Database of Ref. [26]; 3,787 test perovskites." .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:CGCNN a mlips:MLIPMethod ;
    rdfs:label "Crystal Graph Convolutional Neural Network (CGCNN)" ;
    mlips:hasLossFunction entity:loss-CGCNN-xie2018 ;
    mlips:hasTrainingAlgorithm entity:alg-CGCNN-xie2018 ;
    mlips:hasHyperparameter mlips:numLayers .

entity:loss-CGCNN-xie2018 a mlips:LossFunction ;
    rdfs:label "Cost function J between predicted and DFT property (MAE-type regression; cross entropy for classification)" .

entity:alg-CGCNN-xie2018 a mls:Algorithm ;
    rdfs:label "Stochastic gradient descent with backpropagation" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

# No hyperparameter value is stated by the paper (see Q12).

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-cgcnn-ef-eq5-xie2018 a mlips:MLIPRun ;
    rdfs:label "CGCNN with the gated convolution (Eq. 5) trained on formation energy per atom" ;
    mlips:appliesMethod entity:CGCNN ;
    mlips:runsOn entity:ds-mp-xie2018 ;
    mlips:produces entity:model-cgcnn-ef-eq5-xie2018 .

entity:model-cgcnn-ef-eq5-xie2018 a mlips:TrainedModel ;
    rdfs:label "CGCNN formation-energy model (Eq. 5 convolution)" .

entity:run-cgcnn-ef-eq4-xie2018 a mlips:MLIPRun ;
    rdfs:label "CGCNN with the simple convolution (Eq. 4) trained on formation energy per atom" ;
    mlips:appliesMethod entity:CGCNN ;
    mlips:runsOn entity:ds-mp-xie2018 ;
    mlips:produces entity:model-cgcnn-ef-eq4-xie2018 .

entity:model-cgcnn-ef-eq4-xie2018 a mlips:TrainedModel ;
    rdfs:label "CGCNN formation-energy model (Eq. 4 convolution)" .

entity:run-cgcnn-eabs-xie2018 a mlips:MLIPRun ;
    rdfs:label "CGCNN trained on absolute energy per atom" ;
    mlips:appliesMethod entity:CGCNN ;
    mlips:runsOn entity:ds-mp-xie2018 ;
    mlips:produces entity:model-cgcnn-eabs-xie2018 .

entity:model-cgcnn-eabs-xie2018 a mlips:TrainedModel ;
    rdfs:label "CGCNN absolute-energy model" .

entity:run-cgcnn-pv-xie2018 a mlips:MLIPRun ;
    rdfs:label "CGCNN with linear pooling trained on perovskite total energy above hull" ;
    mlips:appliesMethod entity:CGCNN ;
    mlips:runsOn entity:ds-perovskites-xie2018 ;
    mlips:produces entity:model-cgcnn-pv-xie2018 .

entity:model-cgcnn-pv-xie2018 a mlips:TrainedModel ;
    rdfs:label "CGCNN perovskite energy-above-hull model (linear pooling, Eq. 4)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-xie2018 mlips:hasResult
    entity:result-cgcnn-ef-eq5-xie2018 ,
    entity:result-cgcnn-ef-eq4-xie2018 ,
    entity:result-cgcnn-eabs-xie2018 ,
