    mlips:targetMaterial entity:mat-mp-xie2018 ;
    mlips:hasAccuracyMetric entity:metric-cgcnn-ef-eq5-1-xie2018 .

entity:metric-cgcnn-ef-eq5-1-xie2018 a mlips:AccuracyMetric ;
