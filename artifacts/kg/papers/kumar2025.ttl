# Canonical Turtle for the protocol-derived encoding of:
#   Kumar, Körmann, Grabowski, Ikeda. Machine Learning Potentials for
#   Hydrogen Absorption in TiCr2 Laves Phases. Acta Materialia 297,
#   121319 (2025). doi:10.1016/j.actamat.2025.121319
#
# This file is the gold standard for the round-trip check: the union
# of the 11 CONSTRUCT queries against this file must reproduce it.
#
# Encoding scope: both the C15 (cubic) and C14 (hexagonal) phase
# artefacts. Kumar et al. train a separate MTP per phase; both
# chains -- training dataset, MLIPRun, TrainedModel, BenchmarkResult,
# and energy/force RMSE -- live in this single file. The C15 chain
# uses the historical IRI prefix (ex:mat-TiCr2, ex:ds-TiCr2H-c15,
# ...); the C14 chain uses the parallel pattern with a -c14 suffix
# (ex:mat-TiCr2-c14, ex:ds-TiCr2H-c14, ...). The structured-phase
# concept (mlips:CrystalMaterial with hasSpaceGroupNumber) is
# deferred to SWJ-04; this encoding keeps the existing
# materialClass-as-string convention.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix mlips:  <https://w3id.org/mlips#> .
@prefix ex:     <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

ex:study-kumar2025 a mlips:BenchmarkStudy ;
    rdfs:label "Kumar et al. (2025): MTP for TiCr2-H Laves phases" ;
    mlips:reportedIn ex:article-kumar2025 .

ex:article-kumar2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1016/j.actamat.2025.121319> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Machine Learning Potentials for Hydrogen Absorption in TiCr2 Laves Phases" ;
    schema:author
        <https://orcid.org/0000-0002-3661-5870> ,
        <https://orcid.org/0000-0003-3050-6291> ,
        <https://orcid.org/0000-0003-4281-5665> ,
        <https://orcid.org/0000-0001-9176-3270> .

<https://orcid.org/0000-0002-3661-5870> a schema:Person ;
    schema:name "Pranav Kumar" ;
    schema:givenName "Pranav" ;
    schema:familyName "Kumar" ;
    schema:identifier <https://orcid.org/0000-0002-3661-5870> .

<https://orcid.org/0000-0003-3050-6291> a schema:Person ;
    schema:name "Fritz Körmann" ;
    schema:givenName "Fritz" ;
    schema:familyName "Körmann" ;
    schema:identifier <https://orcid.org/0000-0003-3050-6291> .

<https://orcid.org/0000-0003-4281-5665> a schema:Person ;
    schema:name "Blazej Grabowski" ;
    schema:givenName "Blazej" ;
    schema:familyName "Grabowski" ;
    schema:identifier <https://orcid.org/0000-0003-4281-5665> .

<https://orcid.org/0000-0001-9176-3270> a schema:Person ;
    schema:name "Yuji Ikeda" ;
    schema:givenName "Yuji" ;
    schema:familyName "Ikeda" ;
    schema:identifier <https://orcid.org/0000-0001-9176-3270> .
###############################################################################
# Q2 -- Material system
###############################################################################

ex:mat-TiCr2 a mlips:MaterialSystem ;
    rdfs:label "TiCr2 (C15 Laves phase)" ;
    mlips:chemicalFormula "TiCr2" ;
    mlips:materialClass "Laves phase, C15 cubic (Fd-3m)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q15724720> .

ex:mat-TiCr2-c14 a mlips:MaterialSystem ;
    rdfs:label "TiCr2 (C14 Laves phase)" ;
    mlips:chemicalFormula "TiCr2" ;
    mlips:materialClass "Laves phase, C14 hexagonal (P63/mmc)" ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q15724720> .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

ex:dft-TiCr2H-c15 a mlips:DFTCalculation .
ex:dft-TiCr2H-c14 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

ex:dft-TiCr2H-c15 mlips:hasDFTSettings ex:dft-settings-TiCr2H-c15 .

ex:dft-settings-TiCr2H-c15 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "4x4x4 Gamma-centred" .

ex:dft-TiCr2H-c14 mlips:hasDFTSettings ex:dft-settings-TiCr2H-c14 .

ex:dft-settings-TiCr2H-c14 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:VASP ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "400"^^xsd:double ;
    mlips:kPointMesh "4x4x4 Gamma-centred (2x2x1 supercell)" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

ex:ds-TiCr2H-c15 a mlips:TrainingDataset ;
    rdfs:label "TiCr2-Hx training set, C15 phase, step 1" ;
    mlips:coversMaterial ex:mat-TiCr2 ;
    mlips:coversProperty mlips:Energy , mlips:Forces , mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1019 ;
    mlips:hasDFTCalculation ex:dft-TiCr2H-c15 .

ex:ds-TiCr2H-c14 a mlips:TrainingDataset ;
    rdfs:label "TiCr2-Hx training set, C14 phase, step 1" ;
    mlips:coversMaterial ex:mat-TiCr2-c14 ;
    mlips:coversProperty mlips:Energy , mlips:Forces , mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 3766 ;
    mlips:hasDFTCalculation ex:dft-TiCr2H-c14 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

ex:ds-TiCr2H-c15 mlips:samplingStrategy
    ex:chem-sampling , ex:vib-sampling , ex:active-learning-sampling .

ex:ds-TiCr2H-c14 mlips:samplingStrategy
    ex:chem-sampling , ex:vib-sampling , ex:active-learning-sampling .

ex:chem-sampling a mlips:SamplingStrategy ;
    rdfs:label "Chemical sampling" ;
    rdfs:comment "Configurations across hydrogen concentrations 0 < x <= 6." .

ex:vib-sampling a mlips:SamplingStrategy ;
    rdfs:label "Vibrational sampling (DFT MD)" ;
    rdfs:comment "Snapshots from ab initio molecular dynamics at 500 K." .

ex:active-learning-sampling a mlips:SamplingStrategy ;
    rdfs:label "Active learning" ;
    rdfs:comment "Extrapolation-grade filtering with threshold gamma >~ 1." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

ex:MTP a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasFunctionalForm ex:mtp-functional-form ;
    mlips:hasLossFunction ex:mtp-loss-w1-001-0001 ;
    mlips:hasTrainingAlgorithm ex:bfgs ;
    mlips:hasHyperparameter mlips:cutoffRadius , mlips:minInteratomicDistance , ex:hp-nq , mlips:momentLevel ;
    mlips:hasImplementation ex:mlip-package-v2 .

ex:mtp-functional-form a mlips:FunctionalForm ;
    rdfs:label "MTP moment-tensor polynomial" .

ex:mtp-loss-w1-001-0001 a mlips:LossFunction ;
    rdfs:label "Weighted MSE (energy 1, force 0.01, stress*V 0.001)" .

ex:bfgs a mls:Algorithm ;
    rdfs:label "BFGS" .

ex:mlip-package-v2 a mlips:Implementation ;
    mlips:implementedIn mlips:MLIP ;
    mlips:version "2" .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

ex:setting-levmax-16 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:momentLevel ;
    mlips:settingValue "16"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model
###############################################################################

ex:run-mtp-TiCr2H-c15 a mlips:MLIPRun ;
    rdfs:label "MTP training run, C15 phase" ;
    mlips:appliesMethod ex:MTP ;
    mlips:runsOn ex:ds-TiCr2H-c15 ;
    mlips:hasHyperparameterSetting ex:setting-levmax-16 ;
    mlips:produces ex:model-mtp-TiCr2H-c15 .

ex:model-mtp-TiCr2H-c15 a mlips:TrainedModel ;
    rdfs:label "C15-MTP for TiCr2-H" .

ex:run-mtp-TiCr2H-c14 a mlips:MLIPRun ;
    rdfs:label "MTP training run, C14 phase" ;
    mlips:appliesMethod ex:MTP ;
    mlips:runsOn ex:ds-TiCr2H-c14 ;
    mlips:hasHyperparameterSetting ex:setting-levmax-16 ;
    mlips:produces ex:model-mtp-TiCr2H-c14 .

ex:model-mtp-TiCr2H-c14 a mlips:TrainedModel ;
    rdfs:label "C14-MTP for TiCr2-H" .

###############################################################################
# Q10 -- Benchmark results
###############################################################################

ex:study-kumar2025 mlips:hasResult ex:result-mtp-ticr2h-c15 , ex:result-mtp-ticr2h-c14 .

ex:result-mtp-ticr2h-c15 a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TiCr2H-c15 ;
    mlips:targetMaterial ex:mat-TiCr2 ;
    mlips:hasAccuracyMetric ex:metric-rmse-energy-c15 , ex:metric-rmse-forces-c15 .

ex:metric-rmse-energy-c15 a mlips:AccuracyMetric ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue 3.17 ;
    mlips:hasUnit unit:MeV-PER-ATOM .

ex:metric-rmse-forces-c15 a mlips:AccuracyMetric ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue 0.134 ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

ex:result-mtp-ticr2h-c14 a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TiCr2H-c14 ;
    mlips:targetMaterial ex:mat-TiCr2-c14 ;
    mlips:hasAccuracyMetric ex:metric-rmse-energy-c14 , ex:metric-rmse-forces-c14 .

ex:metric-rmse-energy-c14 a mlips:AccuracyMetric ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue 2.81 ;
    mlips:hasUnit unit:MeV-PER-ATOM .

ex:metric-rmse-forces-c14 a mlips:AccuracyMetric ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue 0.1 ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

# NB: the metricValue is reported as 0.100 eV/Angstrom in Kumar 2025
# Fig. 7d (3 sig figs). We write the bare-decimal `0.1` here because
# oxigraph normalises trailing zeros while rapper does not, breaking
# the bit-exact round-trip. issue-0015 will re-type all numeric
# literals as xsd:double, which is more idiomatic and decouples
# precision-display from the round-trip canonical form.

###############################################################################
# Q11 -- Computational resources
###############################################################################

# Kumar et al. (2025) reports no training-cost or inference-cost
# metadata. This is recorded as a gap in Q12 of the subsection.

# Paper-local hyperparameters tagged for the candidate-vocabulary
# audit (issue-0007). These appear in only this paper or are family-specific;
# a future curator may promote them into mlips-vocab.ttl when a
# second paper uses the same parameter.

ex:hp-nq a mlips:Hyperparameter ;
    rdfs:label "MTP quadrature node count" ;
    mlips:hyperparameterName "n_q" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

# schema:affiliation links added by issue-0005 sweep.
<https://orcid.org/0000-0002-3661-5870> schema:affiliation mlips:UniversityofStuttgart .
<https://orcid.org/0000-0003-3050-6291> schema:affiliation mlips:UniversityofStuttgart .
<https://orcid.org/0000-0003-3050-6291> schema:affiliation mlips:RuhrUniversityBochum .
<https://orcid.org/0000-0003-4281-5665> schema:affiliation mlips:UniversityofStuttgart .
<https://orcid.org/0000-0001-9176-3270> schema:affiliation mlips:UniversityofStuttgart .
