entity:run-sog-PA-ji2025 a mlips:MLIPRun ;
    rdfs:label "SOG-Net trained on polar-apolar dimers" ;
    mlips:appliesMethod entity:SOG-Net ;
    mlips:runsOn entity:ds-dimer-PA-ji2025 ;
