###############################################################################
# Q9 -- MLIP run + trained model (Q11 compute-cost properties inline)
###############################################################################

entity:run-sog-CC-ji2025 a mlips:MLIPRun ;
    rdfs:label "SOG-Net trained on charged-charged dimers" ;
    mlips:appliesMethod entity:SOG-Net ;
    mlips:runsOn entity:ds-dimer-CC-ji2025 ;
    mlips:hasHyperparameterSetting entity:setting-sog-CC-cutoffRadius-ji2025 ,
        entity:setting-sog-CC-num-gaussians-ji2025 ,
        entity:setting-sog-CC-latent-layers-ji2025 ,
        entity:setting-sog-CC-fourier-grid-ji2025 ,
        entity:setting-sog-CC-learningRate-ji2025 ;
    mlips:produces entity:model-sog-CC-ji2025 .

entity:model-sog-CC-ji2025 a mlips:TrainedModel ;
    rdfs:label "SOG-Net model for CC dimers" .

entity:run-sog-CP-ji2025 a mlips:MLIPRun ;
    rdfs:label "SOG-Net trained on charged-polar dimers" ;
    mlips:appliesMethod entity:SOG-Net ;
    mlips:runsOn entity:ds-dimer-CP-ji2025 ;
    mlips:hasHyperparameterSetting entity:setting-sog-CP-cutoffRadius-ji2025 ,
        entity:setting-sog-CP-num-gaussians-ji2025 ,
        entity:setting-sog-CP-latent-layers-ji2025 ,
        entity:setting-sog-CP-fourier-grid-ji2025 ,
        entity:setting-sog-CP-learningRate-ji2025 ;
    mlips:produces entity:model-sog-CP-ji2025 .

entity:model-sog-CP-ji2025 a mlips:TrainedModel ;
    rdfs:label "SOG-Net model for CP dimers" .

entity:run-sog-PP-ji2025 a mlips:MLIPRun ;
    rdfs:label "SOG-Net trained on polar-polar dimers" ;
    mlips:appliesMethod entity:SOG-Net ;
    mlips:runsOn entity:ds-dimer-PP-ji2025 ;
    mlips:hasHyperparameterSetting entity:setting-sog-PP-cutoffRadius-ji2025 ,
        entity:setting-sog-PP-num-gaussians-ji2025 ,
        entity:setting-sog-PP-latent-layers-ji2025 ,
        entity:setting-sog-PP-fourier-grid-ji2025 ,
        entity:setting-sog-PP-learningRate-ji2025 ;
    mlips:produces entity:model-sog-PP-ji2025 .

entity:model-sog-PP-ji2025 a mlips:TrainedModel ;
    rdfs:label "SOG-Net model for PP dimers" .

entity:run-sog-CA-ji2025 a mlips:MLIPRun ;
    rdfs:label "SOG-Net trained on charged-apolar dimers" ;
    mlips:appliesMethod entity:SOG-Net ;
    mlips:runsOn entity:ds-dimer-CA-ji2025 ;
