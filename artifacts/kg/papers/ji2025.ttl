# Canonical Turtle for the protocol-derived encoding of:
#   Y.-P. Ji et al. (2025). Machine-Learning Interatomic Potentials for Long-Range Systems.
#   Physical Review Letters. doi:10.1103/ssp9-7s81  arXiv:2502.04668v3
#
# Version read: arxiv-preprint arXiv:2502.04668v3 (sha256 cd99f043352358f2...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 83 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
#
# Encoding scope: the SOG-Net method (introduced here) and the six
# molecular-dimer fits whose force RMSEs the main text prints (dimer
# classes CC, CP, PP, CA, PA, AA from the BioFragment Database). The toy
# NaCl electrolyte, molten NaCl, the charged-system benchmarks of
# Table I, the dipeptide and the water tests are described in the gaps.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-ji2025 a mlips:BenchmarkStudy ;
    rdfs:label "Ji et al. (2025): machine-learning interatomic potentials for long-range systems (SOG-Net)" ;
    mlips:reportedIn entity:article-ji2025 .

entity:article-ji2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1103/ssp9-7s81> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Machine-Learning Interatomic Potentials for Long-Range Systems" ;
    schema:author <https://orcid.org/0009-0000-6789-4385> ,
        <https://orcid.org/0000-0003-0247-4149> ,
        <https://orcid.org/0000-0001-7645-4998> .

<https://orcid.org/0009-0000-6789-4385> a schema:Person ;
    schema:name "Yajie Ji" ;
    schema:givenName "Yajie" ;
    schema:familyName "Ji" ;
    schema:identifier <https://orcid.org/0009-0000-6789-4385> .

<https://orcid.org/0000-0003-0247-4149> a schema:Person ;
    schema:name "Jiuyang Liang" ;
    schema:givenName "Jiuyang" ;
    schema:familyName "Liang" ;
    schema:identifier <https://orcid.org/0000-0003-0247-4149> .

<https://orcid.org/0000-0001-7645-4998> a schema:Person ;
    schema:name "Zhenli Xu" ;
    schema:givenName "Zhenli" ;
    schema:familyName "Xu" ;
    schema:identifier <https://orcid.org/0000-0001-7645-4998> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-dimer-CC-ji2025 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers, charged-charged (CC) class, separations of about 5 to 15 A" ;
    mlips:materialClass "Molecular dimers of relaxed charged, polar or apolar molecules in a 30 A periodic box" .

entity:mat-dimer-CP-ji2025 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers, charged-polar (CP) class, separations of about 5 to 15 A" ;
    mlips:materialClass "Molecular dimers of relaxed charged, polar or apolar molecules in a 30 A periodic box" .

entity:mat-dimer-PP-ji2025 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers, polar-polar (PP) class, separations of about 5 to 15 A" ;
    mlips:materialClass "Molecular dimers of relaxed charged, polar or apolar molecules in a 30 A periodic box" .

entity:mat-dimer-CA-ji2025 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers, charged-apolar (CA) class, separations of about 5 to 15 A" ;
    mlips:materialClass "Molecular dimers of relaxed charged, polar or apolar molecules in a 30 A periodic box" .

entity:mat-dimer-PA-ji2025 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers, polar-apolar (PA) class, separations of about 5 to 15 A" ;
    mlips:materialClass "Molecular dimers of relaxed charged, polar or apolar molecules in a 30 A periodic box" .

entity:mat-dimer-AA-ji2025 a mlips:MaterialSystem ;
    rdfs:label "Molecular dimers, apolar-apolar (AA) class, separations of about 5 to 15 A" ;
    mlips:materialClass "Molecular dimers of relaxed charged, polar or apolar molecules in a 30 A periodic box" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-dft-ji2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-dft-ji2025 mlips:hasDFTSettings entity:calc-settings-dft-ji2025 .

entity:calc-settings-dft-ji2025 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:HSE06 ;
    rdfs:comment "BioFragment Database data computed with the HSE06 hybrid functional (the paper: 'with a high fraction of exact exchange'); code and basis are not restated." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-dimer-CC-ji2025 a mlips:TrainingDataset ;
    rdfs:label "BioFragment dimer data, charged-charged class" ;
    mlips:coversMaterial entity:mat-dimer-CC-ji2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-ji2025 .

entity:ds-dimer-CP-ji2025 a mlips:TrainingDataset ;
    rdfs:label "BioFragment dimer data, charged-polar class" ;
    mlips:coversMaterial entity:mat-dimer-CP-ji2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-ji2025 .

entity:ds-dimer-PP-ji2025 a mlips:TrainingDataset ;
    rdfs:label "BioFragment dimer data, polar-polar class" ;
    mlips:coversMaterial entity:mat-dimer-PP-ji2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-ji2025 .

entity:ds-dimer-CA-ji2025 a mlips:TrainingDataset ;
    rdfs:label "BioFragment dimer data, charged-apolar class" ;
    mlips:coversMaterial entity:mat-dimer-CA-ji2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-ji2025 .

entity:ds-dimer-PA-ji2025 a mlips:TrainingDataset ;
    rdfs:label "BioFragment dimer data, polar-apolar class" ;
    mlips:coversMaterial entity:mat-dimer-PA-ji2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-ji2025 .

entity:ds-dimer-AA-ji2025 a mlips:TrainingDataset ;
    rdfs:label "BioFragment dimer data, apolar-apolar class" ;
    mlips:coversMaterial entity:mat-dimer-AA-ji2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-dft-ji2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-dimer-CC-ji2025 mlips:samplingStrategy
    entity:sampling-separation-scan-ji2025 .

entity:ds-dimer-CP-ji2025 mlips:samplingStrategy
    entity:sampling-separation-scan-ji2025 .

entity:ds-dimer-PP-ji2025 mlips:samplingStrategy
    entity:sampling-separation-scan-ji2025 .

entity:ds-dimer-CA-ji2025 mlips:samplingStrategy
    entity:sampling-separation-scan-ji2025 .

entity:ds-dimer-PA-ji2025 mlips:samplingStrategy
    entity:sampling-separation-scan-ji2025 .

entity:ds-dimer-AA-ji2025 mlips:samplingStrategy
    entity:sampling-separation-scan-ji2025 .

entity:sampling-separation-scan-ji2025 a mlips:SamplingStrategy ;
    rdfs:label "Dimer separation scan, random 9:1 split" ;
    rdfs:comment "Dimer pairs at separations from about 5 A to 15 A; for each molecular pair the data are split at random into training and test sets 9:1." .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:SOG-Net a mlips:MLIPMethod ;
    rdfs:label "SOG-Net (sum-of-Gaussians neural network for long-range interactions)" ;
    mlips:hasFunctionalForm entity:ff-SOG-Net ;
    mlips:hasTrainingAlgorithm entity:alg-SOG-Net-ji2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        entity:hp-num-gaussians-ji2025 ,
        entity:hp-latent-layers-ji2025 ,
        entity:hp-fourier-grid-ji2025 ,
        mlips:learningRate ;
    mlips:inferenceComplexity "CPU time of the full model 10% to 40% above the short-range model, depending on system size (fast Fourier evaluation of the long-range part)" .

entity:ff-SOG-Net a mlips:FunctionalForm ;
    rdfs:label "Short-range descriptor network (core-shell Deep-Potential-type descriptors) plus a long-range energy from latent variables convolved with a learnable sum-of-Gaussians multiplier in Fourier space" .

entity:alg-SOG-Net-ji2025 a mls:Algorithm ;
    rdfs:label "Adam, initial learning rate 0.001 decaying by a factor of 0.98 every 10 epochs; three stages starting with batch size 2 and 800 epochs, both doubling at each stage" .

entity:hp-num-gaussians-ji2025 a mlips:Hyperparameter ;
    rdfs:label "SOG-Net number of Gaussians M" ;
    mlips:hyperparameterName "M" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-latent-layers-ji2025 a mlips:Hyperparameter ;
    rdfs:label "SOG-Net number of layers of latent variables" ;
    mlips:hyperparameterName "P" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

entity:hp-fourier-grid-ji2025 a mlips:Hyperparameter ;
    rdfs:label "SOG-Net number of Fourier grid points per dimension" ;
    mlips:hyperparameterName "N_FFT" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-sog-CC-cutoffRadius-ji2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "10"^^xsd:integer .

entity:setting-sog-CC-num-gaussians-ji2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-num-gaussians-ji2025 ;
    mlips:settingValue "12"^^xsd:integer .

entity:setting-sog-CC-latent-layers-ji2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-latent-layers-ji2025 ;
    mlips:settingValue "1"^^xsd:integer .

entity:setting-sog-CC-fourier-grid-ji2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter entity:hp-fourier-grid-ji2025 ;
    mlips:settingValue "31"^^xsd:integer .

entity:setting-sog-CC-learningRate-ji2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

