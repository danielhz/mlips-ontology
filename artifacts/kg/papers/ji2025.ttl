###############################################################################
# Q10 -- Benchmark results
###############################################################################

entity:study-ji2025 mlips:hasResult
    entity:result-sog-CC-ji2025 ,
    entity:result-sog-CP-ji2025 ,
    entity:result-sog-PP-ji2025 ,
    entity:result-sog-CA-ji2025 ,
    entity:result-sog-PA-ji2025 ,
    entity:result-sog-AA-ji2025 .

entity:result-sog-CC-ji2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-sog-CC-ji2025 ;
    mlips:targetMaterial entity:mat-dimer-CC-ji2025 ;
    mlips:hasAccuracyMetric entity:metric-sog-CC-1-ji2025 .

entity:metric-sog-CC-1-ji2025 a mlips:AccuracyMetric ;
    rdfs:label "RMSE on forces over the whole data set: SOG-Net, CC dimers (short-range-only model: 64.3)" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "3.8"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

