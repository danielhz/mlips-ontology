###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-perov-wu2023 a mlips:MaterialSystem ;
    rdfs:label "Perovskite oxides and solid solutions with up to six elements (BaTiO3, PbTiO3, SrTiO3, KNN, PZT, PMN-PT, PIN-PMN-PT and others; 14 metal elements)" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbesol-wu2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbesol-wu2023 mlips:hasDFTSettings entity:calc-settings-pbesol-wu2023 .

entity:calc-settings-pbesol-wu2023 a mlips:DFTSettings ;
    mlips:usedDFTCode entity:lib-ABACUS-wu2023 ;
    mlips:xcFunctional entity:xc-PBEsol-wu2023 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:kPointMesh "0.1 1/Bohr spacing" ;
    rdfs:comment "Numerical atomic orbitals (DZP), SG15 ONCV pseudopotentials, 100 Ry, convergence 1e-7 Ry." .

entity:lib-ABACUS-wu2023 a mlips:Library ;
    rdfs:label "ABACUS" ;
    mlips:candidateForVocabulary mlips:Library .

entity:xc-PBEsol-wu2023 a mlips:XCFunctional ;
    rdfs:label "PBEsol" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-unipero-wu2023 a mlips:TrainingDataset ;
    rdfs:label "UniPero final training database" ;
    mlips:coversMaterial entity:mat-perov-wu2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:numConfigurations 19288 ;
    mlips:hasDFTCalculation entity:calc-pbesol-wu2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-unipero-wu2023 mlips:samplingStrategy
    entity:sampling-dpgen-wu2023 .

entity:sampling-dpgen-wu2023 a mlips:SamplingStrategy ;
    rdfs:label "Modular DP-GEN: concurrent learning progressing from 3-element to 4- and 6-element perovskites, starting from about 1,000 configurations of 26 perovskites" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:DeePMD a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasDescriptor mlips:DeepPotentialDescriptor ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:numLayers ;
    mlips:hasImplementation entity:impl-DeePMD-wu2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:impl-DeePMD-wu2023 a mlips:Implementation ;
    mlips:implementedIn mlips:DeePMDkit .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-unipero-cutoffRadius-wu2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-unipero-numLayers-wu2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-unipero-wu2023 a mlips:MLIPRun ;
    rdfs:label "UniPero: DPA-1 (se_atten descriptor with two attention layers) trained on the perovskite database" ;
    mlips:appliesMethod entity:DeePMD ;
    mlips:runsOn entity:ds-unipero-wu2023 ;
    mlips:hasHyperparameterSetting entity:setting-unipero-cutoffRadius-wu2023 ,
        entity:setting-unipero-numLayers-wu2023 ;
    mlips:produces entity:model-unipero-wu2023 .

entity:model-unipero-wu2023 a mlips:TrainedModel ;
    rdfs:label "UniPero (DPA-1)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-wu2023 mlips:hasResult
    entity:result-unipero-train-wu2023 .

entity:result-unipero-train-wu2023 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-unipero-wu2023 ;
    mlips:targetMaterial entity:mat-perov-wu2023 ;
    mlips:hasAccuracyMetric entity:metric-unipero-train-1-wu2023 ,
        entity:metric-unipero-train-2-wu2023 .

entity:metric-unipero-train-1-wu2023 a mlips:AccuracyMetric ;
    rdfs:label "train total-energy MAE on perov: UniPero" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "1.75"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-unipero-train-2-wu2023 a mlips:AccuracyMetric ;
    rdfs:label "train force MAE on perov: UniPero" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "0.054"^^xsd:double ;
    mlips:hasUnit unit:EV-PER-ANGSTROM .

