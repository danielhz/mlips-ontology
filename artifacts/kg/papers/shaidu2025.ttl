# Canonical Turtle for the protocol-derived encoding of:
#   Yusuf Shaidu et al. (2025). Transferable dispersion-aware machine learning interatomic potentials for multilayer transition metal dichalcogenide heterostructures.
#   npj Computational Materials. doi:10.1038/s41524-025-01761-9
#
# Version read: publisher (sha256 a591cc8f15308537...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 440 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/shaidu2025.yaml.
#
# Encoding scope: the vdW-DF-C09 (Quantum ESPRESSO) data set of TMD
# monolayers, bilayers and hBN-supported layers from ensemble-based
# active learning and metadynamics (about 92,600 structures; 90/10
# split), the Behler-Parrinello-type NNP (PANNA; 8 A radial and 4 A
# angular cutoffs) with an added species-dependent C6 van der Waals term
# (6-12 A), and its training and test MAEs. Binding and sliding energies,
# phonons and moire reconstructions are properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-shaidu2025 a mlips:BenchmarkStudy ;
    rdfs:label "Shaidu et al. (2025): a transferable dispersion-aware neural-network potential for multilayer transition-metal dichalcogenide heterostructures" ;
    mlips:reportedIn entity:article-shaidu2025 .

entity:article-shaidu2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-025-01761-9> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Transferable dispersion-aware machine learning interatomic potentials for multilayer transition metal dichalcogenide heterostructures" ;
    schema:author entity:person-Shaidu-shaidu2025 ,
        entity:person-Naik-shaidu2025 ,
        entity:person-Louie-shaidu2025 ,
        entity:person-Neaton-shaidu2025 .

entity:person-Shaidu-shaidu2025 a schema:Person ;
    schema:name "Yusuf Shaidu" ;
    schema:givenName "Yusuf" ;
    schema:familyName "Shaidu" .

entity:person-Naik-shaidu2025 a schema:Person ;
    schema:name "Mit H. Naik" ;
    schema:givenName "Mit H." ;
    schema:familyName "Naik" .

entity:person-Louie-shaidu2025 a schema:Person ;
    schema:name "Steven G. Louie" ;
    schema:givenName "Steven G." ;
    schema:familyName "Louie" .

entity:person-Neaton-shaidu2025 a schema:Person ;
    schema:name "Jeffrey B. Neaton" ;
    schema:givenName "Jeffrey B." ;
    schema:familyName "Neaton" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tmd-shaidu2025 a mlips:MaterialSystem ;
    rdfs:label "MoS2, MoSe2, WS2, WSe2, MoTe2 and their homo-/heterobilayers and multilayers, with hexagonal BN" ;
    mlips:materialClass "2D lateral heterostructure" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-c09-shaidu2025 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-c09-shaidu2025 mlips:hasDFTSettings entity:calc-settings-c09-shaidu2025 .

entity:calc-settings-c09-shaidu2025 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional entity:xc-vdW-DF-C09-shaidu2025 ;
    mlips:pseudopotentialType mlips:NormConserving ;
    rdfs:comment "Norm-conserving pseudopotentials (Methods)." .

entity:xc-vdW-DF-C09-shaidu2025 a mlips:XCFunctional ;
    rdfs:label "vdW-DF-C09" ;
    mlips:candidateForVocabulary mlips:XCFunctional .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-tmd-shaidu2025 a mlips:TrainingDataset ;
    rdfs:label "TMD/hBN data set (about 92,600 structures; 90 % of pre-hBN data plus all hBN data for training, remaining 10 % for testing)" ;
    mlips:coversMaterial entity:mat-tmd-shaidu2025 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-c09-shaidu2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-tmd-shaidu2025 mlips:samplingStrategy
    entity:sampling-al-shaidu2025 .

entity:sampling-al-shaidu2025 a mlips:SamplingStrategy ;
    rdfs:label "Active learning with a five-NNP ensemble (energy deviation above 2.5 meV/atom) on MD at 300/800 K and 0, +-1 GPa, plus metadynamics on interlayer distances and hBN-supported configurations" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-shaidu2025 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-shaidu2025 ;
    mlips:hasHyperparameter mlips:cutoffRadius ,
        mlips:angularCutoff ,
        mlips:batchSize ,
        mlips:learningRate ;
    mlips:hasImplementation entity:impl-HDNNP-shaidu2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:GeometryOptimization ,
        mlips:PhononCalculation .

entity:loss-HDNNP-shaidu2025 a mlips:LossFunction ;
    rdfs:label "Energy and force errors; long-range C6 dispersion term with geometric-mean C6 coefficients added to the network energy" .

entity:alg-HDNNP-shaidu2025 a mls:Algorithm ;
    rdfs:label "Adam, learning rate decayed by 1 % every 5,000 steps" .

entity:impl-HDNNP-shaidu2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PANNA-shaidu2025 .

entity:lib-PANNA-shaidu2025 a mlips:Library ;
    rdfs:label "PANNA" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-nnp-cutoffRadius-shaidu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "8"^^xsd:integer .

entity:setting-nnp-angularCutoff-shaidu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:angularCutoff ;
    mlips:settingValue "4"^^xsd:integer .

entity:setting-nnp-batchSize-shaidu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:batchSize ;
    mlips:settingValue "16"^^xsd:integer .

entity:setting-nnp-learningRate-shaidu2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:learningRate ;
    mlips:settingValue "0.001"^^xsd:double .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-nnp-shaidu2025 a mlips:MLIPRun ;
    rdfs:label "Dispersion-aware Behler-Parrinello NNP for TMD heterostructures (43 radial Gaussians, 16 angular centres; vdW up to 12 A)" ;
    mlips:appliesMethod entity:HDNNP ;
    mlips:runsOn entity:ds-tmd-shaidu2025 ;
    mlips:hasHyperparameterSetting entity:setting-nnp-cutoffRadius-shaidu2025 ,
        entity:setting-nnp-angularCutoff-shaidu2025 ,
        entity:setting-nnp-batchSize-shaidu2025 ,
        entity:setting-nnp-learningRate-shaidu2025 ;
    mlips:produces entity:model-nnp-shaidu2025 .

entity:model-nnp-shaidu2025 a mlips:TrainedModel ;
    rdfs:label "TMD dispersion-aware NNP (Shaidu 2025)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-shaidu2025 mlips:hasResult
    entity:result-nnp-train-shaidu2025 ,
    entity:result-nnp-test-shaidu2025 .

entity:result-nnp-train-shaidu2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nnp-shaidu2025 ;
    mlips:targetMaterial entity:mat-tmd-shaidu2025 ;
    mlips:hasAccuracyMetric entity:metric-nnp-train-1-shaidu2025 ,
        entity:metric-nnp-train-2-shaidu2025 .

entity:metric-nnp-train-1-shaidu2025 a mlips:AccuracyMetric ;
    rdfs:label "train energy MAE on tmd: dispersion-aware NNP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.75"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nnp-train-2-shaidu2025 a mlips:AccuracyMetric ;
    rdfs:label "train force MAE on tmd: dispersion-aware NNP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "14.52"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

entity:result-nnp-test-shaidu2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-nnp-shaidu2025 ;
    mlips:targetMaterial entity:mat-tmd-shaidu2025 ;
    mlips:hasAccuracyMetric entity:metric-nnp-test-1-shaidu2025 ,
        entity:metric-nnp-test-2-shaidu2025 .

entity:metric-nnp-test-1-shaidu2025 a mlips:AccuracyMetric ;
    rdfs:label "test energy MAE on tmd: dispersion-aware NNP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "0.74"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ATOM .

entity:metric-nnp-test-2-shaidu2025 a mlips:AccuracyMetric ;
    rdfs:label "test force MAE on tmd: dispersion-aware NNP" ;
    mlips:metricType mlips:MAE ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricValue "14.33"^^xsd:double ;
    mlips:hasUnit mlips:MilliEV-PER-ANGSTROM .

