###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-org-matin2025 a mlips:MaterialSystem ;
    rdfs:label "Small organic molecules with C, H, N, O (ANI-1ccx) and the larger COMP6 benchmark molecules" ;
    mlips:materialClass "Organic and biochemical molecules (C, N, O, H)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-ccsdt-matin2025 a mlips:WaveFunctionCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-ccsdt-matin2025 mlips:hasWaveFunctionSettings entity:calc-settings-ccsdt-matin2025 .

entity:calc-settings-ccsdt-matin2025 a mlips:WaveFunctionSettings ;
    mlips:usedReferenceCode mlips:ORCA ;
    mlips:wfMethod mlips:CCSDT ;
    mlips:basisSet "CBS" ;
    rdfs:comment "ANI-1ccx CCSD(T)/CBS energies (Refs. 20, 40); the wB97x DFT labels of the same configurations are used only in Fig. 5." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-ani1ccx-matin2025 a mlips:TrainingDataset ;
    rdfs:label "ANI-1ccx (about 4.9e5 configurations; energies only)" ;
    mlips:coversMaterial entity:mat-org-matin2025 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasReferenceCalculation entity:calc-ccsdt-matin2025 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HIP-NN a mlips:MLIPMethod ;
    rdfs:label "Hierarchically Interacting Particle Neural Network (HIP-NN)" ;
    mlips:hasFunctionalForm entity:ff-HIP-NN ;
    mlips:hasLossFunction entity:loss-HIP-NN-matin2025 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ;
    mlips:hasImplementation entity:impl-HIP-NN-matin2025 ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-HIP-NN a mlips:FunctionalForm ;
    rdfs:label "Deep neural network with on-site and interaction layers over inverse-distance sensitivity functions; the molecular energy is a sum of atomic energies decomposed into hierarchical contributions from successive interaction layers" .

entity:loss-HIP-NN-matin2025 a mlips:LossFunction ;
    rdfs:label "RMSE + MAE of energies (teachers); plus scheduled force term on ensemble-averaged teacher forces (students); L2 (1e-4) and hierarchicality (0.1) regularisation" .

entity:impl-HIP-NN-matin2025 a mlips:Implementation ;
    mlips:implementedIn entity:lib-hippynn-matin2025 .

entity:lib-hippynn-matin2025 a mlips:Library ;
    rdfs:label "hippynn" ;
    mlips:candidateForVocabulary mlips:Library .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-teacher1-numLayers-matin2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-teacher1-cutoffRadius-matin2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-teacher1-numRadialBasis-matin2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "20"^^xsd:integer .

entity:setting-student1-numLayers-matin2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-student1-cutoffRadius-matin2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6.5"^^xsd:double .

entity:setting-student1-numRadialBasis-matin2025 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numRadialBasis ;
    mlips:settingValue "20"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-teacher1-matin2025 a mlips:MLIPRun ;
    rdfs:label "Single HIP-NN teacher trained on ANI-1ccx energies (2 interaction layers, lmax 2)" ;
    mlips:appliesMethod entity:HIP-NN ;
    mlips:runsOn entity:ds-ani1ccx-matin2025 ;
    mlips:hasHyperparameterSetting entity:setting-teacher1-numLayers-matin2025 ,
        entity:setting-teacher1-cutoffRadius-matin2025 ,
        entity:setting-teacher1-numRadialBasis-matin2025 ;
    mlips:produces entity:model-teacher1-matin2025 .

entity:model-teacher1-matin2025 a mlips:TrainedModel ;
    rdfs:label "HIP-NN ANI-1ccx teacher (single)" .

entity:run-student1-matin2025 a mlips:MLIPRun ;
    rdfs:label "Single HIP-NN student trained on ANI-1ccx energies and the single teacher's forces" ;
    mlips:appliesMethod entity:HIP-NN ;
    mlips:runsOn entity:ds-ani1ccx-matin2025 ;
    mlips:hasHyperparameterSetting entity:setting-student1-numLayers-matin2025 ,
        entity:setting-student1-cutoffRadius-matin2025 ,
        entity:setting-student1-numRadialBasis-matin2025 ;
    mlips:produces entity:model-student1-matin2025 .

entity:model-student1-matin2025 a mlips:TrainedModel ;
    rdfs:label "HIP-NN ANI-1ccx student (single-teacher KD)" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

entity:study-matin2025 mlips:hasResult
    entity:result-teacher1-gdb-matin2025 ,
    entity:result-student1-gdb-matin2025 .

entity:result-teacher1-gdb-matin2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-teacher1-matin2025 ;
    mlips:targetMaterial entity:mat-org-matin2025 ;
    mlips:hasAccuracyMetric entity:metric-teacher1-gdb-1-matin2025 ,
        entity:metric-teacher1-gdb-2-matin2025 .

entity:metric-teacher1-gdb-1-matin2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE on GDB 10-13: HIP-NN single teacher" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "3.31"^^xsd:double ;
    mlips:hasUnit unit:KiloCAL-PER-MOL .

entity:metric-teacher1-gdb-2-matin2025 a mlips:AccuracyMetric ;
    rdfs:label "Conformer energy difference RMSE on GDB 10-13: HIP-NN single teacher" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "2.45"^^xsd:double ;
    mlips:hasUnit unit:KiloCAL-PER-MOL .

entity:result-student1-gdb-matin2025 a mlips:BenchmarkResult ;
    mlips:evaluatesModel entity:model-student1-matin2025 ;
    mlips:targetMaterial entity:mat-org-matin2025 ;
    mlips:hasAccuracyMetric entity:metric-student1-gdb-1-matin2025 ,
        entity:metric-student1-gdb-2-matin2025 .

entity:metric-student1-gdb-1-matin2025 a mlips:AccuracyMetric ;
    rdfs:label "Energy RMSE on GDB 10-13: HIP-NN single-teacher student" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "2.93"^^xsd:double ;
    mlips:hasUnit unit:KiloCAL-PER-MOL .

entity:metric-student1-gdb-2-matin2025 a mlips:AccuracyMetric ;
    rdfs:label "Conformer energy difference RMSE on GDB 10-13: HIP-NN single-teacher student" ;
    mlips:metricType mlips:RMSE ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricValue "2.11"^^xsd:double ;
    mlips:hasUnit unit:KiloCAL-PER-MOL .

