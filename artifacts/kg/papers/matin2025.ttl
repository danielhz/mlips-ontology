# Canonical Turtle for the protocol-derived encoding of:
#   Sakib Matin et al. (2025). Ensemble Knowledge Distillation for Machine Learning Interatomic Potentials.
#   arXiv (Cornell University). doi:10.48550/arxiv.2503.14293  arXiv:2503.14293v3
#
# Version read: arxiv-preprint arXiv:2503.14293v3 (sha256 5227301a0629e34f...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 427 (Training/reliability). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/matin2025.yaml.
#
# Encoding scope: HIP-NN teacher models trained on ANI-1ccx CCSD(T)/CBS
# energies, student HIP-NNs trained on the energies plus
# ensemble-averaged teacher forces (first and second generation), control
# and baseline models, and the single-teacher distillation test with the
# CC-COMP6 'GDB 10-13' RMSEs stated in the SI. Ensemble results
# (Figs. 2, 4-6) and MD stability (Fig. 3) are figure-only.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-matin2025 a mlips:BenchmarkStudy ;
    rdfs:label "Matin et al. (2025): ensemble knowledge distillation (EKD) of HIP-NN potentials trained on energy-only coupled-cluster data" ;
    mlips:reportedIn entity:article-matin2025 .

entity:article-matin2025 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2503.14293> ;
    schema:datePublished "2025"^^xsd:gYear ;
    schema:name "Ensemble Knowledge Distillation for Machine Learning Interatomic Potentials" ;
    schema:author entity:person-Matin-matin2025 ,
        entity:person-Shinkle-matin2025 ,
        entity:person-Pimonova-matin2025 ,
        entity:person-Craven-matin2025 ,
        entity:person-Pachalieva-matin2025 ,
