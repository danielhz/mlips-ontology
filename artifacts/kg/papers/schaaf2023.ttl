# Canonical Turtle for the protocol-derived encoding of:
#   Lars L. Schaaf et al. (2023). Accurate energy barriers for catalytic reaction pathways: an automatic training protocol for machine learning force fields.
#   npj Computational Materials. doi:10.1038/s41524-023-01124-2
#
# Version read: publisher (sha256 431e3c4c7066c84a...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 576 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/schaaf2023.yaml.
#
# Encoding scope: the GAP (double turbo-SOAP, 4 and 6 A cutoffs) built
# by the uncertainty-driven training protocol (MD with 50 meV energy
# uncertainty threshold, dimers, NEB-based refinement) for CO2
# hydrogenation to methanol on In2O3, and MACE models (2 layers, 256
# channels, L = 1) for the dopant study. The reported errors are mean
# adsorption-energy and barrier errors, which are properties; no
# energy/force RMSE or MAE is given in the text read.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-schaaf2023 a mlips:BenchmarkStudy ;
    rdfs:label "Schaaf et al. (2023): automatic active-learning protocol for MLFFs with accurate energy barriers of catalytic CO2 hydrogenation on indium oxide" ;
    mlips:reportedIn entity:article-schaaf2023 .

entity:article-schaaf2023 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s41524-023-01124-2> ;
    schema:datePublished "2023"^^xsd:gYear ;
    schema:name "Accurate energy barriers for catalytic reaction pathways: an automatic training protocol for machine learning force fields" ;
    schema:author <https://orcid.org/0000-0002-1935-236X> ,
        <https://orcid.org/0000-0002-0043-5907> ,
        <https://orcid.org/0000-0001-8434-3497> ,
        entity:person-Schafer-schaaf2023 ,
        <https://orcid.org/0000-0002-8180-2034> .

<https://orcid.org/0000-0002-1935-236X> a schema:Person ;
    schema:name "Lars L. Schaaf" ;
    schema:givenName "Lars L." ;
    schema:familyName "Schaaf" ;
    schema:identifier <https://orcid.org/0000-0002-1935-236X> .

<https://orcid.org/0000-0002-0043-5907> a schema:Person ;
    schema:name "Edvin Fako" ;
    schema:givenName "Edvin" ;
    schema:familyName "Fako" ;
    schema:identifier <https://orcid.org/0000-0002-0043-5907> .

<https://orcid.org/0000-0001-8434-3497> a schema:Person ;
    schema:name "Sandip De" ;
    schema:givenName "Sandip" ;
    schema:familyName "De" ;
    schema:identifier <https://orcid.org/0000-0001-8434-3497> .

entity:person-Schafer-schaaf2023 a schema:Person ;
    schema:name "Ansgar Schäfer" ;
    schema:givenName "Ansgar" ;
    schema:familyName "Schäfer" .

<https://orcid.org/0000-0002-8180-2034> a schema:Person ;
    schema:name "Gábor Csányi" ;
    schema:givenName "Gábor" ;
    schema:familyName "Csányi" ;
    schema:identifier <https://orcid.org/0000-0002-8180-2034> .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-in2o3-schaaf2023 a mlips:MaterialSystem ;
    rdfs:label "In2O3 surfaces with CO2 hydrogenation intermediates and transition states (including Pt-doped surfaces)" ;
    mlips:materialClass "Oxides" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-qe-schaaf2023 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-qe-schaaf2023 mlips:hasDFTSettings entity:calc-settings-qe-schaaf2023 .

entity:calc-settings-qe-schaaf2023 a mlips:DFTSettings ;
    mlips:usedDFTCode mlips:QuantumESPRESSO ;
    mlips:xcFunctional mlips:PBE ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:energyCutoff "884"^^xsd:double ;
    mlips:kPointMesh "Maximum spacing 0.25 1/A" ;
    rdfs:comment "Gaussian smearing 0.1 eV, SCF 1e-7 eV" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-in2o3-schaaf2023 a mlips:TrainingDataset ;
    rdfs:label "In2O3 CO2-hydrogenation training set from the automatic protocol" ;
    mlips:coversMaterial entity:mat-in2o3-schaaf2023 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation entity:calc-qe-schaaf2023 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-in2o3-schaaf2023 mlips:samplingStrategy
    entity:sampling-al-schaaf2023 .

entity:sampling-al-schaaf2023 a mlips:SamplingStrategy ;
    rdfs:label "Active learning: MD on reaction intermediates stopped when GAP energy uncertainty exceeds 50 meV, dimer configurations, and refinement along NEB minimum-energy paths" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:GAP a mlips:MLIPMethod ;
    rdfs:label "Gaussian Approximation Potential with SOAP kernel" ;
    mlips:hasDescriptor mlips:SOAPDescriptor ;
    mlips:hasLossFunction entity:loss-GAP-schaaf2023 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-GAP-schaaf2023 ;
    mlips:supportsSimulation mlips:MolecularDynamics ,
        mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:loss-GAP-schaaf2023 a mlips:LossFunction ;
    rdfs:label "Sparse GPR on energies and forces with CUR-selected sparse points; polynomial SOAP kernel" .

entity:impl-GAP-schaaf2023 a mlips:Implementation ;
    mlips:implementedIn mlips:QUIP .

entity:MACE a mlips:MLIPMethod ;
    rdfs:label "MACE: higher-order equivariant message-passing neural network" ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ;
    mlips:hasImplementation entity:impl-MACE-schaaf2023 ;
    mlips:supportsSimulation mlips:NudgedElasticBand ,
        mlips:GeometryOptimization .

entity:impl-MACE-schaaf2023 a mlips:Implementation ;
    mlips:implementedIn mlips:MACE .

###############################################################################
# Q8 -- Hyperparameter settings
###############################################################################

entity:setting-gap-cutoffRadius-schaaf2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "6"^^xsd:integer .

entity:setting-mace-numLayers-schaaf2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numLayers ;
    mlips:settingValue "2"^^xsd:integer .

entity:setting-mace-numFeatures-schaaf2023 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:numFeatures ;
    mlips:settingValue "256"^^xsd:integer .

###############################################################################
# Q9 -- MLIP run + trained model (Q11 training-cost properties inline)
###############################################################################

entity:run-gap-schaaf2023 a mlips:MLIPRun ;
    rdfs:label "GAP for CO2 hydrogenation on In2O3 (automatic protocol)" ;
    mlips:appliesMethod entity:GAP ;
    mlips:runsOn entity:ds-in2o3-schaaf2023 ;
    mlips:hasHyperparameterSetting entity:setting-gap-cutoffRadius-schaaf2023 ;
    mlips:produces entity:model-gap-schaaf2023 .

entity:model-gap-schaaf2023 a mlips:TrainedModel ;
    rdfs:label "GAP In2O3 CO2 hydrogenation" .

entity:run-mace-schaaf2023 a mlips:MLIPRun ;
    rdfs:label "MACE trained on the protocol data for the dopant study" ;
    mlips:appliesMethod entity:MACE ;
    mlips:runsOn entity:ds-in2o3-schaaf2023 ;
    mlips:hasHyperparameterSetting entity:setting-mace-numLayers-schaaf2023 ,
        entity:setting-mace-numFeatures-schaaf2023 ;
    mlips:produces entity:model-mace-schaaf2023 .

entity:model-mace-schaaf2023 a mlips:TrainedModel ;
    rdfs:label "MACE In2O3 dopants" .

###############################################################################
# Q10 -- Benchmark results (Q11 inference-cost properties inline)
###############################################################################

