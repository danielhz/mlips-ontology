###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-carbon-kurniawan2026 a mlips:MaterialSystem ;
    rdfs:label "Carbon allotropes: diamond, graphite, monolayer and bilayer graphene" ;
    mlips:chemicalFormula "C" ;
    mlips:materialClass "Elemental solid and liquid carbon" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-kurniawan2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-kurniawan2026 mlips:hasDFTSettings entity:calc-settings-pbe-kurniawan2026 .

entity:calc-settings-pbe-kurniawan2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    mlips:energyCutoff "500"^^xsd:double ;
    rdfs:comment "Many-body dispersion for bilayer graphene and graphite; about 30 A vacuum for slabs; Gamma-centred Monkhorst-Pack meshes (Sec. 2.2; data of Refs. 6, 48)." .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-carbon-kurniawan2026 a mlips:TrainingDataset ;
    rdfs:label "Carbon data set (4,344 training and 444 test configurations; Table 1)" ;
    mlips:coversMaterial entity:mat-carbon-kurniawan2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 4788 ;
    mlips:hasDFTCalculation entity:calc-pbe-kurniawan2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

# No sampling strategy is described by the paper (see Q12).

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-kurniawan2026 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-kurniawan2026 ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:numFeatures ,
        mlips:batchSize ,
        mlips:learningRate ,
        mlips:numEpochs .

entity:loss-HDNNP-kurniawan2026 a mlips:LossFunction ;
    rdfs:label "Squared residuals of per-atom energy (sigma_E = 1 eV) and forces (sigma_F = 10 eV/A)" .

entity:alg-HDNNP-kurniawan2026 a mls:Algorithm ;
    rdfs:label "Adam; learning rate 1e-3 for 5,000 epochs then 1e-4 for 35,000; dropout 0.1" .

