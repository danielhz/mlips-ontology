    schema:name "Comparative study of ensemble-based uncertainty quantification methods for neural network interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-5369-5710> ,
        <https://orcid.org/0000-0003-0013-575X> ,
        <https://orcid.org/0000-0003-3311-6299> ,
        <https://orcid.org/0000-0001-9529-9399> .

