###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-tio2-farris2026 a mlips:MaterialSystem ;
    rdfs:label "TiO2 bulk phases (aenet benchmark set)" ;
    mlips:chemicalFormula "TiO2" ;
    mlips:materialClass "Oxides" .

entity:mat-qm7-farris2026 a mlips:MaterialSystem ;
    rdfs:label "QM7 organic molecules (C, H, N, O, S; up to 23 atoms)" ;
    mlips:materialClass "Small organic molecules (equilibrium geometries)" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pbe-farris2026 a mlips:DFTCalculation .

entity:calc-pbe0-farris2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pbe-farris2026 mlips:hasDFTSettings entity:calc-settings-pbe-farris2026 .

entity:calc-settings-pbe-farris2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE ;
    rdfs:comment "TiO2 dataset of Ref. 28" .

entity:calc-pbe0-farris2026 mlips:hasDFTSettings entity:calc-settings-pbe0-farris2026 .

entity:calc-settings-pbe0-farris2026 a mlips:DFTSettings ;
    mlips:xcFunctional mlips:PBE0 ;
    rdfs:comment "QM7 atomization energies" .

###############################################################################
# Q5 -- Training dataset characterisation
###############################################################################

entity:ds-tio2-high-farris2026 a mlips:TrainingDataset ;
    rdfs:label "TiO2 training set, high-data regime (6,330 structures)" ;
    mlips:coversMaterial entity:mat-tio2-farris2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 6330 ;
    mlips:hasDFTCalculation entity:calc-pbe-farris2026 .

entity:ds-tio2-low-farris2026 a mlips:TrainingDataset ;
    rdfs:label "TiO2 training set, low-data regime (1,265 structures)" ;
    mlips:coversMaterial entity:mat-tio2-farris2026 ;
    mlips:coversProperty mlips:Energy ,
        mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:numConfigurations 1265 ;
    mlips:hasDFTCalculation entity:calc-pbe-farris2026 .

entity:ds-qm7-farris2026 a mlips:TrainingDataset ;
    rdfs:label "QM7 training split (80%, energies only)" ;
    mlips:coversMaterial entity:mat-qm7-farris2026 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation entity:calc-pbe0-farris2026 .

###############################################################################
# Q6 -- Sampling strategies
###############################################################################

entity:ds-tio2-high-farris2026 mlips:samplingStrategy
    entity:sampling-split-farris2026 .

entity:ds-tio2-low-farris2026 mlips:samplingStrategy
    entity:sampling-split-farris2026 .

entity:ds-qm7-farris2026 mlips:samplingStrategy
    entity:sampling-split-farris2026 .

entity:sampling-split-farris2026 a mlips:SamplingStrategy ;
    rdfs:label "Random 80/10/10 splits; low-data regime keeps 20% of training and validation" .

###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HDNNP a mlips:MLIPMethod ;
    rdfs:label "High-Dimensional Neural Network Potential (Behler-Parrinello)" ;
    mlips:hasDescriptor mlips:SymmetryFunctionDescriptor ;
    mlips:hasLossFunction entity:loss-HDNNP-farris2026 ;
    mlips:hasTrainingAlgorithm entity:alg-HDNNP-farris2026 ;
    mlips:hasHyperparameter mlips:numLayers ;
    mlips:hasImplementation entity:impl-HDNNP-farris2026 .

entity:loss-HDNNP-farris2026 a mlips:LossFunction ;
    rdfs:label "Energy-force likelihood (ELBO for BNNs; per-member loss for ensembles)" .

entity:alg-HDNNP-farris2026 a mls:Algorithm ;
    rdfs:label "Hyperparameters by Optuna; Bayes by Backprop for BNNs (TyXe/Pyro)" .

entity:impl-HDNNP-farris2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-aenet-PyTorch-farris2026 .

entity:lib-aenet-PyTorch-farris2026 a mlips:Library ;
    rdfs:label "aenet-PyTorch" ;
    mlips:candidateForVocabulary mlips:Library .

