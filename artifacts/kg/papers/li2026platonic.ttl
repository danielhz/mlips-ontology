# Canonical Turtle for the protocol-derived encoding of:
#   Zhenzhu Li et al. (2026). Platonic representation of foundation machine learning interatomic potentials.
#   Nature Machine Intelligence. doi:10.1038/s42256-026-01235-7  arXiv:2512.05349v1
#
# Version read: arxiv-preprint arXiv:2512.05349v1 (sha256 1fa7a0dad046203e...);
#   the DOI above is cited, numbers are those of the version read.
# Corpus rank 438 (Application/model instance). Method identity follows
#   artifacts/kg/METHODS.md (registry: artifacts/kg/methods-registry.csv).
# Generated by artifacts/scripts/encode_paper.py from artifacts/kg/encoding/specs/li2026platonic.yaml.
#
# Encoding scope: seven pretrained foundation MLIPs (MACE-MP-0 small,
# medium and large; MACE-omat; SevenNet-omat; Orb-v3 conservative and
# direct omat) whose atomic embeddings for 27,136 MP-20 structures
# (282,847 environments) are projected onto a shared anchor space
# (DIRECT-sampled anchors). The study analyses representations; it
# reports no energy or force errors.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://w3id.org/mlips#> .
@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-li2026platonic a mlips:BenchmarkStudy ;
    rdfs:label "Li and Walsh (2026): a Platonic representation aligning the latent embeddings of foundation MLIPs" ;
    mlips:reportedIn entity:article-li2026platonic .

entity:article-li2026platonic a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.1038/s42256-026-01235-7> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Platonic representation of foundation machine learning interatomic potentials" ;
    schema:author <https://orcid.org/0000-0002-6669-563X> ,
        <https://orcid.org/0000-0001-5460-7033> .

<https://orcid.org/0000-0002-6669-563X> a schema:Person ;
    schema:name "Zhenzhu Li" ;
    schema:givenName "Zhenzhu" ;
    schema:familyName "Li" ;
    schema:identifier <https://orcid.org/0000-0002-6669-563X> .

<https://orcid.org/0000-0001-5460-7033> a schema:Person ;
    schema:name "Aron Walsh" ;
    schema:givenName "Aron" ;
    schema:familyName "Walsh" ;
    schema:identifier <https://orcid.org/0000-0001-5460-7033> .

