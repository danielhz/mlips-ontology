###############################################################################

entity:run-mp0-s-li2026platonic a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0 small as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mp0-s-li2026platonic .

entity:model-mp0-s-li2026platonic a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0 small" .

entity:run-mp0-m-li2026platonic a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0 medium as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mp0-m-li2026platonic .

entity:model-mp0-m-li2026platonic a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0 medium" .

entity:run-mp0-l-li2026platonic a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0 large as distributed" ;
    mlips:appliesMethod entity:MACE ;
    mlips:produces entity:model-mp0-l-li2026platonic .

entity:model-mp0-l-li2026platonic a mlips:TrainedModel ;
