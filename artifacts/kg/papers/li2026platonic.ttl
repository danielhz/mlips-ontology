entity:run-seven-omat-li2026platonic a mlips:MLIPRun ;
    rdfs:label "SevenNet omat model as distributed" ;
    mlips:appliesMethod entity:NequIP ;
    mlips:produces entity:model-seven-omat-li2026platonic .

entity:model-seven-omat-li2026platonic a mlips:TrainedModel ;
