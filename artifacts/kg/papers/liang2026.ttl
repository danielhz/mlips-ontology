@prefix entity: <https://w3id.org/mlips/entity/> .

###############################################################################
# Q1 -- Bibliographic identification
###############################################################################

entity:study-liang2026 a mlips:BenchmarkStudy ;
    rdfs:label "Liang, Lu, Ji and Jiang (2026): prolate spheroidal wave functions for fast, exponent-aware long-range MLIPs (PSWF-LR)" ;
    mlips:reportedIn entity:article-liang2026 .

entity:article-liang2026 a schema:ScholarlyArticle ;
    schema:sameAs <https://doi.org/10.48550/arxiv.2606.06617> ;
    schema:datePublished "2026"^^xsd:gYear ;
    schema:name "Prolate spheroidal wave functions enable fast and exponent-aware long-range machine learning interatomic potentials" ;
    schema:author entity:person-Liang-liang2026 ,
        entity:person-Lu-liang2026 ,
        entity:person-Ji-liang2026 ,
        entity:person-Jiang-liang2026 .

entity:person-Liang-liang2026 a schema:Person ;
    schema:name "Jiuyang Liang" ;
    schema:givenName "Jiuyang" ;
    schema:familyName "Liang" .

entity:person-Lu-liang2026 a schema:Person ;
    schema:name "Libin Lu" ;
    schema:givenName "Libin" ;
    schema:familyName "Lu" .

entity:person-Ji-liang2026 a schema:Person ;
    schema:name "Yajie Ji" ;
    schema:givenName "Yajie" ;
    schema:familyName "Ji" .

entity:person-Jiang-liang2026 a schema:Person ;
    schema:name "Shidong Jiang" ;
    schema:givenName "Shidong" ;
    schema:familyName "Jiang" .

###############################################################################
# Q2 -- Material system
###############################################################################

entity:mat-nacl-liang2026 a mlips:MaterialSystem ;
    rdfs:label "Na9Cl8+ / Na8Cl8+ ionic clusters" ;
    mlips:materialClass "charged ionic clusters" .

entity:mat-c10-liang2026 a mlips:MaterialSystem ;
    rdfs:label "Terminally protonated carbon chains C10H2 / C10H3+" ;
    mlips:materialClass "charged organic molecules" .

entity:mat-au2mgo-liang2026 a mlips:MaterialSystem ;
    rdfs:label "Au2 on MgO(001) with and without Al doping" ;
    mlips:materialClass "supported metal cluster on oxide" .

entity:mat-cubta-liang2026 a mlips:MaterialSystem ;
    rdfs:label "Dry Cu(111)-benzotriazole interface" ;
    mlips:materialClass "metal-organic interface" .

entity:mat-cubta-w-liang2026 a mlips:MaterialSystem ;
    rdfs:label "Solvated Cu(111)-benzotriazole interface" ;
    mlips:materialClass "metal-organic-water interface" .

###############################################################################
# Q3 -- Reference calculation method (type only; settings live in Q4)
###############################################################################

entity:calc-pub-liang2026 a mlips:DFTCalculation .

###############################################################################
# Q4 -- Reference settings + software code
###############################################################################

entity:calc-pub-liang2026 mlips:hasDFTSettings entity:calc-settings-pub-liang2026 .

entity:calc-settings-pub-liang2026 a mlips:DFTSettings ;
