    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5.29"^^xsd:double .

entity:setting-pswf-c10-cutoffRadius-liang2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
