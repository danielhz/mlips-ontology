###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:PSWF-LR a mlips:MLIPMethod ;
    rdfs:label "PSWF-LR (long-range MLIP module with prolate-spheroidal-wave-function mollified inverse-power channels on latent atomic variables, combined with a short-range CACE, MACE or NequIP model)" ;
    mlips:hasTrainingAlgorithm entity:alg-PSWF-LR-liang2026 ;
    mlips:hasHyperparameter mlips:cutoffRadius ;
    mlips:hasImplementation entity:impl-PSWF-LR-liang2026 .

entity:alg-PSWF-LR-liang2026 a mls:Algorithm ;
    rdfs:label "Short-range CACE (or MACE for C10, no message passing) plus long-range channels p = 1..6 on latent atomic variables with PSWF mollifiers (c = 12.024, mesh h = 1.5 A)" .

entity:impl-PSWF-LR-liang2026 a mlips:Implementation ;
    mlips:implementedIn entity:lib-PSWF-LR-liang2026 .

entity:lib-PSWF-LR-liang2026 a mlips:Library ;
    rdfs:label "PSWF-LR" ;
    mlips:candidateForVocabulary mlips:Library .

