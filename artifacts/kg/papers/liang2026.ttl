    mlips:settingValue "5"^^xsd:double .

entity:setting-pswf-cubta-w-cutoffRadius-liang2026 a mlips:HyperparameterSetting ;
    mlips:forHyperparameter mlips:cutoffRadius ;
    mlips:settingValue "5"^^xsd:double .

