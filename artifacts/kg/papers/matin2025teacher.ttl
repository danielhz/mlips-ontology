###############################################################################
# Q7 -- MLIP method, components, implementation
###############################################################################

entity:HIP-NN a mlips:MLIPMethod ;
    rdfs:label "Hierarchically Interacting Particle Neural Network (HIP-NN)" ;
    mlips:hasFunctionalForm entity:ff-HIP-NN ;
    mlips:hasLossFunction entity:loss-HIP-NN-matin2025teacher ;
    mlips:hasTrainingAlgorithm entity:alg-HIP-NN-matin2025teacher ;
    mlips:hasHyperparameter mlips:numLayers ,
        mlips:cutoffRadius ,
        mlips:numRadialBasis ,
        mlips:learningRate ,
        entity:hp-wA-matin2025teacher ;
    mlips:hasImplementation entity:impl-HIP-NN-matin2025teacher ;
    mlips:supportsSimulation mlips:MolecularDynamics .

entity:ff-HIP-NN a mlips:FunctionalForm ;
    rdfs:label "Deep neural network with on-site and interaction layers over inverse-distance sensitivity functions; the molecular energy is a sum of atomic energies decomposed into hierarchical contributions from successive interaction layers" .

entity:loss-HIP-NN-matin2025teacher a mlips:LossFunction ;
    rdfs:label "Sum of RMSE and MAE terms for energy and forces (w_E 1, w_F 10), L2 10^-6, HIP-NN R term 0.01; students add the atomic-energy term (w_E 1, w_F 30, w_A 100)" .

entity:alg-HIP-NN-matin2025teacher a mls:Algorithm ;
    rdfs:label "Adam, learning rate halved with patience 30, termination patience 50" .

entity:impl-HIP-NN-matin2025teacher a mlips:Implementation ;
    mlips:implementedIn entity:lib-hippynn-matin2025teacher .

entity:lib-hippynn-matin2025teacher a mlips:Library ;
    rdfs:label "hippynn" ;
    mlips:candidateForVocabulary mlips:Library .

entity:hp-wA-matin2025teacher a mlips:Hyperparameter ;
    rdfs:label "Weight of the teacher atomic-energy loss term (w_A)" ;
    mlips:hyperparameterName "w_A" ;
    mlips:hyperparameterDatatype xsd:decimal ;
    mlips:candidateForVocabulary mlips:Hyperparameter .

