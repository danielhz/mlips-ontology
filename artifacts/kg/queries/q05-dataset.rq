# Q5 -- Training dataset. All triples whose subject is a TrainingDataset,
# EXCEPT the samplingStrategy edges (which live in Q6).

PREFIX mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  ?s a mlips:TrainingDataset .
  ?s ?p ?o .
  FILTER (?p != mlips:samplingStrategy)
}
