# Q11 -- Computational resources.
# Compute-cost data properties on the run, and inference-cost data
# properties on the benchmark result (their domain; issue #1). Q10
# returns the same result triples; the round-trip takes the union.

PREFIX mlips: <https://w3id.org/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  {
    ?s a mlips:MLIPRun .
    ?s ?p ?o .
    VALUES ?p {
      mlips:trainingDuration
      mlips:gpuHours
      mlips:trainingHardware
      mlips:peakMemory
    }
  } UNION {
    ?s a mlips:BenchmarkResult .
    ?s ?p ?o .
    VALUES ?p {
      mlips:inferenceTimePerAtom
      mlips:inferenceHardware
    }
  }
}
