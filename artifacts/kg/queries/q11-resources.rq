# Q11 -- Computational resources.
# Compute-cost data properties on the run, and inference-cost data
# properties on the trained model.

PREFIX mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  {
    ?s a mlips:MLIPRun .
    ?s ?p ?o .
    VALUES ?p {
      mlips:trainingDuration
      mlips:gpuHours
      mlips:trainingHardware
      mlips:peakMemory
    }
  } UNION {
    ?s a mlips:TrainedModel .
    ?s ?p ?o .
    VALUES ?p {
      mlips:inferenceTimePerAtom
      mlips:inferenceHardware
    }
  }
}
