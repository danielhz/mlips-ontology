# Q1 -- Bibliographic identification.
# Captures the BenchmarkStudy node (type, label, link to article) and
# the ScholarlyArticle node (all triples).
# The hasResult edge from BenchmarkStudy lives in Q10.

PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX mlips:  <https://kg.ki.uni-stuttgart.de/_ontology/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  {
    ?s a mlips:BenchmarkStudy .
    ?s ?p ?o .
    VALUES ?p { rdf:type rdfs:label mlips:reportedIn }
  } UNION {
    ?s a schema:ScholarlyArticle .
    ?s ?p ?o .
  }
}
