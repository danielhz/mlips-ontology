# Q1 -- Bibliographic identification.
# Captures: the BenchmarkStudy node (type, label, link to article);
# the ScholarlyArticle node (all triples, including any schema:author
# edges); the schema:Person nodes attached via schema:author and
# their bibliographic triples (schema:name, schema:givenName,
# schema:familyName, schema:identifier for ORCID, schema:affiliation
# for institutional links); and the schema:Organization nodes
# attached via schema:affiliation (schema:name, schema:identifier
# for ROR).
#
# After issue-0009 introduced cross-paper Person identity collapse
# (the alphabetically-first paper that mentions an ORCID owns the
# `?p a schema:Person` declaration; later papers reference the same
# ORCID via schema:author without re-typing), Q1 also walks
# schema:author from any local ScholarlyArticle and pulls every
# triple on the resulting subject -- this captures affiliation
# triples that live in non-owner papers and whose subject is no
# longer typed locally as schema:Person.
#
# The hasResult edge from BenchmarkStudy lives in Q10.

PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX mlips:  <https://w3id.org/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  {
    ?s a mlips:BenchmarkStudy .
    ?s ?p ?o .
    VALUES ?p { rdf:type rdfs:label mlips:reportedIn }
  } UNION {
    ?s a schema:ScholarlyArticle .
    ?s ?p ?o .
  } UNION {
    ?s a schema:Person .
    ?s ?p ?o .
  } UNION {
    ?s a schema:Organization .
    ?s ?p ?o .
  } UNION {
    [] a schema:ScholarlyArticle ;
       schema:author ?s .
    ?s ?p ?o .
  }
}
