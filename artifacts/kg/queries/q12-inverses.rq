# Q12 -- Computed inverse-role triples.
# Captures triples whose predicate is one of the eight named inverses
# declared in the schema. Used only against the *computed* TTL: the
# canonical paper.ttl never carries these predicates; they appear only
# after artifacts/kg/computed/inverses.rq runs.

PREFIX mlips: <https://w3id.org/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  VALUES ?p {
    mlips:isHyperparameterOf
    mlips:isImplementationOf
    mlips:isResultOf
    mlips:isMetricOf
    mlips:isSettingOf
    mlips:isProducedBy
    mlips:wasRunBy
    mlips:isEvaluatedIn
  }
  ?s ?p ?o .
}
