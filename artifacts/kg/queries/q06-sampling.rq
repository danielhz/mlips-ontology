# Q6 -- Sampling strategies.
# Two blocks:
#   (1) dataset -> samplingStrategy -> strategy edges
#   (2) SamplingStrategy nodes and all their triples

PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX mlips: <https://w3id.org/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  {
    ?s a mlips:TrainingDataset .
    ?s ?p ?o .
    FILTER (?p = mlips:samplingStrategy)
  } UNION {
    ?s a mlips:SamplingStrategy .
    ?s ?p ?o .
  }
}
