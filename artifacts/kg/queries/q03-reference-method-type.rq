# Q3 -- Reference calculation method type.
# Captures only the rdf:type triple of the reference-calculation node.
# Settings link is in Q4; dataset-to-calc link is in Q5.

PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX mlips: <https://w3id.org/mlips#>

CONSTRUCT { ?s rdf:type ?type }
WHERE {
  ?s a ?type .
  VALUES ?type {
    mlips:DFTCalculation
    mlips:WaveFunctionCalculation
    mlips:ReferenceCalculation
  }
}
