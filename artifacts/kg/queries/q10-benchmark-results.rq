# Q10 -- Benchmark results, accuracy metrics, and the link from the
# study to its results.
# (BenchmarkStudy's other identifying triples are in Q1.)

PREFIX mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#>

CONSTRUCT { ?s ?p ?o }
WHERE {
  {
    ?s a mlips:BenchmarkStudy .
    ?s ?p ?o .
    VALUES ?p { mlips:hasResult }
  } UNION {
    ?s a mlips:BenchmarkResult .
    ?s ?p ?o .
  } UNION {
    ?s a mlips:AccuracyMetric .
    ?s ?p ?o .
  }
}
