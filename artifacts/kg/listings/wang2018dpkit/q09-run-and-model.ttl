@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-deepmd-water
    a mlips:TrainedModel ;
    rdfs:label "DeePMD water model (PBE0+TS reference, demonstration of DeePMD-kit)" .
ex:run-deepmd-water
    a mlips:MLIPRun ;
    rdfs:label "DeePMD-kit demonstration training run on the liquid-water dataset (10^6 batches, batch size 4)" ;
    mlips:appliesMethod ex:DeePMD ;
    mlips:hasHyperparameterSetting ex:setting-decay-rate-deepmd, ex:setting-decay-steps-deepmd, ex:setting-hidden-deepmd, ex:setting-lr0-deepmd, ex:setting-rcut-60-wang2018 ;
    mlips:produces ex:model-deepmd-water ;
    mlips:runsOn ex:ds-water-wang2018 .
