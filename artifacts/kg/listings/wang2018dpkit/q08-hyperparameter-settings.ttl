@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-decay-rate-deepmd
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-decay-rate-deepmd ;
    mlips:settingValue "0.95" .
ex:setting-decay-steps-deepmd
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-decay-steps-deepmd ;
    mlips:settingValue "5000" .
ex:setting-hidden-deepmd
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-hidden-deepmd ;
    mlips:settingValue "(240, 120, 60, 30, 10)" .
ex:setting-lr0-deepmd
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-lr0-deepmd ;
    mlips:settingValue "0.001" .
ex:setting-rcut-60-wang2018
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-deepmd ;
    mlips:settingValue "6.0" .
