@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:aimd-sampling-wang2018
    a mlips:SamplingStrategy ;
    rdfs:comment "Configurations are recorded every 0.0005 ps along a 20 ps NVT AIMD trajectory of 64 water molecules at 330 K." ;
    rdfs:label "Vibrational sampling (NVT AIMD)" .
ex:ds-water-wang2018
    mlips:samplingStrategy ex:aimd-sampling-wang2018 .
