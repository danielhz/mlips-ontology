@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:DeePMD
    a mlips:MLIPMethod ;
    rdfs:label "Deep Potential Molecular Dynamics (DeePMD)" ;
    mlips:hasFunctionalForm ex:deepmd-functional-form ;
    mlips:hasHyperparameter ex:hp-decay-rate-deepmd, ex:hp-decay-steps-deepmd, ex:hp-hidden-deepmd, ex:hp-lr0-deepmd, ex:hp-rcut-deepmd ;
    mlips:hasImplementation ex:deepmd-kit-impl ;
    mlips:hasLossFunction ex:deepmd-loss-wang2018 ;
    mlips:hasTrainingAlgorithm ex:adam-deepmd .
ex:adam-deepmd
    a mls:Algorithm ;
    rdfs:label "Adam stochastic gradient descent with exponentially decaying learning rate (start 1e-3, decay rate 0.95 every 5000 steps)" .
ex:deepmd-functional-form
    a mlips:FunctionalForm ;
    rdfs:label "Per-atom DNN over local-frame radial+angular descriptors (1/R, x/R, y/R, z/R) sorted by chemical species, 5 hidden layers (240, 120, 60, 30, 10) with tanh activations" .
ex:deepmd-kit-impl
    a mlips:Implementation ;
    mlips:implementedIn ex:lib-deepmd-kit ;
    mlips:version "0.1" .
ex:deepmd-loss-wang2018
    a mlips:LossFunction ;
    rdfs:label "Weighted MSE on energy and force (no virial), with annealed prefactors (p_e: 0.02 -> 8; p_f: 1000 -> 1; p_v: 0)" .
ex:lib-deepmd-kit
    a mlips:Library ;
    rdfs:label "DeePMD-kit (Python/C++ on TensorFlow, with LAMMPS pair_style deepmd and i-PI dp_ipi clients)" .
