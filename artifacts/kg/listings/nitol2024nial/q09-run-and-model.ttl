@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-mtp-NiAl-nitol2024nial
    a mlips:TrainedModel ;
    rdfs:label "Optimised MTP for Ni-Al alloys (2653 basis set, 5.4 A cutoff)" .
ex:run-mtp-NiAl-nitol2024nial
    a mlips:MLIPRun ;
    rdfs:label "MTP training run (2653 basis set, r_cut=5.4 A) on the Ni-Al training set" ;
    mlips:appliesMethod ex:MTP-nitol2024nial ;
    mlips:hasHyperparameterSetting ex:setting-levmax-2653-nitol2024nial, ex:setting-max-body-order-5-nitol2024nial, ex:setting-num-linear-params-2653-nitol2024nial, ex:setting-num-radial-8-nitol2024nial, ex:setting-rcut-5_4-nitol2024nial ;
    mlips:produces ex:model-mtp-NiAl-nitol2024nial ;
    mlips:runsOn ex:ds-NiAl-nitol2024nial .
