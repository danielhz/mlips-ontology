@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-rmse-energy-nitol2024nial
    a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on energy per atom (Ni-Al validation set, 815 configs)" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 1.64 .
ex:metric-rmse-force-nitol2024nial
    a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on force components (Ni-Al validation set)" ;
    mlips:hasUnit unit:EV-PER-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 0.028 .
ex:metric-rmse-stress-nitol2024nial
    a mlips:AccuracyMetric ;
    rdfs:label "Validation RMSE on stress components (Ni-Al validation set)" ;
    mlips:hasUnit unit:GigaPA ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 0.09 .
ex:result-rmse-energy-nitol2024nial
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-NiAl-nitol2024nial ;
    mlips:hasAccuracyMetric ex:metric-rmse-energy-nitol2024nial ;
    mlips:targetMaterial ex:mat-NiAl-nitol2024nial .
ex:result-rmse-force-nitol2024nial
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-NiAl-nitol2024nial ;
    mlips:hasAccuracyMetric ex:metric-rmse-force-nitol2024nial ;
    mlips:targetMaterial ex:mat-NiAl-nitol2024nial .
ex:result-rmse-stress-nitol2024nial
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-NiAl-nitol2024nial ;
    mlips:hasAccuracyMetric ex:metric-rmse-stress-nitol2024nial ;
    mlips:targetMaterial ex:mat-NiAl-nitol2024nial .
ex:study-nitol2024nial
    mlips:hasResult ex:result-rmse-energy-nitol2024nial, ex:result-rmse-force-nitol2024nial, ex:result-rmse-stress-nitol2024nial .
