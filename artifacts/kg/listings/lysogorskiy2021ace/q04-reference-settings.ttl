@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:dft-Cu-lysogorskiy2021ace
    mlips:hasDFTSettings ex:dft-settings-Cu-lysogorskiy2021ace .
ex:dft-Si-lysogorskiy2021ace
    mlips:hasDFTSettings ex:dft-settings-Si-lysogorskiy2021ace .
ex:dft-settings-Cu-lysogorskiy2021ace
    a mlips:DFTSettings ;
    mlips:usedDFTCode ex:lib-fhi-aims-lysogorskiy2021ace ;
    mlips:xcFunctional mlips:PBE .
ex:dft-settings-Si-lysogorskiy2021ace
    a mlips:DFTSettings ;
    rdfs:comment "Inherited from the Bartok et al. 2018 GAP-Si reference database." ;
    mlips:usedDFTCode ex:lib-castep-lysogorskiy2021ace ;
    mlips:xcFunctional mlips:PW91 .
ex:lib-castep-lysogorskiy2021ace
    a mlips:Library ;
    rdfs:label "CASTEP (used for the Si reference data, via the GAP-Si database of Bartok et al. 2018)" ;
    schema:url <http://www.castep.org> .
ex:lib-fhi-aims-lysogorskiy2021ace
    a mlips:Library ;
    rdfs:label "FHI-aims (used for the Cu reference data)" .
