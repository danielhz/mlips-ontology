@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-ace-Cu-lysogorskiy2021ace
    a mlips:TrainedModel ;
    rdfs:label "PACE-Cu (general-purpose ACE for fcc copper)" .
ex:model-ace-Si-lysogorskiy2021ace
    a mlips:TrainedModel ;
    rdfs:label "PACE-Si (linear ACE matching GAP-Si accuracy)" .
ex:run-ace-Cu-lysogorskiy2021ace
    a mlips:MLIPRun ;
    rdfs:label "PACE-Cu fitting run (nonlinear two-density Finnis-Sinclair embedding)" ;
    mlips:appliesMethod ex:ACE-lysogorskiy2021ace ;
    mlips:hasHyperparameterSetting ex:setting-nbasis-Cu-lysogorskiy2021ace, ex:setting-rcut-Cu-lysogorskiy2021ace ;
    mlips:produces ex:model-ace-Cu-lysogorskiy2021ace ;
    mlips:runsOn ex:ds-Cu-lysogorskiy2021ace .
ex:run-ace-Si-lysogorskiy2021ace
    a mlips:MLIPRun ;
    rdfs:label "PACE-Si fitting run (linear ACE, nu_max=4)" ;
    mlips:appliesMethod ex:ACE-lysogorskiy2021ace ;
    mlips:hasHyperparameterSetting ex:setting-bodyorder-Si-lysogorskiy2021ace, ex:setting-nbasis-Si-lysogorskiy2021ace ;
    mlips:produces ex:model-ace-Si-lysogorskiy2021ace ;
    mlips:runsOn ex:ds-Si-lysogorskiy2021ace .
