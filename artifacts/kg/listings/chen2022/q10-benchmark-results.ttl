@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-mae-energy-chen2022
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on energy per atom (MPF.2021.2.8 held-out)" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 35 .
ex:metric-mae-force-chen2022
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on force components (MPF.2021.2.8 held-out)" ;
    mlips:hasUnit unit:MeV-PER-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 72 .
ex:metric-mae-stress-chen2022
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on stress components (MPF.2021.2.8 held-out)" ;
    mlips:hasUnit unit:GigaPA ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 0.41 .
ex:result-mae-energy-chen2022
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-m3gnet-chen2022 ;
    mlips:hasAccuracyMetric ex:metric-mae-energy-chen2022 ;
    mlips:targetMaterial ex:mat-MP-universal-chen2022 .
ex:result-mae-force-chen2022
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-m3gnet-chen2022 ;
    mlips:hasAccuracyMetric ex:metric-mae-force-chen2022 ;
    mlips:targetMaterial ex:mat-MP-universal-chen2022 .
ex:result-mae-stress-chen2022
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-m3gnet-chen2022 ;
    mlips:hasAccuracyMetric ex:metric-mae-stress-chen2022 ;
    mlips:targetMaterial ex:mat-MP-universal-chen2022 .
ex:study-chen2022
    mlips:hasResult ex:result-mae-energy-chen2022, ex:result-mae-force-chen2022, ex:result-mae-stress-chen2022 .
