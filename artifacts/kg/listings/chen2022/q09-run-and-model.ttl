@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-m3gnet-chen2022
    a mlips:TrainedModel ;
    rdfs:label "M3GNet universal IAP (M3GNet-EFS) trained on MPF.2021.2.8" .
ex:run-m3gnet-chen2022
    a mlips:MLIPRun ;
    rdfs:label "M3GNet-EFS training run on MPF.2021.2.8" ;
    mlips:appliesMethod ex:M3GNet ;
    mlips:hasHyperparameterSetting ex:setting-3body-cutoff-4-chen2022, ex:setting-embedding-dim-64-chen2022, ex:setting-num-blocks-3-chen2022, ex:setting-num-radial-basis-3-chen2022, ex:setting-rcut-5-chen2022 ;
    mlips:produces ex:model-m3gnet-chen2022 ;
    mlips:runsOn ex:ds-MPF-2021-2-8 .
