@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-mae-energy-deng2023
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on energy per atom (MPtrj test split, 157,955 structures from 14,572 materials, with-magmom CHGNet)" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 30 .
ex:metric-mae-force-deng2023
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on force components (MPtrj test split, with-magmom CHGNet)" ;
    mlips:hasUnit unit:MeV-PER-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 77 .
ex:metric-mae-stress-deng2023
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on stress components (MPtrj test split, with-magmom CHGNet)" ;
    mlips:hasUnit unit:GigaPA ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 0.348 .
ex:result-mae-energy-deng2023
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-chgnet-deng2023 ;
    mlips:hasAccuracyMetric ex:metric-mae-energy-deng2023 ;
    mlips:targetMaterial ex:mat-MP-universal-deng2023 .
ex:result-mae-force-deng2023
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-chgnet-deng2023 ;
    mlips:hasAccuracyMetric ex:metric-mae-force-deng2023 ;
    mlips:targetMaterial ex:mat-MP-universal-deng2023 .
ex:result-mae-stress-deng2023
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-chgnet-deng2023 ;
    mlips:hasAccuracyMetric ex:metric-mae-stress-deng2023 ;
    mlips:targetMaterial ex:mat-MP-universal-deng2023 .
ex:study-deng2023
    mlips:hasResult ex:result-mae-energy-deng2023, ex:result-mae-force-deng2023, ex:result-mae-stress-deng2023 .
