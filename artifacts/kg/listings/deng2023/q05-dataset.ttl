@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:ds-MPtrj
    a mlips:TrainingDataset ;
    rdfs:label "MPtrj: 1,580,395 atomic configurations from 145,923 Materials Project compounds, with energies, forces, stresses, and 7,944,833 site magnetic moments" ;
    mlips:coversMaterial ex:mat-MP-universal-deng2023 ;
    mlips:coversProperty mlips:Energy, mlips:Forces, mlips:Stresses ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation ex:dft-deng2023 ;
    mlips:numConfigurations 1580395 .
