@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:CHGNet
    a mlips:MLIPMethod ;
    rdfs:label "CHGNet: Crystal Hamiltonian Graph neural Network with charge-informed (magmom) outputs" ;
    mlips:hasFunctionalForm ex:chgnet-functional-form ;
    mlips:hasHyperparameter ex:hp-batch-size-deng2023, ex:hp-bond-cutoff-deng2023, ex:hp-feature-dim-deng2023, ex:hp-initial-lr-deng2023, ex:hp-num-conv-layers-deng2023, ex:hp-rcut-deng2023 ;
    mlips:hasImplementation ex:chgnet-impl-deng2023 ;
    mlips:hasLossFunction ex:chgnet-huber-loss ;
    mlips:hasTrainingAlgorithm ex:adam-deng2023 .
ex:adam-deng2023
    a mls:Algorithm ;
    rdfs:label "Adam optimiser with CosineAnnealingLR scheduler (initial lr=1e-3, decays to 1e-5 by epoch 20, learning rate adjusted ten times per epoch)" .
ex:chgnet-functional-form
    a mlips:FunctionalForm ;
    rdfs:label "Two-graph (atom + bond) message-passing neural network with explicit angle features, atom/bond/angle convolution blocks, magmom regularisation of the latent atom features, and energy/force/stress/magmom outputs (forces and stresses by auto-differentiation of total energy)." .
ex:chgnet-huber-loss
    a mlips:LossFunction ;
    rdfs:label "Huber loss (delta=0.1) on energy, forces, stresses, and magnetic moments with weights w_E=1, w_f=1, w_sigma=0.1, w_m=0.1" .
ex:chgnet-impl-deng2023
    a mlips:Implementation ;
    mlips:implementedIn ex:lib-chgnet ;
    mlips:version "PyTorch 1.12.0" .
ex:lib-chgnet
    a mlips:Library ;
    rdfs:label "CHGNet (PyTorch)" ;
    schema:url <https://github.com/CederGroupHub/chgnet> .
