@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-batch-size-40-deng2023
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-batch-size-deng2023 ;
    mlips:settingValue "40" .
ex:setting-bond-cutoff-3-deng2023
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-bond-cutoff-deng2023 ;
    mlips:settingValue "3.0" .
ex:setting-feature-dim-64-deng2023
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-feature-dim-deng2023 ;
    mlips:settingValue "64" .
ex:setting-initial-lr-1e-3-deng2023
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-initial-lr-deng2023 ;
    mlips:settingValue "0.001" .
ex:setting-num-conv-layers-4-deng2023
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-num-conv-layers-deng2023 ;
    mlips:settingValue "4" .
ex:setting-rcut-5-deng2023
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-deng2023 ;
    mlips:settingValue "5.0" .
