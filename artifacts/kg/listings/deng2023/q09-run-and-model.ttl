@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-chgnet-deng2023
    a mlips:TrainedModel ;
    rdfs:label "CHGNet pretrained universal MLIP (with magmoms, 400,438 trainable parameters)" .
ex:run-chgnet-deng2023
    a mlips:MLIPRun ;
    rdfs:label "CHGNet (with-magmom) training run on MPtrj" ;
    mlips:appliesMethod ex:CHGNet ;
    mlips:hasHyperparameterSetting ex:setting-batch-size-40-deng2023, ex:setting-bond-cutoff-3-deng2023, ex:setting-feature-dim-64-deng2023, ex:setting-initial-lr-1e-3-deng2023, ex:setting-num-conv-layers-4-deng2023, ex:setting-rcut-5-deng2023 ;
    mlips:produces ex:model-chgnet-deng2023 ;
    mlips:runsOn ex:ds-MPtrj .
