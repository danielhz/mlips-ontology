@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-F-64
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-F ;
    mlips:settingValue "64" .
ex:setting-T-6
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-T ;
    mlips:settingValue "6" .
ex:setting-rho-001
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rho ;
    mlips:settingValue "0.01" .
