@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:ds-md17-schutt2018
    a mlips:TrainingDataset ;
    rdfs:label "MD17 reference set, used at N=1000 and N=50000 training sizes" ;
    mlips:coversMaterial ex:mat-md17-schutt2018 ;
    mlips:coversProperty mlips:Energy, mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation ex:dft-schutt2018 ;
    mlips:numConfigurations 50000 .
