@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-mae-md17-energy
    a mlips:AccuracyMetric ;
    rdfs:label "MAE of total energy on MD17 aspirin (N=50000, energy+forces loss)" ;
    mlips:hasUnit unit:KiloCAL-PER-MOL ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 0.12 .
ex:metric-mae-md17-forces
    a mlips:AccuracyMetric ;
    rdfs:label "MAE of atomic forces on MD17 aspirin (N=50000, energy+forces loss)" ;
    mlips:hasUnit unit:KiloCAL-PER-MOL-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 0.33 .
ex:result-md17-energy
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-schnet-md17 ;
    mlips:hasAccuracyMetric ex:metric-mae-md17-energy ;
    mlips:targetMaterial ex:mat-md17-schutt2018 .
ex:result-md17-forces
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-schnet-md17 ;
    mlips:hasAccuracyMetric ex:metric-mae-md17-forces ;
    mlips:targetMaterial ex:mat-md17-schutt2018 .
ex:study-schutt2018
    mlips:hasResult ex:result-md17-energy, ex:result-md17-forces .
