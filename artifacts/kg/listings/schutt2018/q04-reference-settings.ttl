@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:dft-schutt2018
    mlips:hasDFTSettings ex:dft-settings-schutt2018 .
ex:dft-settings-schutt2018
    a mlips:DFTSettings ;
    rdfs:comment "Tkatchenko-Scheffler dispersion correction (PBE+vdW-TS)." ;
    mlips:usedDFTCode ex:lib-fhi-aims ;
    mlips:xcFunctional mlips:PBE .
ex:lib-fhi-aims
    a mlips:Library ;
    rdfs:label "FHI-aims" .
