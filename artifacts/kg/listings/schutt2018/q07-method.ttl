@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:SchNet
    a mlips:MLIPMethod ;
    rdfs:label "SchNet (continuous-filter convolutional deep neural network)" ;
    mlips:hasFunctionalForm ex:schnet-functional-form ;
    mlips:hasHyperparameter ex:hp-F, ex:hp-T, ex:hp-rcut, ex:hp-rho ;
    mlips:hasImplementation ex:schnet-impl ;
    mlips:hasLossFunction ex:schnet-loss-energy-force ;
    mlips:hasTrainingAlgorithm ex:adam .
ex:adam
    a mls:Algorithm ;
    rdfs:label "ADAM optimizer with mini-batches of 32, exponential learning-rate decay (ratio 0.96 per 100k steps)" .
ex:lib-schnet
    a mlips:Library ;
    rdfs:label "SchNet reference implementation" .
ex:schnet-functional-form
    a mlips:FunctionalForm ;
    rdfs:label "Atom embeddings + interaction blocks with continuous-filter convolutions; per-atom energy via atom-wise dense layers, summed for total energy" .
ex:schnet-impl
    a mlips:Implementation ;
    mlips:implementedIn ex:lib-schnet .
ex:schnet-loss-energy-force
    a mlips:LossFunction ;
    rdfs:label "Combined squared-error loss on energies and forces with trade-off rho=0.01" .
