@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:dft-settings-shapeev2016
    a mlips:DFTSettings ;
    rdfs:comment "CASTEP-default norm-conserving pseudopotentials." ;
    mlips:kPointMesh "Brillouin-zone meshes converged per-cell; finite-temperature electronic broadening at 1000 K" ;
    mlips:pseudopotentialType mlips:NormConserving ;
    mlips:usedDFTCode ex:lib-castep-shapeev2016 ;
    mlips:xcFunctional mlips:PBE .
ex:dft-shapeev2016
    mlips:hasDFTSettings ex:dft-settings-shapeev2016 .
ex:lib-castep-shapeev2016
    a mlips:Library ;
    rdfs:label "CASTEP" ;
    schema:url <http://www.castep.org> .
