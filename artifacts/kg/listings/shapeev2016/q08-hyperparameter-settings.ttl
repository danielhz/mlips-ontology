@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-mtp1-shapeev2016
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-levmax-shapeev2016 ;
    mlips:settingValue "MTP_1: deg(B_alpha)+8(#alpha) <= 62, #alpha <= 4, mu <= 5, nu <= 4 (11133 basis functions)" .
ex:setting-mtp2-shapeev2016
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-levmax-shapeev2016 ;
    mlips:settingValue "MTP_2: deg(B_alpha)+8(#alpha) <= 52, #alpha <= 5, mu <= 3, nu <= 5; 760 basis functions extracted via l_0 regularisation (N_cap=4)" .
ex:setting-rcut-shapeev2016
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-shapeev2016 ;
    mlips:settingValue "4.9" .
ex:setting-rmin-shapeev2016
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rmin-shapeev2016 ;
    mlips:settingValue "1.9" .
