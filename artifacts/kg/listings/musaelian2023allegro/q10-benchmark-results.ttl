@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-mae-Li3PO4-energy
    a mlips:AccuracyMetric ;
    rdfs:label "MAE on Li3PO4 quenched-state energies" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 1.7 .
ex:metric-mae-Li3PO4-forces
    a mlips:AccuracyMetric ;
    rdfs:label "MAE on Li3PO4 quenched-state force components" ;
    mlips:hasUnit unit:MilliEV-PER-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 75.7 .
ex:result-allegro-Li3PO4-energy
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-allegro-Li3PO4 ;
    mlips:hasAccuracyMetric ex:metric-mae-Li3PO4-energy ;
    mlips:targetMaterial ex:mat-Li3PO4 .
ex:result-allegro-Li3PO4-forces
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-allegro-Li3PO4 ;
    mlips:hasAccuracyMetric ex:metric-mae-Li3PO4-forces ;
    mlips:targetMaterial ex:mat-Li3PO4 .
ex:study-musaelian2023allegro
    mlips:hasResult ex:result-allegro-Li3PO4-energy, ex:result-allegro-Li3PO4-forces .
