@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-allegro-Li3PO4
    a mlips:TrainedModel ;
    rdfs:label "Allegro Li3PO4 model (3 layers, lmax=3, 128 features)" .
ex:run-allegro-Li3PO4
    a mlips:MLIPRun ;
    rdfs:label "Allegro training run on Li3PO4 melt+quench (3 layers, lmax=3, 128 features)" ;
    mlips:appliesMethod ex:Allegro ;
    mlips:hasHyperparameterSetting ex:setting-features-allegro, ex:setting-lmax-allegro, ex:setting-numbasis-allegro, ex:setting-numlayers-allegro, ex:setting-rcut-allegro ;
    mlips:produces ex:model-allegro-Li3PO4 ;
    mlips:runsOn ex:ds-Li3PO4 .
