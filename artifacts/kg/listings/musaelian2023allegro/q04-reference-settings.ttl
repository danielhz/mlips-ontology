@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:dft-musaelian2023allegro
    mlips:hasDFTSettings ex:dft-settings-musaelian2023allegro .
ex:dft-settings-musaelian2023allegro
    a mlips:DFTSettings ;
    mlips:energyCutoff 400 ;
    mlips:kPointMesh "Gamma-point only" ;
    mlips:pseudopotentialType mlips:PAW ;
    mlips:usedDFTCode ex:lib-vasp ;
    mlips:xcFunctional mlips:PBE .
ex:lib-vasp
    a mlips:Library ;
    rdfs:label "VASP" .
