@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-features-allegro
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-features ;
    mlips:settingValue "128" .
ex:setting-lmax-allegro
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-lmax ;
    mlips:settingValue "3" .
ex:setting-numbasis-allegro
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-numbasis ;
    mlips:settingValue "8" .
ex:setting-numlayers-allegro
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-numlayers ;
    mlips:settingValue "3" .
ex:setting-rcut-allegro
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut ;
    mlips:settingValue "6.0" .
