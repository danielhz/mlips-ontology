@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-Mthresh-025
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-Mthresh ;
    mlips:settingValue "0.25" .
ex:setting-hidden-20-15-10
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-hidden-eckhoff2021 ;
    mlips:settingValue "3 hidden layers x (20, 15, 10) neurons per element" .
ex:setting-rcut-105-eckhoff2021
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-eckhoff2021 ;
    mlips:settingValue "10.5 a0 (Bohr radii)" .
