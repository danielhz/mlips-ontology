@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-mhdnnp-MnO
    a mlips:TrainedModel ;
    rdfs:label "Magnetic HDNNP for MnO (sACSF + 3-layer feed-forward NN)" .
ex:run-mhdnnp-MnO
    a mlips:MLIPRun ;
    rdfs:label "mHDNNP training run on MnO/Mn_{0.969}O dataset" ;
    mlips:appliesMethod ex:mHDNNP ;
    mlips:hasHyperparameterSetting ex:setting-Mthresh-025, ex:setting-hidden-20-15-10, ex:setting-rcut-105-eckhoff2021 ;
    mlips:produces ex:model-mhdnnp-MnO ;
    mlips:runsOn ex:ds-MnO-eckhoff2021 .
