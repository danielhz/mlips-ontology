@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:ds-TiAl
    a mlips:TrainingDataset ;
    rdfs:label "Ti-Al MTP training set (33 polymorphs + 2160 AIMD + 185 surfaces + 580 solid-solutions + 840 strained = 3798 configs)" ;
    mlips:coversMaterial ex:mat-TiAl ;
    mlips:coversProperty mlips:Energy, mlips:Forces ;
    mlips:datasetProvenance mlips:Published ;
    mlips:hasDFTCalculation ex:dft-qi2023 ;
    mlips:numConfigurations 3798 .
