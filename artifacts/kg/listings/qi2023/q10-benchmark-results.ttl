@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-mae-polymorph
    a mlips:AccuracyMetric ;
    rdfs:label "MAE on formation energies of polymorph structures (vs. DFT)" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 18 .
ex:metric-mae-surface
    a mlips:AccuracyMetric ;
    rdfs:label "MAE on formation energies of surface structures (vs. DFT)" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 8 .
ex:result-mtp-polymorph
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TiAl ;
    mlips:hasAccuracyMetric ex:metric-mae-polymorph ;
    mlips:targetMaterial ex:mat-TiAl .
ex:result-mtp-surface
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TiAl ;
    mlips:hasAccuracyMetric ex:metric-mae-surface ;
    mlips:targetMaterial ex:mat-TiAl .
ex:study-qi2023
    mlips:hasResult ex:result-mtp-polymorph, ex:result-mtp-surface .
