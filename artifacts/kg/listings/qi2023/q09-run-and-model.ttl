@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-mtp-TiAl
    a mlips:TrainedModel ;
    rdfs:label "Ti-Al MTP (rcut=4.8 Ang, levmax=22)" .
ex:run-mtp-TiAl
    a mlips:MLIPRun ;
    rdfs:label "MTP training run, Ti-Al binary" ;
    mlips:appliesMethod ex:MTP ;
    mlips:hasHyperparameterSetting ex:setting-levmax-22, ex:setting-rcut-4_8 ;
    mlips:produces ex:model-mtp-TiAl ;
    mlips:runsOn ex:ds-TiAl .
