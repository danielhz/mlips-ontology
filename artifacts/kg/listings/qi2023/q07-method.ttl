@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:MTP
    a mlips:MLIPMethod ;
    rdfs:label "Moment Tensor Potential" ;
    mlips:hasFunctionalForm ex:mtp-functional-form ;
    mlips:hasHyperparameter ex:hp-levmax, ex:hp-rcut ;
    mlips:hasImplementation ex:mlip-package ;
    mlips:hasLossFunction ex:mtp-loss-100-1-0 .
ex:lib-mlip
    a mlips:Library ;
    rdfs:label "MLIP package" ;
    schema:url <https://gitlab.com/ashapeev/mlip-2> .
ex:mlip-package
    a mlips:Implementation ;
    mlips:implementedIn ex:lib-mlip .
ex:mtp-functional-form
    a mlips:FunctionalForm ;
    rdfs:label "MTP moment-tensor polynomial" .
ex:mtp-loss-100-1-0
    a mlips:LossFunction ;
    rdfs:label "Weighted MSE (energy 100, force 1, stress 0)" .
