@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-ANI1-smith2017
    a mlips:TrainedModel ;
    rdfs:label "ANI-1 potential (H/C/N/O)" .
ex:run-ANI1-smith2017
    a mlips:MLIPRun ;
    rdfs:label "ANI-1 training run on the ANI-1 dataset" ;
    mlips:appliesMethod ex:ANI-smith2017 ;
    mlips:hasHyperparameterSetting ex:setting-aev-smith2017, ex:setting-arch-smith2017, ex:setting-lr-smith2017, ex:setting-rcut-ang-smith2017, ex:setting-rcut-rad-smith2017 ;
    mlips:produces ex:model-ANI1-smith2017 ;
    mlips:runsOn ex:ds-ANI1-smith2017 .
