@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:ds-ANI1-smith2017
    a mlips:TrainingDataset ;
    rdfs:label "ANI-1 dataset: ~17.2 M conformations of ~57951 small molecules from GDB-11 (up to 8 heavy atoms; 80% used for training)" ;
    mlips:coversMaterial ex:mat-organic-smith2017 ;
    mlips:coversProperty mlips:Energy ;
    mlips:datasetProvenance mlips:InHouse ;
    mlips:hasDFTCalculation ex:dft-smith2017 ;
    mlips:numConfigurations 17200000 .
