@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:ANI-smith2017
    a mlips:MLIPMethod ;
    rdfs:label "ANI (ANAKIN-ME): atom-type-specific HDNNP using modified Behler-Parrinello atomic environment vectors (AEVs)" ;
    mlips:hasFunctionalForm ex:ani-functional-form-smith2017 ;
    mlips:hasHyperparameter ex:hp-aev-smith2017, ex:hp-arch-smith2017, ex:hp-lr-smith2017, ex:hp-rcut-ang-smith2017, ex:hp-rcut-rad-smith2017 ;
    mlips:hasImplementation ex:impl-neurochem-smith2017 ;
    mlips:hasLossFunction ex:ani-loss-smith2017 ;
    mlips:hasTrainingAlgorithm ex:adam-smith2017 .
ex:adam-smith2017
    a mls:Algorithm ;
    rdfs:label "ADAM (lr=1e-3, beta1=0.9, beta2=0.999, eps=1e-8) with max-norm regularisation (3.0); 6 lr-decay restarts" .
ex:ani-functional-form-smith2017
    a mlips:FunctionalForm ;
    rdfs:label "Total energy = sum over atoms of element-specific feed-forward NN outputs taking modified BP atomic environment vectors as input (radial: shifted Gaussians; angular: shifted-cosine + radial-shell factor; atom-type-differentiated channels)" .
ex:ani-loss-smith2017
    a mlips:LossFunction ;
    rdfs:label "Exponential cost C = tau * exp((1/tau) * sum_j (E^ANI_j - E^DFT_j)^2), tau = 0.5 (robust to outliers)" .
ex:impl-neurochem-smith2017
    a mlips:Implementation ;
    mlips:implementedIn ex:lib-neurochem-smith2017 .
ex:lib-neurochem-smith2017
    a mlips:Library ;
    rdfs:label "NeuroChem (in-house C/C++/CUDA GPU package; AEVs computed by AEVLib; CUBLAS-accelerated)" .
