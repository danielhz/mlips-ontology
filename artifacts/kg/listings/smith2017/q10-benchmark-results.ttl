@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-rmse-gdb10-smith2017
    a mlips:AccuracyMetric ;
    rdfs:label "Total-energy RMSE on the GDB-10 transferability test (134 molecules of 10 heavy atoms; molecules outside the training distribution)" ;
    mlips:hasUnit unit:KiloCAL-PER-MOL ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 1.9 .
ex:metric-rmse-test-smith2017
    a mlips:AccuracyMetric ;
    rdfs:label "Total-energy RMSE on the ANI-1 held-out test set (vs. wB97X/6-31G(d))" ;
    mlips:hasUnit unit:KiloCAL-PER-MOL ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 1.3 .
ex:metric-rmse-train-smith2017
    a mlips:AccuracyMetric ;
    rdfs:label "Total-energy RMSE on the ANI-1 training set (vs. wB97X/6-31G(d))" ;
    mlips:hasUnit unit:KiloCAL-PER-MOL ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 1.2 .
ex:result-ANI1-gdb10-smith2017
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-ANI1-smith2017 ;
    mlips:hasAccuracyMetric ex:metric-rmse-gdb10-smith2017 ;
    mlips:targetMaterial ex:mat-organic-smith2017 .
ex:result-ANI1-test-smith2017
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-ANI1-smith2017 ;
    mlips:hasAccuracyMetric ex:metric-rmse-test-smith2017 ;
    mlips:targetMaterial ex:mat-organic-smith2017 .
ex:result-ANI1-train-smith2017
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-ANI1-smith2017 ;
    mlips:hasAccuracyMetric ex:metric-rmse-train-smith2017 ;
    mlips:targetMaterial ex:mat-organic-smith2017 .
ex:study-smith2017
    mlips:hasResult ex:result-ANI1-gdb10-smith2017, ex:result-ANI1-test-smith2017, ex:result-ANI1-train-smith2017 .
