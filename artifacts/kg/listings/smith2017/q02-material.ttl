@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:mat-organic-smith2017
    a mlips:MaterialSystem ;
    rdfs:label "Organic molecules (H, C, N, O)" ;
    mlips:chemicalFormula "H,C,N,O molecular space" ;
    mlips:materialClass "Molecular: neutral closed-shell organic molecules in the singlet spin state, configurations drawn from GDB-11 (up to 8 heavy atoms in training; benchmarked on molecules with up to 54 atoms)" .
