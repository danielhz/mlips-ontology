@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-aev-smith2017
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-aev-smith2017 ;
    mlips:settingValue "32 radial shifts, 8 radial + 8 angular shifts -> 768 AEV elements for 4 atom types" .
ex:setting-arch-smith2017
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-arch-smith2017 ;
    mlips:settingValue "Per-atom-type pyramidal NN 768:128:128:64:1 (Gaussian activations, linear output); 124033 parameters per element" .
ex:setting-lr-smith2017
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-lr-smith2017 ;
    mlips:settingValue "Initial learning rate 1e-3 (mini-batch size 1024 molecules; 100-epoch validation patience)" .
ex:setting-rcut-ang-smith2017
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-ang-smith2017 ;
    mlips:settingValue "3.1" .
ex:setting-rcut-rad-smith2017
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-rad-smith2017 ;
    mlips:settingValue "4.6" .
