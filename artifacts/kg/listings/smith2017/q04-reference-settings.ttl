@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:basis-6-31g-d-smith2017
    a mlips:DftBasisSet ;
    rdfs:comment "Pople-style split-valence double-zeta Gaussian basis with d polarisation on heavy atoms; molecular all-electron DFT." ;
    rdfs:label "6-31G(d)" ;
    mlips:candidateForVocabulary mlips:DftBasisSet .
ex:dft-settings-smith2017
    a mlips:DFTSettings ;
    rdfs:comment "Range-separated hybrid meta-GGA. All-electron Gaussian-type basis (no pseudopotential)." ;
    mlips:dftBasisSet ex:basis-6-31g-d-smith2017 ;
    mlips:kPointMesh "Molecular calculations (no Brillouin-zone sampling); ultra-fine DFT integration grid" ;
    mlips:usedDFTCode ex:lib-gaussian09-smith2017 ;
    mlips:xcFunctional mlips:omegaB97X .
ex:dft-smith2017
    mlips:hasDFTSettings ex:dft-settings-smith2017 .
ex:lib-gaussian09-smith2017
    a mlips:Library ;
    rdfs:label "Gaussian 09 (with the 6-31G(d) Pople basis set)" .
