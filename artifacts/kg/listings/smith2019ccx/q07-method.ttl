@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:ANI-smith2019ccx
    a mlips:MLIPMethod ;
    rdfs:label "ANI (Behler-Parrinello-style HDNN with ANI symmetry functions)" ;
    mlips:hasFunctionalForm ex:ani-form-smith2019ccx ;
    mlips:hasHyperparameter ex:hp-cutoff-smith2019ccx ;
    mlips:hasImplementation ex:torchani-smith2019ccx ;
    mlips:hasLossFunction ex:ani-loss-smith2019ccx ;
    mlips:hasTrainingAlgorithm ex:adam-smith2019ccx .
ex:adam-smith2019ccx
    a mls:Algorithm ;
    rdfs:label "Adam (with exponential learning-rate decay)" .
ex:ani-form-smith2019ccx
    a mlips:FunctionalForm ;
    rdfs:label "Per-element fully-connected feed-forward subnetwork operating on ANI atom-centred symmetry functions; total energy is a sum of per-atom contributions" .
ex:ani-loss-smith2019ccx
    a mlips:LossFunction ;
    rdfs:label "Energy-only MSE on per-molecule total energies (no force or stress targets)" .
ex:lib-torchani-smith2019ccx
    a mlips:Library ;
    rdfs:label "TorchANI / ANI training scripts (Python on PyTorch)" ;
    schema:url <https://github.com/aiqm/torchani> .
ex:torchani-smith2019ccx
    a mlips:Implementation ;
    mlips:implementedIn ex:lib-torchani-smith2019ccx .
