@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-gap-Si
    a mlips:TrainedModel ;
    rdfs:label "GAP-6 silicon potential" .
ex:run-gap-Si
    a mlips:MLIPRun ;
    rdfs:label "GAP training run on the general-purpose Si database" ;
    mlips:appliesMethod ex:GAP ;
    mlips:hasHyperparameterSetting ex:setting-M-9000, ex:setting-delta-3, ex:setting-rcut-5-bartok2018si, ex:setting-sigma-atom-05, ex:setting-zeta-4 ;
    mlips:produces ex:model-gap-Si ;
    mlips:runsOn ex:ds-Si-bartok2018 .
