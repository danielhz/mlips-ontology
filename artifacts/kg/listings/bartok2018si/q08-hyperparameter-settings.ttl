@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-M-9000
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-M ;
    mlips:settingValue "9000" .
ex:setting-delta-3
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-delta ;
    mlips:settingValue "3" .
ex:setting-rcut-5-bartok2018si
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut-bartok2018si ;
    mlips:settingValue "5.0" .
ex:setting-sigma-atom-05
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-sigma-atom ;
    mlips:settingValue "0.5" .
ex:setting-zeta-4
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-zeta ;
    mlips:settingValue "4" .
