@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-mtp-TaVCrW
    a mlips:TrainedModel ;
    rdfs:label "TaVCrW MTP" .
ex:run-mtp-TaVCrW
    a mlips:MLIPRun ;
    rdfs:label "MTP training run on the TaVCrW HEA dataset (6711 configurations)" ;
    mlips:appliesMethod ex:MTP ;
    mlips:hasHyperparameterSetting ex:setting-rcut-50-gubaev2023 ;
    mlips:produces ex:model-mtp-TaVCrW ;
    mlips:runsOn ex:ds-TaVCrW .
