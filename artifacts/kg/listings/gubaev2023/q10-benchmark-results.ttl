@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-rmse-energy-gubaev2023
    a mlips:AccuracyMetric ;
    rdfs:label "Overall RMSE in predicted energy across in-distribution Ta-V-Cr-W subsystems (Table 1, MTP)" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 2.43 .
ex:metric-rmse-forces-gubaev2023
    a mlips:AccuracyMetric ;
    rdfs:label "Overall RMSE in predicted atomic forces across in-distribution Ta-V-Cr-W subsystems (Table 1, MTP)" ;
    mlips:hasUnit unit:EV-PER-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:RMSE ;
    mlips:metricValue 0.054 .
ex:result-mtp-energy-gubaev2023
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TaVCrW ;
    mlips:hasAccuracyMetric ex:metric-rmse-energy-gubaev2023 ;
    mlips:targetMaterial ex:mat-TaVCrW .
ex:result-mtp-forces-gubaev2023
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mtp-TaVCrW ;
    mlips:hasAccuracyMetric ex:metric-rmse-forces-gubaev2023 ;
    mlips:targetMaterial ex:mat-TaVCrW .
ex:study-gubaev2023
    mlips:hasResult ex:result-mtp-energy-gubaev2023, ex:result-mtp-forces-gubaev2023 .
