@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:dft-behler2007
    mlips:hasDFTSettings ex:dft-settings-behler2007 .
ex:dft-settings-behler2007
    a mlips:DFTSettings ;
    rdfs:comment "Vanderbilt-style ultrasoft pseudopotential." ;
    mlips:energyCutoff 272 ;
    mlips:kPointMesh "3x3x3 k-point mesh, Fermi smearing 0.1 eV" ;
    mlips:pseudopotentialType mlips:Ultrasoft ;
    mlips:usedDFTCode ex:lib-pwscf ;
    mlips:xcFunctional mlips:LDA .
ex:lib-pwscf
    a mlips:Library ;
    rdfs:label "PWscf (Quantum ESPRESSO)" ;
    schema:url <http://www.pwscf.org> .
