@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-hdnnp-Si-behler2007
    a mlips:TrainedModel ;
    rdfs:label "Behler-Parrinello HDNNP for bulk silicon" .
ex:run-hdnnp-Si-behler2007
    a mlips:MLIPRun ;
    rdfs:label "HDNNP training run, bulk silicon" ;
    mlips:appliesMethod ex:HDNNP-behler2007 ;
    mlips:hasHyperparameterSetting ex:setting-numhidden-behler2007, ex:setting-numsf-behler2007, ex:setting-rcut-behler2007 ;
    mlips:produces ex:model-hdnnp-Si-behler2007 ;
    mlips:runsOn ex:ds-Si-behler2007 .
