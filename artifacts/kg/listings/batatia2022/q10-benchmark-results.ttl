@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-mae-rmd17-aspirin-energy
    a mlips:AccuracyMetric ;
    rdfs:label "MAE on aspirin energies, rMD17, 1000 train" ;
    mlips:hasUnit unit:MilliEV ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 2.2 .
ex:metric-mae-rmd17-aspirin-forces
    a mlips:AccuracyMetric ;
    rdfs:label "MAE on aspirin force components, rMD17, 1000 train" ;
    mlips:hasUnit unit:MilliEV-PER-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 6.6 .
ex:result-mace-rmd17-aspirin-energy
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mace-rMD17 ;
    mlips:hasAccuracyMetric ex:metric-mae-rmd17-aspirin-energy ;
    mlips:targetMaterial ex:mat-rMD17 .
ex:result-mace-rmd17-aspirin-forces
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mace-rMD17 ;
    mlips:hasAccuracyMetric ex:metric-mae-rmd17-aspirin-forces ;
    mlips:targetMaterial ex:mat-rMD17 .
ex:study-batatia2022
    mlips:hasResult ex:result-mace-rmd17-aspirin-energy, ex:result-mace-rmd17-aspirin-forces .
