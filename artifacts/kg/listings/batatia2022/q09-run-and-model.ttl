@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-mace-rMD17
    a mlips:TrainedModel ;
    rdfs:label "MACE rMD17 model (L=3, two-layer, 256 channels)" .
ex:run-mace-rMD17
    a mlips:MLIPRun ;
    rdfs:label "MACE training run on rMD17 (per-molecule, 1000 configs)" ;
    mlips:appliesMethod ex:MACE ;
    mlips:hasHyperparameterSetting ex:setting-channels-256, ex:setting-correlation-3, ex:setting-lmax-3, ex:setting-numlayers-2, ex:setting-rcut-5 ;
    mlips:produces ex:model-mace-rMD17 ;
    mlips:runsOn ex:ds-rMD17 .
