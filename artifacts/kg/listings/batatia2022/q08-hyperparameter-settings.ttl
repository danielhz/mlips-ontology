@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:setting-channels-256
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-channels ;
    mlips:settingValue "256" .
ex:setting-correlation-3
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-correlation-order ;
    mlips:settingValue "3" .
ex:setting-lmax-3
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-lmax ;
    mlips:settingValue "3" .
ex:setting-numlayers-2
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-numlayers ;
    mlips:settingValue "2" .
ex:setting-rcut-5
    a mlips:HyperparameterSetting ;
    mlips:forHyperparameter ex:hp-rcut ;
    mlips:settingValue "5.0" .
