@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:mat-rMD17
    a mlips:MaterialSystem ;
    rdfs:label "rMD17 small organic molecules (10 molecules: aspirin, azobenzene, benzene, ethanol, malonaldehyde, naphthalene, paracetamol, salicylic acid, toluene, uracil)" ;
    mlips:chemicalFormula "C,H,N,O" ;
    mlips:materialClass "Small organic molecules sampled from gas-phase ab initio MD trajectories" .
