@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:metric-mae-energy-batatia2024mp0
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on energy per atom (MPtrj held-out, MACE-MP-0 medium)" ;
    mlips:hasUnit unit:MeV-PER-ATOM ;
    mlips:metricProperty mlips:EnergyProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 18 .
ex:metric-mae-force-batatia2024mp0
    a mlips:AccuracyMetric ;
    rdfs:label "Test MAE on force components (MPtrj held-out, MACE-MP-0 medium)" ;
    mlips:hasUnit unit:MeV-PER-ANGSTROM ;
    mlips:metricProperty mlips:ForceProperty ;
    mlips:metricType mlips:MAE ;
    mlips:metricValue 39 .
ex:result-mae-energy-batatia2024mp0
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mace-mp-0-batatia2024mp0 ;
    mlips:hasAccuracyMetric ex:metric-mae-energy-batatia2024mp0 ;
    mlips:targetMaterial ex:mat-MP-universal-batatia2024mp0 .
ex:result-mae-force-batatia2024mp0
    a mlips:BenchmarkResult ;
    mlips:evaluatesModel ex:model-mace-mp-0-batatia2024mp0 ;
    mlips:hasAccuracyMetric ex:metric-mae-force-batatia2024mp0 ;
    mlips:targetMaterial ex:mat-MP-universal-batatia2024mp0 .
ex:study-batatia2024mp0
    mlips:hasResult ex:result-mae-energy-batatia2024mp0, ex:result-mae-force-batatia2024mp0 .
