@base <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix mlips: <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .
@prefix ex: <https://example.org/mlips/kg/> .
ex:model-mace-mp-0-batatia2024mp0
    a mlips:TrainedModel ;
    rdfs:label "MACE-MP-0b3 medium foundation model" .
ex:run-mace-mp-0-batatia2024mp0
    a mlips:MLIPRun ;
    rdfs:label "MACE-MP-0b3 (medium) training run on MPtrj" ;
    mlips:appliesMethod ex:MACE-MP-0 ;
    mlips:hasHyperparameterSetting ex:setting-correlation-order-3-batatia2024mp0, ex:setting-initial-lr-1e-3-batatia2024mp0, ex:setting-lmax-3-batatia2024mp0, ex:setting-mlp-hidden-3x64-batatia2024mp0, ex:setting-num-channels-128-batatia2024mp0, ex:setting-num-epochs-100-batatia2024mp0, ex:setting-num-layers-2-batatia2024mp0, ex:setting-num-radial-bessel-10-batatia2024mp0, ex:setting-rcut-6-batatia2024mp0 ;
    mlips:produces ex:model-mace-mp-0-batatia2024mp0 ;
    mlips:runsOn ex:ds-MPtrj-batatia2024mp0 .
