# Competency-question vocabulary + instances (Epic C, C1 design draft).
#
# Makes the nine competency questions (CQ1-CQ9, paper §3) first-class
# RDF instead of bare .rq files, so concon's generic doc view (their
# Epic B3) can render a competency-question section, and so the .rq
# files under cq-queries/ can be GENERATED from this file (RDF =
# source of truth; see Epic C2).
#
# DESIGN DECISIONS (for review; coordinate shape with @concon before
# encoding all nine + wiring the generator):
#
#  * Companion vocabulary, NOT folded into the domain ontology. CQs are
#    metadata *about* the ontology, not MLIP domain concepts, so they
#    get their own namespace `https://w3id.org/mlips/cq#` (prefix `cq:`)
#    and their own file. (The w3id sub-path redirect is Daniel's to
#    mint, like the main namespace.)
#  * `cq:sparqlQuery` stores the query VERBATIM (PREFIX + the hand-
#    written comment + SELECT) so generation is byte-exact and the
#    valuable per-query notes (e.g. the property-chain workaround in
#    CQ6/CQ7/CQ9) are preserved. `cq:questionText` carries the short
#    NL question separately for rendering. (Alternative: store body-
#    only and synthesise the header on generation -- open for @concon.)
#  * `cq:motivates` links each CQ to the ontology class(es) it
#    exercises, for cross-linking in the doc view.
#
# This draft encodes CQ1 (simple) and CQ8 (the simulation-types fix) as
# representative examples; the remaining seven follow the same shape
# once the shape is agreed.

@prefix cq:      <https://w3id.org/mlips/cq#> .
@prefix mlips:   <https://w3id.org/mlips#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

###############################################################################
# Vocabulary (schema)
###############################################################################

cq:CompetencyQuestion a owl:Class ;
    rdfs:label "Competency Question"@en ;
    rdfs:comment "A question the MLIPs ontology is designed to answer, paired with a SPARQL realisation and the ontology terms it exercises."@en .

cq:questionText a owl:DatatypeProperty ;
    rdfs:label "question text"@en ;
    rdfs:comment "The natural-language competency question."@en ;
    rdfs:domain cq:CompetencyQuestion ;
    rdfs:range xsd:string .

cq:sparqlQuery a owl:DatatypeProperty ;
    rdfs:label "SPARQL query"@en ;
    rdfs:comment "A SPARQL SELECT query realising the competency question against the dataset. Source of truth for the corresponding cq-queries/<id>.rq file (stored verbatim, including the leading comment)."@en ;
    rdfs:domain cq:CompetencyQuestion ;
    rdfs:range xsd:string .

cq:motivates a owl:ObjectProperty ;
    rdfs:label "motivates"@en ;
    rdfs:comment "An ontology class that this competency question exercises / motivates."@en ;
    rdfs:domain cq:CompetencyQuestion ;
    rdfs:range owl:Class .

###############################################################################
# Instances (CQ1 and CQ8 shown; CQ2-CQ7, CQ9 to follow after sign-off)
###############################################################################

cq:CQ1 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ1" ;
    rdfs:label "Method hyperparameters (name, datatype, default)"@en ;
    cq:questionText "Which MLIP methods exist, and what hyperparameters does each accept (name, datatype, default value)?" ;
    cq:motivates mlips:MLIPMethod, mlips:Hyperparameter ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ1: Which MLIP methods exist, and what hyperparameters does each
# accept (name, datatype, default value)?

SELECT ?algo ?hp ?name ?type ?default WHERE {
  ?algo a mlips:MLIPMethod ;
        mlips:hasHyperparameter ?hp .
  ?hp mlips:hyperparameterName ?name ;
      mlips:hyperparameterDatatype ?type .
  OPTIONAL { ?hp mlips:defaultValue ?default }
}
""" .

cq:CQ8 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ8" ;
    rdfs:label "Simulation types performed with each method"@en ;
    cq:questionText "Which simulation types (molecular dynamics, Monte Carlo, geometry optimisation, phonon calculations, thermodynamic integration) have been performed with a given MLIP?" ;
    cq:motivates mlips:MLIPMethod, mlips:SimulationType ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ8: Which simulation types (molecular dynamics, Monte Carlo,
# geometry optimisation, phonon calculations, thermodynamic
# integration) have been performed with a given MLIP?

SELECT ?algo ?sim WHERE {
  ?algo a mlips:MLIPMethod ;
        mlips:supportsSimulation ?sim .
}
""" .

cq:CQ2 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ2" ;
    rdfs:label "Implementations and library versions per method"@en ;
    cq:questionText "Which libraries implement a given method, and what versions are available?" ;
    cq:motivates mlips:MLIPMethod, mlips:Implementation, mlips:Library ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ2: Which libraries implement a given method, and what versions
# are available?

SELECT ?algo ?impl ?lib ?version WHERE {
  ?algo a mlips:MLIPMethod ;
        mlips:hasImplementation ?impl .
  ?impl mlips:implementedIn ?lib .
  OPTIONAL { ?impl mlips:version ?version }
}
""" .

cq:CQ3 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ3" ;
    rdfs:label "Training datasets and DFT settings for a material"@en ;
    cq:questionText "For a given material system, which training datasets are available, and what DFT code and settings were used?" ;
    cq:motivates mlips:TrainingDataset, mlips:DFTCalculation, mlips:MaterialSystem ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ3: For a given material system, which training datasets are
# available, and what DFT code and settings were used?
# (Generalised: returns rows for every material, not just TiCr2.)

SELECT ?ds ?mat ?xc ?cutoff ?pseudo WHERE {
  ?ds a mlips:TrainingDataset ;
      mlips:coversMaterial ?mat ;
      mlips:hasDFTCalculation ?calc .
  ?calc mlips:hasDFTSettings ?settings .
  ?settings mlips:xcFunctional ?xc .
  OPTIONAL { ?settings mlips:energyCutoff ?cutoff }
  OPTIONAL { ?settings mlips:pseudopotentialType ?pseudo }
}
""" .

cq:CQ4 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ4" ;
    rdfs:label "Provenance of each training dataset"@en ;
    cq:questionText "What is the provenance of each training dataset (published source, in-house calculation, augmented from existing data)?" ;
    cq:motivates mlips:TrainingDataset ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# CQ4: What is the provenance of each training dataset (published
# source, in-house calculation, augmented from existing data)?

SELECT ?ds ?label ?prov WHERE {
  ?ds a mlips:TrainingDataset ;
      mlips:datasetProvenance ?prov .
  OPTIONAL { ?ds rdfs:label ?label }
}
""" .

cq:CQ5 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ5" ;
    rdfs:label "Dataset size, covered properties, and sampling strategy"@en ;
    cq:questionText "How many configurations does a dataset contain, what properties are covered (energies, forces, stresses), and along which sampling strategy were the configurations drawn?" ;
    cq:motivates mlips:TrainingDataset ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ5: How many configurations does a dataset contain, what
# properties are covered (energies, forces, stresses), and along
# which sampling strategy were the configurations drawn?

SELECT ?ds ?nconfig ?prop ?sampling WHERE {
  ?ds a mlips:TrainingDataset .
  OPTIONAL { ?ds mlips:numConfigurations ?nconfig }
  OPTIONAL { ?ds mlips:coversProperty   ?prop }
  OPTIONAL { ?ds mlips:samplingStrategy ?sampling }
}
""" .

cq:CQ6 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ6" ;
    rdfs:label "Published benchmarks of a method on a material, with accuracy metrics"@en ;
    cq:questionText "Which published studies have benchmarked a given method on a given material property, and what accuracy metrics were reported?" ;
    cq:motivates mlips:BenchmarkStudy, mlips:BenchmarkResult, mlips:AccuracyMetric ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ6: Which published studies have benchmarked a given method on
# a given material property, and what accuracy metrics were
# reported? (Generalised: every method on every material; the
# inline version in §8.1 of the paper hardcodes MTP and TiCr2 as
# an example.)
#
# The schema declares trainedWith := appliesMethod ∘ produces^-1
# (a property chain). Without an OWL reasoner, queries that use
# trainedWith directly return 0 rows; this query traverses the
# asserted MLIPRun edge (?run appliesMethod ?algo, ?run produces
# ?model) so it works against a plain SPARQL endpoint.

SELECT ?study ?algo ?mat ?metric_type ?prop ?value WHERE {
  ?study a mlips:BenchmarkStudy ;
         mlips:hasResult ?result .
  ?result mlips:evaluatesModel ?model ;
          mlips:targetMaterial ?mat ;
          mlips:hasAccuracyMetric ?metric .
  ?run a mlips:MLIPRun ;
       mlips:produces ?model ;
       mlips:appliesMethod ?algo .
  ?metric mlips:metricType ?metric_type ;
          mlips:metricProperty ?prop ;
          mlips:metricValue ?value .
}
""" .

cq:CQ7 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ7" ;
    rdfs:label "Ranking method/hyperparameter combinations by accuracy for a material"@en ;
    cq:questionText "For a given material and target property, how do different method/hyperparameter combinations rank by accuracy?" ;
    cq:motivates mlips:BenchmarkResult, mlips:AccuracyMetric, mlips:MLIPMethod ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ7: For a given material and target property, how do different
# method/hyperparameter combinations rank by accuracy?
# (Generalised: groups by material + property, ranks by RMSE.)
#
# Same property-chain note as cq06.rq: traverses the asserted
# ?run appliesMethod ?algo + ?run produces ?model edges instead
# of relying on the inferred trainedWith chain.

SELECT ?mat ?prop ?algo ?value WHERE {
  ?result mlips:evaluatesModel ?model ;
          mlips:targetMaterial ?mat ;
          mlips:hasAccuracyMetric ?metric .
  ?run a mlips:MLIPRun ;
       mlips:produces ?model ;
       mlips:appliesMethod ?algo .
  ?metric mlips:metricType mlips:RMSE ;
          mlips:metricProperty ?prop ;
          mlips:metricValue ?value .
} ORDER BY ?mat ?prop ?value
""" .

cq:CQ9 a cq:CompetencyQuestion ;
    dcterms:identifier "CQ9" ;
    rdfs:label "Method efficiency: inference complexity, GPU hours, inference time"@en ;
    cq:questionText "For a given target accuracy, which methods and trained models are most efficient (asymptotic complexity plus measured training and inference cost)?" ;
    cq:motivates mlips:MLIPMethod, mlips:TrainedModel, mlips:MLIPRun ;
    cq:sparqlQuery """PREFIX mlips: <https://w3id.org/mlips#>

# CQ9: For a given target accuracy, which methods and trained
# models are most efficient? Combines asymptotic complexity (prior
# knowledge attached to the method) with measured training and
# inference cost (empirical data on the run).
#
# Same property-chain note as cq06/cq07: traverses ?run
# appliesMethod ?algo + ?run produces ?model on the asserted edges
# rather than the inferred trainedWith chain.
#
# Many fields are OPTIONAL: the seeded corpus reports
# inferenceTimePerAtom and gpuHours sparsely (a longstanding
# metadata gap in the source literature, see §5.1), so only the
# papers that report compute cost contribute rows.

SELECT ?algo ?inf_complexity ?gpu_hours ?t_inf ?rmse WHERE {
  ?result a mlips:BenchmarkResult ;
          mlips:evaluatesModel ?model ;
          mlips:hasAccuracyMetric ?metric .
  ?model mlips:inferenceTimePerAtom ?t_inf .
  ?metric mlips:metricType mlips:RMSE ;
          mlips:metricValue ?rmse .
  FILTER(?rmse < 2.0)
  ?run a mlips:MLIPRun ;
       mlips:produces ?model ;
       mlips:appliesMethod ?algo .
  OPTIONAL { ?algo mlips:inferenceComplexity ?inf_complexity }
  OPTIONAL { ?run mlips:gpuHours ?gpu_hours }
} ORDER BY ?t_inf
""" .
