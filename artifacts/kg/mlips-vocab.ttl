# Starter controlled vocabulary for reference-method classes.
#
# Named individuals for XCFunctional, PseudopotentialType, WfMethod,
# and DftBasisSet that recur across the corpus. Each per-paper
# canonical .ttl references these IRIs directly; the IRIs' own
# type/label/comment triples live HERE (not in any per-paper file)
# so the round-trip check at the per-paper level is unaffected.
#
# When an encoded paper uses an entity not in this list, the
# convention is: mint a paper-local IRI and tag it with
# mlips:candidateForVocabulary <class>. The deduplication audit
# collects candidates; a curator promotes them into this file
# (or merges them into an existing entry) when appropriate.
#
# Wikidata alignment policy: where a named individual has a clear
# Wikidata concept entry (the method/family itself, not a citation
# or an inventor), record it via mlips:sameAsWikidata. Where no
# clear entry exists, an explicit "No Wikidata entry as of
# YYYY-MM-DD" comment is added so future curators don't waste
# effort re-searching. Coverage is intentionally partial: many DFT
# functionals (PBE, PBE0, HSE06, SCAN, ...) are folded into
# Wikidata's broader "Density functional theory" / "Hybrid
# functional" entries rather than carrying their own QIDs.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mlips:  <https://kg.ki.uni-stuttgart.de/_ontology/mlips#> .

###############################################################################
# Exchange-correlation functionals (XCFunctional)
###############################################################################

mlips:LDA a mlips:XCFunctional ;
    rdfs:label "LDA" ;
    rdfs:comment "Local density approximation; the simplest XC functional family." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q898241> .

mlips:PW91 a mlips:XCFunctional ;
    rdfs:label "PW91" ;
    rdfs:comment "Perdew-Wang 1991 GGA functional." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:PBE a mlips:XCFunctional ;
    rdfs:label "PBE" ;
    rdfs:comment "Perdew-Burke-Ernzerhof; GGA family. The most common XC functional in solid-state DFT." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:PBE0 a mlips:XCFunctional ;
    rdfs:label "PBE0" ;
    rdfs:comment "Adamo-Barone hybrid (25% exact exchange + 75% PBE)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:HSE06 a mlips:XCFunctional ;
    rdfs:label "HSE06" ;
    rdfs:comment "Heyd-Scuseria-Ernzerhof screened hybrid (omega = 0.11 a0^-1)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:SCAN a mlips:XCFunctional ;
    rdfs:label "SCAN" ;
    rdfs:comment "Strongly Constrained and Appropriately Normed; a meta-GGA." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:omegaB97X a mlips:XCFunctional ;
    rdfs:label "omegaB97X" ;
    rdfs:comment "Range-separated hybrid GGA (Chai-Head-Gordon family); common in molecular chemistry." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:wB97X a mlips:XCFunctional ;
    rdfs:label "wB97X" ;
    rdfs:comment "Alternative spelling of omegaB97X. Treated as the same entity in the corpus." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." ;
    <http://www.w3.org/2002/07/owl#sameAs> mlips:omegaB97X .

###############################################################################
# Pseudopotential types (PseudopotentialType)
###############################################################################

mlips:PAW a mlips:PseudopotentialType ;
    rdfs:label "PAW" ;
    rdfs:comment "Projector augmented-wave method (Bloechl 1994)." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q7249488> .

mlips:Ultrasoft a mlips:PseudopotentialType ;
    rdfs:label "ultrasoft" ;
    rdfs:comment "Vanderbilt ultrasoft pseudopotential." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q11289206> .

mlips:NormConserving a mlips:PseudopotentialType ;
    rdfs:label "norm-conserving" ;
    rdfs:comment "Norm-conserving pseudopotential family (Hamann-Schlueter-Chiang and successors)." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q11325789> .

###############################################################################
# Wave-function methods (WfMethod)
###############################################################################

mlips:HF a mlips:WfMethod ;
    rdfs:label "HF" ;
    rdfs:comment "Hartree-Fock (no electron correlation beyond exchange)." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q7879841> .

mlips:MP2 a mlips:WfMethod ;
    rdfs:label "MP2" ;
    rdfs:comment "Second-order Moeller-Plesset perturbation theory." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q1074890> .

mlips:CCSD a mlips:WfMethod ;
    rdfs:label "CCSD" ;
    rdfs:comment "Coupled cluster with singles and doubles." ;
    rdfs:comment "Wikidata Q1117940 covers the coupled-cluster family (including CCSD as a named member); no dedicated CCSD-only entry exists." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q1117940> .

mlips:CCSDT a mlips:WfMethod ;
    rdfs:label "CCSD(T)" ;
    rdfs:comment "Coupled cluster with singles, doubles, and perturbative triples; the gold standard of single-reference quantum chemistry." ;
    rdfs:comment "Wikidata Q1117940 covers the coupled-cluster family (including CCSD(T) as a named member); no dedicated CCSD(T)-only entry exists." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q1117940> .

mlips:DLPNO_CCSDT a mlips:WfMethod ;
    rdfs:label "DLPNO-CCSD(T)" ;
    rdfs:comment "Domain-based local pair natural orbital approximation to CCSD(T) (Neese et al.); near-CCSD(T) accuracy at much reduced cost." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:CASPT2 a mlips:WfMethod ;
    rdfs:label "CASPT2" ;
    rdfs:comment "Complete active space second-order perturbation theory; multi-reference method." ;
    rdfs:comment "Q25304396 is the CASPTn family entry; CASPT2 is its second-order variant and the most common implementation." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q25304396> .

mlips:NEVPT2 a mlips:WfMethod ;
    rdfs:label "NEVPT2" ;
    rdfs:comment "N-electron valence state perturbation theory; multi-reference method, intruder-state-free." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q3984072> .

###############################################################################
# DFT basis sets (DftBasisSet) -- used by all-electron and
# localised-basis DFT codes
###############################################################################

mlips:NAOIntermediate a mlips:DftBasisSet ;
    rdfs:label "FHI-aims NAO intermediate" ;
    rdfs:comment "FHI-aims numeric atom-centered orbitals, intermediate tier." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:NAOTier1 a mlips:DftBasisSet ;
    rdfs:label "FHI-aims NAO tier 1" ;
    rdfs:comment "FHI-aims numeric atom-centered orbitals, first tier (smallest valence-quality)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:NAOTier2 a mlips:DftBasisSet ;
    rdfs:label "FHI-aims NAO tier 2" ;
    rdfs:comment "FHI-aims numeric atom-centered orbitals, second tier (production-quality)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:LAPW a mlips:DftBasisSet ;
    rdfs:label "LAPW" ;
    rdfs:comment "Linearised augmented plane waves; basis family of Wien2k and Elk." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .
