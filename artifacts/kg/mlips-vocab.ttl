# Starter controlled vocabulary for reference-method classes.
#
# Named individuals for XCFunctional, PseudopotentialType, WfMethod,
# and DftBasisSet that recur across the corpus. Each per-paper
# canonical .ttl references these IRIs directly; the IRIs' own
# type/label/comment triples live HERE (not in any per-paper file)
# so the round-trip check at the per-paper level is unaffected.
#
# When an encoded paper uses an entity not in this list, the
# convention is: mint a paper-local IRI and tag it with
# mlips:candidateForVocabulary <class>. The deduplication audit
# collects candidates; a curator promotes them into this file
# (or merges them into an existing entry) when appropriate.
#
# Wikidata alignment policy: where a named individual has a clear
# Wikidata concept entry (the method/family itself, not a citation
# or an inventor), record it via mlips:sameAsWikidata. Where no
# clear entry exists, an explicit "No Wikidata entry as of
# YYYY-MM-DD" comment is added so future curators don't waste
# effort re-searching. Coverage is intentionally partial: many DFT
# functionals (PBE, PBE0, HSE06, SCAN, ...) are folded into
# Wikidata's broader "Density functional theory" / "Hybrid
# functional" entries rather than carrying their own QIDs.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix mlips:  <https://w3id.org/mlips#> .

###############################################################################
# Exchange-correlation functionals (XCFunctional)
###############################################################################

mlips:LDA a mlips:XCFunctional ;
    rdfs:label "LDA" ;
    rdfs:comment "Local density approximation; the simplest XC functional family." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q898241> .

mlips:PW91 a mlips:XCFunctional ;
    rdfs:label "PW91" ;
    rdfs:comment "Perdew-Wang 1991 GGA functional." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:PBE a mlips:XCFunctional ;
    rdfs:label "PBE" ;
    rdfs:comment "Perdew-Burke-Ernzerhof; GGA family. The most common XC functional in solid-state DFT." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:PBE0 a mlips:XCFunctional ;
    rdfs:label "PBE0" ;
    rdfs:comment "Adamo-Barone hybrid (25% exact exchange + 75% PBE)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:HSE06 a mlips:XCFunctional ;
    rdfs:label "HSE06" ;
    rdfs:comment "Heyd-Scuseria-Ernzerhof screened hybrid (omega = 0.11 a0^-1)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:SCAN a mlips:XCFunctional ;
    rdfs:label "SCAN" ;
    rdfs:comment "Strongly Constrained and Appropriately Normed; a meta-GGA." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:omegaB97X a mlips:XCFunctional ;
    rdfs:label "omegaB97X" ;
    rdfs:comment "Range-separated hybrid GGA (Chai-Head-Gordon family); common in molecular chemistry." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:wB97X a mlips:XCFunctional ;
    rdfs:label "wB97X" ;
    rdfs:comment "Alternative spelling of omegaB97X. Treated as the same entity in the corpus." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." ;
    <http://www.w3.org/2002/07/owl#sameAs> mlips:omegaB97X .

###############################################################################
# Pseudopotential types (PseudopotentialType)
###############################################################################

mlips:PAW a mlips:PseudopotentialType ;
    rdfs:label "PAW" ;
    rdfs:comment "Projector augmented-wave method (Bloechl 1994)." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q7249488> .

mlips:Ultrasoft a mlips:PseudopotentialType ;
    rdfs:label "ultrasoft" ;
    rdfs:comment "Vanderbilt ultrasoft pseudopotential." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q11289206> .

mlips:NormConserving a mlips:PseudopotentialType ;
    rdfs:label "norm-conserving" ;
    rdfs:comment "Norm-conserving pseudopotential family (Hamann-Schlueter-Chiang and successors)." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q11325789> .

###############################################################################
# Wave-function methods (WfMethod)
###############################################################################

mlips:HF a mlips:WfMethod ;
    rdfs:label "HF" ;
    rdfs:comment "Hartree-Fock (no electron correlation beyond exchange)." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q7879841> .

mlips:MP2 a mlips:WfMethod ;
    rdfs:label "MP2" ;
    rdfs:comment "Second-order Moeller-Plesset perturbation theory." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q1074890> .

mlips:CCSD a mlips:WfMethod ;
    rdfs:label "CCSD" ;
    rdfs:comment "Coupled cluster with singles and doubles." ;
    rdfs:comment "Wikidata Q1117940 covers the coupled-cluster family (including CCSD as a named member); no dedicated CCSD-only entry exists." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q1117940> .

mlips:CCSDT a mlips:WfMethod ;
    rdfs:label "CCSD(T)" ;
    rdfs:comment "Coupled cluster with singles, doubles, and perturbative triples; the gold standard of single-reference quantum chemistry." ;
    rdfs:comment "Wikidata Q1117940 covers the coupled-cluster family (including CCSD(T) as a named member); no dedicated CCSD(T)-only entry exists." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q1117940> .

mlips:DLPNO_CCSDT a mlips:WfMethod ;
    rdfs:label "DLPNO-CCSD(T)" ;
    rdfs:comment "Domain-based local pair natural orbital approximation to CCSD(T) (Neese et al.); near-CCSD(T) accuracy at much reduced cost." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:CASPT2 a mlips:WfMethod ;
    rdfs:label "CASPT2" ;
    rdfs:comment "Complete active space second-order perturbation theory; multi-reference method." ;
    rdfs:comment "Q25304396 is the CASPTn family entry; CASPT2 is its second-order variant and the most common implementation." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q25304396> .

mlips:NEVPT2 a mlips:WfMethod ;
    rdfs:label "NEVPT2" ;
    rdfs:comment "N-electron valence state perturbation theory; multi-reference method, intruder-state-free." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q3984072> .

###############################################################################
# DFT basis sets (DftBasisSet) -- used by all-electron and
# localised-basis DFT codes
###############################################################################

mlips:NAOIntermediate a mlips:DftBasisSet ;
    rdfs:label "FHI-aims NAO intermediate" ;
    rdfs:comment "FHI-aims numeric atom-centered orbitals, intermediate tier." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:NAOTier1 a mlips:DftBasisSet ;
    rdfs:label "FHI-aims NAO tier 1" ;
    rdfs:comment "FHI-aims numeric atom-centered orbitals, first tier (smallest valence-quality)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:NAOTier2 a mlips:DftBasisSet ;
    rdfs:label "FHI-aims NAO tier 2" ;
    rdfs:comment "FHI-aims numeric atom-centered orbitals, second tier (production-quality)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:LAPW a mlips:DftBasisSet ;
    rdfs:label "LAPW" ;
    rdfs:comment "Linearised augmented plane waves; basis family of Wien2k and Elk." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

###############################################################################
# Software packages (mlips:Library)
#
# Canonical IRIs for software packages observed across the corpus.
# Per-paper Implementation nodes carry the version literal; the
# Library here is the shared "what the software is" entity, with a
# Wikidata link where one exists. Per-paper canonicals reference
# these IRIs directly via mlips:usedDFTCode, mlips:usedReferenceCode,
# or mlips:implementedIn (from an Implementation).
###############################################################################

# DFT engines

mlips:VASP a mlips:Library ;
    rdfs:label "VASP" ;
    rdfs:comment "Vienna Ab-initio Simulation Package; plane-wave DFT code." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q7928305> .

mlips:CASTEP a mlips:Library ;
    rdfs:label "CASTEP" ;
    rdfs:comment "Cambridge Serial Total Energy Package; plane-wave DFT code with norm-conserving and ultrasoft pseudopotentials." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q5008880> .

mlips:QuantumESPRESSO a mlips:Library ;
    rdfs:label "Quantum ESPRESSO" ;
    rdfs:comment "Open-source plane-wave DFT suite (formerly known as PWscf in the pre-2008 codebase)." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q17096266> .

mlips:FHIaims a mlips:Library ;
    rdfs:label "FHI-aims" ;
    rdfs:comment "Fritz-Haber-Institut ab initio molecular simulations; all-electron numerical-atom-centred-orbital (NAO) DFT code." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q65119607> .

mlips:Gaussian a mlips:Library ;
    rdfs:label "Gaussian" ;
    rdfs:comment "Gaussian electronic-structure package (Gaussian 09 / 16); molecular all-electron Gaussian-basis DFT and post-HF code." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q901177> .

# Wave-function codes

mlips:ORCA a mlips:Library ;
    rdfs:label "ORCA" ;
    rdfs:comment "ORCA quantum-chemistry program (Neese et al.); supports DFT, post-HF, and DLPNO methods." ;
    mlips:sameAsWikidata <http://www.wikidata.org/entity/Q16948427> .

# MLIP / atomistic-ML packages (no Wikidata software entries as of 2026-04-28)

mlips:MLIP a mlips:Library ;
    rdfs:label "MLIP" ;
    rdfs:comment "Shapeev-group MTP fitting code; the package commonly referenced as MLIP-2 (Novikov et al. 2021) -- versioning is captured per-paper on the Implementation node." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:QUIP a mlips:Library ;
    rdfs:label "QUIP" ;
    rdfs:comment "Quantum mechanics and Interatomic Potentials suite (libAtoms); hosts the GAP plug-in." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:MACE a mlips:Library ;
    rdfs:label "MACE" ;
    rdfs:comment "MACE training/evaluation code (PyTorch + e3nn); higher-order equivariant message-passing GNN. The mace-mp foundation-model deployment lives in a sibling repo and is captured per-paper via the Implementation version literal." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:NequIP a mlips:Library ;
    rdfs:label "NequIP" ;
    rdfs:comment "Equivariant E(3) neural-network potential implementation (Batzner et al.)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:Allegro a mlips:Library ;
    rdfs:label "Allegro" ;
    rdfs:comment "Strictly-local equivariant neural-network potential implementation (Musaelian et al.)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:TorchANI a mlips:Library ;
    rdfs:label "TorchANI" ;
    rdfs:comment "PyTorch implementation of the ANI symmetry-function neural-network potential family." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:NeuroChem a mlips:Library ;
    rdfs:label "NeuroChem" ;
    rdfs:comment "Roitberg-group ANI training framework predating TorchANI." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:M3GNet a mlips:Library ;
    rdfs:label "M3GNet" ;
    rdfs:comment "Materials graph neural network with three-body interactions (Chen and Ong); TensorFlow." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:CHGNet a mlips:Library ;
    rdfs:label "CHGNet" ;
    rdfs:comment "Charge-informed universal neural-network potential (Ceder group); PyTorch." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:DeePMDkit a mlips:Library ;
    rdfs:label "DeePMD-kit" ;
    rdfs:comment "Deep Potential Molecular Dynamics package (Wang, Zhang, Han, E); TensorFlow + LAMMPS pair_style." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:SchNet a mlips:Library ;
    rdfs:label "SchNet" ;
    rdfs:comment "Continuous-filter convolutional deep-learning architecture for molecules and materials (Schuett et al.); reference implementation predating SchNetPack." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:RuNNer a mlips:Library ;
    rdfs:label "RuNNer" ;
    rdfs:comment "Behler-group Neural Network code; canonical reference implementation of HDNNPs (and the spin-dependent sACSF extension)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

mlips:PACE a mlips:Library ;
    rdfs:label "PACE" ;
    rdfs:comment "Performant Atomic Cluster Expansion C++ implementation; LAMMPS pair_style for the ACE method (Drautz 2019)." ;
    rdfs:comment "No Wikidata entry as of 2026-04-28." .

###############################################################################
# Hyperparameters (mlips:Hyperparameter)
#
# Canonical type-level hyperparameter individuals. Each carries the
# mlips:hyperparameterName / mlips:hyperparameterDatatype metadata
# that competency question CQ1 reaches for, plus optional defaults
# and physical bounds. Per-paper HyperparameterSetting instances
# point at these via mlips:forHyperparameter; per-paper MLIPMethod
# instances reference them via mlips:hasHyperparameter.
#
# An IRI such as mlips:cutoffRadius is also a DatatypeProperty in
# the schema (with range xsd:double, used to attach a numeric value
# directly to a HyperparameterSetting node). OWL 2 punning lets the
# same IRI carry both the property and the type-level Hyperparameter
# individual without conflict; CQ1 only consults the individual side
# (?hp a mlips:Hyperparameter ; mlips:hyperparameterName ...).
###############################################################################

mlips:cutoffRadius a mlips:Hyperparameter ;
    rdfs:label "cutoff radius" ;
    rdfs:comment "Distance beyond which atoms are not considered neighbours of a given centre. Universal across descriptor- and graph-based MLIPs; usually denoted r_cut." ;
    mlips:hyperparameterName "cutoff_radius" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:minValue "0.0"^^xsd:double ;
    mlips:maxValue "12.0"^^xsd:double .

mlips:angularCutoff a mlips:Hyperparameter ;
    rdfs:label "angular cutoff" ;
    rdfs:comment "Secondary, typically smaller cutoff governing the angular / 3-body / bond-graph component of the descriptor (e.g. ANI angular AEV cutoff, M3GNet 3-body cutoff, CHGNet bond-graph cutoff)." ;
    mlips:hyperparameterName "angular_cutoff" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:minValue "0.0"^^xsd:double ;
    mlips:maxValue "8.0"^^xsd:double .

mlips:minInteratomicDistance a mlips:Hyperparameter ;
    rdfs:label "minimum interatomic distance" ;
    rdfs:comment "Lower bound on the radial-basis support; configurations with closer pairs are flagged as out-of-domain. Common in MTP encodings (r_min)." ;
    mlips:hyperparameterName "r_min" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:minValue "0.0"^^xsd:double ;
    mlips:maxValue "5.0"^^xsd:double .

mlips:momentLevel a mlips:Hyperparameter ;
    rdfs:label "MTP moment level" ;
    rdfs:comment "Maximum-level threshold lev_max controlling the size of the level-truncated MTP basis. MTP-specific: not directly comparable to the body-order or angular-basis count of other families." ;
    mlips:hyperparameterName "lev_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "0"^^xsd:integer .

mlips:bodyOrder a mlips:Hyperparameter ;
    rdfs:label "body order" ;
    rdfs:comment "Maximum body order / correlation order of the descriptor's many-body basis (ACE, MACE). Body order 2 = pair, 3 = triplet, etc." ;
    mlips:hyperparameterName "body_order" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "2"^^xsd:integer ;
    mlips:maxValue "8"^^xsd:integer .

mlips:numLayers a mlips:Hyperparameter ;
    rdfs:label "number of layers" ;
    rdfs:comment "Number of message-passing / interaction layers in a graph-neural-network MLIP. SchNet's T, MACE / NequIP / Allegro layer counts, M3GNet / CHGNet block counts." ;
    mlips:hyperparameterName "num_layers" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "1"^^xsd:integer ;
    mlips:maxValue "12"^^xsd:integer .

mlips:numFeatures a mlips:Hyperparameter ;
    rdfs:label "number of features" ;
    rdfs:comment "Width of the per-atom feature vector / hidden state in graph-network MLIPs. Goes by 'channels', 'embedding dim', 'feature size', SchNet's F." ;
    mlips:hyperparameterName "num_features" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "1"^^xsd:integer .

mlips:numRadialBasis a mlips:Hyperparameter ;
    rdfs:label "number of radial basis functions" ;
    rdfs:comment "Number of radial basis functions used to expand the radial dependence of the descriptor (Bessel basis in MACE, n_max in SOAP, etc.)." ;
    mlips:hyperparameterName "num_radial_basis" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "1"^^xsd:integer .

mlips:numAngularBasis a mlips:Hyperparameter ;
    rdfs:label "number of angular basis functions" ;
    rdfs:comment "Maximum spherical-harmonic order l_max controlling the angular component of the descriptor (SOAP, MACE, NequIP, Allegro)." ;
    mlips:hyperparameterName "l_max" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "0"^^xsd:integer ;
    mlips:maxValue "10"^^xsd:integer .

mlips:learningRate a mlips:Hyperparameter ;
    rdfs:label "learning rate" ;
    rdfs:comment "Initial learning rate for the gradient-based optimiser (Adam, AdamW, AMSGrad). The corpus-wide median is around 1e-3." ;
    mlips:hyperparameterName "learning_rate" ;
    mlips:hyperparameterDatatype xsd:double ;
    mlips:defaultValue "0.001"^^xsd:double ;
    mlips:minValue "0.0"^^xsd:double ;
    mlips:maxValue "1.0"^^xsd:double .

mlips:batchSize a mlips:Hyperparameter ;
    rdfs:label "batch size" ;
    rdfs:comment "Number of training examples per stochastic gradient step." ;
    mlips:hyperparameterName "batch_size" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "1"^^xsd:integer .

mlips:numEpochs a mlips:Hyperparameter ;
    rdfs:label "number of epochs" ;
    rdfs:comment "Number of full passes over the training set." ;
    mlips:hyperparameterName "num_epochs" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "1"^^xsd:integer .

mlips:numSparseConfigs a mlips:Hyperparameter ;
    rdfs:label "number of sparse configurations" ;
    rdfs:comment "Sparse-Gaussian-process inducing-set size (M / Msparse) controlling the cost of GAP regression." ;
    mlips:hyperparameterName "num_sparse_configs" ;
    mlips:hyperparameterDatatype xsd:integer ;
    mlips:minValue "1"^^xsd:integer .
