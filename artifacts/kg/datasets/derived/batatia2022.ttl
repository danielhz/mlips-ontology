@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix mlips:   <https://w3id.org/mlips#> .
@prefix entity:  <https://w3id.org/mlips/entity/> .

entity:extract-batatia2022-2026-07-26 a prov:Activity ;
    rdfs:label "aggregate metadata extraction from the collected batatia2022 dataset artifact(s)" ;
    prov:startedAtTime "2026-07-26"^^xsd:date ;
    rdfs:comment "extract_dataset_metadata.py; run on kg1 against ~/mlips-datasets (see PROVENANCE sidecars)" .
entity:dist-rmd17-0 a dcat:Distribution ;
    dcat:downloadURL <https://ndownloader.figshare.com/files/23950376> ;
    dcat:byteSize "1066301513"^^xsd:nonNegativeInteger ;
    dcterms:format "npz" ;
    spdx:checksum [ a spdx:Checksum ;
        spdx:algorithm spdx:checksumAlgorithm_sha256 ;
        spdx:checksumValue "cddeea2ec2c4b22a9de16a9a65a3eeedac5b29da9c99c20bbff0153912bf922b" ] ;
    prov:generatedAtTime "2026-07-26T09:44:57Z"^^xsd:dateTime .
entity:ds-rMD17
    mlips:numConfigurations 999988 ;
    mlips:coversProperty mlips:Energy , mlips:Forces ;
    dcat:distribution entity:dist-rmd17-0 ;
    prov:wasGeneratedBy entity:extract-batatia2022-2026-07-26 ;
    rdfs:comment "Artifact-derived aggregates: aspirin: 100000; azobenzene: 99988; benzene: 100000; ethanol: 100000; malonaldehyde: 100000; naphthalene: 100000; paracetamol: 100000; salicylic: 100000; toluene: 100000; uracil: 100000. Species: {C, H, N, O}; atoms/config 9-24 KG's 1000 is the 950+50 per-molecule split used by MACE (split index CSVs are in the deposit)." .
