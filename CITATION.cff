cff-version: 1.2.0
message: "If you use this ontology or knowledge graph, please cite it using the metadata in this file."
title: "An Ontology for Machine Learning Interatomic Potentials"
abstract: "An OWL 2 ontology and worked-example knowledge graph for describing machine learning interatomic potentials (MLIPs): algorithm families and their hyperparameters, training datasets with DFT/wave-function provenance, published benchmarks, and the simulation types each potential supports."
type: dataset
version: "0.1.1"
date-released: "2026-07-25"
license: CC-BY-4.0
url: "https://w3id.org/mlips"
repository-code: "https://github.com/danielhz/mlips-ontology"
keywords:
  - machine learning interatomic potentials
  - ontology
  - knowledge graph
  - OWL
  - materials science
  - FAIR data
