# Build outputs from artifacts/kg/build-listings.sh.
# Regenerable from artifacts/kg/papers/<paper-id>.ttl.
artifacts/kg/listings/
# Build outputs from `build-listings.sh --computed`.
# Regenerable from dist/artifacts/kg/papers/<paper-id>-computed.ttl.
artifacts/kg/listings-computed/

# Build outputs from the figure-rendering pipeline
# (artifacts/tools/render_figures.sh and dot_to_tikz.py).
# Sources (.dot) live with the paper repo for now; this repo only
# holds the tool, not its outputs.
artifacts/figures/

# Build outputs from artifacts/scripts/generate_term_appendix.py.
# Regenerable from artifacts/ontology/mlips.ttl.
dist/

# Computed-TTL outputs from `make compute`.
# Per-paper materialisation of the canonical paper.ttl plus the
# computed inverse-role and label triples emitted by
# artifacts/kg/computed/{inverses,labels}.rq.
*-computed.ttl

# Stray latex log left by upstream renderers.
texput.log

# Editor / OS
*~
\#*\#
.#*
.DS_Store


# Added by cargo

/target
